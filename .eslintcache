  launchersCollection?: any;\n  isLoading: boolean;\n  error: ErrorMessage;\n}\n\nexport const initialState: CollectionState = {\n  isLoading: false,\n  error: { message: \"An Error occurred\" },\n};\n\nexport const collectionSlice = createSlice({\n  name: \"createCollection\",\n  initialState,\n  reducers: {\n    setLoading: (state, { payload }) => {\n      state.isLoading = payload;\n    },\n    setCurrentCollectionSuccess: (state, { payload }) => {\n      state.currentCollection = payload;\n      // console.log(\"Dispatch collection \", state.currentCollection);\n    },\n    setLauncherCollections: (state, { payload }) => {\n      state.launchersCollection = payload;\n    },\n\n    setCollections: (state, payload) => {\n      state.collections = payload.payload;\n      // console.log(\" collections \",state.collections);\n    },\n    setFeaturedCollection: (state, payload) => {\n      state.featuredCollections = payload.payload;\n    },\n    updateFeaturedCollectionStatus: (state, payload) => {\n      state.featuredCollections = payload.payload;\n    },\n    updateCollectionStatus: (state, payload) => {\n      state.collections = payload.payload;\n      // console.log(\" collections \",state.collections);\n    },\n    updateLauncherCollections: (state, { payload }) => {\n      state.launchersCollection = payload;\n    },\n    setFailed: (state, { payload }) => {\n      state.error = payload;\n    },\n  },\n});\n\nexport const createCollection =\n  (formData: any): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n\n    try {\n      let res = await axios({\n        method: \"post\",\n        url: process.env.REACT_APP_BASE_URL + \"collection/addCollection\",\n        data: formData,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      let data = res.data;\n      dispatch(\n        alert({\n          title: `Success`,\n          message: res?.data?.message || `Collection created successfully`,\n          severity: \"success\",\n        })\n      );\n      return data;\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    }\n  };\n\nexport const getMyCreatedCollections = (): AppThunk => async (dispatch) => {\n  const authToken = localStorage.getItem(\"authToken\") || \"\";\n  dispatch(setLoading(true));\n  try {\n    let res = await axios({\n      method: \"get\",\n      url: process.env.REACT_APP_BASE_URL + \"collection/getOwnCollections\",\n      headers: {\n        \"x-auth-token\": authToken,\n      },\n    });\n    let data = res.data;\n    dispatch(setCollections(data));\n  } catch (error: any) {\n    dispatch(\n      alert({\n        title: `Failed`,\n        message: error?.response?.data?.message || \"something went wrong\",\n        severity: \"error\",\n      })\n    );\n    dispatch(setFailed(error));\n  } finally {\n    dispatch(setLoading(false));\n  }\n};\n\nexport const getCollectionDetail =\n  (collectionId: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: `${process.env.REACT_APP_BASE_URL}collection/getCollectionById/${collectionId}`,\n      });\n      let data = res.data;\n      return data;\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getCollectionNfts =\n  (collectionId: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: `${process.env.REACT_APP_BASE_URL}collection/getNftsByCollection/${collectionId}`,\n      });\n      let data = res.data;\n      return data;\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getAllCollectionNFT =\n  ({ search, isVerified, limit, page }: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: `${process.env.REACT_APP_BASE_URL}listing/getAllCollection`,\n        params: {\n          search,\n          isVerified,\n          limit,\n          page,\n        },\n      });\n      let data = res.data;\n      dispatch(setCollections(data));\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getAllFeaturedCollection =\n  ({ search, isVerified, limit, page }: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: `${process.env.REACT_APP_BASE_URL}collection/getRquestedFeaturedCollections`,\n        params: {\n          search,\n          isVerified,\n          limit,\n          page,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      let data = res.data;\n      dispatch(setFeaturedCollection(data));\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const changeCollectionStatus =\n  ({ isVerified, id }: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    try {\n      const authToken = localStorage.getItem(\"authToken\") || \"\";\n      let res = await axios({\n        method: \"patch\",\n        url: `${process.env.REACT_APP_BASE_URL}collection/collectionStatus/${id}`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n        data: { isVerified },\n      });\n      dispatch(\n        alert({\n          title: `Success`,\n          message: res?.data?.message || `Collection updated successfully`,\n          severity: \"success\",\n        })\n      );\n      return res?.data;\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const changeCollectionActivation =\n  ({ status, id }: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    try {\n      const authToken = localStorage.getItem(\"authToken\") || \"\";\n      let res = await axios({\n        method: \"post\",\n        url: `${process.env.REACT_APP_BASE_URL}collection/activationStatus`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n        data: { id, status },\n      });\n      dispatch(\n        alert({\n          title: `Success`,\n          message: res?.data?.message || `Collection updated successfully`,\n          severity: \"success\",\n        })\n      );\n      return res?.data;\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getCollectionDetails =\n  (id: string): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + \"collection/getCollectionById\",\n        params: {\n          id,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      const data = res.data;\n      return data;\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    }\n  };\n\nexport const makeCollectionFeatured =\n  (collectionId: string, featured: boolean): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    try {\n      const authToken = localStorage.getItem(\"authToken\") || \"\";\n      let res = await axios({\n        method: \"post\",\n        url: `${process.env.REACT_APP_BASE_URL}collection/makeCollectionFeature/${collectionId}`,\n        params: {\n          featured,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      dispatch(\n        alert({\n          title: `Success`,\n          message:\n            res?.data?.message || `Collection featured updated successfully`,\n          severity: \"success\",\n        })\n      );\n      return res?.data;\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const approvedLauncherDrop =\n  (inputs: { id: string; isApproved: boolean }): AppThunk =>\n  async (dispatch) => {\n    console.log(\"🚀 ~ file: collectionReducer.ts ~ line 393 ~ batchId\", inputs);\n    const { id: batchId, isApproved: approved } = inputs;\n    dispatch(setLoading(true));\n    try {\n      const authToken = localStorage.getItem(\"authToken\") || \"\";\n      let res = await axios({\n        method: \"post\",\n        url: `${process.env.REACT_APP_BASE_URL}batch/approvedOrDisapprovedLauncher/${batchId}`,\n        params: {\n          approved,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      dispatch(\n        alert({\n          title: `Success`,\n          message: res?.data?.message || `Launcher drop updated successfully`,\n          severity: \"success\",\n        })\n      );\n      return res?.data;\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getAllRequestedApprovalLaunchers =\n  ({ limit, page }: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: `${process.env.REACT_APP_BASE_URL}batch/getRequestedApprovalLaunchpad`,\n        params: {\n          limit,\n          page,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      let data = res.data;\n      dispatch(setLauncherCollections(data));\n    } catch (error: any) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const {\n  setCurrentCollectionSuccess,\n  setLoading,\n  setFailed,\n  setCollections,\n  updateCollectionStatus,\n  updateFeaturedCollectionStatus,\n  setFeaturedCollection,\n  updateLauncherCollections,\n  setLauncherCollections,\n} = collectionSlice.actions;\n\nexport default collectionSlice.reducer;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/store/reducers/nftReducer.ts",["1124"],"import { createSlice } from \"@reduxjs/toolkit\";\n\nimport { AppThunk, RootState } from \"../store\";\nimport axios from \"axios\";\nimport { alert } from \"./alertSlice\";\n\nexport interface ErrorMessage {\n  message: string;\n}\nexport interface nft {\n  _id: String;\n  userId: String;\n  assetUrl: String;\n  key: Number;\n  mint: String;\n  name: String;\n  artistName: String;\n  symbol: String;\n  description: String;\n  seller_fee_basis_points: Number;\n  image: String;\n  external_url: String;\n  properties: Object;\n  creators: [];\n  primarySaleHappened: Number;\n  isMutable: Number;\n  editionNonce: Number;\n  tokenStandard: Number;\n}\nexport interface NftState {\n  nfts?: nft[];\n  nftsSales?: any;\n  trendingNfts?: nft[];\n  isLoading: boolean;\n  error: ErrorMessage;\n}\n\nexport const initialState: NftState = {\n  isLoading: false,\n  error: { message: \"An Error occurred\" },\n};\n\nexport const nftSlice = createSlice({\n  name: \"createNft\",\n  initialState,\n  reducers: {\n    setLoading: (state, { payload }) => {\n      state.isLoading = payload;\n    },\n    setNfts: (state, payload) => {\n      state.nfts = payload.payload;\n    },\n    setNftSales: (state, payload) => {\n      state.nftsSales = payload.payload;\n    },\n    setTrendingNfts: (state, payload) => {\n      state.trendingNfts = payload.payload;\n    },\n    setFailed: (state, { payload }) => {\n      state.error = payload;\n    },\n  },\n});\n\nexport const getAllNft =\n  ({ limit, page, filter }: any): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + \"listing/getAllNft\",\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n        params: {\n          limit,\n          page,\n          filter,\n        },\n      });\n      let data = res.data;\n\n      dispatch(setNfts(data));\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getSearchedNft =\n  ({ filter }: any): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + `auction/getSearchResults`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n        params: {\n          filter,\n        },\n      });\n      let data = res.data;\n      dispatch(setNfts(data.nfts));\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getNftDetails =\n  (id: string): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + \"nft/getNftDetail\",\n        params: {\n          id,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      const data = res.data;\n      return data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    }\n  };\n\nexport const getUserNft =\n  (userId: string, filter: Object): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + \"nft/getAllNftData/admin\",\n        params: {\n          userId,\n          filter,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      const data = res.data;\n      console.log(\"data======?? User Nft \", data);\n      return data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    }\n  };\n\nexport const getTrendingNft = (): AppThunk => async (dispatch) => {\n  const authToken = localStorage.getItem(\"authToken\") || \"\";\n  dispatch(setLoading(true));\n  try {\n    let res = await axios({\n      method: \"get\",\n      url: process.env.REACT_APP_BASE_URL + \"activity/getTrendingNft\",\n      headers: {\n        \"x-auth-token\": authToken,\n      },\n    });\n    let data = res.data;\n    dispatch(setTrendingNfts(data));\n  } catch (error) {\n    dispatch(\n      alert({\n        title: `Failed`,\n        message: error?.response?.data?.message || \"something went wrong\",\n        severity: \"error\",\n      })\n    );\n    dispatch(setFailed(error));\n  } finally {\n    dispatch(setLoading(false));\n  }\n};\n\nexport const getNftActivities =\n  (nftId: string): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"post\",\n        url: process.env.REACT_APP_BASE_URL + \"activity/getNftActivity\",\n        data: {\n          nftId,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      const data = res.data;\n      return data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getNftsSalesActivities =\n  ({ search, nftType, limit, page }: any): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + \"activity/getNftSaleActivity\",\n        params: {\n          search,\n          nftType,\n          limit,\n          page,\n        },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      const data = res.data;\n      dispatch(setNftSales(data));\n      return data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\