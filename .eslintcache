    />\n                                             <path\n                                                d=\"M12 8H12.01\"\n                                                stroke=\"#6F6F6F\"\n                                                strokeWidth={2}\n                                                strokeLinecap=\"round\"\n                                                strokeLinejoin=\"round\"\n                                             />\n                                          </svg>\n                                          View Details\n                                       </Dropdown.Item>\n                                    </Dropdown.Menu>\n                                 </Dropdown>\n                              </td>\n                           </tr>\n                        )\n                     })}\n\n                  </tbody>\n               </table>\n               <div className=\"d-sm-flex text-center justify-content-between align-items-center\">\n                  <div className=\"dataTables_info\" id=\"example5_info\">\n                     Showing {activePag.current * sort + 1} to{\" \"}\n                     {tabledata?.length > (activePag.current + 1) * sort\n                        ? (activePag.current + 1) * sort\n                        : tabledata?.length}{\" \"}\n                     of {tabledata?.length} entries\n                  </div>\n                  <div className=\"dataTables_paginate paging_simple_numbers\">\n                     <Link\n                        className=\"paginate_button previous disabled\"\n                        aria-controls=\"example5\"\n                        onClick={() =>\n                           activePag.current > 0 &&\n                           onClick(activePag.current - 1)\n                        }\n                     >\n                        Previous\n                     </Link>\n                     <span>\n                        {paggination.map((number, i) => (\n                           <Link\n                              key={i}\n                              // to=\"\"\n                              className={`paginate_button  ${activePag.current === i ? \"current\" : \"\"\n                                 }`}\n                              onClick={() => onClick(i)}\n                           >\n                              {number}\n                           </Link>\n                        ))}\n                     </span>\n                     <Link\n                        className=\"paginate_button next\"\n                        onClick={() =>\n                           activePag.current + 1 < paggination.length &&\n                           onClick(activePag.current + 1)\n                        }\n                     >\n                        Next\n                     </Link>\n                  </div>\n               </div>\n            </div>\n         </div>\n      </>\n   );\n};\n\nexport default PricingsListingTable;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Blogs/BlogDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Nfts/NftDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Auction/AuctionDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/table/BootstrapTable.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/table/DataTable.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/Products.js",["1361"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\nconst tempImage = 'https://qfhf65psmzzuk23swabcb3wrlsolwmmif7gfc3okhedfez5e3y.arweave.net/gU5fdfJmc0Vrcr-ACIO7RXJy7MYgvzFFtyjkGUmek3k?ext=svg'\n\nconst MAX_LENGTH = 30;\n\nconst Products = ({ product: { fullName , description , image  } }) => {\n   return (\n      <div className=\"col-xl-3 col-lg-6 col-md-6 col-sm-6\">\n         <div className=\"card\">\n            <div className=\"card-body\">\n               <div className=\"new-arrival-product\">\n                  <div className=\"new-arrivals-img-contnent\">\n                     <img className=\"img-fluid\" src={image || tempImage} alt=\"\" />\n                  </div>\n                  <div className=\"new-arrival-content text-center mt-3\">\n                     Name\n                     <h4>\n                        {/* <Link to=\"/ecom-product-detail\"> */}\n                           {fullName}\n                           {/* </Link> */}\n                     </h4>\n                     {/* {rating}\n                     <span className=\"price\">${price}</span> */}\n                  </div>\n                  <div className=\"new-arrival-content text-center mt-3\">\n                    Description\n                     <h4>\n                        {/* <Link to=\"/ecom-product-detail\"> */}\n\n                           { description && `${description.substring(0, MAX_LENGTH)}...`}\n                           {/* </Link> */}\n                     </h4>\n                     {/* {rating}\n                     <span className=\"price\">${price}</span> */}\n                  </div>\n               </div>\n            </div>\n         </div>\n      </div>\n   );\n};\n\nexport default Products;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/apexcharts/ApexChart.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/listingTable/NewListings.js",["1362","1363","1364","1365","1366","1367"],"import React, { useState, useEffect } from \"react\";\nimport { Dropdown } from \"react-bootstrap\";\nimport { EditorState, convertFromRaw } from \"draft-js\";\nimport { convertToHTML } from \"draft-convert\";\nimport { useHistory } from \"react-router-dom\";\nimport swal from \"sweetalert\";\n\nconst NewsListingsTable = ({ tabledata, deleteBlog, limit, page }) => {\n  console.log(\n    \"🚀 ~ file: NewListings.js ~ line 9 ~ NewsListingsTable ~ tabledata\",\n    tabledata\n  );\n  const history = useHistory();\n  //   const [tData, setTData] = useState(tabledata);\n  //   console.log(\n  //     \"🚀 ~ file: NewListings.js ~ line 11 ~ NewsListingsTable ~ tData\",\n  //     tData\n  //   );\n\n  //   useEffect(() => {\n  //     (async () => {\n  //       const contentData =\n  //         tabledata &&\n  //         tabledata?.map(async (item) => {\n  //           const editorState = await EditorState.createWithContent(\n  //             convertFromRaw(JSON.parse(item?.description))\n  //           );\n  //           const html_content = await convertToHTML(\n  //             editorState?.getCurrentContent()\n  //           );\n  //           // const tex = html_content.innerHTML\n  //           return {\n  //             ...item,\n  //             description: html_content,\n  //           };\n  //         });\n  //       console.log(\n  //         \"🚀 ~ file: NewListings.js ~ line 31 ~ contentData\",\n  //         contentData\n  //       );\n  //       setTData(await Promise.all(contentData || []));\n  //     })();\n  //   }, [tabledata]);\n\n  const onDeleteBlog = (id) => {\n    swal({\n      title: \"Are you sure?\",\n      text: \"Once deleted, you will not be able to recover this News!\",\n      icon: \"warning\",\n      buttons: true,\n      dangerMode: true,\n    }).then((willDelete) => {\n      if (willDelete) {\n        deleteBlog(id);\n      }\n    });\n  };\n  return (\n    <>\n      <div className=\"table-responsive\">\n        <div className=\"dataTables_wrapper no-footer\">\n          <table\n            id=\"spendingTable\"\n            className=\"display mb-4 dataTablesCard card-table dataTable no-footer\"\n            style={{ width: \"100%\" }}\n          >\n            <thead>\n              <tr role=\"row\">\n                <th\n                  className=\"pr-0 no-data-img all_spending_strg\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-sort=\"ascending\"\n                  style={{ width: 32 }}\n                >\n                  <div className=\"custom-control custom-checkbox ml-2\">\n                    <strong>No.</strong>\n                  </div>\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Image\n                </th>\n\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Title\n                </th>\n              </tr>\n            </thead>\n            <tbody>\n              {tabledata &&\n                tabledata.map((row, index) => {\n                  return (\n                    <tr role=\"row\" className=\"odd\" style={{ height: 150 }}>\n                      <td className=\"pr-0 all_spending_checkbox\">\n                        <div className=\"custom-control custom-checkbox ml-2\">\n                          <strong>{limit * page + index + 1}</strong>\n                        </div>\n                      </td>\n\n                      <td>\n                        {\n                          <img\n                            src={row.newsImage}\n                            width={60}\n                            alt={row.newsImage}\n                          />\n                        }\n                      </td>\n\n                      <td>{row.title}</td>\n                      <td>\n                        <Dropdown className=\"dropdown ml-auto\">\n                          <Dropdown.Toggle\n                            variant=\"\"\n                            className=\"icon-false p-0 btn-link\"\n                            data-toggle=\"dropdown\"\n                          >\n                            <svg\n                              width={24}\n                              height={24}\n                              viewBox=\"0 0 24 24\"\n                              fill=\"none\"\n                              xmlns=\"http://www.w3.org/2000/svg\"\n                            >\n                              <path\n                                d=\"M11.0005 12C11.0005 12.5523 11.4482 13 12.0005 13C12.5528 13 13.0005 12.5523 13.0005 12C13.0005 11.4477 12.5528 11 12.0005 11C11.4482 11 11.0005 11.4477 11.0005 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                              />\n                              <path\n                                d=\"M18.0005 12C18.0005 12.5523 18.4482 13 19.0005 13C19.5528 13 20.0005 12.5523 20.0005 12C20.0005 11.4477 19.5528 11 19.0005 11C18.4482 11 18.0005 11.4477 18.0005 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                              />\n                              <path\n                                d=\"M4.00049 12C4.00049 12.5523 4.4482 13 5.00049 13C5.55277 13 6.00049 12.5523 6.00049 12C6.00049 11.4477 5.55277 11 5.00049 11C4.4482 11 4.00049 11.4477 4.00049 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\