me=\"dropdown text-sans-serif\">\n                                       <Dropdown.Toggle\n                                          variant=\"\"\n                                          className=\"btn btn-primary tp-btn-light sharp icon-false\"\n                                          type=\"button\"\n                                          id=\"order-dropdown-0\"\n                                          data-toggle=\"dropdown\"\n                                          data-boundary=\"viewport\"\n                                          aria-haspopup=\"true\"\n                                          aria-expanded=\"false\"\n                                       >\n                                          <span>\n                                             <svg\n                                                xmlns=\"http://www.w3.org/2000/svg\"\n                                                xmlnsXlink=\"http://www.w3.org/1999/xlink\"\n                                                width=\"18px\"\n                                                height=\"18px\"\n                                                viewBox=\"0 0 24 24\"\n                                                version=\"1.1\"\n                                             >\n                                                <g\n                                                   stroke=\"none\"\n                                                   strokeWidth={1}\n                                                   fill=\"none\"\n                                                   fillRule=\"evenodd\"\n                                                >\n                                                   <rect\n                                                      x={0}\n                                                      y={0}\n                                                      width={24}\n                                                      height={24}\n                                                   />\n                                                   <circle\n                                                      fill=\"#000000\"\n                                                      cx={5}\n                                                      cy={12}\n                                                      r={2}\n                                                   />\n                                                   <circle\n                                                      fill=\"#000000\"\n                                                      cx={12}\n                                                      cy={12}\n                                                      r={2}\n                                                   />\n                                                   <circle\n                                                      fill=\"#000000\"\n                                                      cx={19}\n                                                      cy={12}\n                                                      r={2}\n                                                   />\n                                                </g>\n                                             </svg>\n                                          </span>\n                                       </Dropdown.Toggle>\n                                       <Dropdown.Menu\n                                          className=\"dropdown-menu dropdown-menu-right border py-0\"\n                                          aria-labelledby=\"order-dropdown-0\"\n                                       >\n                                          <div className=\"py-2\">\n                                             <a\n                                                className=\"dropdown-item\"\n                                                href=\"#!\"\n                                             >\n                                                Completed\n                                             </a>\n                                             <a\n                                                className=\"dropdown-item\"\n                                                href=\"#!\"\n                                             >\n                                                Processing\n                                             </a>\n                                             <a\n                                                className=\"dropdown-item\"\n                                                href=\"#!\"\n                                             >\n                                                On Hold\n                                             </a>\n                                             <a\n                                                className=\"dropdown-item\"\n                                                href=\"#!\"\n                                             >\n                                                Pending\n                                             </a>\n                                             <div className=\"dropdown-divider\" />\n                                             <a\n                                                className=\"dropdown-item text-danger\"\n                                                href=\"#!\"\n                                             >\n                                                Delete\n                                             </a>\n                                          </div>\n                                       </Dropdown.Menu>\n                                    </Dropdown>\n                                 </td>\n                              </tr>\n                           </tbody>\n                        </table>\n                     </div>\n                  </div>\n               </div>\n            </div>\n         </div>\n      </div>\n   );\n};\n\nexport default ProductOrder;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/delete-NftGrid.js",["1199","1200","1201"],"import React, { Fragment  , useEffect , useState} from \"react\";\nimport { useDispatch , useSelector } from 'react-redux'\n// import Products from \"./Products\";\n\n/// Data\n// import productData from \"../productData\";\nimport PageTitle from \"../../../../layouts/PageTitle\";\nimport DataTable from \"../../../Dashboard/DataTable\";\nimport { getAllNft } from '../../../../../store/reducers/nftReducer'\n\n\nconst ProductGrid = () => {\n\n   const [nft , setNft] = useState(null);\n   const dispatch = useDispatch();\n   useEffect(() => {\n\n      const getNftListing = (async () => {\n\n        dispatch(getAllNft());\n         \n         // const requestOptions = {\n         //    method: 'GET',\n         //    redirect: 'follow'\n         //  };\n          \n         //  let NftListing = await fetch(\"http://localhost:5000/listing/getAllNft\", requestOptions)\n         //    .then(response => response.text())\n         //    .then(result => {\n         //       return JSON.parse(result)\n         //    })\n         //    .catch(error => console.log('error', error));\n          \n         //    setNft(NftListing)\n         //    console.log('NftListing ====>' , NftListing)\n      })\n\n      getNftListing()\n\n   } , []);\n\n   const data = useSelector((store) => store.nftReducer.nfts)\n   return (\n      <Fragment>\n         <PageTitle activeMenu=\"Blank\" motherMenu=\"Layout\" />\n         <div className=\"row\">\n            <DataTable tabledata = {data}/>\n         </div>\n      </Fragment>\n   );\n};\n\nexport default ProductGrid;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/NewsForm.js",["1202","1203","1204","1205","1206","1207"],"import React, { Fragment, useState } from \"react\";\nimport { useDispatch } from \"react-redux\";\n// import Products from \"./Products\";\nimport { creteBlogs } from \"../../../../../store/reducers/blogReducer\";\nimport { convertToRaw, EditorState } from \"draft-js\";\nimport { Editor } from \"react-draft-wysiwyg\";\n// import htmlToDraft from \"html-to-draftjs\";\nimport \"react-draft-wysiwyg/dist/react-draft-wysiwyg.css\";\nimport CircularProgress from \"@material-ui/core/CircularProgress\";\nimport { fileUpload } from \"../../../../../Helper/common\";\nimport ButtonLoader from \"../../../common/buttonLoader\";\nimport PageTitle from \"../../../../layouts/PageTitle\";\nimport { alert } from \"../../../../../store/reducers/alertSlice\";\nimport { createNews } from \"../../../../../store/reducers/newReducer\";\nconst NewsForm = () => {\n  const [editorState, setEditorState] = useState(() =>\n    EditorState.createEmpty()\n  );\n  const [formValues, setFormValues] = useState({\n    title: \"\",\n    image: \"test Image\",\n  });\n  const [files, setFiles] = useState([]);\n\n  const dispatch = useDispatch();\n  const [showAlert, setAlert] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [errors, setErrors] = useState({});\n\n  const validate = (values) => {\n    let err = {};\n\n    if (!formValues.title) {\n      err.title = \"Title is required\";\n    }\n\n    if (!files && !files[0]) {\n      err.image = \"Image is required\";\n    } else if (files && files[0]?.type.split(\"/\")[0] !== \"image\") {\n      err.image = \"Please provide a valid image\";\n    }\n\n    return err;\n  };\n\n  const handleSubmit = async (e) => {\n    e.preventDefault();\n    const err = validate();\n    if (Object.keys(err).length > 0) {\n      return setErrors(err);\n    }\n\n    setLoading(true);\n    let myHeaders = new Headers();\n    myHeaders.append(\"Content-Type\", \"application/json\");\n    const contentState = editorState.getCurrentContent();\n    let stateData = await JSON.stringify(convertToRaw(contentState));\n    const blogImage = await fileUpload(files[0]);\n    const raw = {\n      newsImage: blogImage,\n      title: formValues.title,\n    };\n    const data = await dispatch(createNews(raw));\n    if (data) {\n      dispatch(\n        alert({\n          title: `Success`,\n          message: `News Created Successfully`,\n          severity: \"success\",\n        })\n      );\n      setTimeout(() => {\n        setAlert(false);\n        document.getElementById(\"create-new-form\")?.reset();\n      }, 3000);\n    }\n    if (data?.heading) {\n      setFormValues({\n        title: \"\",\n        image: \"test Image\",\n      });\n      setEditorState(EditorState.createEmpty());\n      setFiles([]);\n    }\n    setLoading(false);\n  };\n\n  const handleChange = (e) => {\n    const { name, value } = e.target;\n    setErrors({ ...errors, [name]: undefined });\n    if (name === \"image\") {\n      setFiles(e.target.files);\n    } else {\n      setFormValues((prevState) => ({\n        ...prevState,\n        [name]: value,\n      }));\n    }\n  };\n\n  const onEditorStateChange = (e) => {\n    setErrors({ ...errors, description: undefined });\n    setEditorState(e);\n  };\n\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"Create\" motherMenu=\"News\" />\n      <div className=\"row\">\n        <div className=\"col-xl-12 col-lg-12\">\n          <div className=\"card\">\n            <div className=\"card-header\">\n              <h4 className=\"card-title\">Create News</h4>\n            </div>\n            <div className=\"card-body\">\n              <div className=\"basic-form\">\n                <form\n                  id=\"create-news-form\"\n                  onSubmit={(e) => {\n                    handleSubmit(e);\n                  }}\n                >\n                  <div className=\"form-group\">\n                    <input\n                      type=\"text\"\n                      className=\"form-control input-default \"\n                      name=\"title\"\n                      placeholder=\"Title\"\n                      value={formValues.title}\n                      onChange={(e) => {\n                        handleChange(e);\n                      }}\n                    />\n                    {errors.title && (\n                      <span className=\"error\">{\"Title is required\"}</span>\n                    )}\n                  </div>\n\n                  <div className=\"input-group\">\n                    <div className=\"custom-file\">\n                      <input\n                        name=\"image\"\n                        type=\"file\"\n                        className=\"custom-file-input\"\n                        onChange={handleChange}\n                        accept=\".png, .jpg, .jpeg, .webp\"\n                      />\n                      <label className=\"custom-file-label\">\n                        {files && files[0]\n                          ? files && files[0]?.name\n                          : `Choose file`}\n                      </label>\n                    </div>\n                  </div>\n                  {errors.image && (\n                    <span className=\"error\">{\"Valid Image is required\"}</span>\n                  )}\n                  <div className=\"mt-3 mt-sm-10\">\n                    <ButtonLoader\n                      loader={loading}\n                      title={\"Create Blog\"}\n                      classes=\"btn btn-primary mb-2\"\n                      disabled={loading}\n                    />\n                  </div>\n                </form>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </Fragment>\n  );\n};\n\nexport default NewsForm;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/ProductDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/UsersGrid.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductList/ProductList.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/Checkout/Checkout.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/RequestedUpcomingLauncherGrid.js",["1208","1209","1210","1211","1212","1213","1214","1215"],"import React, { Fragment, useEffect, useState } from \"react\";\n// import Products from \"./Products\";\nimport { useDispatch, useSelector } from \"react-redux\";\n/// Data\n// import productData from \"../productData\";\nimport PageTitle from \"../../../../layouts/PageTitle\";\nimport {\n  getAllFeaturedCollection,\n  getAllRequestedApprovalLaunchers,\n} from \"../../../../../store/reducers/collectionReducer\";\nimport PageLoader from \"../../../common/pageLoader\";\nimport SearchField from \"../../../common/searchFiled\";\nimport SelectOptionField from \"../../../common/selectOptionField\";\nimport Pagination from \"../../../common/pagination\";\nimport FeaturedCollectionListing from \"../../../listingTable/FeaturedCollectionListing\";\nimport RequestedApprovalLaunchers from \"../../../listingTable/RequestedApprovalLaunchers\";\n\nconst RequestedUpcomingLauncherGrid = () => {\n  const [loader, setLoader] = useState({ data: true, filter: false });\n  const [searchText, setSearchText] = useState(\"\");\n  const [filter, setFilter] = useState(\"\");\n  const [page, setPage] = useState(0);\n\n  const limit = 20;\n  const dispatch = useDispatch();\n\n  const options = [\n    {\n      label: \"Select Option\",\n      value: \"\",\n    },\n    {\n      label: \"Verified\",\n      value: true,\n    },\n    {\n      label: \"Unverified\",\n      value: false,\n    },\n  ];\n\n  const handleSearch = () => {\n    setLoader({ data: true, filter: true });\n    getCollectionListing({\n      search: searchText,\n      isVerified: filter || undefined,\n      page: 1,\n    });\n  };\n\n  const handleChange = (e) => {\n    if (!e.target.value || e.target.value.trim() === null) {\n      setLoader({ data: true, filter: true });\n      setSearchText(e.target.value);\n      return getCollectionListing({\n        search: \"\",\n        // isVerified: filter || undefined,\n        page: 1,\n      });\n    }\n    setSearchText(e.target.value);\n  };\n\n  const getCollectionListing = async ({ search, isVerified, page }) => {\n    await dispatch(getAllRequestedApprovalLaunchers({ search, page, limit }));\n    setLoader({ data: false, filter: false });\n  };\n\n  const ApplyFilter = (e) => {\n    setLoader({ data: true, filter: true });\n    setFilter(e.target.value);\n    return getCollectionListing({\n      //   search: searchText,\n      //   isVerified:\n      //     !e.target.value || e.target.value === \"\" ? undefined : e.target.value,\n      page: 1,\n    });\n  };\n\n  useEffect(() => {\n    setLoader({ data: true, filter: true });\n    getCollectionListing({\n      //   search: searchText,\n      //   isVerified: undefined,\n      page: 1,\n    });\n\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  const handlePageClick = (e) => {\n    setLoader({ data: true, filter: false });\n    setPage(e.selected);\n    return getCollectionListing({\n      search: searchText,\n      isVerified: filter || undefined,\n      page: e.selected + 1,\n    });\n  };\n\n  const data = useSelector(\n    (state) => state.collectionReducer.launchersCollection\n  );\n\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"listing\" motherMenu=\"Featued Collection\" />\n      {loader.data ? (\n        <PageLoader />\n      ) : (\n        <div className=\"row justify-content-end\">\n          {/* <SelectOptionField\n            onChange={ApplyFilter}\n            filter={filter}\n            options={options}\n          /> */}\n          {/* <SearchField\n            onChange={handleChange}\n            searchText={searchText}\n            handleSearch={handleSearch}\n          /> */}\n          <RequestedApprovalLaunchers\n            limit={limit}\n            page={page}\n            tabledata={data?.docs}\n          />\n        </div>\n      )}\n      {data?.totalDocs && !loader?.filter && (\n        <div>\n          Showing {limit * page + 1} to{\" \"}\n          {data?.totalDocs < limit ? data?.totalDocs : limit * (page + 1)} {\"\"}\n          of {data?.totalDocs} entries\n          {\n            <Pagination\n              handlePageClick={handlePageClick}\n              totalDocs={data?.totalDocs}\n            />\n          }\n        </div>\n      )}\n    </Fragment>\n  );\n};\n\nexport default RequestedUpcomingLauncherGrid;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Email/Compose/Compose.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Email/Inbox/Inbox.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Email/Read/Read.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/AppProfile/AppProfile.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/CollectionGrid.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/AppProfile/PostDetails.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/FeaturedCollectionGrid.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/Invoice/Invoice.js",["1216"],"import React, { Fragment } from \"react\";\nimport PageTitle from \"../../../../layouts/PageTitle\";\nimport QrCode from \"../../../../../images/qr.png\";\nimport Logo1 from \"../../../../../images/logo.png\";\nimport LogoText from \"../../../../../images/logo-text.png\";\n\n\nconst Invoice = () => {\n   return (\n      <Fragment>\n         <PageTitle motherMenu=\"Layout\" activeMenu=\"Blank\" />\n\n         <div className=\"row\">\n            <div className=\"col-lg-12\">\n               <div className=\"card mt-3\">\n                  <div className=\"card-header\">\n                     {\" \"}\n                     Invoice <strong>01/01/01/2018</strong>{\" \"}\n                     <span className=\"float-right\">\n                        <strong>Status:</strong> Pending\n                     </span>{\" \"}\n                  </div>\n                  <div className='card-body'>\n\t\t\t\t\t<div className=\"row\">\n\t\t\t\t\t\t<div className=\"col-xl-3 col-sm-6 mb-4\">\n\t\t\t\t\t\t\t<h6>From:</h6>\n\t\t\t\t\t\t\t<div> <strong>Webz Poland</strong> </div>\n\t\t\t\t\t\t\t<div>Madalinskiego 8</div>\n\t\t\t\t\t\t\t<div>71-101 Szczecin, Poland</div>\n\t\t\t\t\t\t\t<div>Email: info@example.com</div>\n\t\t\t\t\t\t\t<div>Phone: +91 987 654 3210</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div className=\"col-xl-3 col-sm-6 mb-4\">\n\t\t\t\t\t\t\t<h6>To:</h6>\n\t\t\t\t\t\t\t<div> <strong>Bob Mart</strong> </div>\n\t\t\t\t\t\t\t<div>Attn: Daniel Marek</div>\n\t\t\t\t\t\t\t<div>43-190 Mikolow, Poland</div>\n\t\t\t\t\t\t\t<div>Email: info@example.com</div>\n\t\t\t\t\t\t\t<div>Phone: +91 987 654 3210</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div className=\"col-xl-6 col-lg-9 col-md-12 col-sm-12 mb-4 d-flex justify-content-lg-end justify-content-md-center justify-content-xs-start\">\n\t\t\t\t\t\t\t<div className=\"row align-items-center\">\n\t\t\t\t\t\t\t\t<div className=\"col-sm-9\"> \n\t\t\t\t\t\t\t\t\t<div className=\"brand-logo mb-3\">\n\t\t\t\t\t\t\t\t\t\t<img className=\"logo-abbr mr-2\" width=\"50\" src={Logo1} alt=\"\"/>\n\t\t\t\t\t\t\t\t\t\t<img className=\"logo-compact\" width=\"110\" src={LogoText} alt=\"\"/>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<span>Please send exact amount: <strong className=\"d-block\">0.15050000 BTC</strong>\n\t\t\t\t\t\t\t\t\t\t<strong>1DonateWffyhwAjskoEwXt83pHZxhLTr8H</strong></span><br/>\n\t\t\t\t\t\t\t\t\t<small className=\"text-muted\">Current exchange rate 1BTC = $6590 USD</small>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div className=\"col-sm-3 mt-3\"> <img src={QrCode} className=\"img-fluid width110\"/> </div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n                     <div className=\"table-responsive\">\n                        <table className=\"table table-striped\">\n                           <thead>\n                              <tr>\n                                 <th className=\"center\">#</th>\n                                 <th>Item</th>\n                                 <th>Description</th>\n                                 <th className=\"right\">Unit Cost</th>\n                                 <th className=\"center\">Qty</th>\n                                 <th className=\"right\">Total</th>\n                              </tr>\n                           </thead>\n                           <tbody>\n                              <tr>\n                                 <td className=\"center\">1</td>\n                                 <td className=\"left strong\">Origin License</td>\n                                 <td className=\"left\">Extended License</td>\n                                 <td className=\"right\">$999,00</td>\n                                 <td className=\"center\">1</td>\n                                 <td className=\"right\">$999,00</td>\n                              </tr>\n                              <tr>\n                                 <td className=\"center\">2</td>\n                                 <td className=\"left\">Custom Services</td>\n                                 <td className=\"left\">\n                                    Instalation and Customization (cost per\n                                    hour)\n                                 </td>\n                                 <td className=\"right\">$150,00</td>\n                                 <td className=\"center\">20</td>\n                                 <td className=\"right\">$3.000,00</td>\n                              </tr>\n                              <tr>\n                                 <td className=\"center\">3</td>\n                                 <td className=\"left\">Hosting</td>\n                                 <td className=\"left\">1 year subcription</td>\n                                 <td className=\"right\">$499,00</td>\n                                 <td className=\"center\">1</td>\n                                 <td className=\"right\">$499,00</td>\n                              </tr>\n                              <tr>\n                                 <td className=\"center\">4</td>\n                                 <td className=\"left\">Platinum Support</td>\n                                 <td className=\"left\">\n                                    1 year subcription 24/7\n                                 </td>\n                                 <td className=\"right\">$3.999,00</td>\n                                 <td className=\"center\">1</td>\n                                 <td className=\"right\">$3.999,00</td>\n                              </tr>\n                           </tbody>\n                        </table>\n                     </div>\n                     <div className=\"row\">\n                        <div className=\"col-lg-4 col-sm-5\"> </div>\n                        <div className=\"col-lg-4 col-sm-5 ml-auto\">\n                           <table className=\"table table-clear\">\n                              <tbody>\n                                 <tr>\n                                    <td className=\"left\">\n                                       <strong>Subtotal</strong>\n                                    </td>\n                                    <td className=\"right\">$8.497,00</td>\n                                 </tr>\n                                 <tr>\n                                    <td className=\"left\">\n                                       <strong>Discount (20%)</strong>\n                                    </td>\n                                    <td className=\"right\">$1,699,40</td>\n                                 </tr>\n                                 <tr>\n                                    <td className=\"left\">\n                                       <strong>VAT (10%)</strong>\n                                    </td>\n                                    <td className=\"right\">$679,76</td>\n                                 </tr>\n                                 <tr>\n                                    <td className=\"left\">\n                                       <strong>Total</strong>\n                                    </td>\n                                    <td className=\"right\">\n                                       <strong>$7.477,36</strong>\n                                       <br />\n                                       <strong>0.15050000 BTC</strong>\n                                    </td>\n                                 </tr>\n                              </tbody>\n                           </table>\n                        </div>\n                     </div>\n                  </div>\n               </div>\n            </div>\n         </div>\n      </Fragment>\n   );\n};\n\nexport default Invoice;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/listings/Nft/NftListing.js",["1217"],"import React, { Fragment, useEffect, useState } from \"react\";\nimport PageTitle from \"../../../layouts/PageTitle\";\n// import DataTable from \"../../Dashboard/DataTable\";\nimport NftListingTable from \"../../listingTable/NftListingTable\";\nimport { useDispatch, useSelector } from 'react-redux'\nimport { getAllNft, getSearchedNft } from '../../../../store/reducers/nftReducer';\nimport PageLoader from \"../../common/pageLoader\";\nimport SearchField from \"../../common/searchFiled\";\nimport SelectOptionField from \"../../common/selectOptionField\";\nimport Pagination from '../../common/pagination';\n\nconst NftListing = () => {\n   const [loader, setLoader] = useState({ data: true, filter: false });\n   const [searchText, setSearchText] = useState({ name: '' })\n   const [filter, setFilter] = useState('');\n   const [page, setPage] = useState(0);\n   const [activeSeach, setActiveSearch] = useState(false);\n   const filterDefaultState = { status: \"active\", range: { min: \"\", max: \"\" }, value: \"All\", type: {} }\n   const [listingFilter, setListingFilter] = useState({ status: \"active\", range: { min: \"\", max: \"\" }, value: \"All\", type: {} });\n   const limit = 20;\n   const dispatch = useDispatch();\n   const getNftListing = async ({ search, page, filter }) => {\n      await dispatch(getAllNft({ search, limit, page, filter }))\n      setLoader({ data: false, filter: false })\n   }\n\n\n   const options = [\n      {\n         label: 'Select Option',\n         value: ''\n      },\n      {\n         label: 'Video',\n         value: 'video'\n      },\n      {\n         label: 'Audio',\n         value: 'audio'\n      },\n      {\n         label: 'Image',\n         value: 'image'\n      },\n      {\n         label: '3D',\n         value: '3d'\n      },\n   ]\n\n   const handleSearch = () => {\n      setLoader({ data: true, filter: true });\n      setFilter('');\n      setListingFilter({\n         ...listingFilter,\n         type: {}\n      })\n      searchNft({ search: searchText, page: 1 });\n   }\n\n   const searchNft = async ({ search }) => {\n      console.log('here ')\n      await dispatch(getSearchedNft({ filter: search }))\n      setLoader({ false: true, filter: false });\n   }\n\n   const handleChange = (e) => {\n      let search = {\n         ...searchText,\n         name: e.target.value\n      }\n      if (!e.target.value || e.target.value.trim() === null) {\n         setLoader({ data: true, filter: true });\n         getNftListing({ filter: filterDefaultState, page: 1 });\n      }\n      setSearchText(search);\n   }\n\n   const ApplyFilter = (e) => {\n      setFilter(e.target.value);\n      setLoader({ data: true, filter: true });\n      setActiveSearch(false);\n      setSearchText({ name: '' })\n      if (e.target.value !== '') {\n         let val = e.target.value;\n         if (e.target.value === '3d') {\n            val = 'vr'\n         }\n\n         const filterObj = {\n            ...listingFilter, type: { \"nftId.properties.category\": val }\n         };\n         setListingFilter(filterObj);\n         return getNftListing({ filter: filterObj, page: 1 })\n      }\n      const filterObj = {\n         ...listingFilter, type: {}\n      };\n      setListingFilter(filterObj);\n      return getNftListing({ filter: filterObj, page: 1 })\n   }\n\n   useEffect(() => {\n      setLoader({ data: true, filter: true })\n      getNftListing({ filter: listingFilter, page: 1 });\n\n      // eslint-disable-next-line react-hooks/exhaustive-deps\n   }, [])\n\n\n   const handlePageClick = (e) => {\n      setLoader({ data: true, filter: false })\n      setPage(e.selected)\n      return getNftListing({ filter: listingFilter, page: e.selected + 1 })\n   }\n\n   const data = useSelector((state) => state.nftReducer.nfts);\n   return (\n      <Fragment>\n         <PageTitle activeMenu=\"Listing\" motherMenu=\"NFT\" />\n         {\n            loader?.data ? <PageLoader /> :\n               <div className=\"row justify-content-end\">\n                  <SelectOptionField onChange={ApplyFilter} filter={filter} options={options} />\n                  <SearchField onChange={handleChange} searchText={searchText.name} handleSearch={handleSearch} />\n                  {data && <NftListingTable limit={limit} page={page} tabledata={data?.docs || data} />}\n               </div>\n         }\n         {(data?.totalDocs && !loader?.filter) && <div>\n            Showing {(limit * page) + 1} to{\" \"}\n            {data?.totalDocs < limit ? data?.totalDocs : limit * (page + 1)} {\"\"}\n            of {data?.totalDocs} entries\n            {<Pagination handlePageClick={handlePageClick} totalDocs={data?.totalDocs} />}\n         </div>\n         }\n\n\n\n      </Fragment>\n   );\n};\n\nexport default NftListing;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Forms/ImportCollections/ImportCollection.js",["1218","1219","1220","1221","1222","1223"],"import React, { Fragment, useEffect, useState } from \"react\";\n\n// import Multistep from \"react-multistep\";\nimport DropdownMultiselect from \"react-multiselect-dropdown-bootstrap\";\nimport axios from \"axios\";\nimport { useDispatch } from \"react-redux\";\nimport { Alert } from \"react-bootstrap\";\n\nimport PageTitle from \"../../../layouts/PageTitle\";\nimport { alert } from \"../../../../store/reducers/alertSlice\";\nimport { addFraction } from \"../../../../store/reducers/fractionReducer\";\nimport { FontAwesomeIcon } from \"@fortawesome/react-fontawesome\";\nimport { faXmark } from \"@fortawesome/free-solid-svg-icons\";\nimport ButtonLoader from \"../../common/buttonLoader\";\n\nconst ImportCollections = () => {\n  const dispatch = useDispatch();\n  const [collectionDetails, setCollectionDetails] = useState({});\n\n  const [loading, setLoading] = useState(false);\n\n  const onInputValueChange = (e) => {\n    e.preventDefault();\n    setCollectionDetails({\n      ...collectionDetails,\n      [e.target.name]: e.target.value,\n    });\n  };\n\n  const handleSubmit = async (event) => {\n    event.preventDefault();\n    try {\n      console.log(\n        \"🚀 ~ file: ImportCollection.js:19 ~ ImportCollections ~ collectionDetails\",\n        collectionDetails\n      );\n\n      if (\n        !collectionDetails?.contractAddress ||\n        !collectionDetails?.avatar ||\n        !collectionDetails?.cover ||\n        !collectionDetails?.name ||\n        !collectionDetails?.blockchain\n      ) {\n        throw new Error(\"Some information is misisng\");\n      }\n      setLoading(true);\n\n      const authToken = (await localStorage.getItem(\"authToken\")) || \"\";\n      let res = await axios({\n        method: \"post\",\n        url: `${process.env.REACT_APP_BASE_URL}importcollection/addImportedCollection`,\n        data: collectionDetails,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n\n      if (res?.data?.success) {\n        dispatch(\n          alert({\n            title: `Success`,\n            message: res?.data?.message,\n            severity: \"success\",\n          })\n        );\n        setCollectionDetails({});\n        return;\n      }\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `failed`,\n          message: error.message || `failed to update System Setting`,\n          severity: \"error\",\n        })\n      );\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"form\" motherMenu=\"Import Collections\" />\n      <div className=\"row\">\n        <div className=\"col-xl-12 col-xxl-12\">\n          <div className=\"card\">\n            <div className=\"card-header\">\n              <h4 className=\"card-title\">Import Collection</h4>\n            </div>\n            <div className=\"card-body\">\n              <form\n                onSubmit={(e) => handleSubmit(e)}\n                id=\"step-form-horizontal\"\n                className=\"step-form-horizontal\"\n              >\n                <div className=\"row\">\n                  <div className=\"col-lg-6 mb-2 align-left\">\n                    <div\n                      className=\"form-group align-left\"\n                      style={{ textAlign: \"left\" }}\n                    >\n                      <label className=\"text-label\">Collection Name</label>\n                      <input\n                        type=\"text\"\n                        name=\"name\"\n                        className=\"form-control\"\n                        placeholder=\"Collection Name\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={collectionDetails?.name || \"\"}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Collection Description\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"description\"\n                        className=\"form-control\"\n                        placeholder=\"Description\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={collectionDetails?.description || \"\"}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Collection Contract Address\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"contractAddress\"\n                        className=\"form-control\"\n                        placeholder=\"Contract Address\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={collectionDetails?.contractAddress || \"\"}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Collection Blockchain (eth, bsc & polygon)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"blockchain\"\n                        className=\"form-control\"\n                        placeholder=\"Collection Blockchain\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={collectionDetails?.blockchain || \"\"}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Collection Avatar Link\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"avatar\"\n                        className=\"form-control\"\n                        placeholder=\"Collection Avatar URL\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={collectionDetails?.avatar || \"\"}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Collection Cover Link\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"cover\"\n                        className=\"form-control\"\n                        placeholder=\"Collection Cover URL\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={collectionDetails?.cover || \"\"}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-lg-6 mb-2\">\n                  <ButtonLoader\n                    loader={loading}\n                    title={\"Import Collection\"}\n                    classes=\"btn btn-primary mb-2\"\n                    disabled={loading}\n                  />\n                </div>\n              </form>\n            </div>\n          </div>\n        </div>\n      </div>\n    </Fragment>\n  );\n};\n\nexport default ImportCollections;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/Customers/Customers.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/PageTitle.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/common/buttonLoader.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/common/selectOptionField.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/common/searchFiled.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/common/pageLoader.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/common/pagination.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/nav/index.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/listingTable/NftListingTable.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/listingTable/FeaturedCollectionListing.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/listingTable/CollectionListing.js",["1224"],"import { Dropdown } from \"react-bootstrap\";\nimport VerifiedUser from \"@material-ui/icons/VerifiedUser\";\nimport { useHistory } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport {\n  changeCollectionStatus,\n  updateCollectionStatus,\n  changeCollectionActivation,\n  makeCollectionFeatured,\n} from \"../../../store/reducers/collectionReducer\";\n\nconst NftListingTable = ({ tabledata, page, limit }) => {\n  const history = useHistory();\n  const collectionData = useSelector(\n    (state) => state.collectionReducer.collections\n  );\n\n  const dispatch = useDispatch();\n\n  const changeStatus = async (rowData) => {\n    const updatedCollections = collectionData?.docs?.map((el) =>\n      rowData?._id === el?._id ? { ...el, isVerified: !el?.isVerified } : el\n    );\n    const collection = await dispatch(\n      changeCollectionStatus({\n        id: rowData?._id,\n        isVerified: !rowData?.isVerified,\n      })\n    );\n    if (collection?._id) {\n      dispatch(\n        updateCollectionStatus({ ...collectionData, docs: updatedCollections })\n      );\n    }\n  };\n\n  const changeActivation = async (rowData) => {\n    const updatedCollections = collectionData?.docs?.map((el) =>\n      rowData?._id === el?._id ? { ...el, isActive: !el?.isActive } : el\n    );\n    const collection = await dispatch(\n      changeCollectionActivation({\n        id: rowData?._id,\n        status: !rowData?.isActive,\n      })\n    );\n    if (collection?.success) {\n      dispatch(\n        updateCollectionStatus({ ...collectionData, docs: updatedCollections })\n      );\n    }\n  };\n\n  // const changeFeatured = async (rowData) => {\n  //   const updatedCollections = collectionData?.docs?.map((el) =>\n  //     rowData?._id === el?._id ? { ...el, featured: !el?.featured } : el\n  //   );\n\n  //   const updateFeatured = await dispatch(\n  //     makeCollectionFeatured(rowData?._id, !rowData?.featured)\n  //   );\n\n  //   if (updateFeatured?.success) {\n  //     dispatch(\n  //       updateCollectionStatus({ ...collectionData, docs: updatedCollections })\n  //     );\n  //   }\n  // };\n\n  return (\n    <>\n      <div className=\"table-responsive\">\n        <div className=\"dataTables_wrapper no-footer\">\n          <table\n            id=\"spendingTable\"\n            className=\"display mb-4 dataTablesCard card-table dataTable no-footer\"\n            style={{ width: \"100%\" }}\n          >\n            <thead>\n              <tr role=\"row\">\n                <th\n                  className=\"pr-0 no-data-img all_spending_strg\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-sort=\"ascending\"\n                  style={{ width: 32 }}\n                >\n                  No.\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Name\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Description\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Verified\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Image\n                </th>\n\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                ></th>\n              </tr>\n            </thead>\n            <tbody>\n              {tabledata &&\n                tabledata?.map((row, index) => {\n                  return (\n                    <tr role=\"row\" className=\"odd\">\n                      <td className=\"pr-0 all_spending_checkbox\">\n                        <strong>{limit * page + index + 1}</strong>\n                      </td>\n\n                      <td>{row?.fullName || \"\"}</td>\n                      <td\n                        style={{\n                          display: \"inline-block\",\n                          width: 300,\n                          whiteSpace: \"nowrap\",\n                          overflow: \"hidden\",\n                          textOverflow: \"ellipsis\",\n                        }}\n                      >\n                        {row?.description}...\n                      </td>\n                      <td>{`${row?.isVerified}` || \"false\"}</td>\n                      <td>{<img src={row?.avatar} width={60} alt=\"\" />}</td>\n\n                      <td>\n                        <Dropdown className=\"dropdown ml-auto\">\n                          <Dropdown.Toggle\n                            variant=\"\"\n                            className=\"icon-false p-0 btn-link\"\n                            data-toggle=\"dropdown\"\n                          >\n                            <svg\n                              width={24}\n                              height={24}\n                              viewBox=\"0 0 24 24\"\n                              fill=\"none\"\n                              xmlns=\"http://www.w3.org/2000/svg\"\n                            >\n                              <path\n                                d=\"M11.0005 12C11.0005 12.5523 11.4482 13 12.0005 13C12.5528 13 13.0005 12.5523 13.0005 12C13.0005 11.4477 12.5528 11 12.0005 11C11.4482 11 11.0005 11.4477 11.0005 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                              />\n                              <path\n                                d=\"M18.0005 12C18.0005 12.5523 18.4482 13 19.0005 13C19.5528 13 20.0005 12.5523 20.0005 12C20.0005 11.4477 19.5528 11 19.0005 11C18.4482 11 18.0005 11.4477 18.0005 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                              />\n                              <path\n                                d=\"M4.00049 12C4.00049 12.5523 4.4482 13 5.00049 13C5.55277 13 6.00049 12.5523 6.00049 12C6.00049 11.4477 5.55277 11 5.00049 11C4.4482 11 4.00049 11.4477 4.00049 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                              />\n                            </svg>\n                          </Dropdown.Toggle>\n                          <Dropdown.Menu className=\"dropdown-menu dropdown-menu-right\">\n                            {/* <Dropdown.Item\n                              className=\"dropdown-item text-black\"\n                              onClick={() => changeFeatured(row)}\n                            >\n                              <VerifiedUser\n                                className={`${\n                                  row?.featured ? \"text-success\" : \"text-danger\"\n                                } mr-3`}\n                              />\n                              {row?.featured\n                                ? \"Remove from Featured\"\n                                : \"Make it Featured\"}\n                            </Dropdown.Item> */}\n                            <Dropdown.Item\n                              className=\"dropdown-item text-black\"\n                              onClick={() => changeStatus(row)}\n                            >\n                              <VerifiedUser\n                                className={`${\n                                  row?.isVerified\n                                    ? \"text-success\"\n                                    : \"text-danger\"\n                                } mr-3`}\n                              />\n                              {row?.isVerified\n                                ? \"Un Verify Collection\"\n                                : \"Verify Collection\"}\n                            </Dropdown.Item>\n\n                            <Dropdown.Item\n                              className=\"dropdown-item text-black\"\n                              onClick={() => changeActivation(row)}\n                            >\n                              <VerifiedUser\n                                className={`${\n                                  row?.isActive ? \"text-danger\" : \"text-success\"\n                                } mr-3`}\n                              />\n                              {row?.isActive\n                                ? \"De-Activate Collection\"\n                                : \"Activate Collection\"}\n                            </Dropdown.Item>\n\n                            <Dropdown.Item\n                              className=\"dropdown-item text-black\"\n                              onClick={() =>\n                                history.push({\n                                  pathname: `/collection-detail/${row?._id}`,\n                                })\n                              }\n                            >\n                              <svg\n                                className=\"mr-3\"\n                                width={24}\n                                height={24}\n                                viewBox=\"0 0 24 24\"\n                                fill=\"none\"\n                                xmlns=\"http://www.w3.org/2000/svg\"\n                              >\n                                <path\n                                  d=\"M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z\"\n                                  stroke=\"#6F6F6F\"\n                                  strokeWidth={2}\n                                  strokeLinecap=\"round\"\n                                  strokeLinejoin=\"round\"\n                                />\n                                <path\n                                  d=\"M12 16V12\"\n                                  stroke=\"#6F6F6F\"\n                                  strokeWidth={2}\n                                  strokeLinecap=\"round\"\n                                  strokeLinejoin=\"round\"\n                                />\n                                <path\n                                  d=\"M12 8H12.01\"\n                                  stroke=\"#6F6F6F\"\n                                  strokeWidth={2}\n                                  strokeLinecap=\"round\"\n                                  strokeLinejoin=\"round\"\n                                />\n                              </svg>\n                              View Details\n                            </Dropdown.Item>\n                          </Dropdown.Menu>\n                        </Dropdown>\n                      </td>\n                    </tr>\n                  );\n                })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default NftListingTable;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Email/Inbox/InboxMessage.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Email/Compose/DropFile.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/listingTable/RequestedApprovalLaunchers.js",["1225","1226","1227"],"import { Dropdown } from \"react-bootstrap\";\nimport VerifiedUser from \"@material-ui/icons/VerifiedUser\";\nimport { useHistory } from \"react-router-dom\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport {\n  changeCollectionStatus,\n  updateFeaturedCollectionStatus,\n  approvedLauncherDrop,\n  updateLauncherCollections,\n  makeCollectionFeatured,\n} from \"../../../store/reducers/collectionReducer\";\n\nconst RequestedApprovalLaunchers = ({ tabledata, page, limit }) => {\n  const history = useHistory();\n  const launcherCollections = useSelector(\n    (state) => state.collectionReducer.launchersCollection\n  );\n  console.log(\n    \"🚀 ~ file: RequestedApprovalLaunchers.js ~ line 18 ~ RequestedApprovalLaunchers ~ launcherCollections\",\n    launcherCollections\n  );\n\n  const dispatch = useDispatch();\n\n  //   const changeStatus = async (rowData) => {\n  //     // const updatedCollections = launcherCollections?.docs?.map((el) =>\n  //     //   rowData?._id === el?._id ? { ...el, isVerified: !el?.isVerified } : el\n  //     // );\n  //     const collection = await dispatch(\n  //       changeCollectionStatus({\n  //         id: rowData?._id,\n  //         isVerified: !rowData?.isVerified,\n  //       })\n  //     );\n  //     if (collection?._id) {\n  //       dispatch(\n  //         updateFeaturedCollectionStatus({\n  //           ...launcherCollections,\n  //           docs: updatedCollections,\n  //         })\n  //       );\n  //     }\n  //   };\n\n  const changeActivation = async (rowData) => {\n    const updatedCollections = launcherCollections?.docs?.map((el) =>\n      rowData?._id === el?._id ? { ...el, isApproved: !el?.isApproved } : el\n    );\n    console.log(\n      \"🚀 ~ file: RequestedApprovalLaunchers.js ~ line 45 ~ changeActivation ~ updatedCollections\",\n      updatedCollections\n    );\n    const collection = await dispatch(\n      approvedLauncherDrop({\n        id: rowData?._id,\n        isApproved: !rowData?.isApproved,\n      })\n    );\n    if (collection?.success) {\n      dispatch(\n        updateLauncherCollections({\n          ...launcherCollections,\n          docs: updatedCollections,\n        })\n      );\n    }\n  };\n\n  return (\n    <>\n      <div className=\"table-responsive\">\n        <div className=\"dataTables_wrapper no-footer\">\n          <table\n            id=\"spendingTable\"\n            className=\"display mb-4 dataTablesCard card-table dataTable no-footer\"\n            style={{ width: \"100%\" }}\n          >\n            <thead>\n              <tr role=\"row\">\n                <th\n                  className=\"pr-0 no-data-img all_spending_strg\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-sort=\"ascending\"\n                  style={{ width: 32 }}\n                >\n                  No.\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Name\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Description\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Verified\n                </th>\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                >\n                  Image\n                </th>\n\n                <th\n                  className=\"sorting\"\n                  tabIndex={0}\n                  aria-controls=\"example5\"\n                  rowSpan={1}\n                  colSpan={1}\n                  aria-label=\"Date Published: activate to sort column ascending\"\n                  style={{ width: 124 }}\n                ></th>\n              </tr>\n            </thead>\n            <tbody>\n              {tabledata &&\n                tabledata?.map((row, index) => {\n                  return (\n                    <tr role=\"row\" className=\"odd\">\n                      <td className=\"pr-0 all_spending_checkbox\">\n                        <strong>{limit * page + index + 1}</strong>\n                      </td>\n\n                      <td>{row?.collectionId?.fullName || \"\"}</td>\n                      <td\n                        style={{\n                          display: \"inline-block\",\n                          width: 300,\n                          whiteSpace: \"nowrap\",\n                          overflow: \"hidden\",\n                          textOverflow: \"ellipsis\",\n                        }}\n                      >\n                        {row?.collectionId?.description}...\n                      </td>\n                      <td>{`${row?.collectionId?.isVerified}` || \"false\"}</td>\n                      <td>\n                        {\n                          <img\n                            src={row?.collectionId?.avatar}\n                            width={60}\n                            alt=\"\"\n                          />\n                        }\n                      </td>\n\n                      <td>\n                        <Dropdown className=\"dropdown ml-auto\">\n                          <Dropdown.Toggle\n                            variant=\"\"\n                            className=\"icon-false p-0 btn-link\"\n                            data-toggle=\"dropdown\"\n                          >\n                            <svg\n                              width={24}\n                              height={24}\n                              viewBox=\"0 0 24 24\"\n                              fill=\"none\"\n                              xmlns=\"http://www.w3.org/2000/svg\"\n                            >\n                              <path\n                                d=\"M11.0005 12C11.0005 12.5523 11.4482 13 12.0005 13C12.5528 13 13.0005 12.5523 13.0005 12C13.0005 11.4477 12.5528 11 12.0005 11C11.4482 11 11.0005 11.4477 11.0005 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                              />\n                              <path\n                                d=\"M18.0005 12C18.0005 12.5523 18.4482 13 19.0005 13C19.5528 13 20.0005 12.5523 20.0005 12C20.0005 11.4477 19.5528 11 19.0005 11C18.4482 11 18.0005 11.4477 18.0005 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                              />\n                              <path\n                                d=\"M4.00049 12C4.00049 12.5523 4.4482 13 5.00049 13C5.55277 13 6.00049 12.5523 6.00049 12C6.00049 11.4477 5.55277 11 5.00049 11C4.4482 11 4.00049 11.4477 4.00049 12Z\"\n                                stroke=\"#3E4954\"\n                                strokeWidth={2}\n                                strokeLinecap=\"round\"\n                                strokeLinejoin=\"round\"\n                              />\n                            </svg>\n                          </Dropdown.Toggle>\n                          <Dropdown.Menu className=\"dropdown-menu dropdown-menu-right\">\n                            <Dropdown.Item\n                              className=\"dropdown-item text-black\"\n                              onClick={() => changeActivation(row)}\n                            >\n                              <VerifiedUser\n                                className={`${\n                                  row?.isApproved\n                                    ? \"text-danger\"\n                                    : \"text-success\"\n                                } mr-3`}\n                              />\n                              {row?.isApproved ? \"Revoke Approval\" : \"Approve\"}\n                            </Dropdown.Item>\n\n                            <Dropdown.Item\n                              className=\"dropdown-item text-black\"\n                              onClick={() =>\n                                history.push({\n                                  pathname: `/collection-detail/${row?.collectionId?._id}`,\n                                })\n                              }\n                            >\n                              <svg\n                                className=\"mr-3\"\n                                width={24}\n                                height={24}\n                                viewBox=\"0 0 24 24\"\n                                fill=\"none\"\n                                xmlns=\"http://www.w3.org/2000/svg\"\n                              >\n                                <path\n                                  d=\"M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z\"\n                                  stroke=\"#6F6F6F\"\n                                  strokeWidth={2}\n                                  strokeLinecap=\"round\"\n                                  strokeLinejoin=\"round\"\n                                />\n                                <path\n                                  d=\"M12 16V12\"\n                                  stroke=\"#6F6F6F\"\n                                  strokeWidth={2}\n                                  strokeLinecap=\"round\"\n                                  strokeLinejoin=\"round\"\n                                />\n                                <path\n                                  d=\"M12 8H12.01\"\n                                  stroke=\"#6F6F6F\"\n                                  strokeWidth={2}\n                                  strokeLinecap=\"round\"\n                                  strokeLinejoin=\"round\"\n                                />\n                              </svg>\n                              View Details\n                            </Dropdown.Item>\n                          </Dropdown.Menu>\n                        </Dropdown>\n                      </td>\n                    </tr>\n                  );\n                })}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default RequestedApprovalLaunchers;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductList/SingleProductList.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/utils/helper.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/listingTable/UsersListing.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Dashboard/DataTable.js",["1228","1229","1230","1231"],"import React, { useState, useRef, useEffect } from \"react\";\nimport { Table, Pagination, Badge, Dropdown } from \"react-bootstrap\";\nimport image07 from \"../../../images/product/7.jpg\";\n\nimport { Link } from \"react-router-dom\";\n\nconst DataTable = ({tabledata , showWhiteListBtn}) => {\n   const [data, setData] = useState(\n      document.querySelectorAll(\"#spendingTable tbody tr\")\n   );\n   const sort = 5;\n   const activePag = useRef(0);\n   const [test, settest] = useState(0);\n\n   // Active data\n   const chageData = (frist, sec) => {\n      for (var i = 0; i < data.length; ++i) {\n         if (i >= frist && i < sec) {\n            data[i].classList.remove(\"d-none\");\n         } else {\n            data[i].classList.add(\"d-none\");\n         }\n      }\n   };\n   // use effect\n   useEffect(() => {\n      setData(document.querySelectorAll(\"#spendingTable tbody tr\"));\n      chackboxFun();\n   }, [test]);\n\n   // Active pagginarion\n   activePag.current === 0 && chageData(0, sort);\n   // paggination\n   let paggination = Array(Math.ceil(data.length / sort))\n      .fill()\n      .map((_, i) => i + 1);\n\n   // Active paggination & chage data\n   const onClick = (i) => {\n      activePag.current = i;\n      chageData(activePag.current * sort, (activePag.current + 1) * sort);\n      settest(i);\n   };\n   const chackbox = document.querySelectorAll(\".all_spending_checkbox input\");\n   const motherChackBox = document.querySelector(\".all_spending_strg input\");\n   const chackboxFun = (type) => {\n      for (let i = 0; i < chackbox.length; i++) {\n         const element = chackbox[i];\n         if (type === \"all\") {\n            if (motherChackBox.checked) {\n               element.checked = true;\n            } else {\n               element.checked = false;\n            }\n         } else {\n            if (!element.checked) {\n               motherChackBox.checked = false;\n               break;\n            } else {\n               motherChackBox.checked = true;\n            }\n         }\n      }\n   };\n   return (\n      <>\n         <div className=\"table-responsive\">\n            <div className=\"dataTables_wrapper no-footer\">\n               <table\n                  id=\"spendingTable\"\n                  className=\"display mb-4 dataTablesCard card-table dataTable no-footer\"\n                  style={{ width: \"100%\" }}\n               >\n                  <thead>\n                     <tr role=\"row\">\n                        <th\n                           className=\"pr-0 no-data-img all_spending_strg\"\n                           tabIndex={0}\n                           aria-controls=\"example5\"\n                           rowSpan={1}\n                           colSpan={1}\n                           aria-sort=\"ascending\"\n                           style={{ width: 32 }}\n                        >\n                           <div className=\"custom-control custom-checkbox ml-2\">\n                              <input\n                                 type=\"checkbox\"\n                                 onClick={() => chackboxFun(\"all\")}\n                                 className=\"custom-control-input\"\n                                 id=\"checkAll\"\n                                 required\n                              />\n                              <label\n                                 className=\"custom-control-label\"\n                                 htmlFor=\"checkAll\"\n                              />\n                           </div>\n                        </th>\n                        { tabledata && Object.keys(tabledata[0]).map((item) => {\n                    return (\n                             <th\n                                className=\"sorting\"\n                                tabIndex={0}\n                                aria-controls=\"example5\"\n                                rowSpan={1}\n                                colSpan={1}\n                                aria-label=\"Date Published: activate to sort column ascending\"\n                                style={{ width: 124 }}\n                            >\n                                {item}\n                            </th>\n                            )\n                        })}\n                        </tr>\n                  </thead>\n                  <tbody>\n\n                  {tabledata && tabledata.map((row , index ) => {\n                           return(\n                              <tr role=\"row\" className=\"odd\">\n                        <td className=\"pr-0 all_spending_checkbox\">\n                           <div className=\"custom-control custom-checkbox ml-2\">\n                              <input\n                                 type=\"checkbox\"\n                                 onClick={() => chackboxFun()}\n                                 className=\"custom-control-input\"\n                                 id=\"customCheckBox6\"\n                                 required\n                              />\n                              <label\n                                 className=\"custom-control-label\"\n                                 htmlFor=\"customCheckBox6\"\n                              />\n                           </div>\n                        </td>\n                        {\n                    Object.entries(row).map(function(data, index) {\n                        let [key, value] = data;\n                    return(\n                        <td>\n                        {key === 'image' ?  <img src={value && value.includes('http') ? value : image07} width={60} alt=\"\" /> : value }\n                        </td>\n                         )\n                            })}\n                        <td>\n                          {showWhiteListBtn && <td>  <div className=\"btn btn-outline-dark d-block btn-lg\"\n            >\n               White List User\n            </div></td>} \n                           <Dropdown className=\"dropdown ml-auto\">\n                              <Dropdown.Toggle\n                                 variant=\"\"\n                                 className=\"icon-false p-0 btn-link\"\n                                 data-toggle=\"dropdown\"\n                              >\n                                 <svg\n                                    width={24}\n                                    height={24}\n                                    viewBox=\"0 0 24 24\"\n                                    fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\"\n                                 >\n                                    <path\n                                       d=\"M11.0005 12C11.0005 12.5523 11.4482 13 12.0005 13C12.5528 13 13.0005 12.5523 13.0005 12C13.0005 11.4477 12.5528 11 12.0005 11C11.4482 11 11.0005 11.4477 11.0005 12Z\"\n                                       stroke=\"#3E4954\"\n                                       strokeWidth={2}\n                                       strokeLinecap=\"round\"\n                                       strokeLinejoin=\"round\"\n                                    />\n                                    <path\n                                       d=\"M18.0005 12C18.0005 12.5523 18.4482 13 19.0005 13C19.5528 13 20.0005 12.5523 20.0005 12C20.0005 11.4477 19.5528 11 19.0005 11C18.4482 11 18.0005 11.4477 18.0005 12Z\"\n                                       stroke=\"#3E4954\"\n                                       strokeWidth={2}\n                                       strokeLinecap=\"round\"\n                                       strokeLinejoin=\"round\"\n                                    />\n                                    <path\n                                       d=\"M4.00049 12C4.00049 12.5523 4.4482 13 5.00049 13C5.55277 13 6.00049 12.5523 6.00049 12C6.00049 11.4477 5.55277 11 5.00049 11C4.4482 11 4.00049 11.4477 4.00049 12Z\"\n                                       stroke=\"#3E4954\"\n                                       strokeWidth={2}\n                                       strokeLinecap=\"round\"\n                                       strokeLinejoin=\"round\"\n                                    />\n                                 </svg>\n                              </Dropdown.Toggle>\n                              <Dropdown.Menu className=\"dropdown-menu dropdown-menu-right\">\n                                \n                                 <Dropdown.Item className=\"dropdown-item text-black\">\n                                    <svg\n                                       className=\"mr-3\"\n                                       width={24}\n                                       height={24}\n                                       viewBox=\"0 0 24 24\"\n                                       fill=\"none\"\n                                       xmlns=\"http://www.w3.org/2000/svg\"\n                                    >\n                                       <path\n                                          d=\"M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z\"\n                                          stroke=\"#6F6F6F\"\n                                          strokeWidth={2}\n                                          strokeLinecap=\"round\"\n                                          strokeLinejoin=\"round\"\n                                       />\n                                       <path\n                                          d=\"M12 16V12\"\n                                          stroke=\"#6F6F6F\"\n                                          strokeWidth={2}\n                                          strokeLinecap=\"round\"\n                                          strokeLinejoin=\"round\"\n                                       />\n                                       <path\n                                          d=\"M12 8H12.01\"\n                                          stroke=\"#6F6F6F\"\n                                          strokeWidth={2}\n                                          strokeLinecap=\"round\"\n                                          strokeLinejoin=\"round\"\n                                       />\n                                    </svg>\n                                    View Details\n                                 </Dropdown.Item>\n                              </Dropdown.Menu>\n                           </Dropdown>\n                        </td>\n                     </tr>\n                           )\n                        })}\n                        \n                  </tbody>\n               </table>\n               <div className=\"d-sm-flex text-center justify-content-between align-items-center\">\n                  <div className=\"dataTables_info\" id=\"example5_info\">\n                     Showing {activePag.current * sort + 1} to{\" \"}\n                     {data.length > (activePag.current + 1) * sort\n                        ? (activePag.current + 1) * sort\n                        : data.length}{\" \"}\n                     of {data.length} entries\n                  </div>\n                  <div className=\"dataTables_paginate paging_simple_numbers\">\n                     <Link\n                        to=\"/spendings\"\n                        className=\"paginate_button previous disabled\"\n                        aria-controls=\"example5\"\n                        onClick={() =>\n                           activePag.current > 0 &&\n                           onClick(activePag.current - 1)\n                        }\n                     >\n                        Previous\n                     </Link>\n                     <span>\n                        {paggination.map((number, i) => (\n                           <Link\n                              key={i}\n                              to=\"/spendings\"\n                              className={`paginate_button  ${\n                                 activePag.current === i ? \"current\" : \"\"\n                              }`}\n                              onClick={() => onClick(i)}\n                           >\n                              {number}\n                           </Link>\n                        ))}\n                     </span>\n                     <Link\n                        to=\"/spendings\"\n                        className=\"paginate_button next\"\n                        onClick={() =>\n                           activePag.current + 1 < paggination.length &&\n                           onClick(activePag.current + 1)\n                        }\n                     >\n                        Next\n                     </Link>\n                  </div>\n               </div>\n            </div>\n         </div>\n      </>\n   );\n};\n\nexport default DataTable;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/Helper/common.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Calendar/EventCalendar.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/ChatBox.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/nav/Header.js",["1232","1233","1234","1235","1236","1237","1238","1239"],"import React from \"react\";\n\nimport { Link } from \"react-router-dom\";\n/// Scroll\nimport PerfectScrollbar from \"react-perfect-scrollbar\";\n\n/// Image\nimport profile from \"../../../images/profile/pic1.jpg\";\nimport avatar from \"../../../images/avatar/1.jpg\";\nimport { Dropdown } from \"react-bootstrap\";\n// import { useWallet } from \"@solana/wallet-adapter-react\";\nimport ProfileSidebar from \"../ProfileSidebar\";\nimport { getUserBalance } from \"../../../Helper/Balance\";\nconst Header = ({\n  onNote,\n  toggle,\n  onProfile,\n  onNotification,\n  onBox,\n  showProfileSideBar,\n  showProfile,\n}) => {\n  let path = window.location.pathname.split(\"/\");\n  path = path[path.length - 1];\n  path = path === \"\";\n\n  return (\n    <div className=\"header\">\n      <div className=\"header-content\">\n        <nav className=\"navbar navbar-expand\">\n          <div className=\"collapse navbar-collapse justify-content-between\">\n            <div className=\"header-left\">\n              <div className=\"search_bar dropdown show d-none\">\n                <div className=\"dropdown-menu p-0 m-0 show\">\n                  <form onSubmit={(e) => e.preventDefault()}>\n                    <input\n                      className=\"form-control\"\n                      type=\"search\"\n                      placeholder=\"Search Here\"\n                      aria-label=\"Search\"\n                    />\n                  </form>\n                </div>\n                <span\n                  className=\"search_icon p-3 c-pointer\"\n                  data-toggle=\"dropdown\"\n                >\n                  <svg\n                    width={20}\n                    height={20}\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    xmlns=\"http://www.w3.org/2000/svg\"\n                  >\n                    <path\n                      d=\"M23.7871 22.7761L17.9548 16.9437C19.5193 15.145 20.4665 12.7982 20.4665 10.2333C20.4665 4.58714 15.8741 0 10.2333 0C4.58714 0 0 4.59246 0 10.2333C0 15.8741 4.59246 20.4665 10.2333 20.4665C12.7982 20.4665 15.145 19.5193 16.9437 17.9548L22.7761 23.7871C22.9144 23.9255 23.1007 24 23.2816 24C23.4625 24 23.6488 23.9308 23.7871 23.7871C24.0639 23.5104 24.0639 23.0528 23.7871 22.7761ZM1.43149 10.2333C1.43149 5.38004 5.38004 1.43681 10.2279 1.43681C15.0812 1.43681 19.0244 5.38537 19.0244 10.2333C19.0244 15.0812 15.0812 19.035 10.2279 19.035C5.38004 19.035 1.43149 15.0865 1.43149 10.2333Z\"\n                      fill=\"#A4A4A4\"\n                    />\n                  </svg>\n                </span>\n              </div>\n            </div>\n          </div>\n        </nav>\n      </div>\n    </div>\n  );\n};\n\nexport default Header;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/nav/NavHader.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/nav/SideBar.js",["1240","1241","1242","1243"],"import React, { Component } from \"react\";\n\n/// Link\nimport { Link, NavLink } from \"react-router-dom\";\n\n\n/// Scroll\nimport PerfectScrollbar from \"react-perfect-scrollbar\";\n\n/// Menu\nimport MetisMenu from \"metismenujs\";\n\n// import HomeIcon from \"@material-ui/icons/Home\";\n// import List from \"@material-ui/icons/List\";\n// import AttachMoney from \"@material-ui/icons/AttachMoney\";\n// import SwapVerticalCircle from \"@material-ui/icons/SwapVerticalCircle\";\n// import Collections from \"@material-ui/icons/Collections\";\n// import People from \"@material-ui/icons/People\";\n// import Comment from \"@material-ui/icons/Comment\";\n// import MonetizationOn from \"@material-ui/icons/MonetizationOn\";\n// import ListAlt from \"@material-ui/icons/ListAlt\";\n// import MenuBook from \"@material-ui/icons/MenuBook\";\n// import PaidIcon from \"@material-ui/icons/Payment\";\nimport SettingsApplicationsIcon from \"@material-ui/icons/Settings\";\n// import LogoutIcon from '@mui/icons-material/Logout';\n// import Trending from \"@material-ui/icons/TrendingUp\";\n// import ArrowUpward from \"@material-ui/icons/ArrowUpward\";\n// import TagFacesSharp from \"@material-ui/icons/TagFacesSharp\";\n///\n// import drump from \"../../../images/card/drump.png\";\n\nclass MM extends Component {\n  componentDidMount() {\n    this.$el = this.el;\n    this.mm = new MetisMenu(this.$el);\n  }\n  componentWillUnmount() {\n    // this.mm(\"dispose\");\n    // console.log(this.mm);\n  }\n  render() {\n    return (\n      <div className=\"mm-wrapper\">\n        <ul className=\"metismenu\" ref={(el) => (this.el = el)}>\n          {this.props.children}\n        </ul>\n      </div>\n    );\n  }\n}\n\nclass SideBar extends Component {\n  /// Open menu\n  componentDidMount() {\n    // sidebar open/close\n    var btn = document.querySelector(\".nav-control\");\n    var aaa = document.querySelector(\"#main-wrapper\");\n\n    function toggleFunc() {\n      return aaa.classList.toggle(\"menu-toggle\");\n    }\n\n    btn.addEventListener(\"click\", toggleFunc);\n\n    //sidebar icon Heart blast\n    var handleheartBlast = document.querySelector(\".heart\");\n\n    // function heartBlast() {\n    //    return handleheartBlast.classList.toggle(\"heart-blast\");\n    // }\n\n    // handleheartBlast.addEventListener('click', heartBlast);\n  }\n  render() {\n    /// Path\n    var path = window.location.pathname;\n    path = path.split(\"/\");\n    path = path[path.length - 1];\n\n    return (\n      <div className=\"deznav wrapper\">\n        <div className=\"deznav-scroll sidebar\">\n          <ul>\n            {/* <li>\n              <NavLink\n                exact\n                className=\"has-arrow ai-icon\"\n                to=\"/\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <HomeIcon className=\"mr-1 pb-1\" />\n                <span className=\"item\">Dashboard</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"nft-listing\" ? \"mm-active\" : \"\"}`}\n                to=\"/nft-listing\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <List className=\"mr-1 pb-1\" />\n                <span className=\"item\">NFT Listing</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"nft-sales\" ? \"mm-active\" : \"\"}`}\n                to=\"/nft-sales\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <ArrowUpward className=\"mr-1 pb-1\" />\n                <span className=\"item\">NFT Sales</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                to=\"/collection-listing\"\n                className={`${\n                  path === \"collection-listing\" ? \"mm-active\" : \"\"\n                }`}\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <Collections className=\"mr-1 pb-1\" />\n                <span className=\"item\">Collection Listing</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                to=\"/featured-collection-listing\"\n                className={`${\n                  path === \"collection-listing\" ? \"mm-active\" : \"\"\n                }`}\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <Collections className=\"mr-1 pb-1\" />\n                <span className=\"item\">Featured Listing</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                to=\"/launchers-collection-listing\"\n                className={`${\n                  path === \"collection-listing\" ? \"mm-active\" : \"\"\n                }`}\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <Collections className=\"mr-1 pb-1\" />\n                <span className=\"item\">Requested Launchers</span>\n              </NavLink>\n            </li>\n\n            <li>\n              <NavLink\n                exact\n                to=\"/collection-importing\"\n                className={`${\n                  path === \"collection-listing\" ? \"mm-active\" : \"\"\n                }`}\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <Collections className=\"mr-1 pb-1\" />\n                <span className=\"item\">Collection Importing</span>\n              </NavLink>\n            </li>\n\n            <li>\n              <NavLink\n                exact\n                to=\"/auctions-listing\"\n                className={`${path === \"auctions-listing\" ? \"mm-active\" : \"\"}`}\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <ListAlt className=\"mr-1 pb-1\" />\n                <span className=\"item\">Auction Listing</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                to=\"/swapping-revenue\"\n                className={`${path === \"swapping-revenue\" ? \"mm-active\" : \"\"}`}\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <SwapVerticalCircle className=\"mr-1 pb-1\" />\n                <span className=\"item\">Swapping</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"users-listing\" ? \"mm-active\" : \"\"}`}\n                to=\"/users-listing\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <People className=\"mr-1 pb-1\" />\n                <span className=\"item\">Users Listing</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"blogs-listing\" ? \"mm-active\" : \"\"}`}\n                to=\"/blogs-listing\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <MenuBook className=\"mr-1 pb-1\" />\n                <span className=\"item\">Blogs Listing</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"blogs-listing\" ? \"mm-active\" : \"\"}`}\n                to=\"/news-listing\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <MenuBook className=\"mr-1 pb-1\" />\n                <span className=\"item\">News Listing</span>\n              </NavLink>\n            </li> */}\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"system-setting\" ? \"mm-active\" : \"\"}`}\n                to=\"/system-setting\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <SettingsApplicationsIcon className=\"mr-1 pb-1\" />\n                <span className=\"item\">System Setting</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                onClick={()=>{localStorage.removeItem('authToken')}}\n                exact\n                // className={`${path === \"system-setting\" ? \"mm-active\" : \"\"}`}\n                to=\"/page-login\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <SettingsApplicationsIcon className=\"mr-1 pb-1\" sx={{mt:3}}/>\n                <span className=\"item\">Log Out</span>\n\n              </NavLink>\n            </li>\n            {/* <li>\n              <NavLink\n                exact\n                className={`${path === \"tax-payment\" ? \"mm-active\" : \"\"}`}\n                to=\"/tax-payment\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <AttachMoney className=\"mr-1 pb-1\" />\n                <span className=\"item\">Tax Payment</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"faq-listing\" ? \"mm-active\" : \"\"}`}\n                to=\"/faq-listing\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <PaidIcon className=\"mr-1 pb-1\" />\n                <span className=\"item\">FAQ Listing</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"revenue\" ? \"mm-active\" : \"\"}`}\n                to=\"/revenue\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <MonetizationOn className=\"mr-1 pb-1\" />\n                <span className=\"item\">Revenue</span>\n              </NavLink>\n            </li>\n            <li>\n              <NavLink\n                exact\n                className={`${path === \"week-trending\" ? \"mm-active\" : \"\"}`}\n                to=\"/week-trending\"\n                aria-expanded=\"false\"\n                activeClassName=\"selected\"\n              >\n                <Trending className=\"mr-1 pb-1\" />\n                <span className=\"item\">Week Trending</span>\n              </NavLink>\n            </li> */}\n          </ul>\n        </div>\n      </div>\n    );\n  }\n}\n\nexport default SideBar;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/bootstrap/alertData.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Dashboard/SpendingDataTable.js",["1244","1245","1246","1247"],"import React, { useState, useRef, useEffect } from \"react\";\nimport { Table, Pagination, Badge, Dropdown } from \"react-bootstrap\";\n\nimport { Link } from \"react-router-dom\";\n\n\nconst headers = ['Ads ID' , 'Date Published' , 'Yesterday Spending' , 'Today Spending'];\nconst rowData = [['#ADS01231' , '26 March 2020, 12:42 AM' , '$4,521.21' , '$5,415.51'] , ['#ADS01231' , '26 March 2020, 12:42 AM' , '$4,521.21' , '$5,415.51']]\n\nconst SpendingDataTable = () => {\n   const [data, setData] = useState(\n      document.querySelectorAll(\"#spendingTable tbody tr\")\n   );\n   const sort = 5;\n   const activePag = useRef(0);\n   const [test, settest] = useState(0);\n\n   // Active data\n   const chageData = (frist, sec) => {\n      for (var i = 0; i < data.length; ++i) {\n         if (i >= frist && i < sec) {\n            data[i].classList.remove(\"d-none\");\n         } else {\n            data[i].classList.add(\"d-none\");\n         }\n      }\n   };\n   // use effect\n   useEffect(() => {\n      setData(document.querySelectorAll(\"#spendingTable tbody tr\"));\n      chackboxFun();\n   }, [test]);\n\n   // Active pagginarion\n   activePag.current === 0 && chageData(0, sort);\n   // paggination\n   let paggination = Array(Math.ceil(data.length / sort))\n      .fill()\n      .map((_, i) => i + 1);\n\n   // Active paggination & chage data\n   const onClick = (i) => {\n      activePag.current = i;\n      chageData(activePag.current * sort, (activePag.current + 1) * sort);\n      settest(i);\n   };\n   const chackbox = document.querySelectorAll(\".all_spending_checkbox input\");\n   const motherChackBox = document.querySelector(\".all_spending_strg input\");\n   // console.log(document.querySelectorAll(\".all_spending_strg input\")[0].checked);\n   const chackboxFun = (type) => {\n      for (let i = 0; i < chackbox.length; i++) {\n         const element = chackbox[i];\n         if (type === \"all\") {\n            if (motherChackBox.checked) {\n               element.checked = true;\n            } else {\n               element.checked = false;\n            }\n         } else {\n            if (!element.checked) {\n               motherChackBox.checked = false;\n               break;\n            } else {\n               motherChackBox.checked = true;\n            }\n         }\n      }\n   };\n\n   return (\n      <>\n         <div className=\"table-responsive\">\n            <div className=\"dataTables_wrapper no-footer\">\n               <table\n                  id=\"spendingTable\"\n                  className=\"display mb-4 dataTablesCard card-table dataTable no-footer\"\n                  style={{ width: \"100%\" }}\n               >\n                  <thead>\n                     <tr role=\"row\">\n                        <th\n                           className=\"pr-0 no-data-img all_spending_strg\"\n                           tabIndex={0}\n                           aria-controls=\"example5\"\n                           rowSpan={1}\n                           colSpan={1}\n                           aria-sort=\"ascending\"\n                           style={{ width: 32 }}\n                        >\n                           <div className=\"custom-control custom-checkbox ml-2\">\n                              <input\n                                 type=\"checkbox\"\n                                 onClick={() => chackboxFun(\"all\")}\n                                 className=\"custom-control-input\"\n                                 id=\"checkAll\"\n                                 required\n                              />\n                              <label\n                                 className=\"custom-control-label\"\n                                 htmlFor=\"checkAll\"\n                              />\n                           </div>\n                        </th>\n                        {headers.map((item) => {\nreturn (\n   <th\n   className=\"sorting\"\n   tabIndex={0}\n   aria-controls=\"example5\"\n   rowSpan={1}\n   colSpan={1}\n   aria-label=\"Date Published: activate to sort column ascending\"\n   style={{ width: 124 }}\n>\n  {item}\n</th>\n)\n                        })}\n                        </tr>\n                  </thead>\n                  <tbody>\n\n                  {rowData && rowData.map((row , index ) => {\n                           return(\n                              <tr role=\"row\" className=\"odd\">\n                        <td className=\"pr-0 all_spending_checkbox\">\n                           <div className=\"custom-control custom-checkbox ml-2\">\n                              <input\n                                 type=\"checkbox\"\n                                 onClick={() => chackboxFun()}\n                                 className=\"custom-control-input\"\n                                 id=\"customCheckBox6\"\n                                 required\n                              />\n                              <label\n                                 className=\"custom-control-label\"\n                                 htmlFor=\"customCheckBox6\"\n                              />\n                           </div>\n                        </td>\n                        {row && row.map((item) => {\n                           return(\n                              <td>\n                                 {item}\n                              </td>\n                           )\n                        })}\n                        <td>\n                           <Dropdown className=\"dropdown ml-auto\">\n                              <Dropdown.Toggle\n                                 variant=\"\"\n                                 className=\"icon-false p-0 btn-link\"\n                                 data-toggle=\"dropdown\"\n                              >\n                                 <svg\n                                    width={24}\n                                    height={24}\n                                    viewBox=\"0 0 24 24\"\n                                    fill=\"none\"\n                                    xmlns=\"http://www.w3.org/2000/svg\"\n                                 >\n                                    <path\n                                       d=\"M11.0005 12C11.0005 12.5523 11.4482 13 12.0005 13C12.5528 13 13.0005 12.5523 13.0005 12C13.0005 11.4477 12.5528 11 12.0005 11C11.4482 11 11.0005 11.4477 11.0005 12Z\"\n                                       stroke=\"#3E4954\"\n                                       strokeWidth={2}\n                                       strokeLinecap=\"round\"\n                                       strokeLinejoin=\"round\"\n                                    />\n                                    <path\n                                       d=\"M18.0005 12C18.0005 12.5523 18.4482 13 19.0005 13C19.5528 13 20.0005 12.5523 20.0005 12C20.0005 11.4477 19.5528 11 19.0005 11C18.4482 11 18.0005 11.4477 18.0005 12Z\"\n                                       stroke=\"#3E4954\"\n                                       strokeWidth={2}\n                                       strokeLinecap=\"round\"\n                                       strokeLinejoin=\"round\"\n                                    />\n                                    <path\n                                       d=\"M4.00049 12C4.00049 12.5523 4.4482 13 5.00049 13C5.55277 13 6.00049 12.5523 6.00049 12C6.00049 11.4477 5.55277 11 5.00049 11C4.4482 11 4.00049 11.4477 4.00049 12Z\"\n                                       stroke=\"#3E4954\"\n                                       strokeWidth={2}\n                                       strokeLinecap=\"round\"\n                                       strokeLinejoin=\"round\"\n                                    />\n                                 </svg>\n                              </Dropdown.Toggle>\n                              <Dropdown.Menu className=\"dropdown-menu dropdown-menu-right\">\n                                 <Dropdown.Item className=\"dropdown-item text-black\">\n                                    <svg\n                                       className=\"mr-3\"\n                                       width={24}\n                                       height={24}\n                                       viewBox=\"0 0 24 24\"\n                                       fill=\"none\"\n                                       xmlns=\"http://www.w3.org/2000/svg\"\n                                    >\n                                       <path\n                                          d=\"M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z\"\n                                          stroke=\"#6F6F6F\"\n                                          strokeWidth={2}\n                                          strokeLinecap=\"round\"\n                                          strokeLinejoin=\"round\"\n                                       />\n                                       <path\n                                          d=\"M12 16V12\"\n                                          stroke=\"#6F6F6F\"\n                                          strokeWidth={2}\n                                          strokeLinecap=\"round\"\n                                          strokeLinejoin=\"round\"\n                                       />\n                                       <path\n                                          d=\"M12 8H12.01\"\n                                          stroke=\"#6F6F6F\"\n                                          strokeWidth={2}\n                                          strokeLinecap=\"round\"\n                                          strokeLinejoin=\"round\"\n                                       />\n                                    </svg>\n                                    View Details\n                                 </Dropdown.Item>\n                              </Dropdown.Menu>\n                           </Dropdown>\n                        </td>\n                     </tr>\n                           )\n                        })}\n                  </tbody>\n               </table>\n               <div className=\"d-sm-flex text-center justify-content-between align-items-center\">\n                  <div className=\"dataTables_info\" id=\"example5_info\">\n                     Showing {activePag.current * sort + 1} to{\" \"}\n                     {data.length > (activePag.current + 1) * sort\n                        ? (activePag.current + 1) * sort\n                        : data.length}{\" \"}\n                     of {data.length} entries\n                  </div>\n                  <div className=\"dataTables_paginate paging_simple_numbers\">\n                     <Link\n                        to=\"/spendings\"\n                        className=\"paginate_button previous disabled\"\n                        aria-controls=\"example5\"\n                        onClick={() =>\n                           activePag.current > 0 &&\n                           onClick(activePag.current - 1)\n                        }\n                     >\n                        Previous\n                     </Link>\n                     <span>\n                        {paggination.map((number, i) => (\n                           <Link\n                              key={i}\n                              to=\"/spendings\"\n                              className={`paginate_button  ${\n                                 activePag.current === i ? \"current\" : \"\"\n                              }`}\n                              onClick={() => onClick(i)}\n                           >\n                              {number}\n                           </Link>\n                        ))}\n                     </span>\n                     <Link\n                        to=\"/spendings\"\n                        className=\"paginate_button next\"\n                        onClick={() =>\n                           activePag.current + 1 < paggination.length &&\n                           onClick(activePag.current + 1)\n                        }\n                     >\n                        Next\n                     </Link>\n                  </div>\n               </div>\n            </div>\n         </div>\n      </>\n   );\n};\n\nexport default SpendingDataTable;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Dashboard/SnappingToValues.js",["1248","1249"],"import React from \"react\";\nimport Nouislider from \"nouislider-react\";\nimport \"nouislider/distribute/nouislider.css\";\n\nconst COLORS = [\"red\", \"green\", \"blue\"];\nconst colors = [0, 0, 0];\n\nclass NonlinerSliderDashBoard extends React.Component {\n   state = {\n      color: \"rgb(127, 127, 127)\",\n      textValue: null,\n      percent: null,\n      value: 0,\n      disabled: false,\n      range: {\n         min: 0,\n         max: 100,\n      },\n      ref: null,\n   };\n\n   onSlide = (render, handle, value, un, percent) => {\n      // console.log(percent);\n      this.setState({\n         textValue: value[0].toFixed(0),\n         percent: percent[1].toFixed(0),\n      });\n   };\n   render() {\n      const { textValue, percent } = this.state;\n      return (\n         <div className=\"slider\" id=\"NonlinerSliderDashBoard\">\n            <div className=\"inputs mb-4\">\n               <input\n                  className=\"form-control fs-24 text-center text-black\"\n                  type=\"number\"\n                  min={-20}\n                  max={40}\n                  step={1}\n                  id=\"input-number\"\n                  value={`${percent ? percent : 100}.00`}\n                  defaultValue=\"100.00\"\n               />\n            </div>\n            <Nouislider\n               connect\n               start={[0, 100]}\n               behaviour=\"tap\"\n               range={{\n                  min: [0],\n                  max: [100],\n               }}\n               onSlide={this.onSlide}\n            />\n            <div className=\"d-flex align-items-center justify-content-between text-black\">\n               <span>${textValue ? textValue : 0}</span>\n               <span>${percent ? percent : 100}</span>\n            </div>\n         </div>\n      );\n   }\n}\n\nexport default NonlinerSliderDashBoard;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/apexcharts/RadialBar3.js",["1250"],"import React, { Component } from \"react\";\nimport ReactApexChart from \"react-apexcharts\";\n\nclass ApexRedialBar3 extends React.Component {\n   constructor(props) {\n      super(props);\n\n      this.state = {\n         series: [56],\n         options: {\n            chart: {\n               height: 250,\n               type: \"radialBar\",\n               toolbar: {\n                  show: false,\n               },\n            },\n            plotOptions: {\n               radialBar: {\n                  startAngle: -100,\n                  endAngle: 260,\n                  hollow: {\n                     margin: 0,\n                     size: \"70%\",\n                     background: \"#fff\",\n                     image: undefined,\n\n                     imageOffsetX: 0,\n                     imageOffsetY: 0,\n                     position: \"front\",\n                  },\n                  track: {\n                     background: \"#e1e5ff\",\n                     strokeWidth: \"100%\",\n                     margin: 0, // margin is in pixels\n                  },\n\n                  dataLabels: {\n                     show: true,\n                     name: {\n                        offsetY: -10,\n                        show: true,\n                        color: \"#888\",\n                        fontSize: \"17px\",\n                     },\n                     value: {\n                        formatter: function (val) {\n                           return parseInt(val);\n                        },\n                        color: \"#111\",\n                        fontSize: \"36px\",\n                        show: true,\n                     },\n                  },\n               },\n            },\n            fill: {\n               type: \"gradient\",\n               gradient: {\n                  shade: \"dark\",\n                  type: \"horizontal\",\n                  shadeIntensity: 0.5,\n                  gradientToColors: [\"#5856CE\"],\n                  inverseColors: true,\n                  opacityFrom: 1,\n                  opacityTo: 1,\n                  stops: [0, 100],\n               },\n            },\n            stroke: {\n               dashArray: 4,\n            },\n            labels: [\"\"],\n         },\n      };\n   }\n\n   render() {\n      return (\n         <div id=\"chart\">\n            <ReactApexChart\n               options={this.state.options}\n               series={this.state.series}\n               type=\"radialBar\"\n               height={250}\n            />\n         </div>\n      );\n   }\n}\nexport default ApexRedialBar3;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/apexcharts/NagetivePositive3.js",["1251"],"import React, { Component } from \"react\";\nimport ReactApexChart from \"react-apexcharts\";\n\nclass ApexNagetivePosative3 extends React.Component {\n   constructor(props) {\n      super(props);\n\n      this.state = {\n         data: [\n            {\n               series: [\n                  {\n                     name: \"Instagram\",\n                     data: [44, 55, 41, 67, 22, 43, 44, 55],\n                  },\n                  {\n                     name: \"Facebook\",\n                     data: [13, 23, 20, 8, 13, 27, 13, 23],\n                  },\n                  {\n                     name: \"Twitter\",\n                     data: [11, 17, 15, 15, 21, 14, 11, 17],\n                  },\n               ],\n            },\n            {\n               series: [\n                  {\n                     name: \"Instagram\",\n                     data: [\n                        44,\n                        55,\n                        41,\n                        67,\n                        22,\n                        43,\n                        44,\n                        55,\n                        41,\n                        67,\n                        22,\n                        43,\n                        44,\n                        55,\n                        41,\n                     ],\n                  },\n                  {\n                     name: \"Facebook\",\n                     data: [\n                        13,\n                        23,\n                        20,\n                        8,\n                        13,\n                        27,\n                        13,\n                        23,\n                        20,\n                        8,\n                        13,\n                        27,\n                        13,\n                        23,\n                        20,\n                     ],\n                  },\n                  {\n                     name: \"Twitter\",\n                     data: [\n                        11,\n                        17,\n                        15,\n                        15,\n                        21,\n                        14,\n                        11,\n                        17,\n                        15,\n                        15,\n                        21,\n                        14,\n                        15,\n                        15,\n                        21,\n                     ],\n                  },\n               ],\n            },\n         ],\n\n         options: {\n            chart: {\n               type: \"bar\",\n               height: 250,\n               stacked: true,\n               toolbar: {\n                  show: false,\n               },\n            },\n            responsive: [\n               {\n                  breakpoint: 480,\n                  options: {\n                     legend: {\n                        position: \"bottom\",\n                        offsetX: -10,\n                        offsetY: 0,\n                     },\n                  },\n               },\n            ],\n            plotOptions: {\n               bar: {\n                  horizontal: false,\n                  columnWidth: \"20%\",\n                  endingShape: \"rounded\",\n                  backgroundRadius: 10,\n                  colors: {\n                     backgroundBarColors: [\n                        \"#f0f0f0\",\n                        \"#f0f0f0\",\n                        \"#f0f0f0\",\n                        \"#f0f0f0\",\n                        \"#f0f0f0\",\n                        \"#f0f0f0\",\n                        \"#f0f0f0\",\n                     ],\n                     backgroundBarOpacity: 1,\n                     backgroundBarRadius: 5,\n                  },\n               },\n            },\n            colors: [\"#ff285c\", \"#5856ce\", \"#56c7ce\"],\n            xaxis: {\n               show: true,\n\n               axisBorder: {\n                  show: true,\n               },\n\n               labels: {\n                  style: {\n                     colors: \"#333\",\n                     fontSize: \"13px\",\n                     fontFamily: \"Poppins\",\n                     fontWeight: 300,\n                     cssClass: \"apexcharts-xaxis-label\",\n                  },\n               },\n               crosshairs: {\n                  show: false,\n               },\n\n               categories: [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"],\n            },\n            yaxis: {\n               show: false,\n            },\n            grid: {\n               show: false,\n            },\n            toolbar: {\n               enabled: false,\n            },\n            dataLabels: {\n               enabled: false,\n            },\n            legend: {\n               position: \"bottom\",\n               offsetY: 0,\n            },\n            fill: {\n               opacity: 1,\n            },\n         },\n      };\n   }\n\n   render() {\n      return (\n         <div id=\"chart\">\n            <ReactApexChart\n               options={this.state.options}\n               series={\n                  this.state.data[this.props.data ? this.props.data : 0].series\n               }\n               type=\"bar\"\n               height={this.props.height ? this.props.height : 440}\n            />\n         </div>\n      );\n   }\n}\n\nexport default ApexNagetivePosative3;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/apexcharts/RadialBar2.js",["1252"],"import React, { Component } from \"react\";\nimport ReactApexChart from \"react-apexcharts\";\n\nclass ApexRedialBar2 extends React.Component {\n   constructor(props) {\n      super(props);\n\n      this.state = {\n         series: [73, 64, 48],\n         options: {\n            chart: {\n               type: \"radialBar\",\n               //width:320,\n               height: 370,\n               offsetY: 0,\n               offsetX: 0,\n            },\n            plotOptions: {\n               radialBar: {\n                  size: undefined,\n                  inverseOrder: false,\n                  hollow: {\n                     margin: 0,\n                     size: \"30%\",\n                     background: \"transparent\",\n                  },\n\n                  track: {\n                     show: true,\n                     background: \"#e1e5ff\",\n                     strokeWidth: \"10%\",\n                     opacity: 1,\n                     margin: 18, // margin is in pixels\n                  },\n               },\n            },\n            responsive: [\n               {\n                  breakpoint: 480,\n                  options: {\n                     chart: {\n                        offsetY: 0,\n                        offsetX: 0,\n                     },\n                     legend: {\n                        position: \"bottom\",\n                        offsetX: 0,\n                        offsetY: 0,\n                     },\n                  },\n               },\n            ],\n\n            fill: {\n               opacity: 1,\n            },\n\n            colors: [\"#FF285C\", \"#5856CE\", \"#56C7CE\"],\n            labels: [\"Instagram\", \"Facebook\", \"Twitter\"],\n            legend: {\n               fontSize: \"16px\",\n               show: false,\n            },\n         },\n      };\n   }\n\n   render() {\n      return (\n         <div id=\"chart\">\n            <ReactApexChart\n               options={this.state.options}\n               series={this.state.series}\n               type=\"radialBar\"\n               height={this.props.height ? this.props.height : 350}\n            />\n         </div>\n      );\n   }\n}\nexport default ApexRedialBar2;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/PluginsMenu/Select2/MultiSelect.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/donught2.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/RevenueBarChart.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/line8.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/realtime.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/SalesBarChart.js",["1253","1254","1255","1256","1257","1258","1259"],"import React from 'react';\nimport {\n  Chart as ChartJS,\n  CategoryScale,\n  LinearScale,\n  BarElement,\n  Title,\n  Tooltip,\n  Legend,\n} from 'chart.js';\nimport { Line } from 'react-chartjs-2';\n// import faker from 'faker';\n\n// ChartJS.register(\n//   CategoryScale,\n//   LinearScale,\n//   BarElement,\n//   Title,\n//   Tooltip,\n//   Legend\n// );\n\nexport const options = {\n  responsive: true,\n  plugins: {\n    legend: {\n      position: 'top',\n    },\n    title: {\n      display: true,\n      text: 'Chart.js Bar Chart',\n    },\n  },\n};\n\nfunction getDates(startDate, endDate) {\n  const dates = []\n  let currentDate = startDate\n  const addDays = function (days) {\n    const date = new Date(this.valueOf())\n    date.setDate(date.getDate() + days)\n    return date\n  }\n  while (currentDate <= endDate) {\n    let date = new Date(currentDate)\n    // date.toLocaleDateString()\n    dates.push(date.toLocaleDateString())\n    currentDate = addDays.call(currentDate, 1)\n  }\n  return dates\n}\n\n\n// const labels = ['January', 'February', 'March', 'April', 'May', 'June', 'July' , 'August' , 'Septermber' , 'October' , 'November' , 'December' ,'January', 'February', 'March', 'April', 'May', 'June', 'July' , 'August' , 'Septermber' , 'October' , 'November' , 'December' , 'July' , 'August' , 'Septermber' , 'October' , 'November' , 'December'];\n\n// export const data = {\n//   labels,\n//   datasets: [\n//     {\n//       label: 'Monthly Sales',\n//       data: [100 , 150 , 200 , 200 , 120 , 160 , 160 , 100 , 150 , 200 , 200 , 120 , 160 , 160 , 20 , 50],\n//       backgroundColor: 'rgba(255, 99, 132, 0.5)',\n//     },\n//     {\n//       label: 'Weekly Sales Sales',\n//       data: [100 , 150 , 200 , 200 , 120 , 160 , 160 , 0 , 0 , 0 , 0 , 0, 0 , 0 , 0 , 0] ,\n//       backgroundColor: 'rgba(255, 99, 71, 1)',\n//     },\n//   ],\n// };\n\nexport default function App({ da }) {\n  let date = new Date();\n  const labels = getDates(new Date(date.setDate(date.getDate() - 31)), new Date());\n  const statisticData = {\n    labels,\n    datasets: [\n      {\n        label: 'Monthly Sales',\n        data: da.monthlySales,\n        backgroundColor: \"#6455E4\",\n        borderColor: \"#6455E4\",\n      },\n      // {\n      //   label: 'Weekly Sales',\n      //   data: da.weeklySales,\n      //   backgroundColor: \"#59C1FE\",\n      //     borderColor: \"#59C1FE\",\n      // },\n    ],\n  };\n  return <Line options={options} data={statisticData} />;\n}\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/bar2.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/line6.js",["1260"],"import React, { Component } from \"react\";\nimport { Line } from \"react-chartjs-2\";\n\nclass LineChart6 extends Component {\n   render() {\n      const data = {\n         labels: [\n            \"January\",\n            \"February\",\n            \"March\",\n            \"April\",\n            \"May\",\n            \"June\",\n            \"July\",\n         ],\n         datasets: [\n            {\n               label: \"My First dataset\",\n               data: [28, 35, 36, 48, 46, 42, 60],\n               backgroundColor: \"#ffff\",\n               borderColor: this.props.color ? this.props.color : \"#5514A4\",\n               borderWidth: 0,\n               strokeColor: this.props.color ? this.props.color : \"#5514A4\",\n               capBezierPoints: !0,\n               pointColor: this.props.color ? this.props.color : \"#fff\",\n               pointBorderColor: this.props.color ? this.props.color : \"#fff\",\n               pointBackgroundColor: this.props.color\n                  ? this.props.color\n                  : \"#5514A4\",\n               pointBorderWidth: 0,\n               pointRadius: 1,\n               pointHoverBorderColor: this.props.color\n                  ? this.props.color\n                  : \"#5514A4\",\n               pointHoverRadius: 3,\n               pointStyle: \"none\",\n               borderWidth: 2,\n            },\n         ],\n      };\n\n      const options = {\n         responsive: true,\n         maintainAspectRatio: false,\n         tooltips: {\n            enabled: true,\n         },\n         legend: {\n            display: false,\n            labels: {\n               usePointStyle: false,\n            },\n         },\n         scales: {\n            xAxes: [\n               {\n                  display: false,\n                  gridLines: {\n                     display: false,\n                     drawBorder: false,\n                  },\n                  scaleLabel: {\n                     display: false,\n                     labelString: \"Month\",\n                  },\n                  ticks: {\n                     beginAtZero: true,\n                  },\n               },\n            ],\n            yAxes: [\n               {\n                  display: false,\n                  gridLines: {\n                     display: false,\n                     drawBorder: false,\n                  },\n                  scaleLabel: {\n                     display: true,\n                     labelString: \"Value\",\n                  },\n               },\n            ],\n         },\n         title: {\n            display: true,\n         },\n      };\n      return (\n         <>\n            <Line\n               data={data}\n               options={options}\n               height={this.props.height ? this.props.height : 300}\n            />\n         </>\n      );\n   }\n}\n\nexport default LineChart6;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/bar4.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/bar3.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/line4.js",["1261"],"import React, { Component } from \"react\";\nimport { Line } from \"react-chartjs-2\";\n\nclass LineChart3 extends Component {\n   render() {\n      const data = {\n         labels: [\n            \"January\",\n            \"February\",\n            \"March\",\n            \"April\",\n            \"May\",\n            \"June\",\n            \"July\",\n         ],\n         datasets: [\n            {\n               label: \"My First dataset\",\n               data: [28, 35, 36, 48, 46, 42, 60],\n               backgroundColor: this.props.color ? this.props.color : \"#5514A4\",\n               borderColor: this.props.borderColor\n                  ? this.props.borderColor\n                  : this.props.color\n                  ? this.props.color\n                  : \"#5514A4\",\n               borderWidth: 0,\n               strokeColor: this.props.borderColor\n                  ? this.props.borderColor\n                  : this.props.color\n                  ? this.props.color\n                  : \"#5514A4\",\n               capBezierPoints: !0,\n               pointColor: this.props.borderColor\n                  ? this.props.borderColor\n                  : this.props.color\n                  ? this.props.color\n                  : \"#fff\",\n               pointBorderColor: this.props.borderColor\n                  ? this.props.borderColor\n                  : this.props.color\n                  ? this.props.color\n                  : \"#fff\",\n               pointBackgroundColor: this.props.borderColor\n                  ? this.props.borderColor\n                  : this.props.color\n                  ? this.props.color\n                  : \"#5514A4\",\n               borderWidth: 2,\n               pointBorderWidth: 0,\n               pointRadius: 3,\n               pointHoverBorderColor: this.props.color\n                  ? this.props.color\n                  : \"#5514A4\",\n               pointHoverRadius: 0,\n               pointStyle: \"line\",\n            },\n         ],\n      };\n\n      const options = {\n         responsive: true,\n         maintainAspectRatio: false,\n         tooltips: {\n            enabled: true,\n         },\n         legend: {\n            display: false,\n            labels: {\n               usePointStyle: false,\n            },\n         },\n         scales: {\n            xAxes: [\n               {\n                  display: false,\n                  gridLines: {\n                     display: false,\n                     drawBorder: false,\n                  },\n                  scaleLabel: {\n                     display: false,\n                     labelString: \"Month\",\n                  },\n                  ticks: {\n                     beginAtZero: true,\n                  },\n               },\n            ],\n            yAxes: [\n               {\n                  display: false,\n                  gridLines: {\n                     display: false,\n                     drawBorder: false,\n                  },\n                  scaleLabel: {\n                     display: true,\n                     labelString: \"Value\",\n                  },\n               },\n            ],\n         },\n         title: {\n            display: true,\n         },\n      };\n      return (\n         <>\n            <Line\n               data={data}\n               options={options}\n               height={this.props.height ? this.props.height : 300}\n            />\n         </>\n      );\n   }\n}\n\nexport default LineChart3;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/line3.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/rechart/PositiveNagative.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/rechart/BarChartNoPadding.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/chartflot/Bar.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/charts/Chartjs/pie.js",["1262"],"import React, { Component } from \"react\";\nimport { Pie } from \"react-chartjs-2\";\n\nconst ChartPie = ({ color1, color2, color3, height, width }) => {\n   const data = {\n      datasets: [\n         {\n            data: [45, 25, 30],\n            borderWidth: 0,\n            backgroundColor: [\n               `${color1 ? color1 : \"rgba(89, 59, 219, 0.9)\"}`,\n               `${color2 ? color2 : \"rgba(89, 59, 219, 0.7)\"}`,\n               `${color3 ? color3 : \"rgba(89, 59, 219, 0.5)\"}`,\n            ],\n            hoverBackgroundColor: [\n               `${color1 ? color1 : \"rgba(89, 59, 219, 0.9)\"}`,\n               `${color2 ? color2 : \"rgba(89, 59, 219, 0.7)\"}`,\n               `${color3 ? color3 : \"rgba(89, 59, 219, 0.5)\"}`,\n            ],\n         },\n      ],\n      labels: [\"one\", \"two\", \"three\"],\n   };\n\n   const options = {\n      responsive: true,\n      legend: false,\n      maintainAspectRatio: false,\n   };\n\n   return (\n      <>\n         <Pie data={data} height={height ? height : 250} options={options} />\n      </>\n   );\n};\n\nexport default ChartPie;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/Helper/Balance.ts",["1263","1264","1265","1266","1267","1268","1269","1270"],"import { Connection } from \"@metaplex/js\";\nimport { endpoint } from \"./getChainNetwork\";\nimport { LAMPORTS_PER_SOL, PublicKey, Keypair, SystemProgram, TransactionInstruction, SYSVAR_RENT_PUBKEY, Transaction } from \"@solana/web3.js\";\nimport { Token, TOKEN_PROGRAM_ID, ASSOCIATED_TOKEN_PROGRAM_ID, AccountLayout, MintLayout } from '@solana/spl-token';\n\n\nexport async function getSenderAta(wallet: any) {\n    const mint = new PublicKey(process.env.REACT_APP_CUSTOM_NATIVE_MINT || \"\");\n    const adminPublicKey : any =  new PublicKey(process.env.REACT_APP_ADMIN_WALLET_ADDRESS || \"\");\n\n    const senderAta = (\n        await PublicKey.findProgramAddress(\n            [\n                adminPublicKey.toBuffer(),\n                TOKEN_PROGRAM_ID.toBuffer(),\n                mint.toBuffer(),\n            ],\n            ASSOCIATED_TOKEN_PROGRAM_ID,\n        )\n    )[0];\n\n    return senderAta\n}\n\nexport const getUserBalance = async (wallet: any) => {\n    const connection: Connection = new Connection(endpoint.url);\n    const accountAta = await getSenderAta(wallet);\n    const balance = await connection.getTokenAccountBalance(accountAta);\n    console.log(\"balance ===\", balance);\n    return (Number(balance.value.amount) / LAMPORTS_PER_SOL);\n  };","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/productData/index.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/chatBox/Chat.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/productData/allProducts.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/Helper/getChainNetwork.ts",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/chatBox/MsgBox.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/productData/ProductStar.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/PluginsMenu/Select2/data.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/ProfileSidebar.js",["1271"],"import React, { useEffect } from \"react\";\nimport { Link, useHistory } from \"react-router-dom\";\n\nimport profileImage from \"../../images/profile/profile.png\";\n\n/// Scroll\nimport PerfectScrollbar from \"react-perfect-scrollbar\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { getLoggedInUser } from \"../../store/reducers/userReducer\";\nimport { Avatar } from \"@material-ui/core\";\n\nfunction ProfileSidebar({ addClass, hideProfile }) {\n   const history = useHistory();\n   const dispatch = useDispatch();\n   const user = useSelector(state => state?.userReducer?.user)\n   const logout = () => {\n      // localStorage.removeItem('authToken');\n      history.push(\"/page-login\");\n   }\n\n   const getLoggedInUserDetail = async () => {\n      await dispatch(getLoggedInUser());\n   }\n\n   useEffect(() => {\n      getLoggedInUserDetail()\n\n      // eslint-disable-next-line react-hooks/exhaustive-deps\n   }, [])\n\n   return (\n      <PerfectScrollbar\n         className={`profile-sidebar dz-scroll ${addClass}`}\n         id=\"DZ_W_Sidebar\"\n         style={{ display: window.location.pathname !== '/' && 'none' }}\n      >\n         <div className=\"d-flex align-items-center justify-content-between mb-4\">\n            <h5 className=\"text-black\">Profile</h5>\n            <Link\n               to=\"/edit-profile\"\n               className=\"text-red text-primary edit-profile-link\"\n            >\n               Edit\n            </Link>\n            <Link\n               to=\"#\"\n               className=\"text-red d-none close-side\"\n               onClick={() => hideProfile()}\n            >\n               <svg\n                  xmlns=\"http://www.w3.org/2000/svg\"\n                  width={24}\n                  height={24}\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  strokeWidth={2}\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                  className=\"feather feather-x-circle\"\n               >\n                  <circle cx={12} cy={12} r={10} />\n                  <line x1={15} y1={9} x2={9} y2={15} />\n                  <line x1={9} y1={9} x2={15} y2={15} />\n               </svg>\n            </Link>\n         </div>\n         <div className=\"profile-img mb-4 d-flex justify-content-center\">\n            <Avatar src={user?.avatar} className={'adminAvatar'} />\n         </div>\n         <div className=\"profile-info-bx mb-4\">\n            <h4 className=\"mb-1 fs-22\">{user?.fullName}</h4>\n            <span>Admin</span>\n         </div>\n         <div className=\"text-center mb-5\">\n            {/* <Link to=\"#\" className=\"btn text-left light btn-dark d-block mb-3 \">\n               <i className=\"fa fa-instagram scale5 mr-3\" />\n               /samuelanderson.404\n            </Link>\n            <Link to=\"#\" className=\"btn text-left light btn-dark d-block mb-3 \">\n               <i className=\"fa fa-twitter scale5 mr-3\" />\n               /samuel.404nderson\n            </Link>\n            <Link to=\"#\" className=\"btn text-left light btn-dark d-block mb-4 \">\n               <i className=\"fa fa-facebook scale5 mr-3\" />\n               /talksamuel.404\n            </Link> */}\n            <Link\n               to=\"/edit-profile\"\n               className=\"btn btn-outline-dark d-block btn-lg mb-2\"\n            >\n               Edit Profile\n            </Link>\n\n            <div onClick={() => logout()} className=\"btn btn-outline-dark d-block btn-lg\"\n            >\n               Logout\n            </div>\n\n         </div>\n         <hr />\n         {/* <div className=\"card-campaign mt-5\">\n            <h5>Ad Campaign Tutorials Video</h5>\n            <Link to=\"#\" className=\"fa fa-play\" />\n         </div> */}\n      </PerfectScrollbar>\n   );\n}\n\nexport default ProfileSidebar;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/chatBox/Alerts.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/chatBox/Notes.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/listings/Nft/NftSales.js",["1272"],"import React, { Fragment, useEffect, useState } from \"react\";\nimport PageTitle from \"../../../layouts/PageTitle\";\n// import DataTable from \"../../Dashboard/DataTable\";\nimport NftListingTable from \"../../listingTable/NftListingTable\";\nimport { useDispatch, useSelector } from 'react-redux'\nimport { getAllNft, getNftsSalesActivities } from '../../../../store/reducers/nftReducer';\nimport PageLoader from \"../../common/pageLoader\";\nimport SearchField from \"../../common/searchFiled\";\nimport SelectOptionField from \"../../common/selectOptionField\";\nimport Pagination from '../../common/pagination';\n\nconst NftSales = () => {\n   const [loader, setLoader] = useState({ data: true, filter: false })\n   const [searchText, setSearchText] = useState('')\n   const [filter, setFilter] = useState('');\n   const [page, setPage] = useState(0)\n   const limit = 20;\n   const dispatch = useDispatch();\n   const getNftListing = async ({ search, nftType, page }) => {\n      await dispatch(getNftsSalesActivities({ search, nftType, limit, page }));\n      setLoader({ data: false, filter: false })\n   }\n\n   const options = [\n      {\n         label: 'Select Option',\n         value: ''\n      },\n      {\n         label: 'Video',\n         value: 'video'\n      },\n      {\n         label: 'Audio',\n         value: 'audio'\n      },\n      {\n         label: 'Image',\n         value: 'image'\n      },\n      {\n         label: '3D',\n         value: '3d'\n      },\n   ]\n\n   const handleSearch = () => {\n      setLoader({ data: true, filter: true });\n      setFilter('');\n      getNftListing({ search: searchText, nftType: null, page: 1 })\n   }\n\n   const handleChange = (e) => {\n      if (!e.target.value || e.target.value.trim() === null) {\n         setSearchText(e.target.value);\n         setLoader({ data: true, filter: true });\n         return getNftListing({ search: '', nftType: filter, page: 1 })\n      }\n      setSearchText(e.target.value)\n   }\n\n   const ApplyFilter = (e) => {\n      setFilter(e.target.value)\n      setLoader({ data: true, filter: true });\n      setSearchText('');\n      return getNftListing({ search: '', nftType: (!e.target.value || e.target.value === '') ? undefined : e.target.value, page: 1 })\n   }\n\n   useEffect(() => {\n      setLoader({ data: true, filter: true })\n      getNftListing({ search: searchText, nftType: filter, page: 1 });\n\n      // eslint-disable-next-line react-hooks/exhaustive-deps\n   }, [])\n\n\n   const handlePageClick = (e) => {\n      setLoader({ data: true, filter: false })\n      setPage(e.selected)\n      return getNftListing({ search: searchText, nftType: filter, page: e.selected + 1 })\n   }\n\n   const data = useSelector((state) => state.nftReducer.nftsSales);\n   console.log('data =====>', data)\n   return (\n      <Fragment>\n         <PageTitle activeMenu=\"Sales\" motherMenu=\"NFT\" />\n         {\n            loader?.data ? <PageLoader /> :\n               <div className=\"row justify-content-end\">\n                  <SelectOptionField onChange={ApplyFilter} filter={filter} options={options} />\n                  <SearchField onChange={handleChange} searchText={searchText} handleSearch={handleSearch} />\n                  {data && <NftListingTable limit={limit} page={page} tabledata={data?.docs} />}\n               </div>\n         }\n         {(data?.totalDocs && !loader?.filter) && <div>\n            Showing {(limit * page) + 1} to{\" \"}\n            {data?.totalDocs < limit ? data?.totalDocs : limit * (page + 1)} {\"\"}\n            of {data?.totalDocs} entries\n            {<Pagination handlePageClick={handlePageClick} totalDocs={data?.totalDocs} />}\n         </div>\n         }\n\n\n\n      </Fragment>\n   );\n};\n\nexport default NftSales;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Wallets/WalletListing.js",["1273","1274","1275","1276","1277","1278","1279","1280","1281"],"import React, { Fragment, useEffect, useState } from \"react\";\nimport { useDispatch, useSelector } from 'react-redux'\n\nimport PageTitle from \"../../layouts/PageTitle\";\nimport { getFaqs, deleteFaq } from '../../../store/reducers/faq.Reducer'\nimport FaqListingTable from \"../listingTable/FaqListing\";\n\nimport PageLoader from \"../common/pageLoader\";\nimport SearchField from \"../common/searchFiled\";\nimport { alert } from '../../../store/reducers/alertSlice'\nconst WalletListing = () => {\n    const [loader, setLoader] = useState(true);\n    const [searchText, setSearchText] = useState('')\n    const dispatch = useDispatch();\n\n    const getNftListing = (async ({ search }) => {\n        await dispatch(getFaqs(search || ''));\n        setLoader(false)\n    })\n\n    useEffect(() => {\n        getNftListing({ search: searchText })\n    }, []);\n\n    const handleSearch = () => {\n        getNftListing({ search: searchText })\n    }\n\n    const handleChange = (e) => {\n        if (!e.target.value || e.target.value.trim() === null) {\n            setSearchText(e.target.value)\n            return getNftListing({ search: '' })\n        }\n        setSearchText(e.target.value)\n    }\n\n    const onDeleteConfirm = async (id) => {\n        try {\n            let deletedBlog = await dispatch(deleteFaq(id));\n            if (deletedBlog) {\n                dispatch(alert({\n                    title: `Success`,\n                    message: `FAQ deleted Successfully`,\n                    severity: \"success\",\n                }))\n                getNftListing({ search: searchText });\n            }\n        } catch (error) {\n            dispatch(alert({\n                title: `failed`,\n                message: `failed to delete FAQ`,\n                severity: \"error\",\n            }))\n        }\n\n    }\n\n    const data = useSelector(state => state.faq.faqs);\n\n    return (\n        <Fragment>\n            <PageTitle activeMenu=\"Listing\" motherMenu=\"Wallet\" />\n            {/* {loader ? <PageLoader /> :\n                <div className=\"row justify-content-end\">\n                    <SearchField onChange={handleChange} searchText={searchText} handleSearch={handleSearch} />\n                    <FaqListingTable tabledata={data} deleteBlog={(id) => onDeleteConfirm(id)} />\n                </div>} */}\n        </Fragment>\n    );\n};\n\nexport default WalletListing;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/WeekTrending/weekTrending.js",["1282","1283","1284"],"import React, { Fragment, useEffect, useState } from \"react\";\nimport PageTitle from \"../../layouts/PageTitle\";\nimport TrendingNft from \"../listingTable/TrendingNftListing\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { getTrendingNft } from \"../../../store/reducers/nftReducer\";\nimport PageLoader from \"../common/pageLoader\";\nimport { Pagination } from \"@material-ui/lab\";\n\nconst WeekTrending = () => {\n  const [loader, setLoader] = useState(true);\n  const [searchText, setSearchText] = useState(\"\");\n  const [filter, setFilter] = useState(\"\");\n  const [page, setPage] = useState(20);\n  const limit = 20;\n  const dispatch = useDispatch();\n\n  const trendingNftListing = async ({ search, nftType }) => {\n    setLoader(true);\n    await dispatch(getTrendingNft());\n    setLoader(false);\n  };\n\n  useEffect(() => {\n    trendingNftListing({ search: searchText, nftType: filter });\n  }, []);\n\n  const handlePageClick = (e) => {\n    setLoader({ data: true, filter: false });\n    setPage(e.selected);\n    return trendingNftListing({\n      search: searchText,\n      isVerified: filter || undefined,\n      page: e.selected + 1,\n    });\n  };\n\n  const data = useSelector((state) => state.nftReducer.trendingNfts);\n\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"Listing\" motherMenu=\"Week Trending\" />\n      {loader ? (\n        <PageLoader />\n      ) : (\n        <div className=\"row justify-content-end\">\n          {/* <SelectOptionField onChange={ApplyFilter} filter={filter} options={options} />\n                        <SearchField onChange={handleChange} searchText={searchText} handleSearch={handleSearch} /> */}\n          {data && <TrendingNft tabledata={data} />}\n          {data?.totalDocs && (\n            <div>\n              Showing {limit * page + 1} to {limit * (page + 1)} {\"\"}\n              of {data?.totalDocs} entries\n              {\n                <Pagination\n                  handlePageClick={handlePageClick}\n                  totalDocs={data?.totalDocs}\n                />\n              }\n            </div>\n          )}\n        </div>\n      )}\n    </Fragment>\n  );\n};\n\nexport default WeekTrending;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/pages/Admin/editProfile.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/revenue/revenue.js",["1285","1286","1287"],"import React, { Fragment, useEffect, useState } from \"react\";\nimport { useDispatch } from 'react-redux'\nimport { CSVLink } from \"react-csv\";\nimport jsPDF from \"jspdf\";\nimport \"jspdf-autotable\";\n\nimport PageTitle from \"../../layouts/PageTitle\";\nimport { getPaymentStats, getPaymentListing } from \"../../../store/reducers/paymentReducer\"\n\nimport PageLoader from \"../common/pageLoader\";\nimport SelectOptionField from \"../common/selectOptionField\";\nimport TaxRevenueChart from \"../charts/Chartjs/TaxRevenueChart\";\nimport RevenueListing from \"../listingTable/RevenueListing\";\nconst RevenueReport = () => {\n\n    const [loader, setLoader] = useState(true);\n    const [days, setDays] = useState(7);\n    const [revenue, setRevenue] = useState([]);\n    const [listing, setListing] = useState([]);\n    const [loading, setLoading] = useState(false)\n    const [CSVFormat, setCSVFormat] = useState(null)\n    const [pdfFormat, setPdfFormat] = useState(null)\n    const dispatch = useDispatch();\n    const [layout, setLayout] = useState(\"graph\");\n\n    const options = [\n        {\n            label: 'Current Day',\n            value: 1\n        },\n        {\n            label: 'Week',\n            value: 7\n        },\n        {\n            label: 'month',\n            value: 30\n        },\n        {\n            label: 'Quarter Year',\n            value: 90\n        },\n        {\n            label: 'Half Year',\n            value: 182\n        },\n        {\n            label: 'Year',\n            value: 365\n        },\n    ]\n\n    const LaoutOptions = [\n        {\n            label: 'Graph',\n            value: 'graph'\n        },\n        {\n            label: 'Listing',\n            value: 'listing'\n        },\n    ]\n\n    const pdfHeaders = ['Payment Currency', 'Nft Id', 'Chat with User Id', 'User Id', 'Amount', 'Payment Type', 'created At']\n\n    const getPayment = (async () => {\n        setLoader(true)\n        const revenueData = await dispatch(getPaymentStats({ days }));\n        setRevenue(revenueData?.payments)\n        setLoader(false)\n    })\n\n    useEffect(() => {\n        getPayment();\n        getRevenueListing();\n    }, [days]);\n\n    const onDaysChange = (e) => {\n        setDays(e.target.value)\n    }\n\n    const getRevenueListing = async () => {\n        const listingData = await dispatch(getPaymentListing({ days }))\n\n        const CSVFormat = [];\n        const pdfData = [];\n        listingData.map(async (item) => {\n            item?.payments?.length && item.payments.map(async (record) => {\n                let pdfFormatData = [];\n                delete record?._id\n                delete record?.transactionSignature\n                CSVFormat.push(record);\n                pdfFormatData = [record?.paymentCurrency ?? 'N/A', record?.nftId ?? 'N/A', record?.chatWithUserId ?? 'N/A', record?.userId ?? 'N/A', record?.amount ?? 'N/A', record?.paymentType ?? 'N/A', record?.createdAt ?? 'N/A']\n                pdfData.push(pdfFormatData);\n            })\n        })\n        setPdfFormat(pdfData)\n        setCSVFormat(CSVFormat)\n        setListing(listingData)\n        setLoader(false)\n    }\n\n    const onLayoutChange = (e) => {\n        setLayout(e.target.value);\n\n        if (e.target.value === 'graph') {\n            getPayment();\n        }\n        else if (e.target.value === 'listing') {\n            getRevenueListing();\n        }\n\n    }\n\n    const download_pdf = () => {\n        const doc = new jsPDF();\n        doc.autoTable({\n            headStyles: { cellWidth: 26, fillColor: '#9945fe' },\n            head: [pdfHeaders],\n            body: pdfFormat\n        });\n        doc.save(\"revenue_report.pdf\");\n    }\n\n    return (\n        <Fragment>\n            <PageTitle activeMenu=\"Report\" motherMenu=\"Revenue\" />\n            {loader ? <PageLoader /> :\n                <div className=\"revenue-page\">\n                    <div className=\"row justify-content-end align-items-center\">\n\n                        {layout === \"listing\" && CSVFormat && <CSVLink\n                            data={CSVFormat}\n                            filename={\"revenue-report.csv\"}\n                            className=\"btn btn-primary mr-3 mb-3\"\n                            target=\"_blank\"\n                        >Download CSV</CSVLink>\n                        }\n\n                        {layout === \"listing\" && pdfFormat && <div className=\"mr-3\">\n                            <button\n                                className=\"btn btn-primary btn-block mb-3\"\n                                style={{ minWidth: 120, cursor: 'pointer' }}\n                                onClick={() => download_pdf()}\n                                title=\"Learn More\"\n                                color=\"#841584\"\n                                accessibilityLabel=\"Learn more about this purple button\"\n                            >Download Pdf</button>\n                        </div>}\n\n                        <SelectOptionField onChange={onLayoutChange} filter={layout} options={LaoutOptions} />\n                        <SelectOptionField onChange={onDaysChange} filter={days} options={options} />\n                    </div>\n\n                    {layout === \"graph\" && revenue !== [] && <TaxRevenueChart tabledata={revenue} days={days} />}\n                    {layout === \"listing\" && <RevenueListing tabledata={listing} />}\n\n                </div>}\n        </Fragment>\n    );\n};\n\nexport default RevenueReport;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/FAQ/FaqForm.js",["1288","1289"],"import React, { Fragment, useState } from \"react\";\nimport { useDispatch } from 'react-redux'\nimport { createFaq } from '../../../store/reducers/faq.Reducer';\nimport { convertToRaw, EditorState } from \"draft-js\";\nimport { Editor } from \"react-draft-wysiwyg\";\nimport \"react-draft-wysiwyg/dist/react-draft-wysiwyg.css\";\n\nimport ButtonLoader from \"../common/buttonLoader\";\nimport PageTitle from \"../../layouts/PageTitle\";\nimport { alert } from \"../../../store/reducers/alertSlice\"\nconst FaqForm = () => {\n    const [editorState, setEditorState] = useState(() =>\n        EditorState.createEmpty())\n    const [formValues, setFormValues] = useState({\n        question: '',\n        answer: '',\n    })\n\n    const dispatch = useDispatch();\n    const [loading, setLoading] = useState(false)\n    const [errors, setErrors] = useState({});\n\n    const validate = () => {\n        let err = {};\n\n        if (!formValues.question) {\n            err.question = \"Title is required\";\n        }\n        if (editorState && !(editorState.getCurrentContent().getPlainText('\\u0001')) || (editorState.getCurrentContent().getPlainText('\\u0001').trim() === '')) {\n            err.answer = \"Answer is required\";\n        }\n        return err;\n    };\n\n    const handleSubmit = async (e) => {\n        e.preventDefault();\n        const err = validate();\n        if (Object.keys(err).length > 0) {\n            return setErrors(err)\n        }\n\n        setLoading(true);\n        let myHeaders = new Headers();\n        myHeaders.append(\"Content-Type\", \"application/json\");\n        const contentState = editorState.getCurrentContent();\n        let stateData = await JSON.stringify(convertToRaw(contentState));\n        const raw = {\n            question: formValues.question,\n            answer: stateData || '',\n        };\n\n        const data = await dispatch(createFaq(raw));\n        if (data) {\n            document.getElementById('create-faq-form').reset();\n            dispatch(alert({\n                title: `Success`,\n                message: `FAQ Created Successfully`,\n                severity: \"success\",\n            }))\n        }\n        if (data?.question) {\n            setFormValues({\n                question: '',\n                answer: '',\n            })\n            setEditorState(EditorState.createEmpty())\n        }\n        setLoading(false);\n    }\n\n    const handleChange = (e) => {\n        const { name, value } = e.target;\n        setErrors({ ...errors, [name]: undefined })\n\n        setFormValues((prevState) => ({\n            ...prevState,\n            [name]: value,\n        }));\n    };\n\n    const onEditorStateChange = (e) => {\n        setErrors({ ...errors, answer: undefined })\n        setEditorState(e);\n    }\n\n    return (\n        <Fragment>\n            <PageTitle activeMenu=\"Create\" motherMenu=\"FAQ\" />\n            <div className=\"row\">\n\n                <div className=\"col-xl-12 col-lg-12\">\n\n                    <div className=\"card\">\n                        <div className=\"card-header\">\n                            <h4 className=\"card-title\">Create FAQ</h4>\n                        </div>\n                        <div className=\"card-body\">\n                            <div className=\"basic-form\">\n                                <form id=\"create-faq-form\" onSubmit={e => { handleSubmit(e) }}>\n                                    <div className=\"form-group\">\n                                        <input\n                                            type=\"text\"\n                                            className=\"form-control input-default \"\n                                            name=\"question\"\n                                            placeholder=\"Question\"\n                                            value={formValues.title}\n                                            onChange={(e) => { handleChange(e) }}\n                                        />\n                                        {errors.question && (\n                                            <span className=\"error\">{'Question is required'}</span>\n                                        )}\n                                    </div>\n\n                                    <div className=\"form-group\" style={{ border: '1px solid #F8F8F8', borderRadius: '0.75rem' }}>\n                                        <Editor\n                                            editorState={editorState}\n                                            wrapperClassName=\"demo-wrapper\"\n                                            editorClassName=\"demo-editor\"\n                                            onEditorStateChange={onEditorStateChange}\n                                        />\n                                        {errors.answer && (\n                                            <span className=\"error\">{'Answer is required'}</span>\n                                        )}\n                                    </div>\n                                    <div className=\"mt-3 mt-sm-10\">\n                                        <ButtonLoader loader={loading} title={'Create FAQ'} classes=\"btn btn-primary mb-2\"\n                                            disabled={loading}\n                                        />\n                                    </div>\n                                </form>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </Fragment>\n    );\n};\n\nexport default FaqForm;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/FAQ/UpdateFaq.js",["1290","1291","1292"],"import React, { Fragment, useState, useEffect } from \"react\";\nimport { useDispatch } from 'react-redux'\nimport { updateFaq } from '../../../store/reducers/faq.Reducer';\nimport { convertToRaw, EditorState, convertFromRaw } from \"draft-js\";\nimport { Editor } from \"react-draft-wysiwyg\";\nimport \"react-draft-wysiwyg/dist/react-draft-wysiwyg.css\";\nimport { useParams, useHistory } from \"react-router-dom\";\n\n\nimport ButtonLoader from \"../common/buttonLoader\";\nimport PageTitle from \"../../layouts/PageTitle\";\nimport { alert } from \"../../../store/reducers/alertSlice\";\n\nconst UpdateFaq = () => {\n    const [editorState, setEditorState] = useState(() =>\n        EditorState.createEmpty())\n    const [formValues, setFormValues] = useState({\n        _id: null,\n        question: '',\n        answer: '',\n    })\n\n    const dispatch = useDispatch();\n    const history = useHistory();\n    let { state } = useHistory().location;\n    let { id } = useParams();\n\n    const [loading, setLoading] = useState(false)\n    const [errors, setErrors] = useState({});\n\n    const validate = () => {\n        let err = {};\n\n        if (!formValues.question) {\n            err.question = \"Title is required\";\n        }\n        if (editorState && !(editorState.getCurrentContent().getPlainText('\\u0001')) || (editorState.getCurrentContent().getPlainText('\\u0001').trim() === '')) {\n            err.answer = \"Answer is required\";\n        }\n        return err;\n    };\n\n    const handleSubmit = async (e) => {\n        e.preventDefault();\n        const err = validate();\n        if (Object.keys(err).length > 0) {\n            return setErrors(err)\n        }\n\n        setLoading(true);\n        let myHeaders = new Headers();\n        myHeaders.append(\"Content-Type\", \"application/json\");\n        const contentState = editorState.getCurrentContent();\n        let stateData = await JSON.stringify(convertToRaw(contentState));\n        const raw = {\n            question: formValues.question,\n            answer: stateData || '',\n            _id: formValues._id\n        };\n\n        const data = await dispatch(updateFaq(raw));\n        if (data) {\n            document.getElementById('create-faq-form').reset();\n            dispatch(alert({\n                title: `Success`,\n                message: `FAQ Updated Successfully`,\n                severity: \"success\",\n            }))\n        }\n        if (data?.question) {\n            setFormValues({\n                _id: '',\n                question: '',\n                answer: '',\n            })\n            setEditorState(EditorState.createEmpty())\n        }\n        setLoading(false);\n    }\n\n    const handleChange = (e) => {\n        const { name, value } = e.target;\n        setErrors({ ...errors, [name]: undefined })\n\n        setFormValues((prevState) => ({\n            ...prevState,\n            [name]: value,\n        }));\n    };\n\n    const onEditorStateChange = (e) => {\n        setErrors({ ...errors, answer: undefined })\n        setEditorState(e);\n    }\n\n    useEffect(() => {\n        !id && history.push(\"/faq-listing\")\n        const contentState = convertFromRaw(JSON.parse(state?.answer));\n        const editorState = EditorState.createWithContent(contentState);\n        setEditorState(editorState);\n        setFormValues({\n            _id: state._id,\n            question: state.question,\n            answer: state.answer,\n        })\n    }, [])\n\n\n\n    return (\n        <Fragment>\n            <PageTitle activeMenu=\"Create\" motherMenu=\"FAQ\" />\n            <div className=\"row\">\n\n                <div className=\"col-xl-12 col-lg-12\">\n\n                    <div className=\"card\">\n                        <div className=\"card-header\">\n                            <h4 className=\"card-title\">Create FAQ</h4>\n                        </div>\n                        <div className=\"card-body\">\n                            <div className=\"basic-form\">\n                                <form id=\"create-faq-form\" onSubmit={e => { handleSubmit(e) }}>\n                                    <div className=\"form-group\">\n                                        <input\n                                            type=\"text\"\n                                            className=\"form-control input-default \"\n                                            name=\"question\"\n                                            placeholder=\"Question\"\n                                            value={formValues.question}\n                                            onChange={(e) => { handleChange(e) }}\n                                        />\n                                        {errors.question && (\n                                            <span className=\"error\">{'Question is required'}</span>\n                                        )}\n                                    </div>\n\n                                    <div className=\"form-group\" style={{ border: '1px solid #F8F8F8', borderRadius: '0.75rem' }}>\n                                        <Editor\n                                            editorState={editorState}\n                                            wrapperClassName=\"demo-wrapper\"\n                                            editorClassName=\"demo-editor\"\n                                            onEditorStateChange={onEditorStateChange}\n                                        />\n                                        {errors.answer && (\n                                            <span className=\"error\">{'Answer is required'}</span>\n                                        )}\n                                    </div>\n                                    <div className=\"mt-3 mt-sm-10\">\n                                        <ButtonLoader loader={loading} title={'Update FAQ'} classes=\"btn btn-primary mb-2\"\n                                            disabled={loading}\n                                        />\n                                    </div>\n                                </form>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </Fragment>\n    );\n};\n\nexport default UpdateFaq;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/FAQ/FaqListing.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/pages/Payment/PaymentDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/pages/Swapping/SwappingDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/pages/User/UserDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/pages/Auction/AuctionDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/pages/Nfts/Nft.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/pages/Blogs/Blog.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/pages/Collection/CollectionDetail.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/SwappingRevenueGrid.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/AuctionsListing.js",["1293","1294"],"import { Fragment, useEffect, useState } from \"react\";\nimport { useDispatch, useSelector } from \"react-redux\";\n\nimport PageTitle from \"../../../../layouts/PageTitle\";\nimport {\n  getAllAuctions,\n  getAllCollectionsName,\n} from \"../../../../../store/reducers/auctionsReducer\";\nimport AuctionListingTable from \"../../../listingTable/AuctionsListing\";\nimport PageLoader from \"../../../common/pageLoader\";\nimport SearchField from \"../../../common/searchFiled\";\nimport SelectOptionField from \"../../../common/selectOptionField\";\nimport axios from \"axios\";\nimport Pagination from \"../../../common/pagination\";\n\nconst BlogsGrid = () => {\n  const [loader, setLoader] = useState({ data: true, filter: false });\n  const [searchText, setSearchText] = useState(\"\");\n  const [filter, setFilter] = useState(\"\");\n  const [collection, setCollection] = useState(\"\");\n  const [collectionOptions, setCollectionOptions] = useState([]);\n  const [collectionListing, setCollectionListing] = useState([]);\n  const [fractions, setFractionValues] = useState([]);\n  const [fraction, setSelectedFraction] = useState(\"\");\n  const [page, setPage] = useState(0);\n  const dispatch = useDispatch();\n  const limit = 20;\n  const options = [\n    {\n      label: \"Select Type\",\n      value: \"\",\n    },\n    {\n      label: \"Fractional\",\n      value: \"fractional\",\n    },\n    {\n      label: \"Fixed Price\",\n      value: \"fixedPrice\",\n    },\n    {\n      label: \"Highest Bid\",\n      value: \"highestBid\",\n    },\n  ];\n\n  const getAuctionListing = async ({ search, auctionType, page, fraction }) => {\n    await dispatch(\n      getAllAuctions({\n        search: search || \"\",\n        auctionType,\n        page,\n        fraction,\n        limit,\n      })\n    );\n    setLoader({ data: false, filter: false });\n  };\n\n  const getCollectionNames = async () => {\n    const collectionNames = await dispatch(getAllCollectionsName());\n    const collectioNamesOptions = [];\n    collectionNames.map((item) => {\n      collectioNamesOptions.push({\n        label: item.name,\n        value: item.name,\n      });\n    });\n    collectioNamesOptions.unshift({\n      label: \"Select Collection\",\n      value: \"\",\n    });\n\n    setCollectionListing(collectionNames);\n    setCollectionOptions(collectioNamesOptions);\n    // setCollection(collectioNamesOptions)\n  };\n\n  const getFractionsListing = async () => {\n    try {\n      const res = await axios({\n        method: \"get\",\n        url: `${process.env.REACT_APP_BASE_URL}systemSetting/getAllSystemSetting`,\n      });\n\n      const fractionsArray = [\n        {\n          label: \"Select Fractions\",\n          value: \"\",\n        },\n      ];\n      res.data?.franctionValues &&\n        res.data?.franctionValues.map((fraction) => {\n          fractionsArray.push({\n            label: fraction,\n            value: fraction,\n          });\n        });\n      setFractionValues(fractionsArray);\n    } catch (error) {\n      console.log(\"error ====>\", error);\n    }\n  };\n\n  useEffect(() => {\n    setLoader({ data: true, filter: true });\n    getAuctionListing({\n      search: searchText,\n      auctionType: filter || undefined,\n      page: 1,\n      fraction,\n    });\n    getCollectionNames();\n    getFractionsListing();\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  const handleSearch = () => {\n    setLoader({ data: true, filter: true });\n    getAuctionListing({\n      search: searchText,\n      auctionType: filter || undefined,\n      page: 1,\n      fraction,\n    });\n  };\n\n  const handleChange = (e) => {\n    if (!e.target.value || e.target.value.trim() === null) {\n      setLoader({ data: true, filter: true });\n      setSearchText(e.target.value);\n      return getAuctionListing({\n        search: \"\",\n        auctionType: filter,\n        page: 1,\n        fraction,\n      });\n    }\n    setSearchText(e.target.value);\n  };\n\n  const ApplyFilter = (e) => {\n    setFilter(e.target.value);\n    setCollection(\"\");\n    setLoader({ data: true, filter: true });\n    return getAuctionListing({\n      search: searchText,\n      auctionType:\n        !e.target.value || e.target.value === \"\" ? undefined : e.target.value,\n      page: 1,\n      fraction,\n    });\n  };\n\n  const applyCollectionFilter = (e) => {\n    setCollection(e.target.value);\n    const val = collectionListing.find((item) => item.name === e.target.value);\n    if (val) {\n      setLoader({ data: true, filter: true });\n      return getAuctionListing({\n        search: val.id,\n        auctionType: undefined,\n        page: 1,\n        fraction,\n      });\n    }\n  };\n\n  const applyFractionFilter = (e) => {\n    setSelectedFraction(e.target.value);\n    setLoader({ data: true, filter: true });\n    return getAuctionListing({\n      search: searchText,\n      auctionType: undefined,\n      page: 1,\n      fraction: e.target.value,\n    });\n  };\n\n  const handlePageClick = (e) => {\n    setCollection(\"\");\n    setLoader({ data: true, filter: false });\n    setPage(e.selected);\n    return getAuctionListing({\n      search: searchText,\n      auctionType: filter,\n      page: e.selected + 1,\n      fraction,\n    });\n  };\n\n  const data = useSelector((state) => state.AuctionReducer.auctions);\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"listing\" motherMenu=\"Auction\" />\n      {loader?.data ? (\n        <PageLoader />\n      ) : (\n        <div className=\"row justify-content-end\">\n          <SelectOptionField\n            onChange={applyFractionFilter}\n            filter={fraction}\n            options={fractions}\n          />\n          <SelectOptionField\n            onChange={applyCollectionFilter}\n            filter={collection}\n            options={collectionOptions}\n          />\n          <SelectOptionField\n            onChange={ApplyFilter}\n            filter={filter}\n            options={options}\n          />\n          <SearchField\n            onChange={handleChange}\n            searchText={searchText}\n            handleSearch={handleSearch}\n          />\n          <AuctionListingTable\n            page={page}\n            limit={limit}\n            tabledata={data?.docs}\n            totalDocs={data?.totalDocs}\n          />\n        </div>\n      )}\n      {data?.totalDocs && !loader?.filter && (\n        <div>\n          Showing {limit * page + 1} to{\" \"}\n          {data?.totalDocs < limit ? data?.totalDocs : limit * (page + 1)} {\"\"}\n          of {data?.totalDocs} entries\n          {\n            <Pagination\n              handlePageClick={handlePageClick}\n              totalDocs={data?.totalDocs}\n            />\n          }\n        </div>\n      )}\n    </Fragment>\n  );\n};\n\nexport default BlogsGrid;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/TaxPayment/TaxPaymentListing.js",["1295","1296"],"import React, { Fragment, useEffect, useState } from \"react\";\nimport PageTitle from \"../../layouts/PageTitle\";\nimport PageLoader from \"../common/pageLoader\";\n// import SearchField from \"../common/searchFiled\";\nimport SelectOptionField from \"../common/selectOptionField\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { getPayments } from \"../../../store/reducers/paymentReducer\";\nimport PaymentListingTable from \"../listingTable/PaymentListing\";\nimport MonetizationOn from \"@material-ui/icons/MonetizationOn\";\nimport Pagination from \"../common/pagination\";\nconst TaxPaymentListing = () => {\n  const dispatch = useDispatch();\n  const [loader, setLoader] = useState({ data: true, filter: false });\n  const [payments, setPayments] = useState(null);\n  const [searchText, setSearchText] = useState(\"\");\n  const [filter, setFilter] = useState(\"\");\n  const [page, setPage] = useState(0);\n  const limit = 20;\n  const options = [\n    {\n      label: \"Select Option\",\n      value: \"\",\n    },\n    {\n      label: \"Chat\",\n      value: \"chat\",\n    },\n    {\n      label: \"Buy\",\n      value: \"buy\",\n    },\n    {\n      label: \"Bid\",\n      value: \"bid\",\n    },\n    {\n      label: \"Minting\",\n      value: \"minting\",\n    },\n  ];\n\n  const getPaymentListing = async ({ search, paymentType, page }) => {\n    await dispatch(getPayments({ search, paymentType, limit, page }));\n    setLoader({ data: false, filter: false });\n  };\n\n  const ApplyFilter = (e) => {\n    setLoader({ data: true, filter: true });\n    setFilter(e.target.value);\n    return getPaymentListing({\n      search: searchText,\n      paymentType:\n        !e.target.value || e.target.value === \"\" ? undefined : e.target.value,\n      page: 1,\n    });\n  };\n\n  const handleChangeStatus = (_data) => {\n    setPayments(_data);\n  };\n\n  useEffect(() => {\n    setLoader({ data: true, filter: true });\n    getPaymentListing({ search: searchText, paymentType: undefined, page: 1 });\n\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  const handlePageClick = (e) => {\n    setLoader({ data: true, filter: false });\n    setPage(e.selected);\n    return getPaymentListing({\n      search: searchText,\n      paymentType: filter || undefined,\n      page: e.selected + 1,\n    });\n  };\n\n  const data = useSelector((state) => state.paymentReducer?.Payments);\n\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"Listing\" motherMenu=\"Tax Payment\" />\n      {loader?.data ? (\n        <PageLoader />\n      ) : (\n        <div className=\"row align-items-end\">\n          <div className=\"col-lg-4 col-sm-8\">\n            <div className=\"card widget-stat\">\n              <div className=\"card-body p-4 pb-2\">\n                <div className=\"media align-items-center\">\n                  <div className=\"media-body\">\n                    <p className=\"fs-18 mb-2 wspace-no\">\n                      Total Paid Amount (PQL)\n                    </p>\n                    <h1 className=\"fs-36 font-w600 d-flex align-items-center text-black mb-0\">\n                      {data?.totalAmount?.toFixed(2) || 0}\n                    </h1>\n                  </div>\n                  <span className=\"ml-3 bg-warning text-white\">\n                    <MonetizationOn />\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-lg-8 col-sm-8 \">\n            <div className=\"row justify-content-end\">\n              <SelectOptionField\n                onChange={ApplyFilter}\n                filter={filter}\n                options={options}\n              />\n            </div>\n          </div>\n          {/* <SearchField onChange={handleChange} searchText={searchText} handleSearch={handleSearch} /> */}\n          <PaymentListingTable\n            limit={limit}\n            page={page}\n            tabledata={data?.docs}\n            handleChangeStatus={handleChangeStatus}\n          />\n        </div>\n      )}\n      {data?.totalDocs && !loader?.filter && (\n        <div>\n          Showing {limit * page + 1} to{\" \"}\n          {data?.totalDocs < limit ? data?.totalDocs : limit * (page + 1)} {\"\"}\n          of {data?.totalDocs} entries\n          {\n            <Pagination\n              handlePageClick={handlePageClick}\n              totalDocs={data?.totalDocs}\n            />\n          }\n        </div>\n      )}\n    </Fragment>\n  );\n};\n\nexport default TaxPaymentListing;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Forms/SystemSettings/SystemSettings.js",["1297","1298"],"import React, { Fragment, useEffect, useState } from \"react\";\n\n// import Multistep from \"react-multistep\";\n// import DropdownMultiselect from \"react-multiselect-dropdown-bootstrap\";\nimport axios from \"axios\";\nimport { useDispatch } from \"react-redux\";\n// import { Alert } from \"react-bootstrap\";\n\nimport PageTitle from \"../../../layouts/PageTitle\";\nimport { alert } from \"../../../../store/reducers/alertSlice\";\n// import { addFraction } from \"../../../../store/reducers/fractionReducer\";\nimport { FontAwesomeIcon } from \"@fortawesome/react-fontawesome\";\nimport { faXmark } from \"@fortawesome/free-solid-svg-icons\";\nimport ButtonLoader from \"../../common/buttonLoader\";\n\nconst SystemSetting = () => {\n  const dispatch = useDispatch();\n  const [systemSetting, setSystemSetting] = useState({});\n  // const [fractionInput, setFractionInput] = useState(null);\n  // const [fractionsValues, setFractionValues] = useState([4, 10, 200]);\n  const [loading, setLoading] = useState(false);\n  const fetchSystemSetting = async () => {\n    try {\n      const authToken = (await localStorage.getItem(\"authToken\")) || \"\";\n      let res = await axios({\n        method: \"get\",\n        url: `${process.env.REACT_APP_BASE_URL}systemSetting/getAllSystemSetting`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      if(!res.data){\n        alert('authentication')\n      }\n      // setFractionValues(res.data?.franctionValues || []);\n      setSystemSetting({ ...res.data });\n    } catch (error) {\n      return false\n    }\n  };\n\n\n  const onInputValueChange = (e) => {\n    e.preventDefault();\n    if (parseFloat(e.target.value) < 0) {\n      setSystemSetting({\n        ...systemSetting,\n        [e.target.name]: e.target.value * -1,\n      });\n      return;\n    }\n    setSystemSetting({ ...systemSetting, [e.target.name]: e.target.value });\n  };\n\n  useEffect(() => {\n    fetchSystemSetting();\n  }, []);\n\n  const handleSubmit = async (event) => {\n    event.preventDefault();\n    let updatedSystemSettings = { ...systemSetting };\n    // updatedSystemSettings.franctionValues = fractionsValues;\n    setLoading(true);\n    try {\n      const authToken = (await localStorage.getItem(\"authToken\")) || \"\";\n      let res = await axios({\n        method: \"post\",\n        url: `${process.env.REACT_APP_BASE_URL}systemSetting/updateSystemSetting`,\n        data: updatedSystemSettings,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n\n      if (res) {\n        dispatch(\n          alert({\n            title: `Success`,\n            message: `System Setting updated successfully`,\n            severity: \"success\",\n          })\n        );\n        setLoading(false);\n      }\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `failed`,\n          message: `failed to update System Setting`,\n          severity: \"error\",\n        })\n      );\n      setLoading(false);\n    }\n  };\n\n  // const removeFraction = (fraction) => {\n  //   // let tempFractions = [...fractionsValues];\n  //   const index = tempFractions.findIndex((item) => item === fraction);\n  //   if (index >= 0) {\n  //     tempFractions.splice(index, 1);\n  //     setFractionValues(tempFractions);\n  //   }\n  // };\n\n  // const addFraction = () => {\n  //   // let tempFractions = [...fractionsValues];\n  //   tempFractions.push(parseInt(fractionInput));\n  //   setFractionValues(tempFractions);\n  // };\n\n  // const onFractionAdd = (e) => {\n  //   setFractionInput(e.target.value);\n  // };\n\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"form\" motherMenu=\"System Setting\" />\n      <div className=\"row\">\n        <div className=\"col-xl-12 col-xxl-12\">\n          <div className=\"card\">\n            <div className=\"card-header\">\n              <h4 className=\"card-title\">System Settings</h4>\n            </div>\n            <div className=\"card-body\">\n              <form\n                onSubmit={(e) => handleSubmit(e)}\n                id=\"step-form-horizontal\"\n                className=\"step-form-horizontal\"\n              >\n                <div className=\"row\">\n                  <div className=\"col-lg-6 mb-2 align-left\">\n                    <div\n                      className=\"form-group align-left\"\n                      style={{ textAlign: \"left\" }}\n                    >\n                      <label className=\"text-label\">\n                        Platform Fee\n                      </label>\n                      <input\n                        type=\"number\"\n                        name=\"platformFee\"\n                        required = 'true'\n                        className=\"form-control\"\n                        // placeholder=\"fee\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.platformFee}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Royality Fee\n                      </label>\n                      <input\n                        type=\"number\"\n                        name=\"royalityFee\"\n                        className=\"form-control\"\n                        required = 'true'\n                        // placeholder=\"fee\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.royalityFee}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  {/* <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Royality Fee Percentage (Percentage)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"royalityFeePercentage\"\n                        className=\"form-control\"\n                        placeholder=\"Royality Fee In Percentage\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.royalityFeePercentage}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Mint Piqsol Fee (In PQL Tokens)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"mintPiqsolFee\"\n                        className=\"form-control\"\n                        placeholder=\"Mint Piqsol Fee\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.mintPiqsolFee}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Buy Now Piqsol Fee (In PQL Tokens)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"buyNowPiqsolFee\"\n                        className=\"form-control\"\n                        placeholder=\"Buy Now Piqsol Fee\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.buyNowPiqsolFee}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Make An Offer Piqsol Fee (In PQL Tokens)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"makeAnOfferPiqsolFee\"\n                        className=\"form-control\"\n                        placeholder=\"Make An Offer Piqsol Fee\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.makeAnOfferPiqsolFee}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Piqsol Price (In USD)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"piqsolPriceInSol\"\n                        className=\"form-control\"\n                        placeholder=\"Add Piqsol Price In Sol\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.piqsolPriceInSol}\n                        // pattern=\"^\\d*(\\.\\d{0,10})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Chat Duration In Days (In PQL Tokens)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"chatDurationInDays\"\n                        className=\"form-control\"\n                        placeholder=\"Add Chat duration\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.chatDurationInDays}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Listing Item Tax (In PQL Tokens)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"listingItemTax\"\n                        className=\"form-control\"\n                        placeholder=\"Add staking platform fee\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.listingItemTax}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Minimum Stake Locked Amount (In PQL Tokens)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"minimumStakeLockedAmount\"\n                        className=\"form-control\"\n                        placeholder=\"Add Minimum Stak Locked Amount\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.minimumStakeLockedAmount}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Staking Platform Fees (In PQL Tokens)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"stakingPlatformFee\"\n                        className=\"form-control\"\n                        placeholder=\"Add staking platform fee\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.stakingPlatformFee}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Batch Upload Tax Fee (In USD)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"batchUploadTaxFee\"\n                        className=\"form-control\"\n                        placeholder=\"Add Batch upload Fee in USD\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.batchUploadTaxFee}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Apply to be Featured Fee (In USD)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"applyToBeFeturedTaxFee\"\n                        className=\"form-control\"\n                        placeholder=\"Add Batch upload Fee in USD\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.applyToBeFeturedTaxFee}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\">\n                      <label className=\"text-label\">\n                        Launch Pad Tax Fee (In USD)\n                      </label>\n                      <input\n                        type=\"text\"\n                        name=\"launchPadTax\"\n                        className=\"form-control\"\n                        placeholder=\"Add Batch upload Fee in USD\"\n                        onChange={(e) => onInputValueChange(e)}\n                        value={systemSetting?.launchPadTax}\n                        // pattern=\"^\\d*(\\.\\d{0,2})?$\"\n                        // min={0}\n                      />\n                    </div>\n                  </div> */}\n                  {/* <div className=\"col-lg-6 mb-2\">\n                    <div className=\"form-group\"></div>\n                  </div> */}\n                  {/* <div className=\"col-lg-6 mb-2\">\n                    <div>\n                      <label>Select franctions</label>\n                      <input\n                        type=\"number\"\n                        name=\"franctionValue\"\n                        className=\"form-control\"\n                        placeholder=\"Enter Sqaure Number (e.g 5x5 = 25 so 25 will be added here)\"\n                        onChange={(e) => onFractionAdd(e)}\n                        value={fractionInput}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-lg-6 mb-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() => addFraction()}\n                      className=\"btn btn-primary mb-2 add-fraction\"\n                    >\n                      Add Fraction\n                    </button>\n                  </div>\n                  <div className=\"col-lg-12 mb-4\">\n                    <div>\n                      {fractionsValues?.length &&\n                        fractionsValues.map((fraction) => {\n                          return (\n                            <div className=\"fraction-values\">\n                              <div> {fraction}</div>\n\n                              <div\n                                style={{ cursor: \"pointer\" }}\n                                onClick={() => removeFraction(fraction)}\n                              >\n                                <FontAwesomeIcon icon={faXmark} />\n                              </div>\n                            </div>\n                          );\n                        })}\n                    </div>\n                  </div> */}\n                  <div className=\"col-lg-6 mb-2\">\n                    <ButtonLoader\n                      loader={loading}\n                      title={\"Update System Setting\"}\n                      classes=\"btn btn-primary mb-2\"\n                      disabled={loading}\n                    />\n                  </div>\n                  <div>\n                    <button\n                      type=\"button\"\n                      className=\"btn btn-primary mb-2 cancel-btn\"\n                    >\n                      Cancel\n                    </button>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        </div>\n      </div>\n    </Fragment>\n  );\n};\n\nexport default SystemSetting;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/ProtectedRoute.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/FractionsForm.js",["1299","1300","1301","1302","1303","1304","1305","1306","1307","1308","1309","1310","1311"],"import React, { Fragment, useEffect, useState } from \"react\";\nimport Products from \"./Products\";\nimport { useDispatch, useSelector } from 'react-redux';\nimport DataTable from \"../../../Dashboard/DataTable\";\n/// Data\n// import productData from \"../productData\";\n// import PageTitle from \"../../../../layouts/PageTitle\";\n// import DataTable from \"../../../Dashboard/DataTable\";\nimport { addFraction, getFractions } from \"../../../../../store/reducers/fractionReducer\";\nimport FractionListingTable from \"../../../listingTable/FractionsListing\";\n\nimport { Row, Card, Col, Alert, Button, Badge, Media, Dropdown, SplitButton, ButtonGroup } from \"react-bootstrap\";\nimport PageLoader from \"../../../common/pageLoader\";\nimport ButtonLoader from \"../../../common/buttonLoader\";\nimport SearchField from \"../../../common/searchFiled\";\nconst FractionsForm = () => {\n   const [loading, setLoading] = useState(false)\n   const [formValues, setFormValues] = useState({\n      fraction: null\n   })\n   const [searchText, setSearchText] = useState('')\n   const [showAlert, setAlert] = useState(false);\n   const dispatch = useDispatch();\n\n   const handleSearch = () => {\n      fetchPricingList({ search: searchText })\n   }\n\n   const handleChangeSearch = (e) => {\n      if (!e.target.value || e.target.value.trim() === null) {\n         setSearchText(e.target.value)\n         return fetchPricingList({ search: '' })\n      }\n      setSearchText(e.target.value)\n   }\n\n   const handleSubmit = async (e) => {\n      e.preventDefault();\n\n      let data = {\n         fraction: e.target.fractions.value\n      }\n      setLoading('add fraction')\n      await dispatch(addFraction(data));\n      fetchPricingList();\n\n   }\n   const fetchPricingList = async ({ search }) => {\n      await dispatch(getFractions( search || ''));\n      setLoading(false)\n   }\n   useEffect(() => {\n      setLoading('data')\n      fetchPricingList({ search: searchText });\n   }, [])\n\n   const handleChange = (e) => {\n      const { name, value } = e.target;\n      setFormValues((prevState) => ({\n         ...prevState,\n         [name]: value,\n      }));\n   };\n\n   const data = useSelector((store) => store.FractionsReducer.Fractions);\n   return (\n      <Fragment>\n         <div>\n            <div className=\"col-xl-6 col-lg-6\">\n               {showAlert && (<Alert\n\n                  variant={'light'}\n                  className=\"alert-dismissible fade show\"\n               >\n                  {/* {data.emoji} */}\n                  <strong>Fractions Added Successfully</strong>\n                  {/* {btn(i, setBasicData, basicData, true)} */}\n               </Alert>)}\n\n               <div className=\"card\">\n                  <div className=\"card-header\">\n                     <h4 className=\"card-title\">Add Pricing</h4>\n                  </div>\n                  <div className=\"card-body\">\n                     <div className=\"basic-form\">\n                        <form id=\"create-blog-form\" onSubmit={e => { handleSubmit(e) }}>\n                           <input\n                              type=\"number\"\n                              className=\"form-control input-default \"\n                              name=\"fractions\"\n                              placeholder=\"Fractions\"\n                              value={formValues.fractions}\n                              onChange={(e) => { handleChange(e) }}\n                           />\n\n                           <div className=\"mt-3 mt-sm-10\">\n                              <ButtonLoader loader={loading === 'add fraction'} title={'Add Fractions'} classes=\"btn btn-primary mb-2\" />\n                              {/* <button\n                                 type=\"submit\"\n                                 className=\"btn btn-primary mb-2\"\n                              >\n                                 Add Fractions\n                              </button> */}\n                           </div>\n                        </form>\n                     </div>\n                  </div>\n               </div>\n\n\n            </div>\n            <div className=\"col-xl-12 col-lg-12\">\n               {loading === 'data' ? <PageLoader /> :\n                  <>\n                     <div className=\"row\">\n                        <div className=\"col-xl-12 col-lg-12  justify-content-end d-flex\">\n                           <SearchField onChange={handleChangeSearch} searchText={searchText} handleSearch={handleSearch} />\n                        </div>\n                     </div>\n                     <FractionListingTable tabledata={data} />\n                  </>\n\n               }\n            </div>\n         </div>\n      </Fragment>\n   );\n};\n\nexport default FractionsForm;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/PricingForm.js",["1312","1313","1314","1315","1316","1317","1318","1319","1320","1321","1322","1323","1324","1325","1326","1327"],"import React, { Fragment, useEffect, useState } from \"react\";\nimport Products from \"./Products\";\nimport { useDispatch, useSelector } from 'react-redux';\nimport { Formik } from \"formik\";\nimport PricingTable from '../../../listingTable/PricingsListing'\n/// Data\n// import productData from \"../productData\";\n// import PageTitle from \"../../../../layouts/PageTitle\";\n// import DataTable from \"../../../Dashboard/DataTable\";\nimport { addPricing, getPricing } from \"../../../../../store/reducers/pricingReducer\";\n\nimport { Row, Card, Col, Alert, Button, Badge, Media, Dropdown, SplitButton, ButtonGroup } from \"react-bootstrap\";\nimport ButtonLoader from \"../../../common/buttonLoader\";\nimport PageLoader from \"../../../common/pageLoader\";\nimport SearchField from \"../../../common/searchFiled\";\nconst PricingForm = () => {\n   const [formValues, setFormValues] = useState({\n      title: '',\n      price: ''\n   })\n\n   const [showAlert, setAlert] = useState(false);\n   const [loader, setLoader] = useState(false);\n   const [loading, setLoading] = useState(true);\n   const [searchText, setSearchText] = useState('')\n   const [selectedCurrency, setCurrency] = useState(null);\n   const dispatch = useDispatch();\n\n   const handleSearch = () => {\n      fetchPricingList({ search: searchText })\n   }\n\n   const handleChangeSearch = (e) => {\n      if (!e.target.value || e.target.value.trim() === null) {\n         setSearchText(e.target.value)\n         return fetchPricingList({ search: '' })\n      }\n      setSearchText(e.target.value)\n   }\n\n   // const handleSubmit = async (e) => {\n   //    e.preventDefault();\n\n   //    let data = {\n   //       name: e.target.name.value,\n   //       price: e.target.price.value\n   //    }\n   //    setLoader(true)\n   //    await dispatch(addPricing(data));\n   //    fetchPricingList();\n   //    setLoader(false)\n\n   // }\n   const fetchPricingList = async ({ search }) => {\n      await dispatch(getPricing(search || ''));\n      setLoading(false)\n   }\n   useEffect(() => {\n      fetchPricingList({ search: searchText });\n   }, [])\n\n   // const handleChange = (e) => {\n   //    const { name, value } = e.target;\n   //    setFormValues((prevState) => ({\n   //       ...prevState,\n   //       [name]: value,\n   //    }));\n   // };\n\n   const data = useSelector((store) => store.PricingReducer.pricing);\n\n   const initialValues = {\n      name: \"\",\n      price: \"\"\n   };\n\n   const validate = (values) => {\n      let errors = {};\n\n      if (!values.name) {\n         errors.name = \"Name is required\";\n      }\n\n      if (!values.price) {\n         errors.price = \"Price is required\";\n      }\n\n      return errors;\n   };\n\n   const submitForm = async(values, { resetForm }) => {\n      setLoader(true)\n      await dispatch(addPricing({...values}));\n      fetchPricingList({ search: searchText });\n      setLoader(false)\n      resetForm()\n   };\n\n\n   return (\n      <Fragment>\n         <div>\n            <div className=\"col-xl-6 col-lg-6\">\n               {showAlert && (<Alert\n\n                  variant={'light'}\n                  className=\"alert-dismissible fade show\"\n               >\n                  {/* {data.emoji} */}\n                  <strong>Blog Added Successfully</strong>\n                  {/* {btn(i, setBasicData, basicData, true)} */}\n               </Alert>)}\n\n               <div className=\"card\">\n                  <div className=\"card-header\">\n                     <h4 className=\"card-title\">Add Pricing</h4>\n                  </div>\n                  <Formik\n                     initialValues={initialValues}\n                     validate={validate}\n                     onSubmit={submitForm}\n                  >\n                     {(formik) => {\n                        const {\n                           values,\n                           handleChange,\n                           handleSubmit,\n                           errors,\n                           touched,\n                           handleBlur,\n                           isValid,\n                           dirty\n                        } = formik;\n                        return (\n                           <form onSubmit={handleSubmit}>\n                              <div className=\"card-body\">\n                                 <div className=\"basic-form\">\n                                    {/* <form id=\"create-blog-form\" onSubmit={e => { handleSubmit(e) }}> */}\n                                    <div className=\"form-group\">\n                                       <input\n                                          type=\"text\"\n                                          className={`form-control input-default ${errors.email && touched.email ? \"input-error\" : null}`}\n                                          name=\"name\"\n                                          placeholder=\"Name\"\n                                          value={values.name}\n                                          onChange={handleChange}\n                                          onBlur={handleBlur}\n                                       />\n                                       {errors.name && touched.name && (\n                                          <span className=\"error\">{errors.name}</span>\n                                       )}\n                                    </div>\n                                    <input\n                                       type=\"number\"\n                                       className=\"form-control input-default \"\n                                       name=\"price\"\n                                       placeholder=\"Price\"\n                                       value={values.price}\n                                       onChange={handleChange}\n                                       onBlur={handleBlur}\n                                    />\n                                    {errors.price && touched.price && (\n                                       <span className=\"error\">{errors.price}</span>\n                                    )}\n                                    <div className=\"mt-3 mt-sm-10\">\n                                       <ButtonLoader classes=\"btn btn-primary mb-2\" title={'Add Price'} loader={loader}\n                                          disabled={!(dirty && isValid) || loader}\n                                       />\n                                       {/* <button\n                              type=\"submit\"\n                              className=\"btn btn-primary mb-2\"\n                           >\n                           Add Price\n                           </button> */}\n                                    </div>\n                                    {/* </form> */}\n                                 </div>\n                              </div>\n                           </form>\n                        )\n                     }}\n                  </Formik>\n               </div>\n            </div>\n\n            <div className=\"col-xl-12 col-lg-12\">\n               {loading ? <PageLoader /> :\n                  <>\n                     <div className=\"row\">\n                        <div className=\"col-xl-12 col-lg-12  justify-content-end d-flex\">\n                           <SearchField onChange={handleChangeSearch} searchText={searchText} handleSearch={handleSearch} />\n                        </div>\n                     </div>\n                     <PricingTable tabledata={data} />\n                  </>\n               }\n            </div>\n         </div>\n      </Fragment>\n   );\n};\n\nexport default PricingForm;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Blog/update/UpdateBlog.js",["1328","1329","1330","1331","1332"],"import React, { Fragment, useState, useEffect } from \"react\";\nimport { useDispatch } from 'react-redux'\nimport { useParams } from 'react-router-dom';\n// import Products from \"./Products\";\nimport { creteBlogs, updateBlog } from '../../../../store/reducers/blogReducer'\nimport { Editor } from \"react-draft-wysiwyg\";\nimport \"react-draft-wysiwyg/dist/react-draft-wysiwyg.css\";\nimport { fileUpload } from '../../../../Helper/common'\n\nimport ButtonLoader from \"../../common/buttonLoader\";\nimport { getBlogDetails } from '../../../../store/reducers/blogReducer';\nimport { convertToRaw, EditorState, convertFromRaw } from 'draft-js';\n\nconst UpdateBlog = () => {\n    const dispatch = useDispatch();\n    const params = useParams();\n    const [editorState, setEditorState] = useState(() =>\n        EditorState.createEmpty())\n    const [formValues, setFormValues] = useState({\n        id: null,\n        title: '',\n        read: '',\n        description: '',\n        image: 'test Image'\n    })\n    const [files, setFiles] = useState([])\n\n    const [loading, setLoading] = useState(false)\n    const [errors, setErrors] = useState({});\n\n    const validate = (values) => {\n        let err = {};\n\n        if (!formValues.title) {\n            err.title = \"Title is required\";\n        }\n        if (!formValues.read) {\n            err.read = \"Read time is required\";\n        }\n\n        if (editorState && !(editorState.getCurrentContent().getPlainText('\\u0001')) || (editorState.getCurrentContent().getPlainText('\\u0001').trim() === '')) {\n            err.description = \"Description is required\";\n        }\n\n        if (!files && !(files[0])) {\n            err.image = \"Image is required\";\n\n        } else if ((files && files[0]?.type.split('/')[0] !== 'image')) {\n            err.image = \"Please provide a valid image\";\n        }\n\n        return err;\n    };\n\n    const fetchBlogDetails = async () => {\n        try {\n            if (params?.id) {\n                const blog = await dispatch(getBlogDetails(params?.id));\n                const contentState = convertFromRaw(JSON.parse(blog?.description));\n                const editorState = EditorState.createWithContent(contentState);\n                setEditorState(editorState)\n                let tempformValues = { ...formValues }\n                tempformValues.id = blog?._id;\n                tempformValues.title = blog?.heading;\n                tempformValues.read = blog?.read;\n                tempformValues.image = blog?.image;\n                setFormValues(tempformValues);\n            }\n\n        } catch (error) {\n            console.log('error =====>', error)\n        }\n    }\n\n\n    useEffect(() => {\n        fetchBlogDetails()\n    }, [])\n\n\n\n    const handleSubmit = async (e) => {\n        e.preventDefault();\n        const err = validate()\n        if (Object.keys(err).length > 0) {\n            return setErrors(err)\n        }\n\n        setLoading(true);\n        let myHeaders = new Headers();\n        myHeaders.append(\"Content-Type\", \"application/json\");\n        const contentState = editorState.getCurrentContent();\n        let stateData = await JSON.stringify(convertToRaw(contentState));\n        const blogImage = await fileUpload(files[0])\n        const raw = {\n            id: formValues.id,\n            image: blogImage,\n            heading: formValues.title,\n            description: stateData || '',\n            read: formValues.read,\n            date: new Date()\n        };\n        const data = await dispatch(updateBlog(raw));\n        if (data?.heading) {\n            setFormValues({\n                title: '',\n                read: '',\n                description: '',\n                image: 'test Image'\n            })\n            setEditorState(EditorState.createEmpty())\n            setFiles([])\n        }\n        setLoading(false);\n    }\n\n    const handleChange = (e) => {\n        const { name, value } = e.target;\n        setErrors({ ...errors, [name]: undefined })\n        if (name === 'image') {\n            setFiles(e.target.files)\n        } else {\n            setFormValues((prevState) => ({\n                ...prevState,\n                [name]: value,\n            }));\n        }\n    };\n\n    const onEditorStateChange = (e) => {\n        setErrors({ ...errors, description: undefined })\n        setEditorState(e);\n    }\n\n    return (\n        <div className=\"row\">\n            <div className=\"col-xl-12 col-lg-12\">\n\n                <div className=\"card\">\n                    <div className=\"card-header\">\n                        <h4 className=\"card-title\">Update Blog</h4>\n                    </div>\n                    <div className=\"card-body\">\n                        <div className=\"basic-form\">\n                            <form id=\"create-blog-form\" onSubmit={e => { handleSubmit(e) }}>\n                                <div className=\"form-group\">\n                                    <input\n                                        type=\"text\"\n                                        className=\"form-control input-default \"\n                                        name=\"title\"\n                                        placeholder=\"Title\"\n                                        value={formValues.title}\n                                        onChange={(e) => { handleChange(e) }}\n                                    />\n                                    {errors.title && (\n                                        <span className=\"error\">{'Title is required'}</span>\n                                    )}\n                                </div>\n                                <div style={{ paddingLeft: 0 }} className=\"col-xl-4 col-lg-4 form-group\">\n                                    <input\n                                        type=\"number\"\n                                        min=\"0\"\n                                        className=\"form-control input-default \"\n                                        name=\"read\"\n                                        placeholder=\"Read Time\"\n                                        value={formValues.read}\n                                        onChange={(e) => { handleChange(e) }}\n                                    />\n                                    {errors.read && (\n                                        <span className=\"error\">{'Read time is required'}</span>\n                                    )}\n\n                                </div>\n                                <div className=\"form-group\" style={{ border: '1px solid #F8F8F8', borderRadius: '0.75rem' }}>\n                                    <Editor\n                                        editorState={editorState}\n                                        wrapperClassName=\"demo-wrapper\"\n                                        editorClassName=\"demo-editor\"\n                                        onEditorStateChange={onEditorStateChange}\n                                    />\n                                    {errors.description && (\n                                        <span className=\"error\">{'Description is required'}</span>\n                                    )}\n                                </div>\n                                <div className=\"input-group\">\n                                    <div className=\"custom-file\">\n                                        <input\n                                            name='image'\n                                            type=\"file\"\n                                            className=\"custom-file-input\"\n                                            onChange={handleChange}\n                                            accept=\".png, .jpg, .jpeg, .webp\"\n                                        />\n                                        <label className=\"custom-file-label\">\n                                            {(files && files[0]) ? files && files[0]?.name : `Choose file`}\n                                        </label>\n                                    </div>\n                                </div>\n                                {errors.image && (\n                                    <span className=\"error\">{'Valid Image is required'}</span>\n                                )}\n                                <div className=\"mt-3 mt-sm-10\">\n                                    <ButtonLoader loader={loading} title={'Update Blog'} classes=\"btn btn-primary mb-2\"\n                                        disabled={loading}\n                                    />\n                                </div>\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    );\n};\n\nexport default UpdateBlog;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/Blog/details/BlogDetails.js",["1333","1334","1335","1336","1337"],"import React, { useEffect, useState } from \"react\";\n// Material Ui Components\nimport {\n  Typography,\n  Box,\n  Container,\n  Grid,\n  Button,\n  Tabs,\n  Tab,\n} from \"@mui/material\";\nimport styles from \"./blog.module.scss\";\nimport { FontAwesomeIcon } from \"@fortawesome/react-fontawesome\";\n// import ss from \"../../assets/images/ss.png\";\nimport { faCalendarDays, faCircle } from \"@fortawesome/free-solid-svg-icons\";\nimport axios from \"axios\";\nimport parse from \"html-react-parser\";\nimport draftToHtml from \"draftjs-to-html\";\nimport { useParams } from \"react-router-dom\";\n\nconst Blogsinglepage = () => {\n  const [blog, setBlog] = useState({\n    read: \"\",\n    heading: \"\",\n    image: \"\",\n    description: \"\",\n    date: null,\n  });\n  const { id } = useParams();\n  // let location = useLocation()\n  const fetchBlogDetails = async () => {\n    const authToken = (await localStorage.getItem(\"authToken\")) || \"\";\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + `blog/getBlogDetails/${id}`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n\n      const date = new Date(res.data?.date);\n      const month = date.toLocaleString(\"default\", { month: \"long\" });\n      const fullDate = month + \" \" + date.getDate() + \",\" + date.getFullYear();\n      let resp = { ...res.data };\n      resp.date = fullDate;\n      setBlog(resp);\n    } catch (error) {\n      console.log(\"error =====>\", error);\n    }\n  };\n  useEffect(() => {\n    fetchBlogDetails();\n  }, []);\n\n  return (\n    <>\n      <Container>\n        <Box className={styles.blogsingle}>\n          <Box className={styles.maxWidth}>\n            <Typography component=\"h3\" className={styles.pageTitle}>\n              {blog.heading}\n            </Typography>\n            <Box sx={{ my: 4, display: \"flex\", alignItems: \"center\" }}>\n              <Box sx={{ display: \"flex\", alignItems: \"center\" }}>\n                <FontAwesomeIcon className={styles.cal} icon={faCalendarDays} />\n                <Typography\n                  component=\"p\"\n                  className={styles.bloginfo}\n                  sx={{ ml: 1 }}\n                >\n                  {blog?.date}\n                </Typography>\n              </Box>\n              <Box sx={{ ml: 2, display: \"flex\", alignItems: \"center\" }}>\n                <FontAwesomeIcon className={styles.cir} icon={faCircle} />\n                <Typography\n                  component=\"p\"\n                  className={styles.bloginfo}\n                  sx={{ ml: 1 }}\n                >\n                  {blog?.read}min Read\n                </Typography>\n              </Box>\n            </Box>\n            <Box\n              component=\"img\"\n              src={blog?.image}\n              className={styles.featureImg}\n            ></Box>\n            <Box className={styles.content} sx={{ mt: 5 }}>\n              {blog?.description !== \"\" &&\n                parse(draftToHtml(JSON.parse(blog?.description)))}\n            </Box>\n          </Box>\n        </Box>\n      </Container>\n    </>\n  );\n};\n\nexport default Blogsinglepage;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/NewsGrid.js",["1338"],"import { Fragment, useEffect, useState } from \"react\";\nimport { useDispatch, useSelector } from \"react-redux\";\nimport { NavLink } from \"react-router-dom\";\n// import Products from \"./Products\";\n\n/// Data\n// import productData from \"../productData\";\nimport PageTitle from \"../../../../layouts/PageTitle\";\nimport BlogListingTable from \"../../../listingTable/BlogListing\";\n\nimport PageLoader from \"../../../common/pageLoader\";\nimport SearchField from \"../../../common/searchFiled\";\nimport { alert } from \"../../../../../store/reducers/alertSlice\";\nimport Pagination from \"../../../common/pagination\";\nimport { deleteNews, getNews } from \"../../../../../store/reducers/newReducer\";\nimport NewsListingsTable from \"../../../listingTable/NewListings\";\nconst BlogsGrid = () => {\n  const [loader, setLoader] = useState({ data: true, filter: false });\n  const [searchText, setSearchText] = useState(\"\");\n  const dispatch = useDispatch();\n  const [page, setPage] = useState(0);\n  const limit = 20;\n\n  const getNewsListings = async ({ search, page }) => {\n    await dispatch(getNews({ search, limit, page }));\n    setLoader({ data: false, filter: false });\n  };\n\n  useEffect(() => {\n    // setLoader({ data: true, filter: true })\n    getNewsListings({ search: searchText, page: 1 });\n\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  const handleSearch = () => {\n    setLoader({ data: true, filter: true });\n    getNewsListings({ search: searchText, page: 1 });\n  };\n\n  const handleChange = (e) => {\n    if (!e.target.value || e.target.value.trim() === null) {\n      setSearchText(e.target.value);\n      setLoader({ data: true, filter: true });\n      return getNewsListings({ search: \"\", page: 1 });\n    }\n    setSearchText(e.target.value);\n  };\n\n  const onDeleteConfirm = async (id) => {\n    console.log(\"🚀 ~ file: NewsGrid.js ~ line 51 ~ onDeleteConfirm ~ id\", id);\n    try {\n      let deletedNews = await dispatch(deleteNews(id));\n      if (deletedNews) {\n        dispatch(\n          alert({\n            title: `Success`,\n            message: `News deleted Successfully`,\n            severity: \"success\",\n          })\n        );\n        setLoader({ data: true, filter: true });\n        getNewsListings({ search: searchText, page: data?.page });\n      }\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `failed`,\n          message: `failed to delete Blog`,\n          severity: \"error\",\n        })\n      );\n    }\n  };\n\n  const handlePageClick = (e) => {\n    setLoader({ data: true, filter: false });\n    setPage(e.selected);\n    return getNewsListings({ search: searchText, page: e.selected + 1 });\n  };\n\n  const data = useSelector((state) => state.news.news);\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"listing\" motherMenu=\"News\" />\n      {loader?.data ? (\n        <PageLoader />\n      ) : (\n        <div className=\"row justify-content-end\">\n          <div className=\"d-flex align-items-center mr-5\">\n            <SearchField\n              onChange={handleChange}\n              searchText={searchText}\n              handleSearch={handleSearch}\n            />\n            <NavLink\n              exact\n              to=\"/news-form\"\n              aria-expanded=\"false\"\n              activeClassName=\"selected\"\n              className=\"btn btn-primary mb-3 ml-3\"\n            >\n              <span className=\"item\">Create News</span>\n            </NavLink>\n          </div>\n          <NewsListingsTable\n            limit={limit}\n            page={page}\n            tabledata={data?.docs}\n            deleteBlog={(id) => onDeleteConfirm(id)}\n          />\n        </div>\n      )}\n      {data?.totalDocs && !loader?.filter && (\n        <div>\n          Showing {limit * page + 1} to{\" \"}\n          {data?.totalDocs < limit ? data?.totalDocs : limit * (page + 1)} {\"\"}\n          of {data?.totalDocs} entries\n          {\n            <Pagination\n              handlePageClick={handlePageClick}\n              totalDocs={data?.totalDocs}\n            />\n          }\n        </div>\n      )}\n    </Fragment>\n  );\n};\n\nexport default BlogsGrid;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/BlogsGrid.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/AppsMenu/Shop/ProductGrid/BlogsForm.js",["1339","1340"],"import React, { Fragment, useState } from \"react\";\nimport { useDispatch } from \"react-redux\";\n// import Products from \"./Products\";\nimport { creteBlogs } from \"../../../../../store/reducers/blogReducer\";\nimport { convertToRaw, EditorState } from \"draft-js\";\nimport { Editor } from \"react-draft-wysiwyg\";\n// import htmlToDraft from \"html-to-draftjs\";\nimport \"react-draft-wysiwyg/dist/react-draft-wysiwyg.css\";\nimport CircularProgress from \"@material-ui/core/CircularProgress\";\nimport { fileUpload } from \"../../../../../Helper/common\";\nimport ButtonLoader from \"../../../common/buttonLoader\";\nimport PageTitle from \"../../../../layouts/PageTitle\";\nimport { alert } from \"../../../../../store/reducers/alertSlice\";\nconst BlogsForm = () => {\n  const [editorState, setEditorState] = useState(() =>\n    EditorState.createEmpty()\n  );\n  const [formValues, setFormValues] = useState({\n    title: \"\",\n    read: \"\",\n    description: \"\",\n    image: \"test Image\",\n  });\n  const [files, setFiles] = useState([]);\n\n  const dispatch = useDispatch();\n  const [showAlert, setAlert] = useState(false);\n  const [loading, setLoading] = useState(false);\n  const [errors, setErrors] = useState({});\n\n  const validate = (values) => {\n    let err = {};\n\n    if (!formValues.title) {\n      err.title = \"Title is required\";\n    }\n    if (!formValues.read) {\n      err.read = \"Read time is required\";\n    }\n\n    if (\n      (editorState &&\n        !editorState.getCurrentContent().getPlainText(\"\\u0001\")) ||\n      editorState.getCurrentContent().getPlainText(\"\\u0001\").trim() === \"\"\n    ) {\n      err.description = \"Description is required\";\n    }\n\n    if (!files && !files[0]) {\n      err.image = \"Image is required\";\n    } else if (files && files[0]?.type.split(\"/\")[0] !== \"image\") {\n      err.image = \"Please provide a valid image\";\n    }\n\n    return err;\n  };\n\n  const handleSubmit = async (e) => {\n    e.preventDefault();\n    const err = validate();\n    if (Object.keys(err).length > 0) {\n      return setErrors(err);\n    }\n\n    setLoading(true);\n    let myHeaders = new Headers();\n    myHeaders.append(\"Content-Type\", \"application/json\");\n    const contentState = editorState.getCurrentContent();\n    let stateData = await JSON.stringify(convertToRaw(contentState));\n    const blogImage = await fileUpload(files[0]);\n    const raw = {\n      image: blogImage,\n      heading: formValues.title,\n      description: stateData || \"\",\n      read: formValues.read,\n      date: new Date(),\n    };\n    const data = await dispatch(creteBlogs(raw));\n    if (data) {\n      dispatch(\n        alert({\n          title: `Success`,\n          message: `Blog Created Successfully`,\n          severity: \"success\",\n        })\n      );\n      setTimeout(() => {\n        setAlert(false);\n        document.getElementById(\"create-blog-form\").reset();\n      }, 3000);\n    }\n    if (data?.heading) {\n      setFormValues({\n        title: \"\",\n        read: \"\",\n        description: \"\",\n        image: \"test Image\",\n      });\n      setEditorState(EditorState.createEmpty());\n      setFiles([]);\n    }\n    setLoading(false);\n  };\n\n  const handleChange = (e) => {\n    const { name, value } = e.target;\n    setErrors({ ...errors, [name]: undefined });\n    if (name === \"image\") {\n      setFiles(e.target.files);\n    } else {\n      setFormValues((prevState) => ({\n        ...prevState,\n        [name]: value,\n      }));\n    }\n  };\n\n  const onEditorStateChange = (e) => {\n    setErrors({ ...errors, description: undefined });\n    setEditorState(e);\n  };\n\n  return (\n    <Fragment>\n      <PageTitle activeMenu=\"Create\" motherMenu=\"Blogs\" />\n      <div className=\"row\">\n        <div className=\"col-xl-12 col-lg-12\">\n          <div className=\"card\">\n            <div className=\"card-header\">\n              <h4 className=\"card-title\">Create Blog</h4>\n            </div>\n            <div className=\"card-body\">\n              <div className=\"basic-form\">\n                <form\n                  id=\"create-blog-form\"\n                  onSubmit={(e) => {\n                    handleSubmit(e);\n                  }}\n                >\n                  <div className=\"form-group\">\n                    <input\n                      type=\"text\"\n                      className=\"form-control input-default \"\n                      name=\"title\"\n                      placeholder=\"Title\"\n                      value={formValues.title}\n                      onChange={(e) => {\n                        handleChange(e);\n                      }}\n                    />\n                    {errors.title && (\n                      <span className=\"error\">{\"Title is required\"}</span>\n                    )}\n                  </div>\n                  <div\n                    style={{ paddingLeft: 0 }}\n                    className=\"col-xl-4 col-lg-4 form-group\"\n                  >\n                    <input\n                      type=\"number\"\n                      min=\"0\"\n                      className=\"form-control input-default \"\n                      name=\"read\"\n                      placeholder=\"Read Time\"\n                      value={formValues.read}\n                      onChange={(e) => {\n                        handleChange(e);\n                      }}\n                    />\n                    {errors.read && (\n                      <span className=\"error\">{\"Read time is required\"}</span>\n                    )}\n                  </div>\n                  <div\n                    className=\"form-group\"\n                    style={{\n                      border: \"1px solid #F8F8F8\",\n                      borderRadius: \"0.75rem\",\n                    }}\n                  >\n                    <Editor\n                      editorState={editorState}\n                      wrapperClassName=\"demo-wrapper\"\n                      editorClassName=\"demo-editor\"\n                      onEditorStateChange={onEditorStateChange}\n                    />\n\n                    {errors.description && (\n                      <span className=\"error\">{\"Description is required\"}</span>\n                    )}\n                  </div>\n                  <div className=\"input-group\">\n                    <div className=\"custom-file\">\n                      <input\n                        name=\"image\"\n                        type=\"file\"\n                        className=\"custom-file-input\"\n                        onChange={handleChange}\n                        accept=\".png, .jpg, .jpeg, .webp\"\n                      />\n                      <label className=\"custom-file-label\">\n                        {files && files[0]\n                          ? files && files[0]?.name\n                          : `Choose file`}\n                      </label>\n                    </div>\n                  </div>\n                  {errors.image && (\n                    <span className=\"error\">{\"Valid Image is required\"}</span>\n                  )}\n                  <div className=\"mt-3 mt-sm-10\">\n                    <ButtonLoader\n                      loader={loading}\n                      title={\"Create Blog\"}\n                      classes=\"btn btn-primary mb-2\"\n                      disabled={loading}\n                    />\n                  </div>\n                </form>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </Fragment>\n  );\n};\n\nexport default BlogsForm;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/PluginsMenu/Lightgallery/Lightgallery.js",["1341"],"import React,{Component} from 'react';\r\nimport SimpleReactLightbox from 'simple-react-lightbox';\r\nimport {SRLWrapper} from 'simple-react-lightbox';\r\n\r\nimport big1 from '../../../../images/big/img1.jpg';\r\nimport big2 from '../../../../images/big/img2.jpg';\r\nimport big3 from '../../../../images/big/img3.jpg';\r\nimport big4 from '../../../../images/big/img4.jpg';\r\nimport big5 from '../../../../images/big/img5.jpg';\r\nimport big6 from '../../../../images/big/img6.jpg';\r\nimport big7 from '../../../../images/big/img7.jpg';\r\nimport big8 from '../../../../images/big/img8.jpg';\r\n\r\nconst lightGallery = [\r\n\t{ thumb : big1, large :\tbig1,\t},\t\r\n\t{ thumb : big2, large :\tbig2,\t},\t\r\n\t{ thumb : big3, large :\tbig3,\t},\t\r\n\t{ thumb : big4, large :\tbig4,\t},\t\r\n\t{ thumb : big5, large :\tbig5,\t},\t\r\n\t{ thumb : big6, large :\tbig6,\t},\t\r\n\t{ thumb : big7, large :\tbig7,\t},\t\r\n\t{ thumb : big8, large :\tbig8,\t},\t\r\n];\r\n\r\nclass Lightgallery extends Component{\r\n\trender(){\r\n\t\treturn(\r\n\t\t\t<>\t\r\n\t\t\t\t<SimpleReactLightbox>\r\n\t\t\t\t\t<SRLWrapper>\r\n\t\t\t\t\t\t<div className=\"row\">\r\n\t\t\t\t\t\t\t<div className=\"col-lg-12\">\r\n\t\t\t\t\t\t\t\t<div className=\"card\">\r\n\t\t\t\t\t\t\t\t\t<div className=\"card-header\">\r\n\t\t\t\t\t\t\t\t\t\t<h4 className=\"card-title\">Light Gallery</h4>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t<div className=\"card-body pb-1\">\r\n\t\t\t\t\t\t\t\t\t\t<div id=\"lightgallery\" className=\"row\">\r\n\t\t\t\t\t\t\t\t\t\t\t{lightGallery.map((item,index)=>(\r\n\t\t\t\t\t\t\t\t\t\t\t\t<a href={item.large} data-exthumbimage=\"images/big/img1.jpg\" data-src={big1} className=\"col-lg-3 col-md-6 mb-4\" key={index}>\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img src={item.thumb} style={{width:\"100%\"}} />\r\n\t\t\t\t\t\t\t\t\t\t\t\t</a>\r\n\t\t\t\t\t\t\t\t\t\t\t))}\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t{/* <!-- /# card --> */}\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</SRLWrapper>\r\n\t\t\t\t</SimpleReactLightbox>\r\n\t\t\t</>\r\n\t\t)\r\n\t}\r\n}\r\nexport default Lightgallery;","/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/PluginsMenu/Jqv Map/JqvMap.js",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/components/PluginsMenu/Toastr/Toastr.js",["1342"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { ToastContainer, toast } from \"react-toastify\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport PageTitle from \"../../../layouts/PageTitle\";\n\nconst Toastr = () => {\n   const notifyTopRight = () => {\n      toast.success(\"✅ Top Right !\", {\n         position: \"top-right\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n      });\n   };\n\n   const notifyBottomRight = () => {\n      toast.warn(\"✅ Bottom Right !\", {\n         position: \"bottom-right\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n      });\n   };\n\n   const notifyBottomLeft = () => {\n      toast.success(\"✅ Bottom Left !\", {\n         position: \"bottom-left\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n\n   const notifyTopLeft = () => {\n      toast.warn(\"✅ Top Left !\", {\n         position: \"bottom-left\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n\n   const notifyTopFullWidth = () => {\n      toast.warn(\"✅ Top Full Width !\", {\n         position: \"top-center\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n\n   const notifyBottomFullWidth = () => {\n      toast.warn(\"✅ Bottom Full Width !\", {\n         position: \"bottom-center\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n\n   const notifyTopCenter = () => {\n      toast.warn(\"✅ Top Center !\", {\n         position: \"top-center\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n\n   const notifyBottomCenter = () => {\n      toast.warn(\"✅ Bottom Center !\", {\n         position: \"bottom-center\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n   const notifyInfo = () => {\n      toast.info(\"❓ Info Notify !\", {\n         position: \"top-right\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n   const notifyWarning = () => {\n      toast.warn(\"❗ Warning Notify !\", {\n         position: \"top-right\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n\n   const notifyError = () => {\n      toast.error(\"❌ Error Notify !\", {\n         position: \"top-right\",\n         autoClose: 5000,\n         hideProgressBar: false,\n         closeOnClick: true,\n         pauseOnHover: true,\n         draggable: true,\n         progress: undefined,\n      });\n   };\n   return (\n      <div className=\"h-80\">\n         <PageTitle activeMenu=\"Toastr\" motherMenu=\"Advanced\" />\n\n         <div className=\"row\">\n            <div className=\"col-12\">\n               <div className=\"card\">\n                  <div className=\"card-header\">\n                     <h4 className=\"card-title\">Toastr</h4>\n                  </div>\n                  <div className=\"card-body\">\n                     <button\n                        onClick={notifyTopRight}\n                        type=\"button\"\n                        className=\"btn btn-dark mb-2 mr-2\"\n                        id=\"toastr-success-top-right\"\n                     >\n                        <ToastContainer\n                           position=\"top-right\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Top Right\n                     </button>\n                     <button\n                        onClick={notifyBottomRight}\n                        type=\"button\"\n                        className=\"btn btn-dark mb-2  mr-2\"\n                        id=\"toastr-success-bottom-right\"\n                     >\n                        <ToastContainer\n                           position=\"bottom-right\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Bottom Right\n                     </button>\n                     <button\n                        onClick={notifyBottomLeft}\n                        type=\"button\"\n                        className=\"btn btn-dark mb-2  mr-2\"\n                        id=\"toastr-success-bottom-left\"\n                     >\n                        <ToastContainer\n                           position=\"bottom-left\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Bottom Left\n                     </button>\n                     <button\n                        onClick={notifyTopLeft}\n                        type=\"button\"\n                        className=\"btn btn-dark mb-2  mr-2\"\n                        id=\"toastr-success-top-left\"\n                     >\n                        <ToastContainer\n                           position=\"top-left\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Top Left\n                     </button>\n                     <button\n                        onClick={notifyTopFullWidth}\n                        type=\"button\"\n                        className=\"btn btn-dark mb-2  mr-2\"\n                        id=\"toastr-success-top-full-width\"\n                     >\n                        <ToastContainer\n                           position=\"top-center\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Top Full Width\n                     </button>\n                     <button\n                        onClick={notifyBottomFullWidth}\n                        type=\"button\"\n                        className=\"btn btn-dark mb-2  mr-2\"\n                        id=\"toastr-success-bottom-full-width\"\n                     >\n                        <ToastContainer\n                           position=\"bottom-center\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Bottom Full Width\n                     </button>\n                     <button\n                        onClick={notifyTopCenter}\n                        type=\"button\"\n                        className=\"btn btn-dark mb-2  mr-2\"\n                        id=\"toastr-success-top-center\"\n                     >\n                        <ToastContainer\n                           position=\"top-center\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Top Center\n                     </button>\n                     <button\n                        onClick={notifyBottomCenter}\n                        type=\"button\"\n                        className=\"btn btn-dark mb-2  mr-2\"\n                        id=\"toastr-success-bottom-center\"\n                     >\n                        <ToastContainer\n                           position=\"bottom-center\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Bottom Center\n                     </button>\n                     <button\n                        onClick={notifyInfo}\n                        type=\"button\"\n                        className=\"btn btn-info mb-2  mr-2\"\n                        id=\"toastr-info-top-right\"\n                     >\n                        <ToastContainer\n                           position=\"top-right\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Info\n                     </button>\n                     <button\n                        onClick={notifyWarning}\n                        type=\"button\"\n                        className=\"btn btn-warning mb-2  mr-2\"\n                        id=\"toastr-warning-top-right\"\n                     >\n                        <ToastContainer\n                           position=\"top-right\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Warning\n                     </button>\n                     <button\n                        onClick={notifyError}\n                        type=\"button\"\n                        className=\"btn btn-danger mb-2  mr-2\"\n                        id=\"toastr-danger-top-right\"\n                     >\n                        <ToastContainer\n                           position=\"top-right\"\n                           autoClose={5000}\n                           hideProgressBar={false}\n                           newestOnTop\n                           closeOnClick\n                           rtl={false}\n                           pauseOnFocusLoss\n                           draggable\n                           pauseOnHover\n                        />\n                        Error\