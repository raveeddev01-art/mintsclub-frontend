d Date ====>\", endDate);\n    // console.log(\"Get form Data\")\n    dispatch(setLoading(true));\n    console.log(\"sort =====>\", sort);\n    try {\n      const authToken = localStorage.getItem(\"authToken\") || \"\";\n      // console.log(\"All users authToken \", JSON.stringify(authToken));\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + \"listing/getAllUsers\",\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n        params: {\n          isBlocked: isVerified === \"blocked\" || undefined,\n          isVerified: (isVerified !== \"blocked\" && isVerified) || undefined,\n          search,\n          startDate: startDate !== \"\" ? startDate : undefined,\n          endDate: endDate !== \"\" ? endDate : undefined,\n          sort: sort === \"Ascending\" ? 1 : -1,\n          limit,\n          page,\n        },\n      });\n      let data = res.data;\n      dispatch(setUsers(data));\n      return res?.data;\n      // console.log(\"All users \", JSON.stringify(data));\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const changeUserVerifiedStatus =\n  ({ isVerified, id }: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    try {\n      const authToken = localStorage.getItem(\"authToken\") || \"\";\n      let res = await axios({\n        method: \"patch\",\n        url: `${process.env.REACT_APP_BASE_URL}user/changeVerifiedStatus/${id}`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n        data: { isVerified },\n      });\n      dispatch(\n        alert({\n          title: `Success`,\n          message: res?.data?.message || `User updated successfully`,\n          severity: \"success\",\n        })\n      );\n      return res?.data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const changeUserBlockStatus =\n  ({ isBlocked, id }: any): AppThunk =>\n  async (dispatch) => {\n    dispatch(setLoading(true));\n    try {\n      const authToken = localStorage.getItem(\"authToken\") || \"\";\n      let res = await axios({\n        method: \"patch\",\n        url: `${process.env.REACT_APP_BASE_URL}user/changeBlockStatus/${id}`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n        data: { isBlocked },\n      });\n      dispatch(\n        alert({\n          title: `Success`,\n          message: res?.data?.message || `User updated successfully`,\n          severity: \"success\",\n        })\n      );\n      return res?.data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getUserDetails =\n  (id: string): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + `user/getUser/${id}`,\n        // params: {\n        //   id\n        // },\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      const data = res.data;\n      return data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    }\n  };\n\nexport const getLoggedInUser = (): AppThunk => async (dispatch) => {\n  const authToken = localStorage.getItem(\"authToken\") || \"\";\n  try {\n    dispatch(setLoading(true));\n    if (authToken && authToken !== \"\") {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + `admin/getLoggedInAdmin`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      const data = res.data;\n      dispatch(loggedInUser(data));\n      return data;\n    }\n  } catch (error) {\n    dispatch(\n      alert({\n        title: `Failed`,\n        message: error?.response?.data?.message || \"something went wrong\",\n        severity: \"error\",\n      })\n    );\n    dispatch(setFailed(error));\n  }\n};\n\nexport const updateMe =\n  (data: object): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"patch\",\n        url: process.env.REACT_APP_BASE_URL + `admin/updateMe`,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n        data,\n      });\n      dispatch(loggedInUser(res?.data));\n      dispatch(\n        alert({\n          title: `Success`,\n          message: res?.data?.message || `Profile updated successfully`,\n          severity: \"success\",\n        })\n      );\n      return res?.data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    }\n  };\n\nexport const {\n  setUsers,\n  setLoading,\n  setFailed,\n  chatSelectedUser,\n  loggedInUser,\n} = userSlice.actions;\n\nexport default userSlice.reducer;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/store/reducers/blogReducer.ts",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/store/reducers/auctionsReducer.ts",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/store/reducers/swappingRevenueReducer.ts",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/store/reducers/fractionReducer.ts",["1126","1127"],"import { createSlice } from \"@reduxjs/toolkit\";\n\nimport { AppThunk, RootState } from \"../store\";\nimport axios from \"axios\";\nimport { alert } from \"./alertSlice\";\n\nexport interface ErrorMessage {\n  message: string;\n}\nexport interface Fraction {\n  _id: String;\n  fraction : Number\n}\nexport interface FractionState {\n  Fractions?: Fraction[];\n  isLoading: boolean;\n  error: ErrorMessage;\n}\n\nexport const initialState: FractionState = {\n  isLoading: false,\n  error: { message: \"An Error occurred\" },\n};\n\nexport const fractionSlice = createSlice({\n  name: \"createFraction\",\n  initialState,\n  reducers: {\n    setLoading: (state, { payload }) => {\n      state.isLoading = payload;\n    },\n    setFractions: (state, payload) => {\n      state.Fractions = payload.payload;\n      console.log(\" Blog's \", state.Fractions);\n    },\n    setFailed: (state, { payload }) => {\n      state.error = payload;\n    },\n  },\n});\n\nexport const getFractions = (search: string): AppThunk => async (dispatch) => {\n  console.log('Here I a, calling API')\n  const authToken = localStorage.getItem(\"authToken\") || \"\";\n  dispatch(setLoading(true));\n  console.log('here URL ' , process.env.REACT_APP_BASE_URL + \"count/getAllCount\")\n  try {\n    let res = await axios({\n      method: \"get\",\n      url: process.env.REACT_APP_BASE_URL + \"fractions/getAllFractions\",\n      headers: {\n        \"x-auth-token\": authToken,\n      },\n      params:{\n        search\n      }\n    });\n    \n    let data = res.data;\n    dispatch(setFractions(data));\n  } catch (error) {\n    dispatch(alert({\n      title: `Failed`,\n      message: error?.response?.data?.message || 'something went wrong',\n      severity: \"error\",\n    }))\n    dispatch(setFailed(error));\n  } finally {\n    dispatch(setLoading(false));\n  }\n};\n\nexport const addFraction = (fraction : any): AppThunk => async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    console.log('here URL ' , process.env.REACT_APP_BASE_URL + \"fractions/addFractions\")\n    try {\n      let res = await axios({\n        method: \"post\",\n        url: process.env.REACT_APP_BASE_URL + \"fractions/addFractions\",\n        data : fraction,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      \n      let data = res.data;\n      dispatch(alert({\n        title: `Success`,\n        message: res?.data?.message || `Fraction added successfully`,\n        severity: \"success\",\n      }))\n    //   dispatch(setFractions(data));\n    } catch (error) {\n      dispatch(alert({\n        title: `Failed`,\n        message: error?.response?.data?.message || 'something went wrong',\n        severity: \"error\",\n      }))\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\n\nexport const { setLoading, setFailed, setFractions  } = fractionSlice.actions;\n\nexport default fractionSlice.reducer;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/store/reducers/paymentReducer.ts",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/store/reducers/faq.Reducer.ts",["1128"],"import { createSlice } from \"@reduxjs/toolkit\";\n\nimport { AppThunk, RootState } from \"../store\";\nimport axios from \"axios\";\nimport { alert } from \"./alertSlice\";\n\nexport interface ErrorMessage {\n  message: string;\n}\nexport interface FAQ {\n  _id: String;\n  question: string;\n  answer: string;\n}\nexport interface CountState {\n  faqs?: FAQ[];\n  isLoading: boolean;\n  error: ErrorMessage;\n}\n\nexport const initialState: CountState = {\n  isLoading: false,\n  error: { message: \"An Error occurred\" },\n};\n\nexport const faqSlice = createSlice({\n  name: \"createFaq\",\n  initialState,\n  reducers: {\n    setLoading: (state, { payload }) => {\n      state.isLoading = payload;\n    },\n    setFaq: (state, payload) => {\n      state.faqs = payload.payload;\n    },\n    setFailed: (state, { payload }) => {\n      state.error = payload;\n    },\n  },\n});\n\nexport const createFaq =\n  (faq: object): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"post\",\n        url: process.env.REACT_APP_BASE_URL + \"faq/addFaq\",\n        data: faq,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      let data = res.data;\n      return data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const getFaqs = ({search, limit, page}: any): AppThunk => async (dispatch) => {\n  const authToken = localStorage.getItem(\"authToken\") || \"\";\n  dispatch(setLoading(true));\n  try {\n    let res = await axios({\n      method: \"get\",\n      url: process.env.REACT_APP_BASE_URL + \"faq/getAllFaqs\",\n      headers: {\n        \"x-auth-token\": authToken,\n      },\n      params: {\n        search,\n        limit,\n        page\n      },\n    });\n\n    let data = res.data;\n    dispatch(setFaq(data));\n  } catch (error) {\n    dispatch(\n      alert({\n        title: `Failed`,\n        message: error?.response?.data?.message || \"something went wrong\",\n        severity: \"error\",\n      })\n    );\n    dispatch(setFailed(error));\n  } finally {\n    dispatch(setLoading(false));\n  }\n};\n\nexport const deleteFaq =\n  (id: string): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"get\",\n        url: process.env.REACT_APP_BASE_URL + \"faq/deleteFaq/\" + id,\n\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      const data = res.data;\n      return data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    }\n  };\n\nexport const updateFaq =\n  (faq: object): AppThunk =>\n  async (dispatch) => {\n    const authToken = localStorage.getItem(\"authToken\") || \"\";\n    dispatch(setLoading(true));\n    try {\n      let res = await axios({\n        method: \"post\",\n        url: process.env.REACT_APP_BASE_URL + \"faq/updateFaq\",\n        data: faq,\n        headers: {\n          \"x-auth-token\": authToken,\n        },\n      });\n      let data = res.data;\n      return data;\n    } catch (error) {\n      dispatch(\n        alert({\n          title: `Failed`,\n          message: error?.response?.data?.message || \"something went wrong\",\n          severity: \"error\",\n        })\n      );\n      dispatch(setFailed(error));\n    } finally {\n      dispatch(setLoading(false));\n    }\n  };\n\nexport const { setLoading, setFailed, setFaq } = faqSlice.actions;\n\nexport default faqSlice.reducer;\n","/Users/ameerhamza/Downloads/Hamza Admin/src/store/reducers/newReducer.ts",[],"/Users/ameerhamza/Downloads/Hamza Admin/src/jsx/layouts/Footer.js",["1129","1130"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\n\nconst Footer = () => {\n   return (\n 