omponents/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types/types.js",[],["614","615"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],["616","617"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.action.js",["618"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["619","620"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["621"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.action.js",["622"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-card/nft-card.js",["623","624","625","626","627"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",["628"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/videoCard.js",["629"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/levelsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/statsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BidModal.js",["630"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BuyModal.js",["631","632","633","634","635"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.action.js",["636","637"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/ApprovalModal.js",["638","639","640"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["641"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        \n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n",["642","643"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/StatsModal.js",["644","645"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/PropertiesModal.js",["646"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/LevelsModal.js",["647"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["648","649"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <div className=\"upload-image-border p-4 position-relative\">\n      <div className=\"nft-uploaded-img-container\">\n        {imageURL || videoURL || audioSrc ? (\n          <MdClose\n            color=\"#e33d0bc2\"\n            className=\"uploaded-cross-icon\"\n            onClick={() => clearData()}\n          />\n        ) : (\n          \"\"\n        )}\n        <label\n          className=\"w-100\"\n          onDrop={(e) => onDrop(e)}\n          onDragOver={(e) => dragOver(e)}\n          onDragEnter={(e) => dragEnter(e)}\n          onDragLeave={(e) => dragLeave(e)}\n        >\n          <div className=\"\">\n            {imageURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <img\n                  className=\"upload-image\"\n                  src={imageURL}\n                  alt=\"upload-image\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : videoURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <VideoComponent\n                  videoUrl={videoURL}\n                  videoStyles={videoStyles}\n                  videoWidth=\"300\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : audioSrc ? (\n              <div className=\"nft-uploaded-img-container\">\n                <AudioPlayer audioSrc={audioSrc} />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : (\n              <>\n                {\" \"}\n                <img\n                  className=\"upload-image-place-holder\"\n                  src={Images.uploadImage}\n                  alt=\"upload-image\"\n                />\n                <div className=\"upload-details text-center mt-2\">\n                  <p>Drag and drop your file</p>\n                  <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n                </div>\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={(e) => onFileChange(e, \"onChange\")}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </>\n            )}\n          </div>\n        </label>\n      </div>\n    </div>\n  );\n};\n\nexport default Upload;\n",["650","651"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],["652","653"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/aboutus/aboutus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contactus/contactus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/faqs/faqs.js",["654","655"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/imageLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/waveform/WaveForm.js",["656","657"],"import React, { Component } from \"react\";\nimport WaveSurfer from \"wavesurfer.js\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { ReactComponent as AudioIcon } from \"../../../assets/images/audio-icon.svg\";\nimport { WaveformContianer, Wave, PlayButton } from \"./Waveform.styled\";\nimport BackgroundImg from \"../../../assets/images/audio-bg.svg\";\n\nimport \"./WaveForm.css\";\n\nclass Waveform extends Component {\n  constructor(props) {\n    super(props);\n  }\n  state = {\n    playing: false,\n  };\n  componentDidMount() {\n    const track = document.querySelector(\"#track\");\n\n    this.waveform = WaveSurfer.create({\n      barWidth: 2,\n      cursorWidth: 1,\n      container: \"#waveform\",\n      backend: \"WebAudio\",\n      height: 80,\n      progressColor: \"#FFFFFF\",\n      responsive: true,\n      waveColor: \"#838383\",\n      cursorColor: \"transparent\",\n    });\n\n    this.waveform.load(track);\n  }\n\n  componentWillUnmount() {\n    this.setState({ playing: false });\n    this.waveform.playPause();\n  }\n\n  handlePlay = () => {\n    this.setState({ playing: !this.state.playing });\n    this.waveform.playPause();\n  };\n\n  render() {\n    return (\n      <WaveformContianer\n        className=\"wave-container px-4 px-xl-5\"\n        style={{\n          background: `rgba(0, 0, 0, 0.79)`,\n          display: `${!this.props.loader ? \"block\" : \"none\"}`,\n        }}\n      >\n        <PlayButton className=\"audio-btn\" onClick={this.handlePlay}>\n          {this.state.playing ? <BsFillPauseFill /> : <BsFillPlayFill />}\n        </PlayButton>\n        <div\n          className={`${\n            this.props.auction ? \"d-none\" : \"\"\n          } audio-icon-wrapper mt-5 d-flex justify-content-center`}\n        >\n          <AudioIcon />\n        </div>\n       <Wave\n          className={`${this.props.auction ? \"mt-5\" : \"\"} waves mb-3`}\n          id=\"waveform\"\n        />\n\n         <audio\n          id=\"track\"\n          onLoadStart={() => console.log(\"onload start\")}\n          oncanplay={() => {\n            this.props.onLoadCallback();\n          }}\n          onEnded={() => {\n            this.handlePlay();\n          }}\n          src={this.props.url}\n        /> \n        {\" \"}\n      </WaveformContianer>\n    );\n  }\n}\n\nexport default Waveform;\n",["658","659"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/waveform/Waveform.styled.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/collectionSubLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/privacy-policy/privacyPolicy.js",["660"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/terms-conditions/termsConditions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auction-audio/auctionAudio.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audio/audio.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/nftDetailLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/sellNFTLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/heroLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/gaTracker/gaTracket.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/listing/listing.js",["661","662","663","664","665"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.reducer.js",["666"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/exportData.js",["667"],{"ruleId":"668","severity":1,"message":"669","line":6,"column":10,"nodeType":"670","messageId":"671","endLine":6,"endColumn":20},{"ruleId":"668","severity":1,"message":"672","line":10,"column":10,"nodeType":"670","messa