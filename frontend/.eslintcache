rCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"390","usedDeprecatedRules":"184"},{"filePath":"391","messages":"392","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"393","messages":"394","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"397","usedDeprecatedRules":"184"},{"filePath":"398","messages":"399","errorCount":0,"fatalErrorCount":0,"warningCount":10,"fixableErrorCount":0,"fixableWarningCount":0,"source":"400","usedDeprecatedRules":"184"},{"filePath":"401","messages":"402","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/index.js",[],["403","404"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/App.js",["405","406","407"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\n// import 'swiper/swiper-bundle.css';\n\nconst App = React.memo((props) => {\n  // const [walletAddress, setWalletAddress] = useState(\"\");\n  let walletAddress = false;\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const history = useHistory();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  // ///set Interval\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address) {\n        toast.info(\"Please login with new address\");\n        walletAddress = address;\n        // setWalletAddress(address)\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n      // setWalletAddress(address);\n    }\n    // }\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={\n                    ENV.getUserKeys(\"_id\")._id || route.path === \"/login\"\n                      ? true\n                      : false\n                  }\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nexport default App;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/store.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/serviceWorker.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/routes.js",["408"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/privateRoute.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/config/config.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/web3.js",["409"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\n\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\n\nexport const validateNetwork = async () => {\n  let prevNetwork = await getNetworkNameByChainId();\n\n  if (prevNetwork === \"Ethereum Rinkby\") {\n    return true;\n  } else {\n    return false;\n  }\n};\nexport const getBalance = async () => {\n  let web3 = await getWeb3();\n  let address = await getWalletAddress();\n  let balance = await web3.eth.getBalance(address);\n  let ethBalance = web3.utils.fromWei(balance, \"ether\");\n\n  return ethBalance;\n};\n\nexport const mintNFt = async (metaData, id, amount, recipientValue) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, metaData)\n      .send({ from: connectedAddress, gassPrice: 5000000 });\n\n    return result;\n  } catch (err) {\n    console.log(err, \"error while minting\");\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\n\nexport const openNFTForBidding = async (\n  biddingTime,\n  startTime,\n  tokenId,\n  copies\n) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id = Number(tokenId);\n    console.log(biddingTime,startTime)\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id, copies)\n      .send({ from: connectedAddress });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"open for bid error\");\n    throw new Error(err);\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const bidAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n    // let bidAmount = Number(amount) * 1000000000000000000;\n\n    let id = Number(tokenId);\n\n    const result = await contractM.methods\n      .bid(id)\n      .send({ from: connectedAddress, value: bidAmount, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\n\nexport const putonsale = async (tokenId, amount, price) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let weiAmount = BigInt(Web3.utils.toWei(price, \"ether\"));\n\n    let id = Number(tokenId);\n    console.log(id, amount, weiAmount);\n    const result = await contractM.methods\n      .putonsale(id, amount, weiAmount)\n      .send({ from: connectedAddress, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const BuyFixedPriceNFT = async (\n  amount,\n  tokenId,\n  setConfirmed,\n  setTransactionHash\n) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n\n    const weiAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n\n    const result = await contractM.methods\n      .BuyFixedPriceNFT(tokenId)\n      .send({ from: connectedAddress, value: weiAmount, gas: 5000000 })\n      .on(\"transactionHash\", function (hash) {\n        setTransactionHash(hash);\n        setConfirmed(true);\n      })\n      .on(\"confirmation\", function (confirmationNumber, receipt) {});\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    setConfirmed(false);\n    console.log(err);\n\n    throw new Error(err);\n  }\n};\nexport const setApprovalForAll = async (setApprovalStatus) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const result = await contractM.methods\n      .setApprovalForAll(ENV.mintsClubContractAddress, true)\n      .send({\n        from: connectedAddress,\n      })\n      .on(\"transactionHash\", function (hash) {\n        // setTransactionHash(hash);\n        setApprovalStatus(\"in-progress\");\n      });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const endAuction=async (tokenId)=>{\n\n  try{\n    let connectedAddress=await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.auctionEnd(tokenId)\n    .send({\n      from: connectedAddress,\n      gassPrice: 5000000\n    })\n    if (result) {\n      console.log(result,\"result\")\n      return result;\n    }\n  }catch(err){\n    console.log(err,\"error\")\n    throw new Error(err);\n  }\n\n}\n\nexport const getMetamaskConnectedAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        // toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      // toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const mint = async () => {\n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n  } catch (e) {}\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = () => {};\n\nexport const createNft = async () => {};\n\nexport const setNftToken = (body) => {\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n  alert(\"calling\");\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        window.location.href = \"/explore-all\";\n      } else {\n      }\n    })\n    .catch((error) => {\n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {};\n\nexport const placeBidNft = async () => {};\n\nexport const SellOnFixedPrice = async () => {};\n\nexport const BuyFixedPriceNFTs = async () => {};\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async () => {};\nexport const signTransaction = async () => {};\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/index.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/full-page-loader/full-page-loader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.js",["410","411","412","413"],"import React, { useEffect } from \"react\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller\";\nimport { connect } from \"react-redux\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n      <Hero />\n\n      <Auctions />\n\n      <TopSeller viewAll={\"View All\"} />\n\n      <PopularCollections />\n\n      <Buysell />\n      <OwnCollectionToday />\n    </>\n  );\n}\n\nexport default Home;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/popular-collections-list/popular-collections-list.js",["414","415","416","417","418","419","420","421"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collection-details/collectiondetails.js",["422","423","424","425","426","427","428","429"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation, useHistory } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./collectiondetails.css\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport VideoCard from \"../test-video-card/videoCard\";\nimport BannerPh from \"../../assets/images/collection-detailBg.png\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nconst CollectionDetailsPage = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [keyword, setKeyword] = useState(\"\");\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n  });\n  const location = useLocation();\n  const history = useHistory();\n\n  // const itemoptions = [\n  //   { value: \"single\", label: \"Single\" },\n  //   { value: \"double\", label: \"Double\" },\n  // ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    chains: {\n      label: \"Chains\",\n      option: [\"Ethereum\"],\n    },\n  };\n\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      if (props.nfts.length > 0) {\n        setDisabled(false);\n      } else {\n        if (initial) {\n          setDisabled(true);\n        }\n      }\n      setNfts(props.nfts);\n\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 40,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter,\n    keyword,\n    buy,\n    auction,\n    latest\n  ) => {\n    setFilterationLoader(true);\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    nftQS.collectionId = location.state._id;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    if (keyword) nftQS.keyword = keyword;\n    if (buy) nftQS.buy = buy;\n    if (auction) nftQS.auction = auction;\n    if (latest) nftQS.latest = latest;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getNFTs(qs);\n  };\n\n  const handleSortOptions = (e) => {\n    setInitial(false);\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    setInitial(false);\n    setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      filter.gtePrice,\n      filter.ltePrice,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false);\n    if (id === \"Buy Now\") {\n      setFilter((prev) => ({ ...prev, buy: true, auction: false, new: false }));\n    } else if (id === \"On Auction\") {\n      setFilter((prev) => ({ ...prev, auction: true, buy: false, new: false }));\n    } else {\n      setFilter((prev) => ({ ...prev, new: true, buy: false, auction: false }));\n    }\n    \n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      id == \"Buy Now\" ? true : false,\n      id == \"On Auction\" ? true : false,\n      id == \"New\" ? true : false\n    );\n  };\n\n  const handleSearchKeyword = () => {\n    setInitial(false);\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n  ///////////Likes\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const { name, logo, description, username } = location.state;\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n\n      <NavbarMain />\n      <Breadcrumb\n        title1={\"Collections\"}\n        title2={\"CollectionDetail\"}\n        title1Handler={() => history.push(\"/explore/exploreAll\")}\n      />\n      <div className=\"collection-detail-hero w-100\">\n        <img className=\"w-100\" src={BannerPh} alt=\"BannerImg\" />\n      </div>\n      <div className=\"collection-detail-content\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              <div className=\"collection-owner-avatar\">\n                <img src={logo} alt=\"owner-avatar\" />\n              </div>\n              <div className=\"d-md-flex align-items-center justify-content-between mt-5\">\n                <div className=\"collection-owner-detail\">\n                  <div className=\"collection-owner-name d-flex align-items-center\">\n                    <h3>\n                      {name}{\" \"}\n                      <img src={TickIcon} alt=\"tick-icon\" className=\"ms-2\" />\n                    </h3>\n                  </div>\n                  {username && username?.[0] && (\n                    <p>\n                      Created by <span>{username?.[0]}</span>\n                    </p>\n                  )}\n                </div>\n                <div className=\" d-block d-md-none\">\n                  <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                    <p>{description}</p>\n                  </div>\n                </div>\n                {/* <div className=\"collection-owner-btns mt-3 mt-md-0 ms-auto\">\n                      <button className=\"me-1 me-sm-2 me-lg-3\">\n                        <img src={FlagIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button className=\"me-1 me-sm-1 me-lg-3\">\n                        <img src={ShareIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button>+ Add to wishlist</button>\n                    </div> */}\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-7 col-md-6 col-lg-5 d-none d-md-block\">\n              <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                <p>{description}</p>\n              </div>\n            </div>\n            {/* <div className=\"col-12 col-lg-7 mt-3 mt-sm-5\">\n                  <div className=\"d-flex align-items-center justify-content-center justify-content-lg-end\">\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>items</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Owner</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Prize floor</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Volume trade</p>\n                    </div>\n                  </div>\n                </div> */}\n          </div>\n          <div className=\"collections-listing padding-wrapper\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img\n                    src={SearchIcon}\n                    alt=\"search-icon\"\n                    className=\"ms-3\"\n                    onClick={() => {\n                      if (keyword === \"\") {\n                        return false;\n                      } else {\n                        handleSearchKeyword();\n                      }\n                    }}\n                  />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                    maxLength=\"50\"\n                    onChange={(e) => {\n                      if (e.target.value.trimStart() === \"\") {\n                    \n                        return false;\n                      }else if(e.target.value===''){\n                        handleSearchKeyword(false)\n                        setKeyword(e.target.value);\n                      } else {\n                        setKeyword(e.target.value);\n                      }\n                    }}\n                    onKeyPress={(e) => {\n                      if (keyword === \"\") {\n                        return false;\n                      } else {\n                        e.key === \"Enter\" && handleSearchKeyword();\n                      }\n                    }}\n                  />\n                </div>\n              </div>\n              {/* <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option\n                            key={index}\n                            value={collection.label}\n                            disabled={disabled}\n                          >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div> */}\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {sortoptions &&\n                      sortoptions.map((collection, index) => {\n                        return (\n                          <option\n                            key={index}\n                            value={collection.label}\n                            disabled={disabled}\n                          >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                      onChangeMinPrice={onChangeMinPrice}\n                      onChangeMaxPrice={onChangeMaxPrice}\n                      minValue={minValue}\n                      maxValue={maxValue}\n                      applyMinMaxFilter={applyMinMaxFilter}\n                      handleStatusFilter={handleStatusFilter}\n                      disabled={disabled}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row mt-5\">\n            <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n              <FilterComponent\n                Status={filterData.status}\n                Chains={filterData.chains}\n                onChangeMinPrice={onChangeMinPrice}\n                onChangeMaxPrice={onChangeMaxPrice}\n                minValue={minValue}\n                maxValue={maxValue}\n                applyMinMaxFilter={applyMinMaxFilter}\n                handleStatusFilter={handleStatusFilter}\n                disabled={disabled}\n              />\n            </div>\n            <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n              <div className=\"row g-3\">\n                {filterationLoader ? (\n                  <div className=\"text-center\">\n                    <div\n                      className=\"spinner-border text-secondary text-white \"\n                      role=\"status\"\n                    >\n                      <span className=\"sr-only\">Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((listing, index) => {\n                    return (\n                      <div className=\"col-6 col-md-4 col-lg-3 px-1\" key={index}>\n                        {listing.fileType === \"image\" ? (\n                          <ListingCards\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            sellingMethod={listing.sellingMethod}\n                            fileType={listing.fileType}\n                            ownerName={listing.owner.username}\n                            copies={listing.copies}\n                            remainingCopies={listing.remainingCopies}\n                          />\n                        ) : (\n                          <VideoCard\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            fileType={listing.fileType}\n                            sellingMethod={listing.sellingMethod}\n                            ownerName={listing.owner.username}\n                            copies={listing.copies}\n                            remainingCopies={listing.remainingCopies}\n                          />\n                        )}\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-white mt-5 text-center no-nfts-title\">\n                    No NFT's Found\n                  </p>\n                )}\n              </div>\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {nfts && props.pagination > nfts.length && nfts.length > 10 && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftsData.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n})(CollectionDetailsPage);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/explore-collections.js",["430","431","432","433"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/not-found/not-found.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user-profile/UserProfile.js",["434","435","436","437","438","439","440","441","442","443"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user-profile/user-edit-profile.js",["444","445","446","447","448","449","450","451","452","453","454","455","456","457","458","459","460","461","462","463","464"],"import React, { useEffect, useState } from \"react\";\n\nimport \"./user-edit-profile.css\";\n\n/////////\n\nimport { connect } from \"react-redux\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { ENV } from \"./../../config/config\";\nimport { Images } from \"../../assets/assets\";\nimport { useHistory } from \"react-router-dom\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\n\nconst EditProfile = (props) => {\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [copy, setCopy] = useState(false);\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const [bioError, setBioError] = useState(false);\n  const [userProfile, setUserProfile] = useState({});\n  const [user, setUser] = useState(null);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n  useEffect(() => {\n    if (props.error !== null) {\n      setLoader(false);\n      toast.error(props.error.messasge);\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      setUser(props.user.individualUser);\n      props.beforeUser();\n      setLoader(false);\n\n      setConnectedAddress(address ? address : \"\");\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      setBannerUrl(bannerImage ? bannerImage : \"\");\n      setImage(profileImage ? profileImage : \"\");\n      setBannerImage(bannerImage ? bannerImage : \"\");\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      setLoader(false);\n      props.beforeUser();\n      toast.success(\"Profile Updated SuccessFully\")\n      history.push('/userprofile')\n    }\n  }, [props.user.userAuth]);\n\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n        return toast.error(\"Invalid File\")\n      }\n      setImageUrl(fileURL);\n      setImage(file);\n    }\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n  \n    if (description && description.length < 3) {\n      setBioError(true);\n      return \"\";\n    } else {\n      setBioError(false);\n    }\n    setErrors(\"\");\n    setLoader(true);\n        // let signature = await signRequest();\n        setLoader(true);\n\n        var formData = new FormData();\n        formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n        if (image) {\n          formData.append(\"profileImage\", image);\n        }\n        if (banner) {\n          formData.append(\"bannerImage\", banner);\n        }\n\n        formData.append(\"bio\", description);\n        formData.append(\"twitterLink\", twitterLink);\n        formData.append(\"username\", username);\n        formData.append(\"email\", email);\n        formData.append(\"webLink\", webLink);\n        formData.append(\"instaLink\", instaLink);\n\n        // return ''\n        props.updateProfile(formData);\n   \n  };\n  const bannerData = {\n    subHeading: \"Information\",\n    heading: \"User Profile\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile padding-wrapper pt-0\">\n\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n          />\n          {loader && <FullPageLoader />}\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n              <form onSubmit={submit}>\n            <div className=\"row\">\n              <div className=\"col-12 mt-5\">\n                <div className=\"logo-wrapper\">\n                  <div className=\"logo-image\">\n                    {image && image ? (\n                      <img className=\"uploaded-logo-img\" src={imageUrl ? imageUrl : Images.EditAvatar} />\n                    ) : (\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <span className=\"logo-img-round\">\n                          <img className=\"upload-icon\" src={imageUrl} />\n                        </span>\n                      </label>\n                    )}\n                  </div>\n\n                  <div className=\"upload-feature-icon-logo\">\n                    <label>\n                      <input\n                        id=\"logo\"\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => onFileChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"logo\"\n                      />\n                      <img src={Images.editIconSmall} />\n                    </label>\n                  </div>\n                  <p className=\"feature-img-title mt-3 mx-2\">Profile Image:</p>\n                </div>\n              </div>\n              <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                <label className=\"create-collection-label\">Username:*</label>\n                <input\n                  className=\"create-collection-input mt-2\"\n                  id=\"name\"\n                  type=\"text\"\n                  name=\"name\"\n                  required\n                  onChange={(e) => {\n                    if (e.target.value.trim() === \"\" && username === \"\") {\n                      return false;\n                    } else {\n                      setUsername(e.target.value);\n                    }\n                  }}\n                  value={username}\n                  placeholder=\"Username\"\n                  maxLength=\"55\"\n                  minLength=\"3\"\n                  autoComplete=\"off\"\n                />\n              </div>\n\n              <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                <label className=\"create-collection-label\">\n                  Email Address:*\n                </label>\n\n                <input\n                  className=\"create-collection-input mt-2\"\n                  id=\"url\"\n                  type=\"text\"\n                  name=\"url\"\n                  placeholder=\"Email Address\"\n                  required\n                  onChange={(e) => {\n                    if (e.target.value.trim() === \"\" && email === \"\") {\n                      return \"\";\n                    } else {\n                      setEmail(e.target.value);\n                    }\n                  }}\n                  value={email}\n                  maxLength=\"55\"\n                  autoComplete=\"off\"\n                />\n              </div>\n\n              <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                <label className=\"create-collection-label\">\n                  Wallet Address:\n                </label>\n\n                <input\n                  className=\"create-collection-input mt-2\"\n                  id=\"url\"\n                  type=\"text\"\n                  name=\"url\"\n                  placeholder=\"URL\"\n                  required\n                  readOnly={true}\n                  autoComplete=\"off\"\n                  value={address}\n                />\n              </div>\n\n              <div className=\"col-12 mt-3 mt-lg-5\">\n                <label className=\"create-collection-label\">BioData:*</label>\n\n                <textarea\n                  className=\"create-collection-area mt-2\"\n                  name=\"description\"\n                  placeholder=\"Enter BioData\"\n                  maxLength=\"500\"\n                  minLength=\"3\"\n                  onChange={(e) => {\n                    if (\n                      e.target.value.trim() === \"\" &&\n                      description === \"\"\n                    ) {\n                      return false;\n                    } else {\n                      setDescription(e.target.value);\n                    }\n                  }}\n                  value={description}\n                ></textarea>\n              </div>\n\n              <div className=\"col-lg-4 col-md-6 col-sm-12 mt-3 mt-lg-5\">\n                <label className=\"create-collection-label\">Twitter Link:</label>\n                <input\n                  className=\"create-collection-input mt-2\"\n                  id=\"name\"\n                  type=\"text\"\n                  name=\"name\"\n                  onChange={(e) => {\n                    if (\n                      e.target.value.trim() === \"\" &&\n                      twitterLink === \"\"\n                    ) {\n                      return false;\n                    } else {\n                      setTwitterLink(e.target.value);\n                    }\n                  }}\n                  value={twitterLink}\n                  placeholder=\"Name\"\n                  maxLength=\"55\"\n                  autoComplete=\"off\"\n                />\n              </div>\n\n              <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0  mt-3 mt-lg-5\">\n                <label className=\"create-collection-label\">\n                  Instagram Link:\n                </label>\n\n                <input\n                  className=\"create-collection-input mt-2\"\n                  id=\"url\"\n                  type=\"text\"\n                  name=\"url\"\n                  placeholder=\"URL\"\n                  onChange={(e) => {\n                    if (\n                      e.target.value.trim() === \"\" &&\n                      instaLink === \"\"\n                    ) {\n                      return false;\n                    } else {\n                      setInstaLink(e.target.value);\n                    }\n                  }}\n                  value={instaLink}\n                  maxLength=\"55\"\n                  autoComplete=\"off\"\n                />\n              </div>\n\n              <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0  mt-3 mt-lg-5 \">\n                <label className=\"create-collection-label\">Website Link:</label>\n                <input\n                  className=\"create-collection-input mt-2\"\n                  id=\"url\"\n                  type=\"text\"\n                  name=\"url\"\n                  placeholder=\"URL\"\n                  onChange={(e) => {\n                    if (\n                      e.target.value.trim() === \"\" &&\n                      webLink === \"\"\n                    ) {\n                      return false;\n                    } else {\n                      setWebLink(e.target.value);\n                    }\n                  }}\n                  value={webLink}\n                  maxLength=\"55\"\n                  autoComplete=\"off\"\n                />\n              </div>\n              <div className=\"create-collection-btn-container\">\n                <button\n                  className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                  type=\"submit\"\n                >\n                  Save Changes\n                </button>\n              </div>\n            </div>\n              </form>\n          </div>\n        </div>\n      </section>\n      {/* {loader && <FullPageLoader />}\n      <NavbarMain />\n      <Breadcrumb title1={\"Profile\"} title2={\"EditProfile\"} />\n      <section className=\"edit-profile padding-wrapper\">\n        <form onSubmit={submit}>\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Set Up Your Profile</span>\n                    <h3 className=\"mb-0\">Profile Setting</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                <div className=\"edit-inp-subheading\">\n                  <h6>Profile Image</h6>\n                </div>\n                <div className=\"edit-avatar pt-4\">\n                  <img\n                    src={imageUrl ? imageUrl : editImages.EditAvatar}\n                    alt=\"editavatar\"\n                  />\n\n                  <label>\n                    <div className=\"avatar-btn-pen\">\n                      <ProfileEditSVG />\n                    </div>\n                    <input\n                      type=\"file\"\n                      accept=\".png,.jpeg,.jpg\"\n                      onChange={(e) => onFileChange(e)}\n                      style={{ display: \"none\" }}\n                      name=\"image\"\n                    />\n                  </label>\n                </div>\n                <div className=\"edit-banner-container\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Profile Banner</h6>\n                  </div>\n                  <div className=\"edit-banner pt-4\">\n                    <img\n                      src={bannerUrl ? bannerUrl : editImages.EditBanner}\n                      alt=\"editavatar\"\n                    />\n                    <label>\n                      <div className=\"banner-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => onBannerChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"banner\"\n                      />\n                    </label>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                <div className=\"row g-4\">\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Username</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"username\"\n                        type=\"text\"\n                        placeholder=\"User Name\"\n                        maxLength=\"50\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        onChange={(e) => {\n                          if (e.target.value.trim() === \"\" && username === \"\") {\n                            return false;\n                          } else {\n                            console.log(\"else\");\n                            setUsername(e.target.value);\n                          }\n                        }}\n                        required={true}\n                        value={username}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"username\", username, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Email Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"email\"\n                        type=\"email\"\n                        placeholder=\"Email Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        onChange={(e) => {\n                          if (e.target.value.trim() === \"\" && email === \"\") {\n                            return \"\";\n                          } else {\n                            setEmail(e.target.value);\n                          }\n                        }}\n                        value={email}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"email\", email, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Wallet Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"address\"\n                        placeholder=\"Wallet Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        value={address}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"address\", address, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-8\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Bio</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      {bioError && (\n                        <p className=\"text-danger \">Minimum 3 words required</p>\n                      )}\n                      <textarea\n                        name=\"bio\"\n                        placeholder=\"Bio\"\n                        maxLength=\"500\"\n                        onChange={(e) => {\n                          if (\n                            e.target.value.trim() === \"\" &&\n                            description === \"\"\n                          ) {\n                            return false;\n                          } else {\n                            console.log(\"else\");\n                            setDescription(e.target.value);\n                          }\n                        }}\n                        value={description}\n                      ></textarea>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Links</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Twitter}\n                          alt=\"twitterlink\"\n                        />\n                        <input\n                          name=\"twitterlink\"\n                          placeholder=\"Twitter Link\"\n                          autocomplete=\"off\"\n                          type=\"url\"\n                          onChange={(e) => {\n                            if (\n                              e.target.value.trim() === \"\" &&\n                              twitterLink === \"\"\n                            ) {\n                              return false;\n                            } else {\n                              console.log(\"else\");\n                              setTwitterLink(e.target.value);\n                            }\n                          }}\n                          value={twitterLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Insta}\n                          alt=\"instalink\"\n                        />\n                        <input\n                          name=\"instagramlink\"\n                          placeholder=\"Instagram Link\"\n                          type=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => {\n                            if (\n                              e.target.value.trim() === \"\" &&\n                              instaLink === \"\"\n                            ) {\n                              return false;\n                            } else {\n                              setInstaLink(e.target.value);\n                            }\n                          }}\n                          value={instaLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Website}\n                          alt=\"websitelink\"\n                        />\n                        <input\n                          name=\"websitelink\"\n                          placeholder=\"Website Link\"\n                          ype=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => {\n                            if (\n                              e.target.value.trim() === \"\" &&\n                              webLink === \"\"\n                            ) {\n                              return false;\n                            } else {\n                              setWebLink(e.target.value);\n                            }\n                          }}\n                          value={webLink}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                <div className=\"\">\n                  <button className=\"btn btn-linear-gradient\">\n                    Save changes\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </form>\n      </section>\n      <Footer /> */}\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n  emptyError,\n})(EditProfile);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/top-seller/topsellerlist.js",["465","466","467"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card top-seller-card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/creat-collections/CreateCollections.js",["468","469","470","471","472","473","474","475","476","477"],"import React, { Component } from \"react\";\nimport Footer from \"../footer/footer\";\nimport \"./CreateCollections.css\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport Select from \"react-select\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        logoUrl: \"\",\n        bannerUrl: \"\",\n        featuredImgUrl: \"\",\n        description: \"\",\n      },\n      categories: null,\n      selectedCategory: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate(prevProps) {\n    if (this.props.error !== null && prevProps.error === null) {\n      toast.error(this.props.error.message);\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      let updatedCategories = [];\n      for (var item of categories) {\n        let obj = {\n          value: item._id,\n          label: item.name,\n        };\n        updatedCategories.push(obj);\n      }\n      this.setState({ categories: updatedCategories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  handleSelectChange = (selectedOption) => {\n    console.log(selectedOption, \"selected \");\n    let { collection } = this.state;\n    collection = { ...collection, categoryId: selectedOption.value };\n    this.setState({\n      selectedOption,\n      collection,\n    });\n  };\n  handleValidation = () => {\n    console.log(\"func\");\n    const { categoryId, logo, name, description, featuredImg } =\n      this.state.collection;\n    console.log(this.state.collection, \"collection\");\n    if (\n      description === \"\" ||\n      logo === \"\" ||\n      categoryId === \"\" ||\n      name === \"\" ||\n      featuredImg === \"\"\n    ) {\n      return true;\n    } else {\n      return false;\n    }\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: \"\", featuredImgUrl: \"\" };\n    this.setState({ collection });\n  };\n\n  render() {\n    const {\n      collection,\n      errors,\n      loader,\n      isSubmitted,\n      categories,\n      selectedOption,\n    } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      const bannerData = {\n        subHeading: \"Create New\",\n        heading: \"Create New Collection\",\n        content:\n          \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n      };\n      return (\n        <>\n          {loader && <FullPageLoader />}\n          <section className=\"create-collection\">\n            <Banner\n              subHeading={bannerData.subHeading}\n              heading={bannerData.heading}\n              content={bannerData.content}\n              bgImg={BannerBg}\n              bannerImg={BannerImage}\n            />\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"upload-container flex-md-row flex-column align-items-center align-items-md-end ps-md-5 ps-0\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {collection && collection.logo ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={collection.logoUrl}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => this.onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => this.onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">Logo Image*</p>\n                  </div>\n                  <div className=\"feature-wrapper pt-md-0 pt-5\">\n                    <div className=\"feature-image\">\n                      <span className=\"feature-img-round\">\n                        {collection && collection.featuredImg ? (\n                          <img\n                            className=\"uploaded-feature-img\"\n                            src={collection.featuredImgUrl}\n                          />\n                        ) : (\n                          <label className=\"upload-icon\">\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                            <img src={Images.featureImageInputBG} />\n                            <div className=\"feature-img-round-info\">\n                              <p className=\"text-center mb-2 browse-file\">\n                                Browse Files\n                              </p>\n                              {/* <p className=\"mb-0\">PNG, GIF, WEBP, MP4, MP3 </p> */}\n                              <p className=\"text-center mb-0\">Max 100mb</p>\n                            </div>\n                          </label>\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-feature-icon\">\n                      <label>\n                        <input\n                          id=\"featuredImg\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          style={{ display: \"none\" }}\n                          name=\"featuredImg\"\n                          onChange={(e) => this.onFileChange(e)}\n                        />\n                        <img src={Images.editIconLarge} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2 text-center text-md-start\">\n                      Feature Image*\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Name:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.name}\n                    placeholder=\"Name\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">URL:</label>\n                  <span className=\"text-danger position-absolute top-0\">\n                    {this.validator.message(\"url\", collection.url, \"url\")}\n                  </span>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"URL\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.url}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Select Category:*\n                  </label>\n\n                  <Select\n                    className=\"react-select-cls\"\n                    classNamePrefix=\"react-select\"\n                    value={selectedOption}\n                    isSearchable={false}\n                    onChange={this.handleSelectChange}\n                    options={categories}\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Description:*\n                  </label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Description\"\n                    maxLength=\"500\"\n                    rows=\"3\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.description}\n                  ></textarea>\n                </div>\n\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    disabled={this.handleValidation()}\n                    onClick={(e) => this.submit(e)}\n                  >\n                    Create Collection\n                  </button>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n\n          {/* <section className=\"edit-profile padding-wrapper create-collection-container\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Create Now</span>\n                      <h3 className=\"mb-0\">Create New Collection</h3>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Logo Image*</h6>\n                    <span className=\"text-danger\">\n                      {this.validator.message(\n                        \"logo\",\n                        collection.logo,\n                        \"required\"\n                      )}\n                    </span>\n                  </div>\n                  <div className=\"collection-logo-container pt-2\">\n                    {collection && collection.logo ? (\n                      <img\n                        src={collection.logoUrl}\n                        className=\"colection-avatar-img\"\n                      />\n                    ) : (\n                      <div className=\"colection-avatar\"></div>\n                    )}\n                    <label>\n                      <div className=\"avatar-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        id=\"logo\"\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => this.onFileChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"logo\"\n                      />\n                    </label>\n                  </div>\n                  <div className=\"\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Featured Image*</h6>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"logo\",\n                          collection.featuredImg,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-featured-container\">\n                      {collection && collection.featuredImg ? (\n                        <div className=\"uploaded-featured-container\">\n                          <img\n                            src={collection.featuredImgUrl}\n                            className=\"uploaded-featured-img\"\n                          />\n                          <div className=\"uploaded-featured-hover w-100\">\n                            <div className=\"uploaded-featured-cross\">\n                              <MdClose\n                                color=\"#e33d0bc2\"\n                                className=\"uploaded-cross-icon\"\n                                onClick={() => this.clearData()}\n                              />\n                            </div>\n                            <label>\n                              <div className=\"text-center\">\n                                <img src={UploadIcon} alt=\"upload-icon\" />\n                              </div>\n                              <input\n                                id=\"featuredImg\"\n                                type=\"file\"\n                                accept=\".png,.jpeg,.jpg\"\n                                style={{ display: \"none\" }}\n                                name=\"featuredImg\"\n                                onChange={(e) => this.onFileChange(e)}\n                              />\n                            </label>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className=\"upload-featured-img\">\n                          <label>\n                            <div className=\"text-center\">\n                              <img\n                                src={CollectionUploadIcon}\n                                alt=\"upload-icon\"\n                              />\n                            </div>\n                            <div className=\"upload-featured-img-content pt-2\">\n                              <h6 className=\"pb-1\">Browse Files</h6>\n                              <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                            </div>\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                          </label>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Name*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"name\",\n                            collection.name,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"name\"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.name}\n                          placeholder=\"Name\"\n                          maxLength=\"55\"\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>URL</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\"url\", collection.url, \"url\")}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"url\"\n                          type=\"text\"\n                          name=\"url\"\n                          placeholder=\"URL\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.url}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Select Category*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"category\",\n                            collection.categoryId,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <select\n                          id=\"category\"\n                          name=\"categoryId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Select Collection\n                          </option>\n                          {categories &&\n                            categories.map((category, index) => {\n                              return (\n                                <option key={index} value={category._id}>\n                                  {category.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                      </div>\n                    </div>\n                    <div className=\"col-md-8\">\n                      <div className=\"edit-inp-subheading pt-4\">\n                        <h6>Discription</h6>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <textarea\n                          name=\"description\"\n                          placeholder=\"Discription\"\n                          maxLength=\"500\"\n                          rows=\"3\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.description}\n                          \n                        ></textarea>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                  <div className=\"\">\n                    <button\n                      type=\"button\"\n                      className=\"btn btn-linear-gradient\"\n                      onClick={(e) => this.submit(e)}\n                    >\n                      Create Collection\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section> */}\n          {/* <Footer /> */}\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nft-detail/nftdetail.js",["478","479","480","481","482","483","484","485","486","487","488","489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504","505","506","507","508","509","510","511","512","513","514","515","516","517","518","519","520","521","522","523","524","525","526","527","528"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/home-auction-list.js",["529","530","531","532","533","534","535"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/sell-nft/SellNFT.js",["536","537","538","539","540","541","542","543","544","545","546","547","548","549","550","551"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./SellNFT.css\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport PriceIcon from \"../../assets/images/priceIcon.svg\";\nimport FeeIcon from \"../../assets/images/feeIcon.svg\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport \"bootstrap-daterangepicker/daterangepicker.css\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  getMyLikedNfts,\n  createActivity,\n} from \"../nfts/nfts.action\";\nimport {\n  openNFTForBidding,\n  putonsale,\n  getWalletAddress,\n  setApprovalForAll,\n  validateNetwork,\n  getMetamaskConnectedAddress\n} from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport axios from \"axios\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { updateProfile } from \"../user/user.action\";\nimport ApprovalModal from \"../modals/ApprovalModal\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nconst { dateRangeInitialSettings } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\n\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n};\n\nconst SellNFT = (props) => {\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [loader, setLoader] = useState(true); // NFT loader\n  const location = useLocation();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [likedNfts, setLikedNfts] = useState();\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const [copies, setCopies] = useState(\"\");\n  const [show, setShow] = useState(false);\n  const [approvalStatus, setApprovalStatus] = useState(\"not-approved\");\n  const [address,setAddress]=useState('');\n  let nftId = props.match.params.id;\n\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n  \n  useEffect(async() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n      let connectedAddress=await getMetamaskConnectedAddress();\n      setAddress(connectedAddress)\n  }, []);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getNFT(nftId);\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n  \n  }, []);\n\n  useEffect(() => {\n    if (props.error !== null) {\n      toast.error(props.error.message);\n      setLoader(false)\n      props.emptyError()\n    }\n  }, [props.error]);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNftDetail(props.nftDetail)\n      setLoader(false);\n      validateIfLiked(likedNfts, props.nftDetail);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const { nft } = props.nft.nftsData;\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) {\n      data = fixedPriceConfig;\n    } else {\n      data = timedAuctionConfig;\n    }\n\n    const keys = name.split(\".\");\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) {\n      setFixedPriceConfig({ ...data });\n    } else {\n      setTimedAuctionConfig({ ...data });\n    }\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    if (copies > nftDetail.copies) {\n      if (Number(nftDetail.copies) === 1) {\n        toast.info(`Copies should be equal to ${nftDetail.copies}`);\n      } else {\n        toast.info(\n          `Copies should be less than or equal to ${nftDetail.copies}`\n        );\n      }\n      return \"\";\n    }\n    if (await validateNetwork()) {\n      if (!nftDetail.user.isApproved) {\n        setShow(true);\n        return ''\n      }\n\n      let price = \"\";\n      let payload = \"\";\n\n      let timedConfig = { ...timedAuctionConfig };\n\n      let fixedConfig = { ...fixedPriceConfig };\n      const { _id, ownerId } = nftDetail;\n\n      let activityPayload = {\n        nftId: _id,\n        ownerId,\n        fromAddress: await getWalletAddress(),\n        activityType: \"List\",\n      };\n\n      if (sellingMethod === 2) {\n        if (Number(timedConfig.startPrice.amount) === 0) {\n          toast.error(\"Price should be greater then 0\");\n          return \"\";\n        }\n        let timedAuctionStartTime = new Date(timedConfig.duration.startDate);\n        let timedAuctionEndTime = new Date(timedConfig.duration.endDate);\n\n        //calculate end time\n        timedAuctionEndTime = timedAuctionEndTime.toString();\n        timedAuctionEndTime =\n          timedAuctionEndTime.slice(0, 15) +\n          \" \" +\n          timedConfig.duration.endTime +\n          \":00\" +\n          timedAuctionEndTime.slice(24);\n        timedConfig.duration.endDate = timedAuctionEndTime;\n\n        //calculate start time\n        timedAuctionStartTime = timedAuctionStartTime.toString();\n        timedAuctionStartTime =\n          timedAuctionStartTime.slice(0, 15) +\n          \" \" +\n          timedConfig.duration.startTime +\n          \":00\" +\n          timedAuctionStartTime.slice(24);\n        timedConfig.duration.startDate = timedAuctionStartTime;\n\n       //Deleting unused data from payload\n        let auctionConfig = timedConfig;\n        delete auctionConfig.duration.startTime;\n        delete auctionConfig.duration.endTime;\n        delete auctionConfig.method;\n        price = Number(auctionConfig.startPrice.amount);\n        auctionConfig.startPrice.amount = Number(\n          auctionConfig.startPrice.amount\n        );\n\n        payload = {\n          _id: location.state._id,\n          sellingMethod,\n          sellingConfig: JSON.stringify(auctionConfig),\n          copiesForAuction: copies,\n        };\n      } else {\n     \n        price = Number(fixedConfig.price.amount);\n        if (price === 0) {\n          toast.error(\"Price should be greater then 0\");\n          return \"\";\n        }\n        payload = {\n          _id: location.state._id,\n          sellingMethod,\n          sellingConfig: JSON.stringify(fixedConfig),\n          copiesForAuction: copies,\n        };\n      }\n\n      setLoader(true);\n\n      var formData = new FormData();\n      for (const key in payload) formData.append(key, payload[key]);\n      if (sellingMethod === 2) {\n        try {\n          let auctionEndDate = timedAuctionConfig.duration.endDate;\n          let auctionStartDate = timedAuctionConfig.duration.startDate;\n\n          const biddingTime = new Date(auctionEndDate).getTime();\n          const startTime = new Date(auctionStartDate).getTime();\n\n          let result = await openNFTForBidding(\n            biddingTime,\n            startTime,\n            location.state.nftToken,\n            copies\n          );\n          if (result) {\n            activityPayload.price = price;\n\n            props.createActivity(activityPayload);\n            props.upsertNFT(\"edit\", formData, \"PUT\");\n          }\n        } catch (err) {\n          setLoader(false);\n          toast.error(err);\n        }\n      } else {\n        try {\n          let result = await putonsale(\n            nftDetail.nftToken,\n            1,\n            fixedConfig.price.amount\n          );\n\n          if (result) {\n            activityPayload.price = price;\n\n            props.createActivity(activityPayload);\n            props.upsertNFT(\"edit\", formData, \"PUT\");\n          }\n        } catch (err) {\n          setLoader(false);\n          toast.error(err);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const handleLikesTogleApi = (nftId, status) => {\n    if (!likeButtonDisable) {\n      setLikeBtnDisable(true);\n      setToggle(!toggle);\n\n      let userId = ENV.getUserKeys(\"_id\")._id;\n\n      let data = {\n        userId,\n        nftId,\n        count: 1,\n      };\n\n      if ((status === \"dislike\") & (nftDetail.likesCount > 0)) {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount - 1;\n\n        setNftDetail(nft);\n        props.toggleLikeDislike(data);\n      } else {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount + 1;\n\n        setNftDetail(nft);\n\n        props.toggleLikeDislike(data);\n      }\n    }\n  };\n\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      setLoader(false);\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      setLoader(false);\n      return setToggle(false);\n    }\n  };\n  const auctionEndTimeConversion = (auctionEndDate) => {\n    var dateString = moment.utc(auctionEndDate).format(\"MMMM D, Y\");\n    var timeString = moment.utc(auctionEndDate).format(\"h:mma\");\n    var totalDateTime = dateString + \" at \" + timeString + \" PKT\";\n    return totalDateTime;\n  };\n  const approveAccount = async () => {\n    setApprovalStatus(\"pending\");\n    var formData = new FormData();\n    formData.append(\"isApproved\", true);\n    formData.append(\"userId\", nftDetail.user._id);\n    try {\n  \n      let accApproved = await setApprovalForAll(setApprovalStatus);\n      if (accApproved) {\n        let updatedNFTDetail = { ...nftDetail };\n        updatedNFTDetail.user.isApproved = true;\n        setNftDetail(updatedNFTDetail);\n        props.updateProfile(formData);\n        setApprovalStatus(\"approved\");\n        toast.success(\"Your Account is Approved!.\");\n        return \"\";\n      }\n    } catch (err) {\n      setApprovalStatus(\"not-approved\");\n      return \"\";\n    }\n  };\n\n\n  const { image, currentPrice, likesCount, auctionEndDate,name,_id ,ownerId,user,fileType} = nftDetail;\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n      <NavbarMain />\n      <section className=\"padding-wrapper nft-detail\">\n        <form onSubmit={submit}>\n          <div className=\"container\">\n            <div className=\"row g-3\">\n              <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n                <div className=\"row\">\n                  <div className=\"col-12 order-2 order-md-1\">\n                    <div className=\"intro mb-5\">\n                      <div className=\"intro-content\">\n                        <span>SellNFTs</span>\n                        <h3 className=\"mb-0\">List of bundles for sale</h3>\n                      </div>\n                    </div>\n                    <div className=\"sale-btn-container mt-5 mb-4\">\n                      <button\n                        className={` ${\n                          activeBtn === 0\n                            ? \"sell-btn-active\"\n                            : \"sell-btn-not-active\"\n                        }  me-3 `}\n                        onClick={() => {\n                          setActiveBtn(0);\n                          setSellingMethod(1);\n                          setCopies(\"\");\n                        }}\n                      >\n                        <svg\n                          xmlns=\"http://www.w3.org/2000/svg\"\n                          width=\"7\"\n                          height=\"14\"\n                          className=\"me-1 me-sm-2\"\n                        >\n                          <path\n                            fill-rule=\"evenodd\"\n                            fill=\"#FDFDFD\"\n                            d=\"M3.974 6.71H3.22c-.939 0-1.527-1.317-1.443-2.098.07-.693.672-1.179 1.329-1.179h1.12c.419 0 .769.31 1.564.722-.683.118-.585.192-.473.192h1.259c.14 0 .266-.133.252.323-.126-1.944-1.161-2.991-2.449-3.079V.265A.256.256 0 0 0 4.128 0h-1.26a.257.257 0 0 0-.252.265v1.341C1.49 1.827.139 3.315.14 5.69c.028 1.03 1.441 2.238 3.008 2.238h.826c.741 0 1.329.678 1.245 1.459-.07 1.413-.671 1.179-1.329 1.179H2.77c-.419 0-.67-.309-.853-.722a.242.242 0 0 0-.238-.191H.42a.262.262 0 0 0-.252.28c.126 1.341 1.161 2.387 2.449 2.475v1.327c0 .147.112.265.251.265h1.26c.14 0 .252-.118.252-.265v-1.356c1.343-.236 2.462-.999 2.602-2.8C7.15 7.678 5.737 6.71 3.974 6.71z\"\n                          />\n                        </svg>\n                        Fixed Prize\n                      </button>\n                      <button\n                        className={` ${\n                          activeBtn === 1\n                            ? \"sell-btn-active\"\n                            : \"sell-btn-not-active\"\n                        } `}\n                        onClick={() => {\n                          setActiveBtn(1);\n                          setSellingMethod(2);\n                          setCopies(\"\");\n                        }}\n                      >\n                        <svg\n                          xmlns=\"http://www.w3.org/2000/svg\"\n                          width=\"16\"\n                          height=\"16\"\n                          className=\"me-1 me-sm-2\"\n                        >\n                          <path\n                            fillRule=\"evenodd\"\n                            fill=\"#FFF\"\n                            d=\"M7.999 15.999a7.999 7.999 0 0 1-7.999-8A7.999 7.999 0 0 1 7.999 0c4.419 0 8 3.581 8 7.999a8 8 0 0 1-8 8zm0-14.4a6.4 6.4 0 1 0 .002 12.802 6.4 6.4 0 0 0-.002-12.802zm1.957 8.666L8.268 9.14a.42.42 0 0 0-.022-.015c.664.095-.313-.209-.442-.313a1.581 1.581 0 0 1-.415-.486 1.572 1.572 0 0 1-.174-.615c-.016-.165-.015-.355-.015-.541V3.999a.8.8 0 0 1 .8-.8h-.001a.8.8 0 0 1 .8.8v3.144c0 .224.001.338.009.42v.004l.003.002c.064.052.158.115.345.24l1.687 1.125c.368.245.467.742.807 1.496-.83-.019-1.327.08-1.694-.165z\"\n                          />\n                        </svg>\n                        Timed Auction\n                      </button>\n                    </div>\n                    <div className=\"nftDetail-accordion\">\n                      <div\n                        className=\"accordion accordion-flush \"\n                        id=\"accordionFlushExample\"\n                      >\n                        {activeBtn === 0 ? (\n                          <>\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingOne\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseOne\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseOne\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  Price\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseOne\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingOne\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-price-container mx-auto\">\n                                    <div className=\"sell-price-inp d-flex align-items-center\">\n                                      <div className=\"sell-price-currency text-center\">\n                                        <span> ETH </span>\n                                      </div>\n                                      <input\n                                        type=\"text\"\n                                        name=\"fixedPriceConfig.price.amount\"\n                                        placeholder=\"Amount\"\n                                        style={{\n                                          borderRadius: \"4px\",\n                                        }}\n                                        maxLength={\"8\"}\n                                        onChange={(e) => {\n                                          if (e.target.value == \"00\") {\n                                            return \"\";\n                                          }\n                                          onChange(e);\n                                        }}\n                                        onKeyDown={(e) =>\n                                          decimalNumberValidator(e)\n                                        }\n                                        value={\n                                          fixedPriceConfig.price.amount\n                                        }\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingNine\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseNine\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseNine\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  No. of Copies\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseNine\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingNine\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-price-container mx-auto\">\n                                    <div className=\"sell-price-inp d-flex align-items-center\">\n                                      <div className=\"sell-price-currency text-center\">\n                                        <span> Copies </span>\n                                      </div>\n\n                                      <input\n                                        type=\"text\"\n                                        name=\"timedAuctionConfig.startPrice.amount\"\n                                        placeholder=\"Copies\"\n                                        maxLength={\"3\"}\n                                        style={{\n                                          borderRadius: \"4px\",\n                                        }}\n                                        min={\"1\"}\n                                        max={`${nftDetail.copies}`}\n                                        onChange={(e) => {\n                                        \n                                          if (\n                                            (e.target.value &&\n                                              e.target.value === \".\") ||\n                                            (e.target.value &&\n                                              e.target.value == \"0\") ||\n                                            e.target.value > nftDetail.copies\n                                          ) {\n                                            return false;\n                                          }\n                                          setCopies(e.target.value);\n                                        }}\n                                        onKeyDown={(e) =>\n                                          decimalNumberValidator(e)\n                                        }\n                                        value={copies}\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n\n                            {/* <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingTwo\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Schedule Listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"date-picker sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"fixedPriceConfig.listingSchedule\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div> */}\n                          </>\n                        ) : (\n                          <>\n                            {/* <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingThree\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseThree\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseThree\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  Bid option\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseThree\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingThree\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-bid-opt-container mx-auto\">\n                                    <button\n                                      className={`${\n                                        activeBidBtn ? \"sell-bid-active\" : \"\"\n                                      } sell-bid-opt-btn`}\n                                      onClick={() =>\n                                        setActiveBidBtn(!activeBidBtn)\n                                      }\n                                    >\n                                      Sell To The Highest Bidder\n                                    </button>\n                                  </div>\n                                </div>\n                              </div>\n                            </div> */}\n\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingFour\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseFour\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseFour\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  Price\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseFour\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingFour\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-price-container mx-auto\">\n                                    <div className=\"sell-price-inp d-flex align-items-center\">\n                                      <div className=\"sell-price-currency text-center\">\n                                        <span> ETH </span>\n                                      </div>\n                                      <input\n                                        type=\"text\"\n                                        name=\"timedAuctionConfig.startPrice.amount\"\n                                        placeholder=\"Amount\"\n                                        maxLength=\"8\"\n                                        style={{\n                                          borderRadius: \"4px\",\n                                        }}\n                                        onChange={(e) => {\n                                      \n                                          if (e.target.value === \"00\") {\n                                            return false;\n                                          } else {\n                                            onChange(e);\n                                          }\n                                        }}\n                                        onKeyDown={(e) =>\n                                          decimalNumberValidator(e)\n                                        }\n                                        value={timedAuctionConfig.startPrice.amount}\n                                        \n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingTen\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseTen\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseTen\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  No. of Copies\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseTen\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingTen\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-price-container mx-auto\">\n                                    <div className=\"sell-price-inp d-flex align-items-center\">\n                                      <div className=\"sell-price-currency text-center\">\n                                        <span> Copies </span>\n                                      </div>\n                                      <input\n                                        type=\"text\"\n                                        name=\"timedAuctionConfig.startPrice.amount\"\n                                        placeholder=\"Copies\"\n                                        style={{\n                                          borderRadius: \"4px\",\n                                        }}\n                                        maxLength=\"3\"\n                                        min={\"1\"}\n                                        max={`${nftDetail.copies}`}\n                                        maxLength={3}\n                                        onChange={(e) => {\n                                          if (\n                                            (e.target.value &&\n                                              e.target.value === \".\") ||\n                                            (e.target.value &&\n                                              e.target.value == \"0\") ||\n                                            e.target.value > nftDetail.copies\n                                          ) {\n                                            return false;\n                                          }\n                                          setCopies(e.target.value);\n                                        }}\n                                        onKeyDown={(e) =>\n                                          decimalNumberValidator(e)\n                                        }\n                                        value={copies}\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingSix\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseSix\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseSix\"\n                                >\n                                  <img\n                                    src={ClockIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  Duration\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseSix\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingSix\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-date-picker mx-auto\">\n                                    <DateRangePicker\n                                      initialSettings={dateRangeInitialSettings}\n                                      onApply={handleDateChange}\n                                    >\n                                      <button\n                                        name=\"timedAuctionConfig.duration\"\n                                        className=\"calender-btn\"\n                                        type=\"button\"\n                                      >\n                                        {moment(\n                                          timedAuctionConfig.duration.startDate\n                                        ).format(\"MMMM D, YYYY\")}{\" \"}\n                                        -{\" \"}\n                                        {moment(\n                                          timedAuctionConfig.duration.endDate\n                                        ).format(\"MMMM D, YYYY\")}\n                                        &nbsp;&nbsp;&nbsp;\n                                        <i className=\"fas fa-calendar-week\" />\n                                      </button>\n                                    </DateRangePicker>\n                                  </div>\n                                  <div className=\"sell-time-container\">\n                                    <div className=\"sell-time-inp mx-auto my-3\">\n                                      <input\n                                        type=\"time\"\n                                        name=\"timedAuctionConfig.duration.startTime\"\n                                        placeholder=\"Start Time\"\n                                        className=\"py-1\"\n                                        onChange={(e) => onChange(e)}\n                                        defaultValue={\n                                          timedAuctionConfig.duration.startTime\n                                        }\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n\n                                    <div className=\"sell-time-inp mx-auto my-3\">\n                                      <input\n                                        type=\"time\"\n                                        name=\"timedAuctionConfig.duration.endTime\"\n                                        placeholder=\"End Time\"\n                                        className=\"py-1\"\n                                        onChange={(e) => onChange(e)}\n                                        defaultValue={\n                                          timedAuctionConfig.duration.endTime\n                                        }\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                    <div className=\"row\">\n                      <div className=\"col-10 col-sm-6 col-md-8 col-lg-6  col-xl-4\">\n                        <div className=\"sell-fee-container\">\n                          <div className=\"sell-fee-title d-flex align-items-center mb-2\">\n                            <img src={FeeIcon} alt=\"feeIcon\" className=\"me-2\" />\n                            <h6>Fees</h6>\n                          </div>\n                          <div className=\"sell-fee-content d-flex align-items-center justify-content-between mb-1\">\n                            <p>Service Fee</p>\n                            <p>2.5 %</p>\n                          </div>\n                          <div className=\"sell-fee-content d-flex align-items-center justify-content-between\">\n                            <p>Creator Royalty</p>\n                            <p>2.5 %</p>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 text-center mt-5\">\n                        <button\n                          className=\"complete-btn px-5\"\n                          type=\"submit\"\n                          // onClick={() => submit()}\n                        >\n                          {\" \"}\n                          Complete Listing{\" \"}\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n                <Card className=\"auction-card detail-card\">\n                  <div className=\"auction-img-wrapper\">\n                    {fileType && fileType === \"image\" ? (\n                      <Card.Img variant=\"top\" src={image} alt=\"AuctionTopImg\" />\n                    ) : fileType && fileType === \"video\" ? (\n                      <div className=\"card-img-top\">\n                        <div className=\"video-wrapper\">\n                          <video\n                            src={nftDetail.image}\n                            ref={videoElement}\n                            onTimeUpdate={handleOnTimeUpdate}\n                          />\n                          <div className=\"controls\">\n                            <div className=\"actions\">\n                              <button\n                                className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                                onClick={togglePlay}\n                              >\n                                {playerState.isPlaying ? (\n                                  <BsFillPauseFill />\n                                ) : (\n                                  <BsFillPlayFill />\n                                )}\n                              </button>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    ) : (\n                      \"\"\n                    )}\n\n                    {/* //InCaseOfVideoCard */}\n                  </div>\n                  <Card.Body>\n                    <div className=\"detail-card-name-container d-flex align-items-center justify-content-between\">\n                      <div className=\"detail-nft-name\">\n                        <h5>{name&&name.length>20?name.slice(0,20)+\"...\":name}</h5>\n                      </div>\n                      <div className=\"likes-container d-flex align-items-center\">\n                        {toggle ? (\n                          <>\n                            <AiFillHeart\n                              className=\"heart-fill-icon \"\n                              onClick={() => {\n                                handleLikesTogleApi(_id, \"dislike\");\n                              }}\n                            />\n                            <p className=\"text-white\">\n                              {likesCount ? likesCount : 0}{\" \"}\n                            </p>\n                          </>\n                        ) : (\n                          <>\n                            <img\n                              src={HeartIcon}\n                              alt=\"heart-icon\"\n                              className=\"ms-1\"\n                              onClick={() => {\n                                handleLikesTogleApi(_id, \"like\");\n                              }}\n                            />\n\n                            <span className=\"ms-1\">\n                              {likesCount ? likesCount : 0}\n                            </span>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                    {currentPrice !== null && (\n                      <div>\n                        <h3>\n                          {currentPrice}\n                          <span>\n                            {\" \"}\n                            ($ {(currentPrice * exchangeRate).toFixed(2)})\n                          </span>\n                        </h3>\n                      </div>\n                    )}\n\n                    <div className=\"detail-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n                      {nftDetail && (\n                        <div className=\"detail-nft-owner\">\n                          <p>\n                            Owned by{\" \"}\n                            <span>\n                              {nftDetail.ownerId === ENV.getUserKeys(\"_id\")._id\n                                ? \"You\"\n                                : nftDetail.user.username}\n                            </span>\n                          </p>\n                        </div>\n                      )}\n                      <div className=\"detail-nft-copies\">\n                        <p>\n                          {nftDetail?.remainingCopies\n                            ? nftDetail?.remainingCopies\n                            : nftDetail.copies}{\" \"}\n                          {nftDetail.copies === 1 ? \"Copy\" : \"Copies\"}\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                      {nftDetail?.sellingMethod === 2 && (\n                        <div className=\"d-flex align-items-center\">\n                          <img\n                            src={ClockIcon}\n                            alt=\"clock-icon\"\n                            className=\"me-1\"\n                          />\n                          <span>\n                            Sale ends {auctionEndTimeConversion(auctionEndDate)}{\" \"}\n                          </span>\n                        </div>\n                      )}\n                    </div>\n                  </Card.Body>\n                </Card>\n              </div>\n            </div>\n          </div>\n        </form>\n        <ApprovalModal\n          show={show}\n          approveAccount={approveAccount}\n          approvalStatus={approvalStatus}\n          onHide={() => setShow(false)}\n          address={address}\n        />\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n\n  {\n  nft: state.nft,\n  error: state.error,\n  nftDetail: state.nft.nftsData,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n  \n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  beforeTogleLikeDislike,\n  createActivity,\n  updateProfile,\n  emptyError\n})(SellNFT);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.js",["552","553","554","555","556","557","558","559","560"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.reducer.js",["561","562"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.reducer.js",["563"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/auctions.reducer.js",["564"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/signup/signup.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/create-nft.js",["565","566","567","568","569","570","571"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/collections.reducer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/explore.reducer.js",["572"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/all-nft/allnft.js",["573","574","575","576","577","578","579","580","581","582"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout4/layout4.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/reducer/reducer.js",["583"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nfts/nfts.reducer.js",["584"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/categories/categories.reducer.js",["585"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user/user.reducer.js",["586"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/offers/offers.reducer.js",["587"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/bids/bids.reducer.js",["588"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/shared/error/error.reducer.js",["589"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout3/layout3.jsx",["590","591"],"import React, { Component } from \"react\";\nimport Footer from \"../../components/footer/footer\";\n\nimport Scrollup from \"../../components/scroll-up/sroll-up\";\n\nclass Layout3 extends Component {\n  render() {\n    return <div className=\"main\">{this.props.children}</div>;\n  }\n}\n\nexport default Layout3;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/assets/assets.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/top-seller/topseller.js",["592","593","594"],"import React, { useEffect, useState } from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { getTopSellers, beforeUser } from \"../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\r\nimport \"./topseller.css\";\r\nimport { Images } from \"../../assets/assets\";\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.user.topSellersAuth) {\r\n      setSellers(props.user.sellers.topSellers);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content clr-blue\">\r\n                <span>Creative Artists</span>\r\n                <h3 className=\"mb-5\">Top Sellers</h3>\r\n              </div>\r\n              {sellers && sellers.length > 12 && props.viewAll && (\r\n                <div className=\"intro-btn mb-5\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll \"\r\n                    to=\"/top-sellers-list\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row items\">\r\n          {sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              if (idx <= 11) {\r\n                return (\r\n                  <div\r\n                    key={`ts_${idx}`}\r\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                  >\r\n                    {/* Single Seller */}\r\n                    <div className=\"card top-seller-card\">\r\n                      <div className=\"single-seller d-flex align-items-center\">\r\n                        <div className=\"seller-avatar-container\">\r\n                          <img\r\n                            className=\"avatar-md rounded-circle\"\r\n                            src={\r\n                              author.profileImage === null\r\n                                ? Images.profilePlaceholder\r\n                                : author.profileImage\r\n                            }\r\n                            alt=\"AvatarImg\"\r\n                          />\r\n                          {author.profileImage ? (\r\n                            <span className=\"seller-avatar-active\">\r\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                            </span>\r\n                          ) : (\r\n                            \"\"\r\n                          )}\r\n                        </div>\r\n\r\n                        {/* Seller Info */}\r\n                        <div className=\"seller-info ml-3 w-100\">\r\n                          <p className=\"seller mb-2\">{author.username}</p>\r\n                          <span className=\"text-end\">\r\n                            {\" \"}\r\n                            {author.totalETH.toFixed(2)}\r\n                          </span>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                );\r\n              }\r\n            })\r\n          ) : (\r\n            <p className=\"text-center\">No Top Sellers Found</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/home-auctions.js",["595","596","597","598","599","600","601"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\n\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\n\r\nimport { getCreators } from \"./../user/user.action\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  // const [creators, setCreator] = useState([]);\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"all\");\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  const [isActive, setIsActive] = useState(0);\r\n  const [filterationLoader,setFilterationLoader]=useState(true)\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n\r\n\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n      if (auctions) {\r\n        auctions.forEach((element, i) => {\r\n          auctions[i].totalBids = element.bidInfo?.bidBy?.length;\r\n        });\r\n      }\r\n\r\n      setAuctions(auctions);\r\n      setFilterationLoader(false)\r\n\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setFilterationLoader(true)\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-md-8\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content clr-yellow\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products.{\" \"}\r\n                    <br className=\"d-none d-xl-block\" />\r\n                    We want to be a part of your smile, success and future\r\n                    growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\r\n              {categoryId === \"all\" && (!auctions || (auctions&&auctions?.length <= 1)) &&!filterationLoader? (\r\n                \"\"\r\n              ) : (\r\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                  {categories &&\r\n                    categories.length > 0 &&\r\n                    categories.map((item, id) => {\r\n                      if (id <= 3) {\r\n                        return (\r\n                          <button\r\n                            key={id}\r\n                            className={`${\r\n                              id === isActive ? \"home-active-category\" : \"\"\r\n                            } me-1 me-sm-3 me-lg-4`}\r\n                            onClick={() => {\r\n                              setIsActive(id);\r\n                              handleCategoryFilter(item.description);\r\n                            }}\r\n                          >\r\n                            {item.name}\r\n                          </button>\r\n                        );\r\n                      }\r\n                    })}\r\n                  <div className=\"intro-btn\">\r\n                    <Link\r\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                      to=\"/auctions\"\r\n                    >\r\n                      View All\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auctions-slides\">\r\n            <div className=\"\">\r\n              {filterationLoader ? (\r\n                <div className=\"text-center\">\r\n                  <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                    <span className=\"sr-only\">Loading...</span>\r\n                  </div>\r\n                </div>\r\n              ) : auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item, index) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        cardBg={\"card-bg-gray\"}\r\n                        key={index}\r\n                        item={item}\r\n                        ownerName={item.owner.username}\r\n                        userId={ENV.getUserKeys(\"_id\")._id}\r\n                        ownerId={item.owner._id}\r\n                        bidsProfile={item.bidInfo.bidByProfile}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className=\"text-center\">No Live Auctions Found</p>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/popular-collections.js",["602","603","604","605","606","607","608","609","610","611"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\n\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n} from \"../collections/collections.actions\";\nimport { connect } from \"react-redux\";\nimport { CollectionImages } from \"../../assets/assets.js\";\nimport { Images } from \"../../assets/assets\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst PopularCollections = (props) => {\n  const [popular, setpopular] = useState([]);\n  const [categories, setCategories] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [popularSettings, settPopularSettings] = useState();\n  const [isActive, setIsActive] = useState(0);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.category.getAuth) {\n      setCategories(props.category.categories);\n    }\n  }, [props.category.getAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n      let popularCollectionsSettings = ENV.popularCollectionsSettings;\n      if (finalCollectionListing.length > 3) {\n        popularCollectionsSettings.infinite = true;\n      } else {\n        popularCollectionsSettings.infinite = false;\n      }\n      settPopularSettings(popularCollectionsSettings);\n      setpopular(finalCollectionListing);\n      setFilterationLoader(false);\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  const handleCategoryFilter = (desc) => {\n    setFilterationLoader(true);\n    props.beforePopularCollection();\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getPopularCollections(qs);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-md-8\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content clr-yellow\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-1\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products.{\" \"}\n                    <br className=\"d-none d-xl-block\" /> We want to be a part of\n                    your smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\n              {categoryId === \"all\" && popular && popular?.length == 0 ? (\n                \"\"\n              ) : (\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      if (id <= 3) {\n                        return (\n                          <button\n                            key={id}\n                            className={`collection-category ${\n                              id === isActive ? \"home-active-category\" : \"\"\n                            } me-1 me-sm-3 me-lg-4`}\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      }\n                    })}\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\n                      to=\"/popular-collections\"\n                    >\n                      View All\n                      <img\n                        src={ViewAllIcon}\n                        alt=\"arrow-left\"\n                        className=\"ms-2 d-none d-sm-none\"\n                      />\n                    </Link>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n          {filterationLoader ? (\n            <div className=\"text-center\">\n              <div className=\"spinner-border text-secondary\" role=\"status\">\n                <span className=\"sr-only\">Loading...</span>\n              </div>\n            </div>\n          ) : popular && popular.length && popular.length > 0 ? (\n            <CardSlider\n              settings={ENV.popularCollectionsSettings}\n              data={popular}\n              homeAuction\n            >\n              {popular.map((item, i) => {\n                if (i < 8) {\n                  return (\n                    <CollectionsCard\n                      key={i}\n                      Subimg1={handleImage(item, 0)}\n                      Subimg2={handleImage(item, 1)}\n                      Subimg3={handleImage(item, 2)}\n                      collection={item}\n                      CardImg={item.featuredImg}\n                      name={item.name}\n                      id={item._id}\n                      userName={item.username[0]}\n                      NFTCount={item.totalNfts}\n                      profileImage={item.profileImage[0]}\n                    />\n                  );\n                }\n              })}\n            </CardSlider>\n          ) : (\n            <p className=\"text-center not-found-title mt-5\">\n              No popular collections Found\n            </p>\n          )}\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(mapStateToProps, {\n  beforePopularCollection,\n  beforeCategory,\n  getCategories,\n  getPopularCollections,\n})(PopularCollections);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/collections.actions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/types.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/shared/error/error.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nfts/nfts.action.js",["612","613","614","615","616"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/functions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/navbar-main/NavbarMain.js",["617","618","619","620"],"import React, { useState } from \"react\";\nimport { Link, useHistory, useLocation, NavLink } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport { ReactComponent as SearchIcon } from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [activeTab, setActiveTab] = React.useState(null);\n  const [searchactive, setSearchActive] = useState(false);\n  const [searchValue, setSearchValue] = useState(\"\");\n  const history = useHistory();\n  const location = useLocation();\n\n  const handleChange = (e) => {\n    setSearchValue(e.target.value);\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword = () => {\n    if (searchValue !== \"\" && searchValue.length >= 3) {\n      history.push({\n        pathname: \"/explore/allNFT\",\n        state: searchValue,\n      });\n    }\n  };\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n\n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"light\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <NavLink to=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </NavLink>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className={\"mx-xl-auto\"}>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/\">Home</NavLink>\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/exploreAll\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Explore All\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/allNFT\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    All NFT\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/create\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Create NFT\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/createcollection\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Create Collection\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/userprofile\" className=\"nav-main-link\">\n                  Profile\n                </NavLink>\n              </Nav.Link>\n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={() => handleSearchKeyword()}\n                >\n                  <SearchIcon className=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={() => handleSearchKeyword()}\n              >\n                <SearchIcon className=\"search-icon\" />\n              </button>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient btn-login\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/hero/hero.js",["621","622","623","624"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport \"./hero.css\";\r\nimport Play from \"../../assets/images/play.svg\";\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport HeroCards from \"../hero-cards/HeroCards\";\r\nimport { ListingImg } from \"../../assets/assets\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeAuction, getLiveAuctions } from \"../auctions/auctions.action\";\r\nimport { connect } from \"react-redux\";\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n  const [auctions, setAuctions] = useState(null);\r\n  const heroSettings = ENV.heroSettings;\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n  useEffect(() => {\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions } = props.auction;\r\n\r\n      setAuctions(auctions);\r\n\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, <br /> <span>and sell </span>\r\n              <br />\r\n              extraordinary <span> NFTs </span>\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                <p className=\"ms-1\">Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"watch-video d-flex align-items-center mt-5 mb-4\">\r\n              <button className=\"hero-play-btn\">\r\n                <img src={Play} alt=\"play\" />\r\n              </button>\r\n              <span className=\"ms-2\">Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6\">\r\n            <CardSlider settings={heroSettings}>\r\n              {auctions &&\r\n                auctions.length > 0 &&\r\n                auctions.map((auction) => {\r\n                  return <HeroCards auction={auction} className=\"slide\" />;\r\n                })}\r\n            </CardSlider>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n})(Hero);\r\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/buy-sell/Buysell.js",["625","626"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\nimport BuyIcon from \"../../assets/images/buy-icon.svg\";\nimport SellIcon from \"../../assets/images/sell-icon.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./Buysell.css\";\n\nconst Buysell = () => {\n  return (\n    <section className=\"buy-sell-section padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row \">\n          <div className=\"col-sm-6\">\n            <div className=\"buy-card d-md-flex align-items-center\">\n              <div className=\"buy-card-img d-flex\">\n                <img src={Images.buyNft} alt=\"buy-logo\" className=\"mx-auto\" />\n              </div>\n              <div className=\"buy-card-content\">\n                <h5>Buy NFT Products</h5>\n                <p>Purchase digital NFT products from the biggest directory.</p>\n                <div className=\"d-flex justify-content-lg-end justify-content-center\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-start-selling text-right\"\n                    to=\"/explore/allNFT\"\n                  >\n                    Start buying\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-sm-6\">\n            <div className=\"sell-card d-md-flex align-items-center\">\n              <div className=\"buy-card-img d-flex\">\n                <img src={Images.sellNft} alt=\"buy-logo\" className=\"mx-auto\" />\n              </div>\n              <div className=\"buy-card-content \">\n                <h5>Sell Your NFT Products</h5>\n                <p>Sell one of your NFT products to make a huge profit.</p>\n                <div className=\"d-flex justify-content-lg-end justify-content-center\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-start-selling\"\n                    to=\"/userprofile\"\n                  >\n                    Start selling\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nexport default Buysell;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/owncollection/OwnCollection.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/footer/footer.js",["627","628","629","630","631","632"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div className=\"input-group notify-form\">\n                  <div className=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections-cards/CollectionsCard.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/statsinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/levelsinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/upload.js",["633","634"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <div className=\"upload-image-border p-4 position-relative\">\n      <div className=\"nft-uploaded-img-container\">\n        {imageURL || videoURL || audioSrc ? (\n          <MdClose\n            color=\"#e33d0bc2\"\n            className=\"uploaded-cross-icon\"\n            onClick={() => clearData()}\n          />\n        ) : (\n          \"\"\n        )}\n        <label\n          className=\"w-100\"\n          onDrop={(e) => onDrop(e)}\n          onDragOver={(e) => dragOver(e)}\n          onDragEnter={(e) => dragEnter(e)}\n          onDragLeave={(e) => dragLeave(e)}\n        >\n          <div className=\"\">\n            {imageURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <img\n                  className=\"upload-image\"\n                  src={imageURL}\n                  alt=\"upload-image\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : videoURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <VideoComponent\n                  videoUrl={videoURL}\n                  videoStyles={videoStyles}\n                  videoWidth=\"300\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : audioSrc ? (\n              <div className=\"nft-uploaded-img-container\">\n                <AudioPlayer audioSrc={audioSrc} />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : (\n              <>\n                {\" \"}\n                <img\n                  className=\"upload-image-place-holder\"\n                  src={Images.uploadImage}\n                  alt=\"upload-image\"\n                />\n                <div className=\"upload-details text-center mt-2\">\n                  <p>Drag and drop your file</p>\n                  <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n                </div>\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={(e) => onFileChange(e, \"onChange\")}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </>\n            )}\n          </div>\n        </label>\n      </div>\n    </div>\n  );\n};\n\nexport default Upload;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/LevelsModal.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/breadcrumb/breadcrumb.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/PropertiesModal.js",["635"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\n\nconst PropertiesModal = (props) => {\n  const {\n    show,\n    onHide,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    properties,\n    onSave,\n  } = props;\n  const handleSubmit = () => {\n    if (properties && properties.length > 0) {\n      let isEmpty = properties.filter(\n        (item) => item.name === \"\" || item.type === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"properties\");\n      }\n    }\n  };\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Add Properties\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {properties.map((item, i) => {\n            return (\n              <div className=\"row g-2 align-items-center justify-content-between mt-3\">\n                <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Type:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"type\"\n                        maxLength=\"40\"\n                        value={item.type}\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Name:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"name\"\n                        maxLength=\"40\"\n                        value={item.name}\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                  <div className=\"inp-close text-end\">\n                    <button onClick={() => removeFormFields(i, \"properties\")}>\n                      <img src={InputClose} alt=\"closemodal\" />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"properties\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={properties && properties.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default PropertiesModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/StatsModal.js",["636"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nconst StatsModal = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {stats &&\n            stats.length > 0 &&\n            stats.map((item, i) => {\n              return (\n                <div\n                  className=\"row g-2 align-items-center justify-content-between mt-3\"\n                  key={i}\n                >\n                  <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                    <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                      <div className=\"ps-2\">\n                        <h6>Name:</h6>\n                      </div>\n                      <div className=\"inp-container\">\n                        <input\n                          type=\"text\"\n                          name=\"name\"\n                          maxLength=\"40\"\n                          value={item.name}\n                          onChange={(e) => handleChange(i, e, \"stats\")}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                    <div className=\"d-flex align-items-center justify-content-between\">\n                      <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                        <div className=\"ps-2\">\n                          <h6>Value:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={item.value}\n                            onChange={(e) => {\n                              console.log(typeof e.target.value);\n                              if (\n                                +e.target.value > 5 ||\n                                e.target.value === \"0\"\n                              ) {\n                                return \"\";\n                              }\n                              handleChange(i, e, \"stats\");\n                            }}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"value-inp-of mx-3\">\n                        <h6>of</h6>\n                      </div>\n                      <div className=\"bid-inp-container modal-value-inp\">\n                        <div className=\"inp-container \">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={5}\n                            autoComplete=\"off\"\n                            className=\"text-center\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                    <div className=\"inp-close text-end\">\n                      <button>\n                        <img\n                          src={InputClose}\n                          alt=\"closemodal\"\n                          onClick={() => removeFormFields(i, \"stats\")}\n                        />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/types/types.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/test-video-card/videoCard.js",["637"],"import React, { useRef } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./videoCard.css\";\nimport useVideoPlayer from \"./components/useVideoPlayer\";\nimport { ENV } from \"../../config/config\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\n\nconst VideoCard = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  likedNfts,\n  ownerId,\n  sellingMethod,\n  userProfile,\n  auctionStartDate,\n  auctionEndDate,\n  copies,\n  remainingCopies,\n  ownerName\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n  const videoElement = useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div className=\"auction-img-wrapper\">\n        <div className=\"card-img-top\">\n          <div className=\"video-wrapper\">\n            <video\n              src={CardImg}\n              ref={videoElement}\n              onTimeUpdate={handleOnTimeUpdate}\n            />\n            <div className=\"controls\">\n              <div className=\"actions\">\n                <button\n                  className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                  onClick={togglePlay}\n                >\n                  {playerState.isPlaying ? (\n                    <BsFillPauseFill />\n                  ) : (\n                    <BsFillPlayFill />\n                  )}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          <div className=\"auction-owner-name\">\n            <p>{copies-remainingCopies} Sold</p>\n          </div>\n          <div className=\"auction-owner-name\">\n            <p>{remainingCopies} Remaining</p>\n          </div>\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owner</p>\n          </div>\n          <div className=\"d-flex align-items-center ps-1\">\n            <span>{ownerName}</span>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default VideoCard;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user/user.action.js",["638","639"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n    console.log(data,\"data\")\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/explore.action.js",["640"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/scroll-up/sroll-up.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/ApprovalModal.js",["641","642"],"import React, { useState, useEffect } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport MetaImg from \"../../assets/images/metamask.png\";\nimport TickImg from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n\n\n  return (\n    <>\n      {approvalStatus === \"in-progress\" || approvalStatus === \"approved\" ? (\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title>\n              {approvalStatus === \"approved\"  ? \"Congratulations\" : \"We’re on it\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\">\n              <button onClick={onHide}>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n            <hr></hr>\n          </Modal.Header>\n          <Modal.Body>\n            <div className=\"approval-container text-center\">\n              {approvalStatus === \"approved\" ? (\n                <div className=\"approval-confirmed\">\n                  <img src={TickImg} alt=\"confirmed\" />\n                </div>\n              ) : (\n                <div className=\"approval-spinner\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n              )}\n\n              <div className=\"approval-status\">\n                {approvalStatus === \"approved\" ? (\n                  <h4>Your Account has been approved</h4>\n                ) : (\n                  <h4>Processing</h4>\n                )}\n              </div>\n              {approvalStatus === \"approved\" ? (\n                \"\"\n              ) : (\n                <div className=\"approval-status-address d-flex align-items-center\">\n                  <p>Wallet Address</p>\n                  <p className=\"ps-4\">\n                    {address.slice(0, 6) + \"...\" + address.slice(-6)}\n                  </p>\n                </div>\n              )}\n            </div>\n          </Modal.Body>\n        </Modal>\n      ) : (\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title>Your account is not approved yet.</Modal.Title>\n            <div className=\"modal-close-container\">\n              <button onClick={onHide}>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n            <hr></hr>\n          </Modal.Header>\n          <Modal.Body>\n            <div className=\"text-center\">\n              <div>\n                <img src={MetaImg} alt=\"metamask\" />\n              </div>\n              <div className=\"modal-nft-status mt-4\">\n                <div className=\"modal-status-subheadings\">\n                  <p> Please approve your Wallet address to reach us </p>\n                </div>\n                <hr></hr>\n                <div className=\"modal-status-address\">\n                  <p>{address}</p>\n                </div>\n              </div>\n            </div>\n          </Modal.Body>\n\n          <Modal.Footer>\n            <button\n              className=\"btn btn-linear-gradient mt-2\"\n              onClick={() => approveAccount()}\n            >\n              {approvalStatus === \"pending\" ? (\n                <div class=\"spinner-border text-white approve-spinner\" role=\"status\"></div>\n              ) : (\n                \"Get Approved\"\n              )}\n            </button>\n          </Modal.Footer>\n        </Modal>\n      )}\n    </>\n  );\n};\nexport default ApprovalModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/filter-component/FilterComponent.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/listing-cards/ListingCards.js",["643"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/auctions.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions-cards/AuctionsCards.js",["644","645","646"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/categories/categories.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/card-slider/CardSlider.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/footer/footer.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/videoComponent/videoComponent.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/hero-cards/HeroCards.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/BidModal.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/BuyModal.js",["647","648","649","650","651","652","653","654"],"import React, { useState } from \"react\";\nimport { Modal, Button, Spinner } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nconst BuyModal = (props) => {\n  const [purchase, setPurchase] = useState(true);\n  const [checkBox, setCheckBox] = useState(false);\n  const {\n    name,\n    image,\n    price,\n    exchangeRate,\n    tokenId,\n    modal,\n    setModal,\n    buyNow,\n    confirmed,\n    transactionHash,\n    transactionSuccess,\n    onHide,\n    disabled,\n  } = props;\n\n  return confirmed === \"\" || confirmed === false ? (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Complete Checkout\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                <img src={image} alt=\"nft-img\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-conntent\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-6\">\n                  <p>\n                    {name && name.length > 10\n                      ? name.slice(0, 10) + \"...\"\n                      : name}\n                  </p>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>{price} ETH</p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <p>Creator Fees: 5%</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>{price} ETH</h6>\n              <p>${(price * exchangeRate).toFixed(2)}</p>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container\">\n            {checkBox ? (\n              <div\n                className=\"custom-checked-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <img src={TickIcon} alt=\"checked\" />\n              </div>\n            ) : (\n              <div\n                className=\"custom-uncheck-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></div>\n            )}\n            <p>\n              By checking this box,I agree to MintsClub{\" \"}\n              <Link>Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => {\n            buyNow();\n          }}\n          disabled={disabled||checkBox}\n          className=\"btn btn-linear-gradient mt-2\"\n        >\n          Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  ) : (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal purchase-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          {!transactionSuccess\n            ? \"Your Purchase is Processing\"\n            : \"Your Purchase has processed!\"}\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"modal-nft-container\">\n          <div className=\"modal-nft-img\">\n            <img src={image} alt=\"nft-img\" />\n          </div>\n        </div>\n        <div className=\"modal-nft-purchased mt-3\">\n          {!transactionSuccess ? (\n            <p>\n              {`  Woo! You just Purchased ${\n                name && name.length > 10 ? name.slice(0, 10) + \"...\" : name\n              }. It should be confirmed on the\n              blockchain shortly`}\n            </p>\n          ) : (\n            <p>\n              {\" \"}\n              {`  Woo! You just Purchased ${\n                name && name.length > 10 ? name.slice(0, 10) + \"...\" : name\n              }. It's been confirmed on the\n              blockchain shortly`}\n            </p>\n          )}\n        </div>\n        <div className=\"modal-nft-status mt-4\">\n          <div className=\"modal-status-subheadings d-flex align-items-center justify-content-between\">\n            <p> Status </p>\n            <p> Transaction Hash </p>\n          </div>\n          <div className=\"modal-status-content d-flex align-items-center justify-content-between\">\n            <div className=\"status-process d-flex align-items-center\">\n              {!transactionSuccess ? (\n                <>\n                  <Spinner\n                    animation=\"border\"\n                    role=\"status\"\n                    size=\"sm\"\n                    variant=\"primary\"\n                    className=\"me-1\"\n                  ></Spinner>\n                  <p>Processing</p>\n                </>\n              ) : (\n                <>\n                  <CheckCircleIcon />\n                </>\n              )}\n            </div>\n            <div\n              className=\"status-address\"\n              onClick={() =>\n                window.open(\n                  `https://rinkeby.etherscan.io/tx/${transactionHash}`,\n                  \"_blank\"\n                )\n              }\n            >\n              <p>\n                {transactionHash.slice(0, 6) +\n                  \".....\" +\n                  transactionHash.slice(-6)}\n              </p>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <p>Share</p>\n        </div>\n        <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-linkedin-in\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-facebook-f\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-instagram\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-twitter\"} />\n          </a>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\nexport default BuyModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/bids/bids.action.js",["655","656"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/offers/offers.action.js",["657"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"data\")\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n   \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n   console.log(data,\"data\")\n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            \n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const buyNow = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}nfts/buyNft`;\nconsole.log(\"sending buy now djfjlkdjsfljsdklf\")\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            \n            dispatch({\n                type: BUY_NOW,\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      \n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout/layout.jsx",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/own-collection-today/own-collection-today.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/banner/banner.js",["658"],"import React from \"react\";\nimport \"./banner.css\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst Banner = ({ subHeading, heading, content, bgImg, bannerImg }) => {\n  return (\n    <>\n      <div\n        className=\"banner-wrapper padding-wrapper\"\n        style={{ backgroundImage: `url(${bgImg})` }}\n      >\n        <div className=\"container\">\n          <div className=\"row align-items-end\">\n            <div className=\"col-md-9 col-lg-7\">\n              <div className=\"intro\">\n                <div className=\"intro-content clr-blue\">\n                  {subHeading && <span>{subHeading}</span>}\n                  {heading && <h3 className=\"mb-0\">{heading}</h3>}\n                  {content && <p className=\"pt-4\">{content}</p>}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-lg-5 d-none d-lg-block\">\n              <div className=\"banner-img\">\n                {bannerImg && <img src={bannerImg} alt=\"banner-img\" />}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Banner;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nft-card/nft-card.js",["659","660","661","662","663","664","665","666","667","668"],"import React from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\n\nimport { ENV } from \"../../config/config\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { connect } from \"react-redux\";\nimport \"./nft-card.css\";\nimport { Images } from \"../../assets/assets\";\n\nconst NFTCard = (props) => {\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n  const {\n    image,\n    name,\n    _id,\n    fileType,\n    owner,\n    cardBg,\n    userId,\n    ownerId,\n    likeCount,\n    sellingMethod,\n    auctionStartDate,\n    auctionEndDate,\n    currentPrice,\n  } = props.data;\n  const { username, profilePhoto } = owner;\n  const { likedNfts } = props;\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n  return (\n    <Card className={`auction-card nft-card ${cardBg} m-1`}>\n      <div className=\"auction-img-wrapper\">\n        {fileType === \"image\" ? (\n          <Card.Img variant=\"top\" src={image} alt=\"AuctionTopImg\" />\n        ) : (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <video\n                src={image}\n                ref={videoElement}\n                onTimeUpdate={handleOnTimeUpdate}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n      <Card.Body>\n        <Card.Title>\n          <div>\n            {name && name.length > 10 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <span className=\"me-2\">{likeCount ? likeCount : 0}</span>\n            {!validateIfLiked(likedNfts, _id) ? (\n              <img\n                src={Images.whiteEmptyHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"like\", likeCount);\n                }}\n              />\n            ) : (\n              <img\n                src={Images.whiteFillHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"dislike\", likeCount);\n                }}\n              />\n            )}\n          </div>\n        </Card.Title>\n        <div className=\"nft-status \">\n          <div className=\"status-info status-sold\">\n            <span className=\"status\">\n              Sold: <span className=\"status-count\">323</span>{\" \"}\n            </span>\n          </div>\n          <div className=\"status-info status-remaining\">\n            <span className=\"status\">\n              Remaining: <span className=\"status-count\">323</span>{\" \"}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-3\">\n          <span className=\"nft-price mt-2\">\n            <img className=\"me-2\" src={Images.nftPriceTag} />\n            Price:<a className=\"price\">{currentPrice} ETH</a>\n          </span>\n        </div>\n        <div className=\"auction-card-owner-container d-flex align-items-center mb-2 mt-3\">\n          <div className=\"auction-owner-avatar\">\n            <img src={profilePhoto} alt=\"avatar\" />\n          </div>\n          <div className=\"ms-2 auction-owner-name\">\n            <p>\n              {\"Owned by \"}\n              <span>\n                {username && username.length > 8\n                  ? username.substring(0, 6) + \"...\"\n                  : username\n                  ? username\n                  : \"unnamed\"}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn\"\n          onClick={() => history.push(`nftdetail/${_id}`)}\n        >\n          {\"View Detail\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state in nfts\"),\n  ({});\n\nexport default connect(mapStateToProps, {})(NFTCard);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/filterComponent/filterComponent.js",["669","670","671","672"],{"ruleId":"673","replacedBy":"674"},{"ruleId":"675","replacedBy":"676"},{"ruleId":"677","severity":1,"message":"678","line":20,"column":13,"nodeType":"679","endLine":22,"endColumn":4},{"ruleId":"677","severity":1,"message":"680","line":22,"column":6,"nodeType":"681","endLine":22,"endColumn":11,"suggestions":"682"},{"ruleId":"677","severity":1,"message":"683","line":31,"column":6,"nodeType":"681","endLine":31,"endColumn":8,"suggestions":"684"},{"ruleId":"685","severity":1,"message":"686","line":3,"column":8,"nodeType":"687","messageId":"688","endLine":3,"endColumn":15},{"ruleId":"689","severity":1,"message":"690","line":173,"column":15,"nodeType":"691","messageId":"692","endLine":173,"endColumn":21},{"ruleId":"685","severity":1,"message":"693","line":5,"column":10,"nodeType":"687","messageId":"688","endLine":5,"endColumn":1