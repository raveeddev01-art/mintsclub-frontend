 // GaTracker()\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  useEffect(() => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n  \n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {\n              routes.map((route, index) => {\n                return (\n                  <PrivateRoute\n                    key={index}\n                    path={route.path}\n                    exact={route.exact}\n                    access={true}\n                    component={props =>\n                      <route.layout {...props} title={route.title}>\n                        <route.component {...props} />\n                      </route.layout>\n                    }\n                  />\n                )\n              })\n            }\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  )\n}\n\nexport default App\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/routes.js",["253","254","255"],"// layouts\nimport layout1 from './layouts/layout1/layout1';\nimport layout2 from './layouts/layout2/layout2';\nimport layout3 from './layouts/layout3/layout3';\nimport layout4 from './layouts/layout4/layout4';\n// components\n// import Home from './components/home/home';\nimport Dashboard from './Screens/Home/home'\nimport FourStepForm from './Screens/FourStepForm/index'\n// import ExploreAll from './components/explore/explore-all';\n// import LiveAuctions from './components/auctions/live-auctions-list';\n// import ItemDetails from './components/item-detail/item-detail';\n// import Activity from './components/activity/activity';\n// import Blog from './components/blog/blog';\n// import BlogSingle from './components/blog-single/blog-single';\n// import HelpCenter from './components/help-center/help-center';\n// import Authors from './components/authors-list/authors-list';\n// import Author from './components/author/author';\n// import Profile from './components/profile/profile';\n// import CreateNFT from './components/create-nft/create-nft';\n// import MyCollections from './components/collections/my-collections';\n// import CreateCollection from './components/create-collection/create-collection';\n// import CollectionDetails from './components/collections/collection-details';\n// import Wallet from './components/wallet/wallet';\n// import Signup from './components/signup/signup';\n// import Contact from './components/contact/contact';\n// import SellNFT from './components/nfts/sell-nft';\n// import NotFound from './components/not-found/not-found';\n// import HowItWorks from './components/how-it-works/how-it-works';\n// import PrivacyTerms from './components/privacy-&-terms/privacy-&-terms';\n\n// routes\nconst routes = [\n    { path: '/', access: true, exact: true, title: 'Home', layout: layout2, component: Dashboard },\n    { path: '/fourStepForm', access: true, exact: true, title: 'Explore', layout: layout2, component: FourStepForm },\n    // { path: '/explore-all', access: true, exact: true, title: 'Explore', layout: layout2, component: ExploreAll },\n    // { path: '/auctions', access: true, exact: true, title: 'Live Auctions', layout: layout2, component: LiveAuctions },\n    // { path: '/item-details', access: true, exact: true, title: 'Item Details', layout: layout2, component: ItemDetails },\n    // { path: '/sell-item/:itemId?', access: true, exact: true, title: 'Sell Item', layout: layout2, component: SellNFT },\n    // { path: '/activity', access: true, exact: true, title: 'Activity', layout: layout2, component: Activity },\n    // { path: '/blog', access: true, exact: true, title: 'Blog', layout: layout1, component: Blog },\n    // { path: '/blog-single', access: true, exact: true, title: 'Blog Single', layout: layout1, component: BlogSingle },\n    // { path: '/help-center', access: true, exact: true, title: 'Help Center', layout: layout1, component: HelpCenter },\n    // { path: '/authors', access: true, exact: true, title: 'Authors', layout: layout2, component: Authors },\n    // { path: '/author/:authorId?', access: true, exact: true, title: 'Author Profile', layout: layout1, component: Author },\n    // { path: '/profile', access: true, exact: true, title: 'Profile', layout: layout1, component: Profile },\n    // { path: '/create', access: true, exact: true, title: 'Create', layout: layout2, component: CreateNFT },\n    // { path: '/collections', access: true, exact: true, title: 'Collections', layout: layout2, component: MyCollections },\n    // { path: '/collection/create', access: true, exact: true, title: 'Create Collection', layout: layout2, component: CreateCollection },\n    // { path: '/collection-details/:collectionId?', access: true, exact: true, title: 'Collection Details', layout: layout1, component: CollectionDetails },\n    // { path: '/login', access: true, exact: true, title: 'login', layout: layout4, component: Wallet },\n    // { path: '/signup', access: true, exact: true, title: 'Signup', layout: layout4, component: Signup },\n    // { path: '/contact', access: true, exact: true, title: 'Contact', layout: layout1, component: Contact },\n    // { path: '/how-it-works', access: true, exact: true, title: 'How It Works', layout: layout1, component: HowItWorks },\n    // { path: '/privacy-and-terms', access: true, exact: true, title: 'Privacy & Terms', layout: layout1, component: PrivacyTerms },\n    // { path: '/*', access: true, exact: true, name: 'Not Found', layout: layout3, component: NotFound }\n];\n\nexport default routes;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/index.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/full-page-loader/full-page-loader.js",["256"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/auctions.reducer.js",["257"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/nfts.reducer.js",["258"],"import { BEFORE_NFT, GET_NFTS, GET_NFT, UPSERT_NFT,NFTALL } from '../../redux/types';\n\nconst initialState = {\n    nftsData: {},\n    nftAll:{},\n    nftsAuth: false,\n    upsertAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case UPSERT_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                upsertAuth: true\n            }\n        case GET_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n            case NFTALL:\n        \n                return {\n                    ...state,\n                    nftAll: action.payload,\n                }\n            \n        case GET_NFTS:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n        case BEFORE_NFT:\n            return {\n                ...state,\n                nftsData: {},\n                nftsAuth: false,\n                upsertAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.reducer.js",["259"],"import { BEFORE_USER, SET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, GET_USER } from '../../redux/types';\n\nconst initialState = {\n    userData: null,\n    userAuth: false,\n    creatorsAuth: false,\n    topSellersAuth: false,\n    individualUserAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_USER:\n            return {\n                ...state,\n                userData: action.payload,\n                userAuth: true\n            }\n        case GET_USER:\n            return {\n                ...state\n            }\n        case SET_CREATORS:\n            return {\n                ...state,\n                creators: action.payload,\n                creatorsAuth: true\n            }\n        case TOP_SELLERS:\n            return {\n                ...state,\n                sellers: action.payload,\n                topSellersAuth: true\n            }\n        case SET_INDIVIDUAL_USER:\n            return {\n                ...state,\n                individualUser: action.payload,\n                individualUserAuth: true\n            }\n        case BEFORE_USER:\n            return {\n                ...state,\n                userData: null,\n                userAuth: false,\n                creatorsAuth: false,\n                topSellersAuth: false,\n                individualUserAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/reducer/reducer.js",["260"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  }\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n            \n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.reducer.js",["261"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/home/home.reducer.js",["262","263"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/categories/categories.reducer.js",["264"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.reducer.js",["265"],"import { BEFORE_COLLECTION, GET_COLLECTION, SET_AUTH_STATE, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\n\nconst initialState = {\n    collection: null,\n    collections: null,\n    allCollections:null,\n    pagination: null,\n    deleteAuth: false,\n    upsertAuth: false,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n            case ALL_COLLECTIONS:\n                return {\n                    ...state,\n                    collection: action.payload.allCollections,\n                    getAuth: true\n                }\n        case SET_AUTH_STATE:\n            return {\n                ...state,\n                getAuth: false\n            }\n\n        case UPSERT_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                upsertAuth: true\n            }\n        case DELETE_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                deleteAuth: true\n            }\n        case GET_COLLECTIONS:\n            return {\n                ...state,\n                collections: action.payload.collections,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_COLLECTION:\n            return {\n                ...state,\n                collection: null,\n                collections: null,\n                pagination: null,\n                deleteAuth: false,\n                upsertAuth: false,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.reducer.js",["266"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.reducer.js",["267"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/bids/bids.reducer.js",["268"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            return {\n                ...state,\n                bids: action.payload.bids,\n                pagination: action.payload.pagination,\n                highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.reducer.js",["269"],"import { BEFORE_FAQ, GET_FAQS } from '../../redux/types';\n\nconst initialState = {\n    faqs: null,\n    faqsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FAQS:\n            return {\n                ...state,\n                faqs: action.payload,\n                faqsAuth: true\n            }\n        case BEFORE_FAQ:\n            return {\n                ...state,\n                faqs: null,\n                faqsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.reducer.js",["270"],"import { BEFORE_CONTACT, CREATE_CONTACT } from '../../redux/types';\n\nconst initialState = {\n    contactAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case CREATE_CONTACT:\n            return {\n                ...state,\n                contactAuth: true\n            }\n        case BEFORE_CONTACT:\n            return {\n                ...state,\n                contactAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/Home/home.js",["271","272"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/index.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.reducer.js",["273"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Navbar/navbar.js",["274","275","276","277","278"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Slider/slider.js",["279"],"import React from \"react\";\nimport \"./slider.css\";\nimport Slider from \"react-slick\";\nimport \"slick-carousel/slick/slick.css\";\nimport \"slick-carousel/slick/slick-theme.css\";\n\n// import image from \"../../assets/images/test.jpg\";\nimport nftBack from \"../../assets/images/nftBack.png\";\n// import nftImage from \"../../assets/images/nftImage.png\";\n\nconst  SimpleSlider=(props)=>{\n\n    const settings = {\n      dots: true,\n      infinite: true,\n      speed: 500,\n      slidesToShow: 1,\n      slidesToScroll: 1,\n    };\n  \n    return (\n      <div className=\"position-relative\" style={{ backgroundColor: \"\" }}>\n        {/* <h2> Single Item</h2> */}\n\n        <img src={nftBack} style={{ width: \"26rem\", minWidth: \"26rem\" }} />\n\n        <div\n          className=\"position-absolute nfts-title-container\"\n          style={{ top: \"-3rem\", right: \"9rem\" }}\n        >\n          <p\n            className=\"text-white mb-0 worlds-famous\"\n            style={{\n              fontSize: \"34px\",\n              fontWeight: \"bold\",\n              // fontFamily: \"Manrope\",\n            }}\n          >\n            World's Famous\n          </p>\n          <p\n            className=\"mb-0 text-white nfts-title\"\n            style={{\n              // fontSize: \"165px\",\n              fontSize:\"8.2vw\",\n              fontWeight: \"bold\",\n              marginTop: \"-3rem\",\n              // fontFamily: \"Manrope\",\n            }}\n          >\n            NFT's\n          </p>\n        </div>\n        <div className=\"position-relative slider-wrapper\" style={{bottom:\"22rem\",right:\"-2rem\",cursor:\"pointer\"}} >\n          <Slider {...settings}>\n            {props.wordsFamousNfts.map((nft,index) => {\n              return (\n                <div key={index} onClick={()=>window.open(nft.link)}>\n                  <img src={nft.img} className=\"slider-img\" alt={nft} style={{objectFit: 'cover'}} />\n                </div>\n              );\n            })}\n          </Slider>\n        </div>\n      </div>\n    );\n  }\n  export default SimpleSlider\n\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/actions/actions.js",["280","281"],"import { toast } from \"react-toastify\";\nimport Web3 from \"web3\";\nimport {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  // DEPLOY_CONTRACT,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n} from \"../types/types\";\n\n\nimport { ENV } from \"../../config/config\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport axios from \"axios\";\nimport dotenv from \"dotenv\";\nexport const currentStepAction = () => (dispatch) => {\n  // alert(\"called\")\n  \n  dispatch({\n    type: CURRENT_STEP,\n  });\n};\nexport const currentStepDecrement = () => (dispatch) => {\n  dispatch({\n    type: CURRENT_STEP_DECREMENT,\n  });\n};\nexport const clearCurrentStep = () => (dispatch) => {\n  dispatch({\n    type: CLEAR_CURRENT_STEP,\n  });\n};\n\nexport const contractResponse = () => (dispatch) => {\n  dispatch({\n    type: CONTRACT_REPONSE,\n  });\n};\n\nexport const deployContract = (data, address, supply) => (dispatch) => {\n  // dispatch({\n  //   type: CONNECT_WELLET,\n  //   payload: address,\n  // });\n\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/createUser`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then(\n      (res) => {\n        // console.log(res, \"response from backendfdkfd\");\n        const abi = res.data.data.abi;\n        if (res.data.status === true) {\n          let metaDataList = [];\n          for (let i = 1; i <= supply; i++) {\n            metaDataList.push(res.data.data.metaData);\n            dispatch({\n              type: SET_CONTRACT_INFO,\n              payload: res.data,\n            });\n          }\n\n          try {\n            const web3 = new Web3(Web3.givenProvider);\n            // const gasPrice = \"5000000\";\n            let contract = new web3.eth.Contract(abi, null, {\n              data: res.data.data.bytecode,\n\n              from: address,\n              // gas: 4600000,\n            });\n            contract\n              .deploy({\n                data: res.data.data.bytecode,\n                arguments: [res.data.data.name, res.data.data.symbol],\n              })\n              .send({\n                from: address,\n                // gas: gasPrice,\n              })\n              .then((contractInstance) => {\n                toast.success(\"Contract Deployed Successfully!\");\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n\n                let info = {\n                  ...res.data,\n                  contractAddress: contractInstance.options.address,\n                };\n                dispatch({\n                  type: SET_CONTRACT_INFO,\n                  payload: {\n                    data: { ...info },\n                  },\n                });\n                dispatch({\n                  type: CONTRACT_ADDRESS,\n                  payload: contractInstance.options.address,\n                });\n                const contractData = {\n                  contractadd: contractInstance.options.address,\n                  Network: \"Etherium\",\n                  Deployed: true,\n                };\n\n                dispatch({\n                  type: CONTRACT_REPONSE,\n                  payload: contractData,\n                });\n              })\n              .catch((err) => {\n                // console.log(\"error\", err);\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n                toast.error(\"Transaction Failed please check wallet history!\");\n              });\n          } catch (err) {\n            dispatch({\n              type: LOADER,\n              payload: false,\n            });\n            toast.error(\"Transaction Failed please check wallet history!\");\n          }\n        } else {\n          dispatch({\n            type: LOADER,\n            payload: false,\n          });\n          // console.log(res, \"dkfjdkfjkdjfkd\");\n          toast.error(res.data.data);\n\n          // dispatch({\n          //   type: CONTRACT_REPONSE,\n          //   payload: res.data,\n          // });\n        }\n        // console.log(res);\n      },\n      (error) => {\n        console.log(error,\"error handle\")\n        toast.error(error.response.data.data);\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        // console.log(error, \"error==dfjdkf\");\n        dispatch({\n          type: CONTRACT_ERROR_MESSAGE,\n          payload: error,\n        });\n        // alert(\"contract response\")\n        // dispatch({\n        //   type: CONTRACT_REPONSE,\n        //   payload: error,\n        // });\n        // resolve(error)\n      }\n    )\n    .catch((err) => {\n      console.log(err, \"error later==>\");\n    });\n};\n\nexport const mintToken = (data, address, supply, email) => (dispatch) => {\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n  // console.log('here is data', data)\n  dispatch({\n    type: CONNECT_WELLET,\n    payload: address,\n  });\n  let metaDataList = [];\n  // console.log(data, \"data=====>\");\n  let metaData = \"\";\n  if (!data.data) {\n    metaData = data;\n  } else {\n    metaData = data.data.metaData;\n  }\n\n  for (let i = 1; i <= supply; i++) {\n    metaDataList.push(metaData);\n  }\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n  // console.log(\"metaDataList\", metaDataList);\n\n  try {\n    const web3 = new Web3(Web3.givenProvider);\n    // console.log('web3', web3);\n    const contractM = new web3.eth.Contract(\n      data.data.abi,\n      data.contractAddress\n    );\n    // console.log(\"metaDataList\", metaDataList);\n    contractM.methods\n      .batchMint(address, metaDataList, supply)\n      .send({\n        from: address,\n        // gas: 5000000,\n      })\n      .then((response) => {\n        // console.log(response, \"res of createNFT===>\");\n        handleEmailRequest(email);\n        let count = localStorage.getItem(address);\n        if (count) {\n          console.log(typeof (+count*1),\"issueee\")\n          localStorage.setItem(address, (+count*1) + 1);\n        } else {\n          localStorage.setItem(address, 1);\n        }\n        toast.success(\"Minting Successful\");\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        dispatch({\n          type: TOKEN_ID,\n          payload: response,\n        });\n        dispatch({\n          type: MINTING_RESPONSE,\n          payload: response,\n        });\n      })\n      .catch((err) => {\n        console.log(err, \"error==>\");\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        toast.error(\"Transaction Failed please check wallet history!\");\n      });\n  } catch (err) {\n    dispatch({\n      type: LOADER,\n      payload: false,\n    });\n    toast.error(\"Transaction Failed please check wallet history!\");\n  }\n};\nconst handleEmailRequest = (email) => {\n  let data = {\n    email,\n  };\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/addEmail`;\n  // console.log(url);\n  axios\n    .post(url,data, config)\n    .then((res) => {\n      // console.log(res, \"email response==>\");\n    })\n    .catch((err) => console.log(err));\n};\nexport const setContractInfo = () => (dispatch) => {\n  dispatch({\n    type: SET_CONTRACT_INFO,\n  });\n};\n\nexport const connectWallet = () => (dispatch) => {\n  connectMetamaskCopy()\n    .then((address) =>\n      // console.log(address,\"address\"),\n      dispatch({\n        type: CONNECT_WELLET,\n        payload: address,\n      })\n    )\n    .catch((err) => console.log(err, \"error\"));\n};\n\nexport const hometest = () => (dispatch) => {\n  // dispatch({\n  // type:HOME_TEST,\n  // payload: data\n  // })\n  // dispatch(emptyError());\n  // const url = `${ENV.url}/nfts/${type}`;\n  // fetch(url, {\n  // method,\n  // headers: {\n  // 'Authorization': ENV.Authorization,\n  // 'x-auth-token': ENV.x_auth_token,\n  // 'Access-Control-Allow-Origin': '*',\n  // 'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  // },\n  // body\n  // }).then(res => res.json()).then(data => {\n  // if (data.success) {\n  // toast.success(data.message)\n  // dispatch({\n  // type: UPSERT_NFT,\n  // payload: data\n  // })\n  // } else {\n  // toast.error(data.message)\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: data\n  // })\n  // }\n  // }).catch(error => {\n  // if (error.response && error.response.data) {\n  // const { data } = error.response\n  // if (data.message)\n  // toast.error(data.message)\n  // }\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: error\n  // })\n  // })\n};\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/web3.js",["282","283"],"import Web3 from \"web3\";\nimport { toast } from 'react-toastify'\n// import contractAbi from './../utils/abis/token.json';\nimport {ENV} from './../config/config';\n// import liveAuctionsAbi from './abis/ARISwapToken.json'\n// import {liveAuction} from './abiSetup.js'\n// import {placeBid} from '../components/bids/bids.action'\n// import {setFixedPriceNftTOken, acceptBit, placeBidApi} from './functions'\n// import {changeOwnerShip} from './functions'\n// import { Redirect } from 'react-router-dom';\n\n// let Contract = require('web3-eth-contract');\n\n// const nftContractAddress = ENV.nftContractAddress;\n// Contract.setProvider();\n// console.log(window.web3?.currentProvider,\"current provider\")\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN)\n\n//get web3\nvar web3Provider=null;\nexport const getWeb3 = async ()=> {\n    // if(window.ethereum) {\n    //     const web3 = new Web3(Web3.givenProvider);\n    //     return web3;\n    // }\n    // else {\n    //     return false;   \n    // }\n    ////////////////////////////////\n    if (window.ethereum) {\n        web3Provider = window.ethereum;\n        try {\n          // Request account access\n          await window.ethereum.enable();\n        } catch (error) {\n          // User denied account access...\n          console.error(\"User denied account access\")\n        }\n      }\n      // Legacy dapp browsers...\n      else if (window.web3) {\n        web3Provider = window.web3.currentProvider;\n      }\n      // If no injected web3 instance is detected, fall back to Ganache\n      else {\n        web3Provider = new Web3.providers.HttpProvider('http://localhost:7545');\n      }\n\n     var web3 = new Web3(web3Provider);\n      return web3\n    ///////////////////////////////\n}\n\n// TEMP. ADDING THIS METHOD - COPY OF CONNECTMETAMASK\n// export const connectMetamaskCopy = async ()=> {\n//     if(window.ethereum) {\n//         const web3 = new Web3(Web3.givenProvider);\n//         const network = await web3.eth.net.getNetworkType();\n//         await window.ethereum.enable();\n//         let accounts = await web3.eth.getAccounts();\n//         let chainId = await web3.eth.getChainId();\n//         if(chainId !== requiredChainId) {\n//             // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n//         }\n//         return accounts[0];\n//     }\n//     else {\n//         // alert(\"Please install metamask to connect to the Marketplace\");\n//         toast.error(\"Please install metamask to connect to the Marketplace\");\n//     }\n// }\nexport const connectMetamaskCopy = async (address) => {\n    if (window.ethereum) {\n      const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      let chainId = await web3.eth.getChainId();\n      // console.log(chainId, \"chainId\");\n      let currentNetwork = getNetworkName(chainId);\n      if (!currentNetwork) {\n        toast.error(\"Please Connect your metamask with Ethereum Network\");\n        return false;\n      }\n      if (chainId !== requiredChainId) {\n        // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n      }\n      // console.log(accounts[0],\"account==>\")\n      if (accounts[0]) {\n        if(accounts[0]===address)\n        {\n          toast.success(\"wallet is already connected\");\n        }\n        else {\n  \n          toast.success(\"wallet connected\");\n        }\n        //    console.log('hello');\n        return accounts[0];\n      } else {\n        let address = await signRequest();\n  \n        toast.success(\"wallet connected\");\n        return address[0];\n      }\n    } else {\n      // alert(\"Please install metamask to connect to the Marketplace\");\n      toast.error(\"This app requires metamask,Please Install Metamask \");\n    }\n  };\n  export const getWalletAddress=async ()=>{\n    const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      return accounts[0]\n  }\nexport const connectMetamask = async ()=> {\n    if(window.ethereum) {\n        const web3 = new Web3(Web3.givenProvider);\n        window.web3=new Web3(window.ethereum)\n        const network = await web3.eth.net.getNetworkType();\n        await window.ethereum.enable();\n        let accounts = await web3.eth.getAccounts();\n        let chainId = await web3.eth.getChainId();\n        if(chainId !== requiredChainId) {\n            // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n        }\n        return accounts[0];\n    }\n    else {\n        // alert(\"Please install metamask to connect to the Marketplace\");\n        toast.error(\"Please install metamask to connect to the Marketplace\");\n    }\n}\n\nexport const getNetworkNameByChainId=async ()=>{\n    if (window.ethereum) {\n      const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      let chainId = await web3.eth.getChainId();\n      // console.log(chainId,\"chainId\")\n      // console.log(chainId, \"chainId\");\n      let currentNetwork = getNetworkName(chainId);\n      // console.log(currentNetwork,\"currentNetwork==>\")\n      return currentNetwork\n    }\n  }\n  \n  const getNetworkName = (chainId) => {\n    let networks = {\n      1: \"Ethereum Mainnet\",\n      4: \"Ethereum Rinkby\",\n      3: \"Ethereum Ropsten\",\n      42: \"Ethereum Kovan\",\n      5: \"Ethereum Goerli\",\n    };\n    return networks[chainId]\n  };\n  \n\nexport const signRequest = async ()=> {\n    if(window.ethereum) {\n        // const web3 = await getWeb3();\n        // if (!web3) {\n        //     toast.error(\"No web3 instance found\");\n        //     return false;\n        // }\n   \n        const web3 = new Web3(Web3.givenProvider);\n        let accounts = await web3.eth.getAccounts();\n        let address = accounts[0];\n        let signature = await handleSignMessage(address);\n        // placeBid()\n        // console.log(signature,\"signature===>\")\n        return signature;\n    }\n    else {\n        alert(\"Please install metamask to connect to the Marketplace\");\n    }\n}\n\n// export const testing=()=>{\n//     const test=web3.eth.\n// }\n\n// export const mint = async (metaData) => {\n//     // alert(\"dfdfdf\")\n//     const web3 = await getWeb3();\n//     if (!web3) {\n//         toast.error(\"No web3 instance found\");\n//         return false;\n//     }\n//     // let tokenContract1 = new Contract(liveAuctionsAbi., nftContractAddress);\n//     try {\n   \n//         let connectedAddress = await connectMetamask();\n//         // console.log(connectedAddress,\"connectedAddress\")\n//         let tokenContract = new Contract(liveAuctionsAbi, nftContractAddress);\n//         // const txCount = await web3.eth.getTransactionCount(connectedAddress);\n//         const myNewData = await tokenContract.methods\n//             .createNewNFT(connectedAddress, metaData)\n//             .encodeABI();\n        \n//             // console.log(myNewData,\"checking create nft  result==>\")\n//         // const gasLimit = await web3.eth.estimateGas({\n//         //     from: connectedAddress,\n//         //     nonce: txCount,\n//         //     to: nftContractAddress,\n//         //     data: myNewData,\n//         // });\n//         // const gas2 = await web3.eth.getGasPrice();\n//         // const transactionParameters = {\n//         //     nonce: web3.utils.toHex(txCount), // ignored by MetaMask\n//         //     gasPrice: web3.utils.toHex(gas2), // customizable by user during MetaMask confirmation.\n//         //     gasLimit: web3.utils.toHex(gasLimit), // customizable by user during MetaMask confirmation.\n//         //     to: nftContractAddress, // Required except during contract publications.\n//         //     from: connectedAddress, // must match user's active address.\n//         //     data: myNewData, // Optional, but used for defining smart contract creation and interaction.\n//         //     // chainId: '0x3', // Used to prevent transaction reuse across blockchains. Auto-filled by MetaMask.\n//         // };\n//         // // As with any RPC call, it may throw an error\n//         // const txHash = await window.ethereum.request({\n//         //     method: 'eth_sendTransaction',\n//         //     params: [transactionParameters],\n//         // });\n//         toast.success(`Success! NFT Created successfully!`)\n//         return true;\n//     } catch (e) {\n//         // alert(\"inCatch\")\n//         let eMessage = e.message.split('{')[0] || '';\n//         // console.log(eMessage,\"message==>\")\n//         toast.error(eMessage);\n//         return false;\n//     }\n    \n// }\n\nconst handleSignMessage = (address) => {\n    return new Promise((resolve, reject) =>{\n        try {\n            const web3 = new Web3(Web3.givenProvider);\n            web3.eth.personal.sign(\n                web3.utils.fromUtf8(`${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`),\n                address,\n                (err, signature) => {\n                    if (err) return reject(err);\n                    return resolve(signature);\n                }\n            )\n        }\n        catch (e) {\n            console.log(e);\n        }\n        \n    }\n    );\n};\n\n// export const ClaimFundsAfterBidding = (token) => {\n//     // getting accounts\n//     return new Promise ( async (resolve, reject) => {\n//     const web3 = new Web3(Web3.givenProvider);\n//      let accounts = await web3.eth.getAccounts();\n//      let address = accounts[0];\n//      liveAuction.methods.ClaimFundsAfterBidding(token).send(\n//          {\n//             from:address\n//         }\n//             ).then(x=> {\n        \n//             return resolve(x);\n//         });\n//      }).catch((err)=>{\n//         //  return reject(err);\n//         console.log(\"err in catch block error===> \",err)\n//     });\n// }\n\n// export const createNft= async (metaData,nftId)=>{\n//     //getting accounts\n//     const web3 = new Web3(Web3.givenProvider);\n//     let accounts = await web3.eth.getAccounts();\n//     // console.log(accounts,\"accounts\")\n//     let address = accounts[0];\n//     // console.log(address,\"addresss==>\")\n//     console.log(metaData,\"metaData==>\")\n//     console.log(liveAuction,\"liveAuction.==>\")\n//     console.log(liveAuction.methods,\"liveAuction.methods==>\")\n//     //create NFT\n//     liveAuction.methods.createNewNFT(address,metaData).send({\n//             value: 1000000000000000,\n//             // value:0,\n//             from:address,\n//             to:address,\n//          }\n//         ).then((res)=>{\n//             // console.log(res.events.Transfer.returnValues.tokenId,\"res of createNFT===>\")\n//             let data={\n//                 nftToken:res.events.Transfer.returnValues.tokenId,\n//                 nftId\n//             }\n\n//             setNftToken(data)\n\n//             toast.success(\"NFT created successfully\")\n//             // window.location.href= '/explore-all'\n//     })\n//    