eErrorCount":0,"fixableWarningCount":0,"source":"449","usedDeprecatedRules":"209"},{"filePath":"450","messages":"451","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"209"},{"filePath":"452","messages":"453","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"209"},{"filePath":"454","messages":"455","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":1,"source":"456","usedDeprecatedRules":"209"},{"filePath":"457","messages":"458","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"209"},{"filePath":"459","messages":"460","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"209"},{"filePath":"461","messages":"462","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"209"},{"filePath":"463","messages":"464","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"209"},{"filePath":"465","messages":"466","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"209"},"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/index.js",[],["467","468"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/App.js",["469","470","471"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\n\nconst App = React.memo((props) => {\n  let walletAddress = false;\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const history = useHistory();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  // ///set Interval\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n    if (walletAddress) {\n      if (walletAddress !== address || !address) {\n        toast.info(\"Please sign in  with new connected address\");\n        walletAddress = address;\n        // setWalletAddress(address)\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n      // setWalletAddress(address);\n    }\n    // }\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={\n                    ENV.getUserKeys(\"_id\")._id || route.path === \"/login\"||route.path==='Signup' \n                      ? true\n                      : false\n                  }\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nexport default App;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/routes.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/web3.js",["472"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\n\nexport const validateNetwork = async () => {\n  let prevNetwork = await getNetworkNameByChainId();\n\n  if (prevNetwork === \"Ethereum Rinkby\") {\n    return true;\n  } else {\n    return false;\n  }\n};\nexport const getBalance = async () => {\n  let web3 = await getWeb3();\n  let address = await getWalletAddress();\n  let balance = await web3.eth.getBalance(address);\n  let ethBalance = web3.utils.fromWei(balance, \"ether\");\n\n  return ethBalance;\n};\n\nexport const mintNFt = async (metaData, id, amount, recipientValue) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, metaData)\n      .send({ from: connectedAddress });\n\n    return result;\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const openNFTForBidding = async (\n  biddingTime,\n  startTime,\n  tokenId,\n  copies\n) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id = Number(tokenId);\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id, copies)\n      .send({ from: connectedAddress });\n    let web3 = await getWeb3();\n    let sellId = await web3.utils.hexToNumber(result.events[0].raw.data);\n    if (sellId) {\n      return sellId;\n    }\n  } catch (err) {\n    throw new Error(err);\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const bidAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n    // let bidAmount = Number(amount) * 1000000000000000000;\n\n    let id = Number(tokenId);\n\n    const result = await contractM.methods\n      .bid(id)\n      .send({ from: connectedAddress, value: bidAmount, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\n\nexport const putonsale = async (tokenId, amount, price) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let weiAmount = BigInt(Web3.utils.toWei(price, \"ether\"));\n\n    let id = Number(tokenId);\n    const result = await contractM.methods\n      .putonsale(id, amount, weiAmount)\n      .send({ from: connectedAddress, gas: 5000000 });\n    let web3 = await getWeb3();\n    let sellId = await web3.utils.hexToNumber(result.events[0].raw.data);\n    if (sellId) {\n      return sellId;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const BuyFixedPriceNFT = async (\n  amount,\n  tokenId,\n  setConfirmed,\n  setTransactionHash\n) => {\n  setConfirmed(\"pending\");\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n\n    const weiAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n\n    const result = await contractM.methods\n      .BuyFixedPriceNFT(tokenId)\n      .send({ from: connectedAddress, value: weiAmount, gas: 5000000 })\n      .on(\"transactionHash\", function (hash) {\n        setTransactionHash(hash);\n        setConfirmed(true);\n      })\n      .on(\"confirmation\", function (confirmationNumber, receipt) {});\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    setConfirmed(false);\n    console.log(err);\n\n    throw new Error(err);\n  }\n};\nexport const setApprovalForAll = async (setApprovalStatus) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const result = await contractM.methods\n      .setApprovalForAll(ENV.mintsClubContractAddress, true)\n      .send({\n        from: connectedAddress,\n      })\n      .on(\"transactionHash\", function (hash) {\n        // setTransactionHash(hash);\n        setApprovalStatus(\"in-progress\");\n      });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const claimNFTfromContract = async (tokenId) => {\n  try {\n    let connectedAddress = await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.claimNft(tokenId).send({\n      from: connectedAddress,\n      gassPrice: 5000000,\n    });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\nexport const endAuctionFromContract = async (tokenId) => {\n  try {\n    let connectedAddress = await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.auctionEnd(tokenId).send({\n      from: connectedAddress,\n      gassPrice: 5000000,\n    });\n    if (result) {\n      console.log(result, \"result\");\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const getMetamaskConnectedAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        // toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      // toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\nexport const connectWithMetamask = async () => {\n  try {\n    let web3 = await getWeb3();\n    await window.ethereum.request({\n      method: \"wallet_requestPermissions\",\n      params: [\n        {\n          eth_accounts: {},\n        },\n      ],\n    });\n    let accounts = await web3.eth.getAccounts();\n    return accounts[0];\n  } catch (err) {\n    toast.error(err.message);\n  }\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const mint = async () => {\n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n  } catch (e) {}\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = () => {};\n\nexport const createNft = async () => {};\n\nexport const setNftToken = (body) => {\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n  alert(\"calling\");\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        window.location.href = \"/explore-all\";\n      } else {\n      }\n    })\n    .catch((error) => {\n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {};\n\nexport const placeBidNft = async () => {};\n\nexport const SellOnFixedPrice = async () => {};\n\nexport const BuyFixedPriceNFTs = async () => {};\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async () => {};\nexport const signTransaction = async () => {};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/index.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["473","474","475","476","477","478","479","480"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [popular, setpopular] = useState([]);\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"all\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getPopularCollections(null, 1);\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      const pagination = props.popularCollections.pagination;\n\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.finalCollectionListing) {\n        let finalCollectionListing = finalCollectionListing.filter(\n          (item) => item.userId === userId\n        );\n        setpopular(finalCollectionListing);\n      } else {\n        if (finalCollectionListing === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setpopular(finalCollectionListing);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.getPopularAuth]);\n\n  const getPopularCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getPopularCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getPopularCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    setPage(page);\n    setLimit(limit + 10);\n    getPopularCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setCategoryId(category);\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getPopularCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n  const bannerData = {\n    subHeading: \"Collections\",\n    heading: \"Popular Collections\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          {\" \"}\n          <section className=\"explore-collection-section padding-wrapper\">\n            <div className=\"container\">\n              <div className=\"row mb-5\">\n                <div className=\"col-12 explore-collection-nav\">\n                  <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                    {categoryId === \"all\" &&\n                    popular &&\n                    popular?.length == 0 &&\n                    !loader\n                      ? \"\"\n                      : categories &&\n                        categories.length > 0 &&\n                        categories.map((item,index) => {\n                          return (\n                            <button\n                              onClick={() => {\n                                setIsActive(item.name);\n                                setSelectedCategory(item.description);\n                                handleFilterCategory(item.description);\n                              }}\n                              key={index}\n                              className={`${\n                                item.name === isActive\n                                  ? \"active-explore-nav\"\n                                  : \"\"\n                              } me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          );\n                        })}\n                  </div>\n                  <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                    {categoryId === \"all\" &&\n                    popular &&\n                    popular?.length == 0 &&\n                    !loader\n                      ? \"\"\n                      : categories &&\n                        categories.length > 0 &&\n                        categories.map((item,index) => {\n                          return (\n                            <div className=\"col-6 col-sm-3\" key={index}>\n                              <button\n                                onClick={() => {\n                                  setIsActive(item.name);\n                                  setSelectedCategory(item.description);\n                                  handleFilterCategory(item.description);\n                                }}\n                                className={\n                                  isActive === item.name\n                                    ? \"active-explore-nav\"\n                                    : \"\"\n                                }\n                              >\n                                {item.name}\n                              </button>\n                            </div>\n                          );\n                        })}\n                  </div>\n                </div>\n              </div>\n              <div className=\"row g-1 align-items-center justify-content-center\">\n                {loader ? (\n                  <div class=\"spinner-border\" role=\"status\">\n                    <span class=\"sr-only\">Loading...</span>\n                  </div>\n                ) : popular && popular.length > 0 ? (\n                  popular.map((item,index) => {\n                    return (\n                      <div className=\"col-sm-6 col-lg-4 col-xl-3\" key={index}>\n                        <CollectionsCard\n                          CardImg={item.featuredImg}\n                          Subimg1={handleImage(item, 0)}\n                          Subimg2={handleImage(item, 1)}\n                          Subimg3={handleImage(item, 2)}\n                          name={item.name}\n                          id={item._id}\n                          collection={item}\n                          userName={item.username[0]}\n                          NFTCount={item.totalNfts}\n                          profileImage={item.profileImage[0]}\n                        />\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center  not-found-title mt-5\">\n                    No Popular Collections Found\n                  </p>\n                )}\n\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {!empty &&\n                      popular?.length === 10 &&\n                      pagination.totalRecords > popular.length && (\n                        <button\n                          className=\"btn btn-rounded-bordered px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more...\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n        </>\n      )}\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforePopularCollection,\n    getPopularCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/signup/signup.js",["481","482","483","484"],"import React, { useEffect, useState } from \"react\";\r\nimport { useHistory } from \"react-router\";\r\nimport Banner from \"../banner/banner\";\r\nimport BannerBg from \"../../assets/images/hero-bg.png\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\r\nimport { toast } from \"react-toastify\";\r\nimport { signup } from \"../user/user.action\";\r\nimport \"./signup.css\";\r\n\r\nconst SignUp = (props) => {\r\n  const [checkBox, setCheckBox] = useState(false);\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [username, setUsername] = useState(\"\");\r\n  const [loader, setLoader] = useState(false);\r\n\r\n  const history = useHistory();\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n     setConnectedAddress(connectedAddress);\r\n  }, []);\r\n  \r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.error?.message) {\r\n      toast.error(props.error.message);\r\n      setLoader(false);\r\n    }\r\n  }, [props.error]);\r\n  useEffect(() => {\r\n    if (props.userAuth) {\r\n      toast.success(\"Signed up successfully\");\r\n      history.push(\"/\");\r\n    }\r\n  }, [props.userAuth]);\r\n\r\n  const signup = async (e) => {\r\n    e.preventDefault();\r\n    try {\r\n      setLoader(true);\r\n      let sign = await signRequest();\r\n      let payload = {\r\n        address: connectedAddress,\r\n        email: email,\r\n        username: username,\r\n        isApproved: false,\r\n      };\r\n      props.signup(payload);\r\n    } catch (err) {\r\n      setLoader(false);\r\n      toast.error(err.message);\r\n    }\r\n  };\r\n\r\n  const signInbannerData = {\r\n    subHeading: \"Sign Up\",\r\n    heading: \"Create an Account\",\r\n    content:\r\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <Banner\r\n        subHeading={signInbannerData.subHeading}\r\n        heading={signInbannerData.heading}\r\n        content={signInbannerData.content}\r\n        bgImg={BannerBg}\r\n      />\r\n      <section className=\"signup-section padding-wrapper mb-5\">\r\n        <div className=\"container\">\r\n          <form onSubmit={signup}>\r\n            <div className=\"row\">\r\n              <div className=\"signup-title\">\r\n                <p className=\"create-acc mt-5\">Create Account</p>\r\n                <p className=\"acc-info\">\r\n                  There’s no account linked to the address, Please SingUp first.\r\n                </p>\r\n              </div>\r\n              <div className=\"col-12 mt-5\">\r\n                <label className=\"label-common\">Address:*</label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  id=\"url\"\r\n                  type=\"text\"\r\n                  name=\"url\"\r\n                  placeholder={connectedAddress}\r\n                  readOnly\r\n                />\r\n              </div>\r\n              <div className=\"col-md-6 col-sm-12 mt-5\">\r\n                <label className=\"label-common \">\r\n                  Enter your email address:*\r\n                </label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  type=\"email\"\r\n                  name=\"email\"\r\n                  placeholder=\"Enter your Email\"\r\n                  required\r\n                  defaultValue={email}\r\n                  onChange={(e) => setEmail(e.target.value)}\r\n                  maxLength=\"55\"\r\n                  autoComplete=\"off\"\r\n                />\r\n              </div>\r\n              <div className=\"col-md-6 col-sm-12 mt-5\">\r\n                <label className=\"label-common\">Enter your username:*</label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  type=\"text\"\r\n                  name=\"username\"\r\n                  maxLength=\"55\"\r\n                  placeholder=\"Enter your Username\"\r\n                  required\r\n                  defaultValue={username}\r\n                  onChange={(e) => setUsername(e.target.value)}\r\n                  autoComplete=\"off\"\r\n                />\r\n              </div>\r\n              <div>\r\n                <div className=\"checkbox-container d-flex align-items-center mt-5\">\r\n                  {checkBox ? (\r\n                    <span\r\n                      className=\"custom-checked-box me-2\"\r\n                      onClick={() => setCheckBox(!checkBox)}\r\n                    >\r\n                      <svg\r\n                        xmlns=\"http://www.w3.org/2000/svg\"\r\n                        width=\"13\"\r\n                        height=\"10\"\r\n                      >\r\n                        <path\r\n                          fill-rule=\"evenodd\"\r\n                          fill=\"#FFF\"\r\n                          d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\r\n                        />\r\n                      </svg>\r\n                    </span>\r\n                  ) : (\r\n                    <span\r\n                      className=\"custom-uncheck-box me-2\"\r\n                      onClick={() => setCheckBox(!checkBox)}\r\n                    ></span>\r\n                  )}\r\n                  <p>\r\n                    By checking this box, I agree to MintsClub{\" \"}\r\n                    <Link>Terms of Services</Link>\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <button\r\n              disabled={\r\n                !checkBox || email.trim() === \"\" || username.trim() === \"\"\r\n              }\r\n              type=\"submit\"\r\n              className=\"btn btn-linear-gradient sign-up-btn mt-5\"\r\n            >\r\n              {loader ? (\r\n                <div className=\"text-center\">\r\n                  <div\r\n                    className=\"spinner-border text-white sign-up-loader\"\r\n                    role=\"status\"\r\n                  >\r\n                    <span className=\"sr-only\">Loading...</span>\r\n                  </div>\r\n                </div>\r\n              ) : (\r\n                \"Sign Up\"\r\n              )}\r\n            </button>\r\n          </form>\r\n        </div>\r\n      </section>\r\n    </>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => (\r\n  console.log(state, \"state\"),\r\n  {\r\n    wallet: state.wallet,\r\n    collection: state.collection,\r\n    user: state.user,\r\n    userAuth: state.user.userAuth,\r\n    error: state.error,\r\n  }\r\n);\r\n\r\nexport default connect(mapStateToProps, {\r\n  signup,\r\n})(SignUp);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/create-nft.js",["485","486","487","488","489"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nimport { toast } from \"react-toastify\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport {\n  beforeCollection,\n  getCollections,\n  myCollections,\n} from \"../collections/collections.actions\";\nimport { addNFTRecord, createNFT, createActivity } from \"../nfts/nfts.action\";\nimport { getCurrentAddress, mintNFt, validateNetwork } from \"../../utils/web3\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport \"./createNft.css\";\nimport AddIcon from \"../../assets/images/add-icon.svg\";\nimport PropertiesModal from \"../modals/PropertiesModal\";\nimport LevelsModal from \"../modals/LevelsModal\";\nimport StatsModal from \"../modals/StatsModal\";\nimport StatsInfo from \"./components/statsinfo\";\nimport LevelsInfo from \"./components/levelsinfo\";\nimport PropertiesInfo from \"./components/propertiesinfo\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport Select from \"react-select\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport UploadIcon from \"../../assets/images/upload-icon.png\";\nimport UploadWhiteIcon from \"../../assets/images/uploadWhiteIcon.png\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport Waveform from \"../audioPlayer/waveform/WaveForm\";\nimport Audio from \"../audio/audio\";\nconst placeholderImg = \"\";\nclass CreateNFT extends Component {\n  constructor(props) {\n    super(props);\n    this.myRef = React.createRef(null);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      nft: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        ownerId: ENV.getUserKeys(\"_id\")._id,\n        creatorId: ENV.getUserKeys(\"_id\")._id,\n        properties: [],\n        levels: [],\n        stats: [],\n        image: \"\",\n        name: \"\",\n        description: \"\",\n        copies: \"\",\n        collectionId: \"\",\n        ownerAddress: \"\",\n        categoryId: \"\",\n        status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n      },\n      properties: [{ name: \"\", type: \"\" }],\n      levels: [{ name: \"\", value: \"\", total: 5 }],\n      stats: [{ name: \"\", value: \"\", total: 5 }],\n      imageURL: \"\",\n      videoURL: \"\",\n      collections: [],\n      allcollections: null,\n      error: false,\n      errorMessage: \"\",\n      audioUrl: \"\",\n      propertiesmodalShow: false,\n      levelsmodalShow: false,\n      statsmodalShow: false,\n      selectedCollection: null,\n      playerState: {\n        isPlaying: false,\n        progress: 0,\n        speed: 1,\n        isMuted: false,\n      },\n    };\n    // const videoElement = this.myRef;\n\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount = async () => {\n    window.scroll(0, 0);\n    this.props.beforeCollection();\n    this.props.myCollections(ENV.getUserKeys(\"_id\")._id);\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      this.props.history.push(\"/login\");\n    }\n\n    let ownerAddress = await getCurrentAddress();\n\n    let { nft } = this.state;\n    nft = { ...nft, ownerAddress: ownerAddress };\n    this.setState({\n      nft,\n    });\n  };\n\n  componentDidUpdate(prevProps, prevState) {\n    // const videoElement = this.myRef;\n    if (this.state.playerState.isPlaying !== prevState.playerState.isPlaying) {\n      this.state.playerState.isPlaying\n        ? this.myRef?.current?.play()\n        : this.myRef?.current?.pause();\n    }\n    if (this.props.error) {\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (\n      this.props.collection.myCollectionsResult &&\n      prevProps.collection.myCollectionsResult !==\n        this.props.collection.myCollectionsResult\n    ) {\n      const collections =\n        this.props.collection.myCollections.collections.Collections;\n\n      if (!collections.length) {\n        toast.info(\"Please create a collection first\");\n        return this.props.history.push(\"/createcollection\");\n      } else {\n        let updatedCollections = [];\n        for (var item of collections) {\n          let obj = {\n            value: item._id,\n            label: item.name,\n            categoryId: item.categoryId,\n          };\n          updatedCollections.push(obj);\n        }\n        this.setState({\n          collections: updatedCollections,\n          loader: false,\n        });\n      }\n    }\n  }\n\n  togglePlay = () => {\n    let test = { ...this.state.playerState };\n    test = { ...test, isPlaying: !test.isPlaying };\n    this.setState({ playerState: test });\n  };\n\n  onChange(e, status = null) {\n    let { name, value } = e.target;\n    if (status) value = status;\n    let { nft } = this.state;\n    nft = { ...nft, [name]: value };\n    this.setState({ nft });\n  }\n  onChangeSelect = (value) => {\n    let { nft } = this.state;\n    nft = { ...nft, collectionId: value.value, categoryId: value.categoryId };\n    this.setState({\n      nft,\n      selectedCollection: value,\n    });\n  };\n\n  reset = () => {\n    const nft = {\n      userId: ENV.getUserKeys(\"_id\")._id,\n      ownerId: ENV.getUserKeys(\"_id\")._id,\n      image: \"\",\n      name: \"\",\n      description: \"\",\n      royalty: \"\",\n      size: \"\",\n      copies: \"\",\n      collectionId: \"\",\n      ownerAddress: this.state.ownerAddress,\n      status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n    };\n    this.setState({ nft });\n  };\n  capitalize(word) {\n    return word[0].toUpperCase() + word.slice(1).toLowerCase();\n  }\n  submit = async (e) => {\n    e.preventDefault();\n    if (await validateNetwork()) {\n      const { nft, videoURL, audioUrl } = this.state;\n\n      let nftInfo = { ...nft };\n      nftInfo.properties = JSON.stringify(nftInfo.properties);\n      nftInfo.levels = JSON.stringify(nftInfo.levels);\n      nftInfo.stats = JSON.stringify(nftInfo.stats);\n      nftInfo.name = this.capitalize(nftInfo.name);\n\n      if (videoURL) {\n        nftInfo.fileType = \"video\";\n      } else if (audioUrl !== \"\") {\n        nftInfo.fileType = \"audio\";\n      } else {\n        nftInfo.fileType = \"image\";\n      }\n      this.setState(\n        {\n          isSubmitted: true,\n          formValid:\n            this.validator.allValid() && nft.collectionId ? true : false,\n        },\n        () => {\n          const { formValid } = this.state;\n          if (formValid) {\n            this.setState(\n              {\n                loader: true,\n              },\n              async () => {\n                var formData = new FormData();\n\n                for (const key in nftInfo)\n                  if (nftInfo[key]) formData.append(key, nftInfo[key]);\n\n                const res = await axiosPostFormData(\n                  \"nfts/create\",\n                  formData,\n                  true\n                );\n\n                if (res.success) {\n                  // this.reset();\n\n                  nft.remainingCopies = nft.copies;\n                  if (res.nft && res.nft.metaData) {\n                    try {\n                      let createNftResult = await mintNFt(\n                        res.nft.metaData,\n                        res.nft._id,\n                        this.state.nft.copies,\n                        2\n                      );\n\n                      if (\n                        createNftResult.events.TransferSingle.returnValues.id\n                      ) {\n                        let data = {\n                          nftToken:\n                            createNftResult.events.TransferSingle.returnValues\n                              .id,\n                          data: res.nft,\n                          image: res.nft.image,\n                        };\n\n                        this.props.addNFTRecord(data);\n\n                        this.props.history.push(\"/explore/allNFT\");\n                      }\n                    } catch (err) {\n                      toast.error(err);\n                      this.setState({ loader: false });\n                    }\n                  }\n                } else {\n                  toast.error(res.response.data.message);\n                  this.setState({ errors: res.message, loader: false });\n                }\n              }\n            );\n          } else {\n            this.validator.showMessages();\n            this.setState(\n              {\n                errors: \"Please fill all required fields in valid format.\",\n                formValid: false,\n              },\n              () => {\n                $(\"#create-nft\").scrollTop(0, 0);\n              }\n            );\n          }\n        }\n      );\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkeby Network\");\n    }\n  };\n\n  onFileChange = (e, status) => {\n    if (this.handleFilesValidation(e, status) === \"file matched\") {\n      let file = \"\";\n      let url = \"\";\n      let fileId = \"\";\n      if (status === \"onDrag\") {\n        file = e.dataTransfer.files[0];\n        url = URL.createObjectURL(e.dataTransfer.files[0]);\n        fileId = e.dataTransfer.id;\n      } else {\n        file = e.target.files[0];\n        url = URL.createObjectURL(e.target.files[0]);\n        fileId = e.target.id;\n      }\n      if (file)\n        if (file.type.includes(\"image\")) {\n          let { nft } = this.state;\n          nft = { ...nft, [e.target.name]: file };\n\n          this.setState(\n            {\n              nft,\n              imageURL: url,\n              videoURL: \"\",\n              error: false,\n              errorMessage: \"\",\n            },\n            () => {\n              if (file) {\n                var reader = new FileReader();\n\n                reader.onload = function (e) {\n                  $(`#nft-${fileId}`).attr(\"src\", e.target.result);\n                  $(\"#nft-image-label\").html(\"File selected\");\n                };\n                reader.readAsDataURL(file);\n              }\n            }\n          );\n        } else if (file.type.includes(\"video\")) {\n          let { nft } = this.state;\n          nft = { ...nft, image: file };\n\n          this.setState({\n            nft,\n            videoURL: url,\n            // image:file,\n            imageURL: \"\",\n            error: false,\n            errorMessage: \"\",\n          });\n        } else if (file.type.includes(\"audio\")) {\n          let { nft } = this.state;\n          nft = { ...nft, image: file };\n\n          this.setState({\n            nft,\n            videoURL: \"\",\n            imageURL: \"\",\n            // image:file,\n            error: false,\n            errorMessage: \"\",\n            audioUrl: url,\n          });\n        } else {\n          $(`#nft-${fileId}`).attr(\"src\", placeholderImg);\n          file = {};\n        }\n    } else {\n      let message = this.handleFilesValidation(e, status);\n      toast.error(message)\n      this.setState({\n        error: true,\n        errorMessage: message,\n      });\n    }\n  };\n  dragOver = (e) => {\n    e.preventDefault();\n  };\n\n  dragEnter = (e) => {\n    e.preventDefault();\n  };\n\n  dragLeave = (e) => {\n    e.preventDefault();\n  };\n  onDrop = (e) => {\n    e.nativeEvent.preventDefault();\n    if (!e) return;\n    this.onFileChange(e, \"onDrag\");\n  };\n\n  handleFilesValidation = (e, status) => {\n    let files = \"\";\n    let type = \"\";\n    if (status === \"onDrag\") {\n      files = e.dataTransfer.files[0];\n      type = e.dataTransfer.files[0].type;\n    } else {\n      files = e.target.files[0];\n      type = e.target.files[0].type;\n    }\n    if (files) {\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\" ||\n        type === \"audio/mpeg\"\n      ) {\n        let fileSize = this.formatBytes(files.size).split(\" \");\n        if ((+fileSize[0] > 100 && fileSize[1] === \"MB\")||(fileSize[1] === \"GB\")) {\n          return \"File size limit is exceeded\";\n        } else {\n          return \"file matched\";\n        }\n      } else {\n        return \"File not supported!\";\n      }\n    }\n  };\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n  clearData = () => {\n    this.setState({\n      imageURL: \"\",\n      audioUrl: \"\",\n      videoURL: \"\",\n    });\n  };\n\n  ////property modal handlers\n\n  addMoreValues = (status) => {\n    if (status === \"properties\") {\n      this.setState({\n        properties: [...this.state.properties, { name: \"\", type: \"\" }],\n      });\n    } else if (status === \"stats\") {\n      this.setState({\n        stats: [...this.state.stats, { name: \"\", value: \"\", total: 5 }],\n      });\n    } else {\n      this.setState({\n        levels: [...this.state.levels, { name: \"\", value: \"\", total: 5 }],\n      });\n    }\n  };\n\n  handleChange = (i, e, status) => {\n    if (status === \"properties\") {\n      let newFormValues = [...this.state.properties];\n      newFormValues[i][e.target.name] = e.target.value;\n      this.setState({\n        properties: newFormValues,\n      });\n    } else if (status === \"stats\") {\n      let newFormValues = [...this.state.stats];\n      newFormValues[i][e.target.name] =\n        e.target.name === \"value\" && e.target.value !== \"\"\n          ? +e.target.value\n          : e.target.value;\n      this.setState({\n        stats: newFormValues,\n      });\n    } else {\n      let newFormValues = [...this.state.levels];\n      newFormValues[i][e.target.name] =\n        e.target.name === \"value\" && e.target.value !== \"\"\n          ? +e.target.value\n          : e.target.value;\n      this.setState({\n        levels: newFormValues,\n      });\n    }\n  };\n\n  removeFormFields = (i, status) => {\n    let { nft } = this.state;\n    if (status === \"properties\") {\n      let newFormValues = [...this.state.properties];\n      newFormValues.splice(i, 1);\n      let newNFTValues = [...this.state.nft.properties];\n      newNFTValues.splice(i, 1);\n      nft = { ...nft, properties: newNFTValues };\n      this.setState({\n        properties: newFormValues,\n        nft,\n      });\n    } else if (status === \"stats\") {\n      let newFormValues = [...this.state.stats];\n      newFormValues.splice(i, 1);\n      let newNFTValues = [...this.state.nft.stats];\n      newNFTValues.splice(i, 1);\n      nft = { ...nft, stats: newNFTValues };\n      this.setState({\n        stats: newFormValues,\n        nft,\n      });\n    } else {\n      let newFormValues = [...this.state.levels];\n      newFormValues.splice(i, 1);\n      let newNFTValues = [...this.state.nft.levels];\n      newNFTValues.splice(i, 1);\n      nft = { ...nft, levels: newNFTValues };\n      this.setState({\n        levels: newFormValues,\n        nft,\n      });\n    }\n  };\n\n  onSave = (status) => {\n    let { nft } = this.state;\n    if (status === \"properties\") {\n      nft = { ...nft, properties: this.state.properties };\n      this.setState({\n        nft,\n        propertiesmodalShow: false,\n      });\n    } else if (status === \"stats\") {\n      nft = { ...nft, stats: this.state.stats };\n      this.setState({\n        nft,\n        statsmodalShow: false,\n      });\n    } else {\n      nft = { ...nft, levels: this.state.levels };\n      this.setState({\n        nft,\n        levelsmodalShow: false,\n      });\n    }\n  };\n  render() {\n    const {\n      nft,\n      loader,\n      collections,\n      imageURL,\n      videoURL,\n      error,\n      errorMessage,\n      audioUrl,\n      selectedCollection,\n    } = this.state;\n\n    const { onDrop, dragOver, dragEnter, dragLeave } = this;\n    const bannerData = {\n      subHeading: \"Get Started\",\n      heading: \"Create NFT\",\n      content:\n        \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n    };\n    const videoStyles = {\n      width: \"100%\",\n      height: \"100%\",\n    };\n\n    return (\n      <>\n        <section className=\"create-collection create-nft\">\n          <Banner\n            subHeading={bannerData.subHeading}\n            heading={bannerData.heading}\n            content={bannerData.content}\n            bgImg={BannerBg}\n            bannerImg={BannerImage}\n          />\n          <div className=\"container\">\n            {/* <form> */}\n            {loader && <FullPageLoader />}\n\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div\n                  className=\"upload-nft-container mb-4 mb-lg-5 mx-auto mx-md-0\"\n                  onDrop={(e) => onDrop(e)}\n                  onDragOver={(e) => dragOver(e)}\n                  onDragEnter={(e) => dragEnter(e)}\n                  onDragLeave={(e) => dragLeave(e)}\n                >\n                  {imageURL ? (\n                    <label className=\"w-100\">\n                      <div className=\"uploaded-img-container px-sm-0 px-2 mx-auto\">\n                        <label>\n                          <input\n                            type=\"file\"\n                            style={{ display: \"none\" }}\n                            onChange={(e) => this.onFileChange(e, \"onChange\")}\n                            accept=\".mp4, .png,.jpeg\"\n                            name=\"image\"\n                          />\n                        </label>\n                        <img className=\"uploaded-img\" src={imageURL} />\n                        <div className=\"upload-icon-container uploaded-img-content text-center\">\n                          <img\n                            src={UploadWhiteIcon}\n                            alt=\"upload\"\n                            className=\"mb-1 mt-4\"\n                          />\n                          <h6 className=\"mb-1 text-white\">\n                            Drag and drop your files\n                          </h6>\n                          <p className=\"mb-1 text-white\">\n                            PNG, GIF, WEBP, MP4 or MP3. Max 100mb.\n                          </p>\n                          <div className=\"mx-3 my-1\">\n                            <span className=\"text-white\">|</span>\n                            <h6 className=\"text-white\">OR</h6>\n                            <span className=\"text-white\">|</span>\n                          </div>\n                          <span className=\"btn uploaded-img-browse upload-nft-btn \">\n                            Browse File\n                          </span>\n                          <span className=\"text-danger text-center mt-3\">\n                            {this.validator.message(\n                              \"image\",\n                              nft.image,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                    </label>\n                  ) : videoURL ? (\n                    <>\n                      <div className=\"uploaded-img-container\">\n                        <div className=\"create-nft-video-container px-sm-0 px-2 mx-auto\">\n                          <video\n                            src={videoURL}\n                            ref={this.myRef}\n                            // onTimeUpdate={handleOnTimeUpdate}\n                          />\n                          <div className=\"controls\">\n                            <div className=\"actions\">\n                              <button\n                                className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                                onClick={() => this.togglePlay()}\n                              >\n                                {this.state.playerState.isPlaying ? (\n                                  <BsFillPauseFill />\n                                ) : (\n                                  <BsFillPlayFill />\n                                )}\n                              </button>\n                            </div>\n                          </div>\n                        </div>\n\n                        <label className=\"video-upload-label\">\n                          <div className=\"uploaded-video-container mx-auto\">\n                            <label>\n                              <input\n                                type=\"file\"\n                                style={{ display: \"none\" }}\n                                onChange={(e) =>\n                                  this.onFileChange(e, \"onChange\")\n                                }\n                                accept=\".mp4, .png,.jpeg,.mp3\"\n                                name=\"image\"\n                              />\n                            </label>\n\n                            <div className=\"upload-icon-container uploaded-video-content text-center\">\n                              <img\n                                src={UploadWhiteIcon}\n                                alt=\"upload\"\n                                className=\"mb-1 mt-4\"\n                              />\n                              <h6 className=\"mb-1 text-white\">\n                                Drag and drop your files\n                              </h6>\n                              <p className=\"mb-1 text-white\">\n                                PNG, GIF, WEBP, MP4 or MP3. Max 100mb.\n                              </p>\n                              <div className=\"mx-3 my-1\">\n                                <span className=\"text-white\">|</span>\n                                <h6 className=\"text-white\">OR</h6>\n                                <span className=\"text-white\">|</span>\n                              </div>\n                              <span className=\"btn uploaded-img-browse upload-nft-btn \">\n                                Browse File\n                              </span>\n                            </div>\n                            <span className=\"text-danger text-center mt-3\">\n                              {this.validator.message(\n                                \"image\",\n                                nft.image,\n                                \"required\"\n                              )}\n                            </span>\n                          </div>\n                        </label>\n                      </div>\n                    </>\n                  ) : audioUrl ? (\n                    <>\n                      <div className=\"uploaded-img-container\">\n                        <div className=\"create-nft-video-container px-sm-0 px-2 mx-auto\">\n                          {/* <Waveform url={audioUrl} auction={false} /> */}\n                          <Audio src={audioUrl} />\n                        </div>\n                        <label className=\"video-upload-label\">\n                          <div className=\"uploaded-video-container mx-auto\">\n                            <label>\n                              <input\n                                type=\"file\"\n                                style={{ display: \"none\" }}\n                                onChange={(e) =>\n                                  this.onFileChange(e, \"onChange\")\n                                }\n                                accept=\".mp4, .png,.jpeg,.mp3\"\n                                name=\"image\"\n                              />\n                            </label>\n\n                            <div className=\"upload-icon-container uploaded-video-content text-center\">\n                              <img\n                                src={UploadWhiteIcon}\n                                alt=\"upload\"\n                                className=\"mb-1 mt-4\"\n                              />\n                              <h6 className=\"mb-1 text-white\">\n                                Drag and drop your files\n                              </h6>\n                              <p className=\"mb-1 text-white\">\n                                PNG, GIF, WEBP, MP4 or MP3. Max 100mb.\n                              </p>\n                              <div className=\"mx-3 my-1\">\n                                <span className=\"text-white\">|</span>\n                                <h6 className=\"text-white\">OR</h6>\n                                <span className=\"text-white\">|</span>\n                              </div>\n                              <span className=\"btn uploaded-img-browse upload-nft-btn \">\n                                Browse File\n                              </span>\n                            </div>\n                            <span className=\"text-danger text-center mt-3\">\n                              {this.validator.message(\n                                \"image\",\n                                nft.image,\n                                \"required\"\n                              )}\n                            </span>\n                          </div>\n                        </label>\n                      </div>\n                    </>\n                  ) : (\n                    <label className=\"w-100\">\n                      <div className=\"upload-icon-container text-center \">\n                        <img src={UploadIcon} alt=\"upload\" className=\"mb-2\" />\n                        <h6 className=\"mb-2\">Drag and drop your files</h6>\n                        <p className=\"mb-2\">\n                          PNG, GIF, WEBP, MP4 or MP3. Max 100mb.\n                        </p>\n                        <div className=\"\">\n                          <span>|</span>\n                          <h6>OR</h6>\n                          <span>|</span>\n                        </div>\n\n                        <input\n                          type=\"file\"\n                          style={{ display: \"none\" }}\n                          onChange={(e) => this.onFileChange(e, \"onChange\")}\n                          accept=\".mp4, .png,.jpeg,.mp3\"\n                          name=\"image\"\n                        />\n                        <span className=\"btn btn-linear-gradient upload-nft-btn text-white mt-3\">\n                          Browse File\n                        </span>\n                        <span className=\"text-danger text-center mb-3\">\n                          {this.validator.message(\n                            \"image\",\n                            nft.image,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                    </label>\n                  )}\n                </div>\n              </div>\n              <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                <label className=\"create-collection-label d-flex\">\n                  Title:*{\" \"}\n                  <span className=\"text-danger ms-2\">\n                    {this.validator.message(\"name\", nft.name, \"required\")}\n                  </span>\n                </label>\n                <input\n                  className=\"create-collection-input mt-2\"\n                  name=\"name\"\n                  placeholder=\"Enter title\"\n                  required=\"required\"\n                  maxLength=\"100\"\n                  minLength=\"3\"\n                  onKeyDown={(e) =>\n                    firstInputCharacterSpace(e, nft.name.length)\n                  }\n                  onChange={(e) => this.onChange(e)}\n                  value={nft.name}\n                  autoComplete=\"off\"\n                />\n              </div>\n\n              <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                <label className=\"create-collection-label d-flex\">\n                  No of Copies:*\n                  <span className=\"text-danger ms-2\">\n                    {this.validator.message(\"name\", nft.copies, \"required\")}\n                  </span>\n                </label>\n                <input\n                  className=\"create-collection-input mt-2\"\n                  name=\"copies\"\n                  placeholder=\"No. of Copies\"\n                  type=\"text\"\n                  maxLength={\"3\"}\n                  autoComplete=\"off\"\n                  required=\"required\"\n                  onKeyDown={(e) => decimalNumberValidator(e)}\n                  onChange={(e) => {\n                    if (e.target.value.length && e.target.value === \"0\") {\n                      return false;\n                    } else {\n                      this.onChange(e);\n                    }\n                  }}\n                  value={nft.copies}\n                />\n              </div>\n\n              <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                <label className=\"create-collection-label d-flex\">\n                  Select Collection:*\n                  <span className=\"text-danger ms-2\">\n                    {this.validator.message(\n                      \"name\",\n                      nft.collectionId,\n                      \"required\"\n                    )}\n                  </span>\n                </label>\n\n                <Select\n                  className=\"react-select-cls\"\n                  classNamePrefix=\"react-select\"\n                  placeholder=\"Select Collection\"\n                  isSearchable={false}\n                  value={selectedCollection}\n                  name=\"collectionId\"\n                  onChange={this.onChangeSelect}\n                  options={collections}\n                />\n              </div>\n              <div className=\"col-12 mt-3 mt-lg-5\">\n                <label className=\"create-collection-label d-flex\">\n                  Description:*{\" \"}\n                  <span className=\"text-danger ms-2\">\n                    {this.validator.message(\n                      \"description\",\n                      nft.description,\n                      \"required\"\n                    )}\n                  </span>\n                </label>\n\n                <textarea\n                  className=\"create-collection-area mt-2\"\n                  name=\"description\"\n                  rows=\"3\"\n                  placeholder=\"Enter description...\"\n                  maxLength=\"500\"\n                  onChange={(e) => this.onChange(e)}\n                  onKeyDown={(e) =>\n                    firstInputCharacterSpace(e, nft.description.length)\n                  }\n                  value={nft.description}\n                ></textarea>\n              </div>\n              <div className=\"col-12 col-lg-6 mt-3 mt-lg-5\">\n                <label className=\"create-collection-label\">Properties:</label>\n                <div className=\"create-collection-input mt-2 d-flex align-items-center justify-content-between\">\n                  <div className=\"properties-content\">\n                    <p>Add Properties</p>\n                  </div>\n                  <div className=\"properties-btn\">\n                    <button\n                      onClick={() => {\n                        this.setState({\n                          propertiesmodalShow: true,\n                        });\n                      }}\n                    >\n                      <img src={AddIcon} alt=\"add\" />\n                    </button>\n                  </div>\n                </div>\n                <div className=\"nft-properties-container mx-2 mt-3\">\n                  <div className=\"row g-2\">\n                    {this.state.nft.properties.map((item) => {\n                      return (\n                        <div className=\"col-md-6\">\n                          <PropertiesInfo name={item.name} type={item.type} />\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-lg-6 mt-3 mt-lg-5\">\n                <label className=\"create-collection-label\">Levels:</label>\n                <div className=\"create-collection-input mt-2 d-flex align-items-center justify-content-between\">\n                  <div className=\"properties-content\">\n                    <p>Add Levels</p>\n                  </div>\n                  <div className=\"properties-btn\">\n                    <button\n                      onClick={() => {\n                        this.setState({\n                          levelsmodalShow: true,\n                        });\n                      }}\n                    >\n                      <img src={AddIcon} alt=\"add\" />\n                    </button>\n                  </div>\n                </div>\n                <div className=\"nft-level-container mx-3 mt-3 \">\n                  {this.state.nft.levels.map((item) => {\n                    return <LevelsInfo name={item.name} value={item.value} />;\n                  })}\n                </div>\n              </div>\n              <div className=\"col-12 col-lg-6 mt-3 \">\n                <label className=\"create-collection-label\">Stats:</label>\n                <div className=\"create-collection-input mt-2 d-flex align-items-center justify-content-between\">\n                  <div className=\"properties-content\">\n                    <p>Add Stats</p>\n                  </div>\n                  <div className=\"properties-btn\">\n                    <button\n                      onClick={() => {\n                        this.setState({\n                          statsmodalShow: true,\n                        });\n                      }}\n                    >\n                      <img src={AddIcon} alt=\"add\" />\n                    </button>\n                  </div>\n                </div>\n                <div className=\"nft-stat-container mx-2 mt-3\">\n                  {this.state.nft.stats.map((item) => {\n                    return <StatsInfo name={item.name} value={item.value} />;\n                  })}\n                </div>\n              </div>\n\n              <div className=\"create-collection-btn-container\">\n                <button\n                  className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                  onClick={(e) => this.submit(e)}\n                >\n                  Create NFT\n                </button>\n              </div>\n            </div>\n            {/* </form> */}\n          </div>\n        </section>\n\n        <PropertiesModal\n          show={this.state.propertiesmodalShow}\n          addMoreValues={this.addMoreValues}\n          handleChange={this.handleChange}\n          removeFormFields={this.removeFormFields}\n          properties={this.state.properties}\n          onSave={this.onSave}\n          onHide={() => {\n            this.setState({\n              propertiesmodalShow: false,\n            });\n          }}\n        />\n\n        <LevelsModal\n          show={this.state.levelsmodalShow}\n          addMoreValues={this.addMoreValues}\n          handleChange={this.handleChange}\n          removeFormFields={this.removeFormFields}\n          levels={this.state.levels}\n          onSave={this.onSave}\n          onHide={() => {\n            this.setState({\n              levelsmodalShow: false,\n            });\n          }}\n        />\n        <StatsModal\n          show={this.state.statsmodalShow}\n          addMoreValues={this.addMoreValues}\n          handleChange={this.handleChange}\n          removeFormFields={this.removeFormFields}\n          stats={this.state.stats}\n          onSave={this.onSave}\n          onHide={() => {\n            this.setState({\n              statsmodalShow: false,\n            });\n          }}\n        />\n        <OwnCollectionToday />\n      </>\n    );\n  }\n}\n\nconst mapStateToProps = (state) => (\n  {\n    error: state.error,\n    collection: state.collection,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollections,\n  addNFTRecord,\n  createNFT,\n  myCollections,\n  createActivity,\n  emptyError,\n})(CreateNFT);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.js",["490","491","492","493"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["494","495","496","497","498","499","500","501","502","503","504","505","506","507","508"],"import React, { useState, useEffect } from \"react\";\nimport \"./SellNFT.css\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport \"bootstrap-daterangepicker/daterangepicker.css\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  getMyLikedNfts,\n  createActivity,\n} from \"../nfts/nfts.action\";\nimport {\n  openNFTForBidding,\n  putonsale,\n  getWalletAddress,\n  setApprovalForAll,\n  validateNetwork,\n  getMetamaskConnectedAddress,\n} from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport axios from \"axios\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { updateProfile } from \"../user/user.action\";\nimport ApprovalModal from \"../modals/ApprovalModal\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport SellNFTLoader from \"../contentLoader/sellNFTLoader\";\nimport Audio from \"../audio/audio\";\nconst { dateRangeInitialSettings } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\n\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n};\n\nconst SellNFT = (props) => {\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [loader, setLoader] = useState(true); // NFT loader\n  const location = useLocation();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [likedNfts, setLikedNfts] = useState();\n  const [copies, setCopies] = useState(\"\");\n  const [show, setShow] = useState(false);\n  const [approvalStatus, setApprovalStatus] = useState(\"not-approved\");\n  const [address, setAddress] = useState(\"\");\n  const [copiesError, setCopiesError] = useState(false);\n  const [contentLoader, setContentLoader] = useState(true);\n  let nftId = props.match.params.id;\n\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  useEffect(async () => {\n    let connectedAddress = await getMetamaskConnectedAddress();\n    setAddress(connectedAddress);\n  }, []);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getNFT(nftId);\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n  }, []);\n\n  useEffect(() => {\n    if (props.error !== null) {\n      toast.error(props.error.message);\n      setLoader(false);\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n      validateIfLiked(likedNfts, props.nftDetail);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      setFixedPriceConfig(config1)\n      setTimedAuctionConfig(config2)\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) {\n      data = fixedPriceConfig;\n    } else {\n      data = timedAuctionConfig;\n    }\n\n    const keys = name.split(\".\");\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) {\n      setFixedPriceConfig({ ...data });\n    } else {\n      setTimedAuctionConfig({ ...data });\n    }\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    if (copies > nftDetail.copies) {\n      if (Number(nftDetail.copies) === 1) {\n        toast.info(`Copies should be equal to ${nftDetail.copies}`);\n      } else {\n        toast.info(\n          `Copies should be less than or equal to ${nftDetail.copies}`\n        );\n      }\n      return \"\";\n    }\n    if (await validateNetwork()) {\n      if (!nftDetail.user.isApproved) {\n        setShow(true);\n        return \"\";\n      }\n\n      let price = \"\";\n      let payload = \"\";\n\n      let timedConfig = { ...timedAuctionConfig };\n\n      let fixedConfig = { ...fixedPriceConfig };\n      const { _id, ownerId } = nftDetail;\n\n      let activityPayload = {\n        nftId: _id,\n        ownerId,\n        fromAddress: await getWalletAddress(),\n        activityType: \"List\",\n      };\n\n      if (sellingMethod === 2) {\n        if (Number(timedConfig.startPrice.amount) === 0) {\n          toast.error(\"Price should be greater then 0\");\n          return \"\";\n        }\n        let timedAuctionStartTime = new Date(timedConfig.duration.startDate);\n        let timedAuctionEndTime = new Date(timedConfig.duration.endDate);\n\n        //calculate end time\n        timedAuctionEndTime = timedAuctionEndTime.toString();\n        timedAuctionEndTime =\n          timedAuctionEndTime.slice(0, 15) +\n          \" \" +\n          timedConfig.duration.endTime +\n          \":00\" +\n          timedAuctionEndTime.slice(24);\n        timedConfig.duration.endDate = timedAuctionEndTime;\n\n        //calculate start time\n        timedAuctionStartTime = timedAuctionStartTime.toString();\n        timedAuctionStartTime =\n          timedAuctionStartTime.slice(0, 15) +\n          \" \" +\n          timedConfig.duration.startTime +\n          \":00\" +\n          timedAuctionStartTime.slice(24);\n        timedConfig.duration.startDate = timedAuctionStartTime;\n\n        //Deleting unused data from payload\n        let auctionConfig = timedConfig;\n        delete auctionConfig.duration.startTime;\n        delete auctionConfig.duration.endTime;\n        delete auctionConfig.method;\n        price = Number(auctionConfig.startPrice.amount);\n        auctionConfig.startPrice.amount = Number(\n          auctionConfig.startPrice.amount\n        );\n\n        payload = {\n          _id: location.state._id,\n          sellingMethod,\n          sellingConfig: JSON.stringify(auctionConfig),\n          copiesForAuction: copies,\n        };\n      } else {\n        price = Number(fixedConfig.price.amount);\n        if (price === 0) {\n          toast.error(\"Price should be greater then 0\");\n          return \"\";\n        }\n        payload = {\n          _id: location.state._id,\n          sellingMethod,\n          sellingConfig: JSON.stringify(fixedConfig),\n          copiesForAuction: copies,\n        };\n      }\n\n      setLoader(true);\n\n      var formData = new FormData();\n      // for (const key in payload) formData.append(key, payload[key]);\n      if (sellingMethod === 2) {\n        try {\n          let auctionEndDate = timedAuctionConfig.duration.endDate;\n          let auctionStartDate = timedAuctionConfig.duration.startDate;\n\n          const biddingTime = new Date(auctionEndDate).getTime();\n          const startTime = new Date(auctionStartDate).getTime();\n\n          let result = await openNFTForBidding(\n            biddingTime,\n            startTime,\n            location.state.nftToken,\n            copies\n          );\n          if (result) {\n            activityPayload.price = price;\n            payload.sellId=Number(result);\n            for (const key in payload) formData.append(key, payload[key]);\n            props.createActivity(activityPayload);\n            props.upsertNFT(\"edit\", formData, \"PUT\");\n          }\n        } catch (err) {\n          setLoader(false);\n          toast.error(err);\n        }\n      } else {\n        try {\n          let result = await putonsale(\n            nftDetail.nftToken,\n            copies,\n            fixedConfig.price.amount\n          );\n\n          if (result) {\n            activityPayload.price = price;\n            payload.sellId=Number(result);\n      for (const key in payload) formData.append(key, payload[key]);\n            \n            props.createActivity(activityPayload);\n            props.upsertNFT(\"edit\", formData, \"PUT\");\n          }\n        } catch (err) {\n          setLoader(false);\n          toast.error(err);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      setLoader(false);\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      setLoader(false);\n      return setToggle(false);\n    }\n  };\n  const approveAccount = async () => {\n    setApprovalStatus(\"pending\");\n    var formData = new FormData();\n    formData.append(\"isApproved\", true);\n    formData.append(\"userId\", nftDetail.user._id);\n    try {\n      let accApproved = await setApprovalForAll(setApprovalStatus);\n      if (accApproved) {\n        let updatedNFTDetail = { ...nftDetail };\n        updatedNFTDetail.user.isApproved = true;\n        setNftDetail(updatedNFTDetail);\n        props.updateProfile(formData);\n        setApprovalStatus(\"approved\");\n        toast.success(\"Your Account is Approved!.\");\n        return \"\";\n      }\n    } catch (err) {\n      setApprovalStatus(\"not-approved\");\n      return \"\";\n    }\n  };\n\n  const { image, name, description, remainingCopies, fileType } = nftDetail;\n  const bannerData = {\n    subHeading: \"NFT\",\n    heading: \"NFT Details\",\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\nconsole.log(copies,\"copies\")\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      {loader && <FullPageLoader />}\n      <section className=\"padding-wrapper sell-nft new-nft-detail\">\n        <div className=\"container\">\n          <div className=\"row g-4 g-xl-5\">\n            <div className=\"col-12\">\n              <div className=\"row g-4\">\n                <div className=\" col-lg-6 col-xl-5\">\n                  {fileType === \"image\" ? (\n                    <div className=\"nft-img-container mx-auto mx-lg-0\">\n                      <div\n                        style={{\n                          display: `${contentLoader ? \"block\" : \"none\"}`,\n                        }}\n                      >\n                        <SellNFTLoader />\n                      </div>\n                      <img\n                        src={image}\n                        alt=\"nft-image\"\n                        onLoad={() => setContentLoader(false)}\n                        style={{\n                          display: `${!contentLoader ? \"block\" : \"none\"}`,\n                        }}\n                      />\n                    </div>\n                  ) : fileType === \"video\" ? (\n                    <div className=\"card-img-top\">\n                      <div className=\"nft-img-container nft-video-container mx-auto mx-lg-0\">\n                        <div\n                          style={{\n                            display: `${contentLoader ? \"block\" : \"none\"}`,\n                          }}\n                        >\n                          <SellNFTLoader />\n                        </div>\n                        <video\n                          src={image}\n                          ref={videoElement}\n                          onTimeUpdate={handleOnTimeUpdate}\n                          onEnded={() => {\n                            togglePlay();\n                          }}\n                          onCanPlay={() => {\n                            setContentLoader(false);\n                          }}\n                          style={{\n                            display: `${!contentLoader ? \"block\" : \"none\"}`,\n                          }}\n                        />\n                        <div className=\"controls\">\n                          <div className=\"actions\">\n                            <button\n                              className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                              onClick={togglePlay}\n                            >\n                              {playerState.isPlaying ? (\n                                <BsFillPauseFill />\n                              ) : (\n                                <BsFillPlayFill />\n                              )}\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  ) : fileType === \"audio\" ? (\n                    <>\n                      <div\n                        style={{\n                          display: `${contentLoader ? \"block\" : \"none\"}`,\n                        }}\n                      >\n                        <SellNFTLoader />\n                      </div>\n                      <Audio\n                        src={image}\n                        onLoadCallback={() => setContentLoader(false)}\n                        loader={contentLoader}\n                      />\n                    </>\n                  ) : (\n                    \" \"\n                  )}\n                </div>\n                <div className=\"col-lg-6 col-xl-7\">\n                  <div className=\"nft-img-detail\">\n                    <h5>NFT Details:</h5>\n                  </div>\n                  <div className=\"nft-img-detail-box\">\n                    <div className=\"nft-detail-rounded-box\">\n                      <p>\n                        {name && name.length > 30\n                          ? name.slice(0, 30) + \"...\"\n                          : name}\n                      </p>\n                    </div>\n                    <div className=\"row g-2 g-sm-4\">\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4\">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Total Copies: <span>{nftDetail?.copies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4 \">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Sold:{\" \"}\n                            <span>{nftDetail?.copies - remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4\">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Remaining: <span>{remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div>\n                    <div className=\"detail-bg-box nft-img-detail\">\n                      <h5>Descriptions:</h5>\n                      <hr />\n                      <p>{description}</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12\">\n              <div className=\"sale-btn-container mt-5\">\n                <button\n                  className={` ${\n                    activeBtn === 0 ? \"sell-btn-active\" : \"sell-btn-not-active\"\n                  }  me-3 `}\n                  onClick={() => {\n                    setActiveBtn(0);\n                    setSellingMethod(1);\n                    setCopies(\"\");\n                    setCopiesError(false);\n                  }}\n                >\n                  Fixed Prize\n                </button>\n                <button\n                  className={` ${\n                    activeBtn === 1 ? \"sell-btn-active\" : \"sell-btn-not-active\"\n                  } `}\n                  onClick={() => {\n                    setActiveBtn(1);\n                    setSellingMethod(2);\n                    setCopies(\"\");\n                    setCopiesError(false);\n                  }}\n                >\n                  Timed Auction\n                </button>\n              </div>\n            </div>\n            {activeBtn === 0 ? (\n              <form onSubmit={submit}>\n                <div className=\"row g-4 g-xl-5\">\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Price:</h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"text\"\n                          name=\"fixedPriceConfig.price.amount\"\n                          placeholder=\"Amount\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          maxLength={\"8\"}\n                          onChange={(e) => {\n                            if (e.target.value == \"00\") {\n                              return \"\";\n                            }\n                            onChange(e);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={fixedPriceConfig.price.amount}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">ETH</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>\n                        No of Copies:*{\" \"}\n                        {copiesError && (\n                          <span className=\"text-danger ms-2 error-msg\">{`This NFT has only ${remainingCopies} copies`}</span>\n                        )}\n                      </h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"number\"\n                          name=\"copies\"\n                          placeholder=\"Copies\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          min={\"1\"}\n                          onChange={(e) => {\n                         \n                            if (+e.target.value > remainingCopies) {\n                              setCopiesError(true);\n                              return false;\n                            }\n                            if (\n                              (e.target.value == 0 && copies === \"\") ||\n                              e.target.value.includes(\".\")\n                            ) {\n                              return false;\n                            }\n                            setCopiesError(false);\n                            setCopies(e.target.value);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={copies}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">Copies</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Fees:</h5>\n                      <hr />\n                      <div className=\"fee-details d-flex align-items-center justify-content-between\">\n                        <div>\n                          <p>\n                            Service Fees:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                        <div>\n                          <p>\n                            Creator Royalty:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"sell-btn-container d-flex justify-content-center justify-content-lg-start\">\n                    <button\n                      className=\"btn btn-linear-gradient sell-btn-completed\"\n                      type=\"submit\"\n                    >\n                      Complete Listing\n                    </button>\n                  </div>\n                </div>\n              </form>\n            ) : (\n              <form onSubmit={submit}>\n                <div className=\"row g-4 g-xl-5\">\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Price:*</h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"text\"\n                          name=\"timedAuctionConfig.startPrice.amount\"\n                          placeholder=\"Amount\"\n                          maxLength=\"8\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          onChange={(e) => {\n                            if (e.target.value === \"00\") {\n                              return false;\n                            } else {\n                              onChange(e);\n                            }\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={timedAuctionConfig.startPrice.amount}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">ETH</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>\n                        No of Copies:*{\" \"}\n                        {copiesError && (\n                          <span className=\"text-danger ms-2 error-msg\">{`This NFT has only ${remainingCopies} copies`}</span>\n                        )}\n                      </h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"number\"\n                          name=\"copies\"\n                          placeholder=\"Copies\"\n                          maxLength={\"3\"}\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          min={\"1\"}\n                          max={`${nftDetail.copies}`}\n                          onChange={(e) => {\n                            if (+e.target.value > remainingCopies) {\n                              setCopiesError(true);\n                              return false;\n                            }\n                            setCopiesError(false);\n\n                            setCopies(e.target.value);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={copies}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">Copies</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Duration:</h5>\n                      <hr />\n                      <div className=\"sell-date-picker\">\n                        <DateRangePicker\n                          initialSettings={dateRangeInitialSettings}\n                          minDate={moment().toDate()}\n                          onApply={handleDateChange}\n                        >\n                          <button\n                            name=\"timedAuctionConfig.duration\"\n                            className=\"calender-btn\"\n                            type=\"button\"\n                          >\n                            {moment(\n                              timedAuctionConfig.duration.startDate\n                            ).format(\"MMMM D, YYYY\")}{\" \"}\n                            -{\" \"}\n                            {moment(timedAuctionConfig.duration.endDate).format(\n                              \"MMMM D, YYYY\"\n                            )}\n                            &nbsp;&nbsp;&nbsp;\n                            <svg\n                              width=\"21\"\n                              height=\"17\"\n                              viewBox=\"0 0 21 17\"\n                              fill=\"none\"\n                              xmlns=\"http://www.w3.org/2000/svg\"\n                            >\n                              <path\n                                d=\"M21 1.54739V16.5821C20.8581 16.8395 20.6576 17 20.3179 17C15.0009 16.9966 9.68439 16.9956 4.3682 16.997C3.94412 16.997 3.69482 16.7648 3.69318 16.3732C3.69318 15.8887 3.69318 15.4043 3.69318 14.9193V14.7311H3.4395C2.51682 14.7311 1.59413 14.7311 0.671455 14.7311C0.36079 14.7311 0.139436 14.5973 0.0430038 14.3622C-0.0534283 14.127 0.0123195 13.9024 0.24025 13.7172C0.775972 13.2754 1.23759 12.7628 1.61002 12.1962C3.00993 10.1145 3.62742 7.82482 3.68769 5.39843C3.71783 4.19078 3.69427 2.98162 3.69591 1.77297C3.69591 1.35764 3.94083 1.13306 4.39285 1.13256C5.32905 1.13256 6.26525 1.13256 7.20144 1.13256H7.42773C7.42773 0.94886 7.42773 0.791913 7.42773 0.635469C7.42773 0.254957 7.68251 -0.00342589 8.04851 0.000106718C8.41451 0.00363932 8.65504 0.258494 8.65778 0.627399C8.65778 0.793936 8.65778 0.960974 8.65778 1.12196H11.7338C11.7338 0.948862 11.7338 0.786868 11.7338 0.624368C11.7338 0.256977 11.9874 0.00162069 12.3458 0.000106718C12.7041 -0.00140725 12.96 0.252436 12.9633 0.619322C12.9633 0.786869 12.9633 0.953911 12.9633 1.11792H16.0803C16.0803 0.933724 16.0803 0.764664 16.0803 0.594595C16.0858 0.255465 16.3406 0.00616261 16.683 0.000106718C17.0255 -0.00594917 17.3027 0.246379 17.3087 0.592574C17.312 0.767186 17.3087 0.94129 17.3087 1.13256H17.5504C18.427 1.13256 19.2998 1.14416 20.1743 1.12751C20.5556 1.11893 20.8373 1.21936 21 1.54739ZM19.7793 5.67548H4.91666C4.77146 8.56213 3.95946 11.2398 2.02643 13.5986H2.19081C6.89297 13.5986 11.5953 13.5969 16.2978 13.5936C16.4011 13.5868 16.4983 13.5462 16.5718 13.479C17.1097 12.9678 17.5737 12.3948 17.9525 11.7743C18.8253 10.3774 19.3448 8.86846 19.5963 7.28282C19.6812 6.75243 19.7168 6.22001 19.7793 5.67548ZM4.9309 4.5178H19.759V2.27611H17.3076C17.3076 2.44971 17.3076 2.61221 17.3076 2.77471C17.3044 3.1416 17.0518 3.39695 16.6934 3.39746C16.3351 3.39796 16.0809 3.14211 16.0776 2.77623C16.0776 2.60919 16.0776 2.44164 16.0776 2.28065H12.9605C12.9605 2.46586 12.9605 2.63391 12.9605 2.8055C12.9539 3.14412 12.6975 3.39292 12.3545 3.39746C12.0115 3.402 11.737 3.14968 11.731 2.80247C11.731 2.62836 11.731 2.45375 11.731 2.27763H8.6545C8.6545 2.45325 8.6545 2.61625 8.6545 2.77925C8.65066 3.14412 8.39424 3.39948 8.03536 3.39746C7.67648 3.39544 7.42718 3.13958 7.42444 2.77169C7.42444 2.60515 7.42444 2.43811 7.42444 2.2751H4.93145L4.9309 4.5178ZM19.7601 10.9895C19.7053 11.0935 19.6741 11.1525 19.6439 11.2121C19.0336 12.4177 18.2862 13.5375 17.2435 14.4737C17.1503 14.5606 17.0386 14.6286 16.9153 14.6735C16.792 14.7184 16.6599 14.7392 16.5274 14.7346C12.7414 14.7289 8.9553 14.7277 5.16924 14.7311H4.93145V15.8539H19.7601V10.9895Z\"\n                                fill=\"#387FFF\"\n                              />\n                            </svg>\n                          </button>\n                        </DateRangePicker>\n                      </div>\n\n                      <div className=\"sell-time-inp mx-auto my-3\">\n                        <input\n                          type=\"time\"\n                          name=\"timedAuctionConfig.duration.startTime\"\n                          placeholder=\"Start Time\"\n                          className=\"py-1\"\n                          onChange={(e) => onChange(e)}\n                          defaultValue={timedAuctionConfig.duration.startTime}\n                          required\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                      <div className=\"sell-time-inp mx-auto my-3\">\n                        <input\n                          type=\"time\"\n                          name=\"timedAuctionConfig.duration.endTime\"\n                          placeholder=\"End Time\"\n                          className=\"py-1\"\n                          onChange={(e) => onChange(e)}\n                          defaultValue={timedAuctionConfig.duration.endTime}\n                          required\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Fees:</h5>\n                      <hr />\n                      <div className=\"fee-details d-flex align-items-center justify-content-between\">\n                        <div>\n                          <p>\n                            Service Fees:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                        <div>\n                          <p>\n                            Creator Royalty:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"sell-btn-container d-flex justify-content-center justify-content-lg-start\">\n                    <button\n                      className=\"btn btn-linear-gradient sell-btn-completed\"\n                      type=\"submit\"\n                    >\n                      Complete Listing\n                    </button>\n                  </div>\n                </div>\n              </form>\n            )}\n          </div>\n        </div>\n        <ApprovalModal\n          show={show}\n          approveAccount={approveAccount}\n          approvalStatus={approvalStatus}\n          onHide={() => setShow(false)}\n          address={address}\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  error: state.error,\n  nftDetail: state.nft.nftsData,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  beforeTogleLikeDislike,\n  createActivity,\n  updateProfile,\n  emptyError,\n})(SellNFT);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/explore-collections.js",["509","510","511","512"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport \"./explore-collections.css\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"./collections.actions\";\nimport { Images } from \"../../assets/assets\";\n\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { beforeCategory, getCategories } from \"./collections.actions\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index && result.length !== 0) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  const bannerData = {\n    subHeading: \"Collections\",\n    heading: \"Explore all\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper pt-0\">\n          <Banner\n            subHeading={bannerData.subHeading}\n            heading={bannerData.heading}\n            content={bannerData.content}\n            bgImg={BannerBg}\n            bannerImg={BannerImage}\n          />\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, index) => {\n                      return (\n                        <button\n                          key={index}\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, index) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\" key={index}>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-1 align-items-center justify-content-center\">\n              {loader ? (\n                <div className=\"spinner-border\" role=\"status\">\n                  <span className=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection, index) => {\n                  return (\n                    <div className=\"col-sm-6 col-md-4 col-xl-3\" key={index}>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : \"\"\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 d-flex justify-content-center align-items-center\">\n                  {!empty &&\n                    collections?.length === 10 &&\n                    !loader &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-rounded-bordered px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more...\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n          <OwnCollectionToday />\n        </section>\n      )}\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["513","514","515","516","517","518"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport \"./collectiondetails.css\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport FilterComponent from \"../filterComponent/filterComponent\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport { Images } from \"../../assets/assets\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst CollectionDetailsPage = (props) => {\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const location = useLocation();\n\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      if (props?.nfts?.length > 0) {\n        setDisabled(false);\n      } else {\n        if (initial) {\n          setDisabled(true);\n        }\n      }\n      setNfts(props.nfts);\n      setNFTPagination(props.pagination);\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        limit,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      nftQS.collectionId = location.state._id;\n\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n      if (page) {\n        nftQS.page = page;\n      } else {\n        nftQS.page = 1;\n      }\n      if (limit) {\n        nftQS.limit = limit;\n      } else {\n        nftQS.limit = 10;\n      }\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n  ///////////Likes\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const fetchData = (filterObj) => {\n    getNFTs(filterObj);\n  };\n  const { name, logo, description, username } = location.state;\n  const bannerData = {\n    subHeading: \"Nfts\",\n    heading: \"Collections Info\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"d-flex flex-column flex-md-row align-items-center align-items-sm-start\">\n                  <div className=\"ms-lg-5 collection-owner-avatar user-avatar-container me-3 flex-fill\">\n                    <img\n                      src={logo ? logo : Images.profilePlaceholder}\n                      alt=\"owner-avatar\"\n                    />\n                  </div>\n                  <div className=\"collection-owner-detail text-center text-sm-start mt-2 mt-sm-4\">\n                    <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n                      <div className=\"collection-owner-name\">\n                        <h3>\n                          {name}{\" \"}\n                          <span>\n                            <img\n                              src={TickIcon}\n                              alt=\"tick-icon\"\n                              className=\"ms-2\"\n                            />\n                          </span>\n                        </h3>\n                      </div>\n                      <div>\n                        <p>\n                          Created By: <span>{username?.[0]}</span>\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-description mt-3\">\n                      <p>{description && description} </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-7 col-md-6 col-lg-5\"></div>\n            </div>\n          </div>\n        </div>\n        {loader && <FullPageLoader />}\n        <FilterComponent\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={loader}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          path=\"/explore/nftdetail/\"\n          collectionDetail\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftsData.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n})(CollectionDetailsPage);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["519","520","521","522","523","524","525","526","527","528","529","530","531","532","533","534","535","536","537","538","539","540","541","542","543","544","545","546","547","548","549","550"],"import React, { useEffect, useState } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport \"./nftdetail.css\";\nimport {\n  getNFT,\n  getNFTsByCollection,\n  getMyLikedNfts,\n  beforeNFT,\n  createActivity,\n  getActivities,\n  getItemsListing,\n  beforeNFTByCollection,\n} from \"../nfts/nfts.action.js\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader.js\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport moment from \"moment\";\nimport axios from \"axios\";\nimport {\n  BsTagFill,\n  BiTransferAlt,\n  MdShoppingCart,\n  FaHandPaper,\n} from \"react-icons/all\";\nimport {\n  placeABid,\n  connectMetamask,\n  BuyFixedPriceNFT,\n  getWalletAddress,\n  getBalance,\n  validateNetwork,\n  claimNFTfromContract,\n  endAuctionFromContract,\n} from \"../../utils/web3\";\nimport {\n  placeBid,\n  getBids,\n  getBidSByNftId,\n  beforeBid,\n  deleteBid,\n} from \"../bids/bids.action\";\nimport {\n  makeOffer,\n  getOffers,\n  beforeOffer,\n  deleteOffer,\n  buyNow,\n} from \"../offers/offers.action\";\nimport { toast } from \"react-toastify\";\nimport BuyModal from \"../modals/BuyModal\";\nimport BidModal from \"../modals/BidModal\";\nimport ReactTimeAgo from \"react-time-ago\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport StatsInfo from \"../create-nft/components/statsinfo\";\nimport LevelsInfo from \"../create-nft/components/levelsinfo\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport { Images } from \"../../assets/assets\";\nimport NftCard from \"../nft-card/nft-card\";\nimport NFTDetailLoader from \"../contentLoader/nftDetailLoader\";\nimport Audio from \"../audio/audio\";\nconst NFTDetail = (props) => {\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [listedItem, setListedItem] = useState([]);\n  const [nfts, setNFTs] = useState([]);\n  const [activities, setActivities] = useState([]);\n  // const [itemsListing, setItemsListing] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [price, setPrice] = useState(0);\n  const [bids, setBids] = useState(null);\n  const [offers, setOffers] = useState(null);\n  const [modalShow, setModalShow] = useState(false);\n  const [modalShow1, setModalShow1] = useState(false);\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [modal, setModal] = useState(1);\n  const [confirmed, setConfirmed] = useState(\"\");\n  const [transactionHash, setTransactionHash] = useState(\"\");\n  const [transactionSuccess, setTransactionSuccess] = useState(false);\n  const [bidModalShow, setBidModalShow] = useState(false);\n  const [balance, setBalance] = useState(\"\");\n  const [disabled, setDisabled] = useState(false);\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const [claimNFT, setClaimNFT] = useState(false);\n  const [initial, setInitial] = useState(false);\n  const [contentLoader, setContentLoader] = useState(true);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n  let nftId = props.match.params.id;\n  let userId = ENV.getUserKeys(\"_id\")._id;\n\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  useEffect(async () => {\n    props.getNFT(nftId);\n    let qs = { userId };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n    let balance = await getBalance();\n    setBalance(balance);\n    // setLoader(true);\n  }, [props.match.params.id]);\n\n  useEffect(() => {\n    if (props.createAuth) {\n      setLoader(false);\n      props.beforeBid();\n      history.push(\"/explore/allNFT\");\n    }\n  }, [props.createAuth]);\n\n  useEffect(() => {\n    if (props.buyAuth) {\n      setLoader(false);\n      setDisabled(false);\n      setTransactionSuccess(true);\n      props.getNFT(nftId);\n      let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n      qs = ENV.objectToQueryString(qs);\n      props.getMyLikedNfts(qs);\n      validateIfLiked();\n      // props.getBids();\n      props.beforeOffer();\n      toast.success(\"You have purchased NFT successfully\");\n      history.push(\"/userprofile\");\n    }\n  }, [props.buyAuth]);\n\n  useEffect(() => {\n    if (props.createAuthOffer) {\n      setLoader(false);\n      history.push(\"/explore/allNFT\");\n    }\n  }, [props.createAuthOffer]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.getAuthOffer) {\n      setOffers(props.offers);\n    }\n  }, [props.getAuthOffer]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setBids(props.bids);\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n\n      //get activities\n      let activityQs = { nftId: props.nftDetail._id };\n      activityQs = ENV.objectToQueryString(activityQs);\n      props.getActivities(activityQs);\n\n      //getItemsListing\n      // let itemsListingQS = { collectionId: props.nftDetail.collectionId };\n      // itemsListingQS = ENV.objectToQueryString(itemsListingQS);\n      // props.getItemsListing(itemsListingQS);\n\n      //get offers\n      if (props.nftDetail.sellingMethod) {\n        if (props.nftDetail.sellingMethod === 1) {\n          let qs = { nftId: props.nftDetail._id };\n          qs = ENV.objectToQueryString(qs);\n          props.getOffers(qs);\n        } else {\n          let qs = { nftId: props.nftDetail._id };\n          qs = ENV.objectToQueryString(qs);\n          props.getBids(qs);\n        }\n      }\n      // //get bids\n      // if (nftDetail?.sellingMethod === 2) {\n      //   let nftBidsQs = { nftId };\n      //   nftBidsQs = ENV.objectToQueryString(nftBidsQs);\n      //   props.getBidSByNftId(nftBidsQs);\n      // }\n\n      //set next bid to 5% greater\n      let fivePerc = \"\";\n      if (\n        props.nftDetail.highestBid === 0 ||\n        props.nftDetail.highestBid === undefined\n      ) {\n        fivePerc = (5 / 100) * props.nftDetail.currentPrice;\n        fivePerc = fivePerc + props.nftDetail.currentPrice;\n      } else {\n        fivePerc = (5 / 100) * props.nftDetail.highestBid;\n        fivePerc = fivePerc + props.nftDetail.highestBid;\n      }\n      let result = fivePerc.toString().slice(0, 8);\n\n      setPrice(result);\n      validateIfLiked(likedNfts, props.nftDetail);\n      props.beforeNFTByCollection();\n      props.getNFTsByCollection(props.nftDetail.collectionId);\n    }\n  }, [props.nftsAuth]);\n\n  useEffect(() => {\n    if (props.nftsByCollectionStatus) {\n      let moreCollection = [];\n      if (props.nftsByCollection && props.nftsByCollection?.length) {\n        moreCollection = props.nftsByCollection.filter(\n          (item) => item._id !== nftDetail._id\n        );\n      }\n      setNFTs(moreCollection);\n      setLoader(false);\n    }\n  }, [props.nftsByCollectionStatus]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  useEffect(() => {\n    if (props.activitiesAuth) {\n      setActivities(props.activities);\n    }\n  }, [props.activitiesAuth]);\n  // useEffect(() => {\n  //   if (props.itemsListingAuth) {\n  //     setItemsListing(props.itemsListing);\n  //   }\n  // }, [props.itemsListingAuth]);\n\n  const handleRouting = async () => {\n    if (await validateNetwork()) {\n      if (\n        ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId &&\n        nftDetail.sellingMethod === 2\n      ) {\n        EndAuction();\n      } else if (ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId) {\n        history.push({\n          pathname: `/sell-item/${nftDetail._id}`,\n          state: nftDetail,\n        });\n      } else if (nftDetail.sellingMethod === 2) {\n        setBidModalShow(true);\n      } else if (nftDetail.sellingMethod === 1) {\n        setModalShow(true);\n      } else {\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  //toggleLikes\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const handleLikesTogleApi = async (nftId, status) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        setToggle(!toggle);\n\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let data = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if ((status === \"dislike\") & (nftDetail.likesCount > 0)) {\n          let nft = nftDetail;\n          nft.likesCount = nft.likesCount - 1;\n\n          setNftDetail(nft);\n          props.toggleLikeDislike(data);\n        } else {\n          let nft = nftDetail;\n          nft.likesCount = nft.likesCount + 1;\n\n          setNftDetail(nft);\n\n          props.toggleLikeDislike(data);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const handleCollectionLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n  const increOrDecreLikes = (id, status) => {\n    let updatedNfts = [];\n    if (status === \"dec\") {\n      updatedNfts = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(updatedNfts);\n    } else {\n      let updatedNfts = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(updatedNfts);\n    }\n  };\n\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      return setToggle(false);\n    }\n  };\n\n  const calculatePricePercantage = () => {\n    let fivePerc = \"\";\n    let result = \"\";\n    if (nftDetail.highestBid === 0 || nftDetail.highestBid === undefined) {\n      fivePerc = (5 / 100) * nftDetail.currentPrice;\n\n      result = fivePerc + nftDetail.currentPrice;\n\n      return result;\n    } else {\n      fivePerc = (5 / 100) * nftDetail.highestBid;\n      result = fivePerc + nftDetail.highestBid;\n      return result.toString().slice(0, 8);\n    }\n  };\n\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const onChange = (e) => {\n    let result = e.target.value.slice(0, 8);\n\n    setPrice(result);\n  };\n  const handleModalSubmit = async () => {\n    if (await validateNetwork()) {\n      setLoader(true);\n\n      if (nftDetail.sellingMethod === 2) {\n        placeBid();\n      } else {\n        makeOffer();\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n  const placeBid = async () => {\n    if (await validateNetwork()) {\n      try {\n        let result = await placeABid(price, nftDetail.sellId);\n        if (result) {\n          const payload = {\n            ownerId: nftDetail.ownerId,\n            bidAmount: price,\n            nftId: nftDetail._id,\n            bidBy: ENV.getUserKeys(\"_id\")._id,\n            isAccepted: false,\n            toAddress: nftDetail.ownerAddress,\n            fromAddress: await connectMetamask(),\n          };\n          props.beforeBid();\n          props.placeBid(payload);\n          createActivity(\"Bid\", price);\n        }\n      } catch (err) {\n        setLoader(false);\n\n        toast.error(err);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const makeOffer = async () => {\n    setLoader(true);\n    try {\n      let result = true;\n      if (result) {\n        const payload = {\n          toAddress: nftDetail.ownerAddress,\n          fromAddress: await connectMetamask(),\n          offerBy: ENV.getUserKeys(\"_id\")._id,\n          ownerId: nftDetail.ownerId,\n          nftId: nftDetail._id,\n          price: price,\n          // expiryDate: nftConfig.expiry.datetime,\n          isAccepted: false,\n          isExpired: false,\n        };\n\n        props.makeOffer(payload);\n      }\n    } catch (err) {\n      setLoader(false);\n\n      toast.error(err);\n    }\n  };\n  const getPercentageChange = (oldNumber, newNumber) => {\n    var decreaseValue = oldNumber - newNumber;\n\n    return (decreaseValue / oldNumber) * 100;\n  };\n\n  const deleteBid = (id) => {\n    let result = bids.filter((bid) => bid._id !== id);\n    setBids(result);\n    props.deleteBid(id);\n    createActivity(\"Cancel Bid\");\n  };\n\n  const auctionEndTimeConversion = (auctionEndDate) => {\n    var dateString = moment(new Date(auctionEndDate))\n      .utc(true)\n      .format(\"MMMM D, Y\");\n    var timeString = moment(new Date(auctionEndDate)).utc(true).format(\"h:mma\");\n    var totalDateTime = dateString + \" at \" + timeString + \" PKT\";\n    return totalDateTime;\n  };\n\n  const BuyNow = async () => {\n    if (await validateNetwork()) {\n      setDisabled(true);\n      try {    \n        let  currentPrice = nftDetail.currentPrice;\n        let  nftToken = nftDetail.sellId;\n        \n        const result = await BuyFixedPriceNFT(\n          currentPrice,\n          nftToken,\n          setConfirmed,\n          setTransactionHash\n        );\n        if (result) {\n          let ownerAddress = await getWalletAddress();\n          let payload = {\n            userId,\n            nftId,\n            ownerAddress,\n          };\n          props.beforeOffer();\n          props.buyNow(payload);\n          createActivity(\"Transfer\", false, ownerAddress);\n        }\n      } catch (err) {\n        setDisabled(false);\n        toast.error(err);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const createActivity = async (type, bidPrice, address) => {\n    const { _id, ownerId, ownerAddress, currentPrice } = nftDetail;\n    let price = \"\";\n    let toAddress = \"\";\n    if (bidPrice) {\n      price = bidPrice;\n    } else {\n      price = currentPrice;\n    }\n\n    if (type === \"Transfer\" || type === \"Bid\") {\n      toAddress = address;\n    }\n\n    let activityPayload = {\n      nftId: _id,\n      ownerId,\n      fromAddress:\n        type === \"Transfer\" ? ownerAddress : await getWalletAddress(),\n      activityType: type,\n      toAddress,\n      price: price,\n    };\n    props.createActivity(activityPayload);\n  };\n  const handleAcitivityIcon = (type) => {\n    if (type === \"Mint\") {\n      return <MdShoppingCart />;\n    } else if (type === \"List\") {\n      return <BsTagFill />;\n    } else if (type === \"Bid\") {\n      return <FaHandPaper />;\n    } else {\n      return <BiTransferAlt />;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    //check if i am owner\n    if (\n      ENV.getUserKeys(\"_id\")._id == nftDetail.ownerId ||\n      nftDetail.sellingMethod === 1\n    ) {\n      return true;\n    }\n    if (startDate && endDate && nftDetail.sellingMethod) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n      if (currentDate > auctionStartDate && currentDate < auctionEndDate) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionIsStarted = (startDate, endDate) => {\n    let currentDate = new Date();\n    let auctionStartDate = new Date(startDate);\n    let auctionEndDate = new Date(endDate);\n    if (currentDate < auctionStartDate) {\n      return \"Sale will start on \" + auctionEndTimeConversion(auctionStartDate);\n    } else {\n      return \"Sale ends \" + auctionEndTimeConversion(auctionEndDate);\n    }\n  };\n\n  useEffect(() => {\n    const interval = setInterval(() => {\n      checkIfAuctionEnded();\n    }, 3000);\n    return () => clearInterval(interval);\n  }, [nftDetail, initial]);\n\n  const checkIfAuctionEnded = async () => {\n    if (nftDetail && nftDetail?.sellingMethod === 2) {\n      let auctionEndDate = new Date(nftDetail.auctionEndDate);\n      let currentDate = new Date();\n      if (currentDate > auctionEndDate) {\n        if (!initial) {\n          let qs = { nftId: nftDetail._id };\n          qs = ENV.objectToQueryString(qs);\n          let url = `${ENV.url}bid/list`;\n          url += `?${qs}`;\n          let res = await axios.get(url);\n          let newBids = res.data.data.Bids;\n          if (!initial) {\n            setInitial(true);\n          }\n\n          if (newBids?.length > 0) {\n            let highestBidByUser = newBids.reduce((max, obj) =>\n              max.bidAmount > obj.bidAmount ? max : obj\n            );\n            if (highestBidByUser.bidBy === userId) {\n              if (!claimNFT) {\n                setClaimNFT(true);\n              }\n            }\n          }\n        }\n      }\n    }\n  };\n\n  const EndAuction = async () => {\n    const { ownerId, sellingMethod } = nftDetail;\n    try {\n      setLoader(true);\n      if (userId == ownerId && sellingMethod == 2) {\n        let result = await endAuctionFromContract(nftDetail.sellId);\n        if (result) {\n          EndAuctionFromBackend();\n        }\n      } else {\n        let result = await claimNFTfromContract(nftDetail.sellId);\n        if (result) {\n          EndAuctionFromBackend();\n        }\n      }\n    } catch (err) {\n      toast.error(err.message);\n      setLoader(false);\n    }\n  };\n  const EndAuctionFromBackend = async () => {\n    let res = await axios.post(`${ENV.url}nfts/endAuction`, {\n      nft: nftDetail,\n    });\n    if (res.data.success) {\n      if (userId == ownerId) {\n        toast.success(res.data.message);\n      } else {\n        toast.success(\"You have purchased NFT successfully\");\n      }\n      history.push(\"/userprofile\");\n    }\n  };\n\n  const {\n    name,\n    copies,\n    remainingCopies,\n    sellingMethod,\n    properties,\n    levels,\n    stats,\n    nftToken,\n    lowestNftPrice,\n    fileType,\n    image,\n    user,\n    ownerId,\n    auctionStartDate,\n    auctionEndDate,\n    description,\n    currentPrice,\n  } = nftDetail;\n\n  const bannerData = {\n    subHeading: \"NFT\",\n    heading: \"NFT Details\",\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n\n  let nftInfo = [\n    {\n      title: \"Contract Address\",\n      value:\n        ENV.mintsClubContractAddress.slice(0, 6) +\n        \"....\" +\n        ENV.mintsClubContractAddress.slice(-6),\n    },\n    {\n      title: \"Token ID\",\n      value: nftToken,\n    },\n    {\n      title: \"Token Standard\",\n      value: \"ERC-1155\",\n    },\n    {\n      title: \"Blockchain\",\n      value: \"Ethereum\",\n    },\n  ];\n\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      {loader && <FullPageLoader />}\n\n      <div className=\"new-nft-detail padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-lg-4 col-xl-3 order-1 order-lg-0 d-none d-lg-block\">\n              <div className=\"detail-box\">\n                <h6>Properties</h6>\n                <hr />\n                {properties && properties.length > 0 ? (\n                  properties.map((detail, i) => {\n                    return (\n                      <div\n                        className=\"detail-rounded-type d-flex align-items-center\"\n                        key={i}\n                      >\n                        <div className=\"detail-rounded-name\">\n                          <p>{detail.name}:</p>\n                        </div>\n                        <div className=\"detail-content\">\n                          <p>{detail.type}</p>\n                        </div>\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center\">No Properties Foud</p>\n                )}\n              </div>\n              <div className=\"detail-box\">\n                <h6>Stats</h6>\n                <hr />\n                <div>\n                  {stats && stats?.length > 0 ? (\n                    stats.map((item) => {\n                      return <StatsInfo name={item.name} value={item.value} />;\n                    })\n                  ) : (\n                    <p className=\"text-center\">No Stats Foud</p>\n                  )}\n                </div>\n              </div>\n              <div className=\"detail-box\">\n                <h6>Levels</h6>\n                <hr />\n                <div>\n                  {levels && levels.length > 0 ? (\n                    levels.map((item) => {\n                      return <LevelsInfo name={item.name} value={item.value} />;\n                    })\n                  ) : (\n                    <p className=\" text-center\">No Levels Foud</p>\n                  )}\n                </div>\n              </div>\n              <div className=\"detail-box\">\n                <h6>Details</h6>\n                <hr />\n                {nftInfo.map((item) => {\n                  return (\n                    <div\n                      className={`detail-rounded-type d-flex align-items-center ${\n                        item.title === \"Contract Address\"\n                          ? \"text-highlighted\"\n                          : \"\"\n                      }`}\n                      onClick={() => {\n                        item.title === \"Contract Address\" &&\n                          window.open(\n                            \"https://rinkeby.etherscan.io/address/0x328106925e0e5721725ec92fc256b7e6cbdd8e43\",\n                            \"_blank\"\n                          );\n                      }}\n                    >\n                      <div className={`detail-rounded-name `}>\n                        <p>{item.title}:</p>\n                      </div>\n                      <div className={`detail-content`}>\n                        <p> {item.value}</p>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n\n            <div className=\"col-lg-8 col-xl-9 order-0 order-lg-1\">\n              <div className=\"row g-4 g-lg-5 g-xl-4\">\n                <div className=\"col-xl-6\">\n                  {fileType === \"image\" ? (\n                    <div className=\"nft-img-container mx-auto mx-lg-0\">\n                      <div\n                        style={{\n                          display: `${contentLoader ? \"block\" : \"none\"}`,\n                        }}\n                      >\n                        <NFTDetailLoader />\n                      </div>\n                      <img\n                        src={image}\n                        alt=\"nft-image\"\n                        onLoad={() => setContentLoader(false)}\n                        style={{\n                          display: `${!contentLoader ? \"block\" : \"none\"}`,\n                        }}\n                      />\n                    </div>\n                  ) : fileType === \"video\" ? (\n                    <div className=\"nft-img-container nft-video-container mx-auto mx-lg-0\">\n                      <div\n                        style={{\n                          display: `${contentLoader ? \"block\" : \"none\"}`,\n                        }}\n                      >\n                        <NFTDetailLoader />\n                      </div>\n                      <video\n                        src={image}\n                        ref={videoElement}\n                        onEnded={() => {\n                          togglePlay();\n                        }}\n                        onCanPlay={() => {\n                          setContentLoader(false);\n                        }}\n                        onTimeUpdate={handleOnTimeUpdate}\n                        style={{\n                          display: `${!contentLoader ? \"block\" : \"none\"}`,\n                        }}\n                      />\n                      <div className=\"controls\">\n                        <div className=\"actions\">\n                          <button\n                            className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                            onClick={togglePlay}\n                          >\n                            {playerState.isPlaying ? (\n                              <BsFillPauseFill />\n                            ) : (\n                              <BsFillPlayFill />\n                            )}\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  ) : fileType === \"audio\" ? (\n                    <>\n                      <div\n                        style={{\n                          display: `${contentLoader ? \"block\" : \"none\"}`,\n                        }}\n                      >\n                        <NFTDetailLoader />\n                      </div>\n                      <Audio\n                        src={image}\n                        onLoadCallback={() => setContentLoader(false)}\n                        loader={contentLoader}\n                      />\n\n                      {/* <Waveform\n                        url={image}\n                        auction={false}\n                        onLoadCallback={() => setLoader(false)}\n                        loader={contentLoader}\n                      /> */}\n                    </>\n                  ) : (\n                    \"\"\n                  )}\n                </div>\n                <div className=\"col-xl-6\">\n                  <div className=\"nft-img-detail\">\n                    <h5>NFT Details:</h5>\n                  </div>\n                  <div className=\"nft-img-detail-box\">\n                    <div className=\"nft-detail-rounded-box\">\n                      <p>\n                        {name && name.length > 30\n                          ? name.slice(0, 30) + \"...\"\n                          : name}\n                      </p>\n                    </div>\n                    <div className=\"row g-2 g-sm-4\">\n                      <div className=\"col-6 col-sm-4 col-xl-6 col-xxl-4\">\n                        <div className=\"nft-detail-rounded-box\">\n                          <p>\n                            Total Copies: <span>{copies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-xl-6 col-xxl-4\">\n                        <div className=\"nft-detail-rounded-box\">\n                          <p>\n                            Sold: <span>{copies - remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-xl-6 col-xxl-4\">\n                        <div className=\"nft-detail-rounded-box\">\n                          <p>\n                            Remaining: <span>{remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"nft-detail-price d-flex align-items-center  mb-3\">\n                      <div className=\"d-flex align-items-center me-2\">\n                        <img src={Images.onsale} className=\"me-3\" />\n                        <h2>{currentPrice}</h2>\n                      </div>\n                      <div className=\"price-in-dollar\">\n                        <p> ($ {(currentPrice * exchangeRate).toFixed(2)})</p>\n                      </div>\n                    </div>\n                    <div className=\"nft-detail-rounded-box on-sale\">\n                      <p>\n                        Copies On Sale:{\" \"}\n                        <span>\n                          {\" \"}\n                          {nftDetail?.copiesForAuction\n                            ? nftDetail?.copiesForAuction\n                            : 0}\n                        </span>\n                      </p>\n                    </div>\n                    <div className=\"nft-detail-date d-flex align-items-center\">\n                      <p>\n                        {sellingMethod === 2 && (\n                          <>\n                            {auctionEndDate &&\n                              checkIfAuctionStartedorEnded(\n                                auctionStartDate,\n                                auctionEndDate\n                              ) && (\n                                <>\n                                  <img\n                                    src={Images.ClockIcon}\n                                    alt=\"clock-icon\"\n                                    className=\"me-1\"\n                                  />\n                                  <span>\n                                    {checkIfAuctionIsStarted(\n                                      auctionStartDate,\n                                      auctionEndDate\n                                    )}{\" \"}\n                                    {/* {auctionEndTimeConversion(\n                                      new Date(auctionEndDate)\n                                    )}{\" \"} */}\n                                  </span>\n                                </>\n                              )}\n                          </>\n                        )}\n                      </p>\n                    </div>\n                  </div>\n                  <div className=\"nft-detail-owner d-flex align-items-center\">\n                    <img\n                      src={\n                        user?.profileImage\n                          ? user?.profileImage\n                          : Images.placeholderImg\n                      }\n                      alt=\"avatar\"\n                      className=\"me-2\"\n                    />\n                    <p>\n                      Owned by:\n                      <span className=\"text-capitalize ms-1\">\n                        {\" \"}\n                        {ownerId === userId\n                          ? \"You\"\n                          : user?.username\n                          ? user.username\n                          : \"unnamed\"}\n                      </span>\n                    </p>\n                  </div>\n                  <div className=\"nft-detail-btn\">\n                    {checkIfAuctionStartedorEnded(\n                      auctionStartDate,\n                      auctionEndDate\n                    ) &&\n                      !claimNFT && (\n                        <button\n                          // disabled={disabled}\n                          onClick={() => handleRouting()}\n                        >\n                          {\" \"}\n                          {userId == ownerId && sellingMethod == 2\n                            ? \"End Auction\"\n                            : userId == ownerId && sellingMethod == 1\n                            ? \"Resale\"\n                            : userId == ownerId\n                            ? \"Sell\"\n                            : sellingMethod === 2\n                            ? \"Place A Bid\"\n                            : sellingMethod === 1\n                            ? \"Buy Now\"\n                            : \"\"}\n                        </button>\n                      )}\n\n                    {claimNFT && (\n                      <button onClick={() => EndAuction()}>\n                        {\"Claim NFT\"}\n                      </button>\n                    )}\n                  </div>\n                </div>\n                <div className=\"col-12 d-block d-lg-none\">\n                  <div className=\"detail-box\">\n                    <h6>Properties</h6>\n                    <hr />\n                    {properties && properties.length > 0 ? (\n                      properties.map((detail, key) => {\n                        return (\n                          <div\n                            className=\"detail-rounded-type d-flex align-items-center\"\n                            key={key}\n                          >\n                            <div className=\"detail-rounded-name\">\n                              <p>{detail.name}:</p>\n                            </div>\n                            <div className=\"detail-content\">\n                              <p>{detail.type}</p>\n                            </div>\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-center\">No Properties Foud</p>\n                    )}\n                  </div>\n                  <div className=\"detail-box\">\n                    <h6>Stats</h6>\n                    <hr />\n                    {stats && stats?.length > 0 ? (\n                      stats.map((item) => {\n                        return (\n                          <StatsInfo name={item.name} value={item.value} />\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-center\">No Stats Foud</p>\n                    )}\n                  </div>\n\n                  <div className=\"detail-box\">\n                    <h6>Levels</h6>\n                    <hr />\n                    <div>\n                      {levels && levels.length > 0 ? (\n                        levels.map((item, i) => {\n                          return (\n                            <LevelsInfo\n                              name={item.name}\n                              value={item.value}\n                              i={i}\n                            />\n                          );\n                        })\n                      ) : (\n                        <p className=\"text-center\">No Levels Foud</p>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"detail-box\">\n                    <h6>Details</h6>\n                    <hr />\n                    {nftInfo.map((detail, i) => {\n                      return (\n                        <div\n                          className=\"detail-rounded-type d-flex align-items-center\"\n                          key={i}\n                        >\n                          <div className=\"detail-rounded-name\">\n                            <p>{detail.title}:</p>\n                          </div>\n                          <div className=\"detail-content\">\n                            <p>{detail.value}</p>\n                          </div>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n                <div className=\"col-12 mt-lg-5\">\n                  <div className=\"detail-bg-box\">\n                    <h5>Descriptions:</h5>\n                    <hr />\n                    <p>{description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12\">\n                  <div className=\"detail-bg-box\">\n                    <h5>Offers:</h5>\n                    <hr />\n                    <div className=\"table-container\">\n                      <table className=\"table table-borderless\">\n                        {sellingMethod === 2 && bids && bids.length > 0 && (\n                          <thead>\n                            <tr>\n                              <th scope=\"col\">Price</th>\n                              <th scope=\"col\">USD Price</th>\n                              <th scope=\"col\">Floor Difference</th>\n\n                              <th scope=\"col\">From</th>\n                            </tr>\n                          </thead>\n                        )}\n                        <tbody>\n                          {sellingMethod === 2 && bids && bids.length > 0 ? (\n                            <>\n                              {bids.map((bid, index) => {\n                                return (\n                                  <tr key={index}>\n                                    <th scope=\"row\">{bid.bidAmount}</th>\n                                    <td>\n                                      $\n                                      {(bid.bidAmount * exchangeRate).toFixed(\n                                        2\n                                      )}\n                                    </td>\n                                    <td>\n                                      {getPercentageChange(\n                                        bid.bidAmount,\n                                        lowestNftPrice\n                                      ).toFixed(0)}\n                                      %{\" \"}\n                                      {bid.bidAmount > lowestNftPrice\n                                        ? \"above\"\n                                        : \"below\"}\n                                    </td>\n                                    <td>\n                                      {bid.fromAddress.slice(0, 4) +\n                                        \"...\" +\n                                        bid.fromAddress.slice(-4)}\n                                    </td>\n                                  </tr>\n                                );\n                              })}\n                            </>\n                          ) : (\n                            <p className=\"text-center d-flex justify-content-center align-items-center\">\n                              No Offers Found\n                            </p>\n                          )}\n                        </tbody>\n                      </table>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12\">\n                  <div className=\"detail-bg-box\">\n                    <h5>Activity:</h5>\n                    <hr />\n                    <div className=\"table-container\">\n                      {activities && activities.length > 0 ? (\n                        <table className=\"table table-borderless\">\n                          <thead>\n                            <tr>\n                              <th scope=\"col\">Event</th>\n                              <th scope=\"col\">Price</th>\n                              <th scope=\"col\">From</th>\n                              <th scope=\"col\">To</th>\n                              <th scope=\"col\">Date</th>\n                            </tr>\n                          </thead>\n                          <tbody>\n                            {activities.map((activity, index) => {\n                              return (\n                                <tr>\n                                  <th scope=\"row\" key={index}>\n                                    <div className=\"d-flex align-items-center\">\n                                      {handleAcitivityIcon(\n                                        activity.activityType\n                                      )}\n                                      <p className=\"ps-1\">\n                                        {\" \"}\n                                        {activity.activityType}{\" \"}\n                                      </p>\n                                    </div>\n                                  </th>\n                                  <td>\n                                    {activity.price ? activity.price : \"\"}\n                                  </td>\n                                  <td>\n                                    {activity.fromAddress\n                                      ? activity.fromAddress.slice(0, 4) +\n                                        \"...\" +\n                                        activity.fromAddress.slice(-6)\n                                      : \"null address\"}\n                                  </td>\n                                  <td>\n                                    {activity.toAddress\n                                      ? activity.toAddress.slice(0, 4) +\n                                      \"...\" +\n                                      activity.toAddress.slice(-4)\n                                      : \"\"}{\" \"}\n                                  </td>\n                                  <td>\n                                    <div>\n                                      <ReactTimeAgo\n                                        date={activity.createdAt}\n                                        locale=\"en-US\"\n                                      />\n                                    </div>\n                                  </td>\n                                </tr>\n                              );\n                            })}\n                          </tbody>\n                        </table>\n                      ) : (\n                        <p className=\"text-white d-flex align-items-center justify-content-center w-100 h-100\">\n                          No Activities Found\n                        </p>\n                      )}\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 order-2 mt-5\">\n              <div className=\"detail-more-collection\">\n                <h6>More from this collection</h6>\n              </div>\n              <div className=\"row align-items-center g-3\">\n                {nfts && nfts.length > 0 ? (\n                  nfts.map((nft, id) => {\n                    if (id <= 3) {\n                      return (\n                        <div\n                          className=\"col-10 col-sm-6 col-md-4 col-lg-3 px-1\"\n                          key={id}\n                        >\n                          {\n                            <NftCard\n                              data={nft}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              likedNfts={likedNfts}\n                              owner={nft?.owner[0]}\n                              path=\"/explore/nftdetail/\"\n                            />\n                          }\n                        </div>\n                      );\n                    }\n                  })\n                ) : (\n                  <p className=\"text-center mt-4\">No NFTs Found</p>\n                )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <OwnCollectionToday />\n      <BuyModal\n        show={modalShow}\n        onHide={() => {\n          setModalShow(false);\n          // setConfirmed(false);\n          // setModal(1);\n          // setTransactionSuccess(false);\n        }}\n        name={name}\n        price={currentPrice}\n        image={image}\n        exchangeRate={exchangeRate}\n        tokenId={nftToken}\n        modal={modal}\n        setModal={setModal}\n        buyNow={BuyNow}\n        confirmed={confirmed}\n        transactionHash={transactionHash}\n        transactionSuccess={transactionSuccess}\n        disabled={disabled}\n        balance={balance}\n        fileType={fileType}\n      />\n      <BuyModal\n        show={modalShow1}\n        onHide={() => {\n          setModalShow1(false);\n          // setConfirmed(false);\n          // setModal(1);\n          // setTransactionSuccess(false);\n        }}\n        name={listedItem.name}\n        price={listedItem.currentPrice}\n        image={listedItem.image}\n        exchangeRate={exchangeRate}\n        tokenId={listedItem.nftToken}\n        modal={modal}\n        setModal={setModal}\n        buyNow={BuyNow}\n        confirmed={confirmed}\n        transactionHash={transactionHash}\n        transactionSuccess={transactionSuccess}\n        disabled={disabled}\n        balance={balance}\n        fileType={fileType}\n      />\n      <BidModal\n        show={bidModalShow}\n        calculatePricePercantage={calculatePricePercantage}\n        handleModalSubmit={handleModalSubmit}\n        onChange={onChange}\n        decimalNumberValidator={decimalNumberValidator}\n        balance={balance}\n        price={price}\n        onHide={() => setBidModalShow(false)}\n      />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nftDetail: state.nft.nftsData,\n  nftsAuth: state.nft.nftsAuth,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  activities: state.nft.itemActivities,\n  activitiesAuth: state.nft.activitiesAuth,\n  itemsListing: state.nft.itemsListing,\n  itemsListingAuth: state.nft.itemsListingAuth,\n  createAuth: state.bid.createAuth,\n  createAuthOffer: state.offer.createAuth,\n  buyAuth: state.offer.buyAuth,\n  getAuth: state.bid.getAuth,\n  getAuthOffer: state.offer.getAuth,\n  offers: state.offer.offers,\n  bids: state.bid.bids,\n  bidsByNft: state.bid.bidsByNft,\n  bidsByNftAuth: state.bid.bidsBYNftAuth,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFT,\n  beforeNFT,\n  getNFTsByCollection,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  placeBid,\n  getBids,\n  getBidSByNftId,\n  beforeBid,\n  deleteBid,\n  beforeTogleLikeDislike,\n  makeOffer,\n  beforeOffer,\n  getOffers,\n  deleteOffer,\n  buyNow,\n  createActivity,\n  getActivities,\n  getItemsListing,\n  beforeNFTByCollection,\n})(NFTDetail);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["551","552","553","554","555","556","557","558","559","560","561","562"],"import React, { useEffect, useState } from \"react\";\n\nimport \"./user-edit-profile.css\";\n\n/////////\n\nimport { connect } from \"react-redux\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { ENV } from \"./../../config/config\";\nimport { Images } from \"../../assets/assets\";\nimport { useHistory } from \"react-router-dom\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport Compressor from \"compressorjs\";\nconst EditProfile = (props) => {\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n  \n  useEffect(() => {\n    if (props.error !== null) {\n      setLoader(false);\n      toast.error(props.error.messasge);\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      props.beforeUser();\n      setLoader(false);\n\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      setImage(profileImage ? profileImage : \"\");\n      setBannerImage(bannerImage ? bannerImage : \"\");\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      setLoader(false);\n      props.beforeUser();\n      toast.success(\"Profile updated successfully\");\n      history.push(\"/userprofile\");\n    }\n  }, [props.user.userAuth]);\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    let sizeBeforeCompress = formatBytes(file.size);\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n        return toast.error(\"Invalid File\");\n      }\n      setImageUrl(fileURL);\n      // setImage(file);\n\n      new Compressor(file, {\n        quality: 0.2,\n        success(result) {\n          setImage(result);\n\n          let sizeAfterCompress = formatBytes(result.size);\n        },\n        error(err) {\n          console.log(err.message);\n        },\n      });\n    }\n  };\n  const formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n\n \n    setErrors(\"\");\n    setLoader(true);\n    // let signature = await signRequest();\n    setLoader(true);\n\n    var formData = new FormData();\n    formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n    if (image) {\n      formData.append(\"profileImage\", image);\n    }\n    if (banner) {\n      formData.append(\"bannerImage\", banner);\n    }\n    formData.append(\"bio\", description);\n    formData.append(\"twitterLink\", twitterLink);\n    formData.append(\"username\", username);\n    formData.append(\"email\", email);\n    formData.append(\"webLink\", webLink);\n    formData.append(\"instaLink\", instaLink);\n\n    // return ''\n    props.updateProfile(formData);\n  };\n  const bannerData = {\n    subHeading: \"Information\",\n    heading: \"User Profile\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile padding-wrapper pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        {loader && <FullPageLoader />}\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <form onSubmit={submit}>\n              <div className=\"row\">\n                <div className=\"col-12 mt-5\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {image && image ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={imageUrl ? imageUrl : Images.logoImage}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={imageUrl ? imageUrl : Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">\n                      Profile Image*\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Username:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    required\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && username === \"\") {\n                        return false;\n                      } else {\n                        setUsername(e.target.value);\n                      }\n                    }}\n                    value={username}\n                    placeholder=\"Username\"\n                    maxLength=\"55\"\n                    minLength=\"3\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">\n                    Email Address:*\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Email Address\"\n                    required\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && email === \"\") {\n                        return \"\";\n                      } else {\n                        setEmail(e.target.value);\n                      }\n                    }}\n                    value={email}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Wallet Address:\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"URL\"\n                    required\n                    readOnly={true}\n                    autoComplete=\"off\"\n                    value={address}\n                    disabled={true}\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">BioData:</label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Enter BioData\"\n                    maxLength=\"500\"\n                    minLength=\"3\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && description === \"\") {\n                        return false;\n                      } else {\n                        setDescription(e.target.value);\n                      }\n                    }}\n                    value={description}\n                  ></textarea>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Twitter Link:\n                  </label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && twitterLink === \"\") {\n                        return false;\n                      } else {\n                        setTwitterLink(e.target.value);\n                      }\n                    }}\n                    value={twitterLink}\n                    placeholder=\"Twitter Link\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0  mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Instagram Link:\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Instagram Link\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && instaLink === \"\") {\n                        return false;\n                      } else {\n                        setInstaLink(e.target.value);\n                      }\n                    }}\n                    value={instaLink}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0  mt-3 mt-lg-5 \">\n                  <label className=\"create-collection-label\">\n                    Website Link:\n                  </label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Website Link\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && webLink === \"\") {\n                        return false;\n                      } else {\n                        setWebLink(e.target.value);\n                      }\n                    }}\n                    value={webLink}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    type=\"submit\"\n                  >\n                    Save Changes\n                  </button>\n                </div>\n              </div>\n            </form>\n          </div>\n        </div>\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n  emptyError,\n})(EditProfile);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["563","564","565","566","567","568","569","570","571"],"import React, { useState, useEffect } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./UserProfile.css\";\nimport { ENV } from \"../../config/config\";\nimport {\n  getProfileNfts,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport { getUserById, beforeUser } from \"../user/user.action\";\nimport { Images } from \"../../assets/assets\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport moment from \"moment\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport EthIcon from \"../../assets/images/eth-icon.svg\";\nimport CopyIcon from \"../../assets/images/copy-icon.svg\";\nimport FilterComponent from \"../filterComponent/filterComponent\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst UserProfile = (props) => {\n  const [isAddressCopied, setAddressCopied] = useState(false);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [nftsCopy, setNFTsCopy] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [user, setUser] = useState(\"\");\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const [copy, setCopy] = useState(false);\n  const [collections, setCollections] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [dataLimit, setDataLimit] = useState(10);\n  const [menuFilter, setMenuFilter] = useState(false);\n  const userId = ENV.getUserKeys(\"_id\")._id;\n\n  useEffect(() => {\n    const {\n      getProfileNfts,\n      getMyLikedNfts,\n      beforeUser,\n      getUserById,\n      getCollections,\n    } = props;\n    let searchQs = { page: 1, limit: 99999 };\n    searchQs = ENV.objectToQueryString(searchQs);\n    getProfileNfts(searchQs);\n    let likedNftsQs = { userId };\n    likedNftsQs = ENV.objectToQueryString(likedNftsQs);\n    getMyLikedNfts(likedNftsQs);\n    beforeUser();\n    getUserById(ENV.getUserKeys(\"_id\")._id);\n    getCollections();\n  }, []);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      let myCollections = props.collections.filter(\n        (item) => item.userId === userId\n      );\n      setCollections(myCollections);\n      props.beforeCollection();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    const { profileNFTsStatus, profileNFTs } = props;\n    if (profileNFTsStatus) {\n      const data = profileNFTs.nfts;\n      if (!menuFilter) {\n        const Nfts = data?.filter((item) => item.ownerId === userId);\n        if (Nfts?.length > 0) {\n          setDisabled(false);\n        } else {\n          if (initial) {\n            setDisabled(true);\n          }\n        }\n        setNFTs(Nfts);\n        setNFTPagination({ total: Nfts?.length });\n      } else {\n        setNFTPagination(data.length);\n        handleNftFilter(menuFilter, data);\n      }\n      setInitial(false);\n      setNFTsCopy(data);\n      setLoader(false);\n      setFilterationLoader(false);\n    }\n  }, [props.profileNFTsStatus]);\n\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    const { individualUserAuth, individualUser } = props;\n    if (individualUserAuth) {\n      setUser(individualUser);\n    }\n  }, [props.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const ChangeTooltip = () =>\n    setTimeout(() => {\n      setAddressCopied(false);\n    }, 3000);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      nftQS = { page, limit: 99999 };\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    props.getProfileNfts(qs);\n  };\n\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n\n        let data = {\n          userId,\n          nftId,\n          count: 1,\n        };\n        if ((status === \"dislike\") & (likesCount > 0)) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n          props.toggleLikeDislike(data);\n        }\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(data);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  const handleNftFilter = (id, data = false) => {\n    let itemsToFilter = data ? data : nftsCopy;\n    setInitial(false);\n    if (id === \"Collected\") {\n      const Nfts = itemsToFilter.filter(\n        (item) => item.creatorId !== userId && item.ownerId === userId\n      );\n      setDataLimit(10);\n      setNFTPagination({ total: Nfts.length });\n      setNFTs(Nfts);\n    } else if (id === \"Created\") {\n      const Nfts = itemsToFilter.filter(\n        (item) => item.ownerId === userId && item.creatorId === userId\n      );\n\n      setDataLimit(10);\n      setNFTPagination({ total: Nfts.length });\n      setNFTs(Nfts);\n    } else {\n      handleFavFilter(itemsToFilter);\n    }\n  };\n\n  const handleFavFilter = (data = false) => {\n    let itemToFilter = data ? data : nftsCopy;\n    let favNfts = [];\n    for (var item of itemToFilter) {\n      let foundNft = likedNfts.find((liked) => liked.nftId === item._id);\n      if (foundNft) {\n        favNfts.push(item);\n      }\n    }\n    setDataLimit(10);\n    setNFTPagination({ total: favNfts.length });\n    setNFTs(favNfts);\n  };\n\n  const fetchData = (filterObj) => {\n    getNFTs(filterObj);\n  };\n  const getPaginatedData = () => {\n    setDataLimit((prev) => prev + 10);\n  };\n\n  const bannerData = {\n    subHeading: \"Information\",\n    heading: \"User Profile\",\n  };\n  const menuData = [\"Collected\", \"Created\", \"Favourited\"];\n  return (\n    <>\n      <section className=\"user-profile pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"d-flex flex-column flex-md-row align-items-center align-items-sm-start\">\n                  <div className=\"user-avatar-edit\">\n                    <div className=\"ms-lg-5 collection-owner-avatar user-avatar-container me-3\">\n                      <img\n                        src={\n                          user?.profileImage\n                            ? user.profileImage\n                            : Images.placeholderImg\n                        }\n                        alt=\"owner-avatar\"\n                      />\n                    </div>\n                    <Link to=\"/editprofile\" className=\"user-edit-icon\">\n                      <img src={Images.editIconSmall} />\n                    </Link>\n                  </div>\n                  <div className=\"collection-owner-detail text-center text-sm-start mt-4\">\n                    {user && (\n                      <div className=\"collection-owner-name\">\n                        <h3>{user.username ? user.username : \"unnamed\"}</h3>\n                      </div>\n                    )}\n\n                    <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n                      {user.address && (\n                        <div className=\"user-address mt-2 d-flex  align-items-center \">\n                          <span className={`${copy ? \"d-block\" : \"d-none\"}`}>\n                            {isAddressCopied ? \"Copied\" : \"Copy\"}\n                          </span>\n                          {user && (\n                            <>\n                              <img\n                                src={EthIcon}\n                                alt=\"eth-icon\"\n                                className=\"me-1\"\n                              />\n\n                              <p className=\"acc-adress d-none d-md-block\">\n                                {user.address}\n                              </p>\n                              <p className=\"acc-address d-md-none\">\n                                {user.address.slice(0, 10) +\n                                  \"...\" +\n                                  user.address.slice(-10)}\n                              </p>\n\n                              <img\n                                onMouseLeave={() => {\n                                  setCopy(false);\n                                }}\n                                onMouseOver={() => {\n                                  setCopy(true);\n                                }}\n                                onClick={() => {\n                                  navigator.clipboard.writeText(user.address);\n                                  setAddressCopied(true);\n                                  ChangeTooltip();\n                                }}\n                                src={CopyIcon}\n                                alt=\"copy-icon\"\n                                className=\"user-address-copy ms-4\"\n                              />\n                            </>\n                          )}\n                        </div>\n                      )}\n\n                      <div className=\"mt-2 mt-sm-0\">\n                        {user && (\n                          <p>\n                            Joined:{\" \"}\n                            <span>\n                              {moment(user.createdAt).format(\"MMMM DD YYYY\")}\n                            </span>\n                          </p>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <FilterComponent\n          collections={collections}\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts?.slice(0, dataLimit)}\n          loader={loader}\n          likedNfts={likedNfts}\n          handleLikesTogleApi={handleLikesTogleApi}\n          handleNftFilter={handleNftFilter}\n          nftPagination={nftPagination}\n          fetchData={fetchData}\n          setMenuFilter={setMenuFilter}\n          menuData={menuData}\n          path=\"/explore/nftdetail/\"\n          getPaginatedData={getPaginatedData}\n          UserProfile\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  profileNFTs: state.nft.profileNFTs,\n  profileNFTsStatus: state.nft.profileNFTsStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  individualUser: state.user.individualUser,\n  individualUserAuth: state.user.individualUserAuth,\n  togleLikeRes: state.explore.togleLikeRes,\n  collections: state.collection.collections,\n  getAuth: state.collection.getAuth,\n  nft: state.nft,\n});\n\nexport default connect(mapStateToProps, {\n  getProfileNfts,\n  getNFTs,\n  beforeNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  getUserById,\n  beforeUser,\n  beforeTogleLikeDislike,\n  getCollections,\n  beforeCollection,\n})(UserProfile);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["572","573","574"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card top-seller-card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller text-capitalize mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["575","576","577","578"],"import React, { useState, useEffect } from \"react\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport { connect } from \"react-redux\";\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\nimport { getCreators } from \"./../user/user.action\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst AuctionsList = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [auctions, setAuctions] = useState(null);\n  const [loader, setLoader] = useState(true); // auctions loader\n  const [categories, setCategories] = useState([]);\n  const [categoryId, setCategoryId] = useState(\"all\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    // get live auctions\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n    props.getCreators();\n  }, []);\n\n  // set live auctions\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions } = props.auction;\n\n      setAuctions(auctions);\n      setLoader(false);\n      props.beforeAuction();\n    }\n  }, [props.auction.auctionsAuth]);\n  useEffect(() => {\n    props.getCategories();\n  }, []);\n  useEffect(() => {\n    if (props.collectionFlag) {\n      setCategories(props.categories);\n    }\n  }, [props.collectionFlag]);\n\n  const handleCategoryFilter = (desc) => {\n    setLoader(true);\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getLiveAuctions(qs);\n  };\n  const bannerData = {\n    subHeading: \"Auctions\",\n    heading: \"Live Auctions\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      \n      <section className=\"explore-collection-section home-auction-list padding-wrapper\">\n        {\n          // loader ? (\n          //   <FullPageLoader />\n          // ) : (\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                            key={id}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <div className=\"col-6 col-sm-3\" key={id}>\n                            <button\n                              onClick={() => {\n                                setIsActive(id);\n                                handleCategoryFilter(item.description);\n                              }}\n                              className={`${\n                                id === isActive ? \"active-explore-nav\" : \"\"\n                              } me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          </div>\n                        );\n                      })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-3 align-items-center justify-content-center\">\n              {loader ? (\n                <div className=\"spinner-border\" role=\"status\"></div>\n              ) : auctions && auctions.length > 0 ? (\n                auctions.map((item, index) => {\n                  return (\n                    <div className=\"col-sm-6 col-md-4 col-xl-3\" key={index}>\n                      <AuctionsCards\n                        key={index}\n                        item={item}\n                        ownerName={item.owner.username}\n                        userId={ENV.getUserKeys(\"_id\")._id}\n                        ownerId={item.owner._id}\n                        bidsProfile={item.bidInfo.bidByProfile}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center mt-5\">No Live Auctions Found</p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {auctions &&\n                    props.auction.pagination.total > auctions.length &&\n                    auctions.length > 10 && (\n                      <button className=\"btn btn-linear-gradient px-5\">\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        }\n        <OwnCollectionToday />\n      </section>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  auction: state.auction,\n  user: state.user,\n  collectionFlag: state.collection.collectionFlag,\n  categories: state.collection.categories,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n  getCreators,\n  getCategories,\n  beforeCategory,\n})(AuctionsList);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["579","580","581","582","583","584","585","586","587","588"],"import React, { Component } from \"react\";\nimport Footer from \"../footer/footer\";\nimport \"./CreateCollections.css\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport Select from \"react-select\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        logoUrl: \"\",\n        bannerUrl: \"\",\n        featuredImgUrl: \"\",\n        description: \"\",\n      },\n      categories: null,\n      selectedCategory: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate(prevProps) {\n    if (this.props.error !== null && prevProps.error === null) {\n      toast.error(this.props.error.message);\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      let updatedCategories = [];\n      for (var item of categories) {\n        let obj = {\n          value: item._id,\n          label: item.name,\n        };\n        updatedCategories.push(obj);\n      }\n      this.setState({ categories: updatedCategories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let fileSize = this.formatBytes(file.size).split(\" \");\n        if (\n          (+fileSize[0] > 100 &&fileSize[1] === \"MB\") ||\n          fileSize[1] === \"GB\"\n        ) {\n          return toast.error(\"File Max Limit Reached.\");\n        }\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  handleSelectChange = (selectedOption) => {\n    let { collection } = this.state;\n    collection = { ...collection, categoryId: selectedOption.value };\n    this.setState({\n      selectedOption,\n      collection,\n    });\n  };\n  handleValidation = () => {\n    const { categoryId, logo, name, description, featuredImg } =\n      this.state.collection;\n    if (\n      description === \"\" ||\n      logo === \"\" ||\n      categoryId === \"\" ||\n      name === \"\" ||\n      featuredImg === \"\"\n    ) {\n      return true;\n    } else {\n      return false;\n    }\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: \"\", featuredImgUrl: \"\" };\n    this.setState({ collection });\n  };\n\n  render() {\n    const {\n      collection,\n      errors,\n      loader,\n      isSubmitted,\n      categories,\n      selectedOption,\n    } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      const bannerData = {\n        subHeading: \"Create New\",\n        heading: \"Create New Collection\",\n        content:\n          \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n      };\n      //create collection max size validation\n      return (\n        <>\n          {loader && <FullPageLoader />}\n          <section className=\"create-collection\">\n            <Banner\n              subHeading={bannerData.subHeading}\n              heading={bannerData.heading}\n              content={bannerData.content}\n              bgImg={BannerBg}\n              bannerImg={BannerImage}\n            />\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"upload-container flex-md-row flex-column align-items-center align-items-md-end ps-md-5 ps-0\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {collection && collection.logo ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={collection.logoUrl}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => this.onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => this.onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">Logo Image*</p>\n                  </div>\n                  <div className=\"feature-wrapper pt-md-0 pt-5\">\n                    <div className=\"feature-image\">\n                      <span className=\"feature-img-round\">\n                        {collection && collection.featuredImg ? (\n                          <img\n                            className=\"uploaded-feature-img\"\n                            src={collection.featuredImgUrl}\n                          />\n                        ) : (\n                          <label className=\"upload-icon\">\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                            <img src={Images.featureImageInputBG} />\n                            <div className=\"feature-img-round-info\">\n                              <p className=\"text-center mb-2 browse-file\">\n                                Browse Files\n                              </p>\n                              {/* <p className=\"mb-0\">PNG, GIF, WEBP, MP4, MP3 </p> */}\n                              <p className=\"text-center mb-0\">Max 100mb</p>\n                            </div>\n                          </label>\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-feature-icon\">\n                      <label>\n                        <input\n                          id=\"featuredImg\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          style={{ display: \"none\" }}\n                          name=\"featuredImg\"\n                          onChange={(e) => this.onFileChange(e)}\n                        />\n                        <img src={Images.editIconLarge} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2 text-center text-md-start\">\n                      Feature Image*\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Name:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.name}\n                    placeholder=\"Enter name\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">URL:</label>\n                  <span className=\"text-danger position-absolute top-0\">\n                    {this.validator.message(\"url\", collection.url, \"url\")}\n                  </span>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Enter URL\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.url}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Select Category:*\n                  </label>\n\n                  <Select\n                    className=\"react-select-cls\"\n                    classNamePrefix=\"react-select\"\n                    value={selectedOption}\n                    isSearchable={false}\n                    onChange={this.handleSelectChange}\n                    options={categories}\n                    placeholder=\"Select Category\"\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Description:*\n                  </label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Enter description...\"\n                    maxLength=\"500\"\n                    rows=\"3\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.description}\n                  ></textarea>\n                </div>\n\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    disabled={this.handleValidation()}\n                    onClick={(e) => this.submit(e)}\n                  >\n                    Create Collection\n                  </button>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n\n          {/* <section className=\"edit-profile padding-wrapper create-collection-container\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Create Now</span>\n                      <h3 className=\"mb-0\">Create New Collection</h3>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Logo Image*</h6>\n                    <span className=\"text-danger\">\n                      {this.validator.message(\n                        \"logo\",\n                        collection.logo,\n                        \"required\"\n                      )}\n                    </span>\n                  </div>\n                  <div className=\"collection-logo-container pt-2\">\n                    {collection && collection.logo ? (\n                      <img\n                        src={collection.logoUrl}\n                        className=\"colection-avatar-img\"\n                      />\n                    ) : (\n                      <div className=\"colection-avatar\"></div>\n                    )}\n                    <label>\n                      <div className=\"avatar-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        id=\"logo\"\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => this.onFileChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"logo\"\n                      />\n                    </label>\n                  </div>\n                  <div className=\"\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Featured Image*</h6>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"logo\",\n                          collection.featuredImg,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-featured-container\">\n                      {collection && collection.featuredImg ? (\n                        <div className=\"uploaded-featured-container\">\n                          <img\n                            src={collection.featuredImgUrl}\n                            className=\"uploaded-featured-img\"\n                          />\n                          <div className=\"uploaded-featured-hover w-100\">\n                            <div className=\"uploaded-featured-cross\">\n                              <MdClose\n                                color=\"#e33d0bc2\"\n                                className=\"uploaded-cross-icon\"\n                                onClick={() => this.clearData()}\n                              />\n                            </div>\n                            <label>\n                              <div className=\"text-center\">\n                                <img src={UploadIcon} alt=\"upload-icon\" />\n                              </div>\n                              <input\n                                id=\"featuredImg\"\n                                type=\"file\"\n                                accept=\".png,.jpeg,.jpg\"\n                                style={{ display: \"none\" }}\n                                name=\"featuredImg\"\n                                onChange={(e) => this.onFileChange(e)}\n                              />\n                            </label>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className=\"upload-featured-img\">\n                          <label>\n                            <div className=\"text-center\">\n                              <img\n                                src={CollectionUploadIcon}\n                                alt=\"upload-icon\"\n                              />\n                            </div>\n                            <div className=\"upload-featured-img-content pt-2\">\n                              <h6 className=\"pb-1\">Browse Files</h6>\n                              <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                            </div>\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                          </label>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Name*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"name\",\n                            collection.name,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"name\"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.name}\n                          placeholder=\"Name\"\n                          maxLength=\"55\"\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>URL</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\"url\", collection.url, \"url\")}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"url\"\n                          type=\"text\"\n                          name=\"url\"\n                          placeholder=\"URL\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.url}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Select Category*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"category\",\n                            collection.categoryId,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <select\n                          id=\"category\"\n                          name=\"categoryId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Select Collection\n                          </option>\n                          {categories &&\n                            categories.map((category, index) => {\n                              return (\n                                <option key={index} value={category._id}>\n                                  {category.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                      </div>\n                    </div>\n                    <div className=\"col-md-8\">\n                      <div className=\"edit-inp-subheading pt-4\">\n                        <h6>Discription</h6>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <textarea\n                          name=\"description\"\n                          placeholder=\"Discription\"\n                          maxLength=\"500\"\n                          rows=\"3\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.description}\n                          \n                        ></textarea>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                  <div className=\"\">\n                    <button\n                      type=\"button\"\n                      className=\"btn btn-linear-gradient\"\n                      onClick={(e) => this.submit(e)}\n                    >\n                      Create Collection\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section> */}\n          {/* <Footer /> */}\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.reducer.js",["589","590"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["591"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["592"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["593"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["594","595","596","597","598","599","600","601","602"],"import React, { useState, useEffect } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./allnft.css\";\nimport { beforeNFT, getNFTs, getMyLikedNfts } from \"../../nfts/nfts.action\";\nimport { ENV } from \"../../../config/config\";\nimport { getCreators, beforeUser } from \"./../../user/user.action\";\nimport { toggleLikeDislike, beforeTogleLikeDislike } from \"../explore.action\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../../collections/collections.actions\";\nimport { validateNetwork } from \"../../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport FilterComponent from \"../../filterComponent/filterComponent\";\nimport Banner from \"../../banner/banner\";\nimport BannerBg from \"../../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../../own-collection-today/own-collection-today\";\n\nconst bannerData = {\n  subHeading: \"Explore\",\n  heading: \"All NFTs\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n\nconst AllNFT = (props) => {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [collections, setCollections] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getCreators();\n    props.getCollections();\n    if (props?.location?.state) {\n      props.beforeNFT();\n      let searchQs = { keyword: props.location.state, page: 1, limit: 10 };\n      window.history.replaceState(null, \"\");\n      searchQs = ENV.objectToQueryString(searchQs);\n      console.log(searchQs, \"searchQs\");\n      setFilterationLoader(true);\n      props.getNFTs(searchQs);\n    } else {\n      getNFTs();\n    }\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // props.beforeUser()\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  //Get NFt's\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nfts, pagination } = props.nft.nftsData;\n      if (nfts) {\n        if (nfts.length > 0) {\n          setDisabled(false);\n        } else {\n          if (initial) {\n            setDisabled(true);\n          }\n        }\n        setNFTs(nfts);\n        setNFTPagination(pagination);\n        setFilterationLoader(false);\n        props.beforeNFT();\n\n        setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  //pagination\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setCollections(props.collections);\n      props.beforeCollection();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        limit,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n      if(page){\n        nftQS.page=page;\n      } else {\n        nftQS.page=1;\n      }\n      if(limit){\n        nftQS.limit=limit;\n      } else {\n        nftQS.limit=10;\n      }\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable || likeButtonDisable === null) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n  const fetchData = (filterObj) => {\n  \n      getNFTs(filterObj);\n  };\n \n  return (\n    <>\n      <section className=\"explore-collection-section padding-wrapper pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          content={bannerData.content}\n          bgImg={BannerBg}\n          bannerImg={BannerImage}\n        />\n\n        <FilterComponent\n          collections={collections}\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={loader}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          initialKeyword={props?.location?.state}\n          path=\"/explore/nftdetail/\"\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFTs,\n  getCreators,\n  toggleLikeDislike,\n  getCollections,\n  getMyLikedNfts,\n  beforeCollection,\n  beforeUser,\n  beforeTogleLikeDislike,\n})(AllNFT);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/reducer/reducer.js",["603"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.reducer.js",["604"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["605"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["606"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["607"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["608"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n      case BEFORE_NFTS_BY_COLLECTION:\n        return {\n          ...state,\n          nftsByCollectionStatus: false,\n        }\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["609"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout/layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["610","611","612","613","614","615","616"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\n\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\n\r\nimport { getCreators } from \"./../user/user.action\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"all\");\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  const [isActive, setIsActive] = useState(0);\r\n  const [filterationLoader, setFilterationLoader] = useState(true);\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions } = props.auction;\r\n      if (auctions) {\r\n        auctions.forEach((element, i) => {\r\n          auctions[i].totalBids = element.bidInfo?.bidBy?.length;\r\n        });\r\n      }\r\n\r\n      setAuctions(auctions);\r\n      setFilterationLoader(false);\r\n\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  useEffect(() => {\r\n    const interval = setInterval(() => {\r\n      checkIfAuctionEnded();\r\n    }, 3000);\r\n    return () => clearInterval(interval);\r\n  }, [auctions]);\r\n\r\n  const checkIfAuctionEnded = () => {\r\n    if (auctions && auctions?.length > 0) {\r\n      auctions.forEach((item, index) => {\r\n        let auctionEndDate = new Date(item.auctionEndDate);\r\n        let currentDate = new Date();\r\n        if (currentDate > auctionEndDate) {\r\n          let updatedAuctions = [...auctions];\r\n          updatedAuctions.splice(index, 1);\r\n          setAuctions(updatedAuctions);\r\n        }\r\n      });\r\n    }\r\n  };\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setFilterationLoader(true);\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-md-8\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content clr-blue\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products.{\" \"}\r\n                    <br className=\"d-none d-xxl-block\" />\r\n                    We want to be a part of your smile, success and future\r\n                    growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\r\n              {categoryId === \"all\" &&\r\n              (!auctions || (auctions && auctions?.length <= 1)) &&\r\n              !filterationLoader ? (\r\n                \"\"\r\n              ) : (\r\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                  {categories &&\r\n                    categories.length > 0 &&\r\n                    categories.map((item, id) => {\r\n                      if (id <= 3) {\r\n                        return (\r\n                          <button\r\n                            key={id}\r\n                            className={`${\r\n                              id === isActive ? \"home-active-category\" : \"\"\r\n                            } me-1 me-sm-3 me-lg-4`}\r\n                            onClick={() => {\r\n                              setIsActive(id);\r\n                              handleCategoryFilter(item.description);\r\n                            }}\r\n                          >\r\n                            {item.name}\r\n                          </button>\r\n                        );\r\n                      }\r\n                    })}\r\n                  <div className=\"intro-btn\">\r\n                    <Link\r\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                      to=\"/auctions\"\r\n                    >\r\n                      View All\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auctions-slides\">\r\n            <>\r\n              {filterationLoader ? (\r\n                <div className=\"spinner-loader-wrapper\">\r\n                  <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                    <span className=\"sr-only\">Loading...</span>\r\n                  </div>\r\n                </div>\r\n              ) : auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item, index) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        cardBg={\"card-bg-gray\"}\r\n                        key={index}\r\n                        item={item}\r\n                        ownerName={item.owner.username}\r\n                        userId={ENV.getUserKeys(\"_id\")._id}\r\n                        ownerId={item.owner._id}\r\n                        bidsProfile={item.bidInfo.bidByProfile}\r\n                        index={index}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className=\"text-center py-5\">No Live Auctions Found</p>\r\n              )}\r\n            </>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topseller.js",["617","618"],"import React, { useEffect, useState } from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { getTopSellers, beforeUser } from \"../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\r\nimport \"./topseller.css\";\r\nimport { Images } from \"../../assets/assets\";\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n  const [loader, setLoader] = useState(true);\r\n\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.user.topSellersAuth) {\r\n      const { topSellers } = props.user.sellers;\r\n      setLoader(false);\r\n      if (topSellers?.length > 11) {\r\n        setSellers(topSellers.slice(0, 11));\r\n      } else {\r\n        setSellers(topSellers);\r\n      }\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content clr-blue\">\r\n                <span>Creative Artists</span>\r\n                <h3 className=\"mb-5\">Top Sellers</h3>\r\n              </div>\r\n              {sellers && sellers.length > 12 && props.viewAll && (\r\n                <div className=\"intro-btn mb-5\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll \"\r\n                    to=\"/top-sellers-list\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row g-3 items\">\r\n          {loader ? (\r\n            <div className=\"top-seller spinner-loader-wrapper\">\r\n              <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                <span className=\"sr-only\">Loading...</span>\r\n              </div>\r\n            </div>\r\n          ) : sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              return (\r\n                <div\r\n                  key={`ts_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                >\r\n                  {/* Single Seller */}\r\n                  <div className=\"card top-seller-card\">\r\n                    <div className=\"single-seller d-flex align-items-center\">\r\n                      <div className=\"seller-avatar-container\">\r\n                        <img\r\n                          className=\"avatar-md rounded-circle\"\r\n                          src={\r\n                            author.profileImage === null\r\n                              ? Images.placeholderImg\r\n                              : author.profileImage\r\n                          }\r\n                          alt=\"AvatarImg\"\r\n                        />\r\n                        {author.profileImage ? (\r\n                          <span className=\"seller-avatar-active\">\r\n                            <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                          </span>\r\n                        ) : (\r\n                          \"\"\r\n                        )}\r\n                      </div>\r\n\r\n                      {/* Seller Info */}\r\n                      <div className=\"seller-info ml-3 w-100\">\r\n                        <p className=\"seller text-capitalize mb-2\">\r\n                          {author.username}\r\n                        </p>\r\n                        <span className=\"text-end\">\r\n                          {\" \"}\r\n                          {author.totalETH.toFixed(2)}\r\n                        </span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          ) : (\r\n            <p className=\"text-center\">No Top Sellers Found</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/popular-collections.js",["619","620","621","622","623","624"],"import React, { useState, useEffect } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n} from \"../collections/collections.actions\";\nimport { connect } from \"react-redux\";\nimport { Images } from \"../../assets/assets\";\n\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst PopularCollections = (props) => {\n  const [popular, setpopular] = useState([]);\n  const [categories, setCategories] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [popularSettings, settPopularSettings] = useState();\n  const [isActive, setIsActive] = useState(0);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.category.getAuth) {\n      setCategories(props.category.categories);\n    }\n  }, [props.category.getAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n      let popularCollectionsSettings = ENV.popularCollectionsSettings;\n      if (finalCollectionListing.length > 3) {\n        popularCollectionsSettings.infinite = true;\n      } else {\n        popularCollectionsSettings.infinite = false;\n      }\n      settPopularSettings(popularCollectionsSettings);\n      if (finalCollectionListing.length && finalCollectionListing.length > 8) {\n        setFilterationLoader(false);\n        setpopular(finalCollectionListing.slice(0, 7));\n      } else {\n        setpopular(finalCollectionListing);\n\n        setFilterationLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  const handleCategoryFilter = (desc) => {\n    setFilterationLoader(true);\n    props.beforePopularCollection();\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getPopularCollections(qs);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index && result.length !== 0) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-md-8\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content clr-blue\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-1\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products.{\" \"}\n                    <br className=\"d-none d-xxl-block\" /> We want to be a part\n                    of your smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\n              {categoryId === \"all\" && popular && popular?.length == 0 ? (\n                \"\"\n              ) : (\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      if (id <= 3) {\n                        return (\n                          <button\n                            key={id}\n                            className={`collection-category ${\n                              id === isActive ? \"home-active-category\" : \"\"\n                            } me-1 me-sm-3 me-lg-4`}\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      }\n                    })}\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\n                      to=\"/popular-collections\"\n                    >\n                      View All\n                      <img\n                        src={ViewAllIcon}\n                        alt=\"arrow-left\"\n                        className=\"ms-2 d-none d-sm-none\"\n                      />\n                    </Link>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n          {filterationLoader ? (\n            <div className=\"spinner-loader-wrapper\">\n              <div className=\"spinner-border text-secondary\" role=\"status\">\n                <span className=\"sr-only\">Loading...</span>\n              </div>\n            </div>\n          ) : popular && popular.length && popular.length > 0 ? (\n            <CardSlider\n              settings={ENV.popularCollectionsSettings}\n              data={popular}\n              homeAuction\n            >\n              {popular.map((item, i) => {\n                return (\n                  <CollectionsCard\n                    key={i}\n                    Subimg1={handleImage(item, 0)}\n                    Subimg2={handleImage(item, 1)}\n                    Subimg3={handleImage(item, 2)}\n                    collection={item}\n                    CardImg={item.featuredImg}\n                    name={item.name}\n                    id={item._id}\n                    userName={item.username[0]}\n                    NFTCount={item.totalNfts}\n                    profileImage={item.profileImage[0]}\n                    index={i}\n                  />\n                );\n              })}\n            </CardSlider>\n          ) : (\n            <p className=\"text-center not-found-title mt-5 py-5\">\n              No Popular Collections Found\n            </p>\n          )}\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(mapStateToProps, {\n  beforePopularCollection,\n  beforeCategory,\n  getCategories,\n  getPopularCollections,\n})(PopularCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.actions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.action.js",["625","626"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero/hero.js",["627","628","629","630"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport \"./hero.css\";\r\nimport Play from \"../../assets/images/play.svg\";\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport HeroCards from \"../hero-cards/HeroCards\";\r\nimport { ListingImg } from \"../../assets/assets\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeAuction, getLiveAuctions } from \"../auctions/auctions.action\";\r\nimport { connect } from \"react-redux\";\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n  const [auctions, setAuctions] = useState(null);\r\n  const heroSettings = ENV.heroSettings;\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n  useEffect(() => {\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions } = props.auction;\r\n      let updatedAuctions = [];\r\n      if (auctions.length > 0) {\r\n        updatedAuctions = auctions.filter((item) => item.fileType === \"image\");\r\n      }\r\n      if (updatedAuctions?.length > 6) {\r\n        updatedAuctions = updatedAuctions.slice(0, 6);\r\n      }\r\n      setAuctions(updatedAuctions);\r\n\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, <br /> <span>and sell </span>\r\n              <br />\r\n              Extraordinary <span> NFTs </span>\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create me-sm-4\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                Create\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                Explore\r\n              </Link>\r\n            </div>\r\n            <div className=\"watch-video d-flex align-items-center mt-5 mb-4\">\r\n              <button className=\"hero-play-btn\">\r\n                <img src={Play} alt=\"play\" />\r\n              </button>\r\n              <span className=\"ms-2\">Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6\">\r\n            <CardSlider settings={heroSettings}>\r\n              {auctions &&\r\n                auctions.length > 0 &&\r\n                auctions.map((auction, id) => {\r\n                  return (\r\n                    <HeroCards key={id} auction={auction} className=\"slide\" />\r\n                  );\r\n                })}\r\n            </CardSlider>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n})(Hero);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["631","632"],"import React, { useState } from \"react\";\nimport { Link, useHistory, useLocation, NavLink } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport { ReactComponent as LoginIcon } from \"../../assets/images/login-icon.svg\";\nimport { ReactComponent as SearchIcon } from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [searchactive, setSearchActive] = useState(false);\n  const [searchValue, setSearchValue] = useState(\"\");\n  const history = useHistory();\n  const location = useLocation();\n\n  const handleChange = (e) => {\n    setSearchValue(e.target.value);\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword = () => {\n    if (searchValue !== \"\" && searchValue.length >= 3) {\n      history.push({\n        pathname: \"/explore/allNFT\",\n        state: searchValue,\n      });\n    }\n  };\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n\n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"light\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <NavLink to=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </NavLink>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className={\"mx-xl-auto\"}>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/\">Home</NavLink>\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/exploreAll\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Explore All\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/allNFT\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    All NFT\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/create\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Create NFT\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/createcollection\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Create Collection\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/userprofile\" className=\"nav-main-link\">\n                  Profile\n                </NavLink>\n              </Nav.Link>\n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <span className=\"me-2\">\n                    <LoginIcon />\n                  </span>\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={() => handleSearchKeyword()}\n                >\n                  <SearchIcon className=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={() => handleSearchKeyword()}\n              >\n                <SearchIcon className=\"search-icon\" />\n              </button>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient btn-login\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <span className=\"me-2\">\n                  <LoginIcon />\n                </span>\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.js",["633","634","635","636","637","638"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport EmailIcon from \"../../assets/images/mailbox-icon.svg\";\nimport \"./footer.css\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  return (\n    <footer className=\"footer-area\">\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin  text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Who Are We?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/aboutus\">About Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/faqs\">FAQs</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Join MintsClub\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/login\">Sign In</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/Signup\">Sign Up</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Quick Links\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/auctions\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/popular-collections\">Popular Collections</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacypolicy\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/termsandconditions\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin\">\n              <div className=\"footer-items footer-notify-item text-center text-lg-end\">\n                <h4 className=\"footer-title\">\n                  Never Miss The NFT Beat! <br /> Subscribe To Our Latest News\n                </h4>\n                <div className=\"notify-form\">\n                  <div className=\"email-icon\">\n                    <img src={EmailIcon} alt=\"mail-box\" />\n                  </div>\n                  <input type=\"email\" placeholder=\"youremail@xyz.com\" />\n                  <div>\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Subscribe\n                    </button>\n                  </div>\n                </div>\n                <p>{data.desc}</p>\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-end\">\n                  <a\n                    href={\"https://www.linkedin.com/showcase/mints-club\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a\n                    href={\"https://www.facebook.com/MintsClub.io/\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a\n                    href={\"https://www.instagram.com/mintsclub/\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={\"https://twitter.com/MintsClub\"} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/buy-sell/Buysell.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/own-collection-today/own-collection-today.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections-cards/CollectionsCard.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/banner/banner.js",["639"],"import React from \"react\";\nimport \"./banner.css\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst Banner = ({ subHeading, heading, content, bgImg, bannerImg }) => {\n  return (\n    <>\n      <div\n        className=\"banner-wrapper padding-wrapper\"\n        style={{ backgroundImage: `url(${bgImg})` }}\n      >\n        <div className=\"container\">\n          <div className=\"row align-items-end\">\n            <div className=\"col-md-9 col-lg-7\">\n              <div className=\"intro\">\n                <div className=\"intro-content clr-blue\">\n                  {subHeading && <span>{subHeading}</span>}\n                  {heading && <h3 className=\"mb-0\">{heading}</h3>}\n                  {content && <p className=\"pt-4\">{content}</p>}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-lg-5 d-none d-lg-block\">\n              <div className=\"banner-img\">\n                {bannerImg && <img src={bannerImg} alt=\"banner-img\" />}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Banner;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/filterComponent/filterComponent.js",["640","641","642","643","644"],"import React, { useState, useEffect } from \"react\";\nimport \"./filterComponent.css\";\nimport SearchIcon from \"../../assets/images/search-inp.svg\";\nimport NftCard from \"../nft-card/nft-card\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport Select from \"react-select\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nconst FilterHoc = (props) => {\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [statusActive, setStatusActive] = useState(null);\n  const [filterActive, setFilterActive] = useState(false);\n  const [initial, setInitial] = useState(true);\n  const [selectedOption, setSelectedOption] = useState();\n  const [collectionActive, setCollectionActive] = useState(null);\n  const [isActive, setIsActive] = useState(1);\n  const [keyword, setKeyword] = useState(\n    props.initialKeyword ? props.initialKeyword : \"\"\n  );\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n    keyword: props.initialKeyword ? props.initialKeyword : \"\",\n  });\n\n  const priceOptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recently Created\" },\n  ];\n  useEffect(() => {\n    const { initialKeyword } = props;\n    if (initialKeyword) {\n      let capitalizeValue = capitalize(initialKeyword);\n      setKeyword(capitalizeValue);\n      handleSearchKeyword(capitalizeValue);\n    }\n  }, [props.initialKeyword]);\n\n  useEffect(() => {\n    fetchData(filter);\n  }, [filter]);\n  const handleSelectChange = (selectedOption) => {\n    setSelectedOption(selectedOption);\n  };\n  const selectCustomStyles = {};\n\n  const statusData = [\"Buy Now\", \"On Auction\", \"New\"];\n  const handleFilters = () => {\n    setFilterActive(!filterActive);\n  };\n  const isHideCollection = () => {\n    if (props.UserProfile || props.collectionDetail) {\n      if (isActive === 1) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return true;\n    }\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n    setInitial(false);\n\n    const { label } = e;\n    if (label === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n    } else if (label === \"Recently Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    if (!UserProfile) {\n      setInitial(false);\n      setFilterationLoader(true);\n      setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    } else {\n      getPaginatedData();\n    }\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n  };\n\n  const handleSearchKeyword = (value) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    let capitalizeValue = \"\";\n    if (value) {\n      capitalizeValue = capitalize(value);\n    }\n    setFilter((prev) => ({ ...prev, keyword: capitalizeValue }));\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    if (id === \"Buy Now\") {\n      setFilter((prev) => ({\n        ...prev,\n        buy: true,\n        auction: false,\n        newest: false,\n      }));\n    } else if (id === \"On Auction\") {\n      setFilter((prev) => ({\n        ...prev,\n        auction: true,\n        buy: false,\n        newest: false,\n      }));\n    } else {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        buy: false,\n        auction: false,\n      }));\n    }\n  };\n  const handleClearFilter = (id) => {\n    if (id === \"status\") {\n      setFilterationLoader(true);\n      setFilter((prev) => ({\n        ...prev,\n        buy: false,\n        auction: false,\n        new: false,\n      }));\n    } else if (id === \"price\") {\n      setFilterationLoader(true);\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setFilter((prev) => ({ ...prev, ltePrice: false, gtePrice: false }));\n    } else if (id === \"collections\") {\n      setFilterationLoader(true);\n      setFilter((prev) => ({ ...prev, collectionId: false }));\n    } else {\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setStatusActive(null);\n      setCollectionActive(null);\n      setSelectedOption(null);\n      setFilterActive(null);\n      setKeyword(\"\");\n      setFilter({\n        collectionId: false,\n        gtePrice: false,\n        ltePrice: false,\n        categoryId: false,\n        oldest: false,\n        lowToHigh: false,\n        highToLow: false,\n        newest: false,\n        page: filter.page,\n        limit: filter.limit,\n        buy: false,\n        auction: false,\n        latest: false,\n      });\n    }\n  };\n  const capitalize = (word) => {\n    return word[0].toUpperCase() + word.slice(1).toLowerCase();\n  };\n\n  const {\n    collections,\n    disabled,\n    menuData,\n    totalItems,\n    handleNftFilter,\n    setMenuFilter,\n    filterationLoader,\n    setFilterationLoader,\n    nfts,\n    loader,\n    likedNfts,\n    nftPagination,\n    handleLikesTogleApi,\n    fetchData,\n    path,\n    getPaginatedData,\n    UserProfile,\n  } = props;\n  return (\n    <div className=\"filterhoc-wrapper padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row justify-content-center justify-content-lg-start\">\n          <div className=\"col-12 order-0\">\n            <div\n              className={`d-flex flex-column flex-md-row align-items-center justify-content-md-between`}\n            >\n              <div className=\"search-input mb-4 mb-md-0\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Search items and accounts\"\n                  maxLength=\"50\"\n                  onChange={(e) => {\n                    if (keyword.trim() === \"\" && e.target.value.trim() === \"\") {\n                      return false;\n                    } else if (e.target.value === \"\") {\n                      handleSearchKeyword(false);\n                      setKeyword(e.target.value);\n                    } else {\n                      setKeyword(e.target.value);\n                    }\n                  }}\n                  onKeyPress={(e) =>\n                    e.key === \"Enter\" && handleSearchKeyword(keyword)\n                  }\n                  value={keyword}\n                />\n                <img src={SearchIcon} alt=\"search-input\" />\n              </div>\n              <div className=\"sort-by-select mb-4 mb-md-0\">\n                <p className=\"me-3\">Sort by:</p>\n                <Select\n                  className=\"react-select-cls\"\n                  classNamePrefix=\"react-select\"\n                  styles={selectCustomStyles}\n                  // defaultValue={priceOptions[3]}\n                  value={selectedOption}\n                  isSearchable={false}\n                  onChange={(value) => {\n                    handleSelectChange(value);\n                    handleSortOptions(value);\n                  }}\n                  options={priceOptions}\n                />\n              </div>\n              <div className=\"mob-filters-btn d-flex d-lg-none align-items-center justify-content-center\">\n                <button\n                  className={`${filterActive ? \"mob-active-filter\" : \"\"}`}\n                  onClick={handleFilters}\n                >\n                  Filters\n                </button>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-12 my-5 order-2 order-lg-1 \">\n            <div className=\"hero-nav d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n              <div>\n                {\" \"}\n                {menuData &&\n                  menuData.length > 0 &&\n                  menuData.map((item, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          setIsActive(id);\n                          handleNftFilter(item);\n                          setMenuFilter(item);\n                        }}\n                        className={`${\n                          id === isActive ? \"active-hero-nav\" : \"\"\n                        } me-2 me-xl-3`}\n                      >\n                        {item}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"total-items mt-3 mt-sm-0\">\n                <p>\n                  Total items:{\" \"}\n                  <span>{nftPagination?.total ? nftPagination?.total : 0}</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div\n            className={`${\n              filterActive ? \"d-block d-lg-block\" : \"d-none d-lg-block\"\n            } col-md-5 col-lg-4 col-xl-3 order-1 order-lg-2 mt-4 mt-lg-0`}\n          >\n            <div className=\"filter-container mb-4\">\n              <h6>Status</h6>\n              <hr />\n              <div className=\"d-flex flex-wrap align-items-center \">\n                {statusData &&\n                  statusData.map((status, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          handleStatusFilter(status);\n                          setStatusActive(status);\n                        }}\n                        className={`${\n                          status === statusActive ? \"active-filter-btn\" : \"\"\n                        } filter-btn me-3`}\n                      >\n                        {status}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {statusActive && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => {\n                      setStatusActive();\n                      handleClearFilter(\"status\");\n                    }}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            <div className=\"filter-container mb-4\">\n              <h6>Price</h6>\n              <hr />\n              <div className=\"min-max-inp d-flex flex-column flex-sm-row align-items-center justify-content-center justify-content-sm-between mb-2\">\n                <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-center\">\n                  <input\n                    type=\"number\"\n                    placeholder=\"Min\"\n                    className=\"me-sm-2\"\n                    value={minValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMinPrice}\n                  ></input>\n                  <input\n                    type=\"number\"\n                    placeholder=\"Max\"\n                    className=\"mt-3 mt-sm-0 me-sm-2\"\n                    value={maxValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMaxPrice}\n                  ></input>\n                </div>\n                <button\n                  className=\"mt-3 mt-sm-0\"\n                  onClick={() => applyMinMaxFilter()}\n                  disabled={disabled || minValue === \"\" || maxValue === \"\"}\n                >\n                  Apply\n                </button>\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {minValue && maxValue && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => handleClearFilter(\"price\")}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            {isHideCollection() && (\n              <div className=\"filter-container hoc-collections-container mb-4\">\n                <h6>Collections</h6>\n                <hr />\n                <div className=\"d-flex flex-wrap align-items-center \">\n                  {collections && collections.length > 0 ? (\n                    collections.map((collection, id) => {\n                      return (\n                        <button\n                          key={id}\n                          onClick={() => {\n                            handleCollectionsFilter(collection._id);\n                            setCollectionActive(id);\n                          }}\n                          className={`${\n                            id === collectionActive ? \"active-filter-btn\" : \"\"\n                          } filter-btn me-2 me-xl-3`}\n                        >\n                          {collection.name}\n                        </button>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center mx-auto\">No Collections Found</p>\n                  )}\n                </div>\n                <div className=\"d-flex align-items-end justify-content-end\">\n                  {collectionActive !== null && (\n                    <button\n                      className=\"filter-clear-btn\"\n                      onClick={() => {\n                        setCollectionActive(null);\n                        handleClearFilter(\"collections\");\n                      }}\n                    >\n                      Clear\n                    </button>\n                  )}\n                </div>\n              </div>\n            )}\n            <div className=\"d-flex align-items-center justify-content-center btn-clear-all\">\n              <button onClick={() => handleClearFilter()}>\n                Clear All Filters\n              </button>\n            </div>\n          </div>\n          <div className=\"col-lg-8 col-xl-9 order-3\">\n            {loader ? (\n              <FullPageLoader />\n            ) : (\n              <div className=\"row g-1\">\n                {filterationLoader ? (\n                  <div className=\"text-center\">\n                    <div\n                      className=\"spinner-border text-secondary\"\n                      role=\"status\"\n                    >\n                      <span className=\"sr-only\">Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((nft, index) => {\n                    return (\n                      <div\n                        key={index}\n                        className=\"col-12 col-sm-6 col-md-4 col-lg-6 col-xl-4\"\n                      >\n                        {\n                          <NftCard\n                            data={nft}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            likedNfts={likedNfts}\n                            owner={nft.owner}\n                            path={path}\n                            index={index}\n                          />\n                        }\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center mt-5 no-nft-title\">No NFTs Found</p>\n                )}\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      nftPagination?.total > nfts.length &&\n                      !filterationLoader && (\n                        <button\n                          className=\"btn btn-rounded-bordered px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more...\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default FilterHoc;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],["645","646"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.action.js",["647"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["648","649"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n  axiosPostFormData,\n} from \"./../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n        \n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n      \n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const update =\n  (body, qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .put(url, body)\n      .then(function (response) {\n        if (response.data.success) {\n        } else {\n        }\n      })\n      .catch(function (error) {\n        // console.log(error);\n      });\n  };\n\nexport const createActivity = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}activity/create`;\n\n  axios\n    .post(url, body)\n    .then(function (response) {\n    \n    })\n    .catch(function (error) {\n      // console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const getActivities =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}activity/get`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {\n       \n\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        // console.log(error);\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n  export const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {    \n        dispatch({\n          type:  GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n \n      })\n      .catch(function (error) {\n        // console.log(error)\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n   \n      });\n  };\nexport const beforeNFTByCollection=()=>(dispatch)=>{\n  dispatch({\n    type: BEFORE_NFTS_BY_COLLECTION,\n  });\n}\nexport const getNFTsByCollection = (id) => (dispatch) => {\n  let data = {\n    collectionId: id,\n  };\n\n  dispatch(emptyError());\n\n  const url = `${ENV.url}nfts/getNFTsByCollection`;\n  axios\n    .post(url, data)\n    .then(function (response) {\n      if (response.data.success) {\n        dispatch({\n          type: GET_NFTS_BY_COLLECTION,\n          payload: response.data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: response.data,\n        });\n      }\n    })\n    .catch(function (error) {\n      // console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .get(url)\n      .then(function (response) {\n        console.log();\n        if (response.data.success) {\n          dispatch({\n            type: GET_MYLIKED_NFTS,\n            payload: response.data.data,\n          });\n        } else {\n        }\n      })\n      .catch(function (error) {\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const createNFT = async (formData) => async (dispatch)=>{\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n    \n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  try{\n\n    const res = await axiosPostFormData(\"nfts/storeNFTData\", formData, true);\n  }catch(error){\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       \n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n        } else {\n        }\n      })\n      .catch((errors) => {});\n  };\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["650"],"import React, { useState } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport ArrowUp from \"../../assets/images/arrowUp.svg\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../config/config\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { connect } from \"react-redux\";\nimport \"./AuctionsCard.css\";\nimport { Images } from \"../../assets/assets\";\nimport ImageLoader from \"../contentLoader/imageLoader\";\nimport AuctionAudio from \"../auction-audio/auctionAudio\";\nconst AuctionsCards = ({\n  ownerName,\n  userId,\n  ownerId,\n  bidsProfile,\n  item,\n  cardBg,\n  key,\n}) => {\n  const { countDownRenderer } = ENV;\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n  const [loader, setLoader] = useState(true);\n\n  const {\n    image,\n    auctionEndDate,\n    name,\n    _id,\n    highestBid,\n    totalBids,\n    currentPrice,\n    fileType,\n  } = item;\n  const { profilePhoto } = item?.owner;\n  return (\n    <Card key={key} className={`auction-card ${cardBg} mx-auto mx-sm-2`}>\n      <div className=\"auction-img-wrapper\">\n        {fileType === \"image\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Card.Img\n              variant=\"top\"\n              onLoad={() => setLoader(false)}\n              src={image}\n              alt=\"AuctionTopImg\"\n              style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n            />\n          </>\n        ) : fileType === \"video\" ? (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n                <ImageLoader />\n              </div>\n\n              <video\n                src={image}\n                onEnded={() => {\n                  togglePlay();\n                }}\n                onCanPlay={() => {\n                  setLoader(false);\n                }}\n                ref={videoElement}\n                onTimeUpdate={handleOnTimeUpdate}\n                style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : fileType === \"audio\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n\n            <AuctionAudio\n              src={image}\n              onLoadCallback={() => setLoader(false)}\n              loader={loader}\n            />\n          </>\n        ) : (\n          \" \"\n        )}\n\n        <div className=\"auction-countdown d-flex flex-column justify-content-center align-items-center\">\n          <Countdown date={auctionEndDate} renderer={countDownRenderer} />\n          <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n            <div className=\"auction-card-avatar d-flex align-items-center\">\n              {bidsProfile &&\n                bidsProfile.length > 0 &&\n                bidsProfile.map((item, i) => {\n                  if (i <= 2) {\n                    return (\n                      <img\n                        src={item === null ? Images.placeholderImg : item}\n                        alt=\"AvatarImg\"\n                        key={i}\n                      />\n                    );\n                  }\n                })}\n\n              <span className={`${totalBids === 0 ? \"\" : \"ms-4\"}`}>\n                {totalBids === 0\n                  ? \"No Bids Found\"\n                  : totalBids < 4\n                  ? totalBids + \" People Placed Bid\"\n                  : totalBids - 1 + \"+ People Placed Bid\"}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body>\n        <Card.Title onClick={() => history.push(`explore/nftdetail/${_id}`)}>\n          <div>\n            {name && name.length > 10 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>{totalBids > 0 ? highestBid : currentPrice}</span>\n          </div>\n        </Card.Title>\n        <div className=\"auction-card-owner-container d-flex align-items-center mb-2\">\n          <div className=\"auction-owner-avatar\">\n            <img\n              src={profilePhoto ? profilePhoto : Images.placeholderImg}\n              alt=\"avatar\"\n            />\n          </div>\n\n          <div className=\"ms-2 auction-owner-name\">\n            <p>\n              {\"Owned by:\"}\n              <span className=\"text-capitalize ms-1\">\n                {!ownerName\n                  ? \"unnamed\"\n                  : ownerName && ownerName.length > 12\n                  ? ownerName.substring(0, 12) + \"....\"\n                  : ownerName}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn\"\n          onClick={() => history.push(`explore/nftdetail/${_id}`)}\n        >\n          {userId === ownerId ? \"View\" : \"Place a Bid\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, {})(AuctionsCards);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-card/nft-card.js",["651","652","653"],"import React, { useState } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\n\nimport { ENV } from \"../../config/config\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport placeholderImg from \"../../assets/images/placeholder.png\";\n\nimport { connect } from \"react-redux\";\nimport \"./nft-card.css\";\nimport { Images } from \"../../assets/assets\";\nimport ImageLoader from \"../contentLoader/imageLoader\";\nimport Audio from \"../audio/audio\";\nconst NFTCard = (props) => {\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n  const [loader, setLoader] = useState(true);\n\n  const {\n    image,\n    name,\n    _id,\n    fileType,\n    cardBg,\n    ownerId,\n    likeCount,\n    currentPrice,\n    copies,\n    remainingCopies,\n  } = props.data;\n\n  const { username, profileImage, profilePhoto } = props.owner;\n  const user = ENV.getUserKeys(\"_id\")._id;\n  const { likedNfts } = props;\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className={`auction-card nft-card ${cardBg} m-1 mx-auto mx-sm-1`}>\n      <div className=\"auction-img-wrapper\">\n        {fileType === \"image\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Card.Img\n              variant=\"top\"\n              onLoad={() => setLoader(false)}\n              src={image}\n              alt=\"AuctionTopImg\"\n              style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n            />\n          </>\n        ) : fileType === \"video\" ? (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n                <ImageLoader />\n              </div>\n              <video\n                id=\"video1\"\n                src={image}\n                ref={videoElement}\n                onTimeUpdate={handleOnTimeUpdate}\n                onEnded={() => {\n                  togglePlay();\n                }}\n                onCanPlay={() => {\n                  setLoader(false);\n                }}\n                style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : fileType === \"audio\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Audio\n              src={image}\n              onLoadCallback={() => setLoader(false)}\n              loader={loader}\n              fileType={fileType}\n            />\n          </>\n        ) : (\n          \" \"\n        )}\n      </div>\n      <Card.Body>\n        <Card.Title>\n          <div>\n            {name && name.length > 15 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <span className=\"me-2\">{likeCount ? likeCount : 0}</span>\n            {!validateIfLiked(likedNfts, _id) ? (\n              <img\n                src={Images.whiteEmptyHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"like\", likeCount);\n                }}\n              />\n            ) : (\n              <img\n                src={Images.whiteFillHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"dislike\", likeCount);\n                }}\n              />\n            )}\n          </div>\n        </Card.Title>\n        <div className=\"nft-status \">\n          <div className=\"status-info status-sold\">\n            <span className=\"status\">\n              Sold:{\" \"}\n              <span className=\"status-count\">{copies - remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n          <div className=\"status-info status-remaining\">\n            <span className=\"status\">\n              Remaining: <span className=\"status-count\">{remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-3\">\n          <span className=\"nft-price mt-2\">\n            <img className=\"me-2\" src={Images.nftPriceTag} />\n            Price:<a className=\"price ms-1\">{currentPrice} ETH</a>\n          </span>\n        </div>\n        <div className=\"auction-card-owner-container d-flex align-items-center mb-2 mt-3\">\n          <div className=\"auction-owner-avatar\">\n            <img\n              src={\n               ( !profilePhoto && !profileImage)\n                  ? placeholderImg\n                  : profilePhoto\n                  ? profilePhoto\n                  : profileImage\n              }\n              alt=\"avatar\"\n            />\n          </div>\n          <div className=\"ms-2 auction-owner-name\">\n            <p>\n              {\"Owned by:\"}\n              <span className=\"text-capitalize ms-1\">\n                {ownerId === user\n                  ? \"You\"\n                  : username && username?.length > 8\n                  ? username.substring(0, 6) + \"...\"\n                  : username?.length <= 8\n                  ? username\n                  : \"unnamed\"}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn\"\n          onClick={() => history.push(`${props.path}${_id}`)}\n        >\n          {\"View Detail\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state in nfts\"),\n  ({});\n\nexport default connect(mapStateToProps, {})(NFTCard);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/videoCard.js",["654"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/levelsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/statsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BidModal.js",["655"],"import React, { useState, useEffect } from \"react\";\nimport { Modal, Button } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\n\nimport \"./BuyModal.css\";\n\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport axios from \"axios\";\n\nconst BidModal = (props) => {\n  const [checkBox, setCheckBox] = useState(false);\n  const [exchangeRate, setExchangeRate] = useState(0);\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  const {\n    onChange,\n    decimalNumberValidator,\n    handleModalSubmit,\n    calculatePricePercantage,\n    onHide,\n    balance,\n    price,\n    show,\n  } = props;\n  \n  return (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className={`buy-modal bid-modal ${show === true ? \"modal-is-open\" : \" \"}`}\n      centered\n      autoFocus={true}\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Place a Bid\n        </Modal.Title>\n\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to place bid!\"}\n        </p>\n\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Price</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"bid-inp-container d-flex align-items-center\">\n          <div className=\"inp-container d-flex align-items-center justify-content-between\">\n            <div>\n              <input\n                type=\"number\"\n                placeholder=\"Place Your Bid\"\n                name=\"nftConfig.price.amount\"\n                style={{ borderRadius: \"4px\" }}\n                onChange={(e) => onChange(e)}\n                onKeyDown={(e) => decimalNumberValidator(e)}\n                defaultValue={calculatePricePercantage()}\n                value={price}\n              />\n            </div>\n            <div className=\"dollar-rate text-end\">\n              <p className=\"\">\n                ${price ? (price * exchangeRate).toFixed(2) : 0}\n              </p>\n            </div>\n          </div>\n          <div className=\"inp-currency\">\n            <h6>ETH</h6>\n          </div>\n        </div>\n        <div className=\"bid-balance text-start\">\n          <p>Balance: {Number(balance).toFixed(4)} ETH</p>\n        </div>\n        {balance !== \"\" && balance === 0 && (\n          <p className=\"text-center insufcient-funds text-danger\">\n            Please Add Balance to place bid\n          </p>\n        )}\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\">Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n          onClick={() => {\n            handleModalSubmit();\n            onHide();\n          }}\n          disabled={\n            +price < calculatePricePercantage() ||\n            balance === 0 ||\n            !checkBox ||\n            +price > +balance\n          }\n        >\n          Confirm Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default BidModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BuyModal.js",["656","657","658","659","660"],"import React, { useState } from \"react\";\nimport { Modal, Button, Spinner } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport { ReactComponent as FbIcon } from \"../../assets/images/fb-blue.svg\";\nimport { ReactComponent as TwitterIcon } from \"../../assets/images/twitter-blue.svg\";\nimport { ReactComponent as LinkedinIcon } from \"../../assets/images/linkedin-blue.svg\";\nimport { ReactComponent as InstaIcon } from \"../../assets/images/insta-blue.svg\";\nimport { ReactComponent as VideoIcon } from \"../../assets/images/buy-video-icon.svg\";\nimport { ReactComponent as AudioIcon } from \"../../assets/images/audio-icon.svg\";\nimport ModalSmiley from \"../../assets/images/model-smiley.svg\";\n\nconst BuyModal = (props) => {\n  const [purchase, setPurchase] = useState(true);\n  const [checkBox, setCheckBox] = useState(false);\n  const {\n    name,\n    image,\n    price,\n    exchangeRate,\n    tokenId,\n    modal,\n    setModal,\n    buyNow,\n    confirmed,\n    transactionHash,\n    transactionSuccess,\n    onHide,\n    disabled,\n    balance,\n    fileType,\n  } = props;\n\n  return confirmed === \"\" || confirmed === false || confirmed === \"pending\" ? (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Complete Checkout\n        </Modal.Title>\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to buy this NFT\"}\n        </p>\n        <div className=\"modal-close-container\">\n          <Button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                {fileType === \"image\" ? (\n                  <img src={image} alt=\"nft-img\" />\n                ) : fileType === \"video\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <VideoIcon />\n                  </div>\n                ) : fileType === \"audio\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <AudioIcon />\n                  </div>\n                ) : (\n                  \"\"\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\" target=\"_blank\">Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => {\n            buyNow();\n          }}\n          disabled={!checkBox || disabled || +price > +balance}\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n        >\n          {confirmed === \"pending\" ? (\n            <div class=\"spinner-border approve-spinner\" role=\"status\"></div>\n          ) : (\n            \" Confirm Checkout\"\n          )}\n        </button>\n      </Modal.Footer>\n    </Modal>\n  ) : (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal purchase-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          {!transactionSuccess\n            ? \"Your Purchase is Processing\"\n            : \"Your Purchase has processed!\"}\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        {transactionSuccess && (\n          <div className=\"modal-nft-purchased  mt-3\">\n            <p>\n              <span className=\"me-4\">\n                <img src={ModalSmiley} alt=\"smiley\" />\n              </span>\n              {`  Woo! You just Purchased ${\n                name && name.length > 10 ? name.slice(0, 10) + \"...\" : name\n              }. It should be confirmed on the\n              blockchain`}\n            </p>\n          </div>\n        )}\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                {fileType === \"image\" ? (\n                  <img src={image} alt=\"nft-img\" />\n                ) : fileType === \"video\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <VideoIcon />\n                  </div>\n                ) : fileType === \"audio\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <AudioIcon />\n                  </div>\n                ) : (\n                  \"\"\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n        <div className=\"buy-modal-subheadings-container buy-modal-status w-100 d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Status</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Transaction Hash</p>\n          </div>\n        </div>\n        <div className=\"modal-status-content d-flex align-items-center justify-content-between mt-2 pb-5\">\n          <div className=\"status-process d-flex align-items-center\">\n            {!transactionSuccess ? (\n              <>\n                <Spinner\n                  animation=\"border\"\n                  role=\"status\"\n                  size=\"sm\"\n                  variant=\"primary\"\n                  className=\"me-2\"\n                ></Spinner>\n                <p>Processing</p>\n              </>\n            ) : (\n              <>\n                <CheckCircleIcon />\n              </>\n            )}\n          </div>\n          <div\n            className=\"status-address\"\n            onClick={() =>\n              window.open(\n                `https://rinkeby.etherscan.io/tx/${transactionHash}`,\n                \"_blank\"\n              )\n            }\n          >\n            <p>\n              {transactionHash.slice(0, 6) +\n                \".....\" +\n                transactionHash.slice(-6)}\n            </p>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <p>Share</p>\n        </div>\n        <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n\n          <FbIcon className=\"social-icon\" onClick={()=>window.open(\"https://www.facebook.com/MintsClub.io/\")} />\n          <TwitterIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://twitter.com/MintsClub\")}/>\n          <LinkedinIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://www.linkedin.com/showcase/mints-club\")}/>\n          <InstaIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://www.instagram.com/mintsclub/\")}/>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\nexport default BuyModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.action.js",["661","662"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/ApprovalModal.js",["663","664","665"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n  return (\n    <>\n      {\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title className=\"acc-title mt-lg-3 mt-5\">\n              {approvalStatus === \"approved\"\n                ? \"Congratulations\"\n                : approvalStatus === \"in-progress\"\n                ? \"We’re on it\"\n                : \"Your account if not approved yet.\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\" onClick={onHide}>\n              <button>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </Modal.Header>\n          <Modal.Body>\n            {approvalStatus === \"approved\" ? (\n              <>\n                <img src={Images.sellerTickIcon} className=\"success-icon\" />\n                <div className=\"w-100 px-4 mb-2\">\n                  <div className=\"acc-approved-container mt-5 mb-5\">\n                    <p className=\"acc-approved ms-4 mb-0\">\n                      Your Account has been approved.\n                    </p>\n                    <img src={Images.smile} className=\"smile-img\" />\n                  </div>\n                </div>\n              </>\n            ) : approvalStatus === \"in-progress\" ? (\n              <>\n                <div className=\"approval-spinner mb-4\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n                <p className=\"processing-title text-center w-100\">\n                  Processing...\n                </p>\n                <div className=\"w-100 px-3\">\n                  <p className=\"approve-msg text-start ms-3 mt-3 \">\n                    Wallet Address\n                  </p>\n                  <input\n                    className=\"input-common mb-5\"\n                    value={address}\n                    readOnly\n                  />\n                </div>\n              </>\n            ) : (\n              <>\n                <img\n                  src={Images.metamaskImg}\n                  className=\"approve-metamask-img\"\n                />\n                <div className=\" w-100 px-3\">\n                  <p className=\"approve-msg w-100 text-start ms-3 mt-3 \">\n                    Please approve your wallet address to reach us\n                  </p>\n                  <input className=\"input-common\" value={address} readOnly />\n                </div>\n                <button\n                  className=\"btn btn-linear-gradient mt-4 my-4 get-approved-btn\"\n                  disabled={approvalStatus === \"pending\"}\n                  onClick={() => approveAccount()}\n                >\n                  {approvalStatus === \"pending\" ? (\n                    <div\n                      class=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>\n                  ) : (\n                    \"Get Approved\"\n                  )}\n                </button>\n              </>\n            )}\n          </Modal.Body>\n        </Modal>\n       \n      }\n    </>\n  );\n};\nexport default ApprovalModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["666"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        \n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n",["667","668"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/StatsModal.js",["669","670"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nconst StatsModal = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <form>\n          <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n            {stats &&\n              stats.length > 0 &&\n              stats.map((item, i) => {\n                return (\n                  <div\n                    className=\"row g-2 align-items-center justify-content-between mt-3\"\n                    key={i}\n                  >\n                    <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                      <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                        <div className=\"ps-2\">\n                          <h6>Name:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"text\"\n                            name=\"name\"\n                            maxLength=\"40\"\n                            value={item.name}\n                            onKeyDown={(e) =>\n                              firstInputCharacterSpace(e, item.name.length)\n                            }\n                            onChange={(e) => handleChange(i, e, \"stats\")}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                      <div className=\"d-flex align-items-center justify-content-between\">\n                        <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                          <div className=\"ps-2\">\n                            <h6>Value:</h6>\n                          </div>\n                          <div className=\"inp-container\">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              min=\"1\"\n                              maxLength=\"1\"\n                              onKeyDown={(e) => {\n                                decimalNumberValidator(e);\n                              }}\n                              value={item.value}\n                              onChange={(e) => {\n                                if (\n                                  +e.target.value > 5 ||\n                                  (+e.target.value <= 0 && item.value == \"\")\n                                ) {\n                                  return \"\";\n                                }\n                                handleChange(i, e, \"stats\");\n                              }}\n                              autoComplete=\"off\"\n                            />\n                          </div>\n                        </div>\n                        <div className=\"value-inp-of mx-3\">\n                          <h6>of</h6>\n                        </div>\n                        <div className=\"bid-inp-container modal-value-inp\">\n                          <div className=\"inp-container \">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              value={5}\n                              autoComplete=\"off\"\n                              className=\"text-center\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                      <div className=\"inp-close text-end me-2\">\n                        <button type=\"submit\">\n                          <img\n                            src={InputClose}\n                            alt=\"closemodal\"\n                            onClick={() => removeFormFields(i, \"stats\")}\n                          />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n          </div>\n        </form>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/PropertiesModal.js",["671"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport { firstInputCharacterSpace } from \"./../../utils/functions\";\nconst PropertiesModal = (props) => {\n  const {\n    show,\n    onHide,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    properties,\n    onSave,\n  } = props;\n  const handleSubmit = () => {\n    if (properties && properties.length > 0) {\n      let isEmpty = properties.filter(\n        (item) => item.name === \"\" || item.type === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"properties\");\n      }\n    }\n  };\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Add Properties\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {properties.map((item, i) => {\n            return (\n              <div\n                className=\"row g-2 align-items-center justify-content-between mt-3\"\n                key={i}\n              >\n                <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Type:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"type\"\n                        maxLength=\"40\"\n                        value={item.type}\n                        onKeyDown={(e) =>\n                          firstInputCharacterSpace(e, item.type.length)\n                        }\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Name:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"name\"\n                        maxLength=\"40\"\n                        value={item.name}\n                        onKeyDown={(e) =>\n                          firstInputCharacterSpace(e, item.name.length)\n                        }\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                  <div className=\"inp-close text-end me-2\">\n                    <button onClick={() => removeFormFields(i, \"properties\")}>\n                      <img src={InputClose} alt=\"closemodal\" />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"properties\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={properties && properties.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default PropertiesModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/LevelsModal.js",["672"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nconst LevelsModal = (props) => {\n  const {\n    show,\n    onHide,\n    levels,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    onSave,\n  } = props;\n\n  const handleSubmit = () => {\n    if (levels && levels.length > 0) {\n      let isEmpty = levels.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"levels\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Levels</Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {levels &&\n            levels.length > 0 &&\n            levels.map((item, i) => {\n              return (\n                <div\n                  className=\"row g-2 align-items-center justify-content-between  mt-3\"\n                  key={i}\n                >\n                  <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                    <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                      <div className=\"ps-2\">\n                        <h6>Name:</h6>\n                      </div>\n                      <div className=\"inp-container\">\n                        <input\n                          type=\"text\"\n                          name=\"name\"\n                          maxLength=\"40\"\n                          value={item.name}\n                          onKeyDown={(e) =>\n                            firstInputCharacterSpace(e, item.name.length)\n                          }\n                          onChange={(e) => handleChange(i, e, \"levels\")}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                    <div className=\"d-flex align-items-center justify-content-between\">\n                      <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                        <div className=\"ps-2\">\n                          <h6>Value:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={item.value}\n                            min=\"1\"\n                            maxLength=\"1\"\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            onChange={(e) => {\n                              if (\n                                +e.target.value > 5 ||\n                                (+e.target.value <= 0 && item.value == \"\")\n                              ) {\n                                return \"\";\n                              }\n                              handleChange(i, e, \"levels\");\n                            }}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"value-inp-of mx-3\">\n                        <h6>of</h6>\n                      </div>\n                      <div className=\"bid-inp-container modal-value-inp\">\n                        <div className=\"inp-container \">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={5}\n                            autoComplete=\"off\"\n                            className=\"text-center\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                    <div className=\"inp-close text-end me-2\">\n                      <button>\n                        <img\n                          src={InputClose}\n                          alt=\"closemodal\"\n                          onClick={() => removeFormFields(i, \"levels\")}\n                        />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"levels\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3 \"\n            disabled={levels && levels.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default LevelsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["673","674"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <div className=\"upload-image-border p-4 position-relative\">\n      <div className=\"nft-uploaded-img-container\">\n        {imageURL || videoURL || audioSrc ? (\n          <MdClose\n            color=\"#e33d0bc2\"\n            className=\"uploaded-cross-icon\"\n            onClick={() => clearData()}\n          />\n        ) : (\n          \"\"\n        )}\n        <label\n          className=\"w-100\"\n          onDrop={(e) => onDrop(e)}\n          onDragOver={(e) => dragOver(e)}\n          onDragEnter={(e) => dragEnter(e)}\n          onDragLeave={(e) => dragLeave(e)}\n        >\n          <div className=\"\">\n            {imageURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <img\n                  className=\"upload-image\"\n                  src={imageURL}\n                  alt=\"upload-image\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : videoURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <VideoComponent\n                  videoUrl={videoURL}\n                  videoStyles={videoStyles}\n                  videoWidth=\"300\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : audioSrc ? (\n              <div className=\"nft-uploaded-img-container\">\n                <AudioPlayer audioSrc={audioSrc} />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : (\n              <>\n                {\" \"}\n                <img\n                  className=\"upload-image-place-holder\"\n                  src={Images.uploadImage}\n                  alt=\"upload-image\"\n                />\n                <div className=\"upload-details text-center mt-2\">\n                  <p>Drag and drop your file</p>\n                  <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n                </div>\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={(e) => onFileChange(e, \"onChange\")}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </>\n            )}\n          </div>\n        </label>\n      </div>\n    </div>\n  );\n};\n\nexport default Upload;\n",["675","676"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],["677","678"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/aboutus/aboutus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contactus/contactus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/faqs/faqs.js",["679","680"],"import React, { useEffect } from \"react\";\nimport \"./faqs.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport { Accordion, Card } from \"react-bootstrap\";\n\nconst bannerData = {\n  subHeading: \"Ask\",\n  heading: \"FAQ\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nconst faqsData = [\n  {\n    question: \"What is MintsClub?\",\n    ans: \"MintsClub is a revolutionary 21st Century blockchain product that brings users one step closer to experiencing Metaverse. The users can mint their digital assets such as images, GIFs, games, sports accessories and more into the cryptomarket and establish a stable revenue stream.\",\n  },\n  {\n    question: \"What is a MintsClub token?\",\n    ans: \"MintsClub token, famously known as Non-fungible Token (NFT) is a distinct cryptographic token that exists on the blockchain platform and cannot be replicated. Tokenization of digital assets has made it easier to buy and sell while reducing the threat of fraudulent acts.\",\n  },\n  {\n    question: \"What is the total supply of MINT?\",\n    ans: \"The total supply of 1-inch Mint tokens is 1.5 billion.\",\n  },\n  {\n    question: \"Where can I buy/sell MINT?\",\n    ans: \"You can sell your NFTs on blockchain marketplaces such as Binance, Cardano, Solana and Algoran and now, MintsClub.\",\n  },\n];\n\nconst Faqs = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper faqs\">\n        <div className=\"container\">\n          <div className=\"row align-items-center justify-content-center\">\n            <div className=\"col-12\">\n              <div\n                className=\"faqs-accordion accordion accordion-flush mx-auto\"\n                id=\"accordionFlushExample\"\n              >\n                {faqsData.map((faq, id) => {\n                  return (\n                    <div className=\"accordion-item mb-4\">\n                      <h2 className=\"accordion-header\" id={`${id}`}>\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target={`#c${id}`}\n                          aria-expanded=\"false\"\n                          aria-controls={`c${id}`}\n                        >\n                          <span>Q{`${id + 1}.`}</span>\n                          {faq.question}\n                        </button>\n                      </h2>\n                      <div\n                        id={`c${id}`}\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby={`${id}`}\n                      >\n                        <div className=\"accordion-body\">\n                          <p>{faq.ans}</p>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Faqs;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/imageLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/waveform/WaveForm.js",["681","682"],"import React, { Component } from \"react\";\nimport WaveSurfer from \"wavesurfer.js\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { ReactComponent as AudioIcon } from \"../../../assets/images/audio-icon.svg\";\nimport { WaveformContianer, Wave, PlayButton } from \"./Waveform.styled\";\nimport BackgroundImg from \"../../../assets/images/audio-bg.svg\";\n\nimport \"./WaveForm.css\";\n\nclass Waveform extends Component {\n  constructor(props) {\n    super(props);\n  }\n  state = {\n    playing: false,\n  };\n  componentDidMount() {\n    const track = document.querySelector(\"#track\");\n\n    this.waveform = WaveSurfer.create({\n      barWidth: 2,\n      cursorWidth: 1,\n      container: \"#waveform\",\n      backend: \"WebAudio\",\n      height: 80,\n      progressColor: \"#FFFFFF\",\n      responsive: true,\n      waveColor: \"#838383\",\n      cursorColor: \"transparent\",\n    });\n\n    this.waveform.load(track);\n  }\n\n  componentWillUnmount() {\n    this.setState({ playing: false });\n    this.waveform.playPause();\n  }\n\n  handlePlay = () => {\n    this.setState({ playing: !this.state.playing });\n    this.waveform.playPause();\n  };\n\n  render() {\n    return (\n      <WaveformContianer\n        className=\"wave-container px-4 px-xl-5\"\n        style={{\n          background: `rgba(0, 0, 0, 0.79)`,\n          display: `${!this.props.loader ? \"block\" : \"none\"}`,\n        }}\n      >\n        <PlayButton className=\"audio-btn\" onClick={this.handlePlay}>\n          {this.state.playing ? <BsFillPauseFill /> : <BsFillPlayFill />}\n        </PlayButton>\n        <div\n          className={`${\n            this.props.auction ? \"d-none\" : \"\"\n          } audio-icon-wrapper mt-5 d-flex justify-content-center`}\n        >\n          <AudioIcon />\n        </div>\n       <Wave\n          className={`${this.props.auction ? \"mt-5\" : \"\"} waves mb-3`}\n          id=\"waveform\"\n        />\n\n         <audio\n          id=\"track\"\n          onLoadStart={() => console.log(\"onload start\")}\n          oncanplay={() => {\n            this.props.onLoadCallback();\n          }}\n          onEnded={() => {\n            this.handlePlay();\n          }}\n          src={this.props.url}\n        /> \n        {\" \"}\n      </WaveformContianer>\n    );\n  }\n}\n\nexport default Waveform;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/waveform/Waveform.styled.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/collectionSubLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/privacy-policy/privacyPolicy.js",["683"],"import React, { useEffect } from \"react\";\nimport \"./privacyPolicy.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\n\nconst bannerData = {\n  subHeading: \"Our Privacy Policy\",\n  heading: \"Privacy Policy\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nconst PrivacyPolicy = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper privacy\">\n        <div className=\"container\">\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Privacy Policy</h5>\n            <p>\n              MintsClub is committed to protecting your privacy. We have\n              prepared this Privacy Policy to describe our working practices\n              regarding the Personal Data we collect, use, and share in\n              connection with the MintsClub website, as described in our Terms\n              of Service (collectively, the “Service”). “NFT” as per this\n              Privacy Policy refers to a non-fungible token or similar digital\n              item implemented on a blockchain (such as the Ethereum\n              blockchain), which uses smart contracts to link to or otherwise be\n              associated with certain content or data.\n              <br />\n              By using our platform and the Services, you accept the terms of\n              this Policy and our Terms of Use, and consent to our collection,\n              use, disclosure, and retention of your information as described in\n              this Policy. If you have not done so already, please also review\n              our terms of use. The terms of use contain provisions that limit\n              our liability to you and require you to resolve any dispute with\n              us on an individual basis and not as part of any class or\n              representative action. <br />\n              <span>\n                IF YOU DO NOT AGREE WITH ANY PART OF THIS PRIVACY POLICY OR OUR\n                TERMS OF USE, THEN PLEASE DO NOT USE ANY OF THE SERVICES.\n              </span>\n              <br />\n              Please note that this Policy does not apply to information\n              collected through third-party websites or services that you may\n              access through the Services or that you submit to us through\n              email, text message or other electronic message or offline.\n            </p>\n          </div>\n          <div className=\"privacy-content\">\n            <h5>Information We Collect</h5>\n            <p>We may collect information about you in a range of ways.</p>\n            <ul>\n              <li>\n                {\" \"}\n                Identity information, such as your first name, last name,\n                username or similar identifier, title, date of birth and gender.\n              </li>\n              <li>\n                {\" \"}\n                Contact information, such as your postal address, email address\n                and telephone number.\n              </li>\n              <li>\n                {\" \"}\n                Profile information, such as your, profile picture, username and\n                wallet address, interests, preferences, feedback and survey\n                responses.\n              </li>\n              <li>\n                {\" \"}\n                Feedback and correspondence, such as information you provide in\n                your responses to surveys, when you participate in market\n                research activities, report a problem with Service, receive\n                customer support or otherwise correspond with us.\n              </li>\n              <li>\n                {\" \"}\n                Financial information, such as your credit card or other payment\n                card details.\n              </li>\n              <li>\n                {\" \"}\n                Transaction information, such details about purchases you make\n                through the Service and billing details.\n              </li>\n              <li>\n                {\" \"}\n                Usage information, such as information about how you use the\n                Service and interact with us.\n              </li>\n              <li>\n                {\" \"}\n                Marketing information, such as your preferences for receiving\n                marketing communications and details about how you engage with\n                them.\n              </li>\n              <li>\n                {\" \"}\n                Financial information, such as bank account number and bank\n                routing number; financial assets holdings.\n              </li>\n              <li>\n                {\" \"}\n                Technical information, such as your Ethereum wallet address,\n                application programming interface (API)-key and network\n                information regarding transactions. Please note that your\n                Ethereum wallet address is not collected by{\" \"}\n                <a href=\"https://metamask.io/\" target=\"_blank\">\n                  Metamask{\" \"}\n                </a>\n                or associated plugins and mobile applications.\n              </li>\n            </ul>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected by other means</h5>\n            <p>\n              As you navigate through and interact with the MintsClub website,\n              we may use automatic data collection technologies to collect\n              certain information about your equipment, browsing actions, and\n              patterns, including:\n              <br />\n              Information Collected by Our Servers. To provide our Service and\n              make it more useful to you, we (or a third party service provider)\n              collect information from you, including, but not limited to, your\n              browser type, operating system, Internet Protocol (“IP”) address,\n              mobile device ID, blockchain address, wallet type, and date/time\n              stamps.\n              <br />\n              Log Files. We gather certain information automatically and store\n              it in log files. This information includes IP addresses, browser\n              type, Internet service provider (“ISP”), referring/exit pages,\n              operating system, date/time stamps, and clickstream data. We use\n              this information to analyze trends, administer the Service, track\n              users’ movements around the Service, and better tailor our\n              Services to match our users’ needs and improve their experience.\n              <br />\n              Cookies. Like many online services, we use cookies to collect\n              information. We may use both session Cookies (which expire once\n              you close your web browser) and persistent Cookies (which stay on\n              your computer until you delete them) to analyze how users interact\n              with our Service, make improvements to our product quality, and\n              provide users with a more personalized experience.\n              <br />\n              Pixel Tag. In addition, we use “Pixel Tags” (also referred to as\n              clear Gifs, Web beacons, or Web bugs). Pixel Tags allow us to\n              analyze how users find our Service, make the Service more useful\n              to you, and tailor your experience with us to meet your particular\n              interests and needs.\n              <br />\n              Analytics Services. In addition to the tracking technologies we\n              place like Cookies and Pixel Tags, other companies may set their\n              own cookies or similar tools when you visit our Service. This\n              includes third-party analytics services (“Analytics Services”)\n              that we engage to help analyze how users use the Service. The\n              information generated by the Cookies or other technologies about\n              your use of our Service (the “Analytics Information”) is\n              transmitted to the Analytics Services. The Analytics Services use\n              Analytics Information to compile reports on user activity, which\n              we may receive on an individual or aggregate basis. We use the\n              information we get from Analytics Services to improve our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected from Third-Parties</h5>\n            <p>\n              We may receive Personal and/or Anonymous Data about you from\n              companies that offer their products and/or services for use in\n              conjunction with our Service or whose products and/or services may\n              be linked from our Service. For example, third-party wallet\n              providers provide us with your blockchain address and certain\n              other information you choose to share with those wallets\n              providers. We may add this to the data we have already collected\n              from or about you through our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected from Public Blockchains</h5>\n            <p>\n              We may collect data from your activity that is publicly visible\n              and/or accessible on blockchains. This may include blockchain\n              addresses and information regarding purchases, sales, or transfers\n              of NFTs, which may then be associated with other data you have\n              provided to us.e have already collected from or about you through\n              our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Use of Your Personal Data</h5>\n            <p>\n              When we collect your Personal Data from you, we will inform you at\n              the time as to the reason we are requesting such Personal Data.\n              The Company uses your Personal Data in any or all of the following\n              ways:\n            </p>\n            <ul>\n              <li> To facilitate you in the creation of your account.</li>\n              <li> Recognise you as a legitimate user of our platform.</li>\n              <li>\n                {\" \"}\n                Provide you with our Service, which includes helping you view,\n                explore, and create NFTs using our platform and, at your own\n                risk, connect with other users to purchase, sell NFTs on public\n                blockchains.\n              </li>\n              <li>\n                {\" \"}\n                Administration of our Service and quality of experience when you\n                interact with our platform.\n              </li>\n              <li> Provide customer support and respond to your queries.</li>\n              <li>\n                {\" \"}\n                Show your username next to the NFTs currently or previously\n                accessible in your third-party wallet, and next to NFTs on which\n                you have interacted.\n              </li>\n              <li>\n                {\" \"}\n                Send you notifications related to activity on the platform,\n                including notifications of offers on your NFTs.\n              </li>\n              <li>\n                {\" \"}\n                Send you newsletters, promotional materials, and other notices\n                related to our Services.\n              </li>\n              <li>\n                {\" \"}\n                To comply with applicable laws and cooperate with investigations\n                by law enforcement agencies.\n              </li>\n            </ul>\n          </div>\n          <div className=\"privacy-content\">\n            <h5>Disclosure of your Personal Data</h5>\n            <h6>\n              Third Party Service Providers:{\" \"}\n              <span>\n                We may share your Personal Data with third party service\n                providers.\n              </span>\n            </h6>\n            <h6>\n              Analytics:{\" \"}\n              <span>\n                We may share your data to be used by analytic platforms or other\n                such equivalent tools which make use of statistical information.\n              </span>\n            </h6>\n            <h6>\n              Legal Rights:{\" \"}\n              <span>\n                We may also share information as required by law, regulation,\n                legal process, or governmental request.\n              </span>\n            </h6>\n            <h6>\n              Other Disclosures:{\" \"}\n              <span>\n                We may also disclose your Personal Data: to fulfill the purpose\n                for which you provide it; for any other purpose disclosed by us\n                when you provide it; or with your consent.\n              </span>\n            </h6>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Third-Party Websites</h5>\n            <p>\n              Our platform may contain links to third-party websites. When you\n              click on a link to any other website or location, you will leave\n              our website and go to another site, and another entity may collect\n              Personal Data from you. We have no control over, do not review,\n              and cannot be responsible for these third-party websites or their\n              content. Please be aware that the terms of this Privacy Policy do\n              not apply to these third-party websites or their content, or to\n              any collection of your Personal Data after you click on links to\n              such third-party websites.\n              <br />\n              You may access other third-party services through the Site, for\n              example by clicking on links to those third-party services from\n              within the Site. We are not responsible for the privacy policies\n              and/or practices of these third-party services, and we encourage\n              you to carefully review their privacy policies.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Third-Party Wallets</h5>\n            <p>\n              To use the MintsClub NFT platform, you must use a third-party\n              wallet which allows you to engage in transactions on public\n              blockchains. Your interactions with any third-party wallet\n              provider are governed by the applicable terms of service and\n              privacy policy of the respective third party.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Security of Data</h5>\n            <p>\n              We care about the security of your data and use adequate physical,\n              administrative, and technological measures to maintain the\n              security of the data collected through our platform. Nonetheless,\n              no physical and logical security framework is perfect, and hence\n              no guarantee can be provided. In the unfortunate event where any\n              data is compromised as a result of a security breach, we will take\n              steps to investigate and remedy the situation at the earliest. We\n              will also notify any such individuals whose information may have\n              been compromised.\n              <br />\n              It is imperative that you understand the seriousness associated\n              with the security of your digital wallet, the responsibility of\n              which is yours. We insist that you take steps to ensure it and any\n              information related to your wallet remains secure at all times. If\n              you discover an issue related to your wallet, please contact your\n              wallet provider.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Data Storage and Retention</h5>\n            <p>\n              Your Personal Data may be retained for as long as you continue to\n              use our platform, have an account registered with us, or for as\n              long as it is necessary to fulfill the purposes mentioned in this\n              Privacy Policy. Personal Data may be retained even after your\n              account has been deactivated, if such retention is reasonably\n              necessary to comply with our legal obligations, to resolve\n              disputes, prevent fraud and abuse, enforce our Terms or other\n              agreements, and/or protect our legitimate interests. We will\n              delete any Personal Data where it is no longer required for\n              purposes mentioned in this privacy policy.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Your Rights</h5>\n            <p>\n              If you are a user belonging from the European Economic Area or\n              United Kingdom, or are a California resident, you have certain\n              rights under the respective European and UK General Data\n              Protection Regulations (“GDPR”) and the respective California\n              Consumer Privacy Act (“CCPA”).\n              <br />\n              ​Collectively, depending the situation you have the following data\n              protection rights:\n            </p>\n            <ul>\n              <li>\n                {\" \"}\n                The right to access, update or to delete the information we have\n                on you. Whenever made possible, you can access, update or\n                request deletion of your Personal Data.\n              </li>\n              <li>\n                {\" \"}\n                The right of rectification. You have the right to have your\n                information rectified if that information is inaccurate or\n                incomplete.\n              </li>\n              <li>\n                {\" \"}\n                The right of restriction. You have the right to request that we\n                restrict processing of your personal information.\n              </li>\n              <li>\n                {\" \"}\n                The right to erasure or right to be forgotten. If at any time\n                you do not agree with the collection or use of your personal\n                information as mentioned in this privacy policy and you want us\n                to delete your data.\n              </li>\n              <li>\n                {\" \"}\n                The right to data portability. You have the right to be given a\n                copy of the information we have on you in a structured,\n                machine-readable and commonly used format and have the right to\n                transmit that data to another controller on request.\n              </li>\n              <li>\n                {\" \"}\n                The right to withdraw consent. You may withdraw your consent to\n                the processing of data or information for the purposes as\n                mentioned in this privacy policy.\n              </li>\n              <li>\n                {\" \"}\n                The right to deactivate cookies. If you wish to restrict or\n                block all the cookies which are set by our websites, please use\n                the tool available on the particular website (if applicable), or\n                refer to the Help function within your browser to learn how to\n                manage your settings within your browser.\n              </li>\n            </ul>\n            <p>\n              In some situations we may not be able to enact upon your request,\n              if there is lawful reason or legal obligation that prevents us\n              from timely compliance with such request.\n              <br />\n              In order to exercise any of the above rights you may drop your\n              request with our chatbot.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Changes to Privacy Policy </h5>\n            <p>\n              MintsClub may make changes to this Privacy Policy at any time. We\n              insist all visitors and users to our website to frequently review\n              the Privacy Policy, to learn about the latest changes to our\n              privacy practices and other operational mechanisms. Any changes to\n              our privacy policy will be accompanied with a ‘last updated date’\n              for your convenience.\n              <br />\n              Your continued use of the Website or our platform’s services\n              indicates your acknowledgement and/or acceptance of any changes to\n              the updated Privacy Policy.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Privacy for Children</h5>\n            <p>\n              MintsClub does not target, and is not intended to attract, users\n              under the age of eighteen (18) years. We do not knowingly collect\n              Personal Data from users under the age of eighteen (18) years or\n              send requests to users under the age of eighteen (18) years for\n              Personal Data.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Contact and Queries</h5>\n            <p>\n              If you have any questions or concerns regarding this Privacy\n              Policy or Mints.Club data collection or processing practices, or\n              if you want to report any security violations to us, drop your\n              queries with our chatbot.\n            </p>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default PrivacyPolicy;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/terms-conditions/termsConditions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auction-audio/auctionAudio.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audio/audio.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/nftDetailLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/sellNFTLoader.js",[],{"ruleId":"684","replacedBy":"685"},{"ruleId":"686","replacedBy":"687"},{"ruleId":"688","severity":1,"message":"689","line":18,"column":13,"nodeType":"690","endLine":20,"endColumn":4},{"ruleId":"688","severity":1,"message":