never used.","no-sequences","Unexpected use of comma operator.","SequenceExpression","unexpectedCommaExpression","'Header' is defined but never used.","'Footer' is defined but never used.","'ModalSearch' is defined but never used.","'ModalMenu' is defined but never used.","'Scrollup' is defined but never used.","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","'dotenv' is defined but never used.","'config' is assigned a value but never used.","'network' is assigned a value but never used.","'accounts' is assigned a value but never used.","'linkError' is assigned a value but never used.","'httpValidation' is assigned a value but never used.","no-useless-escape","Unnecessary escape character: \\+.","Literal","unnecessaryEscape",["389","390"],["391","392"],"'Typography' is defined but never used.","'ListItemText' is defined but never used.","'Box' is defined but never used.","'IconButton' is defined but never used.","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'setCaptchaMessage' is assigned a value but never used.","'setDeployNetwork' is assigned a value but never used.","'deploy' is assigned a value but never used.","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","React Hook useEffect has a missing dependency: 'props'. Either include it or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["393"],"React Hook useEffect has a missing dependency: 'props.settings.settings'. Either include it or remove the dependency array. If 'setData' needs the current value of 'props.settings.settings', you can also switch to useReducer instead of useState and read 'props.settings.settings' in the reducer.",["394"],"react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"395","text":"396"},{"range":"397","text":"396"},{"range":"398","text":"396"},{"range":"399","text":"396"},{"range":"400","text":"396"},"'loader' is assigned a value but never used.","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression",["401"],"'formatAddress' is assigned a value but never used.","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","'errorMessage' is assigned a value but never used.","array-callback-return","Array.prototype.map() expects a value to be returned at the end of arrow function.","expectedAtEnd","'genStyle' is assigned a value but never used.","'userId' is assigned a value but never used.","'ALL_COLLECTIONS' is defined but never used.",{"desc":"402","fix":"403"},{"messageId":"404","fix":"405","desc":"406"},{"messageId":"407","fix":"408","desc":"409"},{"messageId":"404","fix":"410","desc":"406"},{"messageId":"407","fix":"411","desc":"409"},{"desc":"412","fix":"413"},{"desc":"414","fix":"415"},[1644,1644]," rel=\"noreferrer\"",[2086,2086],[2526,2526],[2966,2966],[3396,3396],{"desc":"412","fix":"416"},"Update the dependencies array to be: [tawkToKey, tawkToPropertyId]",{"range":"417","text":"418"},"removeEscape",{"range":"419","text":"420"},"Remove the `\\`. This maintains the current functionality.","escapeBackslash",{"range":"421","text":"422"},"Replace the `\\` with `\\\\` to include the actual backslash character.",{"range":"423","text":"420"},{"range":"424","text":"422"},"Update the dependencies array to be: [props]",{"range":"425","text":"426"},"Update the dependencies array to be: [props.settings.settings, props.settings.settingsAuth]",{"range":"427","text":"428"},{"range":"429","text":"426"},[612,617],"[tawkToKey, tawkToPropertyId]",[2492,2493],"",[2492,2492],"\\",[2535,2536],[2535,2535],[513,515],"[props]",[645,674],"[props.settings.settings, props.settings.settingsAuth]",[1276,1278]]