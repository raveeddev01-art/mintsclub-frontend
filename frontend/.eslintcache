"244","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"245","usedDeprecatedRules":"118"},{"filePath":"246","messages":"247","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"248","usedDeprecatedRules":"118"},{"filePath":"249","messages":"250","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"118"},{"filePath":"251","messages":"252","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"118"},{"filePath":"253","messages":"254","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"255","usedDeprecatedRules":"118"},{"filePath":"256","messages":"257","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"258","usedDeprecatedRules":"118"},{"filePath":"259","messages":"260","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"118"},{"filePath":"261","messages":"262","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"263","usedDeprecatedRules":"118"},"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/index.js",[],["264","265"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/App.js",["266","267"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport GaTracker from \"./gaTracker/gaTracket\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\n// import 'swiper/swiper-bundle.css';\n\nconst App = () => {\n  // GaTracker()\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  useEffect(() => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={true}\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n};\n\nexport default App;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/index.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/routes.js",["268","269","270"],"// layouts\nimport layout1 from './layouts/layout1/layout1';\nimport layout2 from './layouts/layout2/layout2';\nimport layout3 from './layouts/layout3/layout3';\nimport layout4 from './layouts/layout4/layout4';\n// components\n// import Home from './components/home/home';\nimport Dashboard from './Screens/Home/home'\nimport FourStepForm from './Screens/FourStepForm/index'\n// import ExploreAll from './components/explore/explore-all';\n// import LiveAuctions from './components/auctions/live-auctions-list';\n// import ItemDetails from './components/item-detail/item-detail';\n// import Activity from './components/activity/activity';\n// import Blog from './components/blog/blog';\n// import BlogSingle from './components/blog-single/blog-single';\n// import HelpCenter from './components/help-center/help-center';\n// import Authors from './components/authors-list/authors-list';\n// import Author from './components/author/author';\n// import Profile from './components/profile/profile';\n// import CreateNFT from './components/create-nft/create-nft';\n// import MyCollections from './components/collections/my-collections';\n// import CreateCollection from './components/create-collection/create-collection';\n// import CollectionDetails from './components/collections/collection-details';\n// import Wallet from './components/wallet/wallet';\n// import Signup from './components/signup/signup';\n// import Contact from './components/contact/contact';\n// import SellNFT from './components/nfts/sell-nft';\n// import NotFound from './components/not-found/not-found';\n// import HowItWorks from './components/how-it-works/how-it-works';\n// import PrivacyTerms from './components/privacy-&-terms/privacy-&-terms';\n\n// routes\nconst routes = [\n    { path: '/', access: true, exact: true, title: 'Home', layout: layout2, component: Dashboard },\n    { path: '/fourStepForm', access: true, exact: true, title: 'Explore', layout: layout2, component: FourStepForm },\n    // { path: '/explore-all', access: true, exact: true, title: 'Explore', layout: layout2, component: ExploreAll },\n    // { path: '/auctions', access: true, exact: true, title: 'Live Auctions', layout: layout2, component: LiveAuctions },\n    // { path: '/item-details', access: true, exact: true, title: 'Item Details', layout: layout2, component: ItemDetails },\n    // { path: '/sell-item/:itemId?', access: true, exact: true, title: 'Sell Item', layout: layout2, component: SellNFT },\n    // { path: '/activity', access: true, exact: true, title: 'Activity', layout: layout2, component: Activity },\n    // { path: '/blog', access: true, exact: true, title: 'Blog', layout: layout1, component: Blog },\n    // { path: '/blog-single', access: true, exact: true, title: 'Blog Single', layout: layout1, component: BlogSingle },\n    // { path: '/help-center', access: true, exact: true, title: 'Help Center', layout: layout1, component: HelpCenter },\n    // { path: '/authors', access: true, exact: true, title: 'Authors', layout: layout2, component: Authors },\n    // { path: '/author/:authorId?', access: true, exact: true, title: 'Author Profile', layout: layout1, component: Author },\n    // { path: '/profile', access: true, exact: true, title: 'Profile', layout: layout1, component: Profile },\n    // { path: '/create', access: true, exact: true, title: 'Create', layout: layout2, component: CreateNFT },\n    // { path: '/collections', access: true, exact: true, title: 'Collections', layout: layout2, component: MyCollections },\n    // { path: '/collection/create', access: true, exact: true, title: 'Create Collection', layout: layout2, component: CreateCollection },\n    // { path: '/collection-details/:collectionId?', access: true, exact: true, title: 'Collection Details', layout: layout1, component: CollectionDetails },\n    // { path: '/login', access: true, exact: true, title: 'login', layout: layout4, component: Wallet },\n    // { path: '/signup', access: true, exact: true, title: 'Signup', layout: layout4, component: Signup },\n    // { path: '/contact', access: true, exact: true, title: 'Contact', layout: layout1, component: Contact },\n    // { path: '/how-it-works', access: true, exact: true, title: 'How It Works', layout: layout1, component: HowItWorks },\n    // { path: '/privacy-and-terms', access: true, exact: true, title: 'Privacy & Terms', layout: layout1, component: PrivacyTerms },\n    // { path: '/*', access: true, exact: true, name: 'Not Found', layout: layout3, component: NotFound }\n];\n\nexport default routes;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/gaTracker/gaTracket.js",["271"],"import { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport ReactGA from \"react-ga\";\nimport { connect } from \"react-redux\";\nimport { useSelector } from \"react-redux\";\n\n\n\nconst useGaTracker = () => {\n    const step=useSelector((state)=>state.dashboard.currentStep)\n    const location = useLocation();\n    const [initialized, setInitialized] = useState(false);\n\n    useEffect(() => {\n        if (!window.location.href.includes(\"localhost\")) {\n        ReactGA.initialize(\"UA-215431628-1\");\n        }\n        setInitialized(true);\n    }, []);\n\n    useEffect(() => {\n        if (initialized) {\n        \n            if(location.pathname === '/')\n            {\n\n                ReactGA.pageview(location.pathname + location.search );\n            }\n            else {\n                ReactGA.pageview(location.pathname + location.search + `/step${step}`);\n            }\n        }\n    }, [initialized, location, step]);\n};\n\nexport default useGaTracker;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/full-page-loader/full-page-loader.js",["272"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/reducer/reducer.js",["273"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/auctions.reducer.js",["274"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/home/home.reducer.js",["275","276"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.reducer.js",["277"],"import { BEFORE_USER, SET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, GET_USER } from '../../redux/types';\n\nconst initialState = {\n    userData: null,\n    userAuth: false,\n    creatorsAuth: false,\n    topSellersAuth: false,\n    individualUserAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_USER:\n            return {\n                ...state,\n                userData: action.payload,\n                userAuth: true\n            }\n        case GET_USER:\n            return {\n                ...state\n            }\n        case SET_CREATORS:\n            return {\n                ...state,\n                creators: action.payload,\n                creatorsAuth: true\n            }\n        case TOP_SELLERS:\n            return {\n                ...state,\n                sellers: action.payload,\n                topSellersAuth: true\n            }\n        case SET_INDIVIDUAL_USER:\n            return {\n                ...state,\n                individualUser: action.payload,\n                individualUserAuth: true\n            }\n        case BEFORE_USER:\n            return {\n                ...state,\n                userData: null,\n                userAuth: false,\n                creatorsAuth: false,\n                topSellersAuth: false,\n                individualUserAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/nfts.reducer.js",["278"],"import { BEFORE_NFT, GET_NFTS, GET_NFT, UPSERT_NFT,NFTALL } from '../../redux/types';\n\nconst initialState = {\n    nftsData: {},\n    nftAll:{},\n    nftsAuth: false,\n    upsertAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case UPSERT_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                upsertAuth: true\n            }\n        case GET_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n            case NFTALL:\n        \n                return {\n                    ...state,\n                    nftAll: action.payload,\n                }\n            \n        case GET_NFTS:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n        case BEFORE_NFT:\n            return {\n                ...state,\n                nftsData: {},\n                nftsAuth: false,\n                upsertAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/categories/categories.reducer.js",["279"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.reducer.js",["280"],"import { BEFORE_COLLECTION, GET_COLLECTION, SET_AUTH_STATE, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\n\nconst initialState = {\n    collection: null,\n    collections: null,\n    allCollections:null,\n    pagination: null,\n    deleteAuth: false,\n    upsertAuth: false,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n            case ALL_COLLECTIONS:\n                return {\n                    ...state,\n                    collection: action.payload.allCollections,\n                    getAuth: true\n                }\n        case SET_AUTH_STATE:\n            return {\n                ...state,\n                getAuth: false\n            }\n\n        case UPSERT_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                upsertAuth: true\n            }\n        case DELETE_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                deleteAuth: true\n            }\n        case GET_COLLECTIONS:\n            return {\n                ...state,\n                collections: action.payload.collections,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_COLLECTION:\n            return {\n                ...state,\n                collection: null,\n                collections: null,\n                pagination: null,\n                deleteAuth: false,\n                upsertAuth: false,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.reducer.js",["281"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.reducer.js",["282"],"import { BEFORE_FAQ, GET_FAQS } from '../../redux/types';\n\nconst initialState = {\n    faqs: null,\n    faqsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FAQS:\n            return {\n                ...state,\n                faqs: action.payload,\n                faqsAuth: true\n            }\n        case BEFORE_FAQ:\n            return {\n                ...state,\n                faqs: null,\n                faqsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.reducer.js",["283"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.reducer.js",["284"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/bids/bids.reducer.js",["285"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            return {\n                ...state,\n                bids: action.payload.bids,\n                pagination: action.payload.pagination,\n                highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.reducer.js",["286"],"import { BEFORE_CONTACT, CREATE_CONTACT } from '../../redux/types';\n\nconst initialState = {\n    contactAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case CREATE_CONTACT:\n            return {\n                ...state,\n                contactAuth: true\n            }\n        case BEFORE_CONTACT:\n            return {\n                ...state,\n                contactAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.reducer.js",["287"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/Home/home.js",["288","289","290","291","292","293","294","295"],"import { useEffect } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { connect } from \"react-redux\";\n// import { hometest } from \"../../Redux/actions/actions\";\nimport Navbar from \"../../components/Navbar/navbar\";\nimport SimpleSlider from \"../../components/Slider/slider\";\n// import image from \"../../assets/images/test.jpg\";\nimport Polygon from \"../../assets/images/icon 2.svg\";\n// import Ethereum from \"../../assets/images/Ethereum.svg\";\nimport Cardano from \"../../assets/images/icon 3.svg\";\nimport Binance from \"../../assets/images/icon4.svg\";\nimport Ethereum from \"../../assets/images/icon1.png\";\n// import nft2 from \"../../assets/images/icon4.svg\";\n// import nft3 from \"../../assets/images/icon 2.svg\";\n////////////////////////\nimport nft1 from \"../../assets/images/nft1.jpg\";\nimport nft2 from \"../../assets/images/nft2.webp\";\nimport nft3 from \"../../assets/images/nft3.jpeg\";\nimport nft4 from \"../../assets/images/nft4.webp\";\nimport nft5 from \"../../assets/images/nft5.jpg\";\nimport GaTracker from \"../../gaTracker/gaTracket\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\nimport { Container } from \"react-bootstrap\";\n\nimport \"./home.css\";\n\nconst Home = (props) => {\n  //  useEffect(()=>{\n  // },[])\n  GaTracker();\n  const networksData = [\n    { name: \"Ethereum\", image: Ethereum },\n    { name: \"Polygon\", image: Polygon },\n    { name: \"Cardano\", image: Cardano },\n    { name: \"Binance SmartChain\", image: Binance },\n  ];\n\n  const history = useHistory();\n\n  return (\n    <div className=\"home-container\">\n      <div className=\"container\">\n        <div className=\"pt-3\">\n          <Navbar />\n        </div>\n        <div className=\"mt-4 details-container\">\n          <div className=\" d-flex justify-content-between home-info-container\">\n            <div className=\" \">\n              <div className=\"details\">\n                <div className=\"\" style={{ maxWidth: \"31rem\" }}>\n                  <p\n                    className=\"text-white mint-title\"\n                    style={{ fontSize: \"46px\", fontWeight: \"bold\" }}\n                  >\n                    Let's Mint Your NFTs\n                  </p>\n                  <p\n                    className=\"text-white mint-title\"\n                    style={{ fontSize: \"30px\", fontWeight: \"bold\" }}\n                  >\n                    Free..! Minting Always!!\n                  </p>\n                  {/* <p className=\"text-white\" style={{ fontSize: \"20px\" }}>\n                    Lorem Ipsum is simply dummy text of the printing and\n                    typesetting industry.{\" \"}\n                  </p> */}\n                </div>\n              </div>\n\n              <div className=\"networks \">\n                <p\n                  className=\"text-white select-network-heading\"\n                  style={{ fontSize: \"36px\" }}\n                >\n                  Select Network\n                </p>\n                <div className=\"networks-list-container mt-4 d-flex \">\n                  {/* {networksData.map((item, index) => {\n                    return (\n                      <div\n                        className=\"network\"\n                        disabled={true}\n                        key={index}\n                     \n                      >\n                      \n                        <img\n                          src={item.image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\n                            \"Ethereum\" === item.name ? \"\" : \"selected-network\"\n                          }`}\n                        />\n                        {\"Ethereum\" !== item.name && (\n                          <span className=\"tooltiptext\">Coming soon</span>\n                        )}\n                      \n                        <p\n                          className={`ml-1 mt-2 ${\n                            \"Ethereum\" === item.name\n                              ? \"network-title-yellow\"\n                              : \"network-title-white\"\n                          }`}\n                          style={{ fontSize: \"14px\" }}\n                        >\n                          {item.name === \"Binance SmartChain\" ? (\n                            <p>\n                              {\"Binance\"} <br /> {\"SmartChain\"}\n                            </p>\n                          ) : (\n                            item.name\n                          )}\n                        </p>\n                      </div>\n                    );\n                  })} */}\n                  {\n                    <div\n                      className=\"network d-flex\"\n                      disabled={true}\n                      //  key={index}\n                    >\n                      {/* {networksData.map((item, index) => {\n                        return (\n                          <div>\n                            <img\n                              src={item.image}\n                              alt=\"coming soon\"\n                              style={{\n                                width: \"4rem\",\n                                cursor: \"pointer\",\n                              }}\n                              className={`network-img  ${\n                                \"Ethereum\" === item.name\n                                  ? \"\"\n                                  : \"selected-network\"\n                              } ${index !== 0 ? \"ml-3\" : \"ml-0\"}`}\n                            />\n                            <p\n                              className={`text-white mt-1  ${\n                                index !== 0 ? \"ml-3\" : \"ml-0\"\n                              }`}\n                            >\n                              {item.name}\n                            </p>\n                            {\"Ethereum\" !== item.name && (\n                              <span\n                                className=\"tooltiptext\"\n                                style={{\n                                  display: `${\n                                    \"Ethereum\" === item.name ? \"none\" : \"block\"\n                                  }`,\n                                }}\n                              >\n                                Coming soon\n                              </span>\n                            )}\n                          </div>\n                        );\n                      })} */}\n                      <div className=\"\">\n                        <img\n                          src={networksData[0].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\n                            \"Ethereum\" === networksData[0].name\n                              ? \"\"\n                              : \"selected-network\"\n                          }`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[0].name}\n                        </p>\n                      </div>\n                      <div className=\" ml-3 polygon position-relative\">\n                        <span className=\"tooltiptext1 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[1].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[1].name}\n                        </p>\n                      </div>\n\n                      <div className=\" ml-3 cardano position-relative\" >\n                        <span className=\"tooltiptext2 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[2].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[2].name}\n                        </p>\n                      </div>\n\n                      <div className=\" ml-3 binance position-relative\">\n                        <span className=\"tooltiptext3 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[3].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img   ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                        {\"Binance\"} <br /> {\"SmartChain\"}\n                        </p>\n                      </div>\n                    </div>\n                  }\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-4\"\n                onClick={() => history.push(\"/fourStepForm\")}\n              >\n                Lets Start\n              </button>\n            </div>\n\n            <div className=\"d-flex  home-slider-wrapper \">\n              <div\n                className=\"home-slider-container\"\n                style={{ marginLeft: \"2rem\" }}\n              >\n                <SimpleSlider assetList={WordsFamousNfts} />\n                {/* {\n                  !spinner &&\n\n                  }\n                  <div className=\"d-flex justify-content-center align-items-center h-100\" style={{display:`${spinner?\"none\":\"block\"}`}}>\n\n                    <div className=\"lds-ellipsis\"><div></div><div></div><div></div><div></div></div>\n                  </div>  */}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// const mapStateToProps = (state) =>\n//   // console.log(state, \"state\"),\n//   ({\n//     hometest: state.home,\n//   });\n\n// export default connect(mapStateToProps, {\n//   hometest,\n// })(Home);\nexport default Home;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/index.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Navbar/navbar.js",["296","297","298","299","300","301","302","303","304"],"// import react from 'react'\nimport \"./navbar.css\";\nimport { useHistory } from \"react-router-dom\";\nimport { BsTwitter } from \"react-icons/bs\";\nimport { SiDiscord } from \"react-icons/si\";\nimport { FaTelegramPlane } from \"react-icons/fa\";\nimport { GrReddit } from \"react-icons/gr\";\nimport { AiFillHome } from \"react-icons/ai\";\nimport mintsLogoSmily from \"../../assets/images/mintsClubSmilyLogo1.png\";\nimport MintsClub from \"../../assets/images/MintsClub-White.png\";\nimport { ENV } from \"../../config/config\";\nimport fullNavIcon from \"../../assets/images/mintsClubLogo1.png\";\n\nconst Navbar = () => {\n  const history = useHistory();\n  const twitter = ENV.twitterLink;\n  const discordLink = ENV.discordLink;\n  const telegramLink = ENV.telegramLink;\n  const redditLink = ENV.redditLink;\n\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n\n  return (\n    <div className=\"nav align-items-center\">\n      <input type=\"checkbox\" id=\"nav-check\" />\n      {/* <div className=\"nav-icon\" ><img src={fullNavIcon} width=\"20%\" /></div> */}\n      <div className=\"nav-header\" style={{ width: \"25%\" }}>\n        <div className=\"nav-title\" onClick={() => history.push(\"/\")}>\n          <img src={MintsClub} width=\"100%\" />\n        </div>\n      </div>\n      <div className=\"nav-btn\">\n        <label htmlFor=\"nav-check\">\n          <span></span>\n          <span></span>\n          <span></span>\n        </label>\n      </div>\n\n      <div className=\"nav-links\">\n        <AiFillHome className=\"home-icon \" />\n        <a\n          className=\"navbar-item\"\n          href=\"#\"\n          target=\"_blank\"\n          style={{ color: \"#ffd33e\" }}\n        >\n          Home\n        </a>\n\n        {twitter && twitter.length > 0 && (\n          <>\n            <BsTwitter className=\"home-icon \" />\n            <a className=\"navbar-item\" href={twitter} target=\"_blank\">\n              Twitter\n            </a>\n          </>\n        )}\n\n        {discordLink && discordLink.length > 0 && (\n          <>\n            <SiDiscord className=\"home-icon \" />\n            <a className=\"navbar-item\" href={discordLink} target=\"_blank\">\n              Discord\n            </a>\n          </>\n        )}\n\n        {telegramLink && telegramLink.length > 0 && (\n          <>\n            <FaTelegramPlane className=\"home-icon \" />\n            <a className=\"navbar-item\" href={telegramLink} target=\"_blank\">\n              Telegram\n            </a>\n          </>\n        )}\n\n        {redditLink && redditLink.length > 0 && (\n          <>\n            <GrReddit className=\"home-icon \" />\n            <a className=\"navbar-item\" href={redditLink} target=\"_blank\">\n              Reddit\n            </a>\n          </>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Navbar;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/exportData.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Slider/slider.js",["305","306","307"],"import React, { useState, useEffect } from \"react\";\nimport \"./slider.css\";\nimport Slider from \"react-slick\";\nimport \"slick-carousel/slick/slick.css\";\nimport \"slick-carousel/slick/slick-theme.css\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\n// import image from \"../../assets/images/test.jpg\";\nimport nftBack from \"../../assets/images/nftBack.png\";\n// import nftImage from \"../../assets/images/nftImage.png\";\n\nconst SimpleSlider = (props) => {\n  const [showSlider, setShowSlider] = useState(false);\n  useEffect(() => {\n    if (showSlider == false) {\n      setTimeout(() => {\n        setShowSlider(true);\n      }, 300);\n    }\n  });\n  const settings = {\n    dots: true,\n    infinite: true,\n    speed: 500,\n    slidesToShow: 1,\n    slidesToScroll: 1,\n  };\n\n  return (\n    <div\n      className=\"position-relative slider-container\"\n      style={{ backgroundColor: \"\" }}\n    >\n      {/* <h2> Single Item</h2> */}\n\n      <img\n        src={nftBack}\n        style={{ width: \"26rem\", minWidth: \"26rem\" }}\n        className=\"slider-bg\"\n      />\n\n      <div\n        className=\"position-absolute nfts-title-container\"\n        style={{ top: \"-3rem\", right: \"9rem\" }}\n      >\n        <p\n          className=\"text-white mb-0 worlds-famous\"\n          style={{\n            fontSize: \"34px\",\n            fontWeight: \"bold\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          World's Famous\n        </p>\n        <p\n          className=\"mb-0 text-white nfts-title\"\n          style={{\n            // fontSize: \"165px\",\n            fontSize: \"8.2vw\",\n            fontWeight: \"bold\",\n            marginTop: \"-3rem\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          NFT's\n        </p>\n      </div>\n      <div\n        className=\"position-relative slider-wrapper\"\n        style={{\n          bottom: \"22rem\",\n          right: \"-2rem\",\n          cursor: \"pointer\",\n          display: showSlider ? \"block\" : \"none\",\n        }}\n      >\n        <Slider {...settings}>\n          {props.assetList.map((nft, index) => {\n            return (\n              <div key={index} onClick={() => window.open(nft.link)}>\n                <img\n                  src={nft.img}\n                  className=\"slider-img\"\n                  alt={nft}\n                  style={{ objectFit: \"cover\" }}\n                />\n              </div>\n            );\n          })}\n        </Slider>\n      </div>\n    </div>\n  );\n};\nexport default SimpleSlider;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/web3.js",["308","309"],"import Web3 from \"web3\";\nimport { toast } from 'react-toastify'\n// import contractAbi from './../utils/abis/token.json';\nimport {ENV} from './../config/config';\n// import liveAuctionsAbi from './abis/ARISwapToken.json'\n// import {liveAuction} from './abiSetup.js'\n// import {placeBid} from '../components/bids/bids.action'\n// import {setFixedPriceNftTOken, acceptBit, placeBidApi} from './functions'\n// import {changeOwnerShip} from './functions'\n// import { Redirect } from 'react-router-dom';\n\n// let Contract = require('web3-eth-contract');\n\n// const nftContractAddress = ENV.nftContractAddress;\n// Contract.setProvider();\n// console.log(window.web3?.currentProvider,\"current provider\")\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN)\n\n//get web3\nvar web3Provider=null;\nexport const getWeb3 = async ()=> {\n    // if(window.ethereum) {\n    //     const web3 = new Web3(Web3.givenProvider);\n    //     return web3;\n    // }\n    // else {\n    //     return false;   \n    // }\n    ////////////////////////////////\n    if (window.ethereum) {\n        web3Provider = window.ethereum;\n        try {\n          // Request account access\n          await window.ethereum.enable();\n        } catch (error) {\n          // User denied account access...\n          console.error(\"User denied account access\")\n        }\n      }\n      // Legacy dapp browsers...\n      else if (window.web3) {\n        web3Provider = window.web3.currentProvider;\n      }\n      // If no injected web3 instance is detected, fall back to Ganache\n      else {\n        web3Provider = new Web3.providers.HttpProvider('http://localhost:7545');\n      }\n\n     var web3 = new Web3(web3Provider);\n      return web3\n    ///////////////////////////////\n}\n\n// TEMP. ADDING THIS METHOD - COPY OF CONNECTMETAMASK\n// export const connectMetamaskCopy = async ()=> {\n//     if(window.ethereum) {\n//         const web3 = new Web3(Web3.givenProvider);\n//         const network = await web3.eth.net.getNetworkType();\n//         await window.ethereum.enable();\n//         let accounts = await web3.eth.getAccounts();\n//         let chainId = await web3.eth.getChainId();\n//         if(chainId !== requiredChainId) {\n//             // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n//         }\n//         return accounts[0];\n//     }\n//     else {\n//         // alert(\"Please install metamask to connect to the Marketplace\");\n//         toast.error(\"Please install metamask to connect to the Marketplace\");\n//     }\n// }\nexport const connectMetamaskCopy = async (address) => {\n    if (window.ethereum) {\n      const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      let chainId = await web3.eth.getChainId();\n      // console.log(chainId, \"chainId\");\n      let currentNetwork = getNetworkName(chainId);\n      if (!currentNetwork) {\n        toast.error(\"Please Connect your metamask with Ethereum Network\");\n        return false;\n      }\n      if (chainId !== requiredChainId) {\n        // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n      }\n      // console.log(accounts[0],\"account==>\")\n      if (accounts[0]) {\n        if(accounts[0]===address)\n        {\n          toast.success(\"wallet is already connected\");\n        }\n        else {\n  \n          toast.success(\"wallet connected\");\n        }\n        //    console.log('hello');\n        return accounts[0];\n      } else {\n        let address = await signRequest();\n  \n        toast.success(\"wallet connected\");\n        return address[0];\n      }\n    } else {\n      // alert(\"Please install metamask to connect to the Marketplace\");\n      toast.error(\"This app requires metamask,Please Install Metamask \");\n    }\n  };\n  export const getWalletAddress=async ()=>{\n    const web3 = new Web3(Web3.givenProvider);\n    // const network = await web3.eth.net.getNetworkType();\n    if(window.ethereum){\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      return accounts[0]\n    }\n  }\nexport const connectMetamask = async ()=> {\n    if(window.ethereum) {\n        const web3 = new Web3(Web3.givenProvider);\n        window.web3=new Web3(window.ethereum)\n        const network = await web3.eth.net.getNetworkType();\n        await window.ethereum.enable();\n        let accounts = await web3.eth.getAccounts();\n        let chainId = await web3.eth.getChainId();\n        if(chainId !== requiredChainId) {\n            // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n        }\n        return accounts[0];\n    }\n    else {\n        // alert(\"Please install metamask to connect to the Marketplace\");\n        toast.error(\"Please install metamask to connect to the Marketplace\");\n    }\n}\n\nexport const getNetworkNameByChainId=async ()=>{\n    if (window.ethereum) {\n      const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      let chainId = await web3.eth.getChainId();\n      // console.log(chainId,\"chainId\")\n      // console.log(chainId, \"chainId\");\n      let currentNetwork = getNetworkName(chainId);\n      // console.log(currentNetwork,\"currentNetwork==>\")\n      return currentNetwork\n    }\n  }\n  \n  const getNetworkName = (chainId) => {\n    let networks = {\n      1: \"Ethereum Mainnet\",\n      4: \"Ethereum Rinkby\",\n      3: \"Ethereum Ropsten\",\n      42: \"Ethereum Kovan\",\n      5: \"Ethereum Goerli\",\n    };\n    return networks[chainId]\n  };\n  \n\nexport const signRequest = async ()=> {\n    if(window.ethereum) {\n        // const web3 = await getWeb3();\n        // if (!web3) {\n        //     toast.error(\"No web3 instance found\");\n        //     return false;\n        // }\n   \n        const web3 = new Web3(Web3.givenProvider);\n        let accounts = await web3.eth.getAccounts();\n        let address = accounts[0];\n        let signature = await handleSignMessage(address);\n        // placeBid()\n        // console.log(signature,\"signature===>\")\n        return signature;\n    }\n    else {\n        alert(\"Please install metamask to connect to the Marketplace\");\n    }\n}\n\n// export const testing=()=>{\n//     const test=web3.eth.\n// }\n\n// export const mint = async (metaData) => {\n//     // alert(\"dfdfdf\")\n//     const web3 = await getWeb3();\n//     if (!web3) {\n//         toast.error(\"No web3 instance found\");\n//         return false;\n//     }\n//     // let tokenContract1 = new Contract(liveAuctionsAbi., nftContractAddress);\n//     try {\n   \n//         let connectedAddress = await connectMetamask();\n//         // console.log(connectedAddress,\"connectedAddress\")\n//         let tokenContract = new Contract(liveAuctionsAbi, nftContractAddress);\n//         // const txCount = await web3.eth.getTransactionCount(connectedAddress);\n//         const myNewData = await tokenContract.methods\n//             .createNewNFT(connectedAddress, metaData)\n//             .encodeABI();\n        \n//             // console.log(myNewData,\"checking create nft  result==>\")\n//         // const gasLimit = await web3.eth.estimateGas({\n//         //     from: connectedAddress,\n//         //     nonce: txCount,\n//         //     to: nftContractAddress,\n//         //     data: myNewData,\n//         // });\n//         // const gas2 = await web3.eth.getGasPrice();\n//         // const transactionParameters = {\n//         //     nonce: web3.utils.toHex(txCount), // ignored by MetaMask\n//         //     gasPrice: web3.utils.toHex(gas2), // customizable by user during MetaMask confirmation.\n//         //     gasLimit: web3.utils.toHex(gasLimit), // customizable by user during MetaMask confirmation.\n//         //     to: nftContractAddress, // Required except during contract publications.\n//         //     from: connectedAddress, // must match user's active address.\n//         //     data: myNewData, // Optional, but used for defining smart contract creation and interaction.\n//         //     // chainId: '0x3', // Used to prevent transaction reuse across blockchains. Auto-filled by MetaMask.\n//         // };\n//         // // As with any RPC call, it may throw an error\n//         // const txHash = await window.ethereum.request({\n//         //     method: 'eth_sendTransaction',\n//         //     params: [transactionParameters],\n//         // });\n//         toast.success(`Success! NFT Created successfully!`)\n//         return true;\n//     } catch (e) {\n//         // alert(\"inCatch\")\n//         let eMessage = e.message.split('{')[0] || '';\n//         // console.log(eMessage,\"message==>\")\n//         toast.error(eMessage);\n//         return false;\n//     }\n    \n// }\n\nconst handleSignMessage = (address) => {\n    return new Promise((resolve, reject) =>{\n        try {\n            const web3 = new Web3(Web3.givenProvider);\n            web3.eth.personal.sign(\n                web3.utils.fromUtf8(`${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`),\n                address,\n                (err, signature) => {\n                    if (err) return reject(err);\n                    return resolve(signature);\n                }\n            )\n        }\n        catch (e) {\n            console.log(e);\n        }\n        \n    }\n    );\n};\n\n// export const ClaimFundsAfterBidding = (token) => {\n//     // getting accounts\n//     return new Promise ( async (resolve, reject) => {\n//     const web3 = new Web3(Web3.givenProvider);\n//      let accounts = await web3.eth.getAccounts();\n//      let address = accounts[0];\n//      liveAuction.methods.ClaimFundsAfterBidding(token).send(\n//          {\n//             from:address\n//         }\n//             ).then(x=> {\n        \n//             return resolve(x);\n//         });\n//      }).catch((err)=>{\n//         //  return reject(err);\n//         console.log(\"err in catch block error===> \",err)\n//     });\n// }\n\n// export const createNft= async (metaData,nftId)=>{\n//     //getting accounts\n//     const web3 = new Web3(Web3.givenProvider);\n//     let accounts = await web3.eth.getAccounts();\n//     // console.log(accounts,\"accounts\")\n//     let address = accounts[0];\n//     // console.log(address,\"addresss==>\")\n//     console.log(metaData,\"metaData==>\")\n//     console.log(liveAuction,\"liveAuction.==>\")\n//     console.log(liveAuction.methods,\"liveAuction.methods==>\")\n//     //create NFT\n//     liveAuction.methods.createNewNFT(address,metaData).send({\n//             value: 1000000000000000,\n//             // value:0,\n//             from:address,\n//             to:address,\n//          }\n//         ).then((res)=>{\n//             // console.log(res.events.Transfer.returnValues.tokenId,\"res of createNFT===>\")\n//             let data={\n//                 nftToken:res.events.Transfer.returnValues.tokenId,\n//                 nftId\n//             }\n\n//             setNftToken(data)\n\n//             toast.success(\"NFT created successfully\")\n//             // window.location.href= '/explore-all'\n//     })\n//     .catch((err)=>{\n//         console.log('err', err)\n//         if(err.code=== 4001){\n//             let url = process.env.REACT_APP_BASE_URL + `nfts/update`;\n//              var payload = {\n//                  status: 0,\n//                  _id:nftId\n//              }\n//             fetch(url, {\n//              method: 'POST',\n//              headers: {\n//                 'content-type': 'application/json',\n//                 'Authorization': ENV.Authorization,\n//                 'x-auth-token': ENV.x_auth_token,\n//                 'Access-Control-Allow-Origin': '*',\n//                 'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n//             },\n//             body: JSON.stringify(payload)\n//         }).then(res => res.json()).then(data => {\n          \n//             console.log(data,\"data==>\")\n//             if (data.success === false) {\n//                 toast.error(err.message)\n//             } \n//         }).catch(error => {\n//             // alert(\"in setting nft then\")\n//             console.log(error,\"error in catch blcok\")\n//             if (error.response && error.response.data) {\n//                 toast.error(err.message)\n            \n//             }\n//             else {\n//         toast.error(\"Transaction Failed Please check wallet history\")\n\n//             }\n         \n//         })\n//         }\n        \n//     })\n//     // return res\n// }\n\n    //openNFTForBidding\n    // export const openNFTForBidding=async(token,timeduration)=>{\n    //     // console.log(token,timeduration,\"checking token and time duration\")\n    //      //openNFTForBidding\n    //      let tokenId=+token;\n    //      const web3 = new Web3(Web3.givenProvider);\n\n    // 