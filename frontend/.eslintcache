itsclub-front-v2/frontend-v2/frontend/src/config/config.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/FullPageLoader/FullPageLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/darkmode/DarkModeState.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/errorHandler/ErrorHandlerState.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/combineComponents.tsx",["477"],"import React, { ComponentProps, FC } from \"react\";\n\nexport const combineComponents = (...components: FC[]): FC => {\n  return components.reduce(\n    (AccumulatedComponents: any, CurrentComponent: any) => {\n      return ({ children }: any): JSX.Element => {\n        return (\n          <AccumulatedComponents>\n            <CurrentComponent>{children}</CurrentComponent>\n          </AccumulatedComponents>\n        );\n      };\n    },\n    ({ children }) => <>{children}</>\n  );\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/wallet/wallet.js",["478","479","480","481","482","483"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/signup/signup.js",["484","485","486"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/wallet/wallet.reducer.js",["487"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/home/home.reducer.js",["488","489"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/auctions.reducer.js",["490"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/explore.reducer.js",["491"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Nfts/nfts.reducer.js",["492"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION,\n  CREATE_NFT_AUTH\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  createNFTauth:false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n      case  CREATE_NFT_AUTH:\n        return {\n          ...state,\n          createNFTauth:true,\n        }\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n        createNFTauth:false\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n      case BEFORE_NFTS_BY_COLLECTION:\n        return {\n          ...state,\n          nftsByCollectionStatus: false,\n        }\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/User/user.reducer.js",["493"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Categories/categories.reducer.js",["494"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/collections.reducer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Offers/offers.reducer.js",["495"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Bids/bids.reducer.js",["496"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/footer.reducer.js",["497"],"import {SUBSCRIBE, BEFORE_FOOTER,SUBSCRIBE_RESPONSE } from '../../redux/types';\n\nconst initialState = {\n    subscribeAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n            case BEFORE_FOOTER:\n                return {\n                    ...state,\n                    subscribeAuth: false,\n                }\n                case SUBSCRIBE:\n                    return {\n                        ...state,\n                        subscribeAuth:false,  \n                    }\n                    case SUBSCRIBE_RESPONSE:\n                        return {\n                            ...state,\n                            subscribeAuth:true,\n                        }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["498"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/home/home.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/home-auction-list.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/not-found/not-found.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/top-seller/topsellerlist.tsx",["499","500","501"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/aboutus/aboutus.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/faqs/faqs.tsx",["502","503"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/privacy-policy/privacyPolicy.tsx",["504"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/terms-conditions/termsConditions.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/connect-wallet/connect-wallet.tsx",["505","506"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/explore-collections/explore-collections.tsx",["507","508","509","510","511"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n  FC,\n} from \"react\";\nimport \"./explore-collections.scss\";\nimport CollectionsCard from \"../../Components/CollectionsCards/CollectionsCard\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { Images } from \"../../assets/assets\";\nimport FullPageLoader from \"../../Components/FullPageLoader/FullPageLoader\";\nimport OwnCollectionToday from \"../../Components/OwnCollectionToday/OwnCollectionToday\";\nimport Banner from \"../../Components/Banner/Banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport { exploreCollectionBanner } from \"../../utils/exportData\";\nimport { ExploreCollectionInt } from \"../../interfaces/ExploreCollections/interface\";\nconst ExploreCollections: FC<ExploreCollectionInt> = (props) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState<any[] | null>(null);\n  const [categoriesLoader, setCatLoader] = useState(true);\n  const [collectionsLoader, setColLoader] = useState(true);\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState<any[] | null>(null);\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState<any>(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n\n    if (props.setLoader) props.setLoader(false);\n\n    getCollections(null, 1, null);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item: any) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (\n    category: string | null,\n    page: number | null,\n    pageLimit: number | null\n  ) => {\n    const filter: any = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  // useImperativeHandle(ref, () => ({\n  //   getCatCollections: (catId:string) => {\n  //     if (props.setLoader) props.setLoader(true);\n\n  //     getCollections(catId, page);\n  //   },\n  //   colCount: collections?.length || 0,\n  // }));\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n  const handleFilterCategory = (category: string) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item: any, index: number) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter(\n        (nft: any) => nft.fileType === \"image\"\n      );\n      if (result.length >= index && result.length !== 0) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper pt-0\">\n          <Banner\n            subHeading={exploreCollectionBanner.subHeading}\n            heading={exploreCollectionBanner.heading}\n            content={exploreCollectionBanner.content}\n            bgImg={BannerBg}\n            bannerImg={BannerImage}\n          />\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item: any, index: number) => {\n                      return (\n                        <button\n                          key={index}\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item: any, index: any) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\" key={index}>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-1 align-items-center justify-content-center\">\n              {loader ? (\n                <div className=\"spinner-border\" role=\"status\">\n                  <span className=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection: any, index: number) => {\n                  return (\n                    <div className=\"col-sm-6 col-md-4 col-xl-3\" key={index}>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : \"\"\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                        ownerAddress={collection?.ownerAddress}\n                        connectedAddress={props.connectedAddress}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 d-flex justify-content-center align-items-center\">\n                  {!empty &&\n                    collections?.length === 10 &&\n                    !loader &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-rounded-bordered px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more...\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n          <OwnCollectionToday />\n        </section>\n      )}\n    </>\n  );\n};\nconst mapStateToProps = (state: any) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollections,\n  beforeCategory,\n  getCategories,\n  toggleLikeDislike,\n})(ExploreCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/popular-collections-list/popular-collections-list.tsx",["512","513","514","515"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collection-details/collectiondetails.tsx",["516","517","518"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/all-nfts/allnft.tsx",["519","520","521","522","523"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/darkmode/DarkModeContext.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/errorHandler/ErrorHandlerContext.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/create-nft.tsx",["524","525","526","527"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/sell-nft/SellNFT.tsx",["528","529","530","531","532","533","534","535","536","537","538","539","540","541","542"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/nft-detail/nftdetail.tsx",["543","544","545","546","547","548","549","550","551","552","553","554","555","556","557","558","559","560","561","562","563","564","565","566","567","568","569","570","571","572","573"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/user-profile/UserProfile.tsx",["574","575","576","577","578","579","580","581","582","583","584"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-collections/CreateCollections.tsx",["585","586","587","588","589","590","591","592","593","594","595","596"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/user-edit-profile/user-edit-profile.tsx",["597","598","599","600","601","602","603","604","605"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout/layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/home-layout/home-layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/collections.actions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/User/user.action.js",["606","607"],"import { toast } from 'react-toastify';\nimport { ENV } from '../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../../pages/collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/web3.js",["608"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\nexport const getChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    return chainId;\n  }\n};\nexport const validateNetwork = async () => {\n  let prevNetwork = await getNetworkNameByChainId();\n\n  if (prevNetwork === \"Ethereum Rinkby\") {\n    return true;\n  } else {\n    return false;\n  }\n};\nexport const getBalance = async () => {\n  let web3 = await getWeb3();\n  let address = await getWalletAddress();\n  let balance = await web3.eth.getBalance(address);\n  let ethBalance = web3.utils.fromWei(balance, \"ether\");\n\n  return ethBalance;\n};\n\nexport const mintNFt = async (metaData, amount) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, metaData)\n      .send({ from: connectedAddress });\n\n    return result;\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const openNFTForBidding = async (\n  biddingTime,\n  startTime,\n  tokenId,\n  copies\n) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id = Number(tokenId);\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id, copies)\n      .send({ from: connectedAddress });\n    let web3 = await getWeb3();\n    let sellId = await web3.utils.hexToNumber(result.events[0].raw.data);\n    if (sellId) {\n      return sellId;\n    }\n  } catch (err) {\n    throw new Error(err);\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const bidAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n    // let bidAmount = Number(amount) * 1000000000000000000;\n    console.log(bidAmount, \"bidAmount\");\n    let id = Number(tokenId);\n    let web3 = await getWeb3();\n\n    const result = await contractM.methods\n      .bid(id)\n      .send({\n        from: connectedAddress,\n        value: bidAmount,\n        gasPrice: web3.utils.toHex(web3.utils.toWei(\"10\", \"gwei\")),\n      });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err,\"error while bidding\")\n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\n\nexport const putonsale = async (tokenId, amount, price) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let weiAmount = BigInt(Web3.utils.toWei(price, \"ether\"));\n    let web3 = await getWeb3();\n    let id = Number(tokenId);\n    const result = await contractM.methods\n      .putonsale(id, amount, weiAmount)\n      .send({\n        from: connectedAddress,\n        gasPrice: web3.utils.toHex(web3.utils.toWei(\"10\", \"gwei\")),\n      });\n    let sellId = await web3.utils.hexToNumber(result.events[0].raw.data);\n    if (sellId) {\n      return sellId;\n    }\n  } catch (err) {\n    // console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const BuyFixedPriceNFT = async (\n  amount,\n  tokenId,\n  setConfirmed,\n  setTransactionHash\n) => {\n  setConfirmed(\"pending\");\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n\n    const weiAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n\n    const result = await contractM.methods\n      .BuyFixedPriceNFT(tokenId)\n      .send({ from: connectedAddress, value: weiAmount, gas: 5000000 })\n      .on(\"transactionHash\", function (hash) {\n        setTransactionHash(hash);\n        setConfirmed(true);\n      })\n      .on(\"confirmation\", function (confirmationNumber, receipt) {});\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    setConfirmed(false);\n    // console.log(err);\n\n    throw new Error(err);\n  }\n};\nexport const setApprovalForAll = async (setApprovalStatus) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const result = await contractM.methods\n      .setApprovalForAll(ENV.mintsClubContractAddress, true)\n      .send({\n        from: connectedAddress,\n      })\n      .on(\"transactionHash\", function (hash) {\n        // setTransactionHash(hash);\n        setApprovalStatus(\"in-progress\");\n      });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const claimNFTfromContract = async (tokenId) => {\n  try {\n    let web3 = await getWeb3();\n    let connectedAddress = await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.claimNft(tokenId).send({\n      from: connectedAddress,\n      gasPrice: web3.utils.toHex(web3.utils.toWei(\"10\", \"gwei\")),\n\n    });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    // console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\nexport const endAuctionFromContract = async (tokenId) => {\n  try {\n    let web3 = await getWeb3();\n    let connectedAddress = await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.auctionEnd(tokenId).send({\n      from: connectedAddress,\n      gasPrice: web3.utils.toHex(web3.utils.toWei(\"10\", \"gwei\")),\n    });\n    if (result) {\n      // console.log(result, \"result\");\n      return result;\n    }\n  } catch (err) {\n    // console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const getMetamaskConnectedAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      // toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        // toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      // toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\nexport const connectWithMetamask = async () => {\n  try {\n    let web3 = await getWeb3();\n    await window.ethereum.request({\n      method: \"wallet_requestPermissions\",\n      params: [\n        {\n          eth_accounts: {},\n        },\n      ],\n    });\n    let accounts = await web3.eth.getAccounts();\n    return accounts[0];\n  } catch (err) {\n    toast.error(err.message);\n  }\n};\n\nexport const switchNetworkToChainId = async (id) => {\n  if (window.ethereum) {\n    try {\n      let web3 = await getWeb3();\n      await web3.currentProvider.request({\n        method: \"wallet_switchEthereumChain\",\n        params: [{ chainId: Web3.utils.toHex(4) }],\n      });\n      let accounts = await web3.eth.getAccounts();\n      return accounts[0];\n    } catch (err) {\n      toast.error(err.message);\n      throw new Error(err);\n    }\n  }\n};\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\n\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      // console.log(e);\n    }\n  });\n};\n\n\n\n\n\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Banner/Banner.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/exportData.js",["609"],"import nft1 from \"../assets/images/famous1.jpeg\";\nimport nft2 from \"../assets/images/famous2.webp\";\nimport nft3 from \"../assets/images/famous3.jpg\";\nimport nft4 from \"../assets/images/famous4.jpg\";\nimport nft5 from \"../assets/images/famous5.png\";\nimport nft6 from \"../assets/images/famous6.jpeg\";\nimport nft7 from \"../assets/images/famous7.jpeg\";\nimport { aboutusImages } from \"../assets/assets\";\n\nimport {\n  AiFillHeart,\n  BsTagFill,\n  GrTransaction,\n  MdShoppingCart,\n} from \"react-icons/all\";\nexport const WordsFamousNfts = [\n  {\n    img: nft3,\n  },\n  {\n    img: nft2,\n  },\n  {\n    img: nft1,\n  },\n  { img: nft4 },\n  { img: nft5 },\n  { img: nft6 },\n  { img: nft7 },\n];\n\nexport const iconByActivity = {\n  minted: <MdShoppingCart />,\n  transfer: <GrTransaction />,\n  list: <BsTagFill />,\n};\n////About Us/////\n\nexport const aboutUsBanner = {\n  subHeading: \"Who we are\",\n  heading: \"Company Profile\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nexport const services = [\n  {\n    name: \"Blockchain Consultancy\",\n    img: aboutusImages.consultancy,\n  },\n  {\n    name: \"Token Development\",\n    img: aboutusImages.development,\n  },\n  {\n    name: \"NFT Marketplace\",\n    img: aboutusImages.marketplace,\n  },\n  {\n    name: \"DApp Development\",\n    img: aboutusImages.dapp,\n  },\n  {\n    name: \"DeFi Development\",\n    img: aboutusImages.defi,\n  },\n  {\n    name: \"Crypto Exchange Development\",\n    img: aboutusImages.crypto,\n  },\n];\n\nexport const comingSoon = [\n  {\n    name: \"Binance\",\n    img: aboutusImages.binance,\n  },\n  {\n    name: \"Cardano\",\n    img: aboutusImages.cardano,\n  },\n  {\n    name: \"Solana\",\n    img: aboutusImages.solana,\n  },\n  {\n    name: \"Algorand\",\n    img: aboutusImages.algoran,\n  },\n];\n\nexport const getBannerData=(subHeading,heading)=>{\n return  {\n    subHeading: subHeading,\n    heading: heading,\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n}\n//All NFTs\nexport const AllNFTsbBanner = {\n  subHeading: \"Explore\",\n  heading: \"All NFTs\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//Explore Collections\nexport const exploreCollectionBanner = {\n  subHeading: \"Collections\",\n  heading: \"Explore all\",\n  content:\n    \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//Create NFT\nexport const createNFTbanner = {\n  subHeading: \"Get Started\",\n  heading: \"Create NFT\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//Faqs\nexport const faqsBanner = {\n  subHeading: \"Ask\",\n  heading: \"FAQ\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nexport const faqsData = [\n  {\n    question: \"What is MintsClub?\",\n    ans: \"MintsClub is a revolutionary 21st Century blockchain product that brings users one step closer to experiencing Metaverse. The users can mint their digital assets such as images, GIFs, games, sports accessories and more into the cryptomarket and establish a stable revenue stream.\",\n  },\n  {\n    question: \"What is a MintsClub token?\",\n    ans: \"MintsClub token, famously known as Non-fungible Token (NFT) is a distinct cryptographic token that exists on the blockchain platform and cannot be replicated. Tokenization of digital assets has made it easier to buy and sell while reducing the threat of fraudulent acts.\",\n  },\n  {\n    question: \"What is the total supply of MINT?\",\n    ans: \"The total supply of 1-inch Mint tokens is 1.5 billion.\",\n  },\n  {\n    question: \"Where can I buy/sell MINT?\",\n    ans: \"You can sell your NFTs on blockchain marketplaces such as Binance, Cardano, Solana and Algoran and now, MintsClub.\",\n  },\n];\n\n//NFT Data\nexport const nftBanner = {\n  subHeading: \"NFT\",\n  heading: \"NFT Details\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//popular-collections-list\nexport const popularBanner = {\n  subHeading: \"Collections\",\n  heading: \"Popular Collections\",\n  content:\n    \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//privacePolicy \nexport const privacyBanner = {\n  subHeading: \"Our Privacy Policy\",\n  heading: \"Privacy Policy\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//sellNFT\nexport const sellNFTBanner = {\n  subHeading: \"NFT\",\n  heading: \"NFT Details\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/explore.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/Footer.tsx",["610","611","612","613","614","615","616"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Nfts/nfts.action.js",["617","618"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION,\n  CREATE_NFT_AUTH,\n} from \"../../redux/types\";\nimport { ENV } from \"../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { axiosPostFormData, handleRequest } from \"../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\n\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(method, `/nfts/${type}`, body);\n      console.log(result, \"result\");\n      const { data, success, message } = result.data;\n      if (success) {\n        toast.success(message);\n        dispatch({\n          type: UPSERT_NFT,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(\"get\", \"nfts/list\", null, qs);\n      const { data, success } = result.data;\n      if (success) {\n        dispatch({\n          type: GET_NFTS,\n          payload: data,\n        });\n        dispatch({\n          type: NFTALL,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const getNFT = (nftId) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let result = await handleRequest(\"get\", `nfts/get/${nftId}`);\n    const { data, success } = result.data;\n    if (success) {\n      dispatch({\n        type: NFTALL,\n        payload: data,\n      });\n      dispatch({\n        type: GET_NFT,\n        payload: data,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: result.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const createActivity = (body) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let res = await handleRequest(\"post\", \"activity/create\", body);\n    const { success, data } = res.data;\n    if (!success) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: res.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getActivities =\n  (qs = null) =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(\"get\", \"activity/get\", null, qs);\n      const { data, success } = result.data;\n      if (success) {\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\nexport const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n    axios\n      .get(url)\n      .then(function (response) {\n        dispatch({\n          type: GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\nexport const beforeNFTByCollection = () => (dispatch) => {\n  dispatch({\n    type: BEFORE_NFTS_BY_COLLECTION,\n  });\n};\n\nexport const getNFTsByCollection = (id) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let payload = {\n      collectionId: id,\n    };\n    let result = await handleRequest(\n      \"post\",\n      \"nfts/getNFTsByCollection\",\n      payload\n    );\n    const { data, success } = result.data;\n    if (success) {\n      dispatch({\n        type: GET_NFTS_BY_COLLECTION,\n        payload: data,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: result.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      const res = await handleRequest(\"get\", \"nftLikes/userNftLikes\", null, qs);\n      const { success, data } = res.data;\n      if (success) {\n        dispatch({\n          type: GET_MYLIKED_NFTS,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: res.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const createNFT = async (formData) => async (dispatch) => {\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  try {\n    const res = await handleRequest(\"post\", \"nfts/storeNFTData\", formData);\n    const { success } = res.data;\n    if (success) {\n      toast.success(\"NFT created successfully\");\n      dispatch({\n        type: CREATE_NFT_AUTH,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: res.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n\n    try {\n      const res = await handleRequest(\"get\", \"nfts/list\", null, qs);\n      const { data, success } = res.data;\n      if (success) {\n        dispatch({\n          type: GET_PROFILE_NFTS,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: res.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/HomeAuctions.ts",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/PopularCollections.ts",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/CollectionDetails.ts",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/AllNFTs.ts",["619"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/home-auctions.tsx",["620","621"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/top-seller/topseller.tsx",["622"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/popular-collections.tsx",["623","624","625","626","627","628"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Hero/Hero.tsx",["629","630"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/OwnCollectionToday/OwnCollectionToday.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/BuySell/BuySell.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/AuctionsCards/AuctionsCards.tsx",["631"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Listing/Listing.tsx",["632","633","634"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/NavbarMain/NavbarMain.tsx",["635","636","637","638","639"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/CardSlider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/CollectionsCards/CollectionsCard.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/AuctionAudio/AuctionAudio.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/ImageLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/TestVideoCard/Components/UseVideoPlayer.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/NftCard/NftCard.tsx",["640","641","642","643"],"import React, { useState, FC } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport useVideoPlayer from \"../TestVideoCard/Components/UseVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport placeholderImg from \"../../assets/images/placeholder.png\";\nimport { connect } from \"react-redux\";\nimport \"./NftCard.scss\";\nimport { Images } from \"../../assets/assets\";\nimport ImageLoader from \"../ContentLoader/ImageLoader\";\nimport Audio from \"../Audio/Audio\";\nimport { NFTCardInt } from \"../../interfaces/components\";\n\nconst NFTCard: FC<NFTCardInt> = (props) => {\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay } = useVideoPlayer(videoElement);\n  const [loader, setLoader] = useState<any>(true);\n  const {\n    image,\n    name,\n    _id,\n    fileType,\n    cardBg,\n    ownerId,\n    likeCount,\n    currentPrice,\n    copies,\n    remainingCopies,\n    ownerAddress,\n  } = props.data;\n  const { username, profileImage, profilePhoto } = props?.owner;\n  const { likedNfts } = props;\n  const validateIfLiked = (likedNfts1: any, id: string) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className={`nft-card ${cardBg} m-1 mx-auto mx-sm-1`}>\n      <div className=\"nft-img-wrapper\">\n        {fileType === \"image\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Card.Img\n              variant=\"top\"\n              onLoad={() => setLoader(false)}\n              onClick={() => history.push(`${props.path}${_id}`)}\n              src={image}\n              alt=\"AuctionTopImg\"\n              style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n            />\n          </>\n        ) : fileType === \"video\" ? (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n                <ImageLoader />\n              </div>\n              <video\n                id=\"video1\"\n                src={image}\n                ref={videoElement}\n                onEnded={() => {\n                  togglePlay();\n                }}\n                onCanPlay={() => {\n                  setLoader(false);\n                }}\n                style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : fileType === \"audio\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Audio\n              src={image}\n              onLoadCallback={() => {\n                setLoader(false);\n                return false;\n              }}\n              loader={loader}\n              fileType={fileType}\n            />\n          </>\n        ) : (\n          \" \"\n        )}\n      </div>\n      <Card.Body>\n        <Card.Title>\n          <div>\n            {name && name.length > 15 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"nft-owner-price d-flex align-items-center\">\n            <span className=\"me-2\">{likeCount ? likeCount : 0}</span>\n            {!validateIfLiked(likedNfts, _id) ? (\n              <img\n                src={Images.whiteEmptyHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"like\", likeCount);\n                }}\n              />\n            ) : (\n              <img\n                src={Images.whiteFillHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"dislike\", likeCount);\n                }}\n              />\n            )}\n          </div>\n        </Card.Title>\n        <div className=\"nft-status \">\n          <div className=\"status-info status-sold\">\n            <span className=\"status\">\n              Sold:{\" \"}\n              <span className=\"status-count\">{copies - remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n          <div className=\"status-info status-remaining\">\n            <span className=\"status\">\n              Remaining: <span className=\"status-count\">{remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-3\">\n          <span className=\"nft-price mt-2\">\n            <img className=\"me-2\" src={Images.nftPriceTag} />\n            Price:<a className=\"price ms-1\">{currentPrice} ETH</a>\n          </span>\n        </div>\n        <div className=\"nft-card-owner-container d-flex align-items-center mb-2 mt-3\">\n          <div className=\"nft-owner-avatar\">\n            <img\n              src={\n                !profilePhoto && !profileImage\n                  ? placeholderImg\n                  : profilePhoto\n                  ? profilePhoto\n                  : profileImage\n              }\n              alt=\"avatar\"\n            />\n          </div>\n          <div className=\"ms-2 nft-owner-name\">\n            <p>\n              {\"Owned by:\"}\n              <span className=\"text-capitalize ms-1\">\n                {ownerAddress?.toUpperCase() ===\n                props.connectedAddress?.toUpperCase()\n                  ? \"You\"\n                  : username && username?.length > 19\n                  ? username.substring(0, 19) + \"...\"\n                  : username?.length <= 19\n                  ? username\n                  : \"unnamed\"}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"nft-bit-btn\"\n          onClick={() => history.push(`${props.path}${_id}`)}\n        >\n          {\"View Detail\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state: any) => ({\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {})(NFTCard);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/DarkModeButton/DarkModeButton.tsx",["644"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/CollectionSubLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Audio/Audio.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/footer.action.js",["645"],"import { ENV } from \"../../config/config\";\nimport {\n  GET_ERRORS,\n  BEFORE_FOOTER,\n  GET_FOOTER,\n  SUBSCRIBE_RESPONSE,\n  SUBSCRIBE,\n} from \"../../redux/types\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport axios from \"axios\";\n\nexport const beforeFooter = () => {\n  return {\n    type: BEFORE_FOOTER,\n  };\n};\n\nexport const getFooter = () => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({ type: SUBSCRIBE });\n  const url = `${ENV.url}/settings/get`;\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        dispatch({\n          type: GET_FOOTER,\n          payload: data.settings,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const subscribeUser = (email) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    const response = await axios.post(`${ENV.url}users/subscribe`, { email });\n    dispatch({\n      type: SUBSCRIBE_RESPONSE,\n    });\n    // console.log(response, \"response\");\n  } catch (error) {\n    // console.log(error.response, \"error\");\n    dispatch({\n      type: GET_ERRORS,\n      payload: error.response.data,\n    });\n  }\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/HeroCards/HeroCards.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Offers/offers.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Bids/bids.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/NftDetailLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Table/Table.tsx",["646"],"import { useEffect, useState } from \"react\";\nimport {\n  BsTagFill,\n  BiTransferAlt,\n  MdShoppingCart,\n  FaHandPaper,\n} from \"react-icons/all\";\nimport ReactTimeAgo from \"react-time-ago\";\nimport { TableInterface } from \"../../interfaces/components\";\nconst Table: React.FC<TableInterface> = ({\n  titles,\n  data,\n  lowestNftPrice,\n  exchangeRate,\n  status,\n}) => {\n  const [info, setInfo] = useState<any>(null);\n\n  useEffect(() => {\n    if (status === \"Offers\") {\n      formateBidsInfo();\n    } else {\n      formateActivityInfo();\n    }\n  }, [data]);\n\n  const getPercentageChange = (oldNumber: number, newNumber: number) => {\n    var decreaseValue = oldNumber - newNumber;\n\n    return (decreaseValue / oldNumber) * 100;\n  };\n\n  const handleAcitivityIcon = (type: string) => {\n    if (type === \"Mint\") {\n      return <MdShoppingCart />;\n    } else if (type === \"List\") {\n      return <BsTagFill />;\n    } else if (type === \"Bid\") {\n      return <FaHandPaper />;\n    } else {\n      return <BiTransferAlt />;\n    }\n  };\n\n  const formateBidsInfo = () => {\n    if (data && data.length > 0) {\n      let formatedData = data.map((item: any) => {\n        return {\n          item1: item.bidAmount,\n          item2: `$ ${(item.bidAmount * exchangeRate).toFixed(2)}`,\n          item3: `${\n            Number(\n              getPercentageChange(item.bidAmount, lowestNftPrice).toFixed(0)\n            ) %\n              item.bidAmount >\n            lowestNftPrice\n              ? \"above\"\n              : \"below\"\n          }`,\n          item4: `${\n            item.fromAddress.slice(0, 4) + \"...\" + item.fromAddress.slice(-4)\n          }`,\n        };\n      });\n      setInfo(formatedData);\n    }\n  };\n\n  const formateActivityInfo = () => {\n    if (data && data.length > 0) {\n      let formatedData: any = data.map((item: any) => {\n        return {\n          item1: (\n            <div className=\"d-flex align-items-center\">\n              {handleAcitivityIcon(item.activityType)}\n              <p className=\"ps-1\"> {item.activityType} </p>\n            </div>\n          ),\n          item2: item.price,\n          item3: `${\n            item.fromAddress\n              ? item.fromAddress.slice(0, 4) +\n                \"...\" +\n                item.fromAddress.slice(-6)\n              : \"null address\"\n          }`,\n          item4: `${\n            item.toAddress\n              ? item.toAddress.slice(0, 4) + \"...\" + item.toAddress.slice(-4)\n              : \"\"\n          }`,\n          item5: (\n            <div>\n              <ReactTimeAgo date={item.createdAt} locale=\"en-US\" />\n            </div>\n          ),\n        };\n      });\n      setInfo(formatedData);\n    }\n  };\n  return (\n    <div className=\"table-container\">\n      <table className=\"table table-borderless\">\n        {data && data.length > 0 && (\n          <thead>\n            <tr>\n              {titles.map((item: any) => {\n                return <th scope=\"col\">{item}</th>;\n              })}\n            </tr>\n          </thead>\n        )}\n        <tbody>\n          {info && info.length > 0 ? (\n            <>\n              {info.map((val: any, index: any) => {\n                return (\n                  <tr key={index}>\n                    <th scope=\"row\">{val.item1}</th>\n                    <td>{val.item2}</td>\n                    <td>{val.item3}</td>\n                    <td>{val.item4}</td>\n                    {val.item5 && <td>{val.item5}</td>}\n                  </tr>\n                );\n              })}\n            </>\n          ) : (\n            <p className=\"text-center d-flex justify-content-center align-items-center\">\n              {` No ${status} Found`}\n            </p>\n          )}\n        </tbody>\n      </table>\n    </div>\n  );\n};\nexport default Table;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/levelsinfo.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/statsinfo.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/SellNFTLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/BidModal/BidModal.tsx",["647"],"import React, { useState, useEffect, FC } from \"react\";\nimport { Modal, Button } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport \"../BuyModal/BuyModal.scss\";\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport axios from \"axios\";\nimport { BidModalInt } from \"../../../interfaces/components\";\n\nconst BidModal: FC<BidModalInt> = (props) => {\n  const [checkBox, setCheckBox] = useState<any>(false);\n  const [exchangeRate, setExchangeRate] = useState<any>(0);\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  const {\n    onChange,\n    decimalNumberValidator,\n    handleModalSubmit,\n    calculatePricePercantage,\n    onHide,\n    balance,\n    price,\n    show,\n  } = props;\n\n  return (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className={`buy-modal bid-modal ${show === true ? \"modal-is-open\" : \" \"}`}\n      centered\n      autoFocus={true}\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Place a Bid\n        </Modal.Title>\n\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to place bid!\"}\n        </p>\n\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Price</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"bid-inp-container d-flex align-items-center\">\n          <div className=\"inp-container d-flex align-items-center justify-content-between\">\n            <div>\n              <input\n                type=\"number\"\n                placeholder=\"Place Your Bid\"\n                name=\"nftConfig.price.amount\"\n                style={{ borderRadius: \"4px\" }}\n                onChange={(e) => onChange(e)}\n                onKeyDown={(e) => decimalNumberValidator(e)}\n                defaultValue={calculatePricePercantage()}\n                value={price}\n              />\n            </div>\n            <div className=\"dollar-rate text-end\">\n              <p className=\"\">\n                ${price ? (price * exchangeRate).toFixed(2) : 0}\n              </p>\n            </div>\n          </div>\n          <div className=\"inp-currency\">\n            <h6>ETH</h6>\n          </div>\n        </div>\n        <div className=\"bid-balance text-start\">\n          <p>Balance: {Number(balance).toFixed(4)} ETH</p>\n        </div>\n        {balance !== \"\" && balance === 0 && (\n          <p className=\"text-center insufcient-funds text-danger\">\n            Please Add Balance to place bid\n          </p>\n        )}\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\">Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n          onClick={() => {\n            handleModalSubmit();\n            onHide();\n          }}\n          disabled={\n            +price < calculatePricePercantage() ||\n            balance === 0 ||\n            !checkBox ||\n            +price > +balance\n          }\n        >\n          Confirm Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default BidModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/BuyModal/BuyModal.tsx",["648","649","650"],"import { useState, FC } from \"react\";\nimport { Modal, Button, Spinner } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport \"./BuyModal.scss\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../../assets/images/tick-checkbox.svg\";\nimport { ReactComponent as FbIcon } from \"../../../assets/images/fb-blue.svg\";\nimport { ReactComponent as TwitterIcon } from \"../../../assets/images/twitter-blue.svg\";\nimport { ReactComponent as LinkedinIcon } from \"../../../assets/images/linkedin-blue.svg\";\nimport { ReactComponent as InstaIcon } from \"../../../assets/images/insta-blue.svg\";\nimport { ReactComponent as VideoIcon } from \"../../../assets/images/buy-video-icon.svg\";\nimport { ReactComponent as AudioIcon } from \"../../../assets/images/audio-icon.svg\";\nimport ModalSmiley from \"../../../assets/images/model-smiley.svg\";\nimport { Buy } from \"../../../interfaces/components\";\nconst BuyModal: FC<Buy> = (props) => {\n  const [purchase, setPurchase] = useState<any>(true);\n  const [checkBox, setCheckBox] = useState<any>(false);\n  const {\n    name,\n    image,\n    price,\n    exchangeRate,\n    tokenId,\n    buyNow,\n    confirmed,\n    transactionHash,\n    transactionSuccess,\n    onHide,\n    disabled,\n    balance,\n    fileType,\n  } = props;\n\n  return confirmed === \"\" || confirmed === false || confirmed === \"pending\" ? (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Complete Checkout\n        </Modal.Title>\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to buy this NFT\"}\n        </p>\n        <div className=\"modal-close-container\">\n          <Button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                {fileType === \"image\" ? (\n                  <img src={image} alt=\"nft-img\" />\n                ) : fileType === \"video\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <VideoIcon />\n                  </div>\n                ) : fileType === \"audio\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <AudioIcon />\n                  </div>\n                ) : (\n                  \"\"\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\" target=\"_blank\">\n                Terms of Services\n              </Link>\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => {\n            buyNow();\n          }}\n          disabled={!checkBox || disabled || +price > +balance}\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n        >\n          {confirmed === \"pending\" ? (\n            <div className=\"spinner-border approve-spinner\" role=\"status\"></div>\n          ) : (\n            \"Confirm Checkout\"\n          )}\n        </button>\n      </Modal.Footer>\n    </Modal>\n  ) : (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal purchase-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          {!transactionSuccess\n            ? \"Your Purchase is Processing\"\n            : \"Your Purchase has processed!\"}\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        {transactionSuccess && (\n          <div className=\"modal-nft-purchased  mt-3\">\n            <p>\n              <span className=\"me-4\">\n                <img src={ModalSmiley} alt=\"smiley\" />\n              </span>\n              {`  Woo! You just Purchased ${\n                name && name.length > 10 ? name.slice(0, 10) + \"...\" : name\n              }. It should be confirmed on the\n              blockchain`}\n            </p>\n          </div>\n        )}\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                {fileType === \"image\" ? (\n                  <img src={image} alt=\"nft-img\" />\n                ) : fileType === \"video\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <VideoIcon />\n                  </div>\n                ) : fileType === \"audio\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <AudioIcon />\n                  </div>\n                ) : (\n                  \"\"\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n        <div className=\"buy-modal-subheadings-container buy-modal-status w-100 d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Status</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Transaction Hash</p>\n          </div>\n        </div>\n        <div className=\"modal-status-content d-flex align-items-center justify-content-between mt-2 pb-5\">\n          <div className=\"status-process d-flex align-items-center\">\n            {!transactionSuccess ? (\n              <>\n                <Spinner\n                  animation=\"border\"\n                  role=\"status\"\n                  size=\"sm\"\n                  variant=\"primary\"\n                  className=\"me-2\"\n                ></Spinner>\n                <p>Processing</p>\n              </>\n            ) : (\n              <>\n                <CheckCircleIcon />\n              </>\n            )}\n          </div>\n          <div\n            className=\"status-address\"\n            onClick={() =>\n              window.open(\n                `https://rinkeby.etherscan.io/tx/${transactionHash}`,\n                \"_blank\"\n              )\n            }\n          >\n            <p>\n              {transactionHash.slice(0, 6) +\n                \".....\" +\n                transactionHash.slice(-6)}\n            </p>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <p>Share</p>\n        </div>\n        <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n          <FbIcon\n            className=\"social-icon\"\n            onClick={() =>\n              window.open(\"https://www.facebook.com/MintsClub.io/\")\n            }\n          />\n          <TwitterIcon\n            className=\"social-icon\"\n            onClick={() => window.open(\"https://twitter.com/MintsClub\")}\n          />\n          <LinkedinIcon\n            className=\"social-icon\"\n            onClick={() =>\n              window.open(\"https://www.linkedin.com/showcase/mints-club\")\n            }\n          />\n          <InstaIcon\n            className=\"social-icon\"\n            onClick={() => window.open(\"https://www.instagram.com/mintsclub/\")}\n          />\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\nexport default BuyModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/ApprovalModal/ApprovalModal.tsx",["651","652","653"],"import { FC } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport { Images } from \"../../../assets/assets\";\nimport { ApprovalModalInt } from \"../../../interfaces/components\";\nimport \"./ApprovalModal.scss\";\n\nconst ApprovalModal: FC<ApprovalModalInt> = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n  return (\n    <>\n      {\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title className=\"acc-title mt-lg-3 mt-5\">\n              {approvalStatus === \"approved\"\n                ? \"Congratulations\"\n                : approvalStatus === \"in-progress\"\n                ? \"We’re on it\"\n                : \"Your account if not approved yet.\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\" onClick={onHide}>\n              <button>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </Modal.Header>\n          <Modal.Body>\n            {approvalStatus === \"approved\" ? (\n              <>\n                <img src={Images.sellerTickIcon} className=\"success-icon\" />\n                <div className=\"w-100 px-4 mb-2\">\n                  <div className=\"acc-approved-container mt-5 mb-5\">\n                    <p className=\"acc-approved ms-4 mb-0\">\n                      Your Account has been approved.\n                    </p>\n                    <img src={Images.smile} className=\"smile-img\" />\n                  </div>\n                </div>\n              </>\n            ) : approvalStatus === \"in-progress\" ? (\n              <>\n                <div className=\"approval-spinner mb-4\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n                <p className=\"processing-title text-center w-100\">\n                  Processing...\n                </p>\n                <div className=\"w-100 px-3\">\n                  <p className=\"approve-msg text-start ms-3 mt-3 \">\n                    Wallet Address\n                  </p>\n                  <input\n                    className=\"input-common mb-5\"\n                    value={address}\n                    readOnly\n                  />\n                </div>\n              </>\n            ) : (\n              <>\n                <img\n                  src={Images.metamaskImg}\n                  className=\"approve-metamask-img\"\n                />\n                <div className=\" w-100 px-3\">\n                  <p className=\"approve-msg w-100 text-start ms-3 mt-3 \">\n                    Please approve your wallet address to reach us\n                  </p>\n                  <input className=\"input-common\" value={address} readOnly />\n                </div>\n                <button\n                  className=\"btn btn-linear-gradient mt-4 my-4 get-approved-btn\"\n                  disabled={approvalStatus === \"pending\"}\n                  onClick={() => approveAccount()}\n                >\n                  {approvalStatus === \"pending\" ? (\n                    <div\n                      className=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>\n                  ) : (\n                    \"Get Approved\"\n                  )}\n                </button>\n              </>\n            )}\n          </Modal.Body>\n        </Modal>\n      }\n    </>\n  );\n};\nexport default ApprovalModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/StatsModal/StatsModal.tsx",["654"],"import { FC } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport InputClose from \"../../../assets/images/inp-close.svg\";\nimport \"../PropertiesModal/PropertiesModal.scss\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"../../../utils/functions\";\nimport { StatsInt } from \"../../../interfaces/components\";\nconst StatsModal: FC<StatsInt> = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item: any) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <form>\n          <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n            {stats &&\n              stats.length > 0 &&\n              stats.map((item: any, i: any) => {\n                return (\n                  <div\n                    className=\"row g-2 align-items-center justify-content-between mt-3\"\n                    key={i}\n                  >\n                    <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                      <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                        <div className=\"ps-2\">\n                          <h6>Name:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"text\"\n                            name=\"name\"\n                            value={item.name}\n                            onKeyDown={(e) =>\n                              firstInputCharacterSpace(e, item.name.length)\n                            }\n                            onChange={(e) => handleChange(i, e, \"stats\")}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                      <div className=\"d-flex align-items-center justify-content-between\">\n                        <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                          <div className=\"ps-2\">\n                            <h6>Value:</h6>\n                          </div>\n                          <div className=\"inp-container\">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              min=\"1\"\n                              onKeyDown={(e) => {\n                                decimalNumberValidator(e);\n                              }}\n                              value={item.value}\n                              onChange={(e) => {\n                                if (\n                                  +e.target.value > 5 ||\n                                  (+e.target.value <= 0 && item.value == \"\") ||\n                                  e.target.value.includes(\".\")\n                                ) {\n                                  return \"\";\n                                }\n                                handleChange(i, e, \"stats\");\n                              }}\n                              autoComplete=\"off\"\n                            />\n                          </div>\n                        </div>\n                        <div className=\"value-inp-of mx-3\">\n                          <h6>of</h6>\n                        </div>\n                        <div className=\"bid-inp-container modal-value-inp\">\n                          <div className=\"inp-container \">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              value={5}\n                              autoComplete=\"off\"\n                              className=\"text-center\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                      <div className=\"inp-close text-end me-2\">\n                        <button type=\"submit\">\n                          <img\n                            src={InputClose}\n                            alt=\"closemodal\"\n                            onClick={() => removeFormFields(i, \"stats\")}\n                          />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n          </div>\n        </form>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/prop