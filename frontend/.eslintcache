ots from '../../assets/images/threeDots.svg';\nimport ArrowUp from '../../assets/images/arrowUp.png';\nimport Bucket from '../../assets/images/bucket.png';\nimport './HeroCards.css';\nimport { Images } from '../../assets/assets';\n\nconst HeroCards = ({\n  CardImg,\n  NftName,\n  OwnerName,\n  HighestBid,\n  BidsProfile,\n  TotalBids,\n}) => {\n  return (\n    <Card className='auction-card hero-card mx-2'>\n      <div className='auction-img-wrapper'>\n        <Card.Img variant='top' src={CardImg} alt='AuctionTopImg' />\n      </div>\n      <Card.Body className='d-flex flex-column'>\n        <div className='hero-card-title-container d-flex align-items-center justify-content-between'>\n          <Card.Title>{NftName}</Card.Title>\n          <div className='options-icon'>\n            <img src={ThreeDots} alt='OptionsIcon' />\n          </div>\n        </div>\n        <div className='auction-card-avatar d-flex align-items-center mb-4'>\n          {BidsProfile &&\n            BidsProfile.length > 0 &&\n            BidsProfile.map((item, i) => {\n              if (i <= 2) {\n                return (\n                  <img\n                    src={item === null ? Images.profilePic : item}\n                    alt='AvatarImg'\n                  />\n                );\n              }\n            })}\n          <span className='ms-4'>\n            {TotalBids > 0 ? TotalBids + '+ People Place Bid' : 'No Bid Found'}\n          </span>\n        </div>\n\n        <div className='auction-card-owner-container d-flex justify-content-between align-items-center mb-2'>\n          <div className='auction-owner-name'>\n            <p>\n              {'Owned by '}\n              {OwnerName && OwnerName.length > 8\n                ? OwnerName.substring(0, 6) + '...'\n                : OwnerName}\n            </p>\n          </div>\n          <div className='d-flex align-items-center'>\n            <img src={ArrowUp} alt='' className='me-1' />\n            <span>{HighestBid}</span>\n          </div>\n        </div>\n        <button className='auction-bit-btn d-flex align-items-center justify-content-center'>\n          <img src={Bucket} alt='' className='me-1' />\n          <p>Place a Bid</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default HeroCards;\n",["674","675"],{"ruleId":"676","severity":1,"message":"677","line":10,"column":9,"nodeType":"678","messageId":"679","endLine":10,"endColumn":25},{"ruleId":"676","severity":1,"message":"680","line":11,"column":10,"nodeType":"678","messageId":"679","endLine":11,"endColumn":15},{"ruleId":"676","severity":1,"message":"681","line":15,"column":10,"nodeType":"678","messageId":"679","endLine":15,"endColumn":23},{"ruleId":"676","severity":1,"message":"682","line":15,"column":25,"nodeType":"678","messageId":"679","endLine":15,"endColumn":41},{"ruleId":"676","severity":1,"message":"683","line":18,"column":7,"nodeType":"678","messageId":"679","endLine":18,"endColumn":14},{"ruleId":"684","severity":1,"message":"685","line":21,"column":6,"nodeType":"686","endLine":21,"endColumn":11,"suggestions":"687"},{"ruleId":"676","severity":1,"message":"688","line":11,"column":8,"nodeType":"678","messageId":"679","endLine":11,"endColumn":23},{"ruleId":"676","severity":1,"message":"689","line":17,"column":8,"nodeType":"678","messageId":"679","endLine":17,"endColumn":24},{"ruleId":"676","severity":1,"message":"690","line":78,"column":9,"nodeType":"678","messageId":"679","endLine":78,"endColumn":14},{"ruleId":"676","severity":1,"message":"691","line":168,"column":9,"nodeType":"678","messageId":"679","endLine":168,"endColumn":12},{"ruleId":"692","severity":1,"message":"693","line":173,"column":15,"nodeType":"694","messageId":"695","endLine":173,"endColumn":21},{"ruleId":"676","severity":1,"message":"696","line":1,"column":28,"nodeType":"678","messageId":"679","endLine":1,"endColumn":36},{"ruleId":"697","severity":1,"message":"698","line":8,"column":1,"nodeType":"699","endLine":32,"endColumn":2},{