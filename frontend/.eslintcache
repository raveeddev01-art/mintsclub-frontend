},{"ruleId":"729","severity":1,"message":"730","line":45,"column":17,"nodeType":"684","endLine":45,"endColumn":77},{"ruleId":"729","severity":1,"message":"730","line":51,"column":21,"nodeType":"684","endLine":51,"endColumn":69},{"ruleId":"729","severity":1,"message":"730","line":76,"column":17,"nodeType":"684","endLine":79,"endColumn":19},{"ruleId":"715","severity":1,"message":"716","line":97,"column":71,"nodeType":"717","messageId":"694","endLine":97,"endColumn":73},{"ruleId":"715","severity":1,"message":"716","line":100,"column":69,"nodeType":"717","messageId":"694","endLine":100,"endColumn":71},{"ruleId":"673","severity":1,"message":"831","line":1,"column":25,"nodeType":"659","messageId":"660","endLine":1,"endColumn":44},"no-unused-vars","'useContext' is defined but never used.","Identifier","unusedVar","react-hooks/exhaustive-deps","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression","React Hook useEffect has missing dependencies: 'tawkToKey' and 'tawkToPropertyId'. Either include them or remove the dependency array. Outer scope values like 'ENV' aren't valid dependencies because mutating them doesn't re-render the component.","ArrayExpression",["832"],"React Hook useEffect has a missing dependency: 'setWallet'. Either include it or remove the dependency array.",["833"],"no-native-reassign",["834"],"no-negated-in-lhs",["835"],"@typescript-eslint/no-unused-vars","'ComponentProps' is defined but never used.","'validateNetwork' is defined but never used.","React Hook useEffect has a missing dependency: 'props'. Either include it or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["836"],"React Hook useEffect has missing dependencies: 'history' and 'props'. Either include them or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["837"],"React Hook useEffect has a missing dependency: 'handleMetamaskStatus'. Either include it or remove the dependency array.",["838"],"jsx-a11y/anchor-is-valid","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","React Hook useEffect has a missing dependency: 'history'. Either include it or remove the dependency array.",["839"],"'sign' is assigned a value but never used.","import/no-anonymous-default-export","Unexpected default export of anonymous function","ExportDefaultDeclaration","no-dupe-keys","Duplicate key 'featuredItems'.","ObjectExpression","unexpected","'setLimit' is assigned a value but never used.",["840"],["841"],"'Accordion' is defined but never used.","'Card' is defined but never used.","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"842","text":"843"},"'useState' is defined but never used.","'Button' is defined but never used.","'forwardRef' is defined but never used.","'useImperativeHandle' is defined but never used.","React Hook useEffect has missing dependencies: 'getCollections' and 'props'. Either include them or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["844"],["845"],["846"],"'error' is assigned a value but never used.","React Hook useEffect has a missing dependency: 'refetchPopular'. Either include it or remove the dependency array.",["847"],"eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","'setDisabled' is assigned a value but never used.","no-empty-pattern","Unexpected empty object pattern.","ObjectPattern","array-callback-return","Array.prototype.map() expects a value to be returned at the end of arrow function.","expectedAtEnd",["848"],"'isLoading' is assigned a value but never used.","'Component' is defined but never used.","'errorMessage' is assigned a value but never used.","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","'dateRangeInitialSettings' is assigned a value but never used.","'toggle' is assigned a value but never used.","'setToggle' is assigned a value but never used.","'loader' is assigned a value but never used.","'likedNfts' is assigned a value but never used.","'setLikedNfts' is assigned a value but never used.","React Hook useEffect has missing dependencies: 'address' and 'history'. Either include them or remove the dependency array.",["849"],["850"],["851"],"jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'getBannerData' is defined but never used.","'listedItem' is assigned a value but never used.","'setListedItem' is assigned a value but never used.","'offers' is assigned a value but never used.","React Hook useEffect has missing dependencies: 'nftId', 'props', and 'userId'. Either include them or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["852"],["853"],"React Hook useEffect has missing dependencies: 'history', 'nftId', and 'props'. Either include them or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["854"],["855"],["856"],"React Hook useEffect has a missing dependency: 'props.offers'. Either include it or remove the dependency array. If 'setOffers' needs the current value of 'props.offers', you can also switch to useReducer instead of useState and read 'props.offers' in the reducer.",["857"],"React Hook useEffect has a missing dependency: 'props.bids'. Either include it or remove the dependency array. If 'setBids' needs the current value of 'props.bids', you can also switch to useReducer instead of useState and read 'props.bids' in the reducer.",["858"],"React Hook useEffect has missing dependencies: 'props' and 'setNextBidFivePercHigh'. Either include them or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["859"],"React Hook useEffect has missing dependencies: 'nftDetail._id' and 'props'. Either include them or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["860"],["861"],"React Hook useEffect has a missing dependency: 'props.activities'. Either include it or rem