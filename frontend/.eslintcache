gCount":0,"usedDeprecatedRules":"260"},{"filePath":"593","messages":"594","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"595","usedDeprecatedRules":"260"},{"filePath":"596","messages":"597","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"260"},"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/index.js",[],["598","599"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/App.js",["600","601"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport GaTracker from \"./gaTracker/gaTracket\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\n// import 'swiper/swiper-bundle.css';\n\nconst App = () => {\n  // GaTracker()\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  useEffect(() => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={true}\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n};\n\nexport default App;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/routes.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/gaTracker/gaTracket.js",["602"],"import { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport ReactGA from \"react-ga\";\nimport { connect } from \"react-redux\";\nimport { useSelector } from \"react-redux\";\n\n\n\nconst useGaTracker = () => {\n    const step=useSelector((state)=>state.dashboard.currentStep)\n    const location = useLocation();\n    const [initialized, setInitialized] = useState(false);\n\n    useEffect(() => {\n        if (!window.location.href.includes(\"localhost\")) {\n        // ReactGA.initialize(\"UA-215431628-1\");r\n        ReactGA.initialize(\"UA-217435968-1\");\n\n        }\n        setInitialized(true);\n    }, []);\n\n    useEffect(() => {\n        if (initialized) {\n        \n            if(location.pathname === '/')\n            {\n\n                ReactGA.pageview(location.pathname + location.search );\n            }\n            else {\n                ReactGA.pageview(location.pathname + location.search + `/step${step}`);\n            }\n        }\n    }, [initialized, location, step]);\n};\n\nexport default useGaTracker;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/index.js",["603"],"import { combineReducers } from 'redux'\nimport homeReducer from './../components/home/home.reducer'\nimport mintsReducer from '../redux/reducer/reducer'\nimport auctionReducer from './../components/auctions/auctions.reducer'\nimport nftReducer from './../components/nfts/nfts.reducer'\nimport userReducer from './../components/user/user.reducer'\nimport walletReducer from './../components/wallet/wallet.reducer'\nimport categoryReducer from './../components/categories/categories.reducer'\nimport collectionReducer from './../components/collections/collections.reducer'\nimport errorReducer from './shared/error/error.reducer'\nimport settingsReducer from '../components/footer/footer.reducer'\nimport faqReducer from '../components/faq/faq.reducer'\nimport offersReducer from '../components/offers/offers.reducer'\nimport bidsReducer from '../components/bids/bids.reducer'\nimport contactReducer from '../components/contact/contact.reducer'\nimport createNftReducer from '../components/create-nft/create-nft-reducer'\n\nexport default combineReducers({\n    home: homeReducer,\n    dashboard:mintsReducer,\n    auction: auctionReducer,\n    nft: nftReducer,\n    user: userReducer,\n    wallet: walletReducer,\n    category: categoryReducer,\n    collection: collectionReducer,\n    error: errorReducer,\n    settings: settingsReducer,\n    faqs: faqReducer,\n    offer: offersReducer,\n    bid: bidsReducer,\n    contact: contactReducer,\n    \n    \n})","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/full-page-loader/full-page-loader.js",["604"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/Home-Ui/HomeUi.js",["605","606","607","608","609","610","611","612","613"],"import { useEffect } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { connect } from \"react-redux\";\n// import { hometest } from \"../../Redux/actions/actions\";\nimport Navbar from \"../../components/Navbar/navbar\";\nimport SimpleSlider from \"../../components/Slider/slider\";\n// import image from \"../../assets/images/test.jpg\";\nimport Polygon from \"../../assets/images/icon 2.svg\";\n// import Ethereum from \"../../assets/images/Ethereum.svg\";\nimport Cardano from \"../../assets/images/icon 3.svg\";\nimport Binance from \"../../assets/images/icon4.svg\";\nimport Ethereum from \"../../assets/images/icon1.png\";\n// import nft2 from \"../../assets/images/icon4.svg\";\n// import nft3 from \"../../assets/images/icon 2.svg\";\n////////////////////////\nimport nft1 from \"../../assets/images/nft1.jpg\";\nimport nft2 from \"../../assets/images/nft2.webp\";\nimport nft3 from \"../../assets/images/nft3.jpeg\";\nimport nft4 from \"../../assets/images/nft4.webp\";\nimport nft5 from \"../../assets/images/nft5.jpg\";\nimport GaTracker from \"../../gaTracker/gaTracket\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\n//mineImports\nimport { Container, Row, Col } from \"react-bootstrap\";\nimport NavbarComponent from \"../rough/navbar-componnent/NavbarComponent\";\nimport SliderExmp from \"../rough/slider-component/sliderExmp\";\nimport \"./HomeUi.css\";\n\nconst HomeUi = (props) => {\n  //  useEffect(()=>{\n  // },[])\n  GaTracker();\n  const networksData = [\n    { name: \"Ethereum\", image: Ethereum },\n    { name: \"Polygon\", image: Polygon },\n    { name: \"Cardano\", image: Cardano },\n    { name: \"BSC\", image: Binance },\n  ];\n\n  const history = useHistory();\n\n  return (\n    <div className=\"home-body\">\n      <Container>\n        <NavbarComponent className=\"mt-1\" />\n        <Row className=\"home-row\">\n          <Col lg=\"6\">\n            <div className=\"hero-content\">\n              <div className=\"hero-content-heading\">\n                <h1 className=\"home-font-family\">Let's Mint Your NFTs</h1>\n                <h6 className=\"home-font-family\">\n                  Mint As Much You Can For{\" \"}\n                  <span>\n                    <b>Free</b>\n                  </span>\n                </h6>\n              </div>\n              <div className=\"hero-network\">\n                <h5 className=\"mt-5 mb-2 home-font-family\">Select Network</h5>\n                <div className=\"hero-network-options d-flex flex-wrap\">\n                  {networksData.map((item, index) => {\n                    return (\n                      <div\n                        className=\"network-img my-4\"\n                        disabled={true}\n                        key={index}\n                      >\n                        <img\n                          src={item.image}\n                          alt=\"coming soon\"\n                          className={` ${\n                            \"Ethereum\" === item.name ? \"\" : \"selected-network\"\n                          }`}\n                        />\n                        {\"Ethereum\" !== item.name && (\n                          <span className=\"custom-tooltip\">Coming soon</span>\n                        )}\n                        <p\n                          className={`ml-1 mt-2 ${\n                            \"Ethereum\" === item.name\n                              ? \"network-title-yellow\"\n                              : \"network-title-white\"\n                          }`}\n                        >\n                          {item.name}\n                        </p>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                className=\"btn btn-start my-5\"\n                onClick={() => history.push(\"/fourStepForm\")}\n              >\n                Lets Start\n              </button>\n            </div>\n          </Col>\n          <Col lg=\"6\">\n            <div className=\"hero-slider my-5 my-lg-0\">\n              <div className=\"carousel-heading\">\n                <h3 className=\"slider-nfts-title\">World’s Famous</h3>\n                <h2 className=\"slider-nfts-title\">NFT's</h2>\n              </div>\n              <div className=\"hero-slider-conatiner\">\n                <SliderExmp assetList={WordsFamousNfts} />\n              </div>\n            </div>\n          </Col>\n        </Row>\n      </Container>\n    </div>\n  );\n};\nexport default HomeUi;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/home/home.js",["614","615","616","617","618","619","620","621"],"import React, { useEffect } from \"react\";\nimport { Table, Pagination } from \"react-bootstrap\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller2\";\nimport Collections from \"../collections/popular-collections\";\nimport MyCollections from \"../collections/my-collections\";\nimport Explore from \"../explore/explore-home\";\nimport Work from \"../work/work\";\nimport Authors from \"../authors/authors\";\nimport Header from \"../header/header\";\nimport NavbarMain from \"../../Screens/rough/navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\nimport AuctionsCards from \"../../Screens/rough/auctions-cards/AuctionsCards\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n      {/* <Header /> */}\n      <NavbarMain />\n      <Hero />\n      {/* <button onClick={()=>Redirection('/explore-all')}>test cases</button>  */}\n      <Auctions />\n      {/* <AuctionsCards /> */}\n      <Work />\n      <TopSeller viewAll={\"View All\"} />\n      {/* <Collections /> */}\n      <PopularCollections />\n      {/* <CardSlider /> */}\n      {/* <Authors /> */}\n      {/* <MyCollections /> */}\n      {/* <Explore /> */}\n      <OwnCollection />\n      <Buysell />\n      <Footer />\n    </>\n  );\n}\n\nexport default Home;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/live-auctions-list.js",["622","623","624","625","626","627","628","629","630"],"import React, { useState, useEffect } from 'react';\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { beforeAuction, getLiveAuctions } from './auctions.action';\nimport { ENV } from '../../config/config';\nimport Countdown from 'react-countdown';\nimport {getCreators, beforeUser} from './../user/user.action';\nimport image from '../../assets/images/placeholder.png'\nconst { globalPlaceholderImage, countDownRenderer } = ENV\n\nconst initData = {\n    pre_heading: \"Auctions\",\n    heading: \"Live Auctions\",\n    content: \"\",\n    btn_1: \"Load More\"\n}\n\nconst LiveAuctions = (props) => {\n    const [pagination, setPagination] = useState(null);\n    const [auctions, setAuctions] = useState(null)\n    const [loader, setLoader] = useState(true) // auctions loader\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n    const [creators,setCreator]=useState([])\n\n    useEffect(() => {\n        window.scroll(0, 0)\n        // get live auctions\n        getLiveAuctions()\n        props.getCreators()\n    }, [])\n\n    useEffect(()=>{\n      \n        if(props.user.topSellersAuth ){\n        //    console.log(props.user.sellers,\"sellers blah blah blah\");\n           setCreator(props.user.sellers)\n           setLoader(false)\n           \n        }\n      },[props.user.topSellersAuth])\n    // set live auctions\n    useEffect(() => {\n        if (props.auction.getAuth) {\n            const { auctions, pagination } = props.auction\n            if (auctions) {\n                setAuctions(auctions)\n                setPagination(pagination)\n                props.beforeAuction()\n             \n            }\n        }\n    }, [props.auction.getAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (pagination)\n            setLoadMoreBtn((pagination.total > 0 && pagination.total > auctions.length && auctions.length > 0))\n    }, [pagination])\n\n    const loadMore = () => {\n        const { page, limit } = pagination\n        setLoader(true)\n\n        // get more live auctions\n        getLiveAuctions(1, limit * (page + 1))\n    }\n\n    const getLiveAuctions = (page = 1, limit = 8) => {\n        const qs = ENV.objectToQueryString({ page, limit })\n        props.getLiveAuctions(qs)\n    }\n    const filterCreator=(nft,field)=>{\n        const result= creators.find((item)=>item._id===nft.nftOwnerId)\n     \n        if(field===\"userName\"){\n\n         if(result?.username){\n       \n             return result?.username\n         }\n         else {\n             return \"no username found\"\n         }\n        }\n        else if(field==\"profileImage\"){\n            if(result?.profileImage)\n            {\n\n                return result?.profileImage\n            }\n            else {\n                return image\n            }\n        }\n\n\n       }\n\n\n\n    return (\n        <section className=\"live-auctions-area load-more padding-wrapper\">\n            {\n                loader ?\n                    <FullPageLoader /> :\n                    <div className=\"container\">\n                        <div className=\"row justify-content-center\">\n                            <div className=\"col-12 col-md-8 col-lg-7\">\n                                {/* Intro */}\n                                <div className=\"intro text-center\">\n                                    <span>{initData.pre_heading}</span>\n                                    <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                                    <p>{initData.content}</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"row items\">\n                            {auctions && auctions.length > 0 ?\n                                auctions.map((item, idx) => {\n                                    return (\n                                        <div className=\"col-4\" key={`auc_${idx}`} id={`#auc-${idx}`}>\n                                            <div className=\"card m-3\">\n                                                <div className=\"image-over\">\n                                                    <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                                        <img className=\"card-img-top\" src={item.image} alt=\"NFT image\" width=\"600\" height=\"600\" />\n                                                    </Link>\n                                                </div>\n                                                <div className=\"card-caption col-12 p-0\">\n                                                    <div className=\"card-body\">\n                                                        <div className=\"mb-3\">\n                                                            <Countdown\n                                                                // date={new Date(item.auctionEndDate) + 10000}\n                                                                date={1651851923270}\n                                                                renderer={countDownRenderer}\n                                                            />\n                                                        </div>\n                                                        <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                                            <h5 className=\"mb-0\">{item.name}</h5>\n                                                        </Link>\n                                                        <Link className=\"seller d-flex align-items-center my-3\" to={`/author`}>\n                                                            \n                                                           <img className=\"avatar-sm rounded-circle\" src={filterCreator(item,\"profileImage\")} alt=\"User Avatar\" />\n                                                             <span className=\"ml-2\">{filterCreator(item,\"userName\")}</span> \n                                                        </Link>\n                                                        <div className=\"card-bottom d-flex justify-content-between\">\n                                                            <span>{item.currentPrice} {ENV.currency}</span>\n                                                            <span>{item.sold} of {item.copies}</span>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    );\n                                })\n                                : <p className=\"text-center ml-3\">No Live Auctions Found</p>\n                            }\n                        </div>\n                        {\n                            loadMoreBtn &&\n                            <div className=\"row\">\n                                <div className=\"col-12 text-center\">\n                                    <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                                </div>\n                            </div>\n                        }\n                    </div>\n            }\n        </section>\n    );\n}\n\nconst mapStateToProps = state => ({\n    auction: state.auction,\n    error: state.error,\n    user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeAuction,getCreators, getLiveAuctions })(LiveAuctions);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore-all.js",["631","632","633","634","635","636","637","638","639"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport FullPageLoader from '../full-page-loader/full-page-loader'\nimport ExploreItems from './explore-items';\nimport NftCard from '../collections/components/NftCard/NftCard';\nimport { Link, useHistory } from 'react-router-dom';\nimport {getCreators, beforeUser} from './../user/user.action';\n\nconst initData = {\n    pre_heading: \"Explore\",\n    heading: \"Exclusive Digital Assets\",\n    content: \"\",\n    btn_1: \"Load More\"\n}\n\nfunction ExploreAll(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n    const [intro, setIntro] = useState(false);\n    const [creators,setCreator]=useState([])\n    const pathname = useHistory().location.pathname\n\n    useEffect(() => {\n        window.scroll(0, 0)\n\n        // set intro section\n        if (pathname === '/explore-all')\n            setIntro(true)\n      \n        // get NFTs for explore section\n        getNFTs()\n        props.getCreators()\n    }, [])\n  useEffect(()=>{\n      \n    if(props.user.topSellersAuth ){\n    //    console.log(props.user.sellers,\"sellers blah blah blah\");\n       setCreator(props.user.sellers)\n       \n    }\n  },[props.user.topSellersAuth])\n  useEffect(()=>{\n    if(props.user.creatorsAuth ){\n    //    console.log(props.user.creators,\"sellers blah blah blah\");\n       setCreator(props.user.creators)\n       setLoader(false)\n    }\n  },[props.user.creatorsAuth])\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            // console.log(nftsData,\"nftsData==>\")\n            if (nftsData) {\n             \n                // console.log(nftsData,\"checking nfts\" )\n                setNFTs(nftsData)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n            \n                // setLoader(false)\n                if (props.setLoader)\n                    props.setLoader(false)\n                    \n            }\n            setLoader(false)\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length && nfts.length > 0))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n        // get more NFTs for explore section\n        getNFTs(1, limit * (page + 1))\n    }\n\n    const getNFTs = (page = 1, limit = 4) => {\n        const nftQS = { page, limit, explore: true }\n\n        if (props.collectionId)\n            nftQS.collectionId = props.collectionId\n\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n//     <div className=\"row gx-5 p-4\">\n//     {\n//       nfts && nfts.map((nft)=>{\n//     return (\n\n// <div className=\"col-6 mt-5\" style={{}}>\n\n//   <NftCard nft={nft}/>\n// </div>\n//     )\n//       })\n//     }\n// console.log(nfts,\"checking nfts==>\")\n\n    return (\n        <section className=\"explore-area\" style={{ paddingTop: `${intro ? '150' : '30'}px` }}>\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n                {\n                    intro &&\n                    <div className=\"row justify-content-center\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                <span>{initData.pre_heading}</span>\n                                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                                {/* <p>{initData.content}</p> */}\n                            </div>\n                        </div>\n                    </div>\n                }\n                <div className=\"row items gx-4 explore-items\">\n                    {nfts && nfts.length > 0 && creators.length>0 ?\n                        nfts.map((item, idx) => {\n                            return (\n                                <div className=\"col-3 mt-5\" style={{}}>\n\n                               <NftCard nft={item} creators={creators} userId={ENV.getUserKeys('_id')._id}/>\n                                </div>\n                                // <div key={`edth_${idx}`} className={`col-12 col-sm-6 col-lg-${props.lgCols ? props.lgCols : '3'} item explore-item`} data-groups={item.group ? item.group : '[\"art\",\"sports\"]'}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <a href=\"/author\">\n                                //                         <h6 className=\"ml-4 mb-0\">{\"usama asghar\"}</h6>\n                                //                         {/* <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6> */}\n                                //                     </a>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     <span>{\"0\"} of {\"5\"}</span>\n                                //                 </div>\n                                //                 {/* <a className=\"btn btn-bordered-white btn-smaller mt-3\" href=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</a> */}\n                                //             </div>\n                                //         </div>\n                                //     </div>\n                                // </div>\n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Exploree</p>\n                    }\n                </div>\n                {\n                    loadMoreBtn &&\n                    <div className=\"row\">\n                        <div className=\"col-12 text-center\">\n                            <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                        </div>\n                    </div>\n                }\n                {/* <ExploreItems class1=\"explore-items\" class2=\"explore-item\" key=\"edth\" /> */}\n            </div>\n        </section>\n    )\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft,\n    user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs ,getCreators})(ExploreAll);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/item-detail/item-detail.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/activity/activity.js",["640"],"import React, { useState, useEffect } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-1/activity\";\r\n\r\nconst Activity = ()  => {\r\n    const [data, setData] = useState({});\r\n    const [tabData_1, setTabData_1] = useState([]);\r\n    const [tabData_2, setTabData_2] = useState([]);\r\n    const [tabData_3, setTabData_3] = useState([]);\r\n    const [filterData, setFilterData] = useState([]);\r\n    \r\n    useEffect(()=>{\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                setData(res.data)\r\n                setTabData_1(res.data.tabData_1)\r\n                setTabData_2(res.data.tabData_2)\r\n                setTabData_3(res.data.tabData_3)\r\n                setFilterData(res.data.filterData)\r\n            })\r\n            \r\n    }, [])\r\n\r\n    return (\r\n        <section className=\"activity-area load-more padding-wrapper\">\r\n            <div className=\"container\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro mb-4\">\r\n                            <div className=\"intro-content\">\r\n                                <span>{data.preHeading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{data.heading}</h3>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    <div className=\"col-12 col-md-6 col-lg-8\">\r\n                        {/* Netstorm Tab */}\r\n                        <ul className=\"netstorm-tab nav nav-tabs\" id=\"nav-tab\">\r\n                            <li>\r\n                                <a className=\"active\" id=\"nav-home-tab\" data-toggle=\"pill\" href=\"#nav-home\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_1}</h5>\r\n                                </a>\r\n                            </li>\r\n                            <li>\r\n                                <a id=\"nav-profile-tab\" data-toggle=\"pill\" href=\"#nav-profile\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_2}</h5>\r\n                                </a>\r\n                            </li>\r\n                            <li>\r\n                                <a id=\"nav-contact-tab\" data-toggle=\"pill\" href=\"#nav-contact\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_3}</h5>\r\n                                </a>\r\n                            </li>\r\n                        </ul>\r\n                        {/* Tab Content */}\r\n                        <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                            <div className=\"tab-pane fade show active\" id=\"nav-home\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_1.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`ato_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                            <div className=\"tab-pane fade\" id=\"nav-profile\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_2.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`att_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                            <div className=\"tab-pane fade\" id=\"nav-contact\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_3.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`atth_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"col-12 col-md-6 col-lg-4\">\r\n                        {/* Activity Content */}\r\n                        <div className=\"activity-content mt-5 mt-lg-0\">\r\n                            {/* Single Widget */}\r\n                            <div className=\"single-widget\">\r\n                                {/* Search Widget */}\r\n                                <div className=\"widget-content search-widget\">\r\n                                    <form action=\"#\">\r\n                                        <input type=\"text\" placeholder=\"Enter your keywords\" />\r\n                                    </form>\r\n                                </div>\r\n                            </div>\r\n                            {/* Single Widget */}\r\n                            <div className=\"single-widget\">\r\n                                {/* Filter Widget */}\r\n                                <div className=\"widget filter-widget\">\r\n                                    <h4 className=\"title\">{data.widgetTitle}</h4>\r\n                                    {/* Filter Widget Content */}\r\n                                    <div className=\"widget-content\">\r\n                                        {/* Tags Widget Items */}\r\n                                        <div className=\"widget-content filter-widget-items mt-3\">\r\n                                            {filterData.map((item, idx) => {\r\n                                                return (\r\n                                                    <a key={`fd_${idx}`} href=\"#\" className=\"badge tag\">{item.title}</a>\r\n                                                );\r\n                                            })}\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\nexport default Activity;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/blog/blog.js",["641","642"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/blog\";\r\n\r\nclass Blog extends Component {\r\n    state = {\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data.blogData\r\n                })\r\n              \r\n            })\r\n        .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"blog-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`bd_${idx}`} className=\"col-12 col-md-4 item\">\r\n                                    {/* Single Blog */}\r\n                                    <div className=\"card blog-card\">\r\n                                        {/* Blog Thumb */}\r\n                                        <div className=\"blog-thumb\">\r\n                                            <a href=\"/blog-single\"><img src={item.img} alt=\"\" /></a>\r\n                                        </div>\r\n                                        {/* Blog Content */}\r\n                                        <div className=\"blog-content\">\r\n                                            {/* Meta Info */}\r\n                                            <ul className=\"meta-info d-flex justify-content-between list-unstyled mt-4\">\r\n                                                <li>By <a href=\"#\">{item.author}</a></li>\r\n                                                <li><a href=\"#\">{item.date}</a></li>\r\n                                            </ul>\r\n                                            {/* Blog Title */}\r\n                                            <a href=\"/blog-single\">\r\n                                                <h4>{item.title}</h4>\r\n                                            </a>\r\n                                            <p>{item.content}</p>\r\n                                            {/* Blog Button */}\r\n                                            <a className=\"btn content-btn\" href=\"/blog-single\">{item.btnText}</a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Blog;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/authors-list/authors-list.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/blog-single/blog-single.js",["643","644"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\nimport Sidebar from '../sidebar/sidebar';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/blogSingle\";\r\n\r\nclass BlogSingle extends Component {\r\n    state = {\r\n        data: {}\r\n    }\r\n    componentDidMount(){\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data\r\n                })\r\n            \r\n            })\r\n        .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"single featured post-details\">\r\n                <div className=\"container\">\r\n                    <div className=\"row\">\r\n                        {/* Main */}\r\n                        <div className=\"col-12 col-lg-8 p-0\">\r\n                            <div className=\"row\">\r\n                                <div className=\"col-12 align-self-center\">\r\n                                    {/* Image */}\r\n                                    <div className=\"blog-thumb\">\r\n                                        <img className=\"w-100\" src={this.state.data.image} alt=\"\" />\r\n                                    </div>\r\n                                    <h2 className=\"featured ml-0\">{this.state.data.title}</h2>\r\n                                    <p>{this.state.data.content_1}</p>\r\n                                    <p>\r\n                                    </p>\r\n                                    <blockquote>{this.state.data.quote}</blockquote>\r\n                                    <p>{this.state.data.content_2}</p>\r\n                                    <p>{this.state.data.content_3}</p>\r\n                                    {/* Post Holder */}\r\n                                    <ul className=\"mb-5 post-holder\">\r\n                                        <li className=\"post-meta-item\">\r\n                                            <div className=\"date\">\r\n                                                <span className=\"posted-on\">Posted On <a href=\"#\" rel=\"bookmark\"><time className=\"entry-date published updated\" dateTime=\"2018-11-01T06:18:46+00:00\">{this.state.data.date}</time></a></span>\r\n                                            </div>\r\n                                        </li>\r\n                                    </ul>\r\n                                    {/* Comments */}\r\n                                    <h3 className=\"comments-reply-text mb-3\">{this.state.data.commentTitle}</h3>\r\n                                    <p className=\"mt-3\">{this.state.data.commentContent}</p>\r\n                                    <form>\r\n                                        <fieldset>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-12 col-lg-6 input-group p-0 pr-lg-3 mb-3\">\r\n                                                    <input type=\"text\" name=\"name\" data-minlength={3} placeholder=\"Name\" required />\r\n                                                </div>\r\n                                                <div className=\"col-12 col-lg-6 input-group p-0 mb-3\">\r\n                                                    <input type=\"email\" name=\"email\" data-minlength={3} placeholder=\"Email\" required />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-12 input-group p-0 mb-3\">\r\n                                                    <textarea name=\"message\" data-minlength={3} rows={4} placeholder=\"Message\" required defaultValue={\"\"} />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 input-group p-0\">\r\n                                                <a className=\"btn btn-bordered-white text-white\">{this.state.data.commentBtn}<i className=\"icon-login ml-2\" /></a>\r\n                                            </div>\r\n                                        </fieldset>\r\n                                    </form>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        {/* Sidebar */}\r\n                        <Sidebar />\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default BlogSingle;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/create-nft.js",["645","646","647","648","649","650","651"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport NFTPreview from \"../nft-preview/nft-preview\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n} from \"./../../utils/functions\";\nimport { createNft } from \"./../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\n// import {ENV} from '../../config/config'\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../collections/collections.actions\";\nimport { setNftToken, createNFT } from \"../nfts/nfts.action\";\nimport { getCurrentAddress } from \"../../utils/web3\";\nimport { RiArrowDropDownLine } from \"react\";\nimport \"./createNft.css\";\n\nimport { Images } from \"../../assets/assets.js\";\nimport Upload from \"./components/upload\";\nimport NavbarMain from \"../../Screens/rough/navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nconst placeholderImg = \"\";\n\nclass CreateNFT extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      nft: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        nftOwnerId: ENV.getUserKeys(\"_id\")._id,\n        image: \"\",\n        videoURL: \"\",\n        audioUrl: \"\",\n        name: \"\",\n        description: \"\",\n        currentPrice: \"\",\n        royalty: \"\",\n        size: \"\",\n        copies: \"\",\n        collectionId: \"\",\n        ownerAddress: \"\",\n        status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n      },\n      imageURL: \"\",\n      videoURL: \"\",\n      collections: null,\n      allcollections: null,\n      error: false,\n      errorMessage: \"\",\n      audioUrl: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount = async () => {\n    window.scroll(0, 0);\n    this.props.getCollections();\n    let ownerAddress = await getCurrentAddress();\n\n    let { nft } = this.state;\n    nft = { ...nft, ownerAddress: ownerAddress };\n    this.setState({\n      nft,\n    });\n  };\n\n  componentDidUpdate() {\n    if (this.props.collection.getAuth) {\n      const { collections } = this.props.collection;\n      console.log(ENV.getUserKeys(\"_id\")._id,\"if\")\n      this.props.beforeCollection();\n      if (!collections) {\n        toast.info(\"Please add a collection first\");\n        return this.props.history.push(\"/collection/create\");\n      } else\n        var myCollections = collections.filter(\n          (item) => item.userId === ENV.getUserKeys(\"_id\")._id\n        );\n      this.setState({\n        collections: myCollections,\n        loader: false,\n      });\n    }\n  }\n\n  // onFileChange(e) {\n  //   let file = e.target.files[0];\n  //   let fileId = e.target.id;\n  //   if (file)\n  //     if (file.type.includes(\"image\")) {\n  //       let { nft } = this.state;\n  //       nft = { ...nft, [e.target.name]: file };\n  //       this.setState(\n  //         {\n  //           nft,\n  //         },\n  //         () => {\n  //           if (file) {\n  //             var reader = new FileReader();\n\n  //             reader.onload = function (e) {\n  //               $(`#nft-${fileId}`).attr(\"src\", e.target.result);\n  //               $(\"#nft-image-label\").html(\"File selected\");\n  //             };\n  //             reader.readAsDataURL(file);\n  //           }\n  //         }\n  //       );\n  //     } else {\n  //       $(`#nft-${fileId}`).attr(\"src\", placeholderImg);\n  //       file = {};\n  //     }\n  // }\n\n  onChange(e, status = null) {\n    let { name, value } = e.target;\n\n    // if status is provided\n    if (status) value = status;\n\n    let { nft } = this.state;\n    nft = { ...nft, [name]: value };\n    this.setState({ nft });\n  }\n\n  reset = () => {\n    const nft = {\n      userId: ENV.getUserKeys(\"_id\")._id,\n      image: \"\",\n      name: \"\",\n      description: \"\",\n      currentPrice: \"\",\n      royalty: \"\",\n      size: \"\",\n      copies: \"\",\n      collectionId: \"\",\n      ownerAddress: this.state.ownerAddress,\n      status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n    };\n    this.setState({ nft });\n  };\n  submit = (e) => {\n    e.preventDefault();\n\n    const { nft } = this.state;\n    console.log(nft, \"nft item\");\n    // return ' '\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() && nft.collectionId ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              var formData = new FormData();\n              for (const key in nft)\n                if (nft[key]) formData.append(key, nft[key]);\n\n              const res = await axiosPostFormData(\n                \"nfts/create\",\n                formData,\n                true\n              );\n              console.log(\"response of create nft\", res);\n\n              if (res.success) {\n                // this.reset();\n                // toast.success(`Success! ${res.message}`)\n\n                if (res.nft && res.nft.metaData) {\n                  try {\n                    let nftId = res.nft._id;\n                    let createNftResult = await createNft(\n                      res.nft.metaData,\n                      res.nft._id\n                    );\n                    console.log(createNftResult, \"createNftResult\");\n\n                    if (createNftResult.events.Transfer.returnValues.tokenId) {\n                      let data = {\n                        nftToken:\n                          createNftResult.events.Transfer.returnValues.tokenId,\n                        nftId,\n                        data: this.state.nft,\n                        image: res.nft.image,\n                      };\n                      this.props.setNftToken(data);\n                    }\n                  } catch (err) {\n                    // alert(err.message);\n                  }\n\n                  this.setState({\n                    loader: true,\n                  });\n                  setTimeout(() => {\n                    this.setState({ loader: false });\n                    // this.props.history.push(\"/collections\");\n                  }, 11000);\n                }\n              } else this.setState({ errors: res.message, loader: false });\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-nft\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n\n  onFileChange = (e, status) => {\n    if (this.handleFilesValidation(e, status) === \"file matched\") {\n      let file = \"\";\n      let url = \"\";\n      let fileId = \"\";\n      if (status === \"onDrag\") {\n        file = e.dataTransfer.files[0];\n        url = URL.createObjectURL(e.dataTransfer.files[0]);\n        fileId = e.dataTransfer.id;\n      } else {\n        file = e.target.files[0];\n        url = URL.createObjectURL(e.target.files[0]);\n        fileId = e.target.id;\n      }\n      if (file)\n        if (file.type.includes(\"image\")) {\n          let { nft } = this.state;\n          nft = { ...nft, [e.target.name]: file };\n          nft = { ...nft, videoURL: \"\" };\n\n          this.setState(\n            {\n              nft,\n              imageURL: url,\n              videoURL: \"\",\n              error: false,\n              errorMessage: \"\",\n            },\n            () => {\n              if (file) {\n                var reader = new FileReader();\n\n                reader.onload = function (e) {\n                  $(`#nft-${fileId}`).attr(\"src\", e.target.result);\n                  $(\"#nft-image-label\").html(\"File selected\");\n                };\n                reader.readAsDataURL(file);\n              }\n            }\n          );\n        } else if (file.type.includes(\"video\")) {\n          let { nft } = this.state;\n          nft = { ...nft, videoURL: file };\n          nft = { ...nft, image: \"\" };\n          this.setState({\n            nft,\n            videoURL: url,\n            imageURL: \"\",\n            error: false,\n            errorMessage: \"\",\n          });\n        } else if (file.type.includes(\"audio\")) {\n          let { nft } = this.state;\n          nft = { ...nft, videoURL: file, audioUrl: file, image: \"\" };\n          console.log(url, \"url for audio\");\n\n          this.setState({\n            nft,\n            videoURL: \"\",\n            imageURL: \"\",\n            error: false,\n            errorMessage: \"\",\n            audioUrl: url,\n          });\n        } else {\n          $(`#nft-${fileId}`).attr(\"src\", placeholderImg);\n          file = {};\n        }\n    } else {\n      let message = this.handleFilesValidation(e, status);\n      this.setState({\n        error: true,\n        errorMessage: message,\n      });\n    }\n  };\n  dragOver = (e) => {\n    e.preventDefault();\n  };\n\n  dragEnter = (e) => {\n    e.preventDefault();\n  };\n\n  dragLeave = (e) => {\n    e.preventDefault();\n  };\n  onDrop = (e) => {\n    e.nativeEvent.preventDefault();\n    if (!e) return;\n\n    this.onFileChange(e, \"onDrag\");\n  };\n\n  handleFilesValidation = (e, status) => {\n    console.log(status, \"status\");\n    let files = \"\";\n    let type = \"\";\n    if (status === \"onDrag\") {\n      files = e.dataTransfer.files[0];\n      type = e.dataTransfer.files[0].type;\n    } else {\n      files = e.target.files[0];\n      type = e.target.files[0].type;\n    }\n    if (files) {\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\" ||\n        type === \"audio/mpeg\"\n      ) {\n        let fileSize = this.formatBytes(files.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          return \"File size limit is exceeded\";\n        } else {\n          return \"file matched\";\n        }\n      } else {\n        return \"File not supported!\";\n      }\n    }\n  };\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  render() {\n    const {\n      nft,\n      errors,\n      loader,\n      isSubmitted,\n      collections,\n      imageURL,\n      videoURL,\n      error,\n      errorMessage,\n      audioUrl,\n    } = this.state;\n    // console.log(nft, \"nft changed\");\n    const { onDrop, dragOver, dragEnter, dragLeave } = this;\n    //    if(!ENV.getUserKeys('_id')._id){\n    //     toast.error(\"Please login to create NFT\")\n    //     this.props.history.push('/')\n    //        return \" \"\n    //    }\n    //    else {\n    // console.log(nft, \"nft\");\n\n    return (\n      <div>\n        <NavbarMain />\n\n        <section className=\"author-area padding-wrapper\">\n          {loader && <FullPageLoader />}\n          {/* <div className=\"container\">\n                    <div className=\"row \">\n  \n                            <div className=\"col-12\">\n                                        <span className=\"get-started-text\">Get Started</span>\n\n                            </div>\n                        <div className=\"col-12 col-md-6 col-sm-12 d-flex flex-column align-items-lg-start align-items-center\">\n                            <div className=\"mt-lg-0 mb-1 mb-lg-1\">\n                               \n                                <div className=\"intro\">\n                                    <div className=\"intro-content\">\n                                        <h3 className=\"mt-3 mb-0 create-item-heading\">Create Item</h3>\n                                    </div>\n                                </div>\n            \n                                {\n                                    isSubmitted && errors &&\n                                    <div className=\"row\">\n                                        <div className=\"col-12\">\n                                            <span id=\"create-nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\n                                        </div>\n                                    </div>\n                                }\n                            </div>\n                  \n                            <form id=\"create-nft\" className=\"item-form card preview-nft-form-card no-hover\">\n                             \n                                <div className=\"row\">\n                                    <div className=\"col-12\">\n                                        <div className=\"input-group form-group\">\n                                            <div className=\"custom-file\">\n                                                <input type=\"file\" className=\"custom-file-input\" id=\"image\" accept=\".png,.jpeg,.jpg\" onChange={(e) => this.onFileChange(e)} name=\"image\" />\n                                                <label id=\"nft-image-label\" className=\"custom-file-label\" htmlFor=\"image\">Choose file *</label>\n                                            </div>\n                                            <span className=\"text-danger\">{this.validator.message('image', nft.image, 'required')}</span>\n                                        </div>\n                                    </div>\n                                    <div className=\"col-12\">\n                                        <div className=\"form-group mt-3\">\n                                            <input type=\"text\" className=\"form-control\" name=\"name\" placeholder=\"Item Name *\" required=\"required\" onChange={(e) => this.onChange(e)} defaultValue={nft.name} />\n                                            <span className=\"text-danger\">{this.validator.message('name', nft.name, 'required')}</span>\n                                        </div>\n                                    </div>\n                                    <div className=\"col-12\">\n                                        <div className=\"form-group\">\n                                            <textarea className=\"form-control\" name=\"description\" placeholder=\"Description *\" cols={30} rows={3} onChange={(e) => this.onChange(e)} defaultValue={nft.description} />\n                                            <span className=\"text-danger\">{this.validator.message('description', nft.description, 'required')}</span>\n                                        </div>\n                                    </div>\n\n\n                                    <div className=\"col-12 col-md-6\">\n                                        <div className=\"form-group\">\n                                            <input type=\"text\" className=\"form-control\" name=\"currentPrice\" placeholder=\"Item Price *\" required=\"required\" onChange={(e) => this.onChange(e)} onKeyDown={(e) => decimalNumberValidator(e)} defaultValue={nft.currentPrice} />\n                                            <span className=\"text-danger\">{this.validator.message('currentPrice', nft.currentPrice, 'required')}</span>\n                                        </div>\n                                    </div> \n                                     <div className=\"col-12 col-md-6\">\n                                        <div className=\"form-group\">\n                                            <input type=\"number\" className=\"form-control\" min=\"0\"  name=\"royalty\" placeholder=\"royality\" required=\"required\" onChange={(e) => this.onChange(e)} defaultValue={nft.royalty} />\n                                            <span className=\"text-danger\">{this.validator.message('royalty', nft.royalty, 'required')}</span>\n                                        </div>\n                                    </div>\n                                 \n                                    <div className=\"col-12 col-md-6\">\n                                        <div className=\"form-group\">\n                                            <input type=\"number\" className=\"form-control\" min=\"0\"  name=\"size\" placeholder=\"Size\" required=\"required\" onChange={(e) => this.onChange(e)} defaultValue={nft.size} />\n                                            <span className=\"text-danger\">{this.validator.message('size', nft.size, 'required')}</span>\n                                        </div>\n                                    </div>\n                                    <div className=\"col-12 col-md-6\">\n                                        <div className=\"form-group\">\n                                            <input type=\"number\" className=\"form-control\" min=\"0\" name=\"copies\" placeholder=\"No. of Copies *\" required=\"required\" onKeyDown={(e) => decimalNumberValidator(e)} onChange={(e) => this.onChange(e)} defaultValue={nft.copies} />\n                                            <span className=\"text-danger\">{this.validator.message('copies', nft.copies, 'required')}</span>\n                                        </div>\n                                    </div>\n                                    <div className=\"col-12\">\n                                        <div className=\"form-group select-wrapper\">\n                                         \n                                            <select className=\"form-control select-after\" id=\"collection\" name=\"collectionId\" onChange={(e) => this.onChange(e)}>\n                                                <option value=\"\">Select Collection</option>\n                                                {\n                                                    collections && collections.map((collection, index) => {\n                                                        return (\n                                                            <option key={index} value={collection._id}>{collection.name}</option>\n                                                        )\n                                                    })\n                                                }\n                                            </select>\n                                            <span className=\"text-danger\">{this.validator.message('collection', nft.collectionId, 'required')}</span>\n                                        </div>\n                                    </div>\n                                 \n                                    <div className=\"col-12 d-flex align-items-center justify-content-center w-100\">\n                                        <button disabled={loader} className=\"btn mt-3 mt-sm-4 create-item-btn\" type=\"button\" onClick={(e) => this.submit(e)}>Create Item</button>\n                                    </div>\n                                </div>\n                            </form>\n                        </div>\n\n\n                \n                        <div className=\"col-12  preview-nft-wrapper col-md-6 col-sm-12 \">\n                        <span class=\"Top-Sellers-copy\">\n  Preview\n</span>\n                            <NFTPreview {...nft} />\n                        </div>\n                    </div>\n                </div> */}\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Get started</span>\n                    <h3 className=\"mb-0\">Create NFT</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-sm-6 col-md-6 col-lg-4 left-container\">\n                <p className=\"upload-title\">Upload</p>\n                {/* ffffffffffffffff */}\n                {/* <div\n                  className=\"upload-image-container\"\n                  onDrop={(e) => onDrop(e)}\n                  onDragOver={(e) => dragOver(e)}\n                  onDragEnter={(e) => dragEnter(e)}\n                  onDragLeave={(e) => dragLeave(e)}\n                >\n                  <Upload\n                    onFileChange={(e, status) => this.onFileChange(e, status)}\n                    Images={Images}\n                    imageURL={imageURL}\n                    videoURL={videoURL}\n                    audioSrc={audioUrl}\n                    \n                    dragOver={dragOver}\n                    onDrop={onDrop}\n                    dragEnter={dragEnter}\n                    dragLeave={dragLeave}\n                  />\n                  <span className=\"text-danger text-center mt-3\">\n                    {this.validator.message(\"image\", nft.image, \"required\")}\n                  </span>\n\n                  {error && (\n                    <p className=\"text-danger text-center mt-3\">\n                      {errorMessage}\n                    </p>\n                  )}\n\n                  <div className=\"choose-file text-center my-5 \">\n                    <p className=\"mb-4\">or choose a file</p>\n\n                    <label>\n                      <span className=\"browse-files-btn mt-2\">browse file</span>\n                      <input\n                        type=\"file\"\n                        style={{ display: \"none\" }}\n                        onChange={(e) => this.onFileChange(e, \"onChange\")}\n                        accept=\".mp4, .png,.jpeg\"\n                        name=\"image\"\n                      />\n                    </label>\n                  </div>\n                </div> */}\n                {/* cccccccccccc */}\n                <div className=\"nft-left-upload p-3\">\n                  <div\n                    className=\"upload-image-container\"\n                    onDrop={(e) => onDrop(e)}\n                    onDragOver={(e) => dragOver(e)}\n                    onDragEnter={(e) => dragEnter(e)}\n                    onDragLeave={(e) => dragLeave(e)}\n                  >\n                    <Upload\n                      onFileChange={(e, status) => this.onFileChange(e, status)}\n                      Images={Images}\n                      imageURL={imageURL}\n                      videoURL={videoURL}\n                      audioSrc={audioUrl}\n                      dragOver={dragOver}\n                      onDrop={onDrop}\n                      dragEnter={dragEnter}\n                      dragLeave={dragLeave}\n                    />\n                    <span className=\"text-danger text-center mt-3\">\n                      {this.validator.message(\"image\", nft.image, \"required\")}\n                    </span>\n\n                    {error && (\n                      <p className=\"text-danger text-center mt-3\">\n                        {errorMessage}\n                      </p>\n                    )}\n\n                    <div className=\"choose-file text-center my-5 \">\n                      <p className=\"mb-4\">or choose a file</p>\n\n                      <label>\n                        <span className=\"browse-files-btn mt-2\">\n                          browse file\n                        </span>\n                        <input\n                          type=\"file\"\n                          style={{ display: \"none\" }}\n                          onChange={(e) => this.onFileChange(e, \"onChange\")}\n                          accept=\".mp4, .png,.jpeg\"\n                          name=\"image\"\n                        />\n                      </label>\n                      {/* <label>\n                        <span className=\"browse-files-btn mt-2\">\n                          browse file\n                        </span>\n                        <input\n                          type=\"file\"\n                          style={{ display: \"none\" }}\n                          onChange={(e) => this.onFileChange(e, \"onChange\")}\n                          accept=\".mp4, .png,.jpeg\"\n                          name=\"image\"\n                        />\n                      </label> */}\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"col-sm-6 col-md-6 col-lg-8 mt-5 mt-sm-0\">\n                <p className=\"upload-title\">Create</p>\n                <div className=\"nft-inputs-container p-4\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-12\">\n                      {/* <label className=\"create-nft-form-title mb-3\">\n                        Title\n                      </label> */}\n                      <input\n                        name=\"name\"\n                        placeholder=\"Title\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.name}\n                        defaultValue={nft.name}\n                        autocomplete=\"off\"\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.name, \"required\")}\n                      </span>\n                    </div>\n                    <div className=\"col-12\">\n                      {/* <label className=\"create-nft-form-title mb-3\">\n                        Description\n                      </label> */}\n                      <textarea\n                        name=\"description\"\n                        rows=\"3\"\n                        placeholder=\"Description*\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.description}\n                        defaultValue={nft.description}\n                      ></textarea>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.description,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n\n                    <div className=\"col-12\">\n                      {/* <label className=\"create-nft-form-title mb-3\">\n                        Item Price\n                      </label> */}\n                      <input\n                        name=\"currentPrice\"\n                        placeholder=\"Item Price*\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        onKeyDown={(e) => decimalNumberValidator(e)}\n                        value={nft.currentPrice}\n                        defaultValue={nft.currentPrice}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.currentPrice,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    {/* <div className=\"col-12 col-md-6\">\n                    <label className=\"create-nft-form-title mb-3\">\n                      Category\n                    </label>\n                    <select name=\"cars\" id=\"cars\" placeholder=\"Select Category\">\n                      <option value=\"select\" className=\"d-none\">\n                        Select Category\n                      </option>\n                      <option value=\"volvo\">Volvo</option>\n                      <option value=\"saab\">Saab</option>\n                      <option value=\"opel\">Opel</option>\n                      <option value=\"audi\">Audi</option>\n                    </select>\n                  </div> */}\n\n                    <div className=\"col-12 col-lg-6\">\n                      {/* <label className=\"create-nft-form-title mb-3\">Size</label> */}\n                      <input\n                        name=\"size\"\n                        value=\"\"\n                        placeholder=\"Size\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.size}\n                        defaultValue={nft.size}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.size, \"required\")}\n                      </span>\n                    </div>\n                    <div className=\"col-12 col-lg-6\">\n                      {/* <label className=\"create-nft-form-title mb-3\">\n                        No. of Copies\n                      </label> */}\n                      <input\n                        name=\"copies\"\n                        value=\"\"\n                        placeholder=\"No. of Copies*\"\n                        required=\"required\"\n                        onKeyDown={(e) => decimalNumberValidator(e)}\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.copies}\n                        defaultValue={nft.copies}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.copies, \"required\")}\n                      </span>\n                    </div>\n\n                    <div className=\"col-12\">\n                      {/* <label className=\"create-nft-form-title mb-3\">\n                        Select Collection\n                      </label> */}\n                      <select\n                        id=\"collectionId\"\n                        name=\"collectionId\"\n                        onChange={(e) => this.onChange(e)}\n                      >\n                        <option value=\"\">Select Collection</option>\n                        {collections &&\n                          collections.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection._id}>\n                                {collection.name}\n                              </option>\n                            );\n                          })}\n                      </select>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.collectionId,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"col-12\">\n                      <div className=\"nft-form-btns text-center \">\n                        <div className=\"btn-link my-1 text-white\">\n                          <a>Preview</a>\n                        </div>\n                        <div className=\"d-flex flex-column justify-content-center align-items-center\">\n                          <button\n                            disabled={loader}\n                            className=\"create-collection-btn my-1\"\n                            typ=\"submit\"\n                            onClick={(e) => this.submit(e)}\n                          >\n                            Create Item\n                          </button>\n                          <button className=\"btn btn-rounded-bordered cancel-collection-btn mt-2\">\n                            Cancel\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n        <Footer />\n      </div>\n    );\n    // }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  collection: state.collection,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollections,\n  setNftToken,\n  createNFT,\n})(CreateNFT);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/my-collections.js",["652","653"],"import React, { useState, useEffect, useRef } from 'react';\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { beforeCategory, getCategories } from '../categories/categories.action';\nimport Collections from './collections';\n\nconst initData = {\n    pre_heading: \"Collections\",\n    heading: \"My Collections\",\n    content: \"\",\n    btnText: \"Create New\"\n}\n\nconst MyCollections = (props) => {\n    const [categories, setCategories] = useState(null)\n    const [categoriesLoader, setCatLoader] = useState(true) // categories loader\n    const [collectionsLoader, setColLoader] = useState(true) // collections loader\n    const collectionsRef = useRef(null)\n\n    useEffect(() => {\n        window.scroll(0, 0)\n        props.getCategories()\n    }, [])\n\n    // when categories data is received\n    useEffect(() => {\n        if (props.category.getAuth) {\n            const { categories } = props.category\n            const allCat = { active: true, name: 'all' }\n            setCategories([allCat, ...categories])\n            props.beforeCategory()\n            setCatLoader(false)\n        }\n    }, [props.category.getAuth])\n\n    const getColLoader = (loader) => {\n        setColLoader(loader)\n    }\n\n    const getCatCollections = (catId) => {\n        collectionsRef.current?.getCatCollections(catId)\n    }\n    // alert(\"cdskjfdkjf\")\n  console.log(categories,\"categories==>\")\n    return (\n        <>\n            {(categoriesLoader || collectionsLoader) && <FullPageLoader />}\n            <section className=\"explore-area padding-wrapper\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12\">\n                            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                                <div className=\"intro-content\">\n                                    <span>{initData.pre_heading}</span>\n                                    <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                                </div>\n                                <div className=\"intro-btn\">\n                                    <Link className=\"btn content-btn text-left\" to=\"/collection/create\">{initData.btnText}</Link>\n                                </div>\n                            </div>\n                            <div className=\"intro my-3\">\n                                <p>{initData.content}</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div className=\"row justify-content-center text-center\">\n                        <div className=\"col-12\">\n                            {/* Explore Menu */}\n                            <div className=\"explore-menu btn-group btn-group-toggle flex-wrap justify-content-center text-center mb-4\" data-toggle=\"buttons\">\n                                {\n                                    categories && categories.length > 0 &&\n                                    categories.map((item, index) => {\n                                        return (\n                                            <label onClick={() => getCatCollections(item._id)} key={`cat_${index}`} className={`btn ${item.active ? 'active' : ''} d-table text-uppercase p-2`}>\n                                                <input type=\"radio\" defaultValue={item.name} defaultChecked className=\"explore-btn\" />\n                                                <span>{item.name}</span>\n                                            </label>\n                                        )\n                                    })\n                                }\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <Collections all={true} userId='61408000cef27850fdea272b' setLoader={getColLoader} ref={collectionsRef} mycollections />\n            </section>\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    error: state.error,\n    category: state.category\n});\n\nexport default connect(mapStateToProps, { beforeCategory, getCategories })(MyCollections);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/help-center/help-center.js",["654"],"import React, { Component } from 'react';\nimport Help from '../help/help';\nimport Faq from '../faq/faq';\n\nclass HelpCenter extends Component {\n\n    componentDidMount() {\n        window.scroll(0, 0)\n    }\n\n    render() {\n        return (\n            <>\n                {/* <Help /> */}\n                <Faq />\n            </>\n        );\n    }\n}\n\nexport default HelpCenter;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/author/author.js",["655","656","657","658","659","660","661","662"],"import React, { useEffect, useState } from \"react\";\r\nimport { useParams } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport AuthorProfile from \"../author-profile/author-profile\";\r\nimport Explore from \"../explore/explore-all\";\r\nimport { getUserById, beforeUser } from \"./../user/user.action\";\r\nimport FilterSearch from \"../filter-search2/filtersearch2\";\r\nimport { ENV } from \"./../../config/config\";\r\n\r\nconst Author = (props) => {\r\n  const params = useParams();\r\n  const [authorProfile, setAuthorProfile] = useState({});\r\n  useEffect(() => {\r\n    props.getUserById(params.authorId);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.user.individualUserAuth) {\r\n      setAuthorProfile(props.user.individualUser);\r\n      props.beforeUser();\r\n    }\r\n  }, [props.user.individualUserAuth]);\r\n  return (\r\n    <section\r\n      className=\"author-area explore-area popular-collections-area\"\r\n      style={{ padding: \"0px\" }}\r\n    >\r\n      <div className=\"\">\r\n        <div className=\"d-flex author-detail-container\">\r\n          <div className=\"author-preview author-card\">\r\n            <div className=\"seller\">\r\n              <div className=\"seller-thumb avatar-lg\">\r\n                <img\r\n                  className=\"rounded-circle\"\r\n                  src={props.profileImage ? props.profileImage : ENV.globalPlaceholderImage}\r\n                  alt=\"User Profile\"\r\n                  style={{ height: \"110px\" }}\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"card-caption p-0 text-center\">\r\n            <div className=\"card-body\">\r\n              <h5 className=\"mb-3\">{authorProfile.username}</h5>\r\n              <p className=\"my-3\">{authorProfile.description}</p>\r\n              <div className=\"input-group\">\r\n                <input type=\"text\" className=\"form-control\" placeholder=\"0x000000000000000000\" readOnly value={authorProfile.address}\r\n                  style={{\r\n                    borderRadius: \"100px\",\r\n                    backgroundColor: \"transparent\",\r\n                    border: \"2px solid\",\r\n                    height: \"40px\",\r\n                    padding: \"1.5rem\",\r\n                    boxShadow: \"none\",\r\n                    outline: \"none\",\r\n\r\n                  }}\r\n                />\r\n                <div className=\"input-group-append\"\r\n                  style={{\r\n                    position: \"absolute\",\r\n                    height: \"100%\",\r\n                    top: \"0\",\r\n                    right: \"0\",\r\n                    borderRadius: \"100px\",\r\n                    overflow: \"hidden\",\r\n                  }}\r\n                >\r\n                  <button style={{\r\n                    marginRight: \"5px\",\r\n                    padding: \"12px 16px\",\r\n                    backgroundColor: \"transparent\",\r\n                    color: \"#fff\",\r\n                    border: \"0\",\r\n                    outline: \"none\",\r\n                  }}><i className=\"icon-docs\" /></button>\r\n                </div>\r\n              </div>\r\n              <div className=\"social-icons d-flex justify-content-center my-3\">\r\n                {\r\n                  authorProfile.facebookLink && <a className=\"facebook\" href={authorProfile.facebookLink} target=\"_blank\">\r\n                    <i className=\"fab fa-facebook-f\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.twitterLink && <a className=\"twitter\" href={authorProfile.twitterLink} target=\"_blank\">\r\n                    <i className=\"fab fa-twitter\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.gPlusLink && <a className=\"google-plus\" href={authorProfile.gPlusLink} target=\"_blank\">\r\n                    <i className=\"fab fa-google-plus-g\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.vineLink && <a className=\"vine\" href={authorProfile.vineLink} target=\"_blank\">\r\n                    <i className=\"fab fa-vine\" />\r\n                  </a>\r\n                }\r\n              </div>\r\n              {\r\n                props.followText &&\r\n                <a className=\"btn btn-bordered-white btn-smaller\" href=\"#\">{props.followText}</a>\r\n              }\r\n            </div>\r\n          </div>\r\n          <div className=\"d-flex collection-wrapper\">\r\n            <FilterSearch />\r\n            <div className=\"nfts-collection-wrapper w-100\">\r\n              <Explore />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  error: state.error,\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { getUserById, beforeUser })(Author);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/profile/profile.js",["663","664","665","666","667"],"import React, { useEffect, useState } from 'react'\nimport { connect } from 'react-redux';\nimport AuthorProfile from \"../author-profile/author-profile\"\nimport { SET_INDIVIDUAL_USER } from '../../redux/types';\nimport 'react-toastify/dist/ReactToastify.css'\nimport $ from 'jquery'\nimport SimpleReactValidator from 'simple-react-validator'\nimport {updateProfile, setIndividualUserData, beforeUser} from './../user/user.action';\nimport {signRequest} from './../../utils/web3';\nimport {ENV} from './../../config/config';\nimport { toast } from 'react-toastify';\nimport {useHistory} from 'react-router-dom'\n\nconst Profile = (props) => {\n    const [isSubmitted, setIsSubmitted] = useState(false)\n    const [loader, setLoader] = useState(false)\n    const [errors, setErrors] = useState('')\n    const [connectedAddress, setConnectedAddress] = useState('')\n    const [image, setImage] = useState('')\n    const [imageUrl, setImageUrl] = useState('')\n    const [banner, setBannerImage] = useState('')\n    const [bannerUrl, setBannerUrl] = useState('')\n    const [address, setAddress] = useState('')\n    const [email, setEmail] = useState('')\n    const [username, setUsername] = useState('')\n    const [description, setDescription] = useState('')\n    const [facebookLink, setFbLink] = useState('')\n    const [twitterLink, setTwitterLink] = useState('')\n    const [gPlusLink, setgPlusLink] = useState('')\n    const [vineLink, setVineLink] = useState('')\n    const [_id, setUserId] = useState('')\n    const history=useHistory()\n    let validator = new SimpleReactValidator({\n        autoForceUpdate: this,\n        messages: {\n            required: 'This field is required.'  // will override all messages\n        },\n    })\n    useEffect(()=>{\n        let user = ENV.getUserKeys('');\n        props.setIndividualUserData(user);\n        setConnectedAddress( user.address ? user.address : '' );\n        setAddress( user.address ? user.address : '');\n        setEmail( user.email ? user.email : '' );\n        setUserId( user._id ? user._id : '' );\n        setDescription( user.description ? user.description : '' );\n        setFbLink( user.facebookLink ? user.facebookLink : '' );\n        setgPlusLink( user.gPlusLink ? user.gPlusLink : '' );\n        setTwitterLink( user.twitterLink ? user.twitterLink : '' );\n        setVineLink( user.vineLink ? user.vineLink : '' );\n        setUsername( user.username ? user.username : '' );\n        setImageUrl( user.profileImage ? user.profileImage : '' );\n    }, []);\n\n    useEffect(()=>{\n        if (props.user.userAuth) {\n            props.beforeUser();\n            setLoader(false);\n        }\n    }, [props.user.userAuth]);\n\n    useEffect(() => {\n        if (props.error) {\n            setErrors(props.error.message);\n            goToTop();\n        }\n    }, [props.error]);\n\n    const goToTop = () => {\n        $('html, body').animate({\n            scrollTop: 0\n        }, 600)\n    }\n\n    const onFileChange = (e) => {\n        let file = e.target.files[0];\n        let fileURL = '';\n        if (file) {\n            if (file.type.includes('image')) {\n                fileURL = URL.createObjectURL(file)\n            } else {\n                file = {};\n                fileURL = '';\n            }\n            setImageUrl(fileURL);\n            setImage(file);\n        }\n    }\n\n    const onBannerChange = (e) => {\n        let file = e.target.files[0];\n        let fileURL = '';\n        if (file) {\n            if (file.type.includes('image')) {\n                fileURL = URL.createObjectURL(file)\n            } else {\n                file = {};\n                fileURL = '';\n            }\n            setBannerUrl(fileURL);\n            setBannerImage(file);\n        }\n    }\n\n    const submit = async (e) => {\n        e.preventDefault();\n        setErrors(\"\");\n        setIsSubmitted(true);\n        let isFormValid = validator.allValid() ? true : false;\n        if(isFormValid) {\n            try {\n                let signature = await signRequest();\n                setLoader(true);\n                var formData = new FormData();\n                formData.append('profileImage', image)\n                formData.append('bannerImage', banner)\n                formData.append('description', description)\n                formData.append('facebookLink', facebookLink)\n                formData.append('twitterLink', twitterLink)\n                formData.append('gPlusLink', gPlusLink)\n                formData.append('vineLink', vineLink)\n                formData.append('username', username)\n                formData.append('signature', signature)\n                props.updateProfile(formData);\n            }\n            catch (e) {\n\n            }\n            \n        }\n        else {\n            validator.showMessages();\n            setErrors('Please fill all required fields in valid format.');\n            goToTop();\n        }\n    }\n    if(!ENV.getUserKeys('_id')._id){\n        toast.error(\"Please login to view profile\")\n        history.push('/')\n           return \" \"\n       }\n       else {\n\n    return (\n        <section className=\"author-area\">\n            <div className=\"container\">\n                <div className=\"row justify-content-between\">\n                    <div className=\"col-12 col-md-4\">\n                        <AuthorProfile profileImage={imageUrl} username={username} description={description} address={connectedAddress} facebookLink={facebookLink} twitterLink={twitterLink} gPlusLink={gPlusLink} vineLink={vineLink} />\n                    </div>\n                    <div className=\"col-12 col-md-7\">\n                        <div className=\"mt-5 mt-lg-0 mb-4 mb-lg-5\">\n                            <div className=\"intro\">\n                                <div className=\"intro-content\">\n                                    <span>Your Profile</span>\n                                    <h3 className=\"mt-3 mb-0\">Update your profile</h3>\n                                </div>\n                            </div>\n                        </div>\n                        <form id=\"create-nft\" className=\"item-form card no-hover\">\n                            {\n                                isSubmitted && errors &&\n                                <div className=\"row pb-2\">\n                                    <div className=\"col-12\">\n                                        <span id=\"create-nft-err\" className=\"text-danger\">{errors}</span>\n                                    </div>\n                                </div>\n                            }\n                            <div className=\"row\">\n                                <div className=\"col-12\">\n                                    <div className=\"input-group form-group\">\n                                        <div className=\"custom-file\">\n                                            <input type=\"file\" className=\"custom-file-input\" id=\"banner\" accept=\".png,.jpeg,.jpg\" onChange={(e) => onBannerChange(e)} name=\"banner\" />\n                                            <label id=\"nft-imasge-label\" className=\"custom-file-label\" htmlFor=\"banner\">\n                                                {banner && banner.name ? banner.name : \"Choose Banner Image\"}\n                                            </label>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"input-group form-group\">\n                                        <div className=\"custom-file\">\n                                            <input type=\"file\" className=\"custom-file-input\" id=\"image\" accept=\".png,.jpeg,.jpg\" onChange={(e) => onFileChange(e)} name=\"image\" />\n                                            <label id=\"nft-imasge-label\" className=\"custom-file-label\" htmlFor=\"image\">\n                                                {image && image.name ? image.name : \"Choose Profile Picture\"}\n                                            </label>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"form-group mt-3\">\n                                        <input type=\"text\" className=\"form-control\" name=\"address\" placeholder=\"Wallet Address *\" required=\"required\" value={address} readOnly/>\n                                        <span className=\"text-danger\">{validator.message('address', address, 'required')}</span>\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"form-group mt-3\">\n                                        <input type=\"text\" className=\"form-control\" name=\"email\" placeholder=\"Email *\" required=\"required\" value={email} readOnly/>\n                                        <span className=\"text-danger\">{validator.message('email', email, 'required')}</span>\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"form-group mt-3\">\n                                        <input type=\"text\" className=\"form-control\" name=\"username\" placeholder=\"Username *\" required=\"required\" onChange={(e) => setUsername(e.target.value)} defaultValue={username} />\n                                        <span className=\"text-danger\">{validator.message('username', username, 'required')}</span>\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"form-group\">\n                                        <textarea className=\"form-control\" name=\"description\" placeholder=\"About\" cols={30} rows={3} onChange={(e) => setDescription(e.target.value)} defaultValue={description} />\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"form-group\">\n                                        <input type=\"text\" className=\"form-control\" name=\"facebookLink\" placeholder=\"Facebook Link\" cols={30} rows={3} onChange={(e) => setFbLink(e.target.value)} defaultValue={facebookLink} />\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"form-group\">\n                                        <input type=\"text\" className=\"form-control\" name=\"twitterLink\" placeholder=\"Twitter Link\" cols={30} rows={3} onChange={(e) => setTwitterLink(e.target.value)} defaultValue={twitterLink} />\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"form-group\">\n                                        <input type=\"text\" className=\"form-control\" name=\"gPlusLink\" placeholder=\"Google Plus Link\" cols={30} rows={3} onChange={(e) => setgPlusLink(e.target.value)} defaultValue={gPlusLink} />\n                                    </div>\n                                </div>\n                                <div className=\"col-12\">\n                                    <div className=\"form-group\">\n                                        <input type=\"text\" className=\"form-control\" name=\"vineLink\" placeholder=\"Vine Link\" cols={30} rows={3} onChange={(e) => setVineLink(e.target.value)} defaultValue={vineLink} />\n                                    </div>\n                                </div>\n                                \n                                <div className=\"col-12\">\n                                    <button disabled={loader} className=\"btn w-100 mt-3 mt-sm-4\" type=\"button\" onClick={(e) => submit(e)}>Update Profile</button>\n                                </div>\n                            </div> \n                        </form>\n                    </div>\n                </div>\n            </div>\n        </section>\n    )\n                        }\n}\n\nconst mapStateToProps = state => ({\n    wallet: state.wallet,\n    user: state.user,\n    error: state.error\n});\n\nexport default connect(mapStateToProps, { updateProfile, setIndividualUserData, beforeUser })(Profile);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collection-details.js",["668","669","670","671","672","673","674","675","676","677","678","679","680","681","682","683","684","685","686"],"import React, { useState, useEffect, useRef } from \"react\";\nimport CollectionPreview from \"./collection-preview\";\nimport Explore from \"../explore/explore-all\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection, getCollection } from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"../../config/config\";\nimport { Accordion, Dropdown } from \"react-bootstrap\";\nimport Select from 'react-select'\nimport FilterSearch from \"../filter-search/filtersearch\";\nimport NftCard from './components/NftCard/NftCard';\nimport {getNFTs} from '../nfts/nfts.action'\nimport {getCreators, beforeUser} from './../user/user.action';\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV;\n\nconst CollectionDetails = (props) => {\n  const [collection, setCollection] = useState(null);\n  const [nfts, setNfts] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [limit, setLimit] = useState(2);\n  const [collectionLoader, setColLoader] = useState(true); // collections loader\n  const [nftsLoader, setNftsLoader] = useState(true); // NFTs loader\n  const [creators,setCreator]=useState([])\n  const nftsRef = useRef(null);\n\n  useEffect(() => {\n   \n    props.getNFTs()\n    window.scroll(0, 0);\n    const { collectionId } = props.match.params;\n    if (collectionId) props.getCollection(window.atob(collectionId));\n    else props.history.push(\"/collections\");\n  }, []);\n\n  // when collection data is received\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collection } = props.collection;\n  \n      setCollection(collection);\n      props.beforeCollection();\n      setColLoader(false);\n    }\n  }, [props.collection.getAuth]);\n   \n  useEffect(()=>{\n      \n    if(props.user.topSellersAuth ){\n    \n       setCreator(props.user.sellers)\n\n    }\n  },[props.user.topSellersAuth])\n\n  // handle show load more button state when pagination is set\n  useEffect(() => {\n   \n    if (nftPagination)\n        setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length && nfts.length > 0))\n  }, [nftPagination])\n\n  const loadMore = () => {\n    \n    // const { page, limit } = nftPagination\n    setLoader(true)\n    setLimit(limit + 2)\n    // get more NFTs for explore section\n    // getNFTs(1, limit * (page + 1));\n  }\n\n  const filterNfts=(nfts)=>{\n\n    if(collection)\n    {\n      const result_nft = nfts.filter((nft)=>nft?.collectionId===collection._id);\n      nfts.pagination = { page: 1, limit: 10, total: result_nft.length, pages: 1 }\n      setNfts(result_nft.slice(0, limit));\n      setNFTPagination(nfts.pagination)\n      getNftsLoader(false);\n    }\n  }\n\n\n\n\n  const getNFTs = (page = 1, limit = 2) => {\n      const nftQS = { page, limit }\n      if (props.collectionId)\n          nftQS.collectionId = props.collectionId\n      const qs = ENV.objectToQueryString(nftQS)\n      props.getNFTs(qs)\n  }\n\n  useEffect(()=>{\n    if(props.nft.nftsAuth)\n    {\n      const {nftsData}=props.nft;\n      filterNfts(nftsData)  \n    }\n\n  },[props?.nft?.nftsAuth,collection, limit])\n\n\n\n  const getNftsLoader = (loader) => {\n    setNftsLoader(loader);\n  };\n\n  return (\n    <section\n      className=\"author-area explore-area  popular-collections-area\"\n      style={{ padding: \"0px\" }}\n    >\n      {(collectionLoader || nftsLoader) && <FullPageLoader />}\n      <div className=\"\">\n        {collection  && (\n          <div className=\"row p-5\" style={{width:\"80%\",margin:\"auto\"}}>\n            <div className=\"col-4 p-4\">\n              <CollectionPreview collection={collection} creators={creators} />\n            </div>\n            <div className=\"col-8 \">\n              <div className=\"row justify-content-center mt-5\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  <div className=\"intro text-center mb-4\">\n                      {/* <span>{initData.pre_heading}</span> */}\n                      <span>Explore</span>\n                      {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                          <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row gx-5 p-4\">\n              \n                {\n                  nfts && creators && nfts.map((nft)=>{\n                  return (\n                    <div className=\"col-6 mt-5\" style={{}}>\n                      <NftCard nft={nft} creators={creators}/>\n                    </div>\n                    )\n                  })\n                }\n                {\n                  loadMoreBtn &&\n                  <div className=\"row w-100\">\n                      <div className=\"col-12 w-100 text-center\">\n                          <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>Load More</a>\n                      </div>\n                  </div>\n                }\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  {\n\n  error: state.error,\n  collection: state.collection,\n  nft:state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollection,\n  getNFTs,\n  getCreators\n})(CollectionDetails);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.js",["687","688","689","690","691","692"],"import React, { useState, useEffect } from 'react';\nimport { Redirect, useHistory } from 'react-router-dom';\nimport validator from 'validator'\nimport { connect } from 'react-redux';\nimport { connectMetamaskCopy, signRequest } from '../../utils/web3'\nimport { beforeWallet, setWalletAddress } from '../wallet/wallet.action';\nimport { toast } from 'react-toastify';\n// import { getCollections } from '../collections/collections.actions'\nimport { ENV } from '../../config/config';\nimport { login, signup } from '../user/user.action';\nimport './wallet.css'\n\nconst Wallet = (props) => {\n    const history = useHistory();\n    const [connectedAddress, setConnectedAddress] = useState('');\n    const [errorMessage, setErrorMessage] = useState('');\n    const [showSignUp, setShowSignUp] = useState(false);\n    const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n    const [email, setEmail] = useState('');\n    const [username, setUsername] = useState('');\n\n    const connectMetamaskCall = async () => {\n        let connectedAddress = await connectMetamaskCopy();\n        setConnectedAddress(connectedAddress);\n        setWalletAddress(connectedAddress);\n\n    }\n\n    useEffect(() => {\n        if (props.error) {\n            console.log('errors', props.error)\n            \n            setErrorMessage(props.error.message);\n            if (props.error.notExist) {\n                setShowSignUp(true);\n            } else {\n                setShowSignUp(false);\n            }\n        }\n    }, [props.error]);\n\n    useEffect(() => {\n        // console.log(\"dskms;kdncksjdncksjdcnkjscnd\", props.user.userAuth);\n        if(props.collection.getAuth === true) {\n            let collections = props.collection.collections;\n            // console.log('collections',collections)\n            const userId = ENV.getUserKeys('_id')._id;\n            // console.log(\"userID\", userId);\n            let myCollections = collections.filter(el => el.userId === userId);\n            // console.log(\"myCollections\", myCollections);\n            // if(myCollections && myCollections.length > 0){\n            //     // history.push('/create')\n            //     history.push('/user-dashboard')\n            // }\n            // else {\n            //     // history.push('/collection/create');\n            //     history.push('/user-dashboard')\n            // }\n        }\n    }, [props.collection.getAuth])\n\n\n\n\n    const signup = async (e) => {\n        e.preventDefault();\n        try {\n\n            if (validator.isEmail(email)) {\n                let sign = await signRequest();\n                let payload = {\n                    address: connectedAddress,\n                    // password: sign,\n                    email: email,\n                    username: username\n                }\n            props.signup(payload);\n              } else {\n                setErrorMessage('please enter valid email')\n              }\n           \n        }\n        catch(err){\n        \n            toast.error(err.message)\n        }\n\n\n    }\n\n    const login = async () => {\n        try {\n\n            let sign = await signRequest();\n            let payload = {\n                address: connectedAddress,\n       \n            }\n            props.login(payload);\n        }\n        catch(err){\n         \n            toast.error(err.message)\n        }\n   \n    }\n\n    const switchSignup = () => {\n        setShowSignUpComponent(true);\n    }\n\n    // if (props.user.userAuth) {\n    //     console.log(\"@@@@Collection-----@\", collections);\n    //     if(collections && collections.length>){\n    //         console.log(\"In Upper\")\n    //         return <Redirect to=\"/create\" />\n    //     }\n    //     else {\n    //         console.log(\"In Down\");\n    //         return <Redirect to=\"/collection/create\" />\n    //     }\n    // }\n\n    return (\n        <section className={!showSignUpComponent ? `wallet-connect-area wallet-wrapper` : `author-area wallet-wrapper` }>\n              \n            <div className=\"container\">\n                {\n                    connectedAddress && !showSignUpComponent ?\n                        <>\n                            <div className=\"row justify-content-center\">\n                                <div className=\"col-12 col-md-8 col-lg-7\">\n                                    {/* Intro */}\n                                    <div className=\"intro text-center\">\n                                        <span>Sign In</span>\n                                        <h3 className=\"mt-3 mb-0\">SignIn to your account</h3>\n                                        {/* <p>Please select the wallet you want to connect to.</p> */}\n                                    </div>\n                                </div>\n                            </div>\n                            <div className=\"row justify-content-center items\">\n                                <div className=\"col-12 col-md-6 col-lg-4 item\">\n                                    <div className=\"card single-wallet sign-in-card\">\n                                        <span className=\"d-block text-center\" href=\"/login\">\n                                            <h4 className=\"mb-0\">Address</h4>\n                                            <p id=\"connected-address mt-2\">{connectedAddress}</p>\n                                            {\n                                                errorMessage && <p className=\"text-gray\">{errorMessage}</p>\n                                            }\n                                            <button className=\"btn w-100 mt-3 mt-sm-4 text-white\" type=\"button\" onClick={() => login()}>Sign In</button>\n                                            {\n                                                showSignUp && <button className=\"btn w-100 mt-3 mt-sm-4 text-white\" type=\"button\" onClick={() => switchSignup()}>Would you like to Signup?</button>\n                                            }\n                                        </span>\n                                    </div>\n                                </div>\n                            </div>\n                        </>\n                        :\n                        showSignUpComponent ?\n                            <div className=\"row justify-content-center\">\n                                <div className=\"col-12 col-md-8 col-lg-7\">\n                                    {/* Intro */}\n                                    <div className=\"intro text-center\">\n                                        <span>SIGNUP</span>\n                                        <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                                        <p className=\"text-gray\">Create the account with the address</p>\n                                    </div>\n                                    {/* Item Form */}\n                                    <form className=\"item-form card no-hover signup-card\" onSubmit={(e) => signup(e)}>\n                                        <div className=\"row\">\n                                            {\n                                                errorMessage && <p className=\"text-center text-gray\">{errorMessage}</p>\n                                            }\n                                            <div className=\"col-12\">\n                                                <div className=\"form-group mt-3\">\n                                                    <input type=\"text\" className=\"form-control sign-up-input\" name=\"address\" placeholder=\"Address\" required=\"required\" disabled={true} value={connectedAddress} />\n                                                </div>\n                                            </div>\n                                            <div className=\"col-12\">\n                                                <div className=\"form-group mt-3\">\n                                                    <input type=\"email\" className=\"form-control sign-up-input\" name=\"email\" placeholder=\"Enter your Email\" required=\"required\" defaultValue={email} onChange={(e) => setEmail(e.target.value)} />\n                                                </div>\n                                            </div>\n                                            <div className=\"col-12\">\n                                                <div className=\"form-group mt-3\">\n                                                    <input type=\"text\" className=\"form-control sign-up-input\" name=\"username\" placeholder=\"Enter your Username\" required=\"required\" defaultValue={username} onChange={(e) => setUsername(e.target.value)} />\n                                                </div>\n                                            </div>\n                                            <div className=\"col-12\">\n                                                <div className=\"form-group mt-3 text-center\">\n                                                    <div className=\"form-check form-check-inline\">\n                                                        <input className=\"form-check-input\" type=\"radio\" name=\"inlineRadioOptions\" id=\"inlineRadio1\" defaultValue=\"option1\" />\n                                                        <label className=\"form-check-label text-center text-gray\" htmlFor=\"inlineRadio1\">I agree to <a href=\"/privacy-and-terms\">Privacy Policy</a></label>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <div className=\"col-12\">\n                                                <button className=\"btn w-100 mt-3 mt-sm-4  text-white \" type=\"submit\">Sign Up</button>\n                                            </div>\n                                            {/* <div className=\"col-12\">\n                                        <span className=\"d-block text-center mt-4\">Already have an account? <a href=\"/login\">Login</a></span>\n                                    </div> */}\n                                        </div>\n                                    </form>\n                                </div>\n                            </div>\n                            :\n                            <>\n                                <div className=\"row justify-content-center\">\n                                    <div className=\"col-12 col-md-8 col-lg-7\">\n                                        {/* Intro */}\n                                        <div className=\"intro text-center\">\n                                            <span>Wallet Connect</span>\n                                            <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                                            <p className=\"text-white mt-3\">Please select the wallet you want to connect to.</p>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div className=\"row justify-content-center items\">\n                                    {\n                                        errorMessage && <p className=\"text-white\">{errorMessage}</p>\n                                    }\n                                    <div className=\"col-12 col-md-6 col-lg-4 item\" onClick={() => connectMetamaskCall()}>\n                                        {/* Single Wallet */}\n                                        <div className=\"card single-wallet whole-hover wallet-metamask-card\">\n                                            <span className=\"d-block text-center\" href=\"/login\">\n                                                <img className=\"avatar-lg\" src=\"/img/metamask2.png\" alt=\"\" />\n                                                <h4 className=\"mb-0 my-3\">MetaMask</h4>\n                                                <p>A browser extension with great flexibility. The web's most popular wallet</p>\n                                            </span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </>\n                }\n            </div>\n        </section>\n    );\n}\n\n\nconst mapStateToProps = state => (\n    {\n        wallet: state.wallet,\n        collection: state.collection,\n        user: state.user,\n        error: state.error\n});\n\nexport default connect(mapStateToProps, { beforeWallet, setWalletAddress, login, signup })(Wallet);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/signup/signup.js",["693","694"],"import React, { Component } from 'react';\r\n\r\nconst initData = {\r\n    pre_heading: \"Signup\",\r\n    heading: \"Create an Account\",\r\n    content: \"\"\r\n}\r\n\r\nconst socialData = [\r\n    {\r\n        id: \"1\",\r\n        link: \"facebook\",\r\n        icon: \"fab fa-facebook-f\"\r\n    },\r\n    {\r\n        id: \"2\",\r\n        link: \"twitter\",\r\n        icon: \"fab fa-twitter\"\r\n    },\r\n    {\r\n        id: \"3\",\r\n        link: \"google-plus\",\r\n        icon: \"fab fa-google-plus-g\"\r\n    }\r\n]\r\n\r\nclass Signup extends Component {\r\n    state = {\r\n        initData: {},\r\n        data: []\r\n    }\r\n    componentDidMount() {\r\n        this.setState({\r\n            initData: initData,\r\n            data: socialData\r\n        })\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"author-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row justify-content-center\">\r\n                        <div className=\"col-12 col-md-8 col-lg-7\">\r\n                            {/* Intro */}\r\n                            <div className=\"intro text-center\">\r\n                                <span>{this.state.initData.pre_heading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                                <p>{this.state.initData.content}</p>\r\n                            </div>\r\n                            {/* Item Form */}\r\n                            <form className=\"item-form card no-hover\">\r\n                                <div className=\"row\">\r\n                                    <div className=\"col-12\">\r\n                                        <div className=\"form-group mt-3\">\r\n                                            <input type=\"text\" className=\"form-control\" name=\"name\" placeholder=\"Enter your Name\" required=\"required\" />\r\n                                        </div>\r\n                                    </div>\r\n                                    <div className=\"col-12\">\r\n                                        <div className=\"form-group mt-3\">\r\n                                            <input type=\"email\" className=\"form-control\" name=\"email\" placeholder=\"Enter your Email\" required=\"required\" />\r\n                                        </div>\r\n                                    </div>\r\n                                    {/* <div className=\"col-12\">\r\n                                        <div className=\"form-group mt-3\">\r\n                                            <input type=\"password\" className=\"form-control\" name=\"password\" placeholder=\"Enter your Password\" required=\"required\" />\r\n                                        </div>\r\n                                    </div> */}\r\n                                    <div className=\"col-12\">\r\n                                        <div className=\"form-group mt-3\">\r\n                                            <div className=\"form-check form-check-inline\">\r\n                                                <input className=\"form-check-input\" type=\"radio\" name=\"inlineRadioOptions\" id=\"inlineRadio1\" defaultValue=\"option1\" />\r\n                                                <label className=\"form-check-label\" htmlFor=\"inlineRadio1\">I agree to <a href=\"#\">Privacy Policy</a></label>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                    <div className=\"col-12\">\r\n                                        <button className=\"btn w-100 mt-3 mt-sm-4\" type=\"submit\">Sign Up</button>\r\n                                    </div>\r\n                                    <div className=\"col-12\">\r\n                                        <span className=\"d-block text-center mt-4\">Already have an account? <a href=\"/login\">Login</a></span>\r\n                                    </div>\r\n                                    <div className=\"col-12\">\r\n                                        <hr />\r\n                                        <div className=\"other-option\">\r\n                                            <span className=\"d-block text-center mb-4\">Or</span>\r\n                                            {/* Social Icons */}\r\n                                            <div className=\"social-icons d-flex justify-content-center\">\r\n                                                {this.state.data.map((item, idx) => {\r\n                                                    return (\r\n                                                        <a key={`lsd_${idx}`} className={item.link} href=\"#\">\r\n                                                            <i className={item.icon} />\r\n                                                            <i className={item.icon} />\r\n                                                        </a>\r\n                                                    );\r\n                                                })}\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </form>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Signup;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.js",["695"],"import { useEffect, useState } from 'react';\r\n\r\nimport validator from 'validator';\r\nimport { connect } from \"react-redux\";\r\nimport { beforeContact, submitContact } from \"./contact.action\";\r\n\r\nimport Alert from 'react-bootstrap/Alert'\r\n\r\nconst Contact = (props) => {\r\n\r\n    const [data, setData] = useState({\r\n        name: '',\r\n        email: '',\r\n        subject: '',\r\n        message: ''\r\n    })\r\n\r\n    const [msg, setMsg] = useState({\r\n        name: '',\r\n        email: '',\r\n        subject: '',\r\n        message: ''\r\n    })\r\n\r\n    const [submitCheck, setSubmitCheck] = useState(false)\r\n    const [alertCheck, setAlertCheck] = useState(false)\r\n\r\n    useEffect(() => {\r\n        window.scroll(0, 0)\r\n    }, [])\r\n\r\n    useEffect(() => {\r\n        if (props.contact.contactAuth) {\r\n            setAlertCheck(true)\r\n            setTimeout(()=>{\r\n                setAlertCheck(false)\r\n            }, 3000)\r\n            props.beforeContact()\r\n        }\r\n    }, [props.contact.contactAuth])\r\n\r\n    const showAlert = () => {\r\n        if (alertCheck) {\r\n            return (\r\n                <Alert variant=\"success\" onClose={() => setAlertCheck(false)} dismissible>\r\n                    <span>\r\n                        Contact message sent successfully.\r\n                    </span>\r\n                </Alert>\r\n            );\r\n        }\r\n    }\r\n\r\n    const formSubmission = (e) => {\r\n        e.preventDefault()\r\n        setSubmitCheck(true)\r\n        if (!validator.isEmpty(data.name) && validator.isEmail(data.email)\r\n            && !validator.isEmpty(data.subject) && !validator.isEmpty(data.message)) {\r\n            let formData = new FormData()\r\n            for (const key in data)\r\n                formData.append(key, data[key])\r\n            props.submitContact(formData)\r\n            setData({ name: '', email: '', subject: '', message: '' })\r\n            setMsg({ name: '', email: '', subject: '', message: '' })\r\n            e.target[0].value = ''\r\n            e.target[1].value = ''\r\n            e.target[2].value = ''\r\n            e.target[3].value = ''\r\n        }\r\n        else {\r\n            let name = ''\r\n            let email = ''\r\n            let subject = ''\r\n            let message = ''\r\n            if (validator.isEmpty(data.name)) {\r\n                name = 'Name Is Required.'\r\n            }\r\n            if (!validator.isEmail(data.email)) {\r\n                email = 'Email Is Required.'\r\n            }\r\n            if (validator.isEmpty(data.subject)) {\r\n                subject = 'Subject Is Required.'\r\n            }\r\n            if (validator.isEmpty(data.message)) {\r\n                message = 'Message Is Required.'\r\n            }\r\n            setMsg({ name, email, subject, message })\r\n        }\r\n    }\r\n\r\n    return (\r\n        <section className=\"author-area\">\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>{\"Contact\"}</span>\r\n                            <h3 className=\"mt-3 mb-0\">{\"Get In Touch\"}</h3>\r\n                        </div>\r\n                        {/* Item Form */}\r\n                        <form id=\"contact-form\" className=\"item-form card no-hover\" onSubmit={(e) => formSubmission(e)}>\r\n                            <div className=\"row\">\r\n                                <div className=\"col-12\">\r\n                                    {showAlert()}\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"name\" placeholder=\"Name\" value={data.name}\r\n                                            id=\"contact-name\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, name: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, name: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, name: 'Name Is Required.' })\r\n                                                    }\r\n\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.name ? `` : `d-none`}`}>{msg.name}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"email\" placeholder=\"Email\" value={data.email}\r\n                                            id=\"contact-email\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, email: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (validator.isEmail(e.target.value)) {\r\n                                                        setMsg({ ...msg, email: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, email: 'Email Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.email ? `` : `d-none`}`}>{msg.email}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"subject\" placeholder=\"Subject\" value={data.subject}\r\n                                            id=\"contact-subject\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, subject: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, subject: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, subject: 'Subject Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            }\r\n                                        />\r\n                                        <label className={`text-danger pl-1 ${msg.subject ? `` : `d-none`}`}>{msg.subject}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <textarea className=\"form-control\" name=\"message\" placeholder=\"Message\" cols={30} rows={3} defaultValue={\"\"} value={data.message}\r\n                                            id=\"contact-message\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, message: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, message: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, message: 'Message Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.message ? `` : `d-none`}`}>{msg.message}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <button className=\"btn w-100 mt-3 mt-sm-4\" type=\"submit\"><i className=\"icon-paper-plane mr-2\" />Send Message</button>\r\n                                </div>\r\n                            </div>\r\n                        </form>\r\n                        <p className=\"form-message\" />\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n    error: state.error,\r\n    contact: state.contact,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeContact, submitContact })(Contact);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/sell-nft.js",["696","697","698","699","700","701","702","703"],"import React, {\r\n  useState,\r\n  useEffect,\r\n} from \"react\";\r\nimport {\r\n  Container,\r\n  Row,\r\n  Col,\r\n  Nav,\r\n} from \"react-bootstrap\";\r\nimport Tab from \"react-bootstrap/Tab\";\r\nimport { connect } from \"react-redux\";\r\nimport {\r\n  beforeNFT,\r\n  getNFT,\r\n  upsertNFT,\r\n} from \"./nfts.action\";\r\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\r\nimport NFTPreview from \"../nft-preview/nft-preview\";\r\nimport { decimalNumberValidator } from \"../../utils/functions\";\r\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\r\nimport \"bootstrap-daterangepicker/daterangepicker.css\";\r\nimport moment from \"moment\";\r\nimport currencyIcon from \"../../assets/images/binance.svg\";\r\nimport { ENV } from \"../../config/config\";\r\nimport {openNFTForBidding} from '../../utils/web3';\r\nimport {SellOnFixedPrice} from '../../utils/web3'\r\nimport { toast } from \"react-toastify\";\r\nconst {\r\n  currencies,\r\n  dateRangeInitialSettings,\r\n  serviceFee,\r\n} = ENV;\r\n\r\nconst config1 = {\r\n  price: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n  listingSchedule: {\r\n    startDate: moment(),\r\n    endDate: moment().add(6, \"months\"),\r\n    startTime: moment(new Date()).format(\"HH:mm\"),\r\n    endTime: \"23:59\",\r\n  },\r\n  reserveFor: \"\", // if user selects reserve buyer\r\n};\r\nconst config2 = {\r\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\r\n  startPrice: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n  duration: {\r\n    startDate: moment(),\r\n    endDate: moment().add(6, \"months\"),\r\n    startTime: moment(new Date()).format(\"HH:mm\"),\r\n    endTime: \"23:59\",\r\n  },\r\n  // if user includes reserve price\r\n  reservePrice: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n};\r\n\r\nconst SellNFT = (props) => {\r\n  const [sellingMethod, setSellingMethod] =\r\n    useState(1); // 1 = Fixed Price, 2 = Timed Auction\r\n  const [fixedPriceConfig, setFixedPriceConfig] =\r\n    useState(config1);\r\n  const [\r\n    timedAuctionConfig,\r\n    setTimedAuctionConfig,\r\n  ] = useState(config2);\r\n  const [nft, setNft] = useState(null);\r\n  const [loader, setLoader] = useState(true); // NFT loader\r\n  const [reserveBuyer, setReserveBuyer] =\r\n    useState(false);\r\n  const [reservePrice, setReservePrice] =\r\n    useState(false);\r\n    const [tokensData,setTokensData]=useState([])\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    const { itemId } = props.match.params;\r\n    if (itemId) props.getNFT(window.atob(itemId));\r\n    else props.history.push(\"/explore-all\");\r\n    getTokens()\r\n  }, []);\r\n\r\n  // when NFT data is received\r\n  useEffect(() => {\r\n    if (props.nft.nftsAuth) {\r\n      const nft = props.nft.nftsData;\r\n      setNft(nft);\r\n      setLoader(false);\r\n      props.beforeNFT();\r\n    }\r\n  }, [props.nft.nftsAuth]);\r\n\r\n  // when NFT data is updated\r\n  useEffect(() => {\r\n    if (props.nft.upsertAuth) {\r\n      const { nft } = props.nft.nftsData;\r\n      const pathname = nft.sellingMethod === 1 ? '/explore-all' : '/auctions'\r\n      setLoader(false);\r\n      props.beforeNFT();\r\n      props.history.push(pathname);\r\n    }\r\n  }, [props.nft.upsertAuth]);\r\n\r\n  // when an error is received\r\n  useEffect(() => {\r\n    setLoader(false);\r\n  }, [props.error]);\r\n\r\n  const onChange = (e) => {\r\n    const { name, value } = e.target;\r\n    let data = null;\r\n    if (sellingMethod === 1)\r\n      data = fixedPriceConfig;\r\n    else data = timedAuctionConfig;\r\n\r\n    const keys = name.split(\".\"); // fixedPriceConfig, price, currency\r\n    if (keys && keys[2])\r\n      data[keys[1]][keys[2]] = value;\r\n    else if (keys && keys[1])\r\n      data[keys[1]] = value;\r\n\r\n    if (sellingMethod === 1)\r\n      setFixedPriceConfig({ ...data });\r\n    else setTimedAuctionConfig({ ...data });\r\n  };\r\n\r\n  const handleDateChange = (e, picker) => {\r\n    const { name } = e.target;\r\n    const { startDate, endDate } = picker;\r\n\r\n    // set start date\r\n    onChange({\r\n      target: {\r\n        name: `${name}.startDate`,\r\n        value: startDate,\r\n      },\r\n    });\r\n\r\n    // set end date\r\n    onChange({\r\n      target: {\r\n        name: `${name}.endDate`,\r\n        value: endDate,\r\n      },\r\n    });\r\n  };\r\n\r\n  const submit = () => {\r\n \r\n    const payload = {\r\n      _id: nft._id,\r\n      sellingMethod,\r\n      sellingConfig: JSON.stringify(\r\n        sellingMethod === 1\r\n          ? fixedPriceConfig\r\n          : timedAuctionConfig\r\n      ),\r\n    };\r\n \r\n\r\n    let test=new Date(timedAuctionConfig.duration.endDate).getTime()\r\n    let time=timedAuctionConfig.duration.endTime\r\n\r\nvar r = Number(time.split(':')[0])*60+Number(time.split(':')[1])*1000;\r\n// \r\n  const timeInMiliSeconds=r+test;\r\n \r\n  // console.log('yoken data', tokensData)\r\n  const nftToken=tokensData.data.find((item)=>item?.nftId===nft?._id)\r\n\r\n   if(nftToken){\r\n    sellingMethod==1?SellOnFixedPrice(nftToken?.nftToken,fixedPriceConfig.price.amount):openNFTForBidding(nftToken.nftToken,timeInMiliSeconds)\r\n\r\n    setLoader(true);\r\n\r\n    var formData = new FormData();\r\n    for (const key in payload)\r\n      formData.append(key, payload[key]);\r\n\r\n    props.upsertNFT(\"edit\", formData, \"PUT\");\r\n   }\r\n   else {\r\n    toast.error(\"there was an issue while creating nft, please try later\")\r\n   }\r\n \r\n  };\r\n\r\n\r\n  const getTokens=()=>{\r\n    const url= process.env.REACT_APP_BASE_URL + 'nftTokens/tokens' \r\n  \r\n  fetch(url, {\r\n   method: 'GET',\r\n   headers: {\r\n      'content-type': 'application/json',\r\n      'Authorization': ENV.Authorization,\r\n      'x-auth-token': ENV.x_auth_token,\r\n      'Access-Control-Allow-Origin': '*',\r\n      'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n  },\r\n\r\n}).then(res => res.json()).then(data => {\r\n\r\n  setTokensData(data)\r\n\r\n  \r\n}).catch(error => {\r\n  \r\n  console.log(error,\"error in catch blcok\")\r\n  \r\n\r\n})\r\n\r\n  }\r\n\r\n  return (\r\n    <div className=\"padding-wrapper\">\r\n      {loader && <FullPageLoader />}\r\n      <div\r\n        className=\"\"\r\n        style={{\r\n          maxWidth: \"85%\",\r\n          margin: \"auto\",\r\n        }}\r\n      >\r\n        <div className=\"d-flex\">\r\n          <div className=\"tabs-container\">\r\n            <span className=\"head-wrapper\">\r\n              List of Bundle for Sale\r\n            </span>\r\n            <div className=\"market-tabs-wrapper\">\r\n              <Tab.Container\r\n                id=\"marketplace-tabs\"\r\n                defaultActiveKey=\"fixedPrice\"\r\n              >\r\n                <Row>\r\n                  <Col\r\n                    lg=\"12\"\r\n                    md=\"12\"\r\n                    sm=\"12\"\r\n                    xs=\"12\"\r\n                  >\r\n                    <Nav\r\n                      variant=\"pills\"\r\n                      className=\"flex-row\"\r\n                    >\r\n                      <Nav.Item className=\"nav-item-wrapper\">\r\n                        <div className=\"mb-2\">\r\n                          Type\r\n                        </div>\r\n                        <Nav.Link\r\n                          eventKey=\"fixedPrice\"\r\n                          onClick={() =>\r\n                            setSellingMethod(1)\r\n                          }\r\n                        >\r\n                          <i className=\"fas fa-dollar-sign\" />\r\n                          <div>Fixed Price</div>\r\n                        </Nav.Link>\r\n                      </Nav.Item>\r\n                      <Nav.Item className=\"nav-item-wrapper\">\r\n                        <div className=\"text-right mr-4 mb-2\">\r\n                          <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                        </div>\r\n                        <Nav.Link\r\n                          eventKey=\"timedAuction\"\r\n                          onClick={() =>\r\n                            setSellingMethod(2)\r\n                          }\r\n                        >\r\n                          <i className=\"fas fa-clock\" />\r\n                          <div>Timed Auction</div>\r\n                        </Nav.Link>\r\n                      </Nav.Item>\r\n                    </Nav>\r\n                  </Col>\r\n                </Row>\r\n                <div className=\"market-tab-content\">\r\n                  <Container fluid>\r\n                    <Tab.Content>\r\n                      <Tab.Pane eventKey=\"fixedPrice\">\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text position-relative\">\r\n                            <div className=\"text-white mb-2 absolute-wrapper\">\r\n                              <b>Price</b>\r\n                            </div>\r\n                            <div className=\"text-right mb-2\">\r\n                              <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                            </div>\r\n                            <div className=\"d-flex\">\r\n                              <button\r\n                                type=\"button\"\r\n                                className=\"ethereum-btn\"\r\n                              >\r\n                                <svg\r\n                                  viewBox=\"0 0 126.61 126.61\"\r\n                                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                                  fill=\"currentColor\"\r\n                                  height=\"18\"\r\n                                  width=\"18\"\r\n                                >\r\n                                  <g>\r\n                                    <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                    <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                    <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                    <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                    <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                  </g>\r\n                                </svg>\r\n                                <span className=\"ml-2\">\r\n                                  {ENV.currency}\r\n                                </span>\r\n                              </button>\r\n                              <input\r\n                                type=\"text\"\r\n                                name=\"fixedPriceConfig.price.amount\"\r\n                                placeholder=\"Amount\"\r\n                                className=\"amount-btn ml-3\"\r\n                                style={{\r\n                                  borderRadius:\r\n                                    \"4px\",\r\n                                }}\r\n                                onChange={(e) =>\r\n                                  onChange(e)\r\n                                }\r\n                                onKeyDown={(e) =>\r\n                                  decimalNumberValidator(\r\n                                    e\r\n                                  )\r\n                                }\r\n                                defaultValue={\r\n                                  fixedPriceConfig\r\n                                    .price.amount\r\n                                }\r\n                                required\r\n                              />\r\n                              {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                $ 0.00\r\n                              </div> */}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>\r\n                                Schedule Listing\r\n                              </b>\r\n                            </div>\r\n                            <div className=\"date-picker\">\r\n                              <DateRangePicker\r\n                                initialSettings={\r\n                                  dateRangeInitialSettings\r\n                                }\r\n                                onApply={\r\n                                  handleDateChange\r\n                                }\r\n                              >\r\n                                <button\r\n                                  name=\"fixedPriceConfig.listingSchedule\"\r\n                                  className=\"calender-btn\"\r\n                                >\r\n\r\n                                  {fixedPriceConfig.listingSchedule.startDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}{\" \"}\r\n                                  -{\" \"}\r\n                                  {fixedPriceConfig.listingSchedule.endDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}\r\n                                  &nbsp;&nbsp;&nbsp;\r\n                                  <i className=\"fas fa-calendar-week\" />\r\n                                </button>\r\n                              </DateRangePicker>\r\n                            </div>\r\n\r\n                            <div className=\"row\">\r\n                              <div className=\"mr-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"fixedPriceConfig.listingSchedule.startTime\"\r\n                                  placeholder=\"Start Time\"\r\n                                  onChange={(e) =>\r\n                                    onChange(e)\r\n                                  }\r\n                                  defaultValue={\r\n                                    fixedPriceConfig\r\n                                      .listingSchedule\r\n                                      .startTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n\r\n                              <div className=\"ml-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"fixedPriceConfig.listingSchedule.endTime\"\r\n                                  placeholder=\"End Time\"\r\n                                  onChange={(e) =>\r\n                                    onChange(e)\r\n                                  }\r\n                                  defaultValue={\r\n                                    fixedPriceConfig\r\n                                      .listingSchedule\r\n                                      .endTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        {/* <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>\r\n                                Reserve for\r\n                                specific buyer\r\n                              </b>\r\n                            </div>\r\n                          </div>\r\n                          <div>\r\n                            <label className=\"switch\">\r\n                              <input\r\n                                type=\"checkbox\"\r\n                                checked={\r\n                                  reserveBuyer\r\n                                }\r\n                                onChange={() =>\r\n                                  setReserveBuyer(\r\n                                    !reserveBuyer\r\n                                  )\r\n                                }\r\n                              />\r\n                              <span className=\"slider round\"></span>\r\n                            </label>\r\n                          </div>\r\n                        </div> */}\r\n                        {reserveBuyer && (\r\n                          <div\r\n                            className=\"mb-3 budle-wrapper\"\r\n                            style={{\r\n                              borderBottom:\r\n                                \"1px solid\",\r\n                              paddingBottom:\r\n                                \"2rem\",\r\n                            }}\r\n                          >\r\n                            <span>\r\n                              <input\r\n                                type=\"text\"\r\n                                placeholder=\"0xf45a189...\"\r\n                                required\r\n                                defaultValue={\r\n                                  fixedPriceConfig.reserveFor\r\n                                }\r\n                                onChange={(e) =>\r\n                                  onChange(e)\r\n                                }\r\n                                name=\"fixedPriceConfig.reserveFor\"\r\n                              />\r\n                            </span>\r\n                          </div>\r\n                        )}\r\n                      </Tab.Pane>\r\n                      <Tab.Pane eventKey=\"timedAuction\">\r\n                        <div className=\"form-group\">\r\n                          <label\r\n                            htmlFor=\"method\"\r\n                            className=\"text-white mb-2\"\r\n                          >\r\n                            <b>Method</b>\r\n                          </label>\r\n                          <select\r\n                            className=\"form-control\"\r\n                            id=\"timed-auction-method\"\r\n                            name=\"timedAuctionConfig.method\"\r\n                            onChange={(e) =>\r\n                              onChange(e)\r\n                            }\r\n                          >\r\n                            <option value={1}>\r\n                              Sell to the highest\r\n                              bidder\r\n                            </option>\r\n                            {/* <option value={2}>\r\n                              Sell with the\r\n                              declining price\r\n                            </option> */}\r\n                          </select>\r\n                        </div>\r\n\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text position-relative\">\r\n                            <div className=\"text-white mb-2 absolute-wrapper\">\r\n                              <b>\r\n                                Starting Price\r\n                              </b>\r\n                            </div>\r\n                            <div className=\"text-right mb-2\">\r\n                              <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                            </div>\r\n                            <div className=\"d-flex\">\r\n                              <button\r\n                                type=\"button\"\r\n                                className=\"ethereum-btn\"\r\n                              >\r\n                                <svg\r\n                                  viewBox=\"0 0 126.61 126.61\"\r\n                                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                                  fill=\"currentColor\"\r\n                                  height=\"18\"\r\n                                  width=\"18\"\r\n                                >\r\n                                  <g>\r\n                                    <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                    <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                    <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                    <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                    <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                  </g>\r\n                                </svg>\r\n                                <span className=\"ml-2\">\r\n                                  {ENV.currency}\r\n                                </span>\r\n                              </button>\r\n                              <input\r\n                                type=\"text\"\r\n                                name=\"timedAuctionConfig.startPrice.amount\"\r\n                                placeholder=\"Amount\"\r\n                                className=\"amount-btn ml-3\"\r\n                                style={{\r\n                                  borderRadius:\r\n                                    \"4px\",\r\n                                }}\r\n                                onChange={(e) =>\r\n                                  onChange(e)\r\n                                }\r\n                                onKeyDown={(e) =>\r\n                                  decimalNumberValidator(\r\n                                    e\r\n                                  )\r\n                                }\r\n                                defaultValue={\r\n                                  timedAuctionConfig\r\n                                    .startPrice\r\n                                    .amount\r\n                                }\r\n                                required\r\n                              />\r\n                              {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                $ 0.00\r\n                              </div> */}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>Duration</b>\r\n                            </div>\r\n                            <div className=\"date-picker\">\r\n                              <DateRangePicker\r\n                                initialSettings={\r\n                                  dateRangeInitialSettings\r\n                                }\r\n                                onApply={\r\n                                  handleDateChange\r\n                                }\r\n                              >\r\n                                <button\r\n                                  name=\"timedAuctionConfig.duration\"\r\n                                  className=\"calender-btn\"\r\n                                >\r\n                                  <i className=\"fas fa-calendar-week\" />\r\n                                  &nbsp;&nbsp;&nbsp;\r\n                                  {timedAuctionConfig.duration.startDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}{\" \"}\r\n                                  -{\" \"}\r\n                                  {timedAuctionConfig.duration.endDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}\r\n                                </button>\r\n                              </DateRangePicker>\r\n                            </div>\r\n\r\n                            <div className=\"row\">\r\n                              <div className=\"mr-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"timedAuctionConfig.duration.startTime\"\r\n                                  placeholder=\"Start Time\"\r\n                                  onChange={(e) =>\r\n                                    onChange(e)\r\n                                  }\r\n                                  defaultValue={\r\n                                    timedAuctionConfig\r\n                                      .duration\r\n                                      .startTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n\r\n                              <div className=\"ml-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"timedAuctionConfig.duration.endTime\"\r\n                                  placeholder=\"End Time\"\r\n                                  onChange={(e) =>\r\n                                    onChange(e)\r\n                                  }\r\n                                  defaultValue={\r\n                                    timedAuctionConfig\r\n                                      .duration\r\n                                      .endTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        {/* <div className=\"reverse-price d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>\r\n                                Include reserve\r\n                                price\r\n                              </b>\r\n                            </div>\r\n                          </div>\r\n                          <div>\r\n                            <label className=\"switch\">\r\n                              <input\r\n                                type=\"checkbox\"\r\n                                checked={\r\n                                  reservePrice\r\n                                }\r\n                                onChange={() =>\r\n                                  setReservePrice(\r\n                                    !reservePrice\r\n                                  )\r\n                                }\r\n                              />\r\n                              <span className=\"slider round\"></span>\r\n                            </label>\r\n                          </div>\r\n                        </div> */}\r\n                        {reservePrice && (\r\n                          <div className=\"d-flex\">\r\n                            <button\r\n                              type=\"button\"\r\n                              className=\"ethereum-btn\"\r\n                            >\r\n                              <svg\r\n                                viewBox=\"0 0 126.61 126.61\"\r\n                                xmlns=\"http://www.w3.org/2000/svg\"\r\n                                fill=\"currentColor\"\r\n                                height=\"18\"\r\n                                width=\"18\"\r\n                              >\r\n                                <g>\r\n                                  <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                  <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                  <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                  <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                  <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                </g>\r\n                              </svg>\r\n                              <span className=\"ml-2\">\r\n                                {ENV.currency}\r\n                              </span>\r\n                            </button>\r\n                            <input\r\n                              type=\"text\"\r\n                              name=\"timedAuctionConfig.reservePrice.amount\"\r\n                              placeholder=\"Amount\"\r\n                              className=\"amount-btn ml-3\"\r\n                              style={{\r\n                                borderRadius:\r\n                                  \"4px\",\r\n                              }}\r\n                              onChange={(e) =>\r\n                                onChange(e)\r\n                              }\r\n                              onKeyDown={(e) =>\r\n                                decimalNumberValidator(\r\n                                  e\r\n                                )\r\n                              }\r\n                              defaultValue={\r\n                                timedAuctionConfig\r\n                                  .reservePrice\r\n                                  .amount\r\n                              }\r\n                              required\r\n                            />\r\n                            {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                              $ 0.00\r\n                            </div> */}\r\n                          </div>\r\n                        )}\r\n                      </Tab.Pane>\r\n                    </Tab.Content>\r\n\r\n                    <div className=\"d-flex justify-content-between my-3 text-white\">\r\n                      <div>\r\n                        <b>Fees</b>\r\n                      </div>\r\n                      <div>\r\n                        <i className=\"fas fa-exclamation-circle\" />\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"d-flex justify-content-between text-white mb-4\">\r\n                      <div>Service Fee</div>\r\n                      <div>{serviceFee}%</div>\r\n                    </div>\r\n                    <div className=\"d-flex justify-content-between text-white mb-4\">\r\n                      <div>Creator Royalty</div>\r\n                      <div>\r\n                        {nft?.royalty || 0}%\r\n                      </div>\r\n                    </div>\r\n\r\n                    <button\r\n                      className=\"complete-listing-btn p-3\"\r\n                      onClick={() => submit()}\r\n                    >\r\n                      Complete Listing\r\n                    </button>\r\n                  </Container>\r\n                </div>\r\n              </Tab.Container>\r\n            </div>\r\n          </div>\r\n          <div className=\"summary-container\">\r\n            {nft && <NFTPreview {...nft} />}\r\n            {/* IMPORTED NFT PREVIEW SO THIS CODE IS NOT NEEDED ANYMORE */}\r\n            {/* <div className=\"d-flex justify-content-center align-items-center\">\r\n              <img src=\"img/auction_1.jpg\" className=\"img-fluid\" style={{ height: \"250px\", width: \"300px\" }} />\r\n            </div>\r\n            <div className=\"pt-3 pb-3\">\r\n              <div className=\"d-flex justify-content-between text-white pb-2\">\r\n                <div>WannaPanda - PnPIbqI9ZF</div>\r\n                <div>Price</div>\r\n              </div>\r\n              <div className=\"d-flex justify-content-between text-white pb-2\">\r\n                <div>1</div>\r\n                <div><i className=\"fab fa-ethereum\" />0</div>\r\n              </div>\r\n            </div> */}\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  nft: state.nft,\r\n  error: state.error,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n  beforeNFT,\r\n  getNFT,\r\n  upsertNFT,\r\n})(SellNFT);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-collection/create-collection.js",["704","705"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/not-found/not-found.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/home/home.reducer.js",["706","707"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/how-it-works/how-it-works.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/privacy-&-terms/privacy-&-terms.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/auctions.reducer.js",["708"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/nfts.reducer.js",["709"],"import { BEFORE_NFT, GET_NFTS, GET_NFT, UPSERT_NFT,NFTALL } from '../../redux/types';\n\nconst initialState = {\n    nftsData: {},\n    nftAll:{},\n    nftsAuth: false,\n    upsertAuth: false,\n    createNFTResult:[],\n    createNFTerror:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case UPSERT_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                upsertAuth: true\n            }\n        case GET_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n            case NFTALL:\n        \n                return {\n                    ...state,\n                    nftAll: action.payload,\n                }\n            \n        case GET_NFTS:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n        case BEFORE_NFT:\n            return {\n                ...state,\n                nftsData: {},\n                nftsAuth: false,\n                upsertAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.reducer.js",["710"],"import { BEFORE_COLLECTION, GET_COLLECTION, SET_AUTH_STATE, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\n\nconst initialState = {\n    collection: null,\n    collections: null,\n    allCollections:null,\n    pagination: null,\n    deleteAuth: false,\n    upsertAuth: false,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n            case ALL_COLLECTIONS:\n                return {\n                    ...state,\n                    collection: action.payload.allCollections,\n                    getAuth: true\n                }\n        case SET_AUTH_STATE:\n            return {\n                ...state,\n                getAuth: false\n            }\n\n        case UPSERT_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                upsertAuth: true\n            }\n        case DELETE_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                deleteAuth: true\n            }\n        case GET_COLLECTIONS:\n            return {\n                ...state,\n                collections: action.payload.collections,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_COLLECTION:\n            return {\n                ...state,\n                collection: null,\n                collections: null,\n                pagination: null,\n                deleteAuth: false,\n                upsertAuth: false,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.reducer.js",["711"],"import { BEFORE_CONTACT, CREATE_CONTACT } from '../../redux/types';\n\nconst initialState = {\n    contactAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case CREATE_CONTACT:\n            return {\n                ...state,\n                contactAuth: true\n            }\n        case BEFORE_CONTACT:\n            return {\n                ...state,\n                contactAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/index.js",["712","713","714"],"import { useState,useEffect,useRef } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport {\n  currentStepAction,\n  currentStepDecrement,\n  clearCurrentStep,\n  deployContract,\n  mintToken,\n  connectWallet,\n} from \"../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport \"./index.css\";\nimport Step1 from \"./StepsComponents/Step1/Step1\";\nimport Step2 from \"./StepsComponents/Step2/Step2\";\nimport Step3 from \"./StepsComponents/Step3/Step3\";\nimport Step4 from \"./StepsComponents/Step4/Step4\";\nimport { ProgressBar } from \"react-bootstrap\";\nimport { HiOutlineChevronDoubleLeft } from \"react-icons/hi\";\nimport { connectMetamaskCopy, getNetworkNameByChainId } from \"../../utils/web3\";\nimport GaTracker from \"../../gaTracker/gaTracket\";\n\n\nconst FourStepForm = (props) => {\n  // console.log(props, \"currentStep==>\");\n  GaTracker();\n\n  //step 1 form\n  const [imgFile, setImgFile] = useState({});\n  const [img, setImge] = useState(\"\");\n  const [videoUrl, setVideoUrl] = useState(\"\");\n  //step 2 form\n  const [name, setName] = useState(\"\");\n  const [symbol, setSymbol] = useState(\"\");\n  const [externalLink, setExternalLink] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [supply, setSupply] = useState(1);\n\n  //step 3 form\n  const [properties, setProperties] = useState([]);\n  const [levels, setLevels] = useState([]);\n\n  //step 4 form\n  const [email, setEmail] = useState(\"\");\n  // const [deployNetwork, setDeployNetwork] = useState(\"\");\n  const [isValidate, setIsvalidate] = useState(false);\n  const [walletAddress, setWalletAddress] = useState(\"\");\n  const [connectedNetwork, setNetworkConnected] = useState(\"\");\n\n  /////////\n  const history = useHistory();\n\n  ////\n   \n  const [visible, setVisible] = useState(false)\n  const { currentStep } = props;\n  const scrollRef=useRef()\n  useEffect(()=>{\n    scrollRef.current.scrollTo(0, 0);\n   },[currentStep])\n\n  const handleGoBack = () => {\n    if(props.mintingResponse){\n      props.clearCurrentStep();\n      history.push(\"/\");\n      return \"\"\n    }\n    if (currentStep === 1) {\n      history.push(\"/\");\n    } else {\n      props.currentStepDecrement();\n    }\n  };\n  useEffect(()=>{\n\n  },[videoUrl])\n\n  const handleBackHome = () => {\n    history.push(\"/\");\n    props.clearCurrentStep();\n  };\n  const handleStep1Info = (file, video, imgUrl) => {\n    // console.log(file, \"file==>\");\n    setImgFile(file);\n    if (video) {\n      setVideoUrl(video);\n      setImge(\"\");\n    }\n    if (imgUrl) {\n      setImge(imgUrl);\n      setVideoUrl(\"\");\n    }\n  };\n  const handleStep2Info = (\n    nameValue,\n    symbolvalue,\n    externalLinkValue,\n    descriptionValue,\n    supplyValue\n  ) => {\n    // console.log(nameValue, \"NAME\");\n\n    setName(nameValue);\n\n    setSymbol(symbolvalue);\n\n    setExternalLink(externalLinkValue);\n\n    setDescription(descriptionValue);\n\n    setSupply(supplyValue);\n  };\n\n  const handleStep3PropertiesInfo = (propertiesValues) => {\n    // console.log(\"hanlde step 3 info\")\n    setProperties(propertiesValues);\n  };\n  const handleStep3LevelsInfo = (levelsInputs) => {\n    setLevels(levelsInputs);\n  };\n\n  const handleStep4Info = (emailValue, network) => {\n    setEmail(emailValue);\n    // setDeployNetwork(network);\n  };\n\n  const handleMinting = async (contractInfo, email) => {\n\n    props.mintToken(contractInfo, walletAddress, +supply, email);\n\n\n  };\n\n  // const connectWalletAddress=()=>{\n\n  // }\n  const handleDeployContract = async () => {\n    connectMetamaskCopy(walletAddress)\n      .then((address) => {\n      \n        if (address) {\n     \n          if (walletAddress) {\n          }\n          setWalletAddress(address);\n        }\n      })\n      .catch((err) => console.log(err, \"err1\"));\n\n    handleNetwork();\n  };\n\n  const handleNetwork = () => {\n    getNetworkNameByChainId()\n      .then((network) => {\n        // console.log(network,\"connected network==>\")\n        setNetworkConnected(network);\n      })\n      .catch((err) => {});\n  };\n\n  const handleDeployment = () => {\n    let obj = {\n      name,\n      description,\n      symbol,\n      externalLink,\n      supply,\n      image: imgFile,\n      email,\n      walletAddress,\n    };\n    props.deployContract(jsonToFormData(obj), walletAddress, +supply);\n  };\n\n  function buildFormData(formData, data, parentKey) {\n    if (\n      data &&\n      typeof data === \"object\" &&\n      !(data instanceof Date) &&\n      !(data instanceof File)\n    ) {\n      Object.keys(data).forEach((key) => {\n        buildFormData(\n          formData,\n          data[key],\n          parentKey ? `${parentKey}[${key}]` : key\n        );\n      });\n    } else {\n      const value = data == null ? \"\" : data;\n\n      formData.append(parentKey, value);\n    }\n  }\n  function jsonToFormData(data) {\n    const formData = new FormData();\n\n    buildFormData(formData, data);\n\n    formData.append(\"attributes\", JSON.stringify(properties));\n    formData.append(\"levels\", JSON.stringify(levels));\n\n    return formData;\n  }\n\n\n\n  const handleCaptchaValidation = (value) => {\n    setIsvalidate(value);\n  };\n  // const scrollToTop = () =>{\n  //   window.scrollTo({\n  //     top: 0, \n  //     behavior: 'smooth'\n  //     /* you can also use 'auto' behaviour\n  //        in place of 'smooth' */\n  //   });\n\n  // };\n  // const toggleVisible = () => {\n  //   const scrolled = document.documentElement.scrollTop;\n  //   if (scrolled > 300){\n  //     setVisible(true)\n  //   } \n  //   else if (scrolled <= 300){\n  //     setVisible(false)\n  //   }\n  // };\n\n  // window.addEventListener('scroll', toggleVisible);\n  return (\n    <div className=\"home-container steps-container\" ref={scrollRef} >\n      <div className=\"steps \">\n        <div className=\"steps-menu py-5\">\n          {currentStep > 0 && (\n            <div\n              className=\"text-white d-flex align-items-center\"\n              style={{ cursor: \"pointer\" }}\n              onClick={() => handleGoBack()}\n            >\n              <HiOutlineChevronDoubleLeft\n                style={{ marginRight: \"0.4rem\" }}\n                color=\"#44D1F9\"\n              />\n              <p className=\"mb-0 mt-0\">{props.mintingResponse?\"Home\":\" Go Back\"}</p>\n            </div>\n          )}\n          {currentStep === 4 && !props.mintingResponse && (\n            <div\n              className=\"text-white\"\n              style={{ cursor: \"pointer\" }}\n              onClick={() => handleBackHome()}\n            >\n              Back to Home\n            </div>\n          )}\n        </div>\n        {currentStep && currentStep === 1 ? (\n          <Step1\n            handleStep1Info={handleStep1Info}\n            imageURl={img}\n            videoURL={videoUrl}\n         \n          />\n        ) : currentStep === 2 ? (\n          <Step2\n            handleStep2Info={handleStep2Info}\n            name={name}\n            symbol={symbol}\n            externalLink={externalLink}\n            description={description}\n            supply={supply}\n       \n          />\n        ) : currentStep === 3 ? (\n          <Step3\n            handleStep3PropertiesInfo={handleStep3PropertiesInfo}\n            handleStep3LevelsInfo={handleStep3LevelsInfo}\n            properties={properties}\n            levels={levels}\n      \n          />\n        ) : currentStep === 4 ? (\n          <Step4\n            handleStep4Info={handleStep4Info}\n            handleDeployContract={handleDeployContract}\n            handleMinting={handleMinting}\n            supply={supply}\n            email={email}\n            handleCaptchaValidation={handleCaptchaValidation}\n            isValidate={isValidate}\n            walletAddress={walletAddress}\n            handleDeployment={handleDeployment}\n            info={{\n              name,\n              symbol,\n              externalLink,\n              description,\n              properties,\n              levels,\n              img,\n              videoUrl,\n              email,\n              supply,\n            }}\n            connectedNetwork={connectedNetwork}\n         \n          />\n        ) : (\n          \"\"\n        )}\n        {/* <div\n          className=\"progress-bar-custom\"\n          style={{ width: \"64%\", margin: \"14rem auto 0 auto\" }}\n        >\n          <ProgressBar\n            className={`${\n              currentStep === 4 ? \"progress-bar-green\" : \"progress-bar-yellow\"\n            }`}\n            now={currentStep * 25}\n          />\n          <p className=\"text-white text-center mt-2\">{currentStep}/4</p>\n        </div> */}\n      </div>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n(\n    // console.log(state, \"state\"),\n    {\n    currentStep: state.dashboard.currentStep,\n    contractInfo: state.dashboard.contractInfo,\n    contractReponse:state.dashboard.contractReponse,\n    mintingResponse:state.dashboard.mintingResponse\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n  currentStepDecrement,\n  clearCurrentStep,\n  deployContract,\n  mintToken,\n  connectWallet,\n})(FourStepForm);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.reducer.js",["715"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/reducer/reducer.js",["716"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.reducer.js",["717"],"import { BEFORE_USER, SET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, GET_USER } from '../../redux/types';\n\nconst initialState = {\n    userData: null,\n    userAuth: false,\n    creatorsAuth: false,\n    topSellersAuth: false,\n    individualUserAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_USER:\n            return {\n                ...state,\n                userData: action.payload,\n                userAuth: true\n            }\n        case GET_USER:\n            return {\n                ...state\n            }\n        case SET_CREATORS:\n            return {\n                ...state,\n                creators: action.payload,\n                creatorsAuth: true\n            }\n        case TOP_SELLERS:\n            return {\n                ...state,\n                sellers: action.payload,\n                topSellersAuth: true\n            }\n        case SET_INDIVIDUAL_USER:\n            return {\n                ...state,\n                individualUser: action.payload,\n                individualUserAuth: true\n            }\n        case BEFORE_USER:\n            return {\n                ...state,\n                userData: null,\n                userAuth: false,\n                creatorsAuth: false,\n                topSellersAuth: false,\n                individualUserAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/categories/categories.reducer.js",["718"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.reducer.js",["719"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.reducer.js",["720"],"import { BEFORE_FAQ, GET_FAQS } from '../../redux/types';\n\nconst initialState = {\n    faqs: null,\n    faqsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FAQS:\n            return {\n                ...state,\n                faqs: action.payload,\n                faqsAuth: true\n            }\n        case BEFORE_FAQ:\n            return {\n                ...state,\n                faqs: null,\n                faqsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/bids/bids.reducer.js",["721"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            return {\n                ...state,\n                bids: action.payload.bids,\n                pagination: action.payload.pagination,\n                highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.reducer.js",["722"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.reducer.js",["723"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Slider/slider.js",["724","725","726"],"import React, { useState, useEffect } from \"react\";\nimport \"./slider.css\";\nimport Slider from \"react-slick\";\nimport \"slick-carousel/slick/slick.css\";\nimport \"slick-carousel/slick/slick-theme.css\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\n// import image from \"../../assets/images/test.jpg\";\nimport nftBack from \"../../assets/images/nftBack.png\";\n// import nftImage from \"../../assets/images/nftImage.png\";\n\nconst SimpleSlider = (props) => {\n  const [showSlider, setShowSlider] = useState(false);\n  useEffect(() => {\n    if (showSlider == false) {\n      setTimeout(() => {\n        setShowSlider(true);\n      }, 300);\n    }\n  });\n  const settings = {\n    dots: true,\n    infinite: true,\n    speed: 500,\n    slidesToShow: 1,\n    slidesToScroll: 1,\n  };\n\n  return (\n    <div\n      className=\"position-relative slider-container\"\n      style={{ backgroundColor: \"\" }}\n    >\n      {/* <h2> Single Item</h2> */}\n\n      <img\n        src={nftBack}\n        style={{ width: \"26rem\", minWidth: \"26rem\" }}\n        className=\"slider-bg\"\n      />\n\n      <div\n        className=\"position-absolute nfts-title-container\"\n        style={{ top: \"-3rem\", right: \"9rem\" }}\n      >\n        <p\n          className=\"text-white mb-0 worlds-famous\"\n          style={{\n            fontSize: \"34px\",\n            fontWeight: \"bold\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          World's Famous\n        </p>\n        <p\n          className=\"mb-0 text-white nfts-title\"\n          style={{\n            // fontSize: \"165px\",\n            fontSize: \"8.2vw\",\n            fontWeight: \"bold\",\n            marginTop: \"-3rem\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          NFT's\n        </p>\n      </div>\n      <div\n        className=\"position-relative slider-wrapper\"\n        style={{\n          bottom: \"22rem\",\n          right: \"-2rem\",\n          cursor: \"pointer\",\n          display: showSlider ? \"block\" : \"none\",\n        }}\n      >\n        <Slider {...settings}>\n          {props.assetList.map((nft, index) => {\n            return (\n              <div key={index} onClick={() => window.open(nft.link)}>\n                <img\n                  src={nft.img}\n                  className=\"slider-img\"\n                  alt={nft}\n                  style={{ objectFit: \"cover\" }}\n                />\n              </div>\n            );\n          })}\n        </Slider>\n      </div>\n    </div>\n  );\n};\nexport default SimpleSlider;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Navbar/navbar.js",["727","728","729","730","731","732","733","734","735"],"// import react from 'react'\nimport \"./navbar.css\";\nimport { useHistory } from \"react-router-dom\";\nimport { BsTwitter } from \"react-icons/bs\";\nimport { SiDiscord } from \"react-icons/si\";\nimport { FaTelegramPlane } from \"react-icons/fa\";\nimport { GrReddit } from \"react-icons/gr\";\nimport { AiFillHome } from \"react-icons/ai\";\nimport mintsLogoSmily from \"../../assets/images/mintsClubSmilyLogo1.png\";\nimport MintsClub from \"../../assets/images/MintsClub-White.png\";\nimport { ENV } from \"../../config/config\";\nimport fullNavIcon from \"../../assets/images/mintsClubLogo1.png\";\n\nconst Navbar = () => {\n  const history = useHistory();\n  const twitter = ENV.twitterLink;\n  const discordLink = ENV.discordLink;\n  const telegramLink = ENV.telegramLink;\n  const redditLink = ENV.redditLink;\n\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n\n  return (\n    <div className=\"nav align-items-center\">\n      <input type=\"checkbox\" id=\"nav-check\" />\n      {/* <div className=\"nav-icon\" ><img src={fullNavIcon} width=\"20%\" /></div> */}\n      <div className=\"nav-header\" style={{ width: \"25%\" }}>\n        <div className=\"nav-title\" onClick={() => history.push(\"/\")}>\n          <img src={MintsClub} width=\"100%\" />\n        </div>\n      </div>\n      <div className=\"nav-btn\">\n        <label htmlFor=\"nav-check\">\n          <span></span>\n          <span></span>\n          <span></span>\n        </label>\n      </div>\n\n      <div className=\"nav-links\">\n        <a\n          className=\"navbar-item\"\n          href=\"#\"\n          target=\"_blank\"\n          style={{ color: \"#ffd33e\" }}\n        >\n          <AiFillHome className=\"home-icon \" />\n          Home\n        </a>\n\n        {twitter && twitter.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={twitter} target=\"_blank\">\n              <BsTwitter className=\"home-icon \" />\n              Twitter\n            </a>\n          </>\n        )}\n\n        {discordLink && discordLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={discordLink} target=\"_blank\">\n              <SiDiscord className=\"home-icon \" />\n              Discord\n            </a>\n          </>\n        )}\n\n        {telegramLink && telegramLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={telegramLink} target=\"_blank\">\n              <FaTelegramPlane className=\"home-icon \" />\n              Telegram\n            </a>\n          </>\n        )}\n\n        {redditLink && redditLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={redditLink} target=\"_blank\">\n              <GrReddit className=\"home-icon \" />\n              Reddit\n            </a>\n          </>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Navbar;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/exportData.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/navbar-componnent/NavbarComponent.js",["736","737"],"import React from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport MintsClub from \"../../../assets/images/MintsClub-White.png\";\n\nimport { BsTwitter } from \"react-icons/bs\";\nimport { SiDiscord } from \"react-icons/si\";\nimport { FaTelegramPlane } from \"react-icons/fa\";\nimport { GrReddit } from \"react-icons/gr\";\nimport { AiFillHome } from \"react-icons/ai\";\n\nimport { ENV } from \"../../../config/config\";\nimport { Nav, Navbar, Container } from \"react-bootstrap\";\nimport \"./NavbarComponent.css\";\n\nconst NavbarComponent = () => {\n  const history = useHistory();\n  const twitter = ENV.twitterLink;\n  const discordLink = ENV.discordLink;\n  const telegramLink = ENV.telegramLink;\n  const redditLink = ENV.redditLink;\n  return (\n    <div>\n      <Navbar\n        bg=\"light\"\n        expand=\"lg\"\n        variant=\"dark\"\n        className=\"navbar-custom align-items-center\"\n      >\n        <Navbar.Brand href=\"/\" className=\"navbar-brand-logo\">\n          <img src={MintsClub} alt=\"logo\" />\n        </Navbar.Brand>\n        <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n        <Navbar.Collapse id=\"basic-navbar-nav\">\n          <Nav className=\"ms-auto\" activeKey=\"/\">\n            <Nav.Link href=\"/\">\n              <AiFillHome className=\"home-icon \" /> Home\n            </Nav.Link>\n            <Nav.Link href={twitter} target=\"_blank\">\n              <BsTwitter className=\"home-icon \" /> Twitter\n            </Nav.Link>\n            <Nav.Link href={discordLink} target=\"_blank\">\n              <SiDiscord className=\"home-icon \" />\n              Discord\n            </Nav.Link>\n            <Nav.Link href={telegramLink} target=\"_blank\">\n              <FaTelegramPlane className=\"home-icon \" />\n              Telegram\n            </Nav.Link>\n            <Nav.Link href={redditLink} target=\"_blank\">\n              <GrReddit className=\"home-icon \" />\n              Reddit\n            </Nav.Link>\n          </Nav>\n        </Navbar.Collapse>\n      </Navbar>\n    </div>\n  );\n};\n\nexport default NavbarComponent;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/slider-component/sliderExmp.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/home-auctions.js",["738","739","740","741","742","743","744","745","746","747","748","749","750","751"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\nimport moment from \"moment\";\r\nimport Countdown from \"react-countdown\";\r\nimport { Swiper, SwiperSlide } from \"swiper/react\";\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\nimport { useTimer } from \"react-timer-hook\";\r\nimport { getCreators, beforeUser } from \"./../user/user.action\";\r\nimport image from \"../../assets/images/placeholder.png\";\r\nimport DemoImg from \"../../assets/images/cl-cr-mainimg.png\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../../Screens/rough/auctions-cards/AuctionsCards\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n// Swiper.use([Navigation, Pagination]);\r\nconst { globalPlaceholderImage, countDownRenderer } = ENV;\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [creators, setCreator] = useState([]);\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({ all: true });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n  useEffect(() => {\r\n    // console.log('auth', props.user.topSellersAuth)\r\n    if (props.user.topSellersAuth) {\r\n      setCreator(props.user.sellers);\r\n      setLoader(false);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n  // set live auctions\r\n  useEffect(() => {\r\n    // if (props.auction.getAuth) {\r\n    const { auctions, pagination } = props.auction;\r\n    if (auctions) {\r\n      setAuctions(auctions);\r\n      props.beforeAuction();\r\n    }\r\n    // }\r\n  }, [props.auction.getAuth]);\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n  const filterCreator = (nft, field) => {\r\n    // console.log('creators', creators)\r\n    // console.log('nft owner', nft)\r\n    const result = creators.find((item) => item._id === nft.nftOwnerId);\r\n    // console.log('reuslt',result\r\n    if (result) {\r\n      if (field === \"userName\") {\r\n        if (result?.username) {\r\n          return result?.username;\r\n        } else {\r\n          return \"no username found\";\r\n        }\r\n      } else if (field == \"profileImage\") {\r\n        if (result.profileImage) {\r\n          return result?.profileImage;\r\n        } else {\r\n          return image;\r\n        }\r\n      }\r\n    }\r\n  };\r\n\r\n  const auctionDemoData = [\r\n    {\r\n      _id: 1,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 2,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 3,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 4,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 5,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 6,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 7,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 8,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n  ];\r\n\r\n  console.log(auctions, \"auctions==>\");\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products. We want to be a part of your\r\n                    smile, success and future growth.\r\n                  </p>\r\n                </div>\r\n                {/* {auctions && auctions.length > 0 && (\r\n                  <div className=\"intro-btn\">\r\n                    <Link className=\"btn content-btn\" to=\"/auctions\">\r\n                      {initData.btnText}\r\n                    </Link>\r\n                  </div>\r\n                )} */}\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\r\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                <button className=\"me-1 me-sm-2 active\">Arts</button>\r\n                <button className=\"me-1 me-sm-2\">Music</button>\r\n                <button className=\"me-1 me-sm-2\">Game</button>\r\n                <button className=\"me-1 me-sm-5\">Sport</button>\r\n                <div className=\"intro-btn\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/authors\"\r\n                  >\r\n                    View All\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          {/* //replace arraySample to auctions */}\r\n          {auctionDemoData && auctionDemoData.length > 0 ? (\r\n            <div className=\"auctions-slides\">\r\n              <div className=\"\">\r\n                {/* <div className=\"swiper-wrapper row\"> */}\r\n                {/* <Swiper\r\n                  id=\"swiper\"\r\n                  modules={[Navigation, Pagination, Autoplay, Virtual]}\r\n                  virtual\r\n                  spaceBetween={50}\r\n                  slidesPerView={3}\r\n                  onSlideChange={() => console.log(\"\")}\r\n                  onSwiper={(swiper) => console.log(swiper)}\r\n                  pagination={{ clickable: true }}\r\n                  scrollbar={{ draggable: true }}\r\n                >\r\n                  {auctionDemoData.map((item, idx) => {\r\n                    return (\r\n                      <>\r\n                        <SwiperSlide>\r\n                          <div\r\n                            key={`auc_${idx}`}\r\n                            className=\"swiper-slide item\"\r\n                            id={`#auc-${idx}`}\r\n                          >\r\n                            <div className=\"card m-3 \">\r\n                              <div className=\"image-over\">\r\n                                <Link\r\n                                  to={`/item-details?item=${window.btoa(\r\n                                    item._id\r\n                                  )}`}\r\n                                >\r\n                                  <img\r\n                                    className=\"card-img-top\"\r\n                                    src={item.image}\r\n                                    alt=\"NFT image\"\r\n                                    width=\"600\"\r\n                                    height=\"600\"\r\n                                    style={{ borderRadius: \"none\" }}\r\n                                  />\r\n                                </Link>\r\n                              </div>\r\n                              <div className=\"card-caption col-12 p-0\">\r\n                                <div className=\"card-body\">\r\n                                  <div className=\"mb-3\">\r\n                                    <Countdown\r\n                                      date={\r\n                                        new Date(item.auctionEndDate) + 10000\r\n                                      }\r\n                                      renderer={countDownRenderer}\r\n                                    />\r\n                                  </div>\r\n                                  <Link\r\n                                    to={`/item-details?item=${window.btoa(\r\n                                      item._id\r\n                                    )}`}\r\n                                  >\r\n                                    <h5 className=\"mb-0\">{item.name}</h5>\r\n                                  </Link>\r\n                                  <Link\r\n                                    className=\"seller d-flex align-items-center my-3\"\r\n                                    to={`/author`}\r\n                                  >\r\n                                    <img\r\n                                      className=\"avatar-sm rounded-circle\"\r\n                                      // src={\"https://gateway.ipfs.io/ipfs/QmR8ye93PSLCQXppDUwtBChXNXavCj1HbFCs2DDac5KRnQ\"}\r\n                                      src={filterCreator(item, \"profileImage\")}\r\n                                      alt=\"User Avatar\"\r\n                                    />\r\n                                    <span className=\"ml-2\">\r\n                                      {filterCreator(item, \"userName\")}\r\n                                    </span>\r\n                                  </Link>\r\n                                  <div className=\"card-bottom d-flex justify-content-between\">\r\n                                    <span>\r\n                                      {item.currentPrice} {ENV.currency}\r\n                                    </span>\r\n                                    <span>\r\n                                      {item.sold} of {item.copies}\r\n                                    </span>\r\n                                  </div>\r\n                                </div>\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </SwiperSlide>\r\n\r\n                      </>\r\n                    );\r\n                  })}\r\n                </Swiper> */}\r\n                <CardSlider settings={ENV.auctionCollectionsSettings}>\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                  <AuctionsCards />\r\n                </CardSlider>\r\n              </div>\r\n            </div>\r\n          ) : (\r\n            <p className=\"text-center ml-3\">No Live Auctions Found</p>\r\n          )}\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n})(AuctionsOne);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/popular-collections.js",["752","753","754","755","756"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\nimport Collections from \"./collections\";\nimport CollectionsCard from \"../../Screens/rough/collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { connect } from \"react-redux\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst PopularCollections = (props) => {\n  // const [categories, setCategories] = useState(null);\n  // const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  // const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  // const collectionsRef = useRef(null);\n\n  // useEffect(() => {\n  //   window.scroll(0, 0);\n  //   props.getCategories();\n  // }, []);\n\n  // // when categories data is received\n  // useEffect(() => {\n  //   if (props.category.getAuth) {\n  //     const { categories } = props.category;\n  //     // const allCat = { active: true, name: 'all' }\n  //     // setCategories([allCat, ...categories])\n  //     setCategories(categories);\n  //     props.beforeCategory();\n  //     setCatLoader(false);\n  //     setColLoader(false);\n  //   }\n  // }, [props.category.getAuth]);\n\n  // const getCatCollections = (catId) => {\n  //   collectionsRef.current?.getCatCollections(catId);\n  // };\n  // const getColLoader = (loader) => {\n  //   setColLoader(loader);\n  // };\n\n  // console.log(categories, \"categories123\");\n\n  return (\n    <>\n      {/* {!collectionsLoader ? (\n        <FullPageLoader />\n      ) : ( */}\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-0\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products. We want to be a part of your\n                    smile, success and future growth.\n                  </p>\n                </div>\n                {/* {collectionsRef.current?.colCount > 0 && (\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn content-btn text-left\"\n                      to=\"/collections\"\n                    >\n                      {initData.btnText}\n                    </Link>\n                  </div>\n                )} */}\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\n                <button className=\"me-1 me-sm-2 active\">Arts</button>\n                <button className=\"me-1 me-sm-2\">Music</button>\n                <button className=\"me-1 me-sm-2\">Game</button>\n                <button className=\"me-1 me-sm-5\">Sport</button>\n                <div className=\"intro-btn\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\n                    to=\"/authors\"\n                  >\n                    View Alll\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <CardSlider settings={ENV.popularCollectionsSettings}>\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            <CollectionsCard />\n            {/* {categories.map((category) => { \n                return (\n                  <>\n                    <CollectionsCard category={category} />\n                  </>\n                );\n              })} */}\n          </CardSlider>\n          {/* <CollectionsCard /> */}\n          {/* <Collections\n            popular={true}\n            userId=\"61408000cef27850fdea272b\"\n            setLoader={getColLoader}\n            ref={collectionsRef}\n          /> */}\n        </div>\n      </section>\n      {/* )} */}\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, { beforeCategory, getCategories })(\n  PopularCollections\n);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore-home.js",["757","758","759","760","761","762"],"import React, { useState } from 'react';\nimport ExploreItems from './explore-items';\nimport { Link } from 'react-router-dom';\n\nconst initData = {\n    pre_heading: \"Exclusive Assets\",\n    heading: \"Explore\",\n    btn_1: \"View All\",\n}\n\nfunction ExploreHome() {\n    const [viewAll, setViewAll] = useState(false);\n\n    const getViewAll = (view) => {\n        setViewAll(view)\n    }\nconst nfts=[\n  1,2,3,4,5,6\n]\n    return (\n        <section className=\"explore-area load-more p-0\">\n            <div className=\"container\">\n                <div className=\"row\">\n                    {/* <div className=\"col-12\">\n                        <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                            <div className=\"intro-content\">\n                                <span>{initData.pre_heading}</span>\n                                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                            </div>\n                            {\n                                viewAll &&\n                                <div className=\"intro-btn\">\n                                    <Link className=\"btn content-btn\" to=\"/explore-all\">{initData.btn_1}</Link>\n                                </div>\n                            }\n                        </div>\n                    </div> */}\n                </div>\n                {/* <ExploreItems key=\"exo\" setView={true} setViewAll={getViewAll} loadMoreBtn nfts={nfts}/> */}\n            </div>\n        </section>\n    );\n}\n\nexport default ExploreHome;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.js",["763","764","765","766","767","768","769","770"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  useEffect(() => {\n    if (props.settings.settingsAuth) {\n      setData(props.settings.settings);\n    }\n  }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div class=\"input-group notify-form\">\n                  <div class=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      class=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2021 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/web3.js",["771","772","773","774","775","776","777"],"import Web3 from \"web3\";\nimport { toast } from 'react-toastify'\nimport contractAbi from './../utils/abis/token.json';\nimport {ENV} from './../config/config';\nimport liveAuctionsAbi from './abis/ARISwapToken.json'\nimport {liveAuction} from './abiSetup.js'\nimport {placeBid} from '../components/bids/bids.action'\nimport {setFixedPriceNftTOken, acceptBit, placeBidApi} from './functions'\nimport {changeOwnerShip} from './functions'\nimport { Redirect } from 'react-router-dom';\n\nlet Contract = require('web3-eth-contract');\n\nconst nftContractAddress = ENV.ariswapContractAddress;\nconsole.log(nftContractAddress,\"nftContractAddress\")\nContract.setProvider();\nconsole.log(window.web3?.currentProvider,\"current provider\")\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN)\nconsole.log(liveAuction,\"liveAuction\")\n\n//get web3\nvar web3Provider=null;\nexport const getWeb3 = async ()=> {\n    // if(window.ethereum) {\n    //     const web3 = new Web3(Web3.givenProvider);\n    //     return web3;\n    // }\n    // else {\n    //     return false;   \n    // }\n    ////////////////////////////////\n    if (window.ethereum) {\n        web3Provider = window.ethereum;\n        try {\n          // Request account access\n          await window.ethereum.enable();\n        } catch (error) {\n          // User denied account access...\n          console.error(\"User denied account access\")\n        }\n      }\n      // Legacy dapp browsers...\n      else if (window.web3) {\n        web3Provider = window.web3.currentProvider;\n      }\n      // If no injected web3 instance is detected, fall back to Ganache\n      else {\n        web3Provider = new Web3.providers.HttpProvider('http://localhost:7545');\n      }\n\n     var web3 = new Web3(web3Provider);\n      return web3\n    ///////////////////////////////\n}\n\n// TEMP. ADDING THIS METHOD - COPY OF CONNECTMETAMASK\n// export const connectMetamaskCopy = async ()=> {\n//     if(window.ethereum) {\n//         const web3 = new Web3(Web3.givenProvider);\n//         const network = await web3.eth.net.getNetworkType();\n//         await window.ethereum.enable();\n//         let accounts = await web3.eth.getAccounts();\n//         let chainId = await web3.eth.getChainId();\n//         if(chainId !== requiredChainId) {\n//             // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n//         }\n//         return accounts[0];\n//     }\n//     else {\n//         // alert(\"Please install metamask to connect to the Marketplace\");\n//         toast.error(\"Please install metamask to connect to the Marketplace\");\n//     }\n// }\nexport const connectMetamaskCopy = async (address) => {\n    if (window.ethereum) {\n      const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      let chainId = await web3.eth.getChainId();\n      // console.log(chainId, \"chainId\");\n      let currentNetwork = getNetworkName(chainId);\n      if (!currentNetwork) {\n        toast.error(\"Please Connect your metamask with Ethereum Network\");\n        return false;\n      }\n      if (chainId !== requiredChainId) {\n        // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n      }\n      // console.log(accounts[0],\"account==>\")\n      if (accounts[0]) {\n        if(accounts[0]===address)\n        {\n          toast.success(\"wallet is already connected\");\n        }\n        else {\n  \n          toast.success(\"wallet connected\");\n        }\n        //    console.log('hello');\n        return accounts[0];\n      } else {\n        let address = await signRequest();\n  \n        toast.success(\"wallet connected\");\n        return address[0];\n      }\n    } else {\n      // alert(\"Please install metamask to connect to the Marketplace\");\n      toast.error(\"This app requires metamask,Please Install Metamask \");\n    }\n  };\n  export const getWalletAddress=async ()=>{\n    const web3 = new Web3(Web3.givenProvider);\n    // const network = await web3.eth.net.getNetworkType();\n    if(window.ethereum){\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      return accounts[0]\n    }\n  }\nexport const connectMetamask = async ()=> {\n    if(window.ethereum) {\n        const web3 = new Web3(Web3.givenProvider);\n        window.web3=new Web3(window.ethereum)\n        const network = await web3.eth.net.getNetworkType();\n        await window.ethereum.enable();\n        let accounts = await web3.eth.getAccounts();\n        let chainId = await web3.eth.getChainId();\n        if(chainId !== requiredChainId) {\n            // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n        }\n        return accounts[0];\n    }\n    else {\n        // alert(\"Please install metamask to connect to the Marketplace\");\n        toast.error(\"Please install metamask to connect to the Marketplace\");\n    }\n}\n\nexport const getNetworkNameByChainId=async ()=>{\n    if (window.ethereum) {\n      const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      let chainId = await web3.eth.getChainId();\n      // console.log(chainId,\"chainId\")\n      // console.log(chainId, \"chainId\");\n      let currentNetwork = getNetworkName(chainId);\n      // console.log(currentNetwork,\"currentNetwork==>\")\n      return currentNetwork\n    }\n  }\n  \n  const getNetworkName = (chainId) => {\n    let networks = {\n      1: \"Ethereum Mainnet\",\n      4: \"Ethereum Rinkby\",\n      3: \"Ethereum Ropsten\",\n      42: \"Ethereum Kovan\",\n      5: \"Ethereum Goerli\",\n    };\n    return networks[chainId]\n  };\n  \n\nexport const signRequest = async ()=> {\n    if(window.ethereum) {\n        // const web3 = await getWeb3();\n        // if (!web3) {\n        //     toast.error(\"No web3 instance found\");\n        //     return false;\n        // }\n   \n        const web3 = new Web3(Web3.givenProvider);\n        let accounts = await web3.eth.getAccounts();\n        let address = accounts[0];\n        let signature = await handleSignMessage(address);\n        // placeBid()\n        // console.log(signature,\"signature===>\")\n        return signature;\n    }\n    else {\n        alert(\"Please install metamask to connect to the Marketplace\");\n    }\n}\n\n// export const testing=()=>{\n//     const test=web3.eth.\n// }\n\nexport const mint = async (metaData) => {\n    // alert(\"dfdfdf\")\n    const web3 = await getWeb3();\n    if (!web3) {\n        toast.error(\"No web3 instance found\");\n        return false;\n    }\n    // let tokenContract1 = new Contract(liveAuctionsAbi., nftContractAddress);\n    try {\n   \n        let connectedAddress = await connectMetamask();\n        // console.log(connectedAddress,\"connectedAddress\")\n        let tokenContract = new Contract(liveAuctionsAbi, nftContractAddress);\n        // const txCount = await web3.eth.getTransactionCount(connectedAddress);\n        const myNewData = await tokenContract.methods\n            .createNewNFT(connectedAddress, metaData)\n            .encodeABI();\n        \n            // console.log(myNewData,\"checking create nft  result==>\")\n        // const gasLimit = await web3.eth.estimateGas({\n        //     from: connectedAddress,\n        //     nonce: txCount,\n        //     to: nftContractAddress,\n        //     data: myNewData,\n        // });\n        // const gas2 = await web3.eth.getGasPrice();\n        // const transactionParameters = {\n        //     nonce: web3.utils.toHex(txCount), // ignored by MetaMask\n        //     gasPrice: web3.utils.toHex(gas2), // customizable by user during MetaMask confirmation.\n        //     gasLimit: web3.utils.toHex(gasLimit), // customizable by user during MetaMask confirmation.\n        //     to: nftContractAddress, // Required except during contract publications.\n        //     from: connectedAddress, // must match user's active address.\n        //     data: myNewData, // Optional, but used for defining smart contract creation and interaction.\n        //     // chainId: '0x3', // Used to prevent transaction reuse across blockchains. Auto-filled by MetaMask.\n        // };\n        // // As with any RPC call, it may throw an error\n        // const txHash = await window.ethereum.request({\n        //     method: 'eth_sendTransaction',\n        //     params: [transactionParameters],\n        // });\n        toast.success(`Success! NFT Created successfully!`)\n        return true;\n    } catch (e) {\n        // alert(\"inCatch\")\n        let eMessage = e.message.split('{')[0] || '';\n        // console.log(eMessage,\"message==>\")\n        toast.error(eMessage);\n        return false;\n    }\n    \n}\n\nconst handleSignMessage = (address) => {\n    return new Promise((resolve, reject) =>{\n        try {\n            const web3 = new Web3(Web3.givenProvider);\n            web3.eth.personal.sign(\n                web3.utils.fromUtf8(`${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`),\n                address,\n                (err, signature) => {\n                    if (err) return reject(err);\n                    return resolve(signature);\n                }\n            )\n        }\n        catch (e) {\n            console.log(e);\n        }\n        \n    }\n    );\n};\n\nexport const ClaimFundsAfterBidding = (token) => {\n    // getting accounts\n    return new Promise ( async (resolve, reject) => {\n    const web3 = new Web3(Web3.givenProvider);\n     let accounts = await web3.eth.getAccounts();\n     let address = accounts[0];\n     liveAuction.methods.ClaimFundsAfterBidding(token).send(\n         {\n            from:address\n        }\n            ).then(x=> {\n        \n            return resolve(x);\n        });\n     }).catch((err)=>{\n        //  return reject(err);\n        console.log(\"err in catch block error===> \",err)\n    });\n}\n\nexport const createNft= async (metaData,nftId)=>{\n\n\n    //getting accounts\n    const web3 = new Web3(Web3.givenProvider);\n    let accounts = await web3.eth.getAccounts();\n    // console.log(accounts,\"accounts\")\n    let address = accounts[0];\n    // console.log(address,\"addresss==>\")\n    console.log(metaData,\"metaData==>\")\n    console.log(liveAuction,\"liveAuction.==>\")\n    console.log(liveAuction.methods,\"liveAuction.methods==>\")\n    //create NFT\n\n    try{\n      let createNftResult=  await liveAuction.methods.createNewNFT(address,metaData).send({\n            value: 1000000000000000,\n            // value:0,\n            from:address,\n         }\n\n         \n        )\n        return createNftResult\n    }catch(err){\n       throw err\n    }\n    // liveAuction.methods.createNewNFT(address,metaData).send({\n    //         value: 1000000000000000,\n    //         // value:0,\n    //         from:address,\n    //      }\n\n         \n    //     ).then((res)=>{\n    //         // console.log(res.events.Transfer.returnValues.tokenId,\"res of createNFT===>\")\n    //         let data={\n    //             nftToken:res.events.Transfer.returnValues.tokenId,\n    //             nftId\n    //         }\n\n    //         setNftToken(data)\n\n    //         toast.success(\"NFT created successfully\")\n    //         // window.location.href= '/explore-all'\n    //         return res\n    // })\n    // .catch((err)=>{\n   \n    //     console.log('err', err)\n    //     if(err.code=== 4001){\n    //         let url = process.env.REACT_APP_BASE_URL + `nfts/update`;\n    //          var payload = {\n    //              status: 0,\n    //              _id:nftId\n    //          }\n    //         fetch(url, {\n    //          method: 'POST',\n    //          headers: {\n    //             'content-type': 'application/json',\n    //             'Authorization': ENV.Authorization,\n    //             'x-auth-token': ENV.x_auth_token,\n    //             'Access-Control-Allow-Origin': '*',\n    //             'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n    //         },\n    //         body: JSON.stringify(payload)\n    //     }).then(res => res.json()).then(data => {\n          \n    //         console.log(data,\"data==>\")\n    //         if (data.success === false) {\n    //             toast.error(err.message)\n    //         } \n    //     }).catch(error => {\n    //         // alert(\"in setting nft then\")\n    //         console.log(error,\"error in catch blcok\")\n    //         if (error.response && error.response.data) {\n    //             toast.error(err.message)\n            \n    //         }\n    //         else {\n    //     toast.error(\"Transaction Failed Please check wallet history\")\n\n    //         }\n         \n    //     })\n    //     }\n        \n    // })\n    // return res\n}\n\n    // openNFTForBidding\n    export const openNFTForBidding=async(token,timeduration)=>{\n        // console.log(token,timeduration,\"checking token and time duration\")\n         //openNFTForBidding\n         let tokenId=+token;\n         const web3 = new Web3(Web3.givenProvider);\n\n         let accounts = await web3.eth.getAccounts();\n        //  console.log(accounts,\"accounts\")\n         let address = accounts[0];\n        //  console.log(address,\"addresss==>\")\n       liveAuction.methods.openNFTForBiddingForSpecific(tokenId,timeduration).send({from:address}).then((res)=>{\n            //  console.log(res ,\"res of openNFTForBidding===>\")\n           \n    })\n    .catch((err)=>{\n        toast.error(\"Transaction Failed Please check wallet history\")\n    })\n    }\n    \n    export const setNftToken=(body)=>{\n        // console.log(body,\"body===>\")\n        // let dummy={\n        //     nftToken:\"123\",\n        //     nftId:\"123\"\n\n        // }\n\n        let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n\n        fetch(url, {\n         method: 'POST',\n         headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        // alert(\"in setting nft then\")\n        // console.log(data,\"data==>\")\n        if (data.success) {\n            window.location.href= '/explore-all'\n        //    console.log(data,\"data in success\")\n        } else {\n         \n        }\n    }).catch(error => {\n        // alert(\"in setting nft then\")\n        console.log(error,\"error in catch blcok\")\n        if (error.response && error.response.data) {\n        \n        }\n     \n    })\n    }\n\n    export const NftOwner=async ()=>{\n        const web3 = new Web3(Web3.givenProvider);\n\n        let accounts = await web3.eth.getAccounts();\n        // console.log(accounts,\"accounts\")\n        let address = accounts[0];\n    //     console.log(address,\"addresss==>\")\n    // //OwnerNFT\n       liveAuction.methods.ownerOf(5).send({from:address}).then((res)=>{\n            //  console.log(res,\"res of createNFT===>\")\n    })\n    .catch((err)=>{\n        console.log(err,\"err in catch block error===>\")\n    })\n    }\n\n    export const placeBidNft=async(body,tokenId,price,toAddress,fromAddress)=>{\n        const web3 = new Web3(Web3.givenProvider);\n\n        let accounts = await web3.eth.getAccounts();\n        // console.log(accounts,\"accounts\")\n        let address = accounts[0];\n        // console.log(address,\"addresss==>\")\n        // console.log(price,\"price888888888888888888888\")\n        // console.log(toAddress,\"toAdress\")\n   \n            liveAuction.methods.placeBid(tokenId).send({value:price.amount,from:address}).then((res)=>{\n                console.log('bid before', res)\n                console.log('body', body)\n                placeBidApi(body,tokenId,price,toAddress,fromAddress)\n                // window.location.href= '/explore-all'\n            //  console.log(res,\"res of place bid result===>\")\n        })\n        // alert(price)\n      .catch((err)=>{\n            toast.error(\"Transaction Failed Please check wallet history\")\n          })\n    }\n\n    export const SellOnFixedPrice=async (tokenId,price)=>{\n        const web3 = new Web3(Web3.givenProvider);\n\n        let accounts = await web3.eth.getAccounts();\n        // console.log(accounts,\"accounts\")\n        let address = accounts[0];     \n            //   Put on sale\n            // console.log('live auction', liveAuction)\n            liveAuction.methods.PutOnSale(tokenId).send({from:address}).then((res)=>{\n                \n                // setFixedPriceNftTOken()\n\n    })\n     \n.catch((err)=>{\n    toast.error(\"Transaction Failed Please check wallet history\")\n})\n    }\n\n    export const BuyFixedPriceNFTs=async (price,tokenId,nftOwnerId)=>{\n        // console.log(tokenId,\"token id in buy fixed price==>\")\n        const web3 = new Web3(Web3.givenProvider);\n\n        let accounts = await web3.eth.getAccounts();\n        // console.log(accounts,\"accounts\")\n        let address = accounts[0];\n        // console.log(address,\"addresss==>\")\n        // console.log(price,\"price888888888888888888888\")\n        // alert(price)\n        let finalPrice = price.toString()\n        // console.log('final price', finalPrice)\n       \n            liveAuction.methods.BuyFixedPriceNFTs(tokenId).send({value:finalPrice,from:address}).then((res)=>{\n                // console.log(res,\"res of place bid result===>\")\n                let currentUserId=ENV.getUserKeys('_id')._id;\n                changeOwnerShip(nftOwnerId,currentUserId)\n\n\n        })\n            //   Place Bid\n       \n.catch((err)=>{\n    toast.error(\"Transaction Failed Please check wallet history\")\n})\n    }\n\n    export const getCurrentAddress= async ()=>{\n        const web3 = new Web3(Web3.givenProvider);\n\n        let accounts = await web3.eth.getAccounts();\n        // console.log(accounts,\"accounts\")\n        let address = accounts[0];\n        return address\n    }\n\n    export const acceptNftOffer=async(tokenId,body)=>{\n\n\n        const web3 = new Web3(Web3.givenProvider);\n\n        let accounts = await web3.eth.getAccounts();\n        // console.log(accounts,\"accounts\")\n        let address = accounts[0];\n        // console.log(address,\"addresss==>\")\n        // console.log('token before sending', tokenId)\n            //  Accept offer \n       liveAuction.methods.acceptOffer(tokenId).send({from:address}).then((res)=>{\n           \n        // console.log(res,\"res of accept bid result===>\")\n        // toast.success(\"Bid accepted successfully\")\n        acceptBit(tokenId,body)\n    \n})\n.catch((err)=>{\n   console.log(err,\"err in catch block error===>\")\n})\n    }\nexport const signTransaction=async ()=>{\n\n    const web3 = new Web3(Web3.givenProvider);\n    // const nonce = await web3.eth.getTransactionCount(\"myAddress\", 'latest');\n    const rawTransaction = {\n        \"from\": \"Keystore account id\",\n        \"to\": \"Account you want to transfer to\",\n        \"value\": 100,\n        \"gas\": 0.21000,\n    \n      };\n\n      const signedTx = await web3.eth.accounts.signTransaction(rawTransaction, \"PRIVATE_KEY\");\n\n      web3.eth.sendSignedTransaction(signedTx.rawTransaction, function(error, hash) {\n        if (!error) {\n        //   console.log(\"🎉 The hash of your transaction is: \", hash, \"\\n Check Alchemy's Mempool to view the status of your transaction!\");\n        } else {\n        //   console.log(\"❗Something went wrong while submitting your transaction:\", error)\n        }\n       });\n   \n}\n\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/functions.js",["778","779","780","781","782","783","784","785","786","787"],"import axios from \"axios\";\nimport { ENV } from '../config/config';\nimport { Redirect } from 'react-router-dom';\nimport { toast } from 'react-toastify'\nimport { useDispatch } from \"react-redux\";\nimport { emptyError } from '../redux/shared/error/error.action';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID } from '../redux/types';\nlet baseUrl = process.env.REACT_APP_BASE_URL;\n\nexport const axiosSyncPost = (url, data, isMultipart = false) => {\n  return new Promise((resolve, reject) => {\n    const params = new URLSearchParams();\n    let keys = Object.keys(data);\n    for (let x = 0; x < keys.length; x++) {\n      params.append(keys[x], data[keys[x]]);\n    }\n\n    const config = {\n      headers: {\n        'Content-Type': isMultipart ? 'multipart/form-data' : 'application/x-www-form-urlencoded',\n        \"Authorization\": ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n    };\n\n    url = baseUrl + url;\n\n    axios.post(url, params, config).then(\n      (res) => {\n        resolve(res.data);\n      },\n      (error) => {\n        resolve(error)\n      },\n    );\n  });\n};\n\nexport const axiosPostFormData = (url, body, isMultipart = false) => {\n\n  let testingURl=\"http://localhost:5000/v1/front/nfts/create\";\n  return new Promise((resolve, reject) => {\n    const config = {\n      headers: {\n        // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n        \"Authorization\": ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n    };\n    \n\n    // url = testingURl + url;\n\n\n    axios.post(ENV.url + url, body, config).then(\n      (res) => {\n        // console.log(res,\"res success\");\n        resolve(res.data)\n      },\n      (error) => {\n        console.log(error,\"res error\");\n        resolve(error)\n      },\n    );\n  });\n};\n\nexport const decimalNumberValidator = (evt) => {\n  let e = evt || window.event;\n\n  // Allow: backspace, delete, tab, escape, enter and .\n  const specialKeys = [46, 8, 9, 27, 13, 110]\n\n  // Allow: Ctrl+A,Ctrl+C,Ctrl+V, Command+A\n  if (specialKeys.includes(e.keyCode) ||\n    // Allow: Ctrl+A,Ctrl+C,Ctrl+Z,Ctrl+X Command+A\n    ((e.keyCode === 65 || e.keyCode === 67 || e.keyCode === 90 || e.keyCode === 88) && (e.ctrlKey === true || e.metaKey === true)) ||\n    // Allow: home, end, left, right, down, up\n    (e.keyCode >= 35 && e.keyCode <= 40)) {\n    // let it happen, don't do anything\n    return;\n  }\n\n  let key = e.keyCode || e.which;\n  if ((!e.shiftKey && !e.altKey && !e.ctrlKey) &&\n    (((key === 190 || key === 110) ||\n      (key >= 48 && key <= 57)) ||\n      (key >= 96 && key <= 105) ||\n      key === 8 || key === 9 || key === 13 ||\n      key === 35 || key === 36 ||\n      key === 37 || key === 39 ||\n      key === 46 || key === 45)) {\n  }\n  else {\n    e.returnValue = false;\n    if (e.preventDefault) e.preventDefault();\n  }\n}\nexport const setFixedPriceNftTOken=(body)=>{\n  let url = `${ENV.url}nftFixedTokens/getFixedtokens`;\n  // let url = `http://3.142.91.8/v1/front/auctions/live`;\n \n  // console.log(url,\"url==>123\")\n    \n\n  fetch(url, {\n      method: 'POST',\n      headers: {\n          'content-type': 'application/json',\n          'Authorization': ENV.Authorization,\n          'x-auth-token': ENV.x_auth_token,\n          'Access-Control-Allow-Origin': '*',\n          'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n      body:body\n  }).then(res => res.json()).then(data => {\n      // console.log(data,\"created nft token\")\n      if (data.success) {\n        \n      } else {\n         \n      }\n  }).catch(errors => {\n      console.log(errors,\"error\")\n  })\n}\n\nexport const changeOwnerShip=(nftOwnerId,currentUserId)=>{\n  // alert(\"changing ownership\")\n  let url = `${ENV.url}nfts/editNft`;\n  // console.log('fetch url', url)\nlet body={\n  nftOwnerId,\n  currentUserId\n}\n  fetch(url, {\n    method: 'PATCH',\n    headers: {\n      'content-type': 'application/json',\n      'Authorization': ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  },\n    body:JSON.stringify(body)\n     }).then(res => res.json()).then(data => {\n       if(data.status === 'success'){\n        toast.success(\"Successfully bought nft\")\n        window.location.href= '/explore-all'\n       }\n      // console.log(data,\"response from the change ownershiop\")\n     }).catch(errors => {\n       console.log('error',errors)\n    })\n}\nexport const acceptBit = (tokenId,body)  => {\n \n   \n    const url = `${ENV.url}bid/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n            window.location.href= '/explore-all'\n            // dispatch({\n            //     type: ACCEPT_BID,\n            //     payload: data\n            // })\n        } else {\n            toast.error(data.message)\n          \n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n      \n    })\n\n}\n\nexport const placeBidApi = (body) =>  {\n\n  console.log('im here')\n\n\n  const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n    //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n           \n            toast.success(data.message)\n            window.location.href= '/explore-all'\n            // dispatch({\n            //     type: CREATE_BID,\n            //     payload: data\n            // })\n        } else {\n            toast.error(data.message)\n            // dispatch({\n            //     type: GET_ERRORS,\n            //     payload: data\n            // })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        // dispatch({\n        //     type: GET_ERRORS,\n        //     payload: error\n        // })\n    })\n \n \n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/nfts.action.js",["788","789","790","791"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n    axiosPostFormData,\n    decimalNumberValidator,\n  } from \"./../../utils/functions\";\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        // console.log(data,\"check data if \");\n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data.allData,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data.allData,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      // console.log(data,\"checking data of nft==>single\");\n      // alert(\"called\")\n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.allData,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.nft,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const createNFT= async (formData)=>{\n    try {\n\n        const res = await axiosPostFormData(\n            \"nfts/create\",\n            formData,\n            true\n          );\n    }\n    catch(err){\n\n    }\n}\nexport const setNftToken = (formData) => async (dispatch) => {\n\n  const res = await axiosPostFormData(\n            \"nfts/storeNFTData\",\n            formData,\n            true\n          );\n};\n\n\n\n\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.action.js",["792"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero/hero.js",["793","794","795","796","797","798"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport ExploreIcon from \"../../assets/images/explore-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport HeroSlider from \"../hero-slider/HeroSlider\";\r\nimport CustomSlider from \"../hero-slider/CustomSlider\";\r\n\r\nimport HeroSlickSlider from \"../hero-slider/HeroSlickSlider\";\r\n\r\nimport HeroCards from \"../../Screens/rough/hero-cards/HeroCards\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient \"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                Create\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-rounded-bordered btn-hero-explore\"\r\n                to=\"/explore-all\"\r\n              >\r\n                {/* <i className=\"icon-rocket mr-2\" /> */}\r\n                <img src={ExploreIcon} alt=\"exploreIcon\" className=\"me-2\" />\r\n                <p>Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"watch-video mt-5\">\r\n              <span className=\"mt-lg-5\">\r\n                <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" /> Watch\r\n                video to learn more\r\n              </span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6 col-xl-7 \">\r\n            {/* <div className=\"ms-auto d-flex\">\r\n              {/* <HeroCards />\r\n              <HeroCards className=\"HeroCard-after\" /> */}\r\n            {/* <HeroSlider /> */}\r\n            {/* <HeroSlickSlider /> */}\r\n            {/* <CustomSlider /> */}\r\n            {/* </div> */}\r\n\r\n            <Slider />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default Hero;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/top-seller/topseller2.js",["799","800","801","802"],"import React, { useEffect, useState } from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\r\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\r\nimport \"./topseller.css\";\r\n\r\nconst exmpData = [\r\n  {\r\n    id: 1,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 2,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 3,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 4,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 5,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 6,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 7,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 8,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 9,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 10,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 11,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 12,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n];\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n  useEffect(() => {\r\n    setSellers(props.user.sellers);\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  console.log(sellers, \"sellers==>\");\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content\">\r\n                <span>CREATIVE ARTIST</span>\r\n                <h3 className=\"mb-0\">Top Sellers</h3>\r\n              </div>\r\n              {props.viewAll ? (\r\n                <div className=\"intro-btn\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/authors\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              ) : (\r\n                \"\"\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row items\">\r\n          {sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              return (\r\n                <div\r\n                  key={`ts_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                >\r\n                  {/* Single Seller */}\r\n                  <div className=\"card\">\r\n                    <div className=\"single-seller d-flex align-items-center\">\r\n                      <Link to={`/author/${author._id}`}>\r\n                        <div className=\"seller-avatar-container\">\r\n                          <img\r\n                            className=\"avatar-md rounded-circle\"\r\n                            //   src={\r\n                            //     author.profileImage\r\n                            //       ? author.profileImage\r\n                            //       : ENV.globalPlaceholderImage\r\n                            //   }\r\n                            src={AvatarImg}\r\n                            alt=\"\"\r\n                          />\r\n                          <span className=\"seller-avatar-active\">\r\n                            <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                          </span>\r\n                        </div>\r\n                      </Link>\r\n                      {/* Seller Info */}\r\n                      <div className=\"seller-info ml-3 w-100\">\r\n                        <Link\r\n                          className=\"seller mb-2\"\r\n                          to={`/author/${author._id}`}\r\n                        >\r\n                          {author.username}\r\n                        </Link>\r\n                        <span className=\"text-end\">{\"256.6ETH\"}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          ) : (\r\n            <p>Top Sellers not available</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.actions.js",["803"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_COLLECTION, SET_AUTH_STATE, GET_COLLECTION, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\n\nexport const beforeCollection = () => {\n    return {\n        type: BEFORE_COLLECTION\n    }\n}\n\nexport const getCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}collection/get/${collectionId}`;\n \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getCollections = (qs = null) => dispatch => {\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        // console.log(error,\"all collections error\");\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const upsertCollection = (apiURL, body, method = 'POST') => dispatch => {\n\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n   \n    // const url = `http://localhost:5000/v1/front/${apiURL}`;\n\n\n    fetch(url, {\n        method,\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: UPSERT_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}collection/delete/${collectionId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const setAuthState = () => (dispatch) => {\n    dispatch({\n        type: SET_AUTH_STATE,\n    })\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/work/work.js",["804","805","806"],"import React, { Component } from \"react\";\r\nimport WalletIcon from \"../../assets/images/setup-wallet-icon.svg\";\r\nimport CollectionIcon from \"../../assets/images/collection-icon.svg\";\r\nimport AddNftIcon from \"../../assets/images/add-nft-icon.svg\";\r\nimport SaleIcon from \"../../assets/images/sale-icon.svg\";\r\nimport axios from \"axios\";\r\nimport { init } from \"aos\";\r\n\r\n// const BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json/work\";\r\nconst BASE_URL = \"../../json-server/db.json/work\";\r\nconst initData = {\r\n  preHeading: \"How It Works\",\r\n  heading: \"Create and sell your NFTs\",\r\n  workData: [\r\n    {\r\n      id: 1,\r\n      icon: \"icons icon-wallet text-effect\",\r\n      img: WalletIcon,\r\n      title: \"Set up your wallet\",\r\n      text: \"Once you've set up your Celo or BSC Metamask wallet, connect to ARI NFT Marketplace by Signing In and clicking Login.\",\r\n    },\r\n    {\r\n      id: 2,\r\n      icon: \"icons icon-grid text-effect\",\r\n      img: CollectionIcon,\r\n      title: \"Create your collection\",\r\n      text: \"Click Create and set up your collection. Add social links, a description, profile & banner images, and set a secondary sales fee.\",\r\n    },\r\n    {\r\n      id: 3,\r\n      icon: \"icons icon-drawer text-effect\",\r\n      img: AddNftIcon,\r\n      title: \"Add your NFTs\",\r\n      text: \"Upload your work (image, video, audio, or 3D art), add a title and description, and customize your NFTs with properties, stats, and unlockable content.\",\r\n    },\r\n    {\r\n      id: 4,\r\n      icon: \"icons icon-bag text-effect\",\r\n      img: SaleIcon,\r\n      title: \"List them for sale\",\r\n      text: \"Choose between auctions, fixed-price listings, and declining-price listings. You choose how you want to sell your NFTs!\",\r\n    },\r\n  ],\r\n};\r\n// console.log('base url',BASE_URL)\r\nclass Work extends Component {\r\n  state = {\r\n    data: {},\r\n    workData: [],\r\n  };\r\n  componentDidMount() {\r\n    this.setState({\r\n      data: initData,\r\n      workData: initData.workData,\r\n    });\r\n    // axios.get(`${BASE_URL}`)\r\n    //     .then(res => {\r\n    //         this.setState({\r\n    //             data: res.data,\r\n    //             workData: res.data.workData\r\n    //         })\r\n    //         console.log(this.state.data)\r\n    //     })\r\n    // .catch(err => console.log(err))\r\n  }\r\n  render() {\r\n    return (\r\n      <section className=\"work-area padding-wrapper\">\r\n        <div className=\"container\">\r\n          <div className=\"row\">\r\n            <div className=\"col-12\">\r\n              {/* Intro */}\r\n              <div className=\"intro mb-4\">\r\n                <div className=\"intro-content\">\r\n                  <span>{this.state.data.preHeading}</span>\r\n                  <h3 className=\"mb-0\">{this.state.data.heading}</h3>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row items mt-3 mt-lg-5\">\r\n            {this.state.workData.map((item, idx) => {\r\n              return (\r\n                <div\r\n                  key={`wd_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                >\r\n                  {/* Single Work */}\r\n                  <div className=\"single-work\">\r\n                    {/* <i className={`${item.icon} mb-5`} /> */}\r\n                    <img src={item.img} alt=\"icon\" className=\"mb-3\" />\r\n                    <h4 className=\"mb-3\">{item.title}</h4>\r\n                    <p>{item.text}</p>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })}\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n}\r\n\r\nexport default Work;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/authors/authors.js",["807","808"],"import React, { useEffect, useState } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport {Link} from 'react-router-dom';\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst Authors = (props) => {\r\n    const [creators, setCreators] = useState([]);\r\n    useEffect(()=> {\r\n        props.getCreators();\r\n        window.scrollTo(0, 0)\r\n    }, []);\r\n    useEffect(()=> {\r\n        setCreators(props.user.sellers)\r\n      \r\n    }, [props.user.topSellersAuth]);\r\n\r\n    return (\r\n        <section className=\"popular-collections-area mt-5\">\r\n            <br />\r\n            <br />\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>Creators</span>\r\n                            <h3 className=\"mt-3 mb-0\">Our Creators</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    {\r\n                        creators && creators.length ? \r\n                        creators.map((author, key)=> {\r\n                            return (\r\n                                <div key={`author_${key}`} className=\"col-12 col-sm-6 col-lg-3 item\">\r\n                                    <div className=\"card no-hover text-center\">\r\n                                        <div className=\"image-over\">\r\n                                            <Link to={`/author/${author._id}`}>\r\n                                                <img className=\"card-img-top\" src={author.profileImage ? author.profileImage: ENV.globalPlaceholderImage} alt=\"Author profile\" />\r\n                                            </Link>\r\n                                        </div>\r\n                                        <div className=\"card-caption col-12 p-0\">\r\n                                            <div className=\"card-body mt-1\">\r\n                                                <Link to={`/author/${author._id}`}>\r\n                                                    <h5>{author.username ? author.username : author.address} </h5>\r\n                                                </Link>\r\n                                                <button type=\"button\" className=\"btn btn-bordered-white btn-smaller\">Follow</button>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                  \r\n                                </div>\r\n                            )\r\n                        })\r\n                        : \r\n                        <p>No Creators Found</p>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n   \r\n    {\r\n    user: state.user\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getCreators })(Authors);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nft-preview/nft-preview.js",["809"],"import React from 'react';\r\nimport { ENV } from '../../config/config'\r\nimport './nft-preview.css'\r\nconst itemPlaceholderImg = ENV.globalPlaceholderImage\r\n\r\nconst NFTPreview = (props) => {\r\n    return (\r\n       \r\n        <div className=\"card preview-nft-card no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.image ? props.image : itemPlaceholderImg} alt=\"NFT image\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body p-0 m-0\">\r\n                    {/* <h5 className=\"mb-3\">{props.name}</h5> */}\r\n                    {/* <p>{props.sold ? props.sold : 0} of {props.copies ? props.copies : 0} Copies</p> */}\r\n                    <p className=\"text-left nft-name-text mt-4\">{\"name\"}</p>\r\n                    <div className=\"d-flex justify-content-between\">\r\n\r\n                    <p className=\"text-white celo-text\">{props.currentPrice ? props.currentPrice : 0}{ENV.currency}</p>\r\n                    <p className=\"text-white\">{\"10/10\"}</p>\r\n                    </div>\r\n                    <div className=\"input-group\">\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n       \r\n    );\r\n}\r\n\r\nexport default NFTPreview;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step4/Step4.js",["810","811","812","813","814","815","816","817","818","819"],"import { useState, useEffect } from \"react\";\nimport MetamaskImg from \"../../../../assets/images/metamask.svg\";\nimport RefreshImg from \"../../../../assets/images/Refresh.svg\";\nimport DetailsImg from \"../../../../assets/images/Details.svg\";\nimport DiscordImg from \"../../../../assets/images/Discord.svg\";\nimport ReactCaptcha from \"../../../../components/Captcha/Captcha\";\n// import { connectMetamaskCopy } from \"../../../../Utils/web3\";\nimport PreviewModal from \"../../../../components/PreviewModal/PreviewModal\";\n// import { CopyToClipboard } from \"react-copy-to-clipboard\";\nimport { MdContentCopy } from \"react-icons/md\";\nimport { getNetworkNameByChainId } from \"../../../../utils/web3\";\nimport {\n  connectWallet,\n  contractResponse,\n  sendOtp,\n  verifyOtp,\n} from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport \"./Step4.css\";\nimport copy from \"copy-to-clipboard\";\nimport { toast } from \"react-toastify\";\nimport { getWalletAddress } from \"../../../../utils/web3\";\nimport { ENV } from \"../../../../config/config\";\nimport { ProgressBar } from \"react-bootstrap\";\n// import Stepper from \"../../../../Components/Stepper/Stepper\";\n// import { propTypes } from \"react-bootstrap/esm/Image\";\nconst Step4 = (props) => {\n  const { discordLink } = ENV;\n  // console.log(props,\"props in setp 4\")\n  const [isVisible, setIsvisible] = useState(false);\n  // const [isValidate, setIsvalidate] = useState(false);\n  const [captchaStatus, setCaptchaStatus] = useState(false);\n  const [captchaError, setCaptchaError] = useState(false);\n  const [captchaMessage, setCaptchaMessage] = useState(\n    \"Invalid Captchca Please Try Again\"\n  );\n  const [email, setEmail] = useState(props.email);\n  const [deployNetwork, setDeployNetwork] = useState(\"\");\n  const [deploy, setDeploy] = useState(false);\n  // const [compile, setCompile] = useState(false);\n  const [loadingMessage, setLoadingMessage] = useState(\"\");\n  const [error, setError] = useState(false);\n  const [emailError, setEmailError] = useState(false);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  //otp verification\n  const [otp, setOtp] = useState(\"\");\n  const [otpError, setOtpError] = useState(false);\n\n  //previewModal\n  const [previewModal, setPreviewModal] = useState(false);\n  const [previewModalStep, setPreviewModalStep] = useState(1);\n  const [maxLimit, setMaxLimit] = useState(false);\n\n  const handleCaptcha = (value) => {\n    // console.log(value);\n    setCaptchaStatus(value);\n    setCaptchaError(false);\n    // if (value) {\n    //   setIsvalidate(true);\n    // }\n  };\n  const checkInternetConnection = () => {\n    var ifConnected = window.navigator.onLine;\n    if (!ifConnected) {\n      toast.error(\"Internet Connection not available!\");\n      return false;\n    } else {\n      return true;\n    }\n  };\n\n  const onChangeEmail = (e) => {\n    setError(false);\n    setEmailError(false);\n    setEmail(e.target.value.trimStart());\n    props.handleStep4Info(e.target.value.trimStart());\n  };\n\n  const handleVisible = () => {\n    setIsvisible(true);\n  };\n\n  const submitCaptcha = () => {\n    // console.log(captchaStatus, \"captchaStatus\");\n    if (checkInternetConnection()) {\n    if (email && emailValidate()) {\n      if (captchaStatus) {\n        // setIsvalidate(true);\n        props.handleCaptchaValidation(true);\n        let data = {\n          email,\n        };\n        toast.success(`Verification OTP code is sent to ${email}`);\n        props.sendOtp(data);\n      } else {\n        setCaptchaError(true);\n      }\n    } else {\n      setEmailError(true);\n      setErrorMessage(\"Please proivde Email.\");\n    }\n  }\n  };\n\n  const onConnect = () => {\n    // props.connectWallet()\n    if (!email) {\n      setEmailError(true);\n      setErrorMessage(\"Email is required\");\n      return \"\";\n    } else {\n      const validate = emailValidate();\n      if (!validate) return \"\";\n    }\n\n    getWalletAddress().then((address) => {\n      // let count = localStorage.getItem(address);\n      // // console.log(count,\"count\")\n      // if (+count > 100) {\n      //   toast.error(\"Maximum Deployment Limit Reached with This Wallet Address! Please contact support.\");\n      //   setMaxLimit(true)\n      //   return \"\";\n      // }\n      // else {\n      //   setMaxLimit(false)\n      // }\n    });\n\n    if (email === \"\") {\n      setError(true);\n      return \"\";\n    }\n\n    props.handleDeployContract();\n  };\n  const emailValidate = () => {\n    if (\n      !String(email)\n        .toLowerCase()\n        .match(\n          /^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/\n        )\n    ) {\n      setEmailError(true);\n      setErrorMessage(\"Email must be valid\");\n      return false;\n    }\n    return true;\n  };\n\n  const onReload = () => {\n \n    if (!email) {\n      setEmailError(true);\n      setErrorMessage(\"Email is required\");\n      return \"\";\n    } else {\n      const validate = emailValidate();\n      if (!validate) return \"\";\n    }\n\n    if (!props.contractReponse) {\n      setDeploy(true);\n\n      // props.contractResponse();\n      props.handleStep4Info(email, deployNetwork);\n      props.handleDeployContract();\n    }\n  };\n\n  const onMint = () => {\n    if (checkInternetConnection()) {\n      if (email === \"\") {\n        setError(true);\n        return \"\";\n      }\n\n      getNetworkNameByChainId()\n        .then((network) => {\n          // console.log(network,\"network==>\")\n          // console.log(props,\"props==>9\")\n          if (network === props.connectedNetwork || !props.connectedNetwork) {\n            setLoadingMessage(\"Please wait your NFT is Minting...\");\n\n            setDeploy(true);\n            props.handleStep4Info(email, deployNetwork);\n\n            props.handleMinting(props.contractInfo, email);\n          } else {\n            toast.error(\n              `Please connect with ${props.connectedNetwork} network`\n            );\n          }\n        })\n        .catch((err) => {});\n    }\n  };\n  useEffect(() => {}, [props.connectedAddressFlag]);\n\n  useEffect(() => {\n    // console.log('all props ', props)\n    // console.log('response for contract ', props.contractResponse)\n  }, [props.contractResponse]);\n\n  const handlePreviewModal = () => {\n    // if(!email)\n    setPreviewModalStep(1);\n    setPreviewModal(!previewModal);\n  };\n\n  const handlePreviewModalSteps = (action) => {\n    if (action === \"next\") {\n      setPreviewModalStep(2);\n    } else {\n      setPreviewModalStep(1);\n    }\n  };\n\n  const onDeploy = () => {\n    if (checkInternetConnection()) {\n      setPreviewModal(false);\n      setLoadingMessage(\"Please wait your contract is Deploying...\");\n      setDeploy(true);\n      props.handleStep4Info(email, deployNetwork);\n      props.handleDeployment();\n    }\n  };\n  // console.log(props,\"tokenId===>\")\n  const displayToken = () => {\n    if (props?.tokenId) {\n      return props.tokenId;\n    }\n    if (props.tokenMinted) {\n      if (+props.supply > 1) {\n        return ` 1-${props.supply}`;\n      }\n    }\n  };\n  const handleOtpVerification = () => {\n    if (checkInternetConnection()) {\n      if (!otp.trim()) {\n        setOtpError(true);\n      } else {\n        props.verifyOtp(email, otp);\n      }\n    }\n  };\n  const sendEmailOtp = () => {\n    if (checkInternetConnection()) {\n      console.log(checkInternetConnection())\n    if (emailValidate()) {\n      let data = {\n        email,\n      };\n      toast.success(`Verification OTP code is sent to ${email}`);\n      props.sendOtp(data);\n    }\n  }\n  };\n  // console.log(props);\n  return (\n    <div className=\"step4-container w-80\">\n      {/* Metamask container */}\n      <div className=\"metamask-container \">\n        <div className=\"d-md-flex justify-content-between w-100 step-4-wrapper\">\n          <div className=\"form-container w-50\">\n            <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n              <div className=\"position-relative\">\n                <label className=\"text-white step4-label\">Email</label>\n                {error && (\n                  <p className=\"mb-0\" style={{ color: \"red\" }}>\n                    {errorMessage}\n                  </p>\n                )}\n                <p\n                  className=\"position-absolute\"\n                  style={{ color: \"red\", top: \"0\", left: \"3.9rem\" }}\n                >\n                  *\n                </p>\n                <p className=\"mb-1\" style={{ color: \"red\" }}>\n                  {emailError && errorMessage}\n                </p>\n              </div>\n\n              <input\n                className=\"step-4-input mt-2\"\n                type=\"text\"\n                onChange={(e) => onChangeEmail(e)}\n                onBlur={(e) => emailValidate(e)}\n                disabled={false}\n                disabled={\n                  props.walletAddress || props.otpVerification ? true : false\n                }\n                value={email}\n                placeholder=\"example@gmail.com\"\n                style={{ maxWidth: \"22rem\", color: \"white\" }}\n              />\n            </div>\n\n            {props.isValidate === false ? (\n              <div className=\"mt-4\">\n                <label className=\"text-white mb-2 step4-label\">\n                  Verify Captcha\n                </label>\n                <ReactCaptcha\n                  handleCaptcha={handleCaptcha}\n                  handleVisible={handleVisible}\n                  isVisible={isVisible}\n                />\n                <p className=\"text-danger mb-0 mt-1\">\n                  {captchaError && captchaMessage}\n                </p>\n                <button\n                  // className=\"btn btn-primary step4-btn\"\n                  className=\"btn btn-secondary start-btn\"\n                  style={{ marginTop: \"0.8rem\" }}\n                  onClick={() => submitCaptcha()}\n                >\n                  Submit\n                </button>\n              </div>\n            ) : // <>\n            !props.otpVerification ? (\n              <div className=\"d-flex flex-column\">\n                <label className=\"text-white step4-label mt-4\">OTP</label>\n                {otpError && (\n                  <p className=\"text-danger  my-1\">Please Enter OTP</p>\n                )}\n                <input\n                  className=\"step-4-input mt-2\"\n                  type=\"Number\"\n                  onChange={(e) => {\n                    setOtpError(false);\n                    setOtp(e.target.value);\n                  }}\n                  placeholder=\"Enter OTP\"\n                  style={{ maxWidth: \"22rem\", color: \"white\" }}\n                />\n                <button\n                  className=\"btn btn-secondary verify-otp-btn mt-4\"\n                  style={{ marginTop: \"0.8rem\", maxWidth: \"22rem\" }}\n                  onClick={() => handleOtpVerification()}\n                >\n                  Verify\n                  {/* <div class=\"spinner-border verify-spinner\" role=\"status\">\n                    <span class=\"sr-only\">Loading...</span>\n                  </div> */}\n                </button>\n                <button\n                  // className=\"btn btn-primary step4-btn\"\n                  className=\"btn btn-secondary verify-otp-btn mt-4\"\n                  style={{ marginTop: \"0.8rem\", maxWidth: \"22rem\" }}\n                  onClick={() => sendEmailOtp()}\n                >\n                  Resend OTP\n                  {/* <div class=\"spinner-border verify-spinner\" role=\"status\">\n                    <span class=\"sr-only\">Loading...</span>\n                  </div> */}\n                </button>\n              </div>\n            ) : (\n              // <>\n              // !props.otpVerification ? (\n              //   <div className=\"d-flex flex-column\">\n              //     <label className=\"text-white step4-label mt-4\">OTP</label>\n              //     {otpError && (\n              //       <p className=\"text-danger  my-1\">Please Enter OTP</p>\n              //     )}\n              //     <input\n              //       className=\"step-4-input mt-2\"\n              //       type=\"Number\"\n              //       onChange={(e) => {\n              //         setOtpError(false);\n              //         setOtp(e.target.value);\n              //       }}\n              //       placeholder=\"Enter OTP\"\n              //       style={{ maxWidth: \"22rem\", color: \"white\" }}\n              //     />\n              //     <button\n              //       // className=\"btn btn-primary step4-btn\"\n              //       className=\"btn btn-secondary verify-otp-btn mt-4\"\n              //       style={{ marginTop: \"0.8rem\", maxWidth: \"22rem\" }}\n              //       onClick={() => handleOtpVerification()}\n              //     >\n              //       Verify\n              //       {/* <div class=\"spinner-border verify-spinner\" role=\"status\">\n              //         <span class=\"sr-only\">Loading...</span>\n              //       </div> */}\n              //     </button>\n              //   </div>\n              // ) :\n              <div className=\"d-flex mt-4\" style={{ flexDirection: \"column\" }}>\n                <div>\n                  <img\n                    src={MetamaskImg}\n                    style={{ width: \"2rem\", marginRight: \"0.8rem\" }}\n                  />\n                  <div className=\"position-relative\">\n                    <label className=\"text-white step4-label\">\n                      Connect Wallet\n                    </label>\n                    <p\n                      className=\"position-absolute\"\n                      style={{ color: \"red\", top: \"0\", left: \"10.4rem\" }}\n                    >\n                      *\n                    </p>\n                  </div>\n                </div>\n                <p className=\"mb-0 mt-2\" style={{ color: \"#aaabab\" }}>\n                  {\" \"}\n                  Connect Wallet with Metamask\n                </p>\n                <div className=\"d-flex align-items-center w-100\">\n                  <button\n                    className={`btn btn-primary my-3 address-btn ${\n                      props.walletAddress ? \"step4-btn\" : \"start-btn\"\n                    }`}\n                    style={{ marginTop: \"0.8rem\" }}\n                    disabled={\n                      props.contractReponse || props.walletAddress\n                        ? true\n                        : false\n                    }\n                    onClick={() => onConnect()}\n                  >\n                    {props.walletAddress ? props.walletAddress : \"Connect\"}\n                  </button>\n                  {!props.loader && !props.contractReponse && (\n                    <img\n                      src={RefreshImg}\n                      style={{\n                        width: \"2rem\",\n                        marginLeft: \"0.8rem\",\n                        cursor: \"pointer\",\n                      }}\n                      disabled={props.contractReponse ? true : false}\n                      onClick={() => onReload()}\n                    />\n                  )}\n                </div>\n              </div>\n            )}\n          </div>\n          <div className=\"discord-container discordJoinCls w-50\">\n            <div\n              className=\"d-flex align-items-center\"\n              style={{ width: \"100%\" }}\n            >\n              <img\n                src={DiscordImg}\n                style={{ width: \"2rem\", marginRight: \"1rem\" }}\n                alt=\"\"\n              />\n              <p className=\"step4-label text-white mb-0\"> Join Discord</p>\n            </div>\n            <p className=\"\" style={{ color: \"#aaabab\" }}>\n              “NFTs are the next big disruptor, just as the internet and\n              eCommerce was.” — Gary Vaynerchuck, Investment guru Mainstream\n              community of digital celebrities and collectors awaits you on\n              Discord!\n            </p>\n            <a\n              className=\"btn btn-secondary discord-btn  mt-2 navbar-item\"\n              style={{ padding: \"0.4rem 6rem !important\" }}\n              href={discordLink}\n              target=\"_blank\"\n            >\n              Join\n            </a>\n          </div>\n        </div>\n        {props.walletAddress && (\n          <div className=\"w-100 text-center mt-4\">\n            <button\n              className=\"btn btn-primary start-btn\"\n              style={{\n                marginTop: \"0.8rem\",\n                backgroundColor: \"#FCD70D  !important\",\n                color: \"black !important\",\n              }}\n              disabled={props.contractReponse ? true : false}\n              onClick={handlePreviewModal}\n            >\n              Preview\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* Details */}\n\n      {props.loader &&\n      (props.contractReponse == false || props.mintingResponse === false) ? (\n        <div className=\"w-100 text-center mt-4\">\n          <div\n            className=\"spinner-border\"\n            style={{ color: \"white\" }}\n            role=\"status\"\n          ></div>\n          <p className=\"text-white\">{loadingMessage}</p>\n          {/* <Stepper/> */}\n        </div>\n      ) : (\n        (props.contractReponse || props.mintingResponse) &&\n        !props.contractError && (\n          <div className=\"step4-details-container mb-2 d-flex justify-content-center w-100\">\n            <div className=\"w-100 d-flex flex-column justify-content-center align-items-center\">\n              <div className=\" w-100 d-flex justify-content-center mt-4\">\n                <div className=\"d-flex align-items-center\">\n                  <img\n                    src={DetailsImg}\n                    style={{ width: \"1.4rem\", marginRight: \"0.5rem\" }}\n                  />\n                  <p className=\"text-white details-title mb-0\">Details</p>\n                </div>\n              </div>\n\n              <div className=\"details-box py-4 mt-4\">\n                <div className=\"details-box-content d-flex justify-content-between flex-row p-2 p-sm-4\">\n                  <div>\n                    <p className=\"info\">Contract Address</p>\n\n                    {props.tokenMinted && props.tokenMinted.length > 0 ? (\n                      <p className=\"info\"> {\"Token ID's\"} </p>\n                    ) : props.tokenId ? (\n                      <p className=\"info\"> {\"Token ID\"} </p>\n                    ) : (\n                      \"\"\n                    )}\n\n                    <p className=\"info\">Token Standard</p>\n                    <p className=\"info\">Blockchain</p>\n                  </div>\n\n                  <div>\n                    <div className=\"d-flex\">\n                      <p\n                        className=\"info\"\n                        style={{\n                          color: \"rgb(68, 209, 249)\",\n                          marginRight: \"0.3rem\",\n                        }}\n                      >\n                        {\" \"}\n                        {props.contractAddress\n                          ? `${String(props.contractAddress).substr(\n                              0,\n                              10\n                            )}.....${String(props.contractAddress).substr(\n                              -10,\n                              String(props.contractAddress).length\n                            )}`\n                          : \"0xsbms....dks33\"}\n                      </p>\n\n                      <MdContentCopy\n                        onClick={() => {\n                          copy(props?.contractAddress);\n                          toast.success(\"Address Copied!\");\n                        }}\n                        style={{\n                          color: \"white\",\n                          width: \"1.3rem\",\n                          height: \"1.3rem\",\n                          cursor: \"pointer\",\n                          marginTop: \"0rem\",\n                        }}\n                      />\n                    </div>\n\n                    {props.tokenId ? (\n                      <p className=\"info\"> {displayToken()} </p>\n                    ) : props.tokenMinted && props.tokenMinted.length > 0 ? (\n                      <p className=\"info\"> {displayToken()} </p>\n                    ) : (\n                      \"\"\n                    )}\n\n                    <p className=\"info \">ERC-721</p>\n                    <p className=\"info \">Ethereum</p>\n                  </div>\n                </div>\n                <div className=\"w-100 text-center \">\n                  {!props.mintingResponse && (\n                    <button\n                      className=\"btn btn-primary mintbtn\"\n                      onClick={() => onMint()}\n                    >\n                      Let's Mint\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )\n      )}\n      <PreviewModal\n        previewModal={previewModal}\n        handlePreviewModal={handlePreviewModal}\n        handlePreviewModalSteps={handlePreviewModalSteps}\n        previewModalStep={previewModalStep}\n        onDeploy={onDeploy}\n        properties={props.properties}\n        levels={props.levels}\n        info={props.info}\n        maxLimit={maxLimit}\n      />\n      <div\n        className=\"progress-bar-custom\"\n        style={{ width: \"64%\", margin: \"3rem auto 0 auto\" }}\n      >\n        <ProgressBar\n          className={`${\n            props.currentStep === 4\n              ? \"progress-bar-green\"\n              : \"progress-bar-yellow\"\n          }`}\n          now={props.currentStep * 25}\n        />\n        <p className=\"text-white text-center mt-2\">{props.currentStep}/4</p>\n      </div>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    connectedAddress: state.dashboard.connectedAddress,\n    connectedAddressFlag: state.dashboard.connectedAddressFlag,\n    contractReponse: state.dashboard.contractReponse,\n    contractError: state.dashboard.contractError,\n    contractInfo: state.dashboard.contractInfo,\n    mintingResponse: state.dashboard.mintingResponse,\n    loader: state.dashboard.loader,\n    tokenId: state.dashboard.tokenId,\n    contractAddress: state.dashboard.contractAddress,\n    tokenMinted: state.dashboard.tokenMinted,\n    otpVerification: state.dashboard.otpVerification,\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n    otpEmail: state.dashboard.otpEmail,\n  });\n\nexport default connect(mapStateToProps, {\n  connectWallet,\n  contractResponse,\n  sendOtp,\n  verifyOtp,\n})(Step4);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/Step3.js",["820","821","822","823","824","825","826","827","828","829"],"import { useState, useEffect } from \"react\";\n\nimport PropertiesImage from \"../../../../assets/images/Properties.svg\";\nimport AddBtnImage from \"../../../../assets/images/Add Button.svg\";\nimport LevelsBtn from \"../../../../assets/images/Levels.svg\";\nimport {\n  currentStepAction,\n  setProperties,\n  setLevels,\n} from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport PropertiesModal from \"../../../../components/PropertiesModal/ProppertiesModal\";\nimport LevelsModal from \"../../../../components/LevelsModal/LevelsModal\";\nimport \"./Step3.css\";\n////For Accordian\nimport * as React from \"react\";\nimport Accordion from \"@mui/material/Accordion\";\nimport AccordionSummary from \"@mui/material/AccordionSummary\";\nimport AccordionDetails from \"@mui/material/AccordionDetails\";\nimport Typography from \"@mui/material/Typography\";\nimport ExpandMoreIcon from \"@mui/icons-material/ExpandMore\";\nimport { Grid, ListItem, ListItemText } from \"@mui/material\";\nimport InfoComp from \"../../infoComp\";\nimport { BsFillInfoCircleFill } from \"react-icons/bs\";\n/////////////////\nimport { ProgressBar } from \"react-bootstrap\";\nimport PropertyModal from \"./PropertyModal\";\nimport LevelModal from \"./LevelsModal\";\n\nconst Step3 = (props) => {\n  // const [open, setOpen] = useState(false);\n  // const [openLevelModal, setOpenLevelModal] = useState(false);\n\n  ///////\n  // const handleOpen = () => setOpen(true);\n  // const handleClose = () => setOpen(false);\n\n  // const handleOpenLevel = () => setOpenLevelModal(true);\n  // const handleCloseLevel = () => {\n  //   setOpenLevelModal(false);\n  // };\n\n  const onSubmit = (propertiesField) => {\n    props.setProperties(propertiesField);\n  };\n  const onSubmitLevels = (levelsFields) => {\n    props.setLevels(levelsFields);\n  };\n  function onClickDelete(event) {\n    event.stopPropagation();\n    // Handle click here\n  }\n\n  return (\n    <div className=\"step3-container \" style={{ height: \"45vh\" }}>\n      {/* ///////////////////// */}\n      <Accordion\n        className=\"transBG\"\n        style={{ backgroundColor: \"unset !important\" }}\n      >\n        <AccordionSummary\n          className=\"transBG\"\n          expandIcon={<ExpandMoreIcon />}\n          aria-controls=\"panel1a-content\"\n          id=\"panel1a-header\"\n        >\n          {/* <Typography>Accordion 1</Typography> */}\n          <div\n            className=\"properties-container d-flex justify-content-between \"\n            onClick={onClickDelete}\n          >\n            <div className=\"ml-2\">\n              <div className=\"d-flex align-items-center \">\n                <img src={PropertiesImage} style={{ height: \"2rem\" }} />\n                <p className=\"mb-0 text-white \" style={{ marginLeft: \"1rem\" }}>\n                  Properties{\" \"}\n                  <span className=\"infoIcon position-relative\">\n                    <BsFillInfoCircleFill />{\" \"}\n                    <span className=\"tooltiptext properties-tooltip\">\n                      Textual Traits Of NFTs\n                    </span>\n                  </span>\n                </p>\n                {/* <img\n                  src={AddBtnImage}\n                  onClick={() => handleOpen()}\n                  className=\"ml-3\"\n                  style={{ height: \"1.5rem\", cursor: \"pointer\" }}\n                /> */}\n                <PropertyModal\n                  propertiesValues={props.properties}\n                  onSubmit={onSubmit}\n                />\n              </div>\n              <p className=\"text-white mt-1\">\n                Textual traits that show up as a rectangles\n              </p>\n            </div>\n          </div>\n        </AccordionSummary>\n        <AccordionDetails className=\"transBG\">\n          {props.properties && props.properties.length > 0 && (\n            <ListItem>\n              <Grid className=\"text-white list-title py-0\" item xs={6}>\n                {\"Name\"}\n              </Grid>\n              <Grid className=\"text-white list-title py-0\" item xs={6}>\n                {\"Value\"}\n              </Grid>\n            </ListItem>\n          )}\n          <ListItem>\n            <Grid container xs={12} className=\"properties-grid\">\n              {props.properties && props.properties.length > 0 ? (\n                props.properties.map((property, i) => {\n                  return (\n                    <>\n                      <>\n                        <Grid\n                          className=\"py-2 text-white list-item break-word pr-1\"\n                          item\n                          xs={6}\n                        >\n                          {property.name}\n                        </Grid>\n                        <Grid\n                          className=\"py-2 text-white list-item break-word pl-1\"\n                          item\n                          xs={6}\n                        >\n                          {property.value}\n                        </Grid>\n                      </>\n                      <span className=\"grid-divider\"></span>\n                    </>\n                  );\n                })\n              ) : (\n                <p className=\"text-white\">{\"No Properies Found\"} </p>\n              )}\n            </Grid>\n          </ListItem>\n        </AccordionDetails>\n      </Accordion>\n\n      {/* /////////////////// */}\n      <Accordion className=\"transBG\">\n        <AccordionSummary\n          className=\"transBG\"\n          expandIcon={<ExpandMoreIcon />}\n          aria-controls=\"panel1a-content\"\n          id=\"panel1a-header\"\n        >\n          {/* <Typography>Accordion 1</Typography> */}\n          <div\n            className=\"properties-container d-flex justify-content-between mt-4 \"\n            onClick={onClickDelete}\n          >\n            <div className=\"ml-2\">\n              <div className=\"d-flex align-items-center \">\n                <img src={LevelsBtn} style={{ height: \"2rem\" }} />\n                <p className=\"mb-0 text-white\" style={{ marginLeft: \"1rem\" }}>\n                  Levels{\" \"}\n                  <span className=\"infoIcon position-relative\">\n                    <BsFillInfoCircleFill />{\" \"}\n                    <span className=\"tooltiptext properties-tooltip\">\n                      Numerical Traits Of NFTs\n                    </span>\n                  </span>\n                </p>\n                <LevelModal\n                  levels={props.levels}\n                  onSubmitLevels={onSubmitLevels}\n                />\n              </div>\n              <p className=\"text-white mt-1\">\n                Numerical traits that show as a progress bar\n              </p>\n            </div>\n          </div>\n        </AccordionSummary>\n        <AccordionDetails>\n          {props.levels && props.levels.length > 0 && (\n            <ListItem>\n              <Grid className=\"text-white list-title py-0\" item xs={4}>\n                {\"Name\"}\n              </Grid>\n              <Grid className=\"text-white list-title py-0\" item xs={4}>\n                {\"Value\"}\n              </Grid>\n              <Grid className=\"text-white list-title py-0\" item xs={4}>\n                {\"Total\"}\n              </Grid>\n            </ListItem>\n          )}\n\n          <ListItem>\n            <Grid container xs={12} className=\"properties-grid\">\n              {props.levels && props.levels.length > 0 ? (\n                props.levels.map((level, i) => {\n                  return (\n                    <>\n                      <>\n                        <Grid\n                          className=\"py-2 text-white list-item break-word\"\n                          item\n                          xs={4}\n                        >\n                          {level.name}\n                        </Grid>\n                        <Grid className=\"py-2 text-white list-item\" item xs={4}>\n                          {level.value}\n                        </Grid>\n                        <Grid className=\"py-2 text-white list-item\" item xs={4}>\n                          {level.total}\n                        </Grid>\n                      </>\n                      <span className=\"grid-divider\"></span>\n                    </>\n                  );\n                })\n              ) : (\n                <p className=\"text-white\">{\"No Levels Found\"}</p>\n              )}\n            </Grid>\n          </ListItem>\n        </AccordionDetails>\n      </Accordion>\n\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary start-btn mt-3 mb-5\"\n        onClick={() => props.currentStepAction()}\n      >\n        Next\n      </button>\n      <div\n        className=\"progress-bar-custom\"\n        style={{ width: \"64%\", margin: \"3rem auto 0 auto\" }}\n      >\n        <ProgressBar\n          className={`${\n            props.currentStep === 4\n              ? \"progress-bar-green\"\n              : \"progress-bar-yellow\"\n          }`}\n          now={props.currentStep * 25}\n        />\n        <p className=\"text-white text-center mt-2\">{props.currentStep}/4</p>\n      </div>\n\n      {/* <PropertiesModal\n        open={open}\n        handleOpen={handleOpen}\n        handleClose={handleClose}\n        propertiesValues={props.properties}\n        onSubmit={onSubmit}\n      /> */}\n      {/* <LevelsModal\n        open={openLevelModal}\n        handleOpen={handleOpenLevel}\n        handleClose={handleCloseLevel}\n        levelsInputs={props.levels}\n        onSubmitLevels={onSubmitLevels}\n      /> */}\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n  setLevels,\n  setProperties,\n})(Step3);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/abiSetup.js",["830"],"import Web3 from 'web3';\nimport liveAuctionsAbi from './abis/ARISwapToken.json'\nimport {ENV} from '../config/config';\n// const web3 = new Web3(\n//   new Web3.providers.HttpProvider('https://data-seed-prebsc-1-s1.binance.org:8545')\n// );\n\nlet web3Provider = window.ethereum;\nvar web3 = new Web3(web3Provider);\n web3 = new Web3(Web3.givenProvider);\n//it's the abi\n\nlet liveAuction=null;\ntry{\n\n     liveAuction = new web3.eth.Contract(liveAuctionsAbi,'0xE400E3fb41B83a2f8161A8d6F34b7B3023441AF5');\n}\ncatch(err){\n// console.log(err,\"error in abiSetup\")\n}\n\nexport { liveAuction };\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/header/header.js",["831","832","833","834","835","836","837"],"import React, { useState, useEffect } from \"react\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { setWalletAddress, getWalletAddress } from \"../wallet/wallet.action\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport { logoutUser } from \"../user/user.action\";\nimport { ENV } from \"./../../config/config\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport MintsClubLogo from \"../../assets/images/main-logo.svg\";\n\nconst Header = (props) => {\n  const history = useHistory();\n  // console.log(\"history\", history);\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [loader, setLoader] = useState(true);\n  const { _id } = ENV.getUserKeys(\"_id\");\n\n  useEffect(async () => {\n    // COMMENTED TEMPORARILY\n    // METHOD 1\n    // props.getWalletAddress()\n\n    // METHOD 2 - a\n    // let connectedAddress = await connectMetamask();\n    // setConnectedAddress(connectedAddress)\n\n    // METHOD 3\n    // if (localStorage.getItem('wa')) {\n    //     let connectedAddress = window.atob(localStorage.getItem('wa'))\n    //     setConnectedAddress(connectedAddress)\n    // }\n\n    // METHOD 4\n    let connectedAddress = await connectMetamaskCopy();\n    setConnectedAddress(connectedAddress);\n    props.setWalletAddress(connectedAddress);\n  }, []);\n\n  // set loader to false when address is received\n  useEffect(() => {\n    if (connectedAddress) setLoader(false);\n  }, [connectedAddress]);\n\n  // COMMENTED TEMPORARILY\n  // METHOD 2 - b\n  // useEffect(() => {\n  //     if (props.wallet.walletAuth) {\n  //         const { connectedAddress } = props.wallet\n  //         setConnectedAddress(connectedAddress)\n  //     }\n  // }, [props.wallet.walletAuth])\n  const formatAddress = (address) => {\n    return address ? address.substr(0, 6) + \"...\" + address.substr(-4) : null;\n  };\n  const logoutUser = () => {\n    props.logoutUser();\n    history.push(\"/login\");\n  };\n\n  return (\n    <header id=\"header\">\n      <div className=\"container header\">\n        {/* Navbar */}\n        <nav\n          data-aos=\"zoom-out\"\n          data-aos-delay={800}\n          className=\"navbar navbar-expand\"\n        >\n          {/* Navbar Brand*/}\n          <Link className=\"navbar-brand\" to=\"/\">\n            <img\n              className=\"navbar-brand-sticky\"\n              src={MintsClubLogo}\n              alt=\"sticky brand-logo\"\n            />\n          </Link>\n          <div className=\"ml-auto\" />\n          {/* Navbar */}\n          <ul className=\"navbar-nav items mx-auto\">\n            <li className=\"nav-item dropdown\">\n              <Link className=\"nav-link\" to=\"/\">\n                Home\n              </Link>\n            </li>\n            <li className=\"nav-item dropdown\">\n              <a className=\"nav-link\">\n                Explore <i className=\"fas fa-angle-down ml-1\" />\n              </a>\n              <ul className=\"dropdown-menu\">\n                <li className=\"nav-item\">\n                  <Link to=\"/explore-all\" className=\"nav-link\">\n                    Explore\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/auctions\" className=\"nav-link\">\n                    Live Auctions\n                  </Link>\n                </li>\n                {/* <li className=\"nav-item\"><Link to=\"/item-details\" className=\"nav-link\">Item Details</Link></li> */}\n              </ul>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/activity\" className=\"nav-link\">\n                Activity\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/collections\" className=\"nav-link\">\n                Collections\n              </Link>\n            </li>\n            {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Community <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/blog\" className=\"nav-link\">Blog</a></li>\n                                <li className=\"nav-item\"><a href=\"/blog-single\" className=\"nav-link\">Blog Single</a></li>\n                                <li className=\"nav-item\"><a href=\"/help-center\" className=\"nav-link\">Help Center</a></li>\n                            </ul>\n                        </li> */}\n            {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Pages <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/authors\" className=\"nav-link\">Authors</a></li>\n                                <li className=\"nav-item\"><a href=\"/author\" className=\"nav-link\">Author</a></li>\n                                <li className=\"nav-item\"><a href=\"/wallet-connect\" className=\"nav-link\">Wallet Connect</a></li>\n                                <li className=\"nav-item\"><a href=\"/create\" className=\"nav-link\">Create</a></li>\n                                <li className=\"nav-item\"><a href=\"/login\" className=\"nav-link\">Login</a></li>\n                                <li className=\"nav-item\"><a href=\"/signup\" className=\"nav-link\">Signup</a></li>\n                            </ul>\n                        </li> */}\n            <li className=\"nav-item\">\n              <Link to=\"/contact\" className=\"nav-link\">\n                Contact\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/history\" className=\"nav-link\">\n                History\n              </Link>\n            </li>\n          </ul>\n          {/* Navbar Icons */}\n          <ul className=\"navbar-nav icons\">\n            <li className=\"nav-item\">\n              <a\n                href=\"#\"\n                className=\"nav-link \"\n                data-toggle=\"modal\"\n                data-target=\"#search\"\n              >\n                <i className=\"fas fa-search\" />\n              </a>\n            </li>\n          </ul>\n          {/* Navbar Toggler */}\n          <ul className=\"navbar-nav toggle\">\n            <li className=\"nav-item\">\n              <a\n                href=\"#\"\n                className=\"nav-link\"\n                data-toggle=\"modal\"\n                data-target=\"#menu\"\n              >\n                <i className=\"fas fa-bars toggle-icon m-0\" />\n              </a>\n            </li>\n          </ul>\n          {/* Navbar Action Button */}\n          <ul className=\"navbar-nav action\">\n            <li className=\"nav-item ml-3\">\n              {connectedAddress && _id ? (\n                <button\n                  className=\"btn ml-lg-auto btn-linear-gradient\"\n                  onClick={logoutUser}\n                >\n                  <i className=\"icon-logout mr-md-2\" /> Logout\n                </button>\n              ) : (\n                // <span id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />{formatAddress(connectedAddress)}</span>\n                <Link\n                  to=\"/login\"\n                  id=\"wallet-address\"\n                  className=\"btn ml-lg-auto btn-linear-gradient\"\n                >\n                  {/* <i className=\"icon-wallet mr-md-2\" /> */}\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  Login\n                </Link>\n              )}\n            </li>\n          </ul>\n        </nav>\n      </div>\n    </header>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n});\nexport default connect(mapStateToProps, {\n  setWalletAddress,\n  getWalletAddress,\n  logoutUser,\n})(Header);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore-items.js",["838","839","840","841","842","843","844"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nimport NftCard from '../collections/components/NftCard/NftCard'\nconst initData = {\n    btn_1: \"Load More\",\n}\n\nfunction ExploreItems(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n\n    useEffect(() => {\n        // get NFTs for explore section\n        const nftQS = { page: 1, limit: 4, explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }, [])\n\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            if (nftsData) {\n                setNFTs(nftsData.nfts)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n                setLoader(false)\n                if (props.setView)\n                    props.setViewAll(nftsData.nfts && nftsData.nfts.length > 0)\n            }\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n\n        // get more NFTs for explore section\n        const nftQS = { page: 1, limit: limit * (page + 1), explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n    return (\n        <>\n            {/* <div className={`row items ${props.class1 ? props.class1 : ''} ${!nfts.length ? 'justify-content-center' : ''}`}> */}\n            <div className=\"row\">\n            <div className=\"row justify-content-center mt-5 w-100\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                {/* <span>{initData.pre_heading}</span> */}\n                                <span>Explore</span>\n                                {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                                    <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                            </div>\n                        </div>\n                    </div>\n\n                {\n                    props.nfts && props.nfts.length > 0 ?\n                        props.nfts.map((item, idx) => {\n                            return (\n                                \n                                // <div key={`${props.key}_${idx}`} className={`col-12 col-sm-6 col-lg-3 item d-block ${props.class2 ? props.class2 : ''}`}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <Link to=\"/author\">\n                                //                         <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6>\n                                //                     </Link>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     {/* <span>{item.sold} of {item.copies}</span> */}\n                                //                 </div>\n                                //                 {/* <Link className=\"btn btn-bordered-white btn-smaller mt-3\" to=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</Link> */}\n                                //             </div>http://3.142.91.8/authorshttp://3.142.91.8/authors\n                                //         </div>\n                                //     </div>\n                                // </div>\n                                     \n                      <>\n                     \n                                     <div className=\"col-4 mt-5\">\n                                     <NftCard/>\n                                     </div>\n\n                                     </>\n                              \n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Explore</p>\n                }  </div>\n            {/* </div> */}\n            {\n                props.loadMoreBtn &&\n                <div className=\"row\">\n                    <div className=\"col-12 text-center\">\n                        <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                    </div>\n                </div>\n            }\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs })(ExploreItems);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.js",["845","846","847"],"import React, {\r\n  useState,\r\n  useEffect,\r\n  forwardRef,\r\n  useImperativeHandle,\r\n} from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeCollection, getCollections } from \"./collections.actions\";\r\nconst { collectionFeaturedImg, userDefaultImg } = ENV;\r\n\r\nconst Collections = forwardRef((props, ref) => {\r\n  const [collections, setCollections] = useState(null);\r\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    if (props.source) setSource(props.source);\r\n\r\n    if (props.setLoader) props.setLoader(false); //to be changed\r\n\r\n    getCollections();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.collection.getAuth) {\r\n      const { collections } = props.collection;\r\n      const userId = ENV.getUserKeys(\"_id\")._id;\r\n      if (props.mycollections) {\r\n        let myCollections = collections.filter(\r\n          (item) => item.userId === userId\r\n        );\r\n        setCollections(myCollections);\r\n      } else {\r\n        setCollections(collections);\r\n      }\r\n      props.beforeCollection();\r\n      if (props.setLoader) props.setLoader(false);\r\n    }\r\n  }, [props.collection.getAuth]);\r\n\r\n  const getCollections = (categoryId = null) => {\r\n    const filter = {\r\n      page: 1,\r\n    };\r\n    if (categoryId) filter.categoryId = categoryId;\r\n\r\n    if (props.userId) filter.userId = props.userId;\r\n\r\n    if (props.popular) filter.popular = true;\r\n\r\n    // if not all then apply limit\r\n    if (!props.all) filter.limit = props.limit ? props.limit : 8;\r\n    else filter.all = true;\r\n\r\n    const qs = ENV.objectToQueryString(filter);\r\n    props.getCollections(qs);\r\n  };\r\n\r\n  useImperativeHandle(ref, () => ({\r\n    getCatCollections: (catId) => {\r\n      if (props.setLoader) props.setLoader(true);\r\n\r\n      getCollections(catId);\r\n    },\r\n    colCount: collections?.length || 0,\r\n  }));\r\n\r\n  const dummyCollections = [\r\n    {\r\n      id: 1,\r\n      name: \"Modern Art collection\",\r\n      itemNos: \"5\",\r\n      owner: \"Abcd\",\r\n    },\r\n    {\r\n      id: 2,\r\n      name: \"Modern Art collection\",\r\n      itemNos: \"5\",\r\n      owner: \"Abcd\",\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <div className=\"popular-collections-area\">\r\n      <div className=\"container\">\r\n        <div\r\n          className={`row items ${!collections && \"justify-content-center\"}`}\r\n        >\r\n          <>\r\n            {/* {collections && collections.length ? (\r\n              collections.map((item, idx) => { */}\r\n            {dummyCollections && dummyCollections.length ? (\r\n              dummyCollections.map((item, idx) => {\r\n                return (\r\n                  <div\r\n                    key={`cd_${idx}`}\r\n                    className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                  >\r\n                    <div className=\"card no-hover text-center\">\r\n                      <div className=\"image-over\">\r\n                        <Link\r\n                          to={`/collection-details/${window.btoa(item._id)}`}\r\n                        >\r\n                          <img\r\n                            className=\"card-img-top\"\r\n                            src={\r\n                              item.featuredImg\r\n                                ? item.featuredImg\r\n                                : collectionFeaturedImg\r\n                            }\r\n                            alt=\"Collection Featured Image\"\r\n                          />\r\n                        </Link>\r\n                        <Link\r\n                          className=\"seller\"\r\n                          to={\r\n                            source === 1\r\n                              ? `/collection-details/${window.btoa(item._id)}`\r\n                              : `/author/${item.user._id}`\r\n                          }\r\n                        >\r\n                          <div className=\"seller-thumb avatar-lg\">\r\n                            <img\r\n                              className=\"rounded-circle\"\r\n                              src={\r\n                                source === 1\r\n                                  ? item.logo\r\n                                  : item.user.profilePhoto\r\n                                  ? item.user.profilePhoto\r\n                                  : userDefaultImg\r\n                              }\r\n                              alt={\r\n                                source === 1 ? \"Collection Logo\" : \"User Avatar\"\r\n                              }\r\n                            />\r\n                          </div>\r\n                        </Link>\r\n                      </div>\r\n                      <div className=\"card-caption col-12 p-0\">\r\n                        <div className=\"card-body mt-4\">\r\n                          <Link\r\n                            to={`/collection-details/${window.btoa(item._id)}`}\r\n                          >\r\n                            <h5 className=\"mb-2\">{item.name}</h5>\r\n                          </Link>\r\n                          <span>\r\n                            {item.category\r\n                              ? item.category.name\r\n                              : \"Category: N/A\"}\r\n                          </span>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                );\r\n              })\r\n            ) : (\r\n              <div className=\"col-12\">\r\n                <p className=\"text-center mt-4\">No Collection Found</p>\r\n              </div>\r\n            )}\r\n          </>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n});\r\n\r\nconst mapStateToProps = (state) => ({\r\n  collection: state.collection,\r\n  error: state.error,\r\n});\r\n\r\nexport default connect(\r\n  mapStateToProps,\r\n  { beforeCollection, getCollections },\r\n  null,\r\n  { forwardRef: true }\r\n)(Collections);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/bids/bids.action.js",["848","849"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body,tokenId,price,toAddress,fromAddress) => dispatch => {\n    alert(\"in herer\")\n    // dispatch(emptyError());\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n    //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n           \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    // if (qs)\n    //     url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/PropertyModal.js",["850"],"import React, {useState} from \"react\";\nimport AddBtnImage from \"../../../../assets/images/Add Button.svg\";\nimport PropertiesModal from \"../../../../components/PropertiesModal/ProppertiesModal\";\nconst PropertyModal = (props)=>{\n// debugger\n  const [open, setOpen] = useState(false);\n  const handleOpen = () => setOpen(true);\n  const handleClose = () => setOpen(false);\n    return(\n      <>\n        <img\n          src={AddBtnImage}\n          onClick={() => handleOpen()}\n          className=\"ml-3\"\n          style={{ height: \"1.5rem\", cursor: \"pointer\" }}\n        />\n        <PropertiesModal\n        open={open}\n        handleOpen={handleOpen}\n        handleClose={handleClose}\n        propertiesValues={JSON.parse(JSON.stringify(props.propertiesValues))}\n        onSubmit={props.onSubmit}\n      />\n      </>\n    )\n}\nexport default PropertyModal;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/LevelsModal.js",["851"],"import React, {useState} from \"react\";\nimport AddBtnImage from \"../../../../assets/images/Add Button.svg\";\nimport LevelsModal from \"../../../../components/LevelsModal/LevelsModal\";\nconst LevelModal = (props)=>{\n\nconst [openLevelModal, setOpenLevelModal] = useState(false);\n\n  const handleOpenLevel = () => setOpenLevelModal(true);\n  const handleCloseLevel = () => setOpenLevelModal(false);\n    return(\n      <>\n        <img\n          src={AddBtnImage}\n          onClick={() => handleOpenLevel()}\n          className=\"ml-3\"\n          style={{ height: \"1.5rem\", cursor: \"pointer\" }}\n        />\n        {/* <PropertiesModal\n        open={open}\n        handleOpen={handleOpen}\n        handleClose={handleClose}\n        propertiesValues={JSON.parse(JSON.stringify(props.propertiesValues))}\n        onSubmit={props.onSubmit}\n      /> */}\n      <LevelsModal\n        open={openLevelModal}\n        handleOpen={handleOpenLevel}\n        handleClose={handleCloseLevel}\n        levelsInputs={props.levels}\n        onSubmitLevels={props.onSubmitLevels}\n      />\n      </>\n    )\n}\nexport default LevelModal;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/infoComp.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/actions/actions.js",["852","853","854","855"],"import { toast } from 'react-toastify';\nimport Web3 from 'web3';\nimport {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  // DEPLOY_CONTRACT,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS,\n  SET_OTP_EMAIL\n} from '../types/types';\n\nimport { ENV } from '../../config/config';\nimport { connectMetamaskCopy } from '../../utils/web3';\nimport axios from 'axios';\nimport dotenv from 'dotenv';\nexport const currentStepAction = () => (dispatch) => {\n  // alert(\"called\")\n\n  dispatch({\n    type: CURRENT_STEP,\n  });\n};\nexport const currentStepDecrement = () => (dispatch) => {\n  dispatch({\n    type: CURRENT_STEP_DECREMENT,\n  });\n};\nexport const clearCurrentStep = () => (dispatch) => {\n  dispatch({\n    type: CLEAR_CURRENT_STEP,\n  });\n};\n\nexport const contractResponse = () => (dispatch) => {\n  dispatch({\n    type: CONTRACT_REPONSE,\n  });\n};\nexport const setProperties = (data) => (dispatch) => {\n  // alert(\"callled\")\n  dispatch({\n    type: SET_PROPERTIES,\n    payload: data,\n  });\n};\nexport const setLevels = (data) => (dispatch) => {\n  dispatch({\n    type: SET_LEVELS,\n    payload: data,\n  });\n};\nexport const setOtpEmail=(data)=>(dispatch)=>{\n  dispatch({\n    type: SET_OTP_EMAIL,\n    payload: data,\n  });\n}\n\nexport const sendOtp = (data) => (dispatch) => {\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/sendVerficationEmail`;\n\n  axios.post(url, data, config).then(\n    (res) => {\n      //  alert(\"email sent\")\n      // console.log(res);\n      if (res.status === 200) {\n        //  toast.success(\"Otp Verification Code sent to \")\n      }\n    },\n    (err) => {\n      console.log(err, 'error');\n      alert('error while sending email');\n    }\n  );\n};\nfunction msToTime(ms) {\n  let seconds = (ms / 1000).toFixed(1);\n  let minutes = (ms / (1000 * 60)).toFixed(1);\n  let hours = (ms / (1000 * 60 * 60)).toFixed(1);\n  let days = (ms / (1000 * 60 * 60 * 24)).toFixed(1);\n  if (seconds < 60) return seconds + ' Sec';\n  else if (minutes < 60) return minutes + ' Min';\n  else if (hours < 24) return hours + ' Hrs';\n  else return days + ' Days';\n}\n\nexport const verifyOtp = (email, otp) => (dispatch) => {\n  let data = {\n    email,\n    otp,\n  };\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/verify`;\n  console.log(url);\n\n  axios.post(url, data, config).then(\n    (res) => {\n      console.log(res,\"res\")\n      if(res.data.email){\n\n        if(res.data.email!==email){\n          toast.error('Invalid Email or OTP');\n          return \" \"\n        }\n      }\n\n    if(res.data.status==false){\n      toast.error(res.data.message);\n      return \" \"\n    }\n\n      if (res.data.status === true) {\n        \n        setOtpEmail(res.data.data[0].email)\n        if (res.data.diffMins < -10) {\n          toast.error('Token is  Expired ,Please resend token & try again');\n          return ' ';\n        } else {\n          toast.success(res.data.message);\n      \n          dispatch({\n            type: SET_OTP_STATUS,\n            payload: true,\n          });\n        }\n      }\n      else {\n        // console.log(\"error\")\n        toast.error(res.data.message);\n      }\n    },\n    (err) => {\n     toast.error(\"Invalid OTP or Email\")\n    }\n  );\n};\n\nexport const deployContract = (data, address, supply) => (dispatch) => {\n\n\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/createUser`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then(\n      (res) => {\n        // console.log(res, \"response from backendfdkfd\");\n        const abi = res.data.data.abi;\n        if (res.data.status === true) {\n          let metaDataList = [];\n\n          for (let i = 1; i <= supply; i++) {\n            metaDataList.push(res.data.data.metaData);\n            dispatch({\n              type: SET_CONTRACT_INFO,\n              payload: res.data,\n            });\n          }\n\n          try {\n            const web3 = new Web3(Web3.givenProvider);\n            // const gasPrice = \"5000000\";\n            let contract = new web3.eth.Contract(abi, null, {\n              data: res.data.data.bytecode,\n\n              from: address,\n              // gas: 4600000,\n            });\n            contract\n              .deploy({\n                data: res.data.data.bytecode,\n                arguments: [res.data.data.name, res.data.data.symbol],\n              })\n              .send({\n                from: address,\n                // gas: gasPrice,\n              })\n              .then((contractInstance) => {\n                toast.success('Contract Deployed Successfully!');\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n\n                let info = {\n                  ...res.data,\n                  contractAddress: contractInstance.options.address,\n                };\n                dispatch({\n                  type: SET_CONTRACT_INFO,\n                  payload: {\n                    data: { ...info },\n                  },\n                });\n                dispatch({\n                  type: CONTRACT_ADDRESS,\n                  payload: contractInstance.options.address,\n                });\n                const contractData = {\n                  contractadd: contractInstance.options.address,\n                  Network: 'Etherium',\n                  Deployed: true,\n                };\n\n                dispatch({\n                  type: CONTRACT_REPONSE,\n                  payload: contractData,\n                });\n              })\n              .catch((err) => {\n                // console.log(\"error\", err);\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n                toast.error('Transaction Failed please check wallet history!');\n              });\n          } catch (err) {\n            dispatch({\n              type: LOADER,\n              payload: false,\n            });\n            toast.error('Transaction Failed please check wallet history!');\n          }\n        } else {\n          dispatch({\n            type: LOADER,\n            payload: false,\n          });\n          // console.log(res, \"dkfjdkfjkdjfkd\");\n          toast.error(res.data.data);\n\n          // dispatch({\n          //   type: CONTRACT_REPONSE,\n          //   payload: res.data,\n          // });\n        }\n        // console.log(res);\n      },\n      (error) => {\n        // console.log(error, 'error handle');\n        toast.error(error.response.data.data);\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        // console.log(error, \"error==dfjdkf\");\n        dispatch({\n          type: CONTRACT_ERROR_MESSAGE,\n          payload: error,\n        });\n        // alert(\"contract response\")\n        // dispatch({\n        //   type: CONTRACT_REPONSE,\n        //   payload: error,\n        // });\n        // resolve(error)\n      }\n    )\n    .catch((err) => {\n      console.log(err, 'error later==>');\n    });\n};\n\nexport const mintToken = (data, address, supply, email) => (dispatch) => {\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n  // console.log('here is data', data)\n  dispatch({\n    type: CONNECT_WELLET,\n    payload: address,\n  });\n  let metaDataList = [];\n  // console.log(data, \"data=====>\");\n  let metaData = '';\n  if (!data.data) {\n    metaData = data;\n  } else {\n    metaData = data.data.metaData;\n  }\n\n  for (let i = 1; i <= supply; i++) {\n    metaDataList.push(metaData);\n  }\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n  // console.log(\"metaDataList\", metaDataList);\n\n  try {\n    const web3 = new Web3(Web3.givenProvider);\n    // console.log('web3', web3);\n    const contractM = new web3.eth.Contract(\n      data.data.abi,\n      data.contractAddress\n    );\n    // console.log(\"metaDataList\", metaDataList);\n    contractM.methods\n      .batchMint(address, metaDataList, supply)\n      .send({\n        from: address,\n        // gas: 5000000,\n      })\n      .then((response) => {\n        // console.log(response, \"res of createNFT===>\");\n        handleEmailRequest(email);\n        let count = localStorage.getItem(address);\n        if (count) {\n          console.log(typeof (+count * 1), 'issueee');\n          localStorage.setItem(address, +count * 1 + 1);\n        } else {\n          localStorage.setItem(address, 1);\n        }\n        toast.success('Minting Successful');\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        dispatch({\n          type: TOKEN_ID,\n          payload: response,\n        });\n        dispatch({\n          type: MINTING_RESPONSE,\n          payload: response,\n        });\n      })\n      .catch((err) => {\n        console.log(err, 'error==>');\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        toast.error('Transaction Failed please check wallet history!');\n      });\n  } catch (err) {\n    dispatch({\n      type: LOADER,\n      payload: false,\n    });\n    toast.error('Transaction Failed please check wallet history!');\n  }\n};\nconst handleEmailRequest = (email) => {\n  let data = {\n    email,\n  };\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/addEmail`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then((res) => {\n      // console.log(res, \"email response==>\");\n    })\n    .catch((err) => console.log(err));\n};\nexport const setContractInfo = () => (dispatch) => {\n  dispatch({\n    type: SET_CONTRACT_INFO,\n  });\n};\n\nexport const connectWallet = () => (dispatch) => {\n  connectMetamaskCopy()\n    .then((address) =>\n      // console.log(address,\"address\"),\n      dispatch({\n        type: CONNECT_WELLET,\n        payload: address,\n      })\n    )\n    .catch((err) => console.log(err, 'error'));\n};\n\nexport const hometest = () => (dispatch) => {\n  // dispatch({\n  // type:HOME_TEST,\n  // payload: data\n  // })\n  // dispatch(emptyError());\n  // const url = `${ENV.url}/nfts/${type}`;\n  // fetch(url, {\n  // method,\n  // headers: {\n  // 'Authorization': ENV.Authorization,\n  // 'x-auth-token': ENV.x_auth_token,\n  // 'Access-Control-Allow-Origin': '*',\n  // 'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  // },\n  // body\n  // }).then(res => res.json()).then(data => {\n  // if (data.success) {\n  // toast.success(data.message)\n  // dispatch({\n  // type: UPSERT_NFT,\n  // payload: data\n  // })\n  // } else {\n  // toast.error(data.message)\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: data\n  // })\n  // }\n  // }).catch(error => {\n  // if (error.response && error.response.data) {\n  // const { data } = error.response\n  // if (data.message)\n  // toast.error(data.message)\n  // }\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: error\n  // })\n  // })\n};\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["856","857"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.properties\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"500px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white mt-0\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 7.95rem\"\n                    : \"7.95rem\"\n                }`,\n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" style={{ width: \"558px\" }} key={i}>\n                      <div className=\"row\">\n                        <div\n                          className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1\"\n                          key={i}\n                        >\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <input\n                              className=\"step3-input mt-2 \"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              placeholder=\"Name\"\n                              value={item.name || \"\"}\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29 !important\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n\n                        <div className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1 ml-0 ml-md-4\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{\n                                fontSize: \"1.2rem\",\n                                fontWeight: \"bold\",\n                              }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <div className=\"d-flex align-items-center w-100\">\n                              <input\n                                className=\"step3-input  mt-2\"\n                                type=\"text\"\n                                name=\"value\"\n                                onChange={(e) => handleChange(i, e)}\n                                placeholder=\"Value\"\n                                value={item.value || \"\"}\n                                maxLength=\"30\"\n                                autoComplete=\"off\"\n                                style={{\n                                  backgroundColor: \"#000e29 \",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                              <BsFillXCircleFill\n                                className=\"ml-1 ml-sm-2\"\n                                style={{\n                                  color: \"#00d3f3\",\n                                  top: \"3rem\",\n                                  left: \"13.8rem\",\n                                  cursor: \"pointer\",\n                                }}\n                                onClick={() => removeFormFields(i)}\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <p\n              className=\" mt-4 ml-4\"\n              style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n              onClick={() => addMoreValues()}\n            >\n              {\" \"}\n              Add Property\n            </p>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-2 mt-md-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   propertiesValues && propertiesValues?.length > 0\n                //     ? false\n                //     : true\n                // }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["858","859","860"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(props.levelsInputs);\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage, setErrorMessage] = React.useState(\"\");\n  const [validate, setValidate] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues.splice(i, 1);\n    setlevelsInputs(newFormValues);\n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total === \"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\");\n        return \"\";\n      }\n      if (+item.value > +item.total) {\n        alert(\"inside\");\n        setError(true);\n        setValidate(true);\n        setErrorMessage(\"Value should be less then total!\");\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n  //  const handleValue=(item)=>{\n  //    if(item.value > item.total){\n\n  //      setError(true)\n  //      return true\n  //    }\n  //    return false\n  //  }\n  //  const handleTotal=(item)=>{\n\n  //  }\n  // console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"550px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 mx-auto justify-content-center\">\n              <div className=\"d-flex\">\n                <img\n                  src={LevelsImage}\n                  alt={\"levels\"}\n                  style={{ height: \"2rem\" }}\n                />\n                <p\n                  className=\"text-white\"\n                  style={{\n                    fontSize: \"1.3rem\",\n                    fontWeight: \"bold\",\n                    marginLeft: \"1rem\",\n                  }}\n                >\n                  Add Levels\n                </p>\n              </div>\n            </div>\n            {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Levels show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n            <form onSubmit={handleSubmit}>\n              <div\n                className=\"row levels-scroll p-3 \"\n                style={{\n                  height: `${\n                    levelsInputs && levelsInputs.length > 0\n                      ? \"8.3rem\"\n                      : \"7.3rem\"\n                  }`,\n                }}\n              >\n                {levelsInputs &&\n                  levelsInputs.length > 0 &&\n                  levelsInputs.map((item, i) => {\n                    return (\n                      <div\n                        className=\"row\"\n                        key={i}\n                        style={{\n                          marginBottom: `${\n                            levelsInputs && levelsInputs.length > 1\n                              ? \"12px\"\n                              : \"0\"\n                          }`,\n                        }}\n                      >\n                        <div className=\"col-10 col-sm-6 mt-2 \" key={i}>\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            <input\n                              className=\"step3-input mt-3 name-inp\"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              value={item.name || \"\"}\n                              placeholder=\"Name\"\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 mt-2\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                            <div className=\"values-total-inp w-100\">\n                              <input\n                                className={`step3-input first-value mt-3 values-inp ${\n                                  validate && item.value > item.total\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min=\"1\"\n                                max={\n                                  item.total == \"0\"\n                                    ? \"1\"\n                                    : item.total\n                                    ? item.total\n                                    : \"1\"\n                                }\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.value || \"\"}\n                                placeholder=\"Value\"\n                                autoComplete=\"off\"\n                                name=\"value\"\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n\n                              <p className=\"text-white mb-0 value-label mt-3\">\n                                Of\n                              </p>\n                              <input\n                                className={`step3-input first-value values-inp mt-3 ${\n                                  validate && item.total < item.value\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min={item.value ? item.value : \"1\"}\n                                max=\"9999\"\n                                name=\"total\"\n                                placeholder=\"Total\"\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.total || \"\"}\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                            </div>\n                            <BsFillXCircleFill\n                              className=\"position-absolute levels-cross-icon\"\n                              style={{\n                                color: \"#00d3f3\",\n                                top: \"3rem\",\n                                right: \"-1rem\",\n                                cursor: \"pointer\",\n                              }}\n                              onClick={() => removeFormFields(i)}\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                <div className=\"W-100 text-center\"></div>\n              </div>\n              <p\n                className=\" col-8 mt-4\"\n                style={{\n                  color: \"#00d3f3\",\n                  cursor: \"pointer\",\n                  marginLeft: \"0.8rem\",\n                }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n\n              <div className=\"w-100 text-center\">\n                <button\n                  type=\"submit\"\n                  className=\"btn btn-secondary start-btn mt-5 text-center\"\n                  style={{ width: \"9rem\" }}\n                  // disabled={\n                  //   levelsInputs && levelsInputs?.length > 0\n                  //     ? false\n                  //     : true\n                  // }\n                  // onClick={() => {\n                  //   handleSubmit()\n                  // }}\n                >\n                  Save\n                </button>\n              </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["861","862"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\nimport Modal from \"@mui/material/Modal\";\nimport { AiOutlineClose } from \"react-icons/ai\";\nimport { BiArrowBack } from \"react-icons/bi\";\n\nimport \"./PreviewModal.css\";\nimport { maxWidth } from \"@mui/system\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 830,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n};\n\nconst genStyle = {\n  row: {\n    display: \"grid\",\n  },\n};\n// let array = [1];\n\nconst PreviewModal = (props) => {\n  // console.log(props,\"props\")\n  const {\n    previewModal,\n    handlePreviewModal,\n    previewModalStep,\n    handlePreviewModalSteps,\n    onDeploy,\n    info,\n  } = props;\n  const handleNextStep = () => {\n    if (previewModalStep === 1) {\n      handlePreviewModalSteps(\"next\");\n    } else {\n      onDeploy();\n    }\n  };\n  // console.log(props,\"props\")\n  return (\n    <div>\n      <Modal\n        open={previewModal}\n        onClose={handlePreviewModal}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"preview-modal-container pt-4 px-1 px-md-5\">\n            <div className=\"w-100 d-flex justify-content-between \">\n              {previewModalStep > 1 ? (\n                <BiArrowBack\n                  className=\"text-white \"\n                  style={{\n                    fontSize: \"1.8rem\",\n                    cursor: \"pointer\",\n                  }}\n                  onClick={() => handlePreviewModalSteps(\"back\")}\n                />\n              ) : (\n                <span></span>\n              )}\n              <AiOutlineClose\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.8rem\",\n                  cursor: \"pointer\",\n                }}\n                onClick={() => handlePreviewModal()}\n              />\n            </div>\n\n            {previewModalStep === 1 ? (\n              <div className=\"row  preview-modal-info\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text \">Preview</p>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div className=\"previewModal-img\">\n                    {info.img && (\n                      <img\n                        src={info.img ? info.img : \"\"}\n                        className=\"mt-3\"\n                        style={{\n                          width: \"100%\",\n                          height: \"100%\",\n                          borderRadius: \"10px\",\n                          objectFit: \"contain\",\n                        }}\n                        alt=\"preview\"\n                      />\n                    )}\n                    {info.videoUrl && (\n                      <video className=\"preview-video-view mt-3\" controls>\n                        <source src={info.videoUrl} />\n                      </video>\n                    )}\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white external-label ml-0 my-2 ml-0\">\n                      External Link\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"url\"\n                      value={\n                        (info.externalLink && info.externalLink.trim()) ||\n                        \"- externalLink -\"\n                      }\n                      placeholder=\"- externalLink -\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label mb-2 ml-0\">\n                      Name\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={info.name || \"\"}\n                      placeholder=\"name\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Email\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"email\"\n                      value={info.email || \"\"}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Symbol\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={\n                        (info.symbol && info.symbol.trim()) || \"- symbol -\"\n                      }\n                      placeholder=\"- symbol -\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Description\n                    </label>\n                    <textarea\n                      className=\"p-3 mt-1 w-100 externalLink-input\"\n                      placeholder=\"- Description -\"\n                      value={\n                        (info.description && info.description.trim()) ||\n                        \"- Description -\"\n                      }\n                      style={{\n                        color: \"#aaabab\",\n                        marginLeft: \"2rem\",\n                        margin: \"0\",\n                        width: \"100%\",\n                      }}\n                      maxLength=\"600\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Supply\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"number\"\n                      value={info.supply || \"- supply -\"}\n                      disabled={true}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      placeholder=\"- supply -\"\n                      maxLength=\"50\"\n                    />\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\" preview-modal-info rowCust\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text mb-3\">Preview</p>\n                </div>\n\n                <p className=\"text-white font-weight-bold preview-properties-title \">\n                  Properties{\" \"}\n                </p>\n\n                <div\n                  className=\"rowCust px-3 mb-3\"\n                  style={{\n                    overflowY: \"auto\",\n                    height: \"5.1rem\",\n                    overflowX: \"hidden\",\n                  }}\n                >\n                  {props.properties && props.properties.length > 0 ? (\n                    props.properties.map((item, index) => {\n                      return (\n                        <div\n                          className=\"row justify-content-between\"\n                          key={index}\n                        >\n                          <div className=\"col-12  col-md-6\" key={index}>\n                            <label\n                              className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                              for=\"preview-name\"\n                            >\n                              Name\n                            </label>\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.name || \"\"}\n                              maxLength=\"50\"\n                              placeholder=\"item name\"\n                              disabled={true}\n                              id=\"preview-name\"\n                            />\n                          </div>\n\n                          <div className=\"col-12 col-md-6 pr-lg-0\">\n                            <label\n                              className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                              for=\"preview-value\"\n                            >\n                              Value\n                            </label>\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.value || \"\"}\n                              placeholder=\"Value\"\n                              maxLength=\"50\"\n                              disabled={true}\n                              id=\"preview-value\"\n                            />\n                          </div>\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center\" style={{ color: \"#A9A9A9\" }}>\n                      {\"No Properties Found\"}\n                    </p>\n                  )}\n                </div>\n                <div className=\"previewdivider ml-3\"></div>\n                {/* ////////////////////////////////////////////// */}\n                <div className=\"mt-3\">\n                  <p className=\"text-white font-weight-bold preview-levels-title\">\n                    Levels{\" \"}\n                  </p>\n                  <div\n                    className=\"rowCust px-3\"\n                    style={{\n                      overflowY: \"auto\",\n                      overflowX: \"hidden\",\n                      height: \"5.1rem\",\n                    }}\n                  >\n                    {props.levels && props.levels.length > 0 ? (\n                      props.levels.map((item, index) => {\n                        return (\n                          <div className=\"row\" key={index}>\n                            <div className=\"col-12 col-md-6 \" key={index}>\n                              <label\n                                className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                                for=\"preview-name\"\n                              >\n                                Name\n                              </label>\n                              <input\n                                className=\"preview-input-step-2 value-input-preview w-100\"\n                                type=\"url\"\n                                value={item.name || \"\"}\n                                placeholder=\"Levels\"\n                                style={{\n                                  marginTop: `${\n                                    index === 0 ? \"0rem\" : \"1.2rem\"\n                                  }`,\n                                  maxWidth: \"90%\",\n                                }}\n                                // maxLength=\"50\"\n                                disabled={true}\n                              />\n                            </div>\n\n                            <div className=\"col-12 col-md-6 \">\n                              <label\n                                className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                                for=\"preview-name\"\n                              >\n                                Value\n                              </label>\n                              <div\n                                className=\"d-flex align-items-center justify-content-between ml-3 preview-modal-value-2\"\n                                style={{\n                                  marginTop: `${\n                                    index === 0 ? \"0rem\" : \"1.2rem\"\n                                  }`,\n                                  width: \"93%\",\n                                }}\n                              >\n                                <input\n                                  className=\"preview-modal-step\"\n                                  type=\"number\"\n                                  pattern=\"[0-9]+\"\n                                  // maxlength=\"4\"\n                                  value={item.value || \"\"}\n                                  placeholder=\"Value\"\n                                  name=\"value\"\n                                  disabled={true}\n                                  style={{\n                                    padding: \"0.6rem 1rem\",\n                                    width: \"45%\",\n                                  }}\n                                />\n\n                                <p className=\"text-white mb-0 mx-2\">Of</p>\n                                <input\n                                  className=\"preview-modal-step\"\n                                  type=\"number\"\n                                  min=\"1\"\n                                  max=\"5\"\n                                  name=\"total\"\n                                  placeholder=\"total\"\n                                  disabled={true}\n                                  // onInput=\"javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);\"\n                                  value={item.total || \"\"}\n                                  style={{\n                                    padding: \"0.6rem 1rem\",\n                                    width: \"45%\",\n                                  }}\n                                />\n                              </div>\n                            </div>\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\" text-center\" style={{ color: \"#A9A9A9\" }}>\n                        {\"No levels Found\"}\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            )}\n            <div className=\"w-100 text-center\">\n              <p className=\"text-white my-3\">{previewModalStep}/2</p>\n              {previewModalStep > 1 && props.maxLimit && (\n                <p className=\"text-danger\">\n                  {\"Maximum deployment limit reached,Please contact support\"}\n                </p>\n              )}\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary preview-btn mb-3\"\n                disabled={props.maxLimit && previewModalStep > 1 ? true : false}\n                onClick={() => handleNextStep()}\n              >\n                {previewModalStep === 1 ? \"Next\" : \"Deploy\"}\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nexport default PreviewModal;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/components/NftCard/NftCard.js",["863","864"],"import react from \"react\";\nimport { Link } from \"react-router-dom\";\nimport \"./NftCard.css\";\n\nconst NftCard = (props) => {\n  const filterCreator = (nft) => {\n    const result = props.creators.find((item) => item._id === nft.nftOwnerId);\n    if (result?.username) {\n      return result?.username;\n    } else {\n      return \"no username found\";\n    }\n  };\n  const { userId, nft } = props;\n  return (\n    <div className=\"NftCard-Container \">\n      <Link to={`/item-details?item=${window.btoa(props.nft._id)}`}>\n        <img\n          src={\n            props?.nft?.image ? props.nft.image : \"https://picsum.photos/200\"\n          }\n          alt=\"testinImage\"\n          className=\"nft-car-img\"\n        />\n      </Link>\n\n      <div className=\"NftCard-description p-3\">\n        <p className=\"mb-0 text-white\">\n          {props?.nft?.name ? props.nft.name : \"someTHing\"}\n        </p>\n        <p className=\"text-white\">Owned By: {filterCreator(props.nft)}</p>\n        <div className=\"d-flex w-100 justify-content-between\">\n          <p className=\"mb-0 text-white\">\n            {props?.nft?.currentPrice ? props.nft.currentPrice : \"0.04\"}\n          </p>\n          <p className=\"mt-0 text-white\">\n            {props?.nft?.sold ? props.nft.sold : \"0\"} out of {props.nft.copies}\n          </p>\n        </div>\n        <div className=\"py-3\">\n          <Link\n            to={`/item-details?item=${window.btoa(props.nft._id)}`}\n            id=\"wallet-address\"\n            className=\"btn ml-lg-auto btn-bordered-white\"\n          >\n            <i className=\"icon-wallet mr-md-2\" />\n            {nft.nftOwnerId === userId\n              ? \"Sell NFT\"\n              : nft.sellingMethod === undefined\n              ? \"NFT Details\"\n              : nft.nftOwnerId !== userId && nft.sellingMethod == 1\n              ? \"Buy Now\"\n              : \"Place a Bid\"}\n          </Link>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default NftCard;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step2/Step2.js",["865","866"],"import { useState } from \"react\";\nimport \"./Step2.css\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport { toast } from \"react-toastify\";\nimport InfoComp from \"../../infoComp\";\nimport { ProgressBar } from \"react-bootstrap\";\n\nconst Step2 = (props) => {\n  // console.log(props,\"props in step 2\")\n  const [name, setName] = useState(props.name);\n  const [symbol, setSymbol] = useState(props.symbol);\n  const [externalLink, setExternalLink] = useState(props.externalLink);\n  const [description, setDescription] = useState(props.description);\n  const [supply, setSupply] = useState(props.supply);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [error, setError] = useState(false);\n  const [linkError, setLinkError] = useState(false);\n\n  const dataDescription = {\n    name: \"Name of NFT contract\",\n    supply: \"Number of NFTs to mint\",\n    externalLink: \"Link of NFT details page\",\n    symbol: \"Symbol of NFT contract\",\n    description: \"Description of NFT\",\n  };\n\n  const patternValidation = (val) => {\n    return /\\s/g.test(val);\n  };\n\n  const httpValidation = (val) => {\n    return /https|http:\\/\\/.*.com/g.test(val);\n  };\n\n  const onChangeName = (e) => {\n    if (!name) {\n      if (patternValidation(e.target.value.trimStart())) {\n        e.preventDefault();\n      } else {\n        setName(e.target.value.trimStart());\n      }\n    } else {\n      setName(e.target.value.trimStart());\n    }\n  };\n\n  const onChangeSymbol = (e) => {\n    if (!symbol) {\n      if (patternValidation(e.target.value.trimStart())) {\n        e.preventDefault();\n      } else {\n        setSymbol(e.target.value.trimStart());\n      }\n    } else {\n      setSymbol(e.target.value.trimStart());\n    }\n  };\n\n  const onChangeExternalLink = (e) => {\n    const { value } = e.target;\n    if (value && value.length > 0) {\n      setLinkError(false);\n      setExternalLink(value.trimStart());\n    } else {\n      setExternalLink(value);\n    }\n  };\n\n  const onChangeDescription = (e) => {\n    if (!description) {\n      if (patternValidation(e.target.value.trimStart())) {\n        e.preventDefault();\n      } else {\n        setDescription(e.target.value.trimStart());\n      }\n    } else {\n      setDescription(e.target.value.trimStart());\n    }\n  };\n\n  const onChangeSupply = (e) => {\n    setSupply(e.target.value);\n  };\n\n  const onSubmit = (e) => {\n    let validatePointer = true;\n    e.preventDefault();\n    // console.log(name, \"name==>\");\n    if (name.trim() === \"\") {\n      setErrorMessage(\"Please Fill required fields!\");\n      toast.error(\"Please Fill required fields!\");\n      setName(\"\");\n      setError(true);\n      validatePointer = false;\n      return \"\";\n    }\n    // console.log(name.trim().length <3)\n    if (name.trim().length < 3) {\n      setErrorMessage(\"Name should have atleast 3 characters\");\n      toast.error(\"Name should have atleast 3 characters.\");\n      validatePointer = false;\n      setError(true);\n      return \" \";\n    }\n    // if (externalLink) {\n    //   // /(http(s)?:\\/\\/.)?(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{2,256}\\.[a-z]{2,6}\\b([-a-zA-Z0-9@:%_\\+.~#?&//=]*)/g\n    //   if (\n    //     !externalLink.match(\n    //       /^(http[s]?:\\/\\/){0,1}(w{3,3}\\.)[-a-z0-9+&@#\\/%?=~_|!:,.;]*[-a-z0-9+&@#\\/%=~_|]/\n    //     )\n    //   ) {\n    //     // alert(\"external link must be a valid uri\")\n    //     validatePointer = false;\n    //     setLinkError(true);\n    //     toast.error(\"Please provide a valid Url.\");\n    //     return \"\";\n    //   }\n    // }\n    // console.log(name,\"nmae\")\n    if (validatePointer) {\n      props.handleStep2Info(name, symbol, externalLink, description, supply);\n      props.currentStepAction();\n    }\n  };\n  return (\n    <div className=\"step2-container \" style={{ marginBottom: \"14%\" }}>\n      <form onSubmit={onSubmit}>\n        <div className=\"row\">\n          <div className=\"col-md-6 col-sm-12\">\n            <div className=\"d-flex\" style={{ color: \"red\" }}>\n              {error && errorMessage}{\" \"}\n            </div>\n            <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n              <div className=\"position-relative\">\n                <label className=\"text-white step-2-label\">\n                  Name <InfoComp text={dataDescription.name} />\n                </label>\n                <p\n                  className=\"position-absolute required-field\"\n\n                  style={{ color: \"red\", bottom: \"-6px\", left: \"52px\" }}\n                >\n                  *\n                </p>\n              </div>\n              <input\n                className=\"step-2-input mt-2\"\n                type=\"text\"\n                // pattern=\"[a-zA-Z]*\"\n                onChange={(e) => onChangeName(e)}\n                value={name}\n                placeholder=\"item name\"\n                // required={true}\n                maxLength=\"50\"\n                minLength=\"3\"\n              />\n            </div>\n\n            <div className=\"d-flex mt-4\" style={{ flexDirection: \"column\" }}>\n              <label className=\"text-white step-2-label \">\n                Symbol <InfoComp text={dataDescription.symbol} />\n              </label>\n\n              {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              {\" \"}\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n              <input\n                className=\"step-2-input mt-2\"\n                type=\"text\"\n                onChange={(e) => onChangeSymbol(e)}\n                value={symbol}\n                placeholder=\"NFT Symbol\"\n                maxLength=\"50\"\n              />\n            </div>\n\n            <div className=\"d-flex  mt-4\" style={{ flexDirection: \"column\" }}>\n              <label className=\"text-white step-2-label\">\n                External Link <InfoComp text={dataDescription.externalLink} />\n              </label>\n\n              {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n              {/* <p style={{color:\"red\"}}>{linkError &&\"External Link must be a valid Url\"}</p> */}\n              <input\n                className=\"step-2-input mt-1\"\n                type=\"url\"\n                onChange={(e) => onChangeExternalLink(e)}\n                value={externalLink}\n                placeholder=\"https://yousite.com/item.1004\"\n                maxLength=\"50\"\n              />\n            </div>\n          </div>\n\n          <div className=\"col-md-6 col-sm-12 mt-5 mt-md-0\">\n            <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n              <label className=\"text-white step-2-label\">\n                Supply <InfoComp text={dataDescription.supply} />\n              </label>\n              <p className=\"mb-0\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n                The number of copies that can be minted{\" \"}\n              </p>\n              <input\n                className=\"step-2-input mt-2\"\n                type=\"number\"\n                onChange={(e) => onChangeSupply(e)}\n                value={supply}\n                placeholder=\"supply\"\n                max=\"100\"\n                min=\"1\"\n              />\n              {/* <select\n              className=\"form-select mt-2 network-dropdown\"\n              style={{\n                color: \"white\",\n                border: \"none\",\n                outline: \"none\",\n                maxWidth: \"22rem\",\n              }}\n              aria-label=\"Default select example\"\n              value={supply}\n              onChange={(e) => onChangeSupply(e)}\n            >\n              <option className=\"network-option\" value=\"1\" defaultValue={\"1\"}>\n                1\n              </option>\n              <option className=\"network-option\" value=\"2\">\n                2\n              </option>\n              <option className=\"network-option\" value=\"3\">\n                3\n              </option>\n              <option className=\"network-option\" value=\"4\">\n                4\n              </option>\n              <option className=\"network-option\" value=\"5\">\n                5\n              </option>\n            </select> */}\n            </div>\n            {/* //////////////////////// */}\n            <div className=\"d-flex  mt-4\" style={{ flexDirection: \"column\" }}>\n              <label className=\"text-white step-2-label\">\n                Description <InfoComp text={dataDescription.description} />\n              </label>\n\n              {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n              <textarea\n                className=\"description p-3 mt-2\"\n                placeholder=\"Add Description\"\n                onChange={onChangeDescription}\n                value={description}\n                style={{ color: \"white\" }}\n                maxLength=\"600\"\n              />\n            </div>\n          </div>\n          <div className=\"col-md-6 col-sm-12 mt-5 mt-md-0\">\n            <button\n              type=\"submit\"\n              className=\"btn btn-secondary start-btn mt-5\"\n              // onClick={() => onSubmit()}\n            >\n              Next\n            </button>\n          </div>\n          <div\n            className=\"progress-bar-custom\"\n            style={{ width: \"64%\", margin: \"3rem auto 0 auto\" }}\n          >\n            <ProgressBar\n              className={`${\n                props.currentStep === 4\n                  ? \"progress-bar-green\"\n                  : \"progress-bar-yellow\"\n              }`}\n              now={props.currentStep * 25}\n            />\n            <p className=\"text-white text-center mt-2\">{props.currentStep}/4</p>\n          </div>\n        </div>\n      </form>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step2);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step1/Step1.js",["867","868","869"],"import { useState, useEffect } from \"react\";\nimport \"./Step1.css\";\n// import { RiFolderUploadLine} from \"react-icons/ri\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport { BsImageFill } from \"react-icons/bs\";\nimport uploadIcon from \"../../../../assets/images/uploadIcon.png\";\nimport { connect } from \"react-redux\";\nimport { BsUpload } from \"react-icons/bs\";\nimport { MdClose } from \"react-icons/md\";\nimport { Grid, IconButton, Typography } from \"@mui/material\";\nimport { ProgressBar } from \"react-bootstrap\";\nimport VideoView from \"../../../../components/videoComponent/videoComponent\";\n\nconst Step1 = (props) => {\n  const [file, setFile] = useState(\"\");\n  const [img, setImage] = useState(props.imageURl);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [videoUrl, setVideoUrl] = useState(props.videoURL);\n  // console.log(process.env,\"config.baseurl===>\")\n\n  useEffect(() => {\n    // console.log(videoUrl);\n  }, [videoUrl]);\n  const onFileChange = (event) => {\n    setErrorMessage(\"\");\n\n    if (event.target.files[0]) {\n      // console.log(event.target.files[0], \"event.target.files[0]==>\");\n\n      let type = event.target.files[0].type;\n      // console.log(type,\"typee\")\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\"\n      ) {\n        let fileSize = formatBytes(event.target.files[0].size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          setErrorMessage(\"File size limit is exceeded\");\n        } else {\n          let url = URL.createObjectURL(event.target.files[0]);\n          if (event.target.files[0].type === \"video/mp4\") {\n            setVideoUrl(url);\n            setImage(\"\");\n          } else {\n            setImage(url);\n            setVideoUrl(\"\");\n            // console.log(formatBytes(event.target.files[0].size).split(' ') ,\"event.target.files[0]==>\")\n            setFile(event.target.files[0]);\n          }\n        }\n        if (\n          type === \"image/jpeg\" ||\n          type === \"image/png\" ||\n          type === \"image/gif\" ||\n          type === \"video/mp4\"\n        ) {\n          let fileSize = formatBytes(event.target.files[0].size).split(\" \");\n          if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n            setErrorMessage(\"File size limit is exceeded\");\n          } else {\n            let url = URL.createObjectURL(event.target.files[0]);\n            if (event.target.files[0].type === \"video/mp4\") {\n              setVideoUrl(url);\n              setImage(\"\");\n            } else {\n              setImage(url);\n              setVideoUrl(\"\");\n              // console.log(formatBytes(event.target.files[0].size).split(' ') ,\"event.target.files[0]==>\")\n              setFile(event.target.files[0]);\n            }\n          }\n        } else {\n          setErrorMessage(\"File not supported!\");\n        }\n      } else {\n        setErrorMessage(\"File not supported!\");\n      }\n    }\n  };\n  function formatBytes(bytes, decimals = 2) {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  }\n\n  // On file upload (click the upload button)\n  const onFileUpload = () => {\n    if (img === \"\" && videoUrl === \"\") {\n      setErrorMessage(\"Please upload a file\");\n      return \"\";\n    }\n    // console.log(file);\n    props.handleStep1Info(file, videoUrl, img);\n    props.currentStepAction();\n  };\n  const dragOver = (e) => {\n    e.preventDefault();\n  };\n\n  const dragEnter = (e) => {\n    e.preventDefault();\n  };\n\n  const dragLeave = (e) => {\n    e.preventDefault();\n  };\n  const onDrop = (e) => {\n    // alert(\"onDrag video\")\n\n    e.preventDefault();\n    setErrorMessage(\"\");\n    setVideoUrl(\"\");\n    const files = e.dataTransfer.files[0];\n    if (files) {\n      const type = e.dataTransfer.files[0].type;\n      console.log(files);\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\"\n      ) {\n        let fileSize = formatBytes(files.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          setErrorMessage(\"File size limit is exceeded\");\n        } else {\n          let url = URL.createObjectURL(files);\n          if (files.type === \"video/mp4\") {\n            setVideoUrl(url);\n            props.handleStep1Info(file, videoUrl, img);\n\n            // setTimeout(()=>{\n\n            //   // setVideoUrl(url);\n            // },1000)\n            setImage(\"\");\n          } else {\n            setImage(url);\n            setVideoUrl(\"\");\n            // console.log(formatBytes(e.target.files[0].size).split(' ') ,\"e.target.files[0]==>\")\n            setFile(files);\n          }\n        }\n      } else {\n        setErrorMessage(\"File not supported!\");\n      }\n    }\n  };\n\n  const removeVideo = (event) => {\n    event.preventDefault();\n    event.stopPropagation();\n    setVideoUrl(\"\");\n  };\n\n  const removeImage = (event) => {\n    event.preventDefault();\n    event.stopPropagation();\n    setImage(\"\");\n  };\n\n  return (\n    <>\n      <p className=\"text-white upload-img-title mb-1\">Upload Asset</p>\n      <p\n        className=\"text-white testingkkk \"\n        style={{ fontSize: \"14px\", padding: \"0rem\", margin: \"0rem\" }}\n      >\n        File type supported:JPEG/PNG/GIF/MP4 max size 100 MB.{\" \"}\n      </p>\n\n      <Grid container style={{ justifyContent: \"space-between\" }}>\n        <Grid item md={6}>\n          {videoUrl && (\n            <div\n              className=\"position-relative video-container\"\n              onDrop={(e) => onDrop(e)}\n              onDragOver={(e) => dragOver(e)}\n              onDragEnter={(e) => dragEnter(e)}\n              onDragLeave={(e) => dragLeave(e)}\n            >\n              <VideoView videoUrl={videoUrl} />\n\n              <MdClose\n                color=\"#e33d0bc2\"\n                className=\"\"\n                onClick={removeVideo}\n                style={{\n                  fontSize: \"2.5rem\",\n                  cursor: \"pointer\",\n                  top: \"28px\",\n                  right: \"2rem\",\n                  position: \"absolute\",\n                  zIndex: 99,\n                }}\n              />\n            </div>\n          )}\n          {!img ? (\n            <>\n              {!videoUrl && !img && (\n                <>\n                  <label\n                    className=\"text-center d-flex mt-2\"\n                    style={{ cursor: \"pointer\", maxWidth: \"25rem\" }}\n                  >\n                    <div\n                      className=\"file-container text-white d-flex justify-content-center align-items-center mt-2 mb-5\"\n                      onDrop={(e) => onDrop(e)}\n                      onDragOver={(e) => dragOver(e)}\n                      onDragEnter={(e) => dragEnter(e)}\n                      onDragLeave={(e) => dragLeave(e)}\n                    >\n                      <div\n                        className=\"d-flex h-100 justify-content-center align-items-center \"\n                        style={{ flexDirection: \"column\", cursor: \"pointer\" }}\n                      >\n                        {/* <RiFolderUploadLine className=\"upload-icon\" /> */}\n                        <img className=\"upload-icon mb-3\" src={uploadIcon} />\n\n                        <p\n                          style={{\n                            color: \"#aaabab\",\n                            fontSize: \"14px\",\n                            margin: \"0rem\",\n                          }}\n                        >\n                          Add photo or video <br /> or Drag and drop\n                        </p>\n                        <input\n                          type=\"file\"\n                          style={{ display: \"none\" }}\n                          onChange={onFileChange}\n                          accept=\".mp4, .png,.jpeg\"\n                        />\n                      </div>\n                    </div>\n                  </label>\n                  <p style={{ color: \"red\" }}>{errorMessage && errorMessage}</p>\n                  <div\n                    onDrop={(e) => onDrop(e)}\n                    onDragOver={(e) => dragOver(e)}\n                    onDragEnter={(e) => dragEnter(e)}\n                    onDragLeave={(e) => dragLeave(e)}\n                    className=\"mb-4\"\n                  >\n                    <label>\n                      <div\n                        className=\"d-flex align-items-center justify-content-center mb-3\"\n                        style={{\n                          backgroundColor: \"#001d43\",\n                          width: \"13.2rem\",\n                          height: \"3rem\",\n                          borderRadius: \"10px\",\n                          cursor: \"pointer\",\n                        }}\n                      >\n                        <BsUpload\n                          style={{ fontSize: \"1.4rem\", color: \"white\" }}\n                        />\n                      </div>\n                      <input\n                        type=\"file\"\n                        style={{ display: \"none\" }}\n                        onChange={onFileChange}\n                        accept=\".mp4, .png,.jpeg\"\n                        onDrop={(e) => onFileChange(e)}\n                        onDragOver={(e) => onFileChange(e)}\n                        onDragEnter={(e) => onFileChange(e)}\n                        onDragLeave={(e) => onFileChange(e)}\n                      />\n                    </label>\n                  </div>\n                </>\n              )}\n              {videoUrl && (\n                <>\n                  <p className=\"mb-0 mt-4\" style={{ color: \"red\" }}>\n                    {errorMessage && errorMessage}\n                  </p>\n                  <div\n                    onDrop={(e) => onDrop(e)}\n                    onDragOver={(e) => dragOver(e)}\n                    onDragEnter={(e) => dragEnter(e)}\n                    onDragLeave={(e) => dragLeave(e)}\n                  >\n                    <label>\n                      <div\n                        className=\"d-flex align-items-center justify-content-center mb-5 my-4\"\n                        style={{\n                          backgroundColor: \"#001d43\",\n                          width: \"13.2rem\",\n                          height: \"3rem\",\n                          borderRadius: \"10px\",\n                          cursor: \"pointer\",\n                        }}\n                      >\n                        <BsUpload\n                          style={{ fontSize: \"1.4rem\", color: \"white\" }}\n                        />\n                      </div>\n                      <input\n                        type=\"file\"\n                        style={{ display: \"none\" }}\n                        onChange={onFileChange}\n                        accept=\".mp4, .png,.jpeg\"\n                        onDrop={(e) => onFileChange(e)}\n                        onDragOver={(e) => onFileChange(e)}\n                        onDragEnter={(e) => onFileChange(e)}\n                        onDragLeave={(e) => onFileChange(e)}\n                      />\n                    </label>\n                  </div>\n                </>\n              )}\n            </>\n          ) : (\n            <>\n              <div\n                className=\"text-white d-flex  mt-4 mb-5\"\n                onDrop={(e) => onDrop(e)}\n                onDragOver={(e) => dragOver(e)}\n                onDragEnter={(e) => dragEnter(e)}\n                onDragLeave={(e) => dragLeave(e)}\n              >\n                <label className=\"text-center position-relative label-parent\">\n                  <MdClose\n                    color=\"#e33d0bc2\"\n                    className=\"\"\n                    onClick={removeImage}\n                    style={{\n                      fontSize: \"2.5rem\",\n                      cursor: \"pointer\",\n                      top: 0,\n                      right: 0,\n                      position: \"absolute\",\n                      zIndex: 99,\n                    }}\n                  />\n                  <img\n                    className=\"selected-file \"\n                    src={img}\n                    alt=\"uploaded image\"\n                    style={{ cursor: \"pointer\" }}\n                  />\n\n                  <BsImageFill\n                    className=\"position-absolute upload-img-icon\"\n                    style={{ fontSize: \"1.2rem\", cursor: \"pointer\" }}\n                  />\n                  <input\n                    type=\"file\"\n                    style={{ display: \"none\" }}\n                    onChange={onFileChange}\n                    accept=\".mp4, .png,.jpeg\"\n                  />\n                </label>\n              </div>\n\n              <p style={{ color: \"red\" }}>{errorMessage && errorMessage}</p>\n              <div\n                onDrop={(e) => onDrop(e)}\n                onDragOver={(e) => dragOver(e)}\n                onDragEnter={(e) => dragEnter(e)}\n                onDragLeave={(e) => dragLeave(e)}\n                className=\"mb-4\"\n              >\n                <label>\n                  <div\n                    className=\"d-flex align-items-center justify-content-center mb-3\"\n                    style={{\n                      backgroundColor: \"#001d43\",\n                      width: \"13.2rem\",\n                      height: \"3rem\",\n                      borderRadius: \"10px\",\n                      cursor: \"pointer\",\n                    }}\n                  >\n                    <BsUpload style={{ fontSize: \"1.4rem\", color: \"white\" }} />\n                  </div>\n                  <input\n                    type=\"file\"\n                    style={{ display: \"none\" }}\n                    onChange={onFileChange}\n                    accept=\".mp4, .png,.jpeg\"\n                    onDrop={(e) => onFileChange(e)}\n                    onDragOver={(e) => onFileChange(e)}\n                    onDragEnter={(e) => onFileChange(e)}\n                    onDragLeave={(e) => onFileChange(e)}\n                  />\n                </label>\n              </div>\n            </>\n          )}\n        </Grid>\n\n        <Grid item md={5} className=\"d-none d-md-block\">\n          <Typography className=\"text-white\" textAlign=\"justify\">\n            <strong>Do you know? </strong>\n            10% of the world’s GDP will be tokenized by 2027. Source: World\n            Economic Forum InvoBlox is your biggest cheerleader and empowers you\n            to become part of the 24$ trillion token industry for FREE! Let’s be\n            partners and create the digital awesomeness the world awaits …\n            (What’s your plan?)\n          </Typography>\n        </Grid>\n      </Grid>\n\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary start-btn mt-5 mt-md-3 mt-lg-0\"\n        onClick={() => onFileUpload()}\n      >\n        Next\n      </button>\n      <div\n        className=\"progress-bar-custom\"\n        style={{ width: \"64%\", margin: \"4rem auto 0 auto\" }}\n      >\n        <ProgressBar\n          className={`${\n            props.currentStep === 4\n              ? \"progress-bar-green\"\n              : \"progress-bar-yellow\"\n          }`}\n          now={props.currentStep * 25}\n        />\n        <p className=\"text-white text-center mt-2\">{props.currentStep}/4</p>\n      </div>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step1);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collection-preview.js",["870","871"],"import React from 'react';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV\n\nconst CollectionPreview = ({ collection }) => {\n    return (\n        <>\n            <div className=\"card no-hover text-center \">\n                <div className=\"image-over\">\n                    <div>\n                        <img className=\"card-img-top\" src={collection.featuredImg ? collection.featuredImg : collectionFeaturedImg} alt=\"Collection Featured Image\" />\n                    </div>\n                    <div className=\"seller\">\n                        <div className=\"seller-thumb avatar-lg\">\n                            <img className=\"rounded-circle\" src={collection.logo} alt='Collection Logo' />\n                        </div>\n                    </div>\n                </div>\n                <div className=\"card-caption col-12 p-0\">\n                    <div className=\"card-body mt-4\">\n                        <div>\n                            <h5 className=\"mb-2\">{collection.name}</h5>\n                            <p className=\"mb-2\">\n                                {\n                                    collection.url ?\n                                        <div className=\"input-group\">\n                                            <input type=\"text\" className=\"form-control\" placeholder=\"Collection URL\" readOnly value={collection.url} />\n                                            <div className=\"input-group-append\" style={{ zIndex: 888 }}>\n                                                <button className=\"btn mr-0\"><i className=\"icon-docs\" /></button>\n                                            </div>\n                                        </div>\n                                        : ('URL: N/A')\n                                }\n                            </p>\n                            <p className=\"mb-2\">{collection.description ? collection.description : 'Description: N/A'}</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div className=\"row items\">\n                <div className=\"col-12 px-0 mt-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <img className=\"avatar-md rounded-circle\" src={collection.category?.image || categoryDefaultImg} alt=\"Category Image\" />\n                            <div className=\"seller-info ml-3\">\n                                <div className=\"seller\">{collection.category?.name || 'N/A'}</div>\n                                <span>Category</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"col-12 px-0 my-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <Link to=\"/author\">\n                                <img className=\"avatar-md rounded-circle\" src={collection.user?.profilePhoto || userDefaultImg} alt=\"User Avatar\" />\n                            </Link>\n                            <div className=\"seller-info ml-3\">\n                                <Link className=\"seller mb-2\" to=\"/author\">{collection.user?.username}</Link>\n                                <span>Creator</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default CollectionPreview;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/filter-search/filtersearch.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/author-profile/author-profile.js",["872","873","874","875","876"],"import React, { useEffect } from 'react';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst AuthorProfile = (props) => {    \r\n    useEffect(()=> {\r\n\r\n    },[])\r\n    return (\r\n        <div className=\"card-wrapper\">\r\n       <div className=\"card no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.profileImage ? props.profileImage: ENV.globalPlaceholderImage} alt=\"User Profile\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body mt-4\">\r\n                    <h5 className=\"mb-3\">{props.username}</h5>\r\n                    <p className=\"my-3\">{props.description}</p>\r\n                    <div className=\"input-group\">\r\n                        <input type=\"text\" className=\"form-control\" placeholder=\"0x000000000000000000\" readOnly value={props.address}/>\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"social-icons d-flex justify-content-center my-3\">\r\n                        {\r\n                            props.facebookLink && <a className=\"facebook\" href={props.facebookLink} target=\"_blank\">\r\n                                <i className=\"fab fa-facebook-f\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.twitterLink && <a className=\"twitter\" href={props.twitterLink} target=\"_blank\">\r\n                                <i className=\"fab fa-twitter\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.gPlusLink && <a className=\"google-plus\" href={props.gPlusLink} target=\"_blank\">\r\n                                <i className=\"fab fa-google-plus-g\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.vineLink && <a className=\"vine\" href={props.vineLink} target=\"_blank\">\r\n                                <i className=\"fab fa-vine\" />\r\n                            </a>\r\n                        }\r\n                    </div>\r\n                    {\r\n                        props.followText &&\r\n                        <a className=\"btn btn-bordered-white btn-smaller\" href=\"#\">{props.followText}</a>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </div>\r\n        </div>\r\n \r\n    );\r\n}\r\nexport default AuthorProfile;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.js",["877","878"],"import { useState, useEffect } from 'react';\r\nimport { connect } from \"react-redux\";\r\nimport { beforeFaq, getFaqs } from \"./faq.action\"\r\n\r\nconst Faq = (props) => {\r\n\r\n    const [data, setData] = useState(null)\r\n\r\n    useEffect(() => {\r\n        props.getFaqs()\r\n     \r\n    }, [])\r\n\r\n    useEffect(() =>{\r\n        if(props.faqs.faqsAuth){\r\n            const {faqs} = props.faqs.faqs\r\n            setData(faqs)\r\n        }\r\n    }, [props.faqs.faqsAuth])\r\n\r\n    return (\r\n        <section className=\"faq-area\">\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>{\"FAQ\"}</span>\r\n                            <h3 className=\"mt-3 mb-0\">{\"Frequently Asked Questions\"}</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12\">\r\n                        {/* FAQ Content */}\r\n                        <div className=\"faq-content\">\r\n                            {/* Netstorm Accordion */}\r\n                            <div className=\"accordion\" id=\"netstorm-accordion\">\r\n                                <div className=\"row justify-content-center\">\r\n                                    <div className=\"col-12 col-md-10\">\r\n                                        {/* Single Accordion Item */}\r\n                                        {data ? data.map((item, idx) => {\r\n                                            return (\r\n                                                <div key={`fd_${idx}`} className=\"single-accordion-item p-3\">\r\n                                                    {/* Card Header */}\r\n                                                    <div className=\"card-header bg-inherit border-0 p-0\">\r\n                                                        <h2 className=\"m-0\">\r\n                                                            <button className={\"btn d-block text-left w-100 collapsed py-4\"} type=\"button\" data-toggle=\"collapse\" data-target={`#helpOption-${idx}`}>\r\n                                                                {item.title}\r\n                                                            </button>\r\n                                                        </h2>\r\n                                                    </div>\r\n                                                    <div id={`helpOption-${idx}`} className={\"collapse\"} data-parent=\"#netstorm-accordion\">\r\n                                                        {/* Card Body */}\r\n                                                        <div className=\"card-body py-3\" dangerouslySetInnerHTML={{__html: item.desc}}>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            );\r\n                                        }) : ''}\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = (state) => ({\r\n    faqs: state.faqs,\r\n    error: state.error,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeFaq, \r\n    getFaqs\r\n})(Faq);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/filter-search2/filtersearch2.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/help/help.js",["879"],"import React, { Component } from 'react';\r\n\r\nconst initData = {\r\n    pre_heading: \"Help Center\",\r\n    heading: \"How can we help you?\",\r\n    content: \"\"\r\n}\r\n\r\nconst data = [\r\n    {\r\n        id: \"1\",\r\n        icon: \"icon icon-plane text-effect\",\r\n        title: \"Getting Started\",\r\n        content: \"Learn how to create an account, set up your wallet, and what you can do on NetStorm\"\r\n    },\r\n    {\r\n        id: \"2\",\r\n        icon: \"icon icon-note text-effect\",\r\n        title: \"Creating\",\r\n        content: \"Learn how to create your very first NFT and how to create your NFT collections so you can begin selling and sharing\"\r\n    },\r\n    {\r\n        id: \"3\",\r\n        icon: \"icon icon-handbag text-effect\",\r\n        title: \"Buying\",\r\n        content: \"Learn how to purchase your first NFT and understand gas fees and what's gas free on NetStorm\"\r\n    },\r\n    {\r\n        id: \"4\",\r\n        icon: \"icon icon-chart text-effect\",\r\n        title: \"Selling\",\r\n        content: \"Learn how list your NFTs for sale and understand the different ways to list your NFTs\"\r\n    },\r\n    {\r\n        id: \"5\",\r\n        icon: \"icon icon-link text-effect\",\r\n        title: \"Partners\",\r\n        content: \"Learn how you can partner with us to showcase your NFT drops\"\r\n    },\r\n    {\r\n        id: \"6\",\r\n        icon: \"icon icon-flag text-effect\",\r\n        title: \"Developers\",\r\n        content: \"Learn how you can develop with NetStorm &amp; sell them on Marketplace\"\r\n    }\r\n]\r\n\r\nclass HelpCenter extends Component {\r\n    state = {\r\n        initData: {},\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        this.setState({\r\n            initData: initData,\r\n            data: data\r\n        })\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"help-center-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row justify-content-center\">\r\n                        <div className=\"col-12 col-md-8 col-lg-7\">\r\n                            {/* Intro */}\r\n                            <div className=\"intro text-center\">\r\n                                <span>{this.state.initData.pre_heading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                                <p>{this.state.initData.content}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"row justify-content-center items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`hd_${idx}`} className=\"col-12 col-md-6 col-lg-4 item\">\r\n                                    {/* Help Card */}\r\n                                    <div className=\"card help-card\">\r\n                                        <a className=\"d-block text-center\" href=\"#\">\r\n                                            <i className={item.icon} />\r\n                                            <h4>{item.title}</h4>\r\n                                            <p>{item.content}</p>\r\n                                        </a>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default HelpCenter;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/sidebar/sidebar.js",["880","881","882"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/sidebar\";\r\n\r\nclass Sidebar extends Component {\r\n    state = {\r\n        data: {},\r\n        widgetData_1: [],\r\n        widgetData_2: [],\r\n        widgetData_3: []\r\n    }\r\n    componentDidMount() {\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data,\r\n                    widgetData_1: res.data.widgetData_1,\r\n                    widgetData_2: res.data.widgetData_2,\r\n                    widgetData_3: res.data.widgetData_3\r\n                })\r\n            })\r\n            .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <aside className=\"col-12 col-lg-4 pl-lg-5 p-0 float-right sidebar\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12 align-self-center text-left\">\r\n                        {/* Widget [categories] */}\r\n                        <div className=\"item widget-categories\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_1}</h4>\r\n                            <ul className=\"list-group list-group-flush\">\r\n                                {this.state.widgetData_1.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdo_${idx}`} className=\"list-group-item d-flex justify-content-between align-items-center\">\r\n                                            <a href=\"#\">{item.title}</a>\r\n                                            <span className=\"badge circle\">{item.content}</span>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                        {/* Widget [tags] */}\r\n                        <div className=\"item widget-tags\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_2}</h4>\r\n                            {this.state.widgetData_2.map((item, idx) => {\r\n                                return (\r\n                                    <a key={`wdt_${idx}`} href=\"\" className=\"badge tag\">{item.title}</a>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                        {/* Widget [share-this] */}\r\n                        <div className=\"item widget-share-this\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_3}</h4>\r\n                            <ul className=\"navbar-nav social share-list\">\r\n                                {this.state.widgetData_3.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdth_${idx}`} className=\"nav-item\">\r\n                                            <a href=\"#\" className=\"nav-link\"><i className={item.icon} /></a>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </aside>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Sidebar;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/item-details/item-details.js",["883","884","885","886","887","888","889","890","891","892","893","894","895","896","897","898","899","900"],"import React, { Component } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport { Link } from 'react-router-dom';\r\nimport { beforeNFT, getNFT } from '../nfts/nfts.action';\r\nimport FullPageLoader from '../full-page-loader/full-page-loader'\r\nimport { ENV } from '../../config/config';\r\nimport moment from 'moment';\r\nimport Countdown from 'react-countdown';\r\nimport SimpleReactValidator from 'simple-react-validator'\r\nimport { decimalNumberValidator } from \"../../utils/functions\";\r\nimport { Container, Row, Col, Button, Modal } from \"react-bootstrap\";\r\nimport { beforeOffer, makeOffer, getOffers, deleteOffer, acceptOffer } from '../offers/offers.action'\r\nimport { beforeBid, placeBid, getBids, deleteBid, acceptBid } from '../bids/bids.action'\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {getCurrentAddress,BuyFixedPriceNFTs,placeBidNft,acceptNftOffer} from '../../utils/web3';\r\nimport { toast } from 'react-toastify'\r\nconst { globalPlaceholderImage, countDownRenderer, currencies, objectToQueryString } = ENV\r\n\r\nconst initData = {\r\n    itemImg: \"/img/auction_2.jpg\",\r\n    date: \"2022-03-30\",\r\n    price_2: \"$500.89\",\r\n    bidBtn: \"Place a Bid\",\r\n    offerBtn: \"Buy Now\",\r\n    sellBtn: \"Sell\"\r\n}\r\n\r\n// expiry options\r\n\r\nconst expiryOptions = [\r\n    { label: '5 Days', value: moment().add(5, \"days\").format('DD/MM/YYYY') },\r\n    { label: '7 Days', value: moment().add(7, \"days\").format('DD/MM/YYYY') },\r\n    { label: 'A Month', value: moment().add(1, \"months\").format('DD/MM/YYYY') },\r\n    { label: 'Custom Date', value: -1 },\r\n]\r\n\r\n// make an offer / bid config.\r\n\r\nconst config1 = {\r\n    price: {\r\n        currency: ENV.currency,\r\n        amount: \"\",\r\n    },\r\n    expiry: {\r\n        date: expiryOptions[0].value,\r\n        time: moment(new Date()).format(\"HH:mm\"),\r\n        type: 1, // 1 for time & 2 for datetime-local\r\n        datetime: '' // for payload \r\n    }\r\n};\r\nlet nft1=[]\r\nclass ItemDetails extends Component {\r\n    isTimeoutAction = false;\r\n    constructor(props) {\r\n        super(props)\r\n        this.state = {\r\n            userId: ENV.getUserKeys()?._id,\r\n            offers: null,\r\n            offersPagination: null,\r\n\r\n            bids: null,\r\n            bidsPagination: null,\r\n            highestBidAmtt:null,\r\n            errors: '',\r\n            isSubmitted: false,\r\n            formValid: true,\r\n            loader: true,\r\n            nft: null,\r\n            nftAll:null,\r\n            isOpen: false,\r\n            creator:[],\r\n            nftConfig: config1 ,// make an offer / bid config.\r\n            nftsData:[],\r\n            bidsData:[],\r\n            creators:[],\r\n            myAddress:''\r\n        }\r\n        this.validator = new SimpleReactValidator({\r\n            autoForceUpdate: this,\r\n            messages: {\r\n                required: 'This field is required.'  // will override all messages\r\n            },\r\n        });\r\n\r\n    }\r\n\r\n    componentDidMount= async()=> {\r\n        window.scroll(0, 0)\r\n        let myAddress=await getCurrentAddress()\r\n     \r\n        this.setState({\r\n            myAddress\r\n        })\r\n        const query = new URLSearchParams(window.location.search)\r\n        this.getTokens()\r\n       \r\n        if (query.get('item')) {\r\n        \r\n            const nftId = window.atob(query.get('item'))\r\n            // console.log(nftId,\"nftId====>\");\r\n            if (nftId) {\r\n                this.props.getNFT(nftId);\r\n                this.getBids(nftId)\r\n\r\n                const bidQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getBids(bidQS);\r\n\r\n                const offerQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getOffers(offerQS);\r\n                this.props.getCreators();\r\n            }\r\n        } else\r\n            this.props.history.push('/explore-all')\r\n    }\r\n\r\n    filterCreator=(nft)=>{\r\n     \r\n        // let nftId=this.state.nft.collection.userId\r\n    }\r\n    filterCreatorsInfo=(id,item)=>{\r\n      \r\n      let user= this.props.user?.creators?.find((item)=>item._id===id )\r\n      if(user){\r\n          if(item==\"username\"){\r\n             return user.username\r\n          }\r\n          if(item==\"profilePhoto\"){\r\n              return user?.profileImage\r\n          }\r\n          if(item==\"id\"){\r\n            return user._id\r\n          }\r\n      }\r\n    }\r\n\r\n    componentDidUpdate() {\r\n        // if (this.props.error)\r\n        //     this.setState({ loader: false })\r\n\r\n        if (this.props.nft.nftsAuth) {\r\n           \r\n            const nft = this.props.nft.nftsData\r\n            const allData=this.props.nft.nftAll\r\n           \r\n            //nft\r\n            nft1=nft\r\n            this.getBids(nft?._id)\r\n            this.setState({\r\n                \r\n                nft,\r\n            nftAll:allData\r\n                \r\n            }, () => {\r\n                this.props.beforeNFT()\r\n            })\r\n            this.filterCreator(nft)\r\n            const date1 = moment();\r\n            const date2 = moment(this.props?.nft?.nftAll?.sellingConfig?.duration?.endDate);\r\n           \r\n            // this.isTimeoutAction =  date2.diff(date1) > 0 ? false : true;\r\n            let result =  date2.diff(date1) > 0 ? false : true;\r\n            this.setState({\r\n                isTimeoutAction:result\r\n            })\r\n            // console.log(result,\"checking result\")\r\n        }\r\n\r\n        if (this.props.offer.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeOffer()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getOffers(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.getAuth) {\r\n            const { offers, pagination } = this.props.offer\r\n            this.setState({ loader: false, offers, offersPagination: pagination }, () => {\r\n                this.props.beforeOffer()\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.deleteAuth) {\r\n            this.props.beforeOffer()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getOffers(qs)\r\n        }\r\n\r\n        if (this.props.bid.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeBid()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getBids(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.getAuth) {\r\n         \r\n            const { bids, pagination, highestBidAmt } = this.props.bid\r\n        \r\n            let nft = { ...this.state.nft }\r\n\r\n            nft.highestBidAmt = highestBidAmt\r\n           \r\n            this.setState({ loader: false, bids, bidsPagination: pagination, nft }, () => {\r\n                this.props.beforeBid()\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.deleteAuth) {\r\n            this.props.beforeBid()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getBids(qs)\r\n        }\r\n\r\n        if (this.props.offer.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeOffer()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeBid()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n        //    console.log(this.props.user.topSellersAuth,\"kjkjkjlkjlkjkljlkjk\");\r\n\r\n        if(this.props.user.topSellersAuth && !this.state.creator?.length>0 ){\r\n            this.filterCreator(this.props.user.sellers)\r\n            this.setState({\r\n                creator:this.props.user.sellers,\r\n                creators:this.props.user.creators\r\n            })\r\n            // console.log(this.props.user.sellers,\"creators===}}}}}}}}}}}}}}}}}}}}}\");\r\n            // console.log(this.state.nft,\"nft below the creator===>\")\r\n        }\r\n        \r\n\r\n    }\r\n   \r\n    getBids=(nftId)=>{\r\n        const BASE_URL= process.env.REACT_APP_BASE_URL \r\n        fetch(BASE_URL + \"/bid/list\", {\r\n            method: 'GET',\r\n            headers: {\r\n                'content-type': 'application/json',\r\n                'Authorization': ENV.Authorization,\r\n                'x-auth-token': ENV.x_auth_token,\r\n                'Access-Control-Allow-Origin': '*',\r\n                'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n            }\r\n        }).then(res => res.json()).then(data => {\r\n       \r\n            let bids=data.data.allBids?.filter((item)=>item.nftId===nftId)          \r\n           \r\n            // const highestBidAmt = bids.length\r\n            var last_element = bids[bids?.length - 1];\r\n       \r\n            this.setState({\r\n                bidsData:bids,\r\n                highestBidAmtt: last_element?.price.amount\r\n\r\n            })\r\n            setTimeout(()=>{\r\n               this.setState({\r\n                   loader:false,\r\n               })\r\n            },2000)\r\n         \r\n        }).catch(error => {\r\n        console.log(error,\"error while getting bids\")\r\n           \r\n        })\r\n    }\r\n    openModal = () => {\r\n  \r\n        if(this.props?.nft?.nftAll.sellingMethod==1)\r\n        {\r\n            // console.log(\"inside if\")\r\n            var res= this.state.nftsData.data.find((item)=>item.nftId===this.state.nft._id)\r\n            // console.log(res,\"response\")               \r\n             // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n             this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n               this.setState({\r\n                   loader:false\r\n               })\r\n\r\n            }, 8000);\r\n          \r\n             BuyFixedPriceNFTs(this.props?.nft?.nftAll.currentPrice,res.nftToken,this.props.nft.nftAll._id)\r\n            \r\n        }\r\n        else {\r\n            // console.log(\"inside else\")\r\n            this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n        }\r\n      \r\n        // this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n    }\r\n\r\n    closeModal = () => this.setState({ isOpen: false });\r\n\r\n    onChange = (e) => {\r\n        const { nftConfig } = this.state;\r\n        const { name, value } = e.target;\r\n        let data = nftConfig;\r\n\r\n        const keys = name.split(\".\"); // nftConfig, price, currency\r\n        if (keys && keys[2])\r\n            data[keys[1]][keys[2]] = value;\r\n        else if (keys && keys[1])\r\n            data[keys[1]] = value;\r\n\r\n        if (keys && keys[1] === 'price' && keys[2] === 'amount')\r\n            data[keys[1]]['amount'] = Number(value)\r\n\r\n        if (keys && keys[1] === 'expiry' && keys[2] === 'date')\r\n            data[keys[1]]['type'] = Number(value) === -1 ? 2 : 1\r\n\r\n        // set datetime for days / months \r\n        if (data.expiry.type === 1)\r\n            data.expiry.datetime = moment(data.expiry.date + ' ' + data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n        // set datetime for custom date\r\n        else if (data.expiry.type === 2) {\r\n            data.expiry.datetime = moment(data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n            data.expiry.date = moment(data.expiry.time, 'DD/MM/YYYY')\r\n        }\r\n\r\n        this.setState({\r\n            nftConfig: {\r\n                ...data\r\n            }\r\n        })\r\n    };\r\n\r\n    // submit when a bid is placed or when an offer is made\r\n    submit = () => {\r\n    //   console.log(this.state.myAddress,\"myaddress\")\r\n\r\n        this.setState({ isSubmitted: true, formValid: this.validator.allValid() }, () => {\r\n            const { formValid } = this.state\r\n            if (formValid) {\r\n                this.setState({\r\n                    loader: false               //need to convert true\r\n                }, () => {\r\n                    const { nft, nftConfig,nftAll } = this.state\r\n           \r\n                    // console.log(nftAll,\"checking nft==>\")\r\n                    const payload = {\r\n                        // ownerId: nft.owner._id,\r\n                        expiryDate: nftConfig.expiry.datetime,\r\n                        price: nftConfig.price,\r\n                        nftId: nft._id,\r\n                        bidBy:ENV.getUserKeys('_id'),\r\n                        user:ENV.getUserKeys('_id'),\r\n                        offerById:ENV.getUserKeys('_id'),\r\n                        toAddress:nftAll.ownerAddress,\r\n                        fromAddress:this.state.myAddress,\r\n\r\n                    }\r\n                    // console.log(payload,\"toaddress8888888\")\r\n           \r\n                    let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                    // console.log('check here selling method',nft.sellingMethod )\r\n                    // if selling method is 2 then go for bid\r\n                    if (nft.sellingMethod === 2) { // place a bid \r\n                        placeBidNft(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        // this.props.placeBid(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        this.setState({\r\n                            loader:true\r\n                        })\r\n\r\n                        setTimeout(() => {\r\n                            this.setState({\r\n                                loader:false\r\n                            })\r\n                          \r\n                        }, 5000);\r\n                    } else if (nft.sellingMethod === 1) { // make an offer \r\n                       let res= this.state.nftsData.find((item)=>item.nftId===nft._id)\r\n                    //    console.log(res,\"response\")\r\n                             \r\n                        // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                        // BuyFixedPriceNFTs(payload.price,res.nftToken)\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                        // this.props.makeOffer(payload,foundResult,payload.price)\r\n                    }\r\n                    else{\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        // console.log('single nft before fix price function', nft)\r\n                        let res= this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                        // console.log(res,\"response\")\r\n                              \r\n                         // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                         BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                    }\r\n                })\r\n\r\n            }\r\n\r\n            else {\r\n                alert(\"in else\")\r\n                this.validator.showMessages()\r\n                this.validator.purgeFields()\r\n                this.setState({\r\n                    errors: 'Please fill all required fields in valid format.',\r\n                    formValid: false\r\n                }, () => {\r\n                    window.scroll(0, 0)\r\n                })\r\n            }\r\n            \r\n        })\r\n    }\r\n\r\n    deleteOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteOffer(offerId)\r\n        })\r\n    }\r\n\r\n    deleteBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteBid(bidId)\r\n        })\r\n    }\r\n\r\n    acceptOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.acceptBid({ offerId })\r\n        })\r\n\r\n    }\r\n\r\n    acceptBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            const { nft, nftConfig,nftAll } = this.state\r\n        \r\n            let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n  \r\n            const payload = {\r\n                bidId:bidId,\r\n                nftId: nft._id,\r\n                bidBy:ENV.getUserKeys('_id'),\r\n                user:ENV.getUserKeys('_id'),\r\n                toAddress:nftAll.ownerAddress,\r\n                fromAddress:this.state.myAddress,\r\n            }\r\n            this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n                this.setState({\r\n                    loader:false\r\n                })\r\n              \r\n            }, 7000);\r\n            acceptNftOffer(foundResult.nftToken,payload)\r\n            // this.props.acceptBid(payload,foundResult.nftToken)\r\n             \r\n        })\r\n       \r\n    }\r\n    creatorUserName=()=>{\r\n        // console.log(this.state.creator,\"creator listing\");/\r\n        // console.log(this.props.nftAll,\"this.props.nftAll?\");\r\n\r\n       let result= this.state.creator.find((item)=>item._id===this.state?.nftAll?.userId)\r\n    //    console.log(result,\"result in the userName function===>\");\r\n       if(result?.username)\r\n       {\r\n\r\n           return result.username\r\n       }\r\n       else {\r\n           return \"no username\"\r\n       }\r\n    }\r\n     getTokens=()=>{\r\n\r\n        let url = process.env.REACT_APP_BASE_URL + `nftTokens/tokens`;\r\n      \r\n        fetch(url, {\r\n         method: 'GET',\r\n         headers: {\r\n            'content-type': 'application/json',\r\n            'Authorization': ENV.Authorization,\r\n            'x-auth-token': ENV.x_auth_token,\r\n            'Access-Control-Allow-Origin': '*',\r\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n        },\r\n      \r\n      }).then(res => res.json()).then(data => {\r\n \r\n        //   console.log(data,\"data==>22222222222222222222222222222222222222\")\r\n      \r\n     this.setState({\r\n        nftsData:data\r\n     })\r\n      \r\n      }).catch(error => {\r\n        \r\n        console.log(error,\"error in catch blcok\")\r\n        \r\n      })\r\n    }\r\n    // filterCreatorsInfo=(id,item)=>{\r\n    //     // console.log(this.state.creators,\"creator in the filterCreatorsFunction\")\r\n    //   let user= this.state?.creators?.data?.find((item)=>item._id===id )\r\n    //   if(user){\r\n\r\n    //       if(item==\"username\"){\r\n    //          return user.username\r\n    //       }\r\n    //       if(item==\"profilePhoto\"){\r\n    //           return user?.profileImage\r\n    //       }\r\n    //       if(item==\"id\"){\r\n    //         return user._id\r\n    //       }\r\n    //   }\r\n      \r\n    // }\r\n\r\n    render() {\r\n        const { loader, nft, nftConfig, isSubmitted, errors, userId, bids, offers } = this.state\r\n        if(!ENV.getUserKeys('_id')._id){\r\n            toast.error(\"Pleas login to continue\")\r\n            this.props.history.push('/')\r\n               return \" \"\r\n           }\r\n           else {\r\n        return (\r\n            <>\r\n                <section className=\"item-details-area padding-wrapper pb-0\">\r\n                    {\r\n                        loader ?\r\n                            <FullPageLoader /> :\r\n                            <>\r\n                                {\r\n                                    nft && \r\n                                    <div className=\"container\">\r\n                                        <div className=\"row justify-content-between\">\r\n                                            <div className=\"col-12 col-lg-5\">\r\n                                                <div className=\"item-info\">\r\n                                                    <div className=\"item-thumb text-center\">\r\n                                                        <img src={nft.image} alt=\"NFT Image\" />\r\n                                                    </div>\r\n                                                    {\r\n                                                        nft.auctionEndDate &&\r\n                                                        <div className=\"card no-hover countdown-times mt-4\">\r\n                                                            <Countdown\r\n                                                                date={new Date(nft.auctionEndDate) + 10000}\r\n                                                                renderer={countDownRenderer}\r\n                                                            />\r\n                                                        </div>\r\n                                                    }\r\n                                                    {/* Tabs */}\r\n                                                    <ul className=\"netstorm-tab nav nav-tabs mt-4\" id=\"nav-tab\">\r\n                                                        <li>\r\n                                                            <a className=\"active\" id=\"bids-tab\" data-toggle=\"pill\" href=\"#bids\">\r\n                                                                <h5 className=\"m-0\">Bids</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                        {/* <li>\r\n                                                            <a id=\"offers-tab\" data-toggle=\"pill\" href=\"#offers\">\r\n                                                                <h5 className=\"m-0\">Offers</h5>\r\n                                                            </a>\r\n                                                        </li> */}\r\n                                                        <li>\r\n                                                            <a id=\"details-tab\" data-toggle=\"pill\" href=\"#details\">\r\n                                                                <h5 className=\"m-0\">Details</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                    </ul>\r\n                                                    \r\n                                                    {/* Tab Content */}\r\n                                                    <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                                                        <div className=\"tab-pane fade show active\" id=\"bids\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {this.state.bidsData &&  this.props.user?.creators?.length > 0  ? \r\n                                                                \r\n                                                                    this.state.bidsData.map((item, idx) => {\r\n                                                                \r\n                                                                        return (\r\n                                                                            <li key={`bid_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                             \r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Bid listed for <strong>{item.price.amount} {item.price.currency} </strong>\r\n                                                                                     <span>{moment(item.createdAt).fromNow()} </span>\r\n                                                                                     <br />by <Link to={`/author/${item.bidById}`}>@{ this.filterCreatorsInfo(item.bidBy,'username')}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                     nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                      nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                     \r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No bids found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div>\r\n\r\n                                                        {/* <div className=\"tab-pane fade\" id=\"offers\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {offers && offers.length > 0 ?\r\n                                                                    offers.filter((item)=>item.nftId===nft._id).map((item, idx) => {\r\n                                                                        return (\r\n                                                                            <li key={`offer_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.offerBy?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Offer listed for <strong>{item.price.amount} {item.price.currency}</strong> {moment(item.createdAt).fromNow()} <br />by <Link to={`/author/${item.nftId}`}>@{this.filterCreatorsInfo(item.offerById,\"username\")}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No offers found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div> */}\r\n                                                        \r\n                                                        <div className=\"tab-pane fade\" id=\"details\">\r\n                                                            <div className=\"owner-meta d-flex align-items-center mt-3\">\r\n                                                                <span>Owner</span>\r\n                                                                <Link className=\"owner d-flex align-items-center ml-2\" to={`/author/${nft.owner?._id}`}>\r\n                                                                    <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto ? nft.owner.profilePhoto : globalPlaceholderImage} alt=\"Owner Image\" />\r\n                                                                    <h6 className=\"ml-2\">{nft.owner?.username}</h6>\r\n                                                                </Link>\r\n                                                            </div>\r\n                                                            <p className=\"mt-2\">Created : {moment(nft.createdAt).format('DD MMM YYYY')\r\n                                                            }</p>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 col-lg-6\">\r\n                                                <div className=\"content mt-5 mt-lg-0\">\r\n                                                    <h3 className=\"m-0\">{nft.name}</h3>\r\n                                                    <p>{nft.description}</p>\r\n\r\n                                                    {/* Owner */}\r\n                                                    <div className=\"owner d-flex align-items-center\">\r\n                                                        <span>Owned By</span>\r\n                                                        <Link className=\"owner-meta d-flex align-items-center ml-3\" to={`/author/${nft.owner?._id}`}>\r\n                                                            <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto || globalPlaceholderImage} alt=\"Owner Avatar\" />\r\n                                                            <h6 className=\"ml-2\">\r\n                                                                {/* {nft.owner?.username}\r\n                                                                 */}\r\n                                                                 {this.creatorUserName()}\r\n                                                                </h6>\r\n                                                        </Link>\r\n                                                    </div>\r\n                                                    {/* Item Info List */}\r\n                                                    <div className=\"item-info-list mt-4\">\r\n                                                        <ul className=\"list-unstyled\">\r\n                                                            <li className=\"price d-flex justify-content-between\">\r\n                                                                <span>Current Price {nft.currentPrice || 0} {ENV.currency}</span>\r\n                                                                {/* <span>{initData.price_2}</span> */}\r\n                                                                <span>{nft.sold} of {nft.copies}</span>\r\n                                                            </li>\r\n                                                            <li>\r\n                                                                <span>Size </span>\r\n                                                                <span>{nft.size}</span>\r\n                                                            </li>\r\n                                                        </ul>\r\n                                                    </div>\r\n                                                    <div className=\"row items\">\r\n                                                        {/* Creator */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <a href=\"/author\">\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.creator?.profilePhoto || globalPlaceholderImage} alt=\"Creator Avatar\" />\r\n                                                                    </a>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`/author/${nft.creator?._id}`}>{\r\n                                                                          this.creatorUserName()\r\n                                                                        // nft.creator?.username\r\n                                                                        }</Link>\r\n                                                                        <span>Creator</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        {/* Collection */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <Link to={`collection-details/${window.btoa(nft.collection?._id)}`}>\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.collection?.image} alt=\"Collection Image\" />\r\n                                                                    </Link>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`collection-details/${window.btoa(nft.collection?._id)}`}>{nft.collection?.name}</Link>\r\n                                                                        <span>Collection</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        <div className=\"col-12 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <h4 className=\"mt-0 mb-2\">Highest Bid</h4>\r\n                                                                <div className=\"price d-flex justify-content-betxween align-items-center\">\r\n                                                                    <span>{this.state.highestBidAmtt ? this.state.highestBidAmtt + ` ${ENV.currency}` : 'N/A'}</span>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                    {\r\n\r\n                                                        nft.nftOwnerId=== userId ?\r\n                                                        <Link className=\"d-block btn btn-bordered-white mt-4 mb-4 w-100\" to={`/sell-item/${window.btoa(nft._id)}`}>{initData.sellBtn}</Link>\r\n                                                        :\r\n                                                        // <button className=\"d-block btn btn-bordered-white mt-4 w-100\" onClick={this.openModal(nft)}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn}</button>\r\n                                                        <>\r\n                                                             {/* this.isTimeoutAction ? 'Auction Timeout' : */}\r\n                                                             {/*  */}\r\n                                                            { \r\n                                                           this.props?.nft?.nftAll.sellingMethod &&\r\n                                                            <button  className=\"d-block btn btn-bordered-white mt-4 w-100\" disabled={this.isTimeoutAction || nft.copies===nft.sold}  onClick={()=>this.openModal()}>{this.isTimeoutAction?\"Auction Timeout\":( nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn)}</button>}\r\n                                                             \r\n                                                            </>\r\n                                                    }\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                }\r\n                            </>\r\n\r\n                    }\r\n                </section>\r\n                <div className=\"modal-wrapper\">\r\n                    {\r\n                        nft &&\r\n                        <Modal\r\n                            centered\r\n                            size=\"lg\"\r\n                            className=\"\"\r\n                            show={this.state.isOpen}\r\n                            onHide={this.closeModal}\r\n                        >\r\n                            <Modal.Header className=\"text-center modal-title-wrapper\">\r\n                                <Modal.Title>\r\n                                    { nft.sellingMethod === 2 ? 'Place A Bid' : 'Make An Offer'}\r\n                                </Modal.Title>\r\n                            </Modal.Header>\r\n                            {\r\n                                isSubmitted && errors &&\r\n                                <Modal.Body className=\"row pt-2 pb-0\">\r\n                                    <div className=\"col-12\">\r\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\r\n                                    </div>\r\n                                </Modal.Body>\r\n                            }\r\n                            <Modal.Body>\r\n                                <div className=\"price-wrapper d-flex\">\r\n                                    <div className=\"price-text position-relative\">\r\n                                        <div className=\"text-white mb-2 absolute-wrapper\">\r\n                                            <b>Price</b>\r\n                                        </div>\r\n                                        <div className=\"text-right mb-2\">\r\n                                            <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                                        </div>\r\n                                        <div className=\"d-flex\">\r\n                                            <select className=\"form-control\" id=\"currency\" name=\"nftConfig.price.currency\" onChange={(e) => this.onChange(e)}>\r\n                                                {\r\n                                                    currencies && currencies.map((currency, index) => {\r\n                                                        return (\r\n                                                            <option key={index} value={currency.symbol}>{currency.symbol}</option>\r\n                                                        )\r\n                                                    })\r\n                                                }\r\n                                            </select>\r\n                                            <input type=\"text\" placeholder=\"Amount\" className=\"amount-btn ml-3\" name=\"nftConfig.price.amount\" placeholder=\"Amount\" className=\"amount-btn ml-3\" style={{ borderRadius: \"4px\" }} onChange={(e) => this.onChange(e)} onKeyDown={(e) => decimalNumberValidator(e)} defaultValue={nftConfig.price.amount} required />\r\n                                            <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                                $ 0.00\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"text-danger\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</Modal.Body>\r\n                            <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\r\n                                <div className=\"offer-expiration-wrapper text-white\">\r\n                                    <b>Offer Expiration</b>\r\n                                </div>\r\n                                <div>\r\n                                    <div className=\"d-flex\">\r\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\r\n                                            style={{\r\n                                                padding: \"7px 55px 7px 55px\",\r\n                                                border: \"none\",\r\n                                                outline: \"none\",\r\n                                                borderRadius: \"4px\",\r\n                                                background: \"#808080\",\r\n                                                display: \"flex\",\r\n                                                alignItems: \"center\",\r\n                                                cursor: \"pointer\",\r\n                                                height: \"51px\",\r\n                                                color: \"#000\"\r\n                                            }}\r\n                                        >\r\n                                            {\r\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\r\n                                                    return (\r\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\r\n                                                    )\r\n                                                })\r\n                                            }\r\n                                        </select>\r\n                                        <div>\r\n                                            <div className=\"mr-auto budle-wrapper\">\r\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\r\n                                            </div>\r\n                                            <span className=\"text-danger message\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"justify-content-center align-items-center\">\r\n                                <div className=\"d-flex justify-content-around\">\r\n                                    <button className=\"ethereum-btn mr-3\" disabled={loader} onClick={() => this.submit()}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.bidBtn}</button>\r\n                                    {/* <button className=\"ethereum-btn\">Add funds</button> */}\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Footer>\r\n                                <button\r\n                                    className=\"btn banner-btn btn-primary\"\r\n                                    onClick={this.closeModal}\r\n                                >\r\n                                    Close\r\n                                </button>\r\n                            </Modal.Footer>\r\n                        </Modal>\r\n                    }\r\n                </div>\r\n            </>\r\n        );\r\n                }\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n    // console.log('state', state),\r\n \r\n    {\r\n    nft: state.nft,\r\n    error: state.error,\r\n    offer: state.offer,\r\n    bid: state.bid,\r\n    user: state.user,\r\n    nftAll:state.nftAll,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeNFT, getNFT,\r\n    beforeOffer, makeOffer, getOffers, deleteOffer, beforeBid, placeBid, getBids, deleteBid, acceptOffer, acceptBid, beforeUser, getCreators ,\r\n})(ItemDetails);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.action.js",["901"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice, acceptNftOffer} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body,tokenId,price) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            acceptNftOffer(body);\n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/create-nft-reducer.js",["902"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/owncollection/OwnCollection.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/buy-sell/Buysell.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/navbar-main/NavbarMain.js",["903","904","905"],"import React from \"react\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport MintsClub from \"../../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../../assets/images/login-icon.svg\";\nimport SearchIcon from \"../../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport \"./NavbarMain.css\";\n\nconst NavbarMain = () => {\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"dark\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <Navbar.Brand href=\"#\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </Navbar.Brand>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className=\"mx-xl-auto\" activeKey=\"/user-dashboard\">\n              <Nav.Link to=\"/user-dasboard\" className=\"nav-main-link\">\n                Home\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                className=\"nav-main-link dropdown-bg\"\n              >\n                <NavDropdown.Item\n                  to=\"/explore-all\"\n                  className=\"nav-main-link main-nav-dd-items\"\n                >\n                  Explore\n                </NavDropdown.Item>\n                <NavDropdown.Item to=\"/auctions\" className=\"nav-main-link\">\n                  Live Auctions\n                </NavDropdown.Item>\n              </NavDropdown>\n              <Nav.Link to=\"/activity\" className=\"nav-main-link\">\n                Activity\n              </Nav.Link>\n              <Nav.Link to=\"/collections\" className=\"nav-main-link\">\n                Collections\n              </Nav.Link>\n              <Nav.Link to=\"/\" className=\"nav-main-link\">\n                Contact\n              </Nav.Link>\n              <Nav.Link to=\"/\" className=\"nav-main-link\">\n                History\n              </Nav.Link>\n\n              <Link\n                to=\"/\"\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                Login\n              </Link>\n              <div class=\"search-box mt-1 mt-sm-0 d-sm-none\">\n                <input\n                  class=\"search-txt \"\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                />\n                <a class=\"search-btn\" href=\"#\">\n                  <img src={SearchIcon} alt=\"search-icon\" />\n                </a>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div class=\"search-box \">\n              <input\n                class=\"search-txt\"\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n              />\n              <a class=\"search-btn me-1 mt-1\" href=\"#\">\n                <img src={SearchIcon} alt=\"search-icon\" />\n              </a>\n            </div>\n            <Link\n              to=\"/\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient\"\n            >\n              <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n              Login\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nexport default NavbarMain;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/auctions-cards/AuctionsCards.js",["906"],"import React from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../../assets/images/arrowUp.svg\";\nimport Bucket from \"../../../assets/images/bucket.png\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../../config/config\";\n\nimport \"./AuctionsCard.css\";\n\nconst AuctionsCards = () => {\n  const { countDownRenderer } = ENV;\n  return (\n    <Card className=\"auction-card mx-2\">\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n        <div className=\"auction-countdown mb-3\">\n          <Countdown date=\"2022/1/26 13:10:12\" renderer={countDownRenderer} />\n        </div>\n      </div>\n      <Card.Body>\n        <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n          <div className=\"auction-card-avatar d-flex align-items-center\">\n            <img src={AvatarImg} alt=\"AvatarImg\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <span className=\"ms-4\">9+ Place Bit</span>\n          </div>\n\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <Card.Title>Music</Card.Title>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owend by Jecica</p>\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default AuctionsCards;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/card-slider/CardSlider.js",["907","908","909"],"import React, { Component } from \"react\";\nimport Slider from \"react-slick\";\nimport CollectionsCard from \"../../Screens/rough/collections-cards/CollectionsCard\";\nimport SliderNextIcon from \"../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../../Screens/rough/auctions-cards/AuctionsCards\";\nimport \"./CardSlider.css\";\nimport TwitchPlayer from \"react-player/twitch\";\n\nexport default class CardSlider extends Component {\n  // const CardSlider = () => {\n  constructor(props) {\n    super(props);\n    this.next = this.next.bind(this);\n    this.previous = this.previous.bind(this);\n  }\n  next() {\n    this.slider.slickNext();\n  }\n  previous() {\n    this.slider.slickPrev();\n  }\n\n  render() {\n    const { settings } = this.props;\n    return (\n      <div className=\"container\">\n        <div className=\"text-end\">\n          <button className=\"card-slider-btn mb-4 me-3\" onClick={this.previous}>\n            <img src={SliderPrevIcon} alt=\"SliderPrevButton\" />\n          </button>\n          <button className=\"card-slider-btn mb-4\" onClick={this.next}>\n            <img src={SliderNextIcon} alt=\"SliderNextButton\" />\n          </button>\n        </div>\n        <Slider ref={(c) => (this.slider = c)} {...settings}>\n          {this.props.children}\n        </Slider>\n      </div>\n    );\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/collections-cards/CollectionsCard.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero-slider/HeroSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero-slider/CustomSlider.js",["910","911","912","913","914","915"],"import React, { useState } from \"react\";\nimport HeroCards from \"../../Screens/rough/hero-cards/HeroCards\";\nimport AuctionsCards from \"../../Screens/rough/auctions-cards/AuctionsCards\";\nimport SliderNextIcon from \"../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../assets/images/sliderprevArrow.png\";\nimport \"./CustomSlider.css\";\n\nconst sliderData = [\n  {\n    id: 1,\n    content: <HeroCards />,\n  },\n  {\n    id: 2,\n    content: <AuctionsCards />,\n  },\n  {\n    id: 3,\n    content: <HeroCards />,\n  },\n  {\n    id: 4,\n    content: <AuctionsCards />,\n  },\n  {\n    id: 5,\n    content: <HeroCards />,\n  },\n  {\n    id: 6,\n    content: <HeroCards />,\n  },\n];\n\nconst CustomSlider = () => {\n  const [current, setCurrent] = useState(0);\n  const [prevSlide, setPreviousSlide] = useState(null);\n  const [nextSlide, setNextSlide] = useState(current + 1);\n  const [secondNextSlide, setSecondNextSlide] = useState(current + 2);\n  const length = sliderData.length;\n\n  const nextSlideMove = () => {\n    setCurrent(current === length - 1 ? 0 : current + 1);\n  };\n\n  const prevSlideMove = () => {\n    setCurrent(current === 0 ? length - 1 : current - 1);\n  };\n  return (\n    <section className=\"customHeroSlider\">\n      {sliderData.map((slide, id) => {\n        return (\n          <div>\n            <div className={id === current ? \"slide active\" : \"slide\"} key={id}>\n              {slide.content}\n            </div>\n          </div>\n        );\n      })}\n      <div className=\"text-end\">\n        <button className=\"card-slider-btn mb-4 me-3\" onClick={nextSlideMove}>\n          <img src={SliderPrevIcon} alt=\"SliderPrevButton\" />\n        </button>\n        <button className=\"card-slider-btn mb-4\" onClick={prevSlideMove}>\n          <img src={SliderNextIcon} alt=\"SliderNextButton\" />\n        </button>\n      </div>\n    </section>\n  );\n};\n\nexport default CustomSlider;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero-slider/HeroSlickSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/hero-cards/HeroCards.js",["916","917","918"],"import React from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../../assets/images/arrowUp.png\";\nimport Bucket from \"../../../assets/images/bucket.png\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../../config/config\";\n\nimport \"./HeroCards.css\";\n\nconst HeroCards = () => {\n  const { countDownRenderer } = ENV;\n  return (\n    <Card className=\"auction-card hero-card mx-2\">\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n        {/* <div className=\"auction-countdown mb-3\">\n          <Countdown date=\"2022/1/26 13:10:12\" renderer={countDownRenderer} />\n        </div> */}\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title>Music</Card.Title>\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <div className=\"auction-card-avatar d-flex align-items-center mb-4\">\n          <img src={AvatarImg} alt=\"AvatarImg\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <span className=\"ms-4\">9+ People Place Bit</span>\n        </div>\n\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owend by Jecica</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default HeroCards;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero/component/slider.js",["919"],"import \"./slider.css\";\nimport { useState } from \"react\";\nimport HeroCards from \"../../../Screens/rough/hero-cards/HeroCards\";\nimport SliderNextIcon from \"../../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../../../Screens/rough/auctions-cards/AuctionsCards\";\nimport { map } from \"jquery\";\n\nconst Slider = () => {\n  const sliderRadioButtons = [\n    {\n      id: \"s1\",\n      value: 1,\n    },\n    {\n      id: \"s2\",\n      value: 2,\n    },\n    {\n      id: \"s3\",\n      value: 3,\n    },\n    {\n      id: \"s4\",\n      value: 4,\n    },\n    {\n      id: \"s5\",\n      value: 5,\n    },\n    {\n      id: \"s6\",\n      value: 6,\n    },\n    {\n      id: \"s7\",\n      value: 7,\n    },\n  ];\n\n  const [sliderChecked, setSliderChecked] = useState(1);\n  const length = sliderRadioButtons.length;\n  const handleRadioInputs = (e) => {\n    setSliderChecked(e.target.value);\n  };\n\n  const nextBtnHandler = () => {\n    if (sliderChecked < length) {\n      setSliderChecked(sliderChecked + 1);\n    } else {\n      setSliderChecked(1);\n    }\n  };\n\n  const prevBtnHandler = () => {\n    if (sliderChecked === 1) {\n      setSliderChecked(7);\n    } else {\n      setSliderChecked(sliderChecked - 1);\n    }\n  };\n\n  return (\n    <section id=\"slider\">\n      {sliderRadioButtons.map((item) => {\n        return (\n          <input\n            type=\"radio\"\n            name=\"slider\"\n            value={item.value}\n            checked={sliderChecked === item.value}\n            onChange={(e) => handleRadioInputs(e)}\n            id={item.id}\n          />\n        );\n      })}\n\n      {/* <input type=\"radio\" name=\"slider\" id=\"s2\" />\n      <input type=\"radio\" name=\"slider\" id=\"s3\" />\n      <input type=\"radio\" name=\"slider\" id=\"s4\" />\n      <input type=\"radio\" name=\"slider\" id=\"s5\" />  */}\n\n      <label for=\"s1\" id=\"slide1\" onClick={() => setSliderChecked(1)}>\n        <HeroCards className=\"slide\" />\n        {/* <img\n          src=\"https://i.pinimg.com/originals/2b/de/de/2bdede0647e3cdf75b44ea33723201d9.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s2\" id=\"slide2\" onClick={() => setSliderChecked(2)}>\n        <AuctionsCards className=\"slide\" />\n\n        {/* <img\n          src=\"https://images6.alphacoders.com/462/thumb-1920-462371.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s3\" id=\"slide3\" onClick={() => setSliderChecked(3)}>\n        <HeroCards className=\"slide\" />\n        {/* <img src=\"https://wallpaperaccess.com/full/1154341.jpg\" alt=\"\" /> */}\n      </label>\n      <label for=\"s4\" id=\"slide4\" onClick={() => setSliderChecked(4)}>\n        <AuctionsCards className=\"slide\" />\n        {/* <img src=\"https://wallpapercave.com/wp/wp2634222.jpg\" alt=\"\" /> */}\n      </label>\n      <label for=\"s5\" id=\"slide5\" onClick={() => setSliderChecked(5)}>\n        <HeroCards className=\"slide\" />\n        {/* <img\n          src=\"https://images5.alphacoders.com/343/thumb-1920-343645.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s6\" id=\"slide6\" onClick={() => setSliderChecked(6)}>\n        <HeroCards className=\"slide\" />\n      </label>\n      <label for=\"s7\" id=\"slide7\" onClick={() => setSliderChecked(7)}>\n        <AuctionsCards className=\"slide\" />\n      </label>\n\n      <div className=\"btn-container\">\n        <button className=\"card-slider-btn mb-4 me-3\" onClick={prevBtnHandler}>\n          <img src={SliderPrevIcon} alt=\"SliderPrevButton\" />\n        </button>\n        <button className=\"card-slider-btn mb-4\" onClick={nextBtnHandler}>\n          <img src={SliderNextIcon} alt=\"SliderNextButton\" />\n        </button>\n      </div>\n    </section>\n  );\n};\n\nexport default Slider;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero-slider/HeroSliderSetting.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/components/upload.js",["920","921","922"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport { IoMdCloudUpload } from \"react-icons/io\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n}) => {\n  return (\n    <label\n      className=\"w-100\"\n      onDrop={(e) => onDrop(e)}\n      onDragOver={(e) => dragOver(e)}\n      onDragEnter={(e) => dragEnter(e)}\n      onDragLeave={(e) => dragLeave(e)}\n    >\n      <div className=\"upload-image-border p-4\">\n        {imageURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <img className=\"upload-image\" src={imageURL} alt=\"upload-image\" />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            {/* <IoMdCloudUpload className=\"img-upload-icon\"/> */}\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : videoURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <VideoComponent\n              videoUrl={videoURL}\n              videoStyles={videoStyles}\n              videoWidth=\"300\"\n            />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n          </div>\n        ) : audioSrc ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <AudioPlayer audioSrc={audioSrc} />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n             <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : (\n          <>\n            {\" \"}\n            <img\n              className=\"upload-image\"\n              src={Images.uploadImage}\n              alt=\"upload-image\"\n            />\n            <div className=\"upload-details text-center mt-2\">\n              <p>Drag and drop your file</p>\n              <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n            </div>\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={(e) => onFileChange(e, \"onChange\")}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </>\n        )}\n      </div>\n    </label>\n  );\n};\n\nexport default Upload;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/audioPlayer/AudioPlayer.js",[],{"ruleId":"923","replacedBy":"924"},{"ruleId":"925","replacedBy":"926"},{