ponents/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],["606","607"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.action.js",["608"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["609","610"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["611"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-card/nft-card.js",["612","613","614"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",[],["615","616"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/videoCard.js",["617"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/levelsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/statsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BidModal.js",["618"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BuyModal.js",["619","620","621","622","623"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.action.js",["624","625"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/ApprovalModal.js",["626","627","628"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["629"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        \n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n",["630","631"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/StatsModal.js",["632","633"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/PropertiesModal.js",["634"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/LevelsModal.js",["635"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["636","637"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <div className=\"upload-image-border p-4 position-relative\">\n      <div className=\"nft-uploaded-img-container\">\n        {imageURL || videoURL || audioSrc ? (\n          <MdClose\n            color=\"#e33d0bc2\"\n            className=\"uploaded-cross-icon\"\n            onClick={() => clearData()}\n          />\n        ) : (\n          \"\"\n        )}\n        <label\n          className=\"w-100\"\n          onDrop={(e) => onDrop(e)}\n          onDragOver={(e) => dragOver(e)}\n          onDragEnter={(e) => dragEnter(e)}\n          onDragLeave={(e) => dragLeave(e)}\n        >\n          <div className=\"\">\n            {imageURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <img\n                  className=\"upload-image\"\n                  src={imageURL}\n                  alt=\"upload-image\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : videoURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <VideoComponent\n                  videoUrl={videoURL}\n                  videoStyles={videoStyles}\n                  videoWidth=\"300\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : audioSrc ? (\n              <div className=\"nft-uploaded-img-container\">\n                <AudioPlayer audioSrc={audioSrc} />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : (\n              <>\n                {\" \"}\n                <img\n                  className=\"upload-image-place-holder\"\n                  src={Images.uploadImage}\n                  alt=\"upload-image\"\n                />\n                <div className=\"upload-details text-center mt-2\">\n                  <p>Drag and drop your file</p>\n                  <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n                </div>\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={(e) => onFileChange(e, \"onChange\")}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </>\n            )}\n          </div>\n        </label>\n      </div>\n    </div>\n  );\n};\n\nexport default Upload;\n",["638","639"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],["640","641"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/aboutus/aboutus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contactus/contactus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/faqs/faqs.js",["642","643"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/imageLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/waveform/WaveForm.js",["644","645"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/waveform/Waveform.styled.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/collectionSubLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/privacy-policy/privacyPolicy.js",["646"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/terms-conditions/termsConditions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auction-audio/auctionAudio.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audio/audio.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/nftDetailLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/sellNFTLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contentLoader/heroLoader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/gaTracker/gaTracket.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/algorand.js",["647"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/listing/listing.js",["648","649","650","651","652"],"import React, { useState, useEffect } from \"react\";\nimport \"./listing.css\";\nimport SearchIcon from \"../../assets/images/search-inp.svg\";\nimport NftCard from \"../nft-card/nft-card\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport Select from \"react-select\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"../../utils/functions\";\nconst Listing = (props) => {\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [statusActive, setStatusActive] = useState(null);\n  const [filterActive, setFilterActive] = useState(false);\n  const [initial, setInitial] = useState(true);\n  const [selectedOption, setSelectedOption] = useState();\n  const [collectionActive, setCollectionActive] = useState(null);\n  const [isActive, setIsActive] = useState(1);\n  const [keyword, setKeyword] = useState(\n    props.initialKeyword ? props.initialKeyword : \"\"\n  );\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n    keyword: props.initialKeyword ? props.initialKeyword : \"\",\n  });\n\n  const priceOptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recently Created\" },\n  ];\n  useEffect(() => {\n    const { initialKeyword } = props;\n    if (initialKeyword) {\n      let capitalizeValue = capitalize(initialKeyword);\n      setKeyword(capitalizeValue);\n      handleSearchKeyword(capitalizeValue);\n    }\n  }, [props.initialKeyword]);\n\n  useEffect(() => {\n    fetchData(filter);\n  }, [filter]);\n  const handleSelectChange = (selectedOption) => {\n    setSelectedOption(selectedOption);\n  };\n  const selectCustomStyles = {};\n\n  const statusData = [\"Buy Now\", \"On Auction\", \"New\"];\n  const handleFilters = () => {\n    setFilterActive(!filterActive);\n  };\n  const isHideCollection = () => {\n    if(props.collectionDetail){\n      return false\n    }\n    if (props.UserProfile ) {\n      if (isActive === 1) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return true;\n    }\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n    setInitial(false);\n\n    const { label } = e;\n    if (label === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n    } else if (label === \"Recently Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    if (!UserProfile) {\n      setInitial(false);\n      setFilterationLoader(true);\n      setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    } else {\n      getPaginatedData();\n    }\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n  };\n\n  const handleSearchKeyword = (value) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    let capitalizeValue = \"\";\n    if (value) {\n      capitalizeValue = capitalize(value);\n    }\n    setFilter((prev) => ({ ...prev, keyword: capitalizeValue }));\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    if (id === \"Buy Now\") {\n      setFilter((prev) => ({\n        ...prev,\n        buy: true,\n        auction: false,\n        newest: false,\n      }));\n    } else if (id === \"On Auction\") {\n      setFilter((prev) => ({\n        ...prev,\n        auction: true,\n        buy: false,\n        newest: false,\n      }));\n    } else {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        buy: false,\n        auction: false,\n      }));\n    }\n  };\n  const handleClearFilter = (id) => {\n    if (id === \"status\") {\n      setFilterationLoader(true);\n      setFilter((prev) => ({\n        ...prev,\n        buy: false,\n        auction: false,\n        new: false,\n      }));\n    } else if (id === \"price\") {\n      setFilterationLoader(true);\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setFilter((prev) => ({ ...prev, ltePrice: false, gtePrice: false }));\n    } else if (id === \"collections\") {\n      setFilterationLoader(true);\n      setFilter((prev) => ({ ...prev, collectionId: false }));\n    } else {\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setStatusActive(null);\n      setCollectionActive(null);\n      setSelectedOption(null);\n      setFilterActive(null);\n      setKeyword(\"\");\n      setFilter({\n        collectionId: false,\n        gtePrice: false,\n        ltePrice: false,\n        categoryId: false,\n        oldest: false,\n        lowToHigh: false,\n        highToLow: false,\n        newest: false,\n        page: filter.page,\n        limit: filter.limit,\n        buy: false,\n        auction: false,\n        latest: false,\n      });\n    }\n  };\n  const capitalize = (word) => {\n    return word[0].toUpperCase() + word.slice(1).toLowerCase();\n  };\n\n  const {\n    collections,\n    disabled,\n    menuData,\n    totalItems,\n    handleNftFilter,\n    setMenuFilter,\n    filterationLoader,\n    setFilterationLoader,\n    nfts,\n    loader,\n    likedNfts,\n    nftPagination,\n    handleLikesTogleApi,\n    fetchData,\n    path,\n    getPaginatedData,\n    UserProfile,\n  } = props;\n  return (\n    <div className=\"filterhoc-wrapper padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row justify-content-center justify-content-lg-start\">\n          <div className=\"col-12 order-0\">\n            <div\n              className={`d-flex flex-column flex-md-row align-items-center justify-content-md-between`}\n            >\n              <div className=\"search-input mb-4 mb-md-0\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Search items and accounts\"\n                  maxLength=\"50\"\n                  onChange={(e) => {\n                    if (keyword.trim() === \"\" && e.target.value.trim() === \"\") {\n                      return false;\n                    } else if (e.target.value === \"\") {\n                      handleSearchKeyword(false);\n                      setKeyword(e.target.value);\n                    } else {\n                      setKeyword(e.target.value);\n                    }\n                  }}\n                  onKeyPress={(e) =>\n                    e.key === \"Enter\" && handleSearchKeyword(keyword)\n                  }\n                  value={keyword}\n                />\n                <img src={SearchIcon} alt=\"search-input\" />\n              </div>\n              <div className=\"sort-by-select mb-4 mb-md-0\">\n                <p className=\"me-3\">Sort by:</p>\n                <Select\n                  className=\"react-select-cls\"\n                  classNamePrefix=\"react-select\"\n                  styles={selectCustomStyles}\n                  // defaultValue={priceOptions[3]}\n                  value={selectedOption}\n                  isSearchable={false}\n                  onChange={(value) => {\n                    handleSelectChange(value);\n                    handleSortOptions(value);\n                  }}\n                  options={priceOptions}\n                />\n              </div>\n              <div className=\"mob-filters-btn d-flex d-lg-none align-items-center justify-content-center\">\n                <button\n                  className={`${filterActive ? \"mob-active-filter\" : \"\"}`}\n                  onClick={handleFilters}\n                >\n                  Filters\n                </button>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-12 my-5 order-2 order-lg-1 \">\n            <div className=\"hero-nav d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n              <div>\n                {\" \"}\n                {menuData &&\n                  menuData.length > 0 &&\n                  menuData.map((item, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          setIsActive(id);\n                          handleNftFilter(item);\n                          setMenuFilter(item);\n                        }}\n                        className={`${\n                          id === isActive ? \"active-hero-nav\" : \"\"\n                        } me-2 me-xl-3`}\n                      >\n                        {item}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"total-items mt-3 mt-sm-0\">\n                <p>\n                  Total items:{\" \"}\n                  <span>{nftPagination?.total ? nftPagination?.total : 0}</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div\n            className={`${\n              filterActive ? \"d-block d-lg-block\" : \"d-none d-lg-block\"\n            } col-md-5 col-lg-4 col-xl-3 order-1 order-lg-2 mt-4 mt-lg-0`}\n          >\n            <div className=\"filter-container mb-4\">\n              <h6>Status</h6>\n              <hr />\n              <div className=\"d-flex flex-wrap align-items-center \">\n                {statusData &&\n                  statusData.map((status, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          handleStatusFilter(status);\n                          setStatusActive(status);\n                        }}\n                        className={`${\n                          status === statusActive ? \"active-filter-btn\" : \"\"\n                        } filter-btn me-3`}\n                      >\n                        {status}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {statusActive && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => {\n                      setStatusActive();\n                      handleClearFilter(\"status\");\n                    }}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            <div className=\"filter-container mb-4\">\n              <h6>Price</h6>\n              <hr />\n              <div className=\"min-max-inp d-flex flex-column flex-sm-row align-items-center justify-content-center justify-content-sm-between mb-2\">\n                <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-center\">\n                  <input\n                    type=\"number\"\n                    placeholder=\"Min\"\n                    className=\"me-sm-2\"\n                    value={minValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMinPrice}\n                  ></input>\n                  <input\n                    type=\"number\"\n                    placeholder=\"Max\"\n                    className=\"mt-3 mt-sm-0 me-sm-2\"\n                    value={maxValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMaxPrice}\n                  ></input>\n                </div>\n                <button\n                  className=\"mt-3 mt-sm-0\"\n                  onClick={() => applyMinMaxFilter()}\n                  disabled={disabled || minValue === \"\" || maxValue === \"\"}\n                >\n                  Apply\n                </button>\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {minValue && maxValue && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => handleClearFilter(\"price\")}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            {isHideCollection() && (\n              <div className=\"filter-container hoc-collections-container mb-4\">\n                <h6>Collections</h6>\n                <hr />\n                <div className=\"d-flex flex-wrap align-items-center \">\n                  {collections && collections.length > 0 ? (\n                    collections.map((collection, id) => {\n                      return (\n                        <button\n                          key={id}\n                          onClick={() => {\n                            handleCollectionsFilter(collection._id);\n                            setCollectionActive(id);\n                          }}\n                          className={`${\n                            id === collectionActive ? \"active-filter-btn\" : \"\"\n                          } filter-btn me-2 me-xl-3`}\n                        >\n                          {collection.name}\n                        </button>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center mx-auto\">No Collections Found</p>\n                  )}\n                </div>\n                <div className=\"d-flex align-items-end justify-content-end\">\n                  {collectionActive !== null && (\n                    <button\n                      className=\"filter-clear-btn\"\n                      onClick={() => {\n                        setCollectionActive(null);\n                        handleClearFilter(\"collections\");\n                      }}\n                    >\n                      Clear\n                    </button>\n                  )}\n                </div>\n              </div>\n            )}\n            <div className=\"d-flex align-items-center justify-content-center btn-clear-all\">\n              <button onClick={() => handleClearFilter()}>\n                Clear All Filters\n              </button>\n            </div>\n          </div>\n          <div className=\"col-lg-8 col-xl-9 order-3\">\n            {loader ? (\n              <FullPageLoader />\n            ) : (\n              <div className=\"row g-1\">\n                {filterationLoader ? (\n                  <div className=\"text-center\">\n                    <div\n                      className=\"spinner-border text-secondary\"\n                      role=\"status\"\n                    >\n                      <span className=\"sr-only\">Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((nft, index) => {\n                    return (\n                      <div\n                        key={index}\n                        className=\"col-12 col-sm-6 col-md-4 col-lg-6 col-xl-4\"\n                      >\n                        {\n                          <NftCard\n                            data={nft}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            likedNfts={likedNfts}\n                            owner={nft.owner}\n                            path={path}\n                            index={index}\n                          />\n                        }\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center mt-5 no-nft-title\">No NFTs Found</p>\n                )}\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      nftPagination?.total > nfts.length &&\n                      !filterationLoader && (\n                        <button\n                          className=\"btn btn-rounded-bordered px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more...\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Listing;\n",{"ruleId":"653","severity":1,"message":"654","line":20,"column":13,"nodeType":"655","endLine":22,"endColumn":4},{"ruleId":"653","severity":1,"message":"656","line":22,"column":6,"nodeType":"657","endLine":22,"endColumn":11,"suggestions":"658"},{"ruleId":"653","severity":1,"message":"659","line":31,"column":6,"nodeType":"657","endLine":31,"endColumn":8,"suggestions":"660"},{"ruleId":"661","severity":1,"message":"662","line":170,"column":15,"nodeType":"663","messageId":"664","endLine":170,"endColumn":21},{"ruleId":"665","severity":1,"message":"666","line":27,"column":23,"nodeType":"667","messageId":"668","endLine":27,"endColumn":37},{"ruleId":"665","severity":1,"message":"669","line":31,"column":10,"nodeType":"667","messageId":"668","endLine":31,"endColumn":16},{"ruleId":"653","severity":1,"message":"670","line":53,"column":6,"nodeType":"657","endLine":53,"endColumn":8,"suggestions":"671"},{"ruleId":"672","severity"