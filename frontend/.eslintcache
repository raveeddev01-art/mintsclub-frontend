catedRules":"114"},{"filePath":"243","messages":"244","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"114"},{"filePath":"245","messages":"246","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"247","usedDeprecatedRules":"114"},{"filePath":"248","messages":"249","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"250","usedDeprecatedRules":"114"},"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/index.js",[],["251","252"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/App.js",["253","254"],"import React, { Suspense,useEffect } from 'react'\nimport routes from './routes'\nimport { PrivateRoute } from './privateRoute'\nimport { Switch } from \"react-router-dom\"\nimport FullPageLoader from './components/full-page-loader/full-page-loader';\nimport GaTracker from './gaTracker/gaTracket'\nimport tawkTo from 'tawkto-react';\nimport { ENV } from './config/config';\nimport './App.css';\n// import 'swiper/swiper-bundle.css';\n\n\nconst App = () => {\n  // GaTracker()\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  useEffect(() => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n  \n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {\n              routes.map((route, index) => {\n                return (\n                  <PrivateRoute\n                    key={index}\n                    path={route.path}\n                    exact={route.exact}\n                    access={true}\n                    component={props =>\n                      <route.layout {...props} title={route.title}>\n                        <route.component {...props} />\n                      </route.layout>\n                    }\n                  />\n                )\n              })\n            }\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  )\n}\n\nexport default App\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/routes.js",["255","256","257"],"// layouts\nimport layout1 from './layouts/layout1/layout1';\nimport layout2 from './layouts/layout2/layout2';\nimport layout3 from './layouts/layout3/layout3';\nimport layout4 from './layouts/layout4/layout4';\n// components\n// import Home from './components/home/home';\nimport Dashboard from './Screens/Home/home'\nimport FourStepForm from './Screens/FourStepForm/index'\n// import ExploreAll from './components/explore/explore-all';\n// import LiveAuctions from './components/auctions/live-auctions-list';\n// import ItemDetails from './components/item-detail/item-detail';\n// import Activity from './components/activity/activity';\n// import Blog from './components/blog/blog';\n// import BlogSingle from './components/blog-single/blog-single';\n// import HelpCenter from './components/help-center/help-center';\n// import Authors from './components/authors-list/authors-list';\n// import Author from './components/author/author';\n// import Profile from './components/profile/profile';\n// import CreateNFT from './components/create-nft/create-nft';\n// import MyCollections from './components/collections/my-collections';\n// import CreateCollection from './components/create-collection/create-collection';\n// import CollectionDetails from './components/collections/collection-details';\n// import Wallet from './components/wallet/wallet';\n// import Signup from './components/signup/signup';\n// import Contact from './components/contact/contact';\n// import SellNFT from './components/nfts/sell-nft';\n// import NotFound from './components/not-found/not-found';\n// import HowItWorks from './components/how-it-works/how-it-works';\n// import PrivacyTerms from './components/privacy-&-terms/privacy-&-terms';\n\n// routes\nconst routes = [\n    { path: '/', access: true, exact: true, title: 'Home', layout: layout2, component: Dashboard },\n    { path: '/fourStepForm', access: true, exact: true, title: 'Explore', layout: layout2, component: FourStepForm },\n    // { path: '/explore-all', access: true, exact: true, title: 'Explore', layout: layout2, component: ExploreAll },\n    // { path: '/auctions', access: true, exact: true, title: 'Live Auctions', layout: layout2, component: LiveAuctions },\n    // { path: '/item-details', access: true, exact: true, title: 'Item Details', layout: layout2, component: ItemDetails },\n    // { path: '/sell-item/:itemId?', access: true, exact: true, title: 'Sell Item', layout: layout2, component: SellNFT },\n    // { path: '/activity', access: true, exact: true, title: 'Activity', layout: layout2, component: Activity },\n    // { path: '/blog', access: true, exact: true, title: 'Blog', layout: layout1, component: Blog },\n    // { path: '/blog-single', access: true, exact: true, title: 'Blog Single', layout: layout1, component: BlogSingle },\n    // { path: '/help-center', access: true, exact: true, title: 'Help Center', layout: layout1, component: HelpCenter },\n    // { path: '/authors', access: true, exact: true, title: 'Authors', layout: layout2, component: Authors },\n    // { path: '/author/:authorId?', access: true, exact: true, title: 'Author Profile', layout: layout1, component: Author },\n    // { path: '/profile', access: true, exact: true, title: 'Profile', layout: layout1, component: Profile },\n    // { path: '/create', access: true, exact: true, title: 'Create', layout: layout2, component: CreateNFT },\n    // { path: '/collections', access: true, exact: true, title: 'Collections', layout: layout2, component: MyCollections },\n    // { path: '/collection/create', access: true, exact: true, title: 'Create Collection', layout: layout2, component: CreateCollection },\n    // { path: '/collection-details/:collectionId?', access: true, exact: true, title: 'Collection Details', layout: layout1, component: CollectionDetails },\n    // { path: '/login', access: true, exact: true, title: 'login', layout: layout4, component: Wallet },\n    // { path: '/signup', access: true, exact: true, title: 'Signup', layout: layout4, component: Signup },\n    // { path: '/contact', access: true, exact: true, title: 'Contact', layout: layout1, component: Contact },\n    // { path: '/how-it-works', access: true, exact: true, title: 'How It Works', layout: layout1, component: HowItWorks },\n    // { path: '/privacy-and-terms', access: true, exact: true, title: 'Privacy & Terms', layout: layout1, component: PrivacyTerms },\n    // { path: '/*', access: true, exact: true, name: 'Not Found', layout: layout3, component: NotFound }\n];\n\nexport default routes;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/index.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/full-page-loader/full-page-loader.js",["258"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/auctions.reducer.js",["259"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/nfts.reducer.js",["260"],"import { BEFORE_NFT, GET_NFTS, GET_NFT, UPSERT_NFT,NFTALL } from '../../redux/types';\n\nconst initialState = {\n    nftsData: {},\n    nftAll:{},\n    nftsAuth: false,\n    upsertAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case UPSERT_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                upsertAuth: true\n            }\n        case GET_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n            case NFTALL:\n        \n                return {\n                    ...state,\n                    nftAll: action.payload,\n                }\n            \n        case GET_NFTS:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n        case BEFORE_NFT:\n            return {\n                ...state,\n                nftsData: {},\n                nftsAuth: false,\n                upsertAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.reducer.js",["261"],"import { BEFORE_USER, SET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, GET_USER } from '../../redux/types';\n\nconst initialState = {\n    userData: null,\n    userAuth: false,\n    creatorsAuth: false,\n    topSellersAuth: false,\n    individualUserAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_USER:\n            return {\n                ...state,\n                userData: action.payload,\n                userAuth: true\n            }\n        case GET_USER:\n            return {\n                ...state\n            }\n        case SET_CREATORS:\n            return {\n                ...state,\n                creators: action.payload,\n                creatorsAuth: true\n            }\n        case TOP_SELLERS:\n            return {\n                ...state,\n                sellers: action.payload,\n                topSellersAuth: true\n            }\n        case SET_INDIVIDUAL_USER:\n            return {\n                ...state,\n                individualUser: action.payload,\n                individualUserAuth: true\n            }\n        case BEFORE_USER:\n            return {\n                ...state,\n                userData: null,\n                userAuth: false,\n                creatorsAuth: false,\n                topSellersAuth: false,\n                individualUserAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/reducer/reducer.js",["262"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  }\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n            \n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.reducer.js",["263"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/home/home.reducer.js",["264","265"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/categories/categories.reducer.js",["266"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.reducer.js",["267"],"import { BEFORE_COLLECTION, GET_COLLECTION, SET_AUTH_STATE, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\n\nconst initialState = {\n    collection: null,\n    collections: null,\n    allCollections:null,\n    pagination: null,\n    deleteAuth: false,\n    upsertAuth: false,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n            case ALL_COLLECTIONS:\n                return {\n                    ...state,\n                    collection: action.payload.allCollections,\n                    getAuth: true\n                }\n        case SET_AUTH_STATE:\n            return {\n                ...state,\n                getAuth: false\n            }\n\n        case UPSERT_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                upsertAuth: true\n            }\n        case DELETE_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                deleteAuth: true\n            }\n        case GET_COLLECTIONS:\n            return {\n                ...state,\n                collections: action.payload.collections,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_COLLECTION:\n            return {\n                ...state,\n                collection: null,\n                collections: null,\n                pagination: null,\n                deleteAuth: false,\n                upsertAuth: false,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.reducer.js",["268"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.reducer.js",["269"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/bids/bids.reducer.js",["270"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            return {\n                ...state,\n                bids: action.payload.bids,\n                pagination: action.payload.pagination,\n                highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.reducer.js",["271"],"import { BEFORE_FAQ, GET_FAQS } from '../../redux/types';\n\nconst initialState = {\n    faqs: null,\n    faqsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FAQS:\n            return {\n                ...state,\n                faqs: action.payload,\n                faqsAuth: true\n            }\n        case BEFORE_FAQ:\n            return {\n                ...state,\n                faqs: null,\n                faqsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.reducer.js",["272"],"import { BEFORE_CONTACT, CREATE_CONTACT } from '../../redux/types';\n\nconst initialState = {\n    contactAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case CREATE_CONTACT:\n            return {\n                ...state,\n                contactAuth: true\n            }\n        case BEFORE_CONTACT:\n            return {\n                ...state,\n                contactAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/Home/home.js",["273","274"],"import {useEffect } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { connect } from \"react-redux\";\n// import { hometest } from \"../../Redux/actions/actions\";\nimport Navbar from \"../../components/Navbar/navbar\";\nimport SimpleSlider from \"../../components/Slider/slider\";\n// import image from \"../../assets/images/test.jpg\";\nimport Polygon from \"../../assets/images/icon 2.svg\";\n// import Ethereum from \"../../assets/images/Ethereum.svg\";\nimport Cardano from \"../../assets/images/icon 3.svg\";\nimport Binance from \"../../assets/images/icon4.svg\";\nimport Ethereum from \"../../assets/images/icon1.png\";\n// import nft2 from \"../../assets/images/icon4.svg\";\n// import nft3 from \"../../assets/images/icon 2.svg\";\n////////////////////////\nimport nft1 from \"../../assets/images/nft1.jpg\";\nimport nft2 from \"../../assets/images/nft2.webp\";\nimport nft3 from \"../../assets/images/nft3.jpeg\";\nimport nft4 from \"../../assets/images/nft4.webp\";\nimport nft5 from \"../../assets/images/nft5.jpg\";\nimport GaTracker from '../../gaTracker/gaTracket'\n\nimport \"./home.css\";\n\nconst Home = (props) => {\n \n  //  useEffect(()=>{\n  // },[])\n  GaTracker()\n  const networksData = [\n    { name: \"Ethereum\", image: Ethereum },\n    { name: \"Polygon\", image: Polygon },\n    { name: \"Cardano\", image: Cardano },\n    { name: \" Binance SmartChain\", image: Binance },\n  ];\n\n  const history = useHistory();\n  const wordsFamousNfts = [\n    {\n      img: nft3,\n      link: \"https://niftygateway.com/itemdetail/primary/0x0151834a6997f89eb8372ac54ac077d79bb4d1e0/7\",\n    },\n    {\n      img: nft1,\n      link: \"https://onlineonly.christies.com/s/beeple-first-5000-days/beeple-b-1981-1/112924?ldp_breadcrumb=back\",\n    },\n    {\n      img: nft2,\n      link: \"https://niftygateway.com/marketplace?collection=0x12f28e2106ce8fd8464885b80ea865e98b465149&tokenId=100010001\",\n    },\n    { img: nft4, link: \"https://foundation.app/@snowden/~/24437\" },\n    { img: nft5, link: \"https://www.phillips.com/mdj\" },\n  ];\n\n  return (\n    <div className=\"home-container p-1\">\n      <div className=\"content\">\n        <div className=\"home-navbar\">\n          <Navbar />\n        </div>\n        <div className=\"mt-4 details-container\">\n          <div className=\" d-flex justify-content-between home-info-container\" >\n\n            <div className=\" \">\n              <div className=\"details\">\n                <div className=\"\" style={{ maxWidth: \"31rem\" }}>\n                  <p\n                    className=\"text-white mint-title\"\n                    style={{ fontSize: \"46px\", fontWeight: \"bold\" }}\n                  >\n                    Let's Mint Your NFT's\n                  </p>\n                  {/* <p className=\"text-white\" style={{ fontSize: \"20px\" }}>\n                    Lorem Ipsum is simply dummy text of the printing and\n                    typesetting industry.{\" \"}\n                  </p> */}\n                </div>\n              </div>\n\n              <div className=\"networks \">\n                <p className=\"text-white select-network-heading\" style={{fontSize:\"36px\"}}>Select Network</p>\n                <div className=\"networks-list-container mt-4 d-flex \">\n                  {networksData.map((item, index) => {\n                    return (\n                      <div\n                        className=\"network\"\n                        disabled={true}\n                        key={index}\n                        // onClick={() => {\n                        //   if (item.name === \"Ethereum\") {\n                        //     setNetwork(item.name);\n                        //     // setFlag(true);\n                        //   }\n                        // }}\n                      >\n                        {/* <div\n                        className=\"position-relative network-image\"\n                          style={{\n                            backgroundColor: \"white\",\n                            width: \"4.7rem\",\n                            borderRadius: \"10px\",\n                            cursor: \"pointer\",\n                          }}\n                        > */}\n                          <img\n                            src={item.image}\n                            alt=\"coming soon\"\n                            style={{\n                              width: \"4rem\",\n                              cursor:\"pointer\"\n                              // padding: \"0rem 0rem 0rem 1rem\",\n                            }}\n                            className={`network-img ${\n                              \"Ethereum\" === item.name ? \"\" : \"selected-network\"\n                            }`}\n                          />\n                          {\n                            \"Ethereum\" !== item.name &&\n                            <span className=\"tooltiptext\">Coming soon</span>\n                          }\n                        {/* </div> */}\n                        <p\n                          className={`ml-1 mt-2 ${\n                            \"Ethereum\" === item.name\n                              ? \"network-title-yellow\"\n                              : \"network-title-white\"\n                          }`}\n                          style={{fontSize:\"14px\"}}\n                        >\n                          {item.name}\n                        </p>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-4\"\n                \n                onClick={() => history.push(\"/fourStepForm\")}\n              >\n                Lets Start\n              </button>\n            </div>\n\n\n\n            <div className=\"d-flex  home-slider-wrapper \">\n              <div\n                className=\"home-slider-container\"\n                style={{ marginLeft: \"2rem\" }}\n              >\n                <SimpleSlider wordsFamousNfts={wordsFamousNfts} />\n                {/* {\n                  !spinner &&\n                  \n                  } \n                  <div className=\"d-flex justify-content-center align-items-center h-100\" style={{display:`${spinner?\"none\":\"block\"}`}}>\n\n                    <div className=\"lds-ellipsis\"><div></div><div></div><div></div><div></div></div>\n                  </div>  */}\n              </div>\n            </div>\n\n          </div>\n\n\n\n\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// const mapStateToProps = (state) =>\n//   // console.log(state, \"state\"),\n//   ({\n//     hometest: state.home,\n//   });\n\n// export default connect(mapStateToProps, {\n//   hometest,\n// })(Home);\nexport default Home\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/index.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.reducer.js",["275"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Navbar/navbar.js",["276","277","278","279","280"],"// import react from 'react'\nimport './navbar.css'\nimport {useHistory} from 'react-router-dom'\n\nconst Navbar =()=>{\n  const history=useHistory()\n    return (\n        <div className=\"nav \">\n  <input type=\"checkbox\" id=\"nav-check\"/>\n  <div className=\"nav-header\">\n    <div className=\"nav-title\" onClick={()=>history.push('/')}>\n      MintsClub\n    </div>\n  </div>\n  <div className=\"nav-btn\">\n    <label htmlFor=\"nav-check\">\n      <span></span>\n      <span></span>\n      <span></span>\n    </label>\n  </div>\n  \n  <div className=\"nav-links\">\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\" style={{color:\"#ffd33e\"}}>Home</a>\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\">Twitter</a>\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\">Discord</a>\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\">Telegram</a>\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\">Reddit</a>\n  </div>\n</div>\n    )\n}\n\n\nexport default Navbar","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Slider/slider.js",["281"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/actions/actions.js",["282","283"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/web3.js",["284","285"],"import Web3 from \"web3\";\nimport { toast } from 'react-toastify'\n// import contractAbi from './../utils/abis/token.json';\nimport {ENV} from './../config/config';\n// import liveAuctionsAbi from './abis/ARISwapToken.json'\n// import {liveAuction} from './abiSetup.js'\n// import {placeBid} from '../components/bids/bids.action'\n// import {setFixedPriceNftTOken, acceptBit, placeBidApi} from './functions'\n// import {changeOwnerShip} from './functions'\n// import { Redirect } from 'react-router-dom';\n\n// let Contract = require('web3-eth-contract');\n\n// const nftContractAddress = ENV.nftContractAddress;\n// Contract.setProvider();\n// console.log(window.web3?.currentProvider,\"current provider\")\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN)\n\n//get web3\nvar web3Provider=null;\nexport const getWeb3 = async ()=> {\n    // if(window.ethereum) {\n    //     const web3 = new Web3(Web3.givenProvider);\n    //     return web3;\n    // }\n    // else {\n    //     return false;   \n    // }\n    ////////////////////////////////\n    if (window.ethereum) {\n        web3Provider = window.ethereum;\n        try {\n          // Request account access\n          await window.ethereum.enable();\n        } catch (error) {\n          // User denied account access...\n          console.error(\"User denied account access\")\n        }\n      }\n      // Legacy dapp browsers...\n      else if (window.web3) {\n        web3Provider = window.web3.currentProvider;\n      }\n      // If no injected web3 instance is detected, fall back to Ganache\n      else {\n        web3Provider = new Web3.providers.HttpProvider('http://localhost:7545');\n      }\n\n     var web3 = new Web3(web3Provider);\n      return web3\n    ///////////////////////////////\n}\n\n// TEMP. ADDING THIS METHOD - COPY OF CONNECTMETAMASK\n// export const connectMetamaskCopy = async ()=> {\n//     if(window.ethereum) {\n//         const web3 = new Web3(Web3.givenProvider);\n//         const network = await web3.eth.net.getNetworkType();\n//         await window.ethereum.enable();\n//         let accounts = await web3.eth.getAccounts();\n//         let chainId = await web3.eth.getChainId();\n//         if(chainId !== requiredChainId) {\n//             // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n//         }\n//         return accounts[0];\n//     }\n//     else {\n//         // alert(\"Please install metamask to connect to the Marketplace\");\n//         toast.error(\"Please install metamask to connect to the Marketplace\");\n//     }\n// }\nexport const connectMetamaskCopy = async (address) => {\n    if (window.ethereum) {\n      const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      let chainId = await web3.eth.getChainId();\n      // console.log(chainId, \"chainId\");\n      let currentNetwork = getNetworkName(chainId);\n      if (!currentNetwork) {\n        toast.error(\"Please Connect your metamask with Ethereum Network\");\n        return false;\n      }\n      if (chainId !== requiredChainId) {\n        // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n      }\n      // console.log(accounts[0],\"account==>\")\n      if (accounts[0]) {\n        if(accounts[0]===address)\n        {\n          toast.success(\"wallet is already connected\");\n        }\n        else {\n  \n          toast.success(\"wallet connected\");\n        }\n        //    console.log('hello');\n        return accounts[0];\n      } else {\n        let address = await signRequest();\n  \n        toast.success(\"wallet connected\");\n        return address[0];\n      }\n    } else {\n      // alert(\"Please install metamask to connect to the Marketplace\");\n      toast.error(\"This app requires metamask,Please Install Metamask \");\n    }\n  };\n  export const getWalletAddress=async ()=>{\n    const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      return accounts[0]\n  }\nexport const connectMetamask = async ()=> {\n    if(window.ethereum) {\n        const web3 = new Web3(Web3.givenProvider);\n        window.web3=new Web3(window.ethereum)\n        const network = await web3.eth.net.getNetworkType();\n        await window.ethereum.enable();\n        let accounts = await web3.eth.getAccounts();\n        let chainId = await web3.eth.getChainId();\n        if(chainId !== requiredChainId) {\n            // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n        }\n        return accounts[0];\n    }\n    else {\n        // alert(\"Please install metamask to connect to the Marketplace\");\n        toast.error(\"Please install metamask to connect to the Marketplace\");\n    }\n}\n\nexport const getNetworkNameByChainId=async ()=>{\n    if (window.ethereum) {\n      const web3 = new Web3(Web3.givenProvider);\n      // const network = await web3.eth.net.getNetworkType();\n      await window.ethereum.enable();\n      let accounts = await web3.eth.getAccounts();\n      let chainId = await web3.eth.getChainId();\n      // console.log(chainId,\"chainId\")\n      // console.log(chainId, \"chainId\");\n      let currentNetwork = getNetworkName(chainId);\n      // console.log(currentNetwork,\"currentNetwork==>\")\n      return currentNetwork\n    }\n  }\n  \n  const getNetworkName = (chainId) => {\n    let networks = {\n      1: \"Ethereum Mainnet\",\n      4: \"Ethereum Rinkby\",\n      3: \"Ethereum Ropsten\",\n      42: \"Ethereum Kovan\",\n      5: \"Ethereum Goerli\",\n    };\n    return networks[chainId]\n  };\n  \n\nexport const signRequest = async ()=> {\n    if(window.ethereum) {\n        // const web3 = await getWeb3();\n        // if (!web3) {\n        //     toast.error(\"No web3 instance found\");\n        //     return false;\n        // }\n   \n        const web3 = new Web3(Web3.givenProvider);\n        let accounts = await web3.eth.getAccounts();\n        let address = accounts[0];\n        let signature = await handleSignMessage(address);\n        // placeBid()\n        // console.log(signature,\"signature===>\")\n        return signature;\n    }\n    else {\n        alert(\"Please install metamask to connect to the Marketplace\");\n    }\n}\n\n// export const testing=()=>{\n//     const test=web3.eth.\n// }\n\n// export const mint = async (metaData) => {\n//     // alert(\"dfdfdf\")\n//     const web3 = await getWeb3();\n//     if (!web3) {\n//         toast.error(\"No web3 instance found\");\n//         return false;\n//     }\n//     // let tokenContract1 = new Contract(liveAuctionsAbi., nftContractAddress);\n//     try {\n   \n//         let connectedAddress = await connectMetamask();\n//         // console.log(connectedAddress,\"connectedAddress\")\n//         let tokenContract = new Contract(liveAuctionsAbi, nftContractAddress);\n//         // const txCount = await web3.eth.getTransactionCount(connectedAddress);\n//         const myNewData = await tokenContract.methods\n//             .createNewNFT(connectedAddress, metaData)\n//             .encodeABI();\n        \n//             // console.log(myNewData,\"checking create nft  result==>\")\n//         // const gasLimit = await web3.eth.estimateGas({\n//         //     from: connectedAddress,\n//         //     nonce: txCount,\n//         //     to: nftContractAddress,\n//         //     data: myNewData,\n//         // });\n//         // const gas2 = await web3.eth.getGasPrice();\n//         // const transactionParameters = {\n//         //     nonce: web3.utils.toHex(txCount), // ignored by MetaMask\n//         //     gasPrice: web3.utils.toHex(gas2), // customizable by user during MetaMask confirmation.\n//         //     gasLimit: web3.utils.toHex(gasLimit), // customizable by user during MetaMask confirmation.\n//         //     to: nftContractAddress, // Required except during contract publications.\n//         //     from: connectedAddress, // must match user's active address.\n//         //     data: myNewData, // Optional, but used for defining smart contract creation and interaction.\n//         //     // chainId: '0x3', // Used to prevent transaction reuse across blockchains. Auto-filled by MetaMask.\n//         // };\n//         // // As with any RPC call, it may throw an error\n//         // const txHash = await window.ethereum.request({\n//         //     method: 'eth_sendTransaction',\n//         //     params: [transactionParameters],\n//         // });\n//         toast.success(`Success! NFT Created successfully!`)\n//         return true;\n//     } catch (e) {\n//         // alert(\"inCatch\")\n//         let eMessage = e.message.split('{')[0] || '';\n//         // console.log(eMessage,\"message==>\")\n//         toast.error(eMessage);\n//         return false;\n//     }\n    \n// }\n\nconst handleSignMessage = (address) => {\n    return new Promise((resolve, reject) =>{\n        try {\n            const web3 = new Web3(Web3.givenProvider);\n            web3.eth.personal.sign(\n                web3.utils.fromUtf8(`${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`),\n                address,\n                (err, signature) => {\n                    if (err) return reject(err);\n                    return resolve(signature);\n                }\n            )\n        }\n        catch (e) {\n            console.log(e);\n        }\n        \n    }\n    );\n};\n\n// export const ClaimFundsAfterBidding = (token) => {\n//     // getting accounts\n//     return new Promise ( async (resolve, reject) => {\n//     const web3 = new Web3(Web3.givenProvider);\n//      let accounts = await web3.eth.getAccounts();\n//      let address = accounts[0];\n//      liveAuction.methods.ClaimFundsAfterBidding(token).send(\n//          {\n//             from:address\n//         }\n//             ).then(x=> {\n        \n//             return resolve(x);\n//         });\n//      }).catch((err)=>{\n//         //  return reject(err);\n//         console.log(\"err in catch block error===> \",err)\n//     });\n// }\n\n// export const createNft= async (metaData,nftId)=>{\n//     //getting accounts\n//     const web3 = new Web3(Web3.givenProvider);\n//     let accounts = await web3.eth.getAccounts();\n//     // console.log(accounts,\"accounts\")\n//     let address = accounts[0];\n//     // console.log(address,\"addresss==>\")\n//     console.log(metaData,\"metaData==>\")\n//     console.log(liveAuction,\"liveAuction.==>\")\n//     console.log(liveAuction.methods,\"liveAuction.methods==>\")\n//     //create NFT\n//     liveAuction.methods.createNewNFT(address,metaData).send({\n//             value: 1000000000000000,\n//             // value:0,\n//             from:address,\n//             to:address,\n//          }\n//         ).then((res)=>{\n//             // console.log(res.events.Transfer.returnValues.tokenId,\"res of createNFT===>\")\n//             let data={\n//                 nftToken:res.events.Transfer.returnValues.tokenId,\n//                 nftId\n//             }\n\n//             setNftToken(data)\n\n//             toast.success(\"NFT created successfully\")\n//             // window.location.href= '/explore-all'\n//     })\n//     .catch((err)=>{\n//         console.log('err', err)\n//         if(err.code=== 4001){\n//             let url = process.env.REACT_APP_BASE_URL + `nfts/update`;\n//              var payload = {\n//                  status: 0,\n//                  _id:nftId\n//              }\n//             fetch(url, {\n//              method: 'POST',\n//              headers: {\n//                 'content-type': 'application/json',\n//                 'Authorization': ENV.Authorization,\n//                 'x-auth-token': ENV.x_auth_token,\n//                 'Access-Control-Allow-Origin': '*',\n//                 'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n//             },\n//             body: JSON.stringify(payload)\n//         }).then(res => res.json()).then(data => {\n          \n//             console.log(data,\"data==>\")\n//             if (data.success === false) {\n//                 toast.error(err.message)\n//             } \n//         }).catch(error => {\n//             // alert(\"in setting nft then\")\n//             console.log(error,\"error in catch blcok\")\n//             if (error.response && error.response.data) {\n//                 toast.error(err.message)\n            \n//             }\n//             else {\n//         toast.error(\"Transaction Failed Please check wallet history\")\n\n//             }\n         \n//         })\n//         }\n        \n//     })\n//     // return res\n// }\n\n    //openNFTForBidding\n    // export const openNFTForBidding=async(token,timeduration)=>{\n    //     // console.log(token,timeduration,\"checking token and time duration\")\n    //      //openNFTForBidding\n    //      let tokenId=+token;\n    //      const web3 = new Web3(Web3.givenProvider);\n\n    //      let accounts = await web3.eth.getAccounts();\n    //     //  console.log(accounts,\"accounts\")\n    //      let address = accounts[0];\n    //     //  console.log(address,\"addresss==>\")\n    //    liveAuction.methods.openNFTForBiddingForSpecific(tokenId,timeduration).send({from:address}).then((res)=>{\n    //         //  console.log(res ,\"res of openNFTForBidding===>\")\n           \n    // })\n    // .catch((err)=>{\n    //     toast.error(\"Transaction Failed Please check wallet history\")\n    // })\n    // }\n    \n    // export const setNftToken=(body)=>{\n    //     // console.log(body,\"body===>\")\n    //     // let dummy={\n    //     //     nftToken:\"123\",\n    //     //     nftId:\"123\"\n\n    //     // }\n\n    //     let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n\n    //     fetch(url, {\n    //      method: 'POST',\n    //      headers: {\n    //         'content-type': 'application/json',\n    //         'Authorization': ENV.Authorization,\n    //         'x-auth-token': ENV.x_auth_token,\n    //         'Access-Control-Allow-Origin': '*',\n    //         'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n    //     },\n    //     body: JSON.stringify(body)\n    // }).then(res => res.json()).then(data => {\n    //     // alert(\"in setting nft then\")\n    //     // console.log(data,\"data==>\")\n    //     if (data.success) {\n    //         window.location.href= '/explore-all'\n    //     //    console.log(data,\"data in success\")\n    //     } else {\n         \n    //     }\n    // }).catch(error => {\n    //     // alert(\"in setting nft then\")\n    //     console.log(error,\"error in catch blcok\")\n    //     if (error.response && error.response.data) {\n        \n    //     }\n     \n    // })\n    // }\n\n    // export const NftOwner=async ()=>{\n    //     const web3 = new Web3(Web3.givenProvider);\n\n    //     let accounts = await web3.eth.getAccounts();\n    //     // console.log(accounts,\"accounts\")\n    //     let address = accounts[0];\n    // //     console.log(address,\"addresss==>\")\n    // // //OwnerNFT\n    //    liveAuction.methods.ownerOf(5).send({from:address}).then((res)=>{\n    //         //  console.log(res,\"res of createNFT===>\")\n    // })\n    // .catch((err)=>{\n    //     console.log(err,\"err in catch block error===>\")\n    // })\n    // }\n\n    // export const placeBidNft=async(body,tokenId,price,toAddress,fromAddress)=>{\n    //     const web3 = new Web3(Web3.givenProvider);\n\n    //     let accounts = await web3.eth.getAccounts();\n    //     // console.log(accounts,\"accounts\")\n    //     let address = accounts[0];\n    //     // console.log(address,\"addresss==>\")\n    //     // console.log(price,\"price888888888888888888888\")\n    //     // console.log(toAddress,\"toAdress\")\n   \n    //         liveAuction.methods.placeBid(tokenId).send({value:price.amount,from:address}).then((res)=>{\n    //             console.log('bid before', res)\n    //             console.log('body', body)\n    //             placeBidApi(body,tokenId,price,toAddress,fromAddress)\n    //             // window.location.href= '/explore-all'\n    //         //  console.log(res,\"res of place bid result===>\")\n    //     })\n    //     // alert(price)\n    //   .catch((err)=>{\n    //         toast.error(\"Transaction Failed Please check wallet history\")\n    //       })\n    // }\n\n//     export const SellOnFixedPrice=async (tokenId,price)=>{\n//         const web3 = new Web3(Web3.givenProvider);\n\n//         let accounts = await web3.eth.getAccounts();\n//         // console.log(accounts,\"accounts\")\n//         let address = accounts[0];     \n//             //   Put on sale\n//             // console.log('live auction', liveAuction)\n//             liveAuction.methods.PutOnSale(tokenId).send({from:address}).then((res)=>{\n                \n//                 // setFixedPriceNftTOken()\n\n//     })\n     \n// .catch((err)=>{\n//     toast.error(\"Transaction Failed Please check wallet history\")\n// })\n//     }\n\n//     export const BuyFixedPriceNFTs=async (price,tokenId,nftOwnerId)=>{\n//         // console.log(tokenId,\"token id in buy fixed price==>\")\n//         const web3 = new Web3(Web3.givenProvider);\n\n//         let accounts = await web3.eth.getAccounts();\n//         // console.log(accounts,\"accounts\")\n//         let address = accounts[0];\n//         // console.log(address,\"addresss==>\")\n//         // console.log(price,\"price888888888888888888888\")\n//         // alert(price)\n//         let finalPrice = price.toString()\n//         // console.log('final price', finalPrice)\n       \n//             liveAuction.methods.BuyFixedPriceNFTs(tokenId).send({value:finalPrice,from:address}).then((res)=>{\n//                 // console.log(res,\"res of place bid result===>\")\n//                 let currentUserId=ENV.getUserKeys('_id')._id;\n//                 changeOwnerShip(nftOwnerId,currentUserId)\n\n\n//         })\n//             //   Place Bid\n       \n// .catch((err)=>{\n//     toast.error(\"Transaction Failed Please check wallet history\")\n// })\n//     }\n\n//     export const getCurrentAddress= async ()=>{\n//         const web3 = new Web3(Web3.givenProvider);\n\n//         let accounts = await web3.eth.getAccounts();\n//         // console.log(accounts,\"accounts\")\n//         let address = accounts[0];\n//         return address\n//     }\n\n//     export const acceptNftOffer=async(tokenId,body)=>{\n\n\n//         const web3 = new Web3(Web3.givenProvider);\n\n//         let accounts = await web3.eth.getAccounts();\n//         // console.log(accounts,\"accounts\")\n//         let address = accounts[0];\n//         // console.log(address,\"addresss==>\")\n//         // console.log('token before sending', tokenId)\n//             //  Accept offer \n//        liveAuction.methods.acceptOffer(tokenId).send({from:address}).then((res)=>{\n           \n//         // console.log(res,\"res of accept bid result===>\")\n//         // toast.success(\"Bid accepted successfully\")\n//         acceptBit(tokenId,body)\n    \n// })\n// .catch((err)=>{\n//    console.log(err,\"err in catch block error===>\")\n// })\n//     }\n// export const signTransaction=async ()=>{\n\n//     const web3 = new Web3(Web3.givenProvider);\n//     // const nonce = await web3.eth.getTransactionCount(\"myAddress\", 'latest');\n//     const rawTransaction = {\n//         \"from\": \"Keystore account id\",\n//         \"to\": \"Account you want to transfer to\",\n//         \"value\": 100,\n//         \"gas\": 0.21000,\n    \n//       };\n\n//       const signedTx = await web3.eth.accounts.signTransaction(rawTransaction, \"PRIVATE_KEY\");\n\n//       web3.eth.sendSignedTransaction(signedTx.rawTransaction, function(error, hash) {\n//         if (!error) {\n//         //   console.log(\"🎉 The hash of your transaction is: \", hash, \"\\n Check Alchemy's Mempool to view the status of your transaction!\");\n//         } else {\n//         //   console.log(\"❗Something went wrong while submitting your transaction:\", error)\n//         }\n//        });\n   \n// }\n\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step2/Step2.js",["286","287","288","289"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/Step3.js",["290","291","292","293","294","295","296"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step1/Step1.js",["297","298","299"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step4/Step4.js",["300","301","302","303","304","305","306"],"import { useState, useEffect } from \"react\";\nimport MetamaskImg from \"../../../../assets/images/metamask.svg\";\nimport RefreshImg from \"../../../../assets/images/Refresh.svg\";\nimport DetailsImg from \"../../../../assets/images/Details.svg\";\nimport DiscordImg from \"../../../../assets/images/Discord.svg\";\nimport ReactCaptcha from \"../../../../components/Captcha/Captcha\";\n// import { connectMetamaskCopy } from \"../../../../Utils/web3\";\nimport PreviewModal from \"../../../../components/PreviewModal/PreviewModal\";\n// import { CopyToClipboard } from \"react-copy-to-clipboard\";\nimport { MdContentCopy } from \"react-icons/md\";\nimport { getNetworkNameByChainId} from \"../../../../utils/web3\";\n\n\nimport {\n  connectWallet,\n  contractResponse,\n} from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\n\n\nimport \"./Step4.css\";\nimport copy from \"copy-to-clipboard\";\n\nimport { toast } from \"react-toastify\";\nimport {getWalletAddress} from '../../../../utils/web3'\n// import Stepper from \"../../../../Components/Stepper/Stepper\";\n// import { propTypes } from \"react-bootstrap/esm/Image\";\nconst Step4 = (props) => {\n  // console.log(props,\"props in setp 4\")\n  const [isVisible, setIsvisible] = useState(false);\n  // const [isValidate, setIsvalidate] = useState(false);\n  const [captchaStatus, setCaptchaStatus] = useState(false);\n  const [captchaError, setCaptchaError] = useState(false);\n  const [captchaMessage, setCaptchaMessage] = useState(\n    \"Invalid Captchca Please Try Again\"\n  );\n  const [email, setEmail] = useState(props.email);\n  const [deployNetwork, setDeployNetwork] = useState(\"\");\n  const [deploy, setDeploy] = useState(false);\n  // const [compile, setCompile] = useState(false);\n  const [loadingMessage, setLoadingMessage] = useState(\"\");\n  const [error, setError] = useState(false);\n  const [emailError, setEmailError] = useState(false);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n\n  //previewModal\n  const [previewModal, setPreviewModal] = useState(false);\n  const [previewModalStep, setPreviewModalStep] = useState(1);\n  const [maxLimit,setMaxLimit]=useState(false)\n  // const [textCopy,setTextCopy]=useState(false)\n\n  ///copy text ////////////////\n\n  // const [copySuccess, setCopySuccess] = useState('');\n  // const textAreaRef = useRef(null);\n\n  // function copyToClipboard(e) {\n  //   textAreaRef.current.select();\n  //   document.execCommand('copy');\n  //   // This is just personal preference.\n  //   // I prefer to not show the the whole text area selected.\n  //   e.target.focus();\n  //   setCopySuccess('Copied!');\n  // };\n  ////////////\n  const handleCaptcha = (value) => {\n    // console.log(value);\n    setCaptchaStatus(value);\n    setCaptchaError(false);\n    // if (value) {\n    //   setIsvalidate(true);\n    // }\n  };\n\n  const onChangeEmail = (e) => {\n    setError(false);\n    setEmailError(false);\n    setEmail(e.target.value.trimStart());\n    props.handleStep4Info(e.target.value.trimStart());\n  };\n\n  const handleVisible = () => {\n    setIsvisible(true);\n  };\n\n  const submitCaptcha = () => {\n    // console.log(captchaStatus, \"captchaStatus\");\n    if (captchaStatus) {\n      // setIsvalidate(true);\n      props.handleCaptchaValidation(true);\n    } else {\n      setCaptchaError(true);\n    }\n  };\n\n  const onConnect = () => {\n    // props.connectWallet()\n    if (!email) {\n      setEmailError(true);\n      setErrorMessage(\"Email is required\");\n      return \"\";\n    }\n    if (\n      !String(email)\n        .toLowerCase()\n        .match(\n          /^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/\n        )\n    ) {\n      setEmailError(true);\n      setErrorMessage(\"Email must be valid\");\n      return \"\";\n    } else {\n      // alert(\"else\")\n    }\n    getWalletAddress().then((address)=>{\n\n      let count = localStorage.getItem(address);\n      // console.log(count,\"count\")\n      if (+count > 5) {\n        toast.error(\"Maximum Deployment Limit Reached with This Wallet Address! Please contact support.\");\n        setMaxLimit(true)\n        return \"\";\n      }\n      else {\n        setMaxLimit(false)\n      }\n    })\n\n    if (email === \"\") {\n      setError(true);\n      return \"\";\n    }\n    // setLoadingMessage(\"Please wait your contract is Deploying!\");\n    // setDeploy(true);\n    // props.handleStep4Info(email, deployNetwork);\n    props.handleDeployContract();\n  };\n\n  const onReload = () => {\n    if (!props.contractReponse) {\n      setDeploy(true);\n\n      // props.contractResponse();\n      props.handleStep4Info(email, deployNetwork);\n      props.handleDeployContract();\n    }\n  };\n\n  const onMint = () => {\n    if (email === \"\") {\n      setError(true);\n      return \"\";\n    }\n\n    getNetworkNameByChainId()\n      .then((network) => {\n        // console.log(network,\"network==>\")\n        // console.log(props,\"props==>9\")\n        if (network === props.connectedNetwork || !props.connectedNetwork) {\n          setLoadingMessage(\"Please wait your NFT is Minting...\");\n\n          setDeploy(true);\n          props.handleStep4Info(email, deployNetwork);\n\n          props.handleMinting(props.contractInfo, email);\n        } else {\n          \n          toast.error(`Please connect with ${props.connectedNetwork} network`);\n        }\n      })\n      .catch((err) => {});\n  };\n  useEffect(() => {}, [props.connectedAddressFlag]);\n\n  useEffect(() => {\n    // console.log('all props ', props)\n    // console.log('response for contract ', props.contractResponse)\n  }, [props.contractResponse]);\n\n  // if (props.contractInfo) {\n  //   var { contractAddress } = props?.contractInfo;\n  //   // console.log(typeof(contractAddress),\"type=============>\")\n  // }\n  const handlePreviewModal = () => {\n    // if(!email)\n    setPreviewModalStep(1);\n    setPreviewModal(!previewModal);\n  };\n\n  const handlePreviewModalSteps = (action) => {\n    if (action === \"next\") {\n      setPreviewModalStep(2);\n    } else {\n      setPreviewModalStep(1);\n    }\n  };\n\n  const onDeploy = () => {\n    setPreviewModal(false);\n    setLoadingMessage(\"Please wait your contract is Deploying...\");\n    setDeploy(true);\n    props.handleStep4Info(email, deployNetwork);\n    props.handleDeployment();\n  };\n  // console.log(props,\"tokenId===>\")\n  const displayToken = () => {\n    if (props?.tokenId) {\n      return props.tokenId;\n    }\n    if (props.tokenMinted) {\n      // if (+props.supply === 2) {\n      //   return \"1,2\";\n      // } else if (+props.supply === 3) {\n      //   return \"1,2,3\";\n      // } else if (+props.supply === 4) {\n      //   return \"1,2,3,4\";\n      // } else if (+props.supply === 5) {\n      //   return \"1,2,3,4,5\";\n      // }\n      if(+props.supply >1) {\n        return ` 1-${props.supply}`\n      }\n    }\n  };\n  // console.log(props);\n  return (\n\n    <div className=\"step4-container w-80\">\n      {/* Metamask container */}\n      <div className=\"metamask-container \">\n        <div className=\" justify-content-between w-100 step-4-wrapper\">\n          <div>\n            <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n              <div className=\"position-relative\">\n                <label className=\"text-white step4-label\">Email</label>\n                {error && (\n                  <p className=\"mb-0\" style={{ color: \"red\" }}>\n                    Please Enter Email\n                  </p>\n                )}\n                <p\n                  className=\"position-absolute\"\n                  style={{ color: \"red\", top: \"0\", left: \"3.9rem\" }}\n                >\n                  *\n                </p>\n                <p className=\"mb-1\" style={{ color: \"red\" }}>\n                  {emailError && errorMessage}\n                </p>\n              </div>\n              <input\n                className=\"step-4-input mt-2\"\n                type=\"text\"\n                onChange={(e) => onChangeEmail(e)}\n                disabled={false}\n                value={email}\n                placeholder=\"example@gmail.com\"\n                style={{ maxWidth: \"22rem\", color: \"white\" }}\n              />\n            </div>\n            {/* <div className=\"position-relative mt-3\">\n              <label className=\"text-white step4-label\">Network</label>\n              <p\n                className=\"position-absolute\"\n                style={{ color: \"red\", top: \"0\", left: \"5.4rem\" }}\n              >\n                *\n              </p>\n            </div>\n            <select\n              class=\"form-select mt-2 network-dropdown\"\n              style={{\n                color: \"white\",\n                border: \"none\",\n                outline: \"none\",\n                maxWidth: \"22rem\",\n              }}\n              aria-label=\"Default select example\"\n              onChange={(e) => setDeployNetwork(e.target.value)}\n            >\n              <option className=\"network-option\" selected>\n                Select Network\n              </option>\n              <option className=\"network-option\" value=\"TestNet\">\n                TestNet\n              </option>\n              <option className=\"network-option\" value=\"MainNet\">\n                MainNet\n              </option>\n            </select> */}\n\n            {props.isValidate === false ? (\n              <div className=\"mt-4\">\n                <label className=\"text-white mb-2 step4-label\">\n                  Verify Captcha\n                </label>\n                <ReactCaptcha\n                  handleCaptcha={handleCaptcha}\n                  handleVisible={handleVisible}\n                  isVisible={isVisible}\n                />\n                <p className=\"text-danger mb-0 mt-1\">\n                  {captchaError && captchaMessage}\n                </p>\n                <button\n                  // className=\"btn btn-primary step4-btn\"\n                  className=\"btn btn-secondary start-btn\"\n                  style={{ marginTop: \"0.8rem\" }}\n                  onClick={() => submitCaptcha()}\n                >\n                  Submit\n                </button>\n              </div>\n            ) : (\n              <div className=\"d-flex mt-4\" style={{ flexDirection: \"column\" }}>\n                <div>\n                  <img\n                    src={MetamaskImg}\n                    style={{ width: \"2rem\", marginRight: \"0.8rem\" }}\n                  />\n                  <div className=\"position-relative\">\n                    <label className=\"text-white step4-label\">\n                      Connect Wallet\n                    </label>\n                    <p\n                      className=\"position-absolute\"\n                      style={{ color: \"red\", top: \"0\", left: \"10.4rem\" }}\n                    >\n                      *\n                    </p>\n                  </div>\n                </div>\n                <p className=\"mb-0 mt-2\" style={{ color: \"#aaabab\" }}>\n                  {\" \"}\n                  Connect Wallet with Metamask\n                </p>\n                <div className=\"d-flex align-items-center\">\n                  <button\n                    className={`btn btn-primary ${props.walletAddress ? 'step4-btn':'start-btn'}`}\n                    style={{ marginTop: \"0.8rem\" }}\n                    disabled={\n                      props.contractReponse || props.walletAddress\n                        ? true\n                        : false\n                    }\n                    onClick={() => onConnect()}\n                  >\n                    {props.walletAddress ? props.walletAddress : \"Connect\"}\n                  </button>\n                  {!props.loader && !props.contractReponse && (\n                    <img\n                      src={RefreshImg}\n                      style={{\n                        width: \"2rem\",\n                        marginLeft: \"0.8rem\",\n                        cursor: \"pointer\",\n                      }}\n                      disabled={props.contractReponse ? true : false}\n                      onClick={() => onReload()}\n                    />\n                  )}\n                </div>\n              </div>\n            )}\n          </div>\n\n          <div className=\"discord-container  \">\n            <div className=\"d-flex align-items-center\">\n              <img\n                src={DiscordImg}\n                style={{ width: \"2rem\", marginRight: \"1rem\" }}\n                alt=\"\"\n              />\n              <p className=\"step4-label text-white mb-0\"> Join Discord</p>\n            </div>\n            <p className=\"\" style={{ color: \"#aaabab\" }}>\n              Join the Discord Community\n            </p>\n            <button\n              className=\"btn btn-secondary start-btn mt-2\"\n              >\n                Join\n              </button>\n          </div>\n        </div>\n        {props.walletAddress && (\n          <div className=\"w-100 text-center mt-4\">\n            <button\n              className=\"btn btn-primary start-btn\"\n              style={{ marginTop: '0.8rem', backgroundColor: '#FCD70D  !important', color:'black !important' }}\n              disabled={props.contractReponse ? true : false}\n              onClick={handlePreviewModal}\n            >\n              Preview\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* Details */}\n\n      {props.loader &&\n      (props.contractReponse == false || props.mintingResponse === false) ? (\n        <div className=\"w-100 text-center mt-4\">\n          <div\n            className=\"spinner-border\"\n            style={{ color: \"white\" }}\n            role=\"status\"\n          ></div>\n          <p className=\"text-white\">{loadingMessage}</p>\n          {/* <Stepper/> */}\n        </div>\n      ) : (\n        (props.contractReponse || props.mintingResponse) &&\n        !props.contractError && (\n          <div className=\"step4-details-container mb-2 d-flex  w-100 justify-content-center w-100\">\n            <div>\n              <div className=\" w-100 d-flex justify-content-center mt-4\">\n                <div className=\"d-flex align-items-center\">\n                  <img\n                    src={DetailsImg}\n                    style={{ width: \"1.4rem\", marginRight: \"0.5rem\" }}\n                  />\n                  <p className=\"text-white details-title mb-0\">Details</p>\n                </div>\n              </div>\n              <div className=\"details-box \">\n                <div className=\"d-flex justify-content-between flex-row p-4 mt-4\">\n                  <div>\n                    <p className=\"info\">Contract Address</p>\n              \n                      \n                          {props.tokenMinted && props.tokenMinted.length >0  ?\n                           <p className=\"info\">   {\"Token ID's\"} </p>\n                            : props.tokenId ?\n                            <p className=\"info\">   {\"Token ID\"} </p>\n                            : \"\"}\n                       \n                    \n                    <p className=\"info\">Token Standard</p>\n                    <p className=\"info\">Blockchain</p>\n                  </div>\n\n                  <div>\n                    <div className=\"d-flex\">\n                      <p\n                        className=\"info\"\n                        style={{\n                          color: \"rgb(68, 209, 249)\",\n                          marginRight: \"0.3rem\",\n                        }}\n                      >\n                        {\" \"}\n                        {props.contractAddress\n                          ? `${String(props.contractAddress).substr(\n                              0,\n                              10\n                            )}.....${String(props.contractAddress).substr(\n                              -10,\n                              String(props.contractAddress).length\n                            )}`\n                          : \"0xsbms....dks33\"}\n                      </p>\n\n                      <MdContentCopy\n                        onClick={() => {\n                          copy(props?.contractAddress);\n                        }}\n                        style={{\n                          color: \"white\",\n                          width: \"1.3rem\",\n                          height: \"1.3rem\",\n                          cursor: \"pointer\",\n                          marginTop:\"1.4rem\"\n                        }}\n                      />\n                    </div>\n\n                    {\n                      props.tokenId ? (\n                        <p className=\"info\"> {displayToken()} </p>\n                      ) : props.tokenMinted && props.tokenMinted.length > 0 ? (\n                        <p className=\"info\"> {displayToken()} </p>\n                      ) : (\n                        \"\"\n                      )\n                      // props.tokenId ||(props.tokenMinted && props.tokenMinted.length >0) && (\n                      //   <p className=\"info\"> {displayToken()} </p>\n                      // )\n                    }\n\n                    <p className=\"info \">ERC-721</p>\n                    <p className=\"info \">Ethereum</p>\n                    {/* //if mint successfull */}\n                  </div>\n                </div>\n                <div className=\"w-100 text-center \">\n                  {!props.mintingResponse && (\n                    <button\n                      className=\"btn btn-primary mintbtn\"\n                      onClick={() => onMint()}\n                    >\n                      Let's Mint\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )\n      )}\n      <PreviewModal\n        previewModal={previewModal}\n        handlePreviewModal={handlePreviewModal}\n        handlePreviewModalSteps={handlePreviewModalSteps}\n        previewModalStep={previewModalStep}\n        onDeploy={onDeploy}\n        info={props.info}\n        maxLimit={maxLimit}\n      />\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  // console.log(state, \"state\"),\n  {\n    connectedAddress: state.dashboard.connectedAddress,\n    connectedAddressFlag: state.dashboard.connectedAddressFlag,\n    contractReponse: state.dashboard.contractReponse,\n    contractError: state.dashboard.contractError,\n    contractInfo: state.dashboard.contractInfo,\n    mintingResponse: state.dashboard.mintingResponse,\n    loader: state.dashboard.loader,\n    tokenId: state.dashboard.tokenId,\n    contractAddress: state.dashboard.contractAddress,\n    tokenMinted: state.dashboard.tokenMinted,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  connectWallet,\n  contractResponse,\n})(Step4);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.js",["307","308","309","310","311","312","313"],"import { useEffect, useState } from 'react';\nimport { Link } from 'react-router-dom';\nimport logo from '../../assets/images/logo.png'\nimport { connect } from 'react-redux'\nimport { getFooter } from './footer.action'\nimport {ENV} from './../../config/config';\n\nconst Footer = (props) => {\n\n    const [data, setData] = useState({\n        facebook: '',\n        twitter: '',\n        instagram: '',\n        youtube: '',\n        vine: '',\n        desc: ''\n    })\n\n    useEffect(() => {\n        props.getFooter()\n    }, [])\n\n    useEffect(() => {\n        if (props.settings.settingsAuth) {\n            setData(props.settings.settings)\n        }\n    }, [props.settings.settingsAuth])\n\n    return (\n        <footer className=\"footer-area\">\n            {/* Footer Top */}\n            <div className=\"footer-top\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Logo */}\n                                <Link className=\"navbar-brand\" to=\"/\">\n                                    <img src={logo} alt=\"\" />\n                                </Link>\n                                <p>{data.desc}</p>\n                                {/* Social Icons */}\n                                <div className=\"social-icons d-flex\">\n                                    {\n                                        data.facebook ?\n                                            <a href={data.facebook} target=\"_blank\">\n                                                <i className={\"fab fa-facebook-f\"} />\n                                                <i className={\"fab fa-facebook-f\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.twitter ?\n                                            <a href={data.twitter} target=\"_blank\">\n                                                <i className={\"fab fa-twitter\"} />\n                                                <i className={\"fab fa-twitter\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.instagram ?\n                                            <a href={data.instagram} target=\"_blank\">\n                                                <i className={\"fab fa-instagram\"} />\n                                                <i className={\"fab fa-instagram\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.youtube ?\n                                            <a href={data.youtube} target=\"_blank\">\n                                                <i className={\"fab fa-youtube\"} />\n                                                <i className={\"fab fa-youtube\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.vine ?\n                                            <a href={data.vine} target=\"_blank\">\n                                                <i className={\"fab fa-vine\"} />\n                                                <i className={\"fab fa-vine\"} />\n                                            </a> : ''\n                                    }\n\n\n\n\n\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Useful Links\"}</h4>\n                                <ul>\n                                    <li><Link to=\"/explore-all\">All NFTs</Link></li>\n                                    <li><Link to=\"/how-it-works\">How It Works</Link></li>\n                                    <li><Link to=\"/create\">Create</Link></li>\n                                    <li><Link to=\"/privacy-and-terms\">Privacy & Terms</Link></li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Community\"}</h4>\n                                <ul>\n                                    <li><Link to=\"/help-center\">Help Center</Link></li>\n                                    <li><Link to=\"/contact\">Contact</Link></li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Subscribe Us\"}</h4>\n                                {/* Subscribe Form */}\n                                <div className=\"subscribe-form d-flex align-items-center\">\n                                    <input type=\"email\" className=\"form-control\" placeholder=\"info@yourmail.com\" />\n                                    <button type=\"submit\" className=\"btn\"><i className=\"icon-paper-plane\" /></button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            {/* Footer Bottom */}\n            <div className=\"footer-bottom\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12\">\n                            {/* Copyright Area */}\n                            <div className=\"copyright-area d-flex flex-wrap justify-content-center justify-content-sm-between text-center py-4\">\n                                {/* Copyright Left */}\n                                <div className=\"copyright-left\">©2021 {ENV.appName}, All Rights Reserved.</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    );\n}\n\nconst mapStateToProps = state => ({\n    error: state.error,\n    settings: state.settings\n});\n\n\nexport default connect(mapStateToProps, { getFooter })(Footer);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/header/header.js",["314","315","316","317","318","319","320"],"import React, { useState, useEffect } from 'react';\nimport { Link, useHistory } from 'react-router-dom';\nimport { connect } from 'react-redux';\nimport { setWalletAddress, getWalletAddress } from '../wallet/wallet.action'\nimport { connectMetamaskCopy } from '../../utils/web3'\nimport { logoutUser } from '../user/user.action';\nimport { ENV } from './../../config/config';\n\nconst Header = (props) => {\n    const history = useHistory();\n    // console.log(\"history\", history);\n    const [connectedAddress, setConnectedAddress] = useState('');\n    const [loader, setLoader] = useState(true);\n    const { _id } = ENV.getUserKeys('_id');\n\n    useEffect(async () => {\n        // COMMENTED TEMPORARILY\n        // METHOD 1\n        // props.getWalletAddress()\n\n        // METHOD 2 - a\n        // let connectedAddress = await connectMetamask();\n        // setConnectedAddress(connectedAddress)\n\n        // METHOD 3\n        // if (localStorage.getItem('wa')) {\n        //     let connectedAddress = window.atob(localStorage.getItem('wa'))\n        //     setConnectedAddress(connectedAddress)\n        // }\n\n        // METHOD 4\n        let connectedAddress = await connectMetamaskCopy();\n        setConnectedAddress(connectedAddress)\n        props.setWalletAddress(connectedAddress)\n    }, [])\n\n    // set loader to false when address is received\n    useEffect(() => {\n        if (connectedAddress)\n            setLoader(false)\n    }, [connectedAddress])\n\n    // COMMENTED TEMPORARILY\n    // METHOD 2 - b\n    // useEffect(() => {\n    //     if (props.wallet.walletAuth) {\n    //         const { connectedAddress } = props.wallet\n    //         setConnectedAddress(connectedAddress)\n    //     }\n    // }, [props.wallet.walletAuth])\n    const formatAddress = (address) => {\n        return address ? address.substr(0, 6) + '...' + address.substr(-4) : null;\n    }\n    const logoutUser = () => {\n        props.logoutUser();\n        history.push('/login');\n    }\n    \n    return (\n        <header id=\"header\">\n            {/* Navbar */}\n            <nav data-aos=\"zoom-out\" data-aos-delay={800} className=\"navbar navbar-expand\">\n                <div className=\"container header\">\n                    {/* Navbar Brand*/}\n                    <Link className=\"navbar-brand\" to=\"/\">\n                        <img className=\"navbar-brand-sticky\" src=\"/img/new_logo.jpeg\" alt=\"sticky brand-logo\" />\n                    </Link>\n                    <div className=\"ml-auto\" />\n                    {/* Navbar */}\n                    <ul className=\"navbar-nav items mx-auto\">\n                        <li className=\"nav-item dropdown\">\n                            <Link className=\"nav-link\" to=\"/\">Home</Link>\n                        </li>\n                        <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\">Explore <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><Link to=\"/explore-all\" className=\"nav-link\">Explore</Link></li>\n                                <li className=\"nav-item\"><Link to=\"/auctions\" className=\"nav-link\">Live Auctions</Link></li>\n                                {/* <li className=\"nav-item\"><Link to=\"/item-details\" className=\"nav-link\">Item Details</Link></li> */}\n                            </ul>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/activity\" className=\"nav-link\">Activity</Link>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/collections\" className=\"nav-link\">Collections</Link>\n                        </li>\n                        {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Community <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/blog\" className=\"nav-link\">Blog</a></li>\n                                <li className=\"nav-item\"><a href=\"/blog-single\" className=\"nav-link\">Blog Single</a></li>\n                                <li className=\"nav-item\"><a href=\"/help-center\" className=\"nav-link\">Help Center</a></li>\n                            </ul>\n                        </li> */}\n                        {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Pages <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/authors\" className=\"nav-link\">Authors</a></li>\n                                <li className=\"nav-item\"><a href=\"/author\" className=\"nav-link\">Author</a></li>\n                                <li className=\"nav-item\"><a href=\"/wallet-connect\" className=\"nav-link\">Wallet Connect</a></li>\n                                <li className=\"nav-item\"><a href=\"/create\" className=\"nav-link\">Create</a></li>\n                                <li className=\"nav-item\"><a href=\"/login\" className=\"nav-link\">Login</a></li>\n                                <li className=\"nav-item\"><a href=\"/signup\" className=\"nav-link\">Signup</a></li>\n                            </ul>\n                        </li> */}\n                        <li className=\"nav-item\">\n                            <Link to=\"/contact\" className=\"nav-link\">Contact</Link>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/history\" className=\"nav-link\">History</Link>\n                        </li>\n                    </ul>\n                    {/* Navbar Icons */}\n                    <ul className=\"navbar-nav icons\">\n                        <li className=\"nav-item\">\n                            <a href=\"#\" className=\"nav-link\" data-toggle=\"modal\" data-target=\"#search\">\n                                <i className=\"fas fa-search\" />\n                            </a>\n                        </li>\n                    </ul>\n                    {/* Navbar Toggler */}\n                    <ul className=\"navbar-nav toggle\">\n                        <li className=\"nav-item\">\n                            <a href=\"#\" className=\"nav-link\" data-toggle=\"modal\" data-target=\"#menu\">\n                                <i className=\"fas fa-bars toggle-icon m-0\" />\n                            </a>\n                        </li>\n                    </ul>\n                    {/* Navbar Action Button */}\n                    <ul className=\"navbar-nav action\">\n                        <li className=\"nav-item ml-3\">\n                            {\n                                connectedAddress && _id ?\n                                    <button className=\"btn ml-lg-auto btn-bordered-white\" onClick={logoutUser}><i className=\"icon-logout mr-md-2\" /> Logout</button>\n                                    // <span id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />{formatAddress(connectedAddress)}</span>\n                                    :\n                                    <Link to=\"/login\" id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />Login</Link>\n                            }\n\n                        </li>\n                    </ul>\n                </div>\n            </nav>\n        </header>\n    );\n};\n\nconst mapStateToProps = state => ({\n    wallet: state.wallet\n});\nexport default connect(mapStateToProps, { setWalletAddress, getWalletAddress, logoutUser })(Header);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["321","322"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 630,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(\n    props.levelsInputs\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage,setErrorMessage]=React.useState(\"\")\n  const [validate,setValidate]=React.useState(false)\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n      let newFormValues = [...levelsInputs];\n      newFormValues.splice(i, 1);\n      setlevelsInputs(newFormValues);\n \n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault()\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total ===\"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\")\n        return \"\";\n      }\n      if(+item.value > +item.total){\n        alert(\"inside\")\n        setError(true)\n        setValidate(true)\n        setErrorMessage(\"Value should be less then total!\")\n        return \"\";\n      }\n \n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n//  const handleValue=(item)=>{\n//    if(item.value > item.total){\n\n//      setError(true)\n//      return true\n//    }\n//    return false\n//  }\n//  const handleTotal=(item)=>{\n\n//  }\n// console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor:\"pointer\"\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={LevelsImage} alt={\"levels\"} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Add Levels\n              </p>\n            </div>\n              {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p className=\"text-center w-100 p-4 text-white\" style={{color:\"#FFFFFF\",opacity:\"0.70\",width:\"80%\",fontSize:\"14px\" }}>\n           Levels show up underneath your item, are clickable, and can be\nfiltered in you collection’s sidebar.\n            </p>\n       <form onSubmit={handleSubmit}>\n            <div className=\"row levels-scroll p-3\" style={{height:`${levelsInputs &&   levelsInputs.length > 0 ?\" 22vh\":\"14vh\"}`}}>\n              {levelsInputs &&\n                levelsInputs.length > 0 &&\n              levelsInputs.map((item, i) => {\n                return (\n                  <div className=\"d-flex\" key={i}>\n                    <div className=\"col-6 mt-2 \" key={i}>\n                      <div\n                        className=\"d-flex\"\n                        style={{ flexDirection: \"column\" }}\n                      >\n                     \n                        <label\n                          className=\"text-white\"\n                          style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                        >\n                          Name\n                        </label>\n\n                        <input\n                          className=\"step3-input mt-3 \"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => handleChange(i, e)}\n                          value={item.name || \"\"}\n                          placeholder=\"Name\"\n                          maxLength=\"50\"\n                          style={{\n                            backgroundColor: \"#000e29\",\n                            maxWidth: \"84%\",\n                            padding: \"0.6rem 1rem\",\n                          }}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-6 mt-3\">\n               \n                      <div\n                        className=\"d-flex position-relative\"\n                        style={{ flexDirection: \"column\" }}\n                      >\n                          \n                          \n                        <label\n                          className=\"text-white\"\n                          style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                        >\n                          Value\n                        </label>\n                        {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                        <div className=\"d-flex align-items-center  w-100\">\n\n                          <input\n                            className={`step3-input first-value mt-2 ${validate && item.value > item.total ? \"levels-value\":\"\"}`}\n                            type=\"number\"      \n                            min=\"1\"\n                            max={item.total ?item.total :\"1\"}\n                            onChange={(e) => handleChange(i, e)}\n                            value={item.value || \"\"}\n                            placeholder=\"Value\"\n                            name=\"value\"\n                    \n                            style={{\n                              backgroundColor: \"#000e29\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                       \n                          \n                          <p className=\"text-white mb-0 value-label\">Of</p>\n                          <input\n                            className={`step3-input first-value mt-2 ${validate && item.total < item.value ? \"levels-value\":\"\"}`}\n                            type=\"number\"\n                            min={item.value ?item.value :\"1\"}\n                            max=\"9999\"\n                            name=\"total\"\n                            placeholder=\"total\"\n                   \n                            onChange={(e) => handleChange(i, e)}\n                            value={item.total || \"\"}\n                            style={{\n                              backgroundColor: \"#000e29\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                        </div>\n                        <BsFillXCircleFill\n                          className=\"position-absolute levels-cross-icon\"\n                          style={{\n                            color: \"#00d3f3\",\n                            top: \"3rem\",\n                            right: \"0\",\n                            cursor: \"pointer\",\n                          }}\n                          onClick={() => removeFormFields(i)}\n                          />\n                      </div>\n                        \n                    </div>\n                  </div>\n                );\n              })}\n\n              <p\n                className=\" mt-4\"\n                style={{ color: \"#00d3f3\" ,cursor:\"pointer\",marginLeft:\"0.8rem\"}}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n        \n            <div className=\"w-100 text-center\">\n              <button\n                type=\"submit\"\n                className=\"btn btn-secondary start-btn mt-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   levelsInputs && levelsInputs?.length > 0\n                //     ? false\n                //     : true\n                // }\n                // onClick={() => {\n                //   handleSubmit()\n                // }}\n              >\n                Save\n              </button>\n            </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) => (\n  // console.log(state, \"state\"),\n  {\n    currentStep: state.dashboard.currentStep,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["323","324"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 630,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.propertiesValues\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white mt-0\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 22vh\"\n                    : \"14vh\"\n                }`,\n             \n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" style={{width:\"558px\"}} key={i}>\n                      <div className=\"col-6 mt-4\" key={i}>\n                        <div\n                          className=\"d-flex\"\n                          style={{ flexDirection: \"column\" }}\n                        >\n                          <label\n                            className=\"text-white\"\n                            style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                          >\n                            Name\n                          </label>\n                          <input\n                            className=\"step3-input mt-2 \"\n                            type=\"text\"\n                            name=\"name\"\n                            onChange={(e) => handleChange(i, e)}\n                            placeholder=\"Name\"\n                            value={item.name || \"\"}\n                            maxLength=\"40\"\n                            style={{\n                              backgroundColor: \"#000e29 !important\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                        </div>\n                      </div>\n\n                      <div className=\"col-6 mt-4\">\n                        <div\n                          className=\"d-flex position-relative\"\n                          style={{ flexDirection: \"column\" }}\n                        >\n                          <label\n                            className=\"text-white\"\n                            style={{\n                              fontSize: \"1.2rem\",\n                              fontWeight: \"bold\",\n                              marginLeft: \"2rem\",\n                            }}\n                          >\n                            Value\n                          </label>\n                          <input\n                            className=\"step3-input  mt-2\"\n                            type=\"text\"\n                            name=\"value\"\n                            onChange={(e) => handleChange(i, e)}\n                            placeholder=\"Value\"\n                            value={item.value || \"\"}\n                            maxLength=\"40\"\n                            style={{\n                              backgroundColor: \"#000e29 \",\n                              maxWidth: \"84%\",\n                              marginLeft: \"2rem\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                          <BsFillXCircleFill\n                            className=\"position-absolute cross-icon\"\n                            style={{\n                              color: \"#00d3f3\",\n                              top: \"3rem\",\n                              left: \"15.8rem\",\n                              cursor: \"pointer\",\n                            }}\n                            onClick={() => removeFormFields(i)}\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n\n              <p\n                className=\" mt-4\"\n                style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Property\n              </p>\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   propertiesValues && propertiesValues?.length > 0\n                //     ? false\n                //     : true\n                // }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["325"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.action.js",["326"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport { GET_ERRORS, SET_USER, GET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, BEFORE_USER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { getCollections, setAuthState } from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n    return {\n        type: BEFORE_USER\n    }\n}\n\n// method to set user data\nexport const setUser = (user) => dispatch => {\n    dispatch(emptyError())\n    dispatch({\n        type: SET_USER,\n        payload: user\n    })\n}\n\n// method to get user data\nexport const getUser = () => dispatch => {\n    dispatch({\n        type: GET_USER\n    })\n}\n\n// method to login using wallet address and sign\nexport const login = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/login/`;\n    // const url = `http://localhost:5000/v1/front/auth/login/`;\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            const userId = data.data._id;\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/register/`;\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n            toast.success(data.message)\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getTopSellers = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/top-sellers`;\n    // const url = `http://3.142.91.8/v1/front/users/top-sellers`;\n    // console.log(url,\"testing url in top sellers\")\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        // console.log(\"data====>\",data);\n        if (data.status) {\n            dispatch({\n                type: TOP_SELLERS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        // console.log(\"errors===>\");\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getCreators = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/creators`;\n    // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n    \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        // console.log(data,\"creators data===>}}}\");\n        if (data.status) {\n            dispatch({\n                type: SET_CREATORS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/${userId}`;\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            dispatch({\n                type: SET_INDIVIDUAL_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => dispatch => {\n    dispatch(emptyError());\n    dispatch({\n        type: SET_INDIVIDUAL_USER,\n        payload: user\n    })\n};\n\nexport const logoutUser = () => (dispatch) => {\n    dispatch({\n        type: SET_USER,\n        userAuth: false,\n        userData: null\n    })\n    dispatch(setAuthState())\n    localStorage.removeItem('encuse');\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.actions.js",["327"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_COLLECTION, SET_AUTH_STATE, GET_COLLECTION, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\n\nexport const beforeCollection = () => {\n    return {\n        type: BEFORE_COLLECTION\n    }\n}\n\nexport const getCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}collection/get/${collectionId}`;\n \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getCollections = (qs = null) => dispatch => {\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        // console.log(error,\"all collections error\");\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const upsertCollection = (apiURL, body, method = 'POST') => dispatch => {\n\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n   \n    // const url = `http://localhost:5000/v1/front/${apiURL}`;\n\n\n    fetch(url, {\n        method,\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: UPSERT_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}collection/delete/${collectionId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const setAuthState = () => (dispatch) => {\n    dispatch({\n        type: SET_AUTH_STATE,\n    })\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/gaTracker/gaTracket.js",["328"],"import { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport ReactGA from \"react-ga\";\nimport { connect } from \"react-redux\";\nimport { useSelector } from \"react-redux\";\n\n\n\nconst useGaTracker = () => {\n    const step=useSelector((state)=>state.dashboard.currentStep)\n    const location = useLocation();\n    const [initialized, setInitialized] = useState(false);\n\n    useEffect(() => {\n        if (!window.location.href.includes(\"localhost\")) {\n        ReactGA.initialize(\"UA-215431628-1\");\n        }\n        setInitialized(true);\n    }, []);\n\n    useEffect(() => {\n        if (initialized) {\n        \n            if(location.pathname === '/')\n            {\n\n                ReactGA.pageview(location.pathname + location.search );\n            }\n            else {\n                ReactGA.pageview(location.pathname + location.search + `/step${step}`);\n            }\n        }\n    }, [initialized, location, step]);\n};\n\nexport default useGaTracker;",{"ruleId":"329","replacedBy":"330"},{"ruleId":"331","replacedBy":"332"},{"ruleId":"333","severity":1,"message":"334","line":6,"column":8,"nodeTy