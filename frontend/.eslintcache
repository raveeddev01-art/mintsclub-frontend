"usedDeprecatedRules":"192"},{"filePath":"393","messages":"394","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"192"},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"192"},{"filePath":"397","messages":"398","errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"399","messages":"400","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"401","usedDeprecatedRules":"192"},{"filePath":"402","messages":"403","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"192"},{"filePath":"404","messages":"405","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"406","usedDeprecatedRules":"192"},{"filePath":"407","messages":"408","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"192"},{"filePath":"409","messages":"410","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"192"},{"filePath":"411","messages":"412","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"413","usedDeprecatedRules":"192"},{"filePath":"414","messages":"415","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"416","usedDeprecatedRules":"192"},{"filePath":"417","messages":"418","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"419","usedDeprecatedRules":"192"},{"filePath":"420","messages":"421","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"192"},{"filePath":"422","messages":"423","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"192"},{"filePath":"424","messages":"425","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"192"},{"filePath":"426","messages":"427","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/index.js",[],["428","429"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/App.js",["430","431","432"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/store.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/routes.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/privateRoute.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/utils/web3.js",["433","434","435"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\n\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\n\nexport const validateNetwork = async () => {\n  let prevNetwork = await getNetworkNameByChainId();\n\n  if (prevNetwork === \"Ethereum Rinkby\") {\n    return true;\n  } else {\n    return false;\n  }\n};\nexport const getBalance = async () => {\n  let web3 = await getWeb3();\n  let address = await getWalletAddress();\n  let balance = await web3.eth.getBalance(address);\n  let ethBalance = web3.utils.fromWei(balance, \"ether\");\n\n  return ethBalance;\n};\n\nexport const mintNFt = async (metaData, id, amount, recipientValue) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n  const value = Number(recipientValue) * 1000000000000000000;\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, metaData)\n      .send({ from: connectedAddress, gassPrice: 5000000 });\n    console.log(result, \"result of minting\");\n    return result;\n  } catch (err) {\n    console.log(err, \"error while minting\");\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const openNFTForBidding = async (biddingTime, startTime, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id = Number(tokenId);\n\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id, 1)\n      .send({ from: connectedAddress });\n    if (result) {\n      console.log(result, \"open for bidding result\");\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"open for bid error\");\n    throw new Error(err);\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let bidAmount = Number(amount) * 1000000000000000000;\n\n    let id = Number(tokenId);\n\n    const result = await contractM.methods\n      .bid(id)\n      .send({ from: connectedAddress, value: bidAmount, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\n\nexport const putonsale = async (tokenId, amount, price) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let weiAmount = BigInt(Number(price) * 1000000000000000000);\n\n    let id = Number(tokenId);\n\n    const result = await contractM.methods\n      .putonsale(id, amount, weiAmount)\n      .send({ from: connectedAddress, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const BuyFixedPriceNFT = async (\n  amount,\n  tokenId,\n  setConfirmed,\n  setTransactionHash\n) => {\n  try {\n    let obj = {\n      amount,\n      tokenId,\n    };\n\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n\n    // const weiAmount =BigInt( Web3.utils.toWei(`${amount}`, 'ether'));\n\n    let weiAmount = Number(amount) * 1000000000000000000;\n\n    const result = await contractM.methods\n      .BuyFixedPriceNFT(tokenId)\n      .send({ from: connectedAddress, value: weiAmount, gas: 5000000 })\n      .on(\"transactionHash\", function (hash) {\n        setTransactionHash(hash);\n        setConfirmed(true);\n      })\n      .on(\"confirmation\", function (confirmationNumber, receipt) {});\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    setConfirmed(false);\n    console.log(err);\n\n    throw new Error(err);\n  }\n};\nexport const setApprovalForAll = async () => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const result = await contractM.methods\n      .setApprovalForAll(ENV.mintsClubContractAddress, true)\n      .send({\n        from: connectedAddress,\n      });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    throw new Error(err);\n  }\n};\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      // toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const mint = async () => {\n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n  } catch (e) {}\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = () => {};\n\nexport const createNft = async () => {};\n\nexport const setNftToken = (body) => {\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n  alert(\"calling\");\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        window.location.href = \"/explore-all\";\n      } else {\n      }\n    })\n    .catch((error) => {\n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {};\n\nexport const placeBidNft = async () => {};\n\nexport const SellOnFixedPrice = async () => {};\n\nexport const BuyFixedPriceNFTs = async () => {};\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async () => {};\nexport const signTransaction = async () => {};\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/config/config.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/index.js",["436","437"],"import { combineReducers } from \"redux\";\nimport homeReducer from \"./../components/home/home.reducer\";\nimport mintsReducer from \"../redux/reducer/reducer\";\nimport auctionReducer from \"./../components/auctions/auctions.reducer\";\nimport nftReducer from \"./../components/nfts/nfts.reducer\";\nimport userReducer from \"./../components/user/user.reducer\";\nimport walletReducer from \"./../components/wallet/wallet.reducer\";\nimport categoryReducer from \"./../components/categories/categories.reducer\";\nimport collectionReducer from \"./../components/collections/collections.reducer\";\nimport errorReducer from \"./shared/error/error.reducer\";\nimport settingsReducer from \"../components/footer/footer.reducer\";\n\nimport offersReducer from \"../components/offers/offers.reducer\";\nimport bidsReducer from \"../components/bids/bids.reducer\";\n\nimport exploreAllReducer from \"../components/explore/explore.reducer\";\nimport createNftReducer from \"../components/create-nft/create-nft-reducer\";\n\nexport default combineReducers({\n  home: homeReducer,\n  dashboard: mintsReducer,\n  auction: auctionReducer,\n  nft: nftReducer,\n  user: userReducer,\n  wallet: walletReducer,\n  category: categoryReducer,\n  collection: collectionReducer,\n  error: errorReducer,\n\n  offer: offersReducer,\n  bid: bidsReducer,\n\n  explore: exploreAllReducer,\n});\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/home/home.js",["438","439"],"import React, { useEffect } from \"react\";\nimport { Table, Pagination } from \"react-bootstrap\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller2\";\n\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n  \n      <NavbarMain />\n      <Hero />\n\n      <Auctions />\n   \n  \n      <TopSeller viewAll={\"View All\"} />\n   \n      <PopularCollections />\n     \n      <OwnCollection />\n      <Buysell />\n      <Footer />\n    </>\n  );\n}\n\nexport default Home;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["440","441","442","443","444","445"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from 'react';\nimport NavbarMain from '../navbar-main/NavbarMain';\nimport CollectionsCard from '../collections-cards/CollectionsCard';\nimport Footer from '../footer/footer';\nimport { connect } from 'react-redux';\nimport { ENV } from '../../config/config';\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from '../collections/collections.actions';\nimport FullPageLoader from '../full-page-loader/full-page-loader';\n\nimport Breadcrumb from '../breadcrumb/breadcrumb';\nimport { Images } from '../../assets/assets';\n\nconst Populars = forwardRef((props, ref) => {\n  const [popular, setpopular] = useState([]);\n  const [isActive, setIsActive] = useState('All');\n  const [collections, setCollections] = useState(null);\n\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState('all');\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getPopularCollections(null, 1);\n    const qs = ENV.objectToQueryString({\n      myFilter: 'all',\n    });\n\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      const pagination = props.popularCollections.pagination;\n\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n\n      setPagination(pagination);\n      const userId = ENV.getUserKeys('_id')._id;\n      if (props.finalCollectionListing) {\n        let finalCollectionListing = finalCollectionListing.filter(\n          (item) => item.userId === userId\n        );\n        setpopular(finalCollectionListing);\n      } else {\n        if (finalCollectionListing === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setpopular(finalCollectionListing);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.getPopularAuth]);\n\n  const getPopularCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getPopularCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getPopularCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getPopularCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getPopularCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === 'image');\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.popularCollectionPlaceholder;\n      }\n    } else {\n      return Images.popularCollectionPlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={'Collections'} title2={'PopularCollections'} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className='explore-collection-section padding-wrapper'>\n          <div className='container'>\n            <div className='row mb-5'>\n              <div className='col-12'>\n                {/* Intro */}\n                <div className='intro'>\n                  <div className='intro-content'>\n                    <span>Most Popular</span>\n                    <h3 className='mb-0'>Popular Collections</h3>\n                  </div>\n                </div>\n              </div>\n              <div className='col-12 explore-collection-nav'>\n                <div className='d-none d-lg-flex justify-content-lg-end text-end align-items-center'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? 'active-explore-nav' : ''\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className='row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className='col-6 col-sm-3'>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? 'active-explore-nav' : ''\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className='row g-4 align-items-center justify-content-center'>\n              {loader ? (\n                <div class='spinner-border text-white' role='status'>\n                  <span class='sr-only'>Loading...</span>\n                </div>\n              ) : popular && popular.length > 0 ? (\n                popular.map((item) => {\n                  return (\n                    <div className='col-sm-6 col-lg-4'>\n                      <CollectionsCard\n                        CardImg={item.featuredImg}\n                        Subimg1={handleImage(item, 0)}\n                        Subimg2={handleImage(item, 1)}\n                        Subimg3={handleImage(item, 2)}\n                        name={item.name}\n                        id={item._id}\n                        collection={item}\n                        userName={item.username[0]}\n                        NFTCount={item.totalNfts}\n                        profileImage={item.profileImage[0]}\n                        // handleLikesTogle={handleLikesTogleApi}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className='text-center text-white not-found-title mt-5'>\n                  No popular collections Found\n                </p>\n              )}\n\n              <div className='col-12'>\n                <div className='mt-5 text-center'>\n                  {!empty &&\n                    popular?.length === 10 &&\n                    pagination.totalRecords > popular.length && (\n                      <button\n                        className='btn btn-linear-gradient px-5'\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforePopularCollection,\n    getPopularCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/explore-collections.js",["446","447","448","449"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from 'react';\n\nimport NavbarMain from '../navbar-main/NavbarMain';\nimport './explore-collections.css';\nimport CollectionsCard from '../collections-cards/CollectionsCard';\nimport Footer from '../footer/footer';\nimport { connect } from 'react-redux';\nimport { ENV } from '../../config/config';\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from './collections.actions';\nimport { Images } from '../../assets/assets';\n\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { beforeCategory, getCategories } from './collections.actions';\nimport Breadcrumb from '../breadcrumb/breadcrumb';\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState('All');\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState('');\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      // console.log('collections', collections.nftDetail);\n      const userId = ENV.getUserKeys('_id')._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter((nft) => nft.fileType === 'image');\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.popularCollectionPlaceholder;\n      }\n    } else {\n      return Images.popularCollectionPlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={'Explore'} title2={'Explore All'} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className='explore-collection-section padding-wrapper'>\n          <div className='container'>\n            <div className='row mb-5'>\n              <div className='col-12'>\n                <div className='intro'>\n                  <div className='intro-content'>\n                    <span>Collections</span>\n                    <h3 className='mb-0'>Explore all</h3>\n                  </div>\n                </div>\n              </div>\n              <div className='col-12 explore-collection-nav'>\n                <div className='d-none d-xxl-flex justify-content-lg-end text-end align-items-center'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? 'active-explore-nav' : ''\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className='row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className='col-6 col-sm-3'>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? 'active-explore-nav' : ''\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className='row g-4 align-items-center justify-content-center'>\n              {loader ? (\n                <div class='spinner-border text-white' role='status'>\n                  <span class='sr-only'>Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className='col-sm-6 col-lg-4'>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : ''\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className='text-center text-white not-found-title mt-5'>\n                  No Collections found\n                </p>\n              )}\n              <div className='col-12'>\n                <div className='mt-5 text-center'>\n                  {!empty &&\n                    collections?.length === 10 &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className='btn btn-linear-gradient px-5'\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collection-details.js",["450","451","452","453","454","455","456","457","458","459","460","461","462","463","464","465","466","467","468"],"import React, { useState, useEffect, useRef } from \"react\";\n\nimport Explore from \"../explore/explore-all\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection, getCollection } from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"../../config/config\";\nimport { Accordion, Dropdown } from \"react-bootstrap\";\nimport Select from 'react-select'\nimport NftCard from './components/NftCard/NftCard';\nimport {getNFTs} from '../nfts/nfts.action'\nimport {getCreators, beforeUser} from './../user/user.action';\nimport { toast } from \"react-toastify\";\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV;\n\nconst CollectionDetails = (props) => {\n  const [collection, setCollection] = useState(null);\n  const [nfts, setNfts] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [limit, setLimit] = useState(2);\n  const [collectionLoader, setColLoader] = useState(true); // collections loader\n  const [nftsLoader, setNftsLoader] = useState(true); // NFTs loader\n  const [creators,setCreator]=useState([])\n  const nftsRef = useRef(null);\n\n  useEffect(() => {\n   \n    props.getNFTs()\n    window.scroll(0, 0);\n    const { collectionId } = props.match.params;\n    if (collectionId) props.getCollection(window.atob(collectionId));\n    else props.history.push(\"/collections\");\n  }, []);\n\n  // when collection data is received\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collection } = props.collection;\n  \n      setCollection(collection);\n      props.beforeCollection();\n      setColLoader(false);\n    }\n  }, [props.collection.getAuth]);\n   \n  useEffect(()=>{\n      \n    if(props.user.topSellersAuth ){\n    \n       setCreator(props.user.sellers)\n\n    }\n  },[props.user.topSellersAuth])\n\n  // handle show load more button state when pagination is set\n  useEffect(() => {\n   \n    if (nftPagination)\n        setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length && nfts.length > 0))\n  }, [nftPagination])\n\n  const loadMore = () => {\n    \n    // const { page, limit } = nftPagination\n    setLoader(true)\n    setLimit(limit + 2)\n    // get more NFTs for explore section\n    // getNFTs(1, limit * (page + 1));\n  }\n\n  const filterNfts=(nfts)=>{\n\n    if(collection)\n    {\n      const result_nft = nfts.filter((nft)=>nft?.collectionId===collection._id);\n      nfts.pagination = { page: 1, limit: 10, total: result_nft.length, pages: 1 }\n      setNfts(result_nft.slice(0, limit));\n      setNFTPagination(nfts.pagination)\n      getNftsLoader(false);\n    }\n  }\n\n\n\n\n  const getNFTs = (page = 1, limit = 2) => {\n      const nftQS = { page, limit }\n      if (props.collectionId)\n          nftQS.collectionId = props.collectionId\n      const qs = ENV.objectToQueryString(nftQS)\n      props.getNFTs(qs)\n  }\n\n  useEffect(()=>{\n    if(props.nft.nftsAuth)\n    {\n      const {nftsData}=props.nft;\n      filterNfts(nftsData)  \n    }\n\n  },[props?.nft?.nftsAuth,collection, limit])\n\n\n\n  const getNftsLoader = (loader) => {\n    setNftsLoader(loader);\n  };\n\n  return (\n    <section\n      className=\"author-area explore-area  popular-collections-area\"\n      style={{ padding: \"0px\" }}\n    >\n      {(collectionLoader || nftsLoader) && <FullPageLoader />}\n      <div className=\"\">\n        {collection  && (\n          <div className=\"row p-5\" style={{width:\"80%\",margin:\"auto\"}}>\n            <div className=\"col-4 p-4\">\n              {/* <CollectionPreview collection={collection} creators={creators} /> */}\n            </div>\n            <div className=\"col-8 \">\n              <div className=\"row justify-content-center mt-5\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  <div className=\"intro text-center mb-4\">\n                      {/* <span>{initData.pre_heading}</span> */}\n                      <span>Explore</span>\n                      {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                          <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row gx-5 p-4\">\n              \n                {\n                  nfts && creators && nfts.map((nft)=>{\n                  return (\n                    <div className=\"col-6 mt-5\" style={{}}>\n                      <NftCard nft={nft} creators={creators}/>\n                    </div>\n                    )\n                  })\n                }\n                {\n                  loadMoreBtn &&\n                  <div className=\"row w-100\">\n                      <div className=\"col-12 w-100 text-center\">\n                          <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>Load More</a>\n                      </div>\n                  </div>\n                }\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  {\n\n  error: state.error,\n  collection: state.collection,\n  nft:state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollection,\n  getNFTs,\n  getCreators,\n\n})(CollectionDetails);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/create-nft.js",["469","470","471","472","473"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nimport { toast } from \"react-toastify\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport {\n  beforeCollection,\n  getCollections,\n  myCollections,\n} from \"../collections/collections.actions\";\nimport { addNFTRecord, createNFT, createActivity } from \"../nfts/nfts.action\";\nimport { getCurrentAddress, mintNFt, validateNetwork } from \"../../utils/web3\";\nimport { RiArrowDropDownLine } from \"react\";\nimport \"./createNft.css\";\nimport { Images } from \"../../assets/assets.js\";\nimport Upload from \"./components/upload\";\nimport Footer from \"../footer/footer\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport AddIcon from \"../../assets/images/add-icon.svg\";\nimport PropertiesModal from \"../modals/PropertiesModal\";\nimport LevelsModal from \"../modals/LevelsModal\";\nimport StatsModal from \"../modals/StatsModal\";\nimport StatsInfo from \"./components/statsinfo\";\nimport LevelsInfo from \"./components/levelsinfo\";\nimport PropertiesInfo from \"./components/propertiesinfo\";\n\nconst placeholderImg = \"\";\nclass CreateNFT extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      nft: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        ownerId: ENV.getUserKeys(\"_id\")._id,\n        creatorId: ENV.getUserKeys(\"_id\")._id,\n        image: \"\",\n        name: \"\",\n        description: \"\",\n        royalty: \"\",\n        size: \"\",\n        copies: \"\",\n        collectionId: \"\",\n        ownerAddress: \"\",\n        categoryId: \"\",\n        status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n      },\n      imageURL: \"\",\n      videoURL: \"\",\n      collections: [],\n      allcollections: null,\n      error: false,\n      errorMessage: \"\",\n      audioUrl: \"\",\n      propertiesmodalShow: false,\n      levelsmodalShow: false,\n      statsmodalShow: false,\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount = async () => {\n    window.scroll(0, 0);\n\n    this.props.myCollections(ENV.getUserKeys(\"_id\")._id);\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      this.props.history.push(\"/login\");\n    }\n\n    let ownerAddress = await getCurrentAddress();\n\n    let { nft } = this.state;\n    nft = { ...nft, ownerAddress: ownerAddress };\n    this.setState({\n      nft,\n    });\n  };\n\n  componentDidUpdate(prevProps) {\n    if (\n      this.props.collection.myCollectionsResult &&\n      prevProps.collection.myCollectionsResult !==\n        this.props.collection.myCollectionsResult\n    ) {\n      const collections =\n        this.props.collection.myCollections.collections.Collections;\n\n      if (!collections.length) {\n        toast.info(\"Please create a collection first\");\n        return this.props.history.push(\"/createcollection\");\n      } else {\n        this.setState({\n          collections: collections,\n          loader: false,\n        });\n      }\n    }\n  }\n\n  onChange(e, status = null) {\n    let { name, value } = e.target;\n\n    // if status is provided\n    if (status) value = status;\n    let category = this.state.collections.find(\n      (item) => item._id === value\n    )?.categoryId;\n\n    let { nft } = this.state;\n    nft = { ...nft, [name]: value, categoryId: category };\n    this.setState({ nft });\n  }\n\n  reset = () => {\n    const nft = {\n      userId: ENV.getUserKeys(\"_id\")._id,\n      ownerId: ENV.getUserKeys(\"_id\")._id,\n      image: \"\",\n      name: \"\",\n      description: \"\",\n      currentPrice: \"\",\n      royalty: \"\",\n      size: \"\",\n      copies: \"\",\n      collectionId: \"\",\n      ownerAddress: this.state.ownerAddress,\n      status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n    };\n    this.setState({ nft });\n  };\n\n  submit = async (e) => {\n    e.preventDefault();\n    if (await validateNetwork()) {\n      const { nft, videoURL, audioUrl } = this.state;\n\n      let nftInfo = nft;\n      delete nftInfo.currentPrice;\n\n      if (videoURL) {\n        nftInfo.fileType = \"video\";\n      } else if (audioUrl !== \"\") {\n        nftInfo.fileType = \"audio\";\n      } else {\n        nftInfo.fileType = \"image\";\n      }\n\n      this.setState(\n        {\n          isSubmitted: true,\n          formValid:\n            this.validator.allValid() && nft.collectionId ? true : false,\n        },\n        () => {\n          const { formValid } = this.state;\n\n          if (formValid) {\n            this.setState(\n              {\n                loader: true,\n              },\n              async () => {\n                var formData = new FormData();\n                delete nftInfo.currentPrice;\n\n                for (const key in nftInfo)\n                  if (nftInfo[key]) formData.append(key, nftInfo[key]);\n\n                const res = await axiosPostFormData(\n                  \"nfts/create\",\n                  formData,\n                  true\n                );\n\n                if (res.success) {\n                  // this.reset();\n\n                  nft.remainingCopies = nft.copies;\n                  if (res.nft && res.nft.metaData) {\n                    try {\n                      let createNftResult = await mintNFt(\n                        res.nft.metaData,\n                        res.nft._id,\n                        this.state.nft.copies,\n\n                        2\n                      );\n\n                      if (\n                        createNftResult.events.TransferSingle.returnValues.id\n                      ) {\n                        let data = {\n                          nftToken:\n                            createNftResult.events.TransferSingle.returnValues\n                              .id,\n                          data: this.state.nft,\n                          image: res.nft.image,\n                        };\n\n                        this.props.addNFTRecord(data);\n\n                        this.props.history.push(\"/explore/allNFT\");\n                      }\n                    } catch (err) {\n                      toast.error(err);\n                      this.setState({ loader: false });\n                    }\n                  }\n                } else this.setState({ errors: res.message, loader: false });\n              }\n            );\n          } else {\n            this.validator.showMessages();\n            this.setState(\n              {\n                errors: \"Please fill all required fields in valid format.\",\n                formValid: false,\n              },\n              () => {\n                $(\"#create-nft\").scrollTop(0, 0);\n              }\n            );\n          }\n        }\n      );\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkeby Network\");\n    }\n  };\n\n  onFileChange = (e, status) => {\n    if (this.handleFilesValidation(e, status) === \"file matched\") {\n      let file = \"\";\n      let url = \"\";\n      let fileId = \"\";\n      if (status === \"onDrag\") {\n        file = e.dataTransfer.files[0];\n        url = URL.createObjectURL(e.dataTransfer.files[0]);\n        fileId = e.dataTransfer.id;\n      } else {\n        file = e.target.files[0];\n        url = URL.createObjectURL(e.target.files[0]);\n        fileId = e.target.id;\n      }\n      if (file)\n        if (file.type.includes(\"image\")) {\n          let { nft } = this.state;\n          nft = { ...nft, [e.target.name]: file };\n\n          this.setState(\n            {\n              nft,\n              imageURL: url,\n              videoURL: \"\",\n              error: false,\n              errorMessage: \"\",\n            },\n            () => {\n              if (file) {\n                var reader = new FileReader();\n\n                reader.onload = function (e) {\n                  $(`#nft-${fileId}`).attr(\"src\", e.target.result);\n                  $(\"#nft-image-label\").html(\"File selected\");\n                };\n                reader.readAsDataURL(file);\n              }\n            }\n          );\n        } else if (file.type.includes(\"video\")) {\n          let { nft } = this.state;\n          nft = { ...nft, image: file };\n\n          this.setState({\n            nft,\n            videoURL: url,\n            // image:file,\n            imageURL: \"\",\n            error: false,\n            errorMessage: \"\",\n          });\n        } else if (file.type.includes(\"audio\")) {\n          let { nft } = this.state;\n          nft = { ...nft, audioUrl: file, image: file };\n\n          this.setState({\n            nft,\n            videoURL: \"\",\n            imageURL: \"\",\n            // image:file,\n            error: false,\n            errorMessage: \"\",\n            audioUrl: url,\n          });\n        } else {\n          $(`#nft-${fileId}`).attr(\"src\", placeholderImg);\n          file = {};\n        }\n    } else {\n      let message = this.handleFilesValidation(e, status);\n      this.setState({\n        error: true,\n        errorMessage: message,\n      });\n    }\n  };\n  dragOver = (e) => {\n    e.preventDefault();\n  };\n\n  dragEnter = (e) => {\n    e.preventDefault();\n  };\n\n  dragLeave = (e) => {\n    e.preventDefault();\n  };\n  onDrop = (e) => {\n    e.nativeEvent.preventDefault();\n    if (!e) return;\n\n    this.onFileChange(e, \"onDrag\");\n  };\n\n  handleFilesValidation = (e, status) => {\n    let files = \"\";\n    let type = \"\";\n    if (status === \"onDrag\") {\n      files = e.dataTransfer.files[0];\n      type = e.dataTransfer.files[0].type;\n    } else {\n      files = e.target.files[0];\n      type = e.target.files[0].type;\n    }\n    if (files) {\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\" ||\n        type === \"audio/mpeg\"\n      ) {\n        let fileSize = this.formatBytes(files.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          return \"File size limit is exceeded\";\n        } else {\n          return \"file matched\";\n        }\n      } else {\n        return \"File not supported!\";\n      }\n    }\n  };\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n  clearData = () => {\n    this.setState({\n      imageURL: \"\",\n      audioUrl: \"\",\n      videoURL: \"\",\n    });\n  };\n\n  render() {\n    const {\n      nft,\n      errors,\n      loader,\n      isSubmitted,\n      collections,\n      imageURL,\n      videoURL,\n      error,\n      errorMessage,\n      audioUrl,\n    } = this.state;\n\n    const { onDrop, dragOver, dragEnter, dragLeave } = this;\n\n    return (\n      <div>\n        <NavbarMain />\n        <Breadcrumb title1={\"NFT\"} title2={\"Create NFT\"} />\n        <section className=\"author-area padding-wrapper\">\n          {/* {loader && <FullPageLoader />} */}\n\n          <div className=\"container\">\n            <form>\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  {/* Intro */}\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Get started</span>\n                      <h3 className=\"mb-0\">Create NFT</h3>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-6 col-md-6 col-lg-4 left-container\">\n                  <p className=\"upload-title\">Upload</p>\n                  <div className=\"nft-left-upload p-3\">\n                    <div\n                      className=\"upload-image-container\"\n                      onDrop={(e) => onDrop(e)}\n                      onDragOver={(e) => dragOver(e)}\n                      onDragEnter={(e) => dragEnter(e)}\n                      onDragLeave={(e) => dragLeave(e)}\n                    >\n                      <Upload\n                        onFileChange={(e, status) =>\n                          this.onFileChange(e, status)\n                        }\n                        clearData={this.clearData}\n                        Images={Images}\n                        imageURL={imageURL}\n                        videoURL={videoURL}\n                        audioSrc={audioUrl}\n                        dragOver={dragOver}\n                        onDrop={onDrop}\n                        dragEnter={dragEnter}\n                        dragLeave={dragLeave}\n                      />\n                      <span className=\"text-danger text-center mt-3\">\n                        {this.validator.message(\"image\", nft.image, \"required\")}\n                      </span>\n\n                      {error && (\n                        <p className=\"text-danger text-center mt-3\">\n                          {errorMessage}\n                        </p>\n                      )}\n\n                      <div className=\"choose-file text-center my-5 \">\n                        <p className=\"mb-4\">or choose a file</p>\n\n                        <label>\n                          <span className=\"browse-files-btn mt-2\">\n                            Browse file\n                          </span>\n                          <input\n                            type=\"file\"\n                            style={{ display: \"none\" }}\n                            onChange={(e) => this.onFileChange(e, \"onChange\")}\n                            accept=\".mp4, .png,.jpeg\"\n                            name=\"image\"\n                          />\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-sm-6 col-md-6 col-lg-8 mt-5 mt-sm-0\">\n                  <p className=\"upload-title\">Create</p>\n                  <div className=\"nft-inputs-container p-4\">\n                    <div className=\"row g-4\">\n                      <div className=\"col-12\">\n                        <input\n                          name=\"name\"\n                          placeholder=\"Title*\"\n                          required=\"required\"\n                          maxLength=\"30\"\n                          minLength=\"3\"\n                          onKeyDown={(e) =>\n                            firstInputCharacterSpace(e, nft.name.length)\n                          }\n                          onChange={(e) => this.onChange(e)}\n                          value={nft.name}\n                          defaultValue={nft.name}\n                          autoComplete=\"off\"\n                        />\n                        <span className=\"text-danger\">\n                          {this.validator.message(\"name\", nft.name, \"required\")}\n                        </span>\n                      </div>\n                      <div className=\"col-12\">\n                        <textarea\n                          className=\"create-collection-textarea\"\n                          name=\"description\"\n                          rows=\"3\"\n                          placeholder=\"Description*\"\n                          maxLength=\"100\"\n                          onChange={(e) => this.onChange(e)}\n                          onKeyDown={(e) =>\n                            firstInputCharacterSpace(e, nft.description.length)\n                          }\n                          value={nft.description}\n                          defaultValue={nft.description}\n                        ></textarea>\n                        <span className=\"text-danger\">\n                          {this.validator.message(\n                            \"name\",\n                            nft.description,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"col-12 col-lg-6\">\n                        <input\n                          name=\"copies\"\n                          placeholder=\"No. of Copies*\"\n                          type=\"number\"\n                          min=\"0\"\n                          max=\"999\"\n                          maxLength={\"3\"}\n                          type=\"text\"\n                          required=\"required\"\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          onChange={(e) => {\n                            if (e.target.value.length && e.target.value === \"0\")\n                              return false;\n                            this.onChange(e);\n                          }}\n                          value={nft.copies}\n                          defaultValue={nft.copies}\n                        />\n                        <span className=\"text-danger\">\n                          {this.validator.message(\n                            \"name\",\n                            nft.copies,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n\n                      <div className=\"col-12 col-lg-6\">\n                        <select\n                          id=\"collectionId\"\n                          name=\"collectionId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Select Collection\n                          </option>\n                          {collections &&\n                            collections.length > 0 &&\n                            collections.map((collection, index) => {\n                              return (\n                                <option key={index} value={collection._id}>\n                                  {collection.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                        <span className=\"text-danger\">\n                          {this.validator.message(\n                            \"name\",\n                            nft.collectionId,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"create-properties-container d-flex align-items-center justify-content-between\">\n                          <div className=\"properties-content\">\n                            <p>Properties</p>\n                          </div>\n                          <div className=\"properties-btn\">\n                            <button\n                              onClick={() => {\n                                this.setState({\n                                  propertiesmodalShow: true,\n                                });\n                              }}\n                            >\n                              <img src={AddIcon} alt=\"add\" />\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"nft-properties-container\">\n                          <div className=\"row g-2\">\n                            <div className=\"col-md-6 col-lg-4\">\n                              <PropertiesInfo name={\"Usama\"} type={\"Male\"} />\n                            </div>\n                            <div className=\"col-md-6 col-lg-4\">\n                              {\" \"}\n                              <PropertiesInfo\n                                name={\"Aqsa\"}\n                                type={\"Female\"}\n                              />{\" \"}\n                            </div>\n                            <div className=\"col-md-6 col-lg-4\">\n                              <PropertiesInfo name={\"Usama\"} type={\"Male\"} />\n                            </div>\n                            <div className=\"col-md-6 col-lg-4\">\n                              {\" \"}\n                              <PropertiesInfo\n                                name={\"Aqsa\"}\n                                type={\"Female\"}\n                              />{\" \"}\n                            </div>\n                            <div className=\"col-md-6 col-lg-4\">\n                              <PropertiesInfo name={\"Usama\"} type={\"Male\"} />\n                            </div>\n                            <div className=\"col-md-6 col-lg-4\">\n                              {\" \"}\n                              <PropertiesInfo\n                                name={\"Aqsa\"}\n                                type={\"Female\"}\n                              />{\" \"}\n                            </div>\n                            <div className=\"col-md-6 col-lg-4\">\n                              <PropertiesInfo name={\"Usama\"} type={\"Male\"} />\n                            </div>\n                            <div className=\"col-md-6 col-lg-4\">\n                              {\" \"}\n                              <PropertiesInfo\n                                name={\"Aqsa\"}\n                                type={\"Female\"}\n                              />{\" \"}\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"create-properties-container d-flex align-items-center justify-content-between\">\n                          <div className=\"properties-content\">\n                            <p>Levels</p>\n                          </div>\n                          <div className=\"properties-btn\">\n                            <button\n                              onClick={() => {\n                                this.setState({\n                                  levelsmodalShow: true,\n                                });\n                              }}\n                            >\n                              <img src={AddIcon} alt=\"add\" />\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"nft-level-container\">\n                          <LevelsInfo name={\"usama\"} value={\"5\"} />\n                          <LevelsInfo name={\"aqsa\"} value={\"4\"} />\n                          <LevelsInfo name={\"aqsa\"} value={\"4\"} />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"create-properties-container d-flex align-items-center justify-content-between\">\n                          <div className=\"properties-content\">\n                            <p>Stats</p>\n                          </div>\n                          <div className=\"properties-btn\">\n                            <button\n                              onClick={() => {\n                                this.setState({\n                                  statsmodalShow: true,\n                                });\n                              }}\n                            >\n                              <img src={AddIcon} alt=\"add\" />\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"nft-stat-container\">\n                          <StatsInfo name={\"usama\"} value={\"5\"} />\n                          <StatsInfo name={\"aqsa\"} value={\"4\"} />\n                          <StatsInfo name={\"aqsa\"} value={\"4\"} />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <select\n                          id=\"collectionId\"\n                          name=\"collectionId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Blockchain\n                          </option>\n                        </select>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"nft-form-btns text-center \">\n                          <div className=\"d-flex  flex-column flex-md-row justify-content-center align-items-center\">\n                            <button\n                              disabled={loader}\n                              className=\"create-collection-btn mt-2 me-md-2\"\n                              typ=\"submit\"\n                              onClick={(e) => this.submit(e)}\n                            >\n                              Create Item\n                            </button>\n                            <button className=\"cancel-collection-btn mt-2\">\n                              Cancel\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </form>\n          </div>\n          <PropertiesModal\n            show={this.state.propertiesmodalShow}\n            onHide={() => {\n              this.setState({\n                propertiesmodalShow: false,\n              });\n            }}\n          />\n          <LevelsModal\n            show={this.state.levelsmodalShow}\n            onHide={() => {\n              this.setState({\n                levelsmodalShow: false,\n              });\n            }}\n          />\n          <StatsModal\n            show={this.state.statsmodalShow}\n            onHide={() => {\n              this.setState({\n                statsmodalShow: false,\n              });\n            }}\n          />\n        </section>\n        <Footer />\n      </div>\n    );\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  collection: state.collection,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollections,\n  addNFTRecord,\n  createNFT,\n  myCollections,\n  createActivity,\n})(CreateNFT);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/signup/signup.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.js",["474","475","476","477","478","479","480","481"],"import React, { useState, useEffect } from \"react\";\nimport { Redirect, useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"../wallet/wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  getCollections,\n  beforeCategory,\n  beforeCollection,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport { login, signup } from \"../user/user.action\";\nimport \"./wallet.css\";\n\nconst Wallet = (props) => {\n  const history = useHistory();\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [disabled,setDisabled]=useState(false)\n\n  const connectMetamaskCall = async () => {\n    setDisabled(true)\n    let connectedAddress = await connectMetamaskCopy();\n    if (connectedAddress){\n      setDisabled(false)\n    }\n    setConnectedAddress(connectedAddress);\n    setWalletAddress(connectedAddress);\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      console.log(\"errors\", props.error);\n\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setDisabled(false)\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    console.log(props.collection.getAuth, \"props.collection.getAuth\");\n    if (props.collection.getAuth === true) {\n      let collections = props.collection.collections;\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n\n      // let myCollections = collections.filter((el) => el.userId === userId);\n\n      // if (myCollections && myCollections.length > 0) {\n      props.beforeCollection();\n      //   history.push(\"/\");\n      // } else {\n      // }\n      history.push(\"/\");\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    \n    e.preventDefault();\n    setDisabled(true)\n    try {\n      if (validator.isEmail(email)) {\n        let sign = await signRequest();\n        let payload = {\n          address: connectedAddress,\n          // password: sign,\n          email: email,\n          username: username,\n          isApproved: false,\n        };\n        // console.log(payload, \"payload\");\n        props.signup(payload);\n      } else {\n        setErrorMessage(\"please enter valid email\");\n      }\n    } catch (err) {\n      toast.error(err.message);\n      setDisabled(false)\n    }\n  };\n\n  const login = async () => {\n    try {\n      setDisabled(true)\n      let sign = await signRequest();\n      let payload = {\n        address: connectedAddress,\n      };\n      \n      props.login(payload);\n    } catch (err) {\n      setDisabled(false)\n      toast.error(err.message);\n    }\n  };\n\n  const switchSignup = () => {\n    setShowSignUpComponent(true);\n  };\n\n  // if (props.user.userAuth) {\n  //     console.log(\"@@@@Collection-----@\", collections);\n  //     if(collections && collections.length>){\n  //         console.log(\"In Upper\")\n  //         return <Redirect to=\"/create\" />\n  //     }\n  //     else {\n  //         console.log(\"In Down\");\n  //         return <Redirect to=\"/collection/create\" />\n  //     }\n  // }\n\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div className=\"container\">\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Sign In</span>\n                  <h3 className=\"mt-3 mb-0\">SignIn to your account</h3>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                <div className=\"card single-wallet sign-in-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <h4 className=\"mb-0\">Address</h4>\n                    <p id=\"connected-address mt-3\">{connectedAddress}</p>\n                    {errorMessage && (\n                      <p className=\"text-gray\">{errorMessage}</p>\n                    )}\n                    {!showSignUp && (\n                      <>\n                        <button\n                          className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4\"\n                          type=\"button\"\n                          disabled={disabled}\n                          onClick={() => login()}\n                        >\n                          Sign In\n                        </button>\n                      </>\n                    )}\n                  \n                    {showSignUp && (\n                      <button\n                        className=\"btn btn-linear-gradient btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                        type=\"button\"\n                        onClick={() => switchSignup()}\n                      >\n                        Would you like to Signup?\n                      </button>\n                    )}\n                      {/* <div className=\"mt-3\">\n                      <a\n                        className=\"text-white back-link \"\n                        onClick={() => {\n                          setConnectedAddress(\"\");\n                          setWalletAddress(\"\");\n                        }}\n                      >\n                        Back\n                      </a>\n                    </div> */}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              {/* Intro */}\n              <div className=\"intro text-center\">\n                <span>SIGNUP</span>\n                <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                <p className=\"text-gray\">Create the account with the address</p>\n              </div>\n              {/* Item Form */}\n              <form\n                className=\"item-form card no-hover signup-card\"\n                onSubmit={(e) => signup(e)}\n              >\n                <div className=\"row\">\n                  {errorMessage && (\n                    <p className=\"text-center text-gray\">{errorMessage}</p>\n                  )}\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"address\"\n                        placeholder=\"Address\"\n                        required=\"required\"\n                        disabled={true}\n                        value={connectedAddress}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"email\"\n                        className=\"form-control sign-up-input\"\n                        name=\"email\"\n                        placeholder=\"Enter your Email\"\n                        required=\"required\"\n                        defaultValue={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"username\"\n                        placeholder=\"Enter your Username\"\n                        required=\"required\"\n                        defaultValue={username}\n                        onChange={(e) => setUsername(e.target.value)}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3 text-center\">\n                      <div className=\"form-check form-check-inline\">\n                        <input\n                          className=\"form-check-input\"\n                          type=\"radio\"\n                          name=\"inlineRadioOptions\"\n                          id=\"inlineRadio1\"\n                          defaultValue=\"option1\"\n                          autoComplete=\"off\"\n                        />\n                        <label\n                          className=\"form-check-label text-center text-gray\"\n                          htmlFor=\"inlineRadio1\"\n                        >\n                          I agree to{\" \"}\n                          <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"text-center\">\n                      <button\n                        className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4  text-white \"\n                        type=\"submit\"\n                        disabled={disabled}\n                      >\n                        Sign Up\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        ) : (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Wallet Connect</span>\n                  <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                  <p className=\"text-white mt-3\">\n                    Please select the wallet you want to connect to.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              {errorMessage && <p className=\"text-white\">{errorMessage}</p>}\n              <div\n                className=\"col-12 col-md-6 col-lg-4 item\"\n                onClick={() => connectMetamaskCall()}\n              >\n                {/* Single Wallet */}\n                <div className=\"card single-wallet whole-hover wallet-metamask-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <img\n                      className=\"avatar-lg\"\n                      src=\"/img/metamask2.png\"\n                      alt=\"\"\n                    />\n                    <h4 className=\"mb-0 my-3\">MetaMask</h4>\n                    <p>\n                      A browser extension with great flexibility. The web's most\n                      popular wallet\n                    </p>\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n  beforeCollection,\n})(Wallet);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["482","483","484","485","486","487","488","489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./SellNFT.css\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport PriceIcon from \"../../assets/images/priceIcon.svg\";\nimport DollarIcon from \"../../assets/images/dollarIcon.svg\";\nimport FeeIcon from \"../../assets/images/feeIcon.svg\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport \"bootstrap-daterangepicker/daterangepicker.css\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  getMyLikedNfts,\n  createActivity,\n} from \"../nfts/nfts.action\";\nimport {\n  openNFTForBidding,\n  putonsale,\n  getWalletAddress,\n  setApprovalForAll,\n  validateNetwork\n} from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport axios from \"axios\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport {updateProfile } from \"../user/user.action\";\n\nconst { currencies, dateRangeInitialSettings, serviceFee } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  listingSchedule: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\n\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n \n};\n\nconst SellNFT = (props) => {\n\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [activeBidBtn, setActiveBidBtn] = useState(false);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [liked, setLiked] = useState(false);\n  const [nft, setNft] = useState(null);\n  const [loader, setLoader] = useState(true); // NFT loader\n  const [tokensData, setTokensData] = useState([]);\n  const location = useLocation();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [likedNfts, setLikedNfts] = useState();\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const [copies, setCopies] = useState(\"\");\n  let nftId = props.match.params.id;\n\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getNFT(nftId);\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n    const { itemId } = props.match.params;\n    // if (itemId) props.getNFT(window.atob(itemId));\n    // else props.history.push(\"/explore-all\");\n    getTokens();\n  }, []);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNftDetail(props.nftDetail);\n      setNft(nft);\n      setLoader(false);\n      validateIfLiked(likedNfts, props.nftDetail);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const { nft } = props.nft.nftsData;\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // validateIfLiked(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  // when an error is received\n  useEffect(() => {\n    setLoader(false);\n  }, [props.error]);\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) {\n      data = fixedPriceConfig;\n    } else {\n      data = timedAuctionConfig;\n    }\n\n    const keys = name.split(\".\");\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) {\n      setFixedPriceConfig({ ...data });\n    } else {\n      setTimedAuctionConfig({ ...data });\n    }\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n\n  const submit = async (e) => {\n\n    e.preventDefault();\n    if(copies>nftDetail.copies){\n      toast.info(`Copies should b less than or equal to ${nftDetail.copies}`)\n      return ''\n    }\n    if(await validateNetwork())\n    {\n\n    \n    if(!nftDetail.user.isApproved){\n      var formData = new FormData();\n      formData.append(\"isApproved\", true);\n      formData.append(\"userId\", nftDetail.user._id);\n      try{\n        let profilePayload={\n          isApproved:true,\n          userId:nftDetail.user._id\n        }\n        \n        let accApproved=  await setApprovalForAll()\n        if(accApproved){\n          let updatedNFTDetail=nftDetail\n          updatedNFTDetail.user.isApproved=true;\n          setNftDetail(updatedNFTDetail)\n          props.updateProfile(formData)\n          toast.success(\"Your Account is Approved!\")\n          return ''\n        }\n      }catch(err){\n        toast.error(err)\n        return ''\n      }\n    }\n\n    let price = \"\";\n    let payload = \"\";\n\n    let timedConfig = { ...timedAuctionConfig };\n\n    let fixedConfig = { ...fixedPriceConfig };\n    const { _id, ownerId, ownerAddress } = nftDetail;\n\n    let activityPayload = {\n      nftId: _id,\n      ownerId,\n      fromAddress: await getWalletAddress(),\n      activityType: \"List\",\n    };\n\n    if (sellingMethod === 2) {\n      if(Number(timedConfig.startPrice.amount)===0)\n      {\n        toast.error(\"Price should be greater then 0\")\n        return ''\n      }\n      let timedAuctionStartTime = new Date(timedConfig.duration.startDate);\n      let timedAuctionEndTime = new Date(timedConfig.duration.endDate);\n\n      timedAuctionEndTime = timedAuctionEndTime.toString();\n      timedAuctionEndTime =\n        timedAuctionEndTime.slice(0, 15) +\n        \" \" +\n        timedConfig.duration.endTime +\n        \":59\" +\n        timedAuctionEndTime.slice(24);\n      timedConfig.duration.endDate = timedAuctionEndTime;\n\n      timedAuctionStartTime = timedAuctionStartTime.toString();\n      timedAuctionStartTime =\n        timedAuctionStartTime.slice(0, 15) +\n        \" \" +\n        timedConfig.duration.startTime +\n        \":59\" +\n        timedAuctionStartTime.slice(24);\n      timedConfig.duration.startDate = timedAuctionStartTime;\n\n      let auctionConfig = timedConfig;\n      delete auctionConfig.duration.startTime;\n      delete auctionConfig.duration.endTime;\n      delete auctionConfig.method;\n      price = Number(auctionConfig.startPrice.amount);\n      auctionConfig.startPrice.amount = Number(auctionConfig.startPrice.amount);\n\n      payload = {\n        _id: location.state._id,\n        sellingMethod,\n        sellingConfig: JSON.stringify(auctionConfig),\n        copiesForAuction: copies,\n      };\n   \n    } else {\n      \n      //  fixedConfig.price.amount;\n      delete fixedConfig.listingSchedule.startTime;\n      delete fixedConfig.listingSchedule.endTime;\n      delete fixedConfig.listingSchedule.startDate;\n      delete fixedConfig.listingSchedule.endDate;\n      delete fixedConfig.listingSchedule;\n      price = Number(fixedConfig.price.amount);\n      if(price===0)\n      {\n        toast.error(\"Price should be greater then 0\")\n        return ''\n      }\n      payload = {\n        _id: location.state._id,\n        sellingMethod,\n        sellingConfig: JSON.stringify(fixedConfig),\n        copiesForAuction: copies,\n      };\n    }\n\n    setLoader(true);\n\n    var formData = new FormData();\n    for (const key in payload) formData.append(key, payload[key]);\n    if (sellingMethod === 2) {\n      try {\n\n        let auctionEndDate = timedAuctionConfig.duration.endDate;\n        let auctionStartDate = timedAuctionConfig.duration.startDate;\n\n        const biddingTime = new Date(auctionEndDate).getTime();\n        const startTime = new Date(auctionStartDate).getTime();\n\n        let result = await openNFTForBidding(\n          biddingTime,\n          startTime,\n          location.state.nftToken\n        );\n        if (result) {\n          activityPayload.price = price;\n\n          props.createActivity(activityPayload);\n          props.upsertNFT(\"edit\", formData, \"PUT\");\n        }\n      } catch (err) {\n        setLoader(false);\n        toast.error(err);\n      }\n    } else {\n      try {\n        let result = await putonsale(\n          nftDetail.nftToken,\n          1,\n          fixedConfig.price.amount\n        );\n\n        if (result) {\n          activityPayload.price = price;\n\n          props.createActivity(activityPayload);\n          props.upsertNFT(\"edit\", formData, \"PUT\");\n        }\n      } catch (err) {\n        setLoader(false);\n        toast.error(err);\n      }\n    }\n  }else {\n    toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\")\n  }\n  };\n\n  const handleLikesTogleApi = (nftId, status) => {\n   \n\n    if (!likeButtonDisable) {\n      setLikeBtnDisable(true);\n      setToggle(!toggle);\n\n      let userId = ENV.getUserKeys(\"_id\")._id;\n\n      let data = {\n        userId,\n        nftId,\n        count: 1,\n      };\n\n      if ((status === \"dislike\") & (nftDetail.likesCount > 0)) {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount - 1;\n        setLiked(false);\n        setNftDetail(nft);\n        props.toggleLikeDislike(data);\n      } else {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount + 1;\n\n        setNftDetail(nft);\n        setLiked(true);\n        props.toggleLikeDislike(data);\n      }\n    }\n  };\n\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      setLoader(false);\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      setLoader(false);\n      return setToggle(false);\n    }\n  };\n  const auctionEndTimeConversion = (auctionEndDate) => {\n    var dateString = moment.utc(auctionEndDate).format(\"MMMM D, Y\");\n    var timeString = moment.utc(auctionEndDate).format(\"h:mma\");\n    var totalDateTime = dateString + \" at \" + timeString + \" PKT\";\n    return totalDateTime;\n  };\n\n  const getTokens = () => {\n    const url = process.env.REACT_APP_BASE_URL + \"nftTokens/tokens\";\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        setTokensData(data);\n      })\n      .catch((error) => {\n        console.log(error, \"error in catch blcok\");\n      });\n  };\n  const { image, currentPrice, likesCount, auctionEndDate } = nftDetail;\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n      <NavbarMain />\n      <section className=\"padding-wrapper nft-detail\">\n        <form onSubmit={submit}>\n          <div className=\"container\">\n            <div className=\"row g-3\">\n              <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n                <div className=\"row\">\n                  <div className=\"col-12 order-2 order-md-1\">\n                    <div className=\"intro mb-5\">\n                      <div className=\"intro-content\">\n                        <span>SellNFTs</span>\n                        <h3 className=\"mb-0\">List of bundles for sale</h3>\n                      </div>\n                    </div>\n                    <div className=\"sale-btn-container mt-5 mb-4\">\n                      <button\n                        className={` ${\n                          activeBtn === 0\n                            ? \"sell-btn-active\"\n                            : \"sell-btn-not-active\"\n                        }  me-3 `}\n                        onClick={() => {\n                          setActiveBtn(0);\n                          setSellingMethod(1);\n                          setCopies(\"\");\n                        }}\n                      >\n                        <svg\n                          xmlns=\"http://www.w3.org/2000/svg\"\n                          width=\"7\"\n                          height=\"14\"\n                          className=\"me-1 me-sm-2\"\n                        >\n                          <path\n                            fill-rule=\"evenodd\"\n                            fill=\"#FDFDFD\"\n                            d=\"M3.974 6.71H3.22c-.939 0-1.527-1.317-1.443-2.098.07-.693.672-1.179 1.329-1.179h1.12c.419 0 .769.31 1.564.722-.683.118-.585.192-.473.192h1.259c.14 0 .266-.133.252.323-.126-1.944-1.161-2.991-2.449-3.079V.265A.256.256 0 0 0 4.128 0h-1.26a.257.257 0 0 0-.252.265v1.341C1.49 1.827.139 3.315.14 5.69c.028 1.03 1.441 2.238 3.008 2.238h.826c.741 0 1.329.678 1.245 1.459-.07 1.413-.671 1.179-1.329 1.179H2.77c-.419 0-.67-.309-.853-.722a.242.242 0 0 0-.238-.191H.42a.262.262 0 0 0-.252.28c.126 1.341 1.161 2.387 2.449 2.475v1.327c0 .147.112.265.251.265h1.26c.14 0 .252-.118.252-.265v-1.356c1.343-.236 2.462-.999 2.602-2.8C7.15 7.678 5.737 6.71 3.974 6.71z\"\n                          />\n                        </svg>\n                        Fixed Prize\n                      </button>\n                      <button\n                        className={` ${\n                          activeBtn === 1\n                            ? \"sell-btn-active\"\n                            : \"sell-btn-not-active\"\n                        } `}\n                        onClick={() => {\n                          setActiveBtn(1);\n                          setSellingMethod(2);\n                          setCopies(\"\");\n                        }}\n                      >\n                        <svg\n                          xmlns=\"http://www.w3.org/2000/svg\"\n                          width=\"16\"\n                          height=\"16\"\n                          className=\"me-1 me-sm-2\"\n                        >\n                          <path\n                            fill-rule=\"evenodd\"\n                            fill=\"#FFF\"\n                            d=\"M7.999 15.999a7.999 7.999 0 0 1-7.999-8A7.999 7.999 0 0 1 7.999 0c4.419 0 8 3.581 8 7.999a8 8 0 0 1-8 8zm0-14.4a6.4 6.4 0 1 0 .002 12.802 6.4 6.4 0 0 0-.002-12.802zm1.957 8.666L8.268 9.14a.42.42 0 0 0-.022-.015c.664.095-.313-.209-.442-.313a1.581 1.581 0 0 1-.415-.486 1.572 1.572 0 0 1-.174-.615c-.016-.165-.015-.355-.015-.541V3.999a.8.8 0 0 1 .8-.8h-.001a.8.8 0 0 1 .8.8v3.144c0 .224.001.338.009.42v.004l.003.002c.064.052.158.115.345.24l1.687 1.125c.368.245.467.742.807 1.496-.83-.019-1.327.08-1.694-.165z\"\n                          />\n                        </svg>\n                        Timed Auction\n                      </button>\n                    </div>\n                    <div className=\"nftDetail-accordion\">\n                      <div\n                        className=\"accordion accordion-flush \"\n                        id=\"accordionFlushExample\"\n                      >\n                        {activeBtn === 0 ? (\n                          <>\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingOne\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseOne\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseOne\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  Price\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseOne\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingOne\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-price-container mx-auto\">\n                                    <div className=\"sell-price-inp d-flex align-items-center\">\n                                      <div className=\"sell-price-currency text-center\">\n                                        <span> ETH </span>\n                                      </div>\n                                      <input\n                                        type=\"text\"\n                                        name=\"fixedPriceConfig.price.amount\"\n                                        placeholder=\"Amount\"\n                                        style={{\n                                          borderRadius: \"4px\",\n                                        }}\n                                        maxLength={\"8\"}\n                                        onChange={(e) => onChange(e)}\n                                        onKeyDown={(e) =>\n                                          decimalNumberValidator(e)\n                                        }\n                                        defaultValue={\n                                          fixedPriceConfig.price.amount\n                                        }\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingNine\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseNine\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseNine\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  No. of Copies\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseNine\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingNine\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-price-container mx-auto\">\n                                    <div className=\"sell-price-inp d-flex align-items-center\">\n                                      <div className=\"sell-price-currency text-center\">\n                                        <span> Copies </span>\n                                      </div>\n                                      <input\n                                        type=\"text\"\n                                        name=\"timedAuctionConfig.startPrice.amount\"\n                                        placeholder=\"Copies\"\n                                        maxLength={\"3\"}\n                                        style={{\n                                          borderRadius: \"4px\",\n                                        }}\n                                        min={\"1\"}\n                                        max={`${nftDetail.copies}`}\n                                        onChange={(e) =>{\n                                            if((e.target.value && e.target.value==='.')||(e.target.value && e.target.value=='0'))\n                                            {\n                                              return false\n                                            }\n                                          setCopies(e.target.value)\n                                        }\n                                        }\n                                        onKeyDown={(e) =>\n                                          decimalNumberValidator(e)\n                                        }\n                                        value={copies}\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n\n                            {/* <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingTwo\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Schedule Listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"date-picker sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"fixedPriceConfig.listingSchedule\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div> */}\n                          </>\n                        ) : (\n                          <>\n                            {/* <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingThree\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseThree\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseThree\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  Bid option\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseThree\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingThree\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-bid-opt-container mx-auto\">\n                                    <button\n                                      className={`${\n                                        activeBidBtn ? \"sell-bid-active\" : \"\"\n                                      } sell-bid-opt-btn`}\n                                      onClick={() =>\n                                        setActiveBidBtn(!activeBidBtn)\n                                      }\n                                    >\n                                      Sell To The Highest Bidder\n                                    </button>\n                                  </div>\n                                </div>\n                              </div>\n                            </div> */}\n\n\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingFour\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseFour\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseFour\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  Price\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseFour\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingFour\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-price-container mx-auto\">\n                                    <div className=\"sell-price-inp d-flex align-items-center\">\n                                      <div className=\"sell-price-currency text-center\">\n                                        <span> ETH </span>\n                                      </div>\n                                      <input\n                                        type=\"text\"\n                                        name=\"timedAuctionConfig.startPrice.amount\"\n                                        placeholder=\"Amount\"\n                                        maxLength=\"8\"\n                                        style={{\n                                          borderRadius: \"4px\",\n                                        }}\n                                        onChange={(e) => onChange(e)}\n                                        onKeyDown={(e) =>\n                                          decimalNumberValidator(e)\n                                        }\n                                        defaultValue={\n                                          fixedPriceConfig.price.amount\n                                        }\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingTen\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseTen\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseTen\"\n                                >\n                                  <img\n                                    src={PriceIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  No. of Copies\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseTen\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingTen\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-price-container mx-auto\">\n                                    <div className=\"sell-price-inp d-flex align-items-center\">\n                                      <div className=\"sell-price-currency text-center\">\n                                        <span> Copies </span>\n                                      </div>\n                                      <input\n                                        type=\"text\"\n                                        name=\"timedAuctionConfig.startPrice.amount\"\n                                        placeholder=\"Copies\"\n                                        style={{\n                                          borderRadius: \"4px\",\n                                        }}\n                                        maxLength=\"3\"\n                                        min={\"1\"}\n                                        max={`${nftDetail.copies}`}\n                                        maxLength={3}\n                                        onChange={(e) =>{\n                                          if((e.target.value && e.target.value==='.')||(e.target.value && e.target.value=='0'))\n                                          {\n                                            return false\n                                          }\n                                          setCopies(e.target.value)\n                                        }\n                                          \n                                        }\n                                        onKeyDown={(e) =>\n                                          decimalNumberValidator(e)\n                                        }\n                                        value={copies}\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                            <div className=\"accordion-item\">\n                              <h2\n                                className=\"accordion-header\"\n                                id=\"flush-headingSix\"\n                              >\n                                <button\n                                  className=\"accordion-button collapsed\"\n                                  type=\"button\"\n                                  data-toggle=\"collapse\"\n                                  data-target=\"#flush-collapseSix\"\n                                  aria-expanded=\"false\"\n                                  aria-controls=\"flush-collapseSix\"\n                                >\n                                  <img\n                                    src={ClockIcon}\n                                    alt=\"price-history\"\n                                    className=\"me-2\"\n                                  />\n                                  Duration\n                                </button>\n                              </h2>\n                              <div\n                                id=\"flush-collapseSix\"\n                                className=\"accordion-collapse collapse\"\n                                aria-labelledby=\"flush-headingSix\"\n                              >\n                                <div className=\"accordion-body\">\n                                  <div className=\"sell-date-picker mx-auto\">\n                                    <DateRangePicker\n                                      initialSettings={dateRangeInitialSettings}\n                                      onApply={handleDateChange}\n                                    >\n                                      <button\n                                        name=\"timedAuctionConfig.duration\"\n                                        className=\"calender-btn\"\n                                        type=\"button\"\n                                      >\n                                        {moment(\n                                          timedAuctionConfig.duration.startDate\n                                        ).format(\"MMMM D, YYYY\")}{\" \"}\n                                        -{\" \"}\n                                        {moment(\n                                          timedAuctionConfig.duration.endDate\n                                        ).format(\"MMMM D, YYYY\")}\n                                        &nbsp;&nbsp;&nbsp;\n                                        <i className=\"fas fa-calendar-week\" />\n                                      </button>\n                                    </DateRangePicker>\n                                  </div>\n                                  <div className=\"sell-time-container\">\n                                    <div className=\"sell-time-inp mx-auto my-3\">\n                                      <input\n                                        type=\"time\"\n                                        name=\"timedAuctionConfig.duration.startTime\"\n                                        placeholder=\"Start Time\"\n                                        className=\"py-1\"\n                                        onChange={(e) => onChange(e)}\n                                        defaultValue={\n                                          timedAuctionConfig.duration.startTime\n                                        }\n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n\n                                    <div className=\"sell-time-inp mx-auto my-3\">\n                                      <input\n                                        type=\"time\"\n                                        name=\"timedAuctionConfig.duration.endTime\"\n                                        placeholder=\"End Time\"\n                                        className=\"py-1\"\n                                        onChange={(e) => onChange(e)}\n                                        defaultValue={\n                                          timedAuctionConfig.duration.endTime\n                                        }\n                                     \n                                        required\n                                        autoComplete=\"off\"\n                                      />\n                                    </div>\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                    <div className=\"row\">\n                      <div className=\"col-10 col-sm-6 col-md-8 col-lg-6  col-xl-4\">\n                        <div className=\"sell-fee-container\">\n                          <div className=\"sell-fee-title d-flex align-items-center mb-2\">\n                            <img src={FeeIcon} alt=\"feeIcon\" className=\"me-2\" />\n                            <h6>Fees</h6>\n                          </div>\n                          <div className=\"sell-fee-content d-flex align-items-center justify-content-between mb-1\">\n                            <p>Service Fee</p>\n                            <p>2.5 %</p>\n                          </div>\n                          <div className=\"sell-fee-content d-flex align-items-center justify-content-between\">\n                            <p>Creator Royalty</p>\n                            <p>2.5 %</p>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 text-center mt-5\">\n                        <button\n                          className=\"complete-btn px-5\"\n                          type=\"submit\"\n                          // onClick={() => submit()}\n                        >\n                          {\" \"}\n                          Complete Listing{\" \"}\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n                <Card className=\"auction-card detail-card\">\n                  <div className=\"auction-img-wrapper\">\n                    {nftDetail && nftDetail.fileType === \"image\" ? (\n                      <Card.Img variant=\"top\" src={image} alt=\"AuctionTopImg\" />\n                    ) : nftDetail && nftDetail.fileType === \"video\" ? (\n                      <div className=\"card-img-top\">\n                        <div className=\"video-wrapper\">\n                          <video\n                            src={nftDetail.image}\n                            ref={videoElement}\n                            onTimeUpdate={handleOnTimeUpdate}\n                          />\n                          <div className=\"controls\">\n                            <div className=\"actions\">\n                              <button\n                                className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                                onClick={togglePlay}\n                              >\n                                {playerState.isPlaying ? (\n                                  <BsFillPauseFill />\n                                ) : (\n                                  <BsFillPlayFill />\n                                )}\n                              </button>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    ) : (\n                      \"\"\n                    )}\n\n                    {/* //InCaseOfVideoCard */}\n                  </div>\n                  <Card.Body>\n                    <div className=\"detail-card-name-container d-flex align-items-center justify-content-between\">\n                      <div className=\"detail-nft-name\">\n                        <h5>{nftDetail.name}</h5>\n                      </div>\n                      <div className=\"likes-container d-flex align-items-center\">\n                        {toggle ? (\n                          <>\n                            <AiFillHeart\n                              className=\"heart-fill-icon \"\n                              onClick={() => {\n                                handleLikesTogleApi(nftDetail._id, \"dislike\");\n                              }}\n                            />\n                            <p className=\"text-white\">\n                              {nftDetail.likesCount ? nftDetail.likesCount : 0}{\" \"}\n                            </p>\n                          </>\n                        ) : (\n                          <>\n                            <img\n                              src={HeartIcon}\n                              alt=\"heart-icon\"\n                              className=\"ms-1\"\n                              onClick={() => {\n                                handleLikesTogleApi(nftDetail._id, \"like\");\n                              }}\n                            />\n\n                            <span className=\"ms-1\">\n                              {nftDetail.likesCount ? nftDetail.likesCount : 0}\n                            </span>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                    {currentPrice !== null && (\n                      <div>\n                        <h3>\n                          {currentPrice}\n                          <span>\n                            {\" \"}\n                            ($ {(currentPrice * exchangeRate).toFixed(2)})\n                          </span>\n                        </h3>\n                      </div>\n                    )}\n\n                    <div className=\"detail-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n                      {\n                        nftDetail &&\n                      <div className=\"detail-nft-owner\">\n                        <p>\n                          Owned by <span>{nftDetail.ownerId===ENV.getUserKeys(\"_id\")._id ?\"You\":nftDetail.user.username}</span>\n                        </p>\n                      </div>\n                      }\n                      <div className=\"detail-nft-copies\">\n                        <p>\n                        {nftDetail?.remainingCopies?nftDetail?.remainingCopies:nftDetail.copies}{\" \"}\n                          {nftDetail.copies === 1 ? \"Copy\" : \"Copies\"}\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                      {nftDetail.sellingMethod === 2 && (\n                        <div className=\"d-flex align-items-center\">\n                          <img\n                            src={ClockIcon}\n                            alt=\"clock-icon\"\n                            className=\"me-1\"\n                          />\n                          <span>\n                            Sale ends {auctionEndTimeConversion(auctionEndDate)}{\" \"}\n                          </span>\n                        </div>\n                      )}\n                    </div>\n                  </Card.Body>\n                </Card>\n              </div>\n            </div>\n          </div>\n        </form>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  error: state.error,\n  nftDetail: state.nft.nftsData,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  beforeTogleLikeDislike,\n  createActivity,\n  updateProfile\n})(SellNFT);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["505","506","507","508","509","510","511","512","513","514","515","516","517","518","519"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["520","521","522","523","524","525","526","527","528","529","530"],"import React, { useState, useEffect } from 'react';\nimport { useLocation,useHistory } from 'react-router-dom';\nimport NavbarMain from '../navbar-main/NavbarMain';\nimport Footer from '../footer/footer';\nimport './collectiondetails.css';\nimport FlagIcon from '../../assets/images/detail-flag.svg';\nimport ShareIcon from '../../assets/images/detail-share.svg';\nimport TickIcon from '../../assets/images/seller-tick-icon.svg';\nimport SearchIcon from '../../assets/images/nav-search-icon.svg';\nimport ListingCards from '../listing-cards/ListingCards';\nimport FilterComponent from '../filter-component/FilterComponent';\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from '../nfts/nfts.action';\nimport { connect } from 'react-redux';\nimport FullPageLoader from '../full-page-loader/full-page-loader';\nimport { ENV } from '../../config/config';\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from '../explore/explore.action';\nimport Breadcrumb from '../breadcrumb/breadcrumb';\nimport VideoCard from '../test-video-card/videoCard';\nimport BannerPh from '../../assets/images/collection-detailBg.png';\nimport { validateNetwork } from '../../utils/web3';\nimport { toast } from 'react-toastify';\nconst CollectionDetailsPage = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [minValue, setMinValue] = useState('');\n  const [maxValue, setMaxValue] = useState('');\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [keyword, setKeyword] = useState('');\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n  });\n  const location = useLocation();\n  const history=useHistory()\n\n  const itemoptions = [\n    { value: 'single', label: 'Single' },\n    { value: 'double', label: 'Double' },\n  ];\n\n  const sortoptions = [\n    { value: 'lowtohigh', label: 'Low To High' },\n    { value: 'hightolow', label: 'High To Low' },\n    { value: 'oldest', label: 'Oldest' },\n    { value: 'newest', label: 'Recantly Created' },\n  ];\n\n  const filterData = {\n    status: {\n      label: 'Status',\n      option: ['Buy Now', 'On Auction', 'New', 'Has Offer'],\n    },\n    chains: {\n      label: 'Chains',\n      option: ['Ethereum'],\n    },\n  };\n\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys('_id')._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      if (props.nfts.length > 0) {\n        setDisabled(false);\n      } else {\n        if (initial) {\n          setDisabled(true);\n        }\n      }\n      setNfts(props.nfts);\n\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 40,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter,\n    keyword,\n    buy,\n    auction,\n    latest\n  ) => {\n    setFilterationLoader(true);\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    nftQS.collectionId = location.state._id;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    if (keyword) nftQS.keyword = keyword;\n    if (buy) nftQS.buy = buy;\n    if (auction) nftQS.auction = auction;\n    if (latest) nftQS.latest = latest;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getNFTs(qs);\n  };\n\n  const handleSortOptions = (e) => {\n    setInitial(false);\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === 'Low To High') {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === 'High To Low') {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === 'Oldest') {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === 'Recantly Created') {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    setInitial(false);\n    setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      filter.gtePrice,\n      filter.ltePrice,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false);\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      id == 'Buy Now' ? true : false,\n      id == 'On Auction' ? true : false,\n      id == 'New' ? true : false\n    );\n  };\n\n  const handleSearchKeyword = () => {\n    setInitial(false);\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n  ///////////Likes\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys('_id')._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === 'dislike' && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, 'dec');\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === 'like') {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: '1234455',\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, 'inc');\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error('Please Connect Your Metamask With Ethereum Rinkby Network');\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === 'dec') {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const { name, banner, logo, description, username } = location.state;\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n\n      <NavbarMain />\n      <Breadcrumb title1={'Collections'} title2={'CollectionDetail'} title1Handler={()=>history.push('/explore/exploreAll')} />\n      <div className='collection-detail-hero w-100'>\n        <img className='w-100' src={BannerPh} alt='BannerImg' />\n      </div>\n      <div className='collection-detail-content'>\n        <div className='container'>\n          <div className='row'>\n            <div className='col-12'>\n              <div className='collection-owner-avatar'>\n                <img src={logo} alt='owner-avatar' />\n              </div>\n              <div className='d-md-flex align-items-center justify-content-between mt-5'>\n                <div className='collection-owner-detail'>\n                  <div className='collection-owner-name d-flex align-items-center'>\n                    <h3>\n                      {name}{' '}\n                      <img src={TickIcon} alt='tick-icon' className='ms-2' />\n                    </h3>\n                  </div>\n                  {username && username?.[0] && (\n                    <p>\n                      Created by <span>{username?.[0]}</span>\n                    </p>\n                  )}\n                </div>\n                <div className=' d-block d-md-none'>\n                  <div className='collection-owner-detail pe-xl-5 mt-4'>\n                    <p>{description}</p>\n                  </div>\n                </div>\n                {/* <div className=\"collection-owner-btns mt-3 mt-md-0 ms-auto\">\n                      <button className=\"me-1 me-sm-2 me-lg-3\">\n                        <img src={FlagIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button className=\"me-1 me-sm-1 me-lg-3\">\n                        <img src={ShareIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button>+ Add to wishlist</button>\n                    </div> */}\n              </div>\n            </div>\n            <div className='col-12 col-sm-7 col-md-6 col-lg-5 d-none d-md-block'>\n              <div className='collection-owner-detail pe-xl-5 mt-4'>\n                <p>{description}</p>\n              </div>\n            </div>\n            {/* <div className=\"col-12 col-lg-7 mt-3 mt-sm-5\">\n                  <div className=\"d-flex align-items-center justify-content-center justify-content-lg-end\">\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>items</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Owner</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Prize floor</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Volume trade</p>\n                    </div>\n                  </div>\n                </div> */}\n          </div>\n          <div className='collections-listing padding-wrapper'>\n            <div className='row g-3 align-items-center justify-content-center justify-content-lg-start '>\n              <div className='col-12 col-sm-10 col-md-4 col-lg-3'>\n                <div className='collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0'>\n                  <img\n                    src={SearchIcon}\n                    alt='search-icon'\n                    className='ms-3'\n                    onClick={handleSearchKeyword}\n                  />\n                  <input\n                    type='text'\n                    className='form-control'\n                    placeholder='Search'\n                    onChange={(e) => setKeyword(e.target.value)}\n                    onKeyPress={(e) =>\n                      e.key === 'Enter' && handleSearchKeyword()\n                    }\n                  />\n                </div>\n              </div>\n              <div className='col-12 col-sm-10 col-md-4 col-lg-3'>\n                <div className='collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0'>\n                  <div className='ms-2'>\n                    <p>Item:</p>\n                  </div>\n\n                  <select name='collection-select'>\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option\n                            key={index}\n                            value={collection.label}\n                            disabled={disabled}\n                          >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className='col-12 col-sm-10 col-md-4 col-lg-3'>\n                <div className='collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0'>\n                  <div className='ms-2'>\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name='collection-select' onChange={handleSortOptions}>\n                    {sortoptions &&\n                      sortoptions.map((collection, index) => {\n                        return (\n                          <option\n                            key={index}\n                            value={collection.label}\n                            disabled={disabled}\n                          >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className='col-12 d-sm-none'>\n                <div className='sm-filter-btn d-flex align-items-center justify-content-center'>\n                  <button\n                    className={`${\n                      activeFilter ? 'filter-btn-active' : 'filter-btn-inactive'\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? 'd-block' : 'd-none'\n                  } sm-filter-options`}\n                >\n                  <div className='col-10 mx-auto mt-2'>\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                      onChangeMinPrice={onChangeMinPrice}\n                      onChangeMaxPrice={onChangeMaxPrice}\n                      minValue={minValue}\n                      maxValue={maxValue}\n                      applyMinMaxFilter={applyMinMaxFilter}\n                      handleStatusFilter={handleStatusFilter}\n                      disabled={disabled}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className='row mt-5'>\n            <div className='col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block'>\n              <FilterComponent\n                Status={filterData.status}\n                Chains={filterData.chains}\n                onChangeMinPrice={onChangeMinPrice}\n                onChangeMaxPrice={onChangeMaxPrice}\n                minValue={minValue}\n                maxValue={maxValue}\n                applyMinMaxFilter={applyMinMaxFilter}\n                handleStatusFilter={handleStatusFilter}\n                disabled={disabled}\n              />\n            </div>\n            <div className='col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0'>\n              <div className='row g-3'>\n                {filterationLoader ? (\n                  <div className='text-center'>\n                    <div\n                      class='spinner-border text-secondary text-white '\n                      role='status'\n                    >\n                      <span class='sr-only'>Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((listing) => {\n                    return (\n                      <div className='col-6 col-md-4 col-lg-3 px-1'>\n                        {listing.fileType === 'image' ? (\n                          <ListingCards\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            sellingMethod={listing.sellingMethod}\n                          />\n                        ) : (\n                          <VideoCard\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            fileType={listing.fileType}\n                            sellingMethod={listing.sellingMethod}\n                          />\n                        )}\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className='text-white mt-5 text-center no-nfts-title'>\n                    No NFT's Found\n                  </p>\n                )}\n              </div>\n              <div className='col-12'>\n                <div className='mt-5 text-center'>\n                  {nfts && props.pagination > nfts.length && nfts.length > 10 && (\n                    <button\n                      className='btn btn-linear-gradient px-5'\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftsData.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n})(CollectionDetailsPage);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["531","532","533","534","535","536","537","538","539","540","541","542","543","544","545","546","547","548"],"import React, { useEffect, useState } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport \"./user-edit-profile.css\";\nimport { editImages } from \"../../assets/assets\";\nimport { ReactComponent as ProfileEditSVG } from \"../../assets/images/edit-pen.svg\";\n/////////\n\nimport { connect } from \"react-redux\";\nimport { SET_INDIVIDUAL_USER } from \"../../redux/types\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { signRequest } from \"./../../utils/web3\";\nimport { ENV } from \"./../../config/config\";\nimport { toast } from \"react-toastify\";\nimport { useHistory } from \"react-router-dom\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\n\nconst EditProfile = (props) => {\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [facebookLink, setFbLink] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [gPlusLink, setgPlusLink] = useState(\"\");\n  const [vineLink, setVineLink] = useState(\"\");\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const [bioError, setBioError] = useState(false);\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      props.beforeUser();\n      setLoader(false);\n\n      setConnectedAddress(address ? address : \"\");\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      setBannerUrl(bannerImage ? bannerImage : \"\");\n      setImage(profileImage ? profileImage : \"\");\n      setBannerImage(bannerImage ? bannerImage : \"\");\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      setLoader(false);\n      props.beforeUser();\n      history.push(\"/userprofile\");\n    }\n  }, [props.user.userAuth]);\n\n  useEffect(() => {\n    if (props.error) {\n      setErrors(props.error.message);\n      goToTop();\n    }\n  }, [props.error]);\n\n  const goToTop = () => {\n    $(\"html, body\").animate(\n      {\n        scrollTop: 0,\n      },\n      600\n    );\n  };\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setImageUrl(fileURL);\n      setImage(file);\n    }\n  };\n\n  const onBannerChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setBannerUrl(fileURL);\n      setBannerImage(file);\n    }\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    let obj = {\n      image,\n      banner,\n      username,\n      instaLink,\n      webLink,\n      description,\n      email,\n      address,\n      instaLink,\n      twitterLink,\n    };\n    if (description && description.length < 3) {\n      setBioError(true);\n      return \"\";\n    } else {\n      setBioError(false);\n    }\n    setErrors(\"\");\n    setLoader(true);\n    setIsSubmitted(true);\n    let isFormValid = validator.allValid() ? true : false;\n    if (isFormValid) {\n      try {\n        // let signature = await signRequest();\n        setLoader(true);\n\n        var formData = new FormData();\n        formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n        if (image) {\n          formData.append(\"profileImage\", image);\n        }\n        if (banner) {\n          formData.append(\"bannerImage\", banner);\n        }\n        formData.append(\"bio\", description);\n        formData.append(\"twitterLink\", twitterLink);\n        formData.append(\"username\", username);\n        formData.append(\"email\", email);\n        formData.append(\"webLink\", webLink);\n        formData.append(\"instaLink\", instaLink);\n\n        // return ''\n        props.updateProfile(formData);\n      } catch (e) {\n        console.log(\"in catch block\");\n        setLoader(false);\n      }\n    } else {\n      validator.showMessages();\n      setErrors(\"Please fill all required fields in valid format.\");\n      goToTop();\n    }\n  };\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n      <NavbarMain />\n      <Breadcrumb title1={\"Profile\"} title2={\"EditProfile\"} />\n      <section className=\"edit-profile padding-wrapper\">\n        <form onSubmit={submit}>\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Set Up Your Profile</span>\n                    <h3 className=\"mb-0\">Profile Setting</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                <div className=\"edit-inp-subheading\">\n                  <h6>Profile Image</h6>\n                </div>\n                <div className=\"edit-avatar pt-4\">\n                  <img\n                    src={imageUrl ? imageUrl : editImages.EditAvatar}\n                    alt=\"editavatar\"\n                  />\n\n                  <label>\n                    <div className=\"avatar-btn-pen\">\n                      <ProfileEditSVG />\n                    </div>\n                    <input\n                      type=\"file\"\n                      accept=\".png,.jpeg,.jpg\"\n                      onChange={(e) => onFileChange(e)}\n                      style={{ display: \"none\" }}\n                      name=\"image\"\n                    />\n                  </label>\n                </div>\n                <div className=\"edit-banner-container\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Profile Banner</h6>\n                  </div>\n                  <div className=\"edit-banner pt-4\">\n                    <img\n                      src={bannerUrl ? bannerUrl : editImages.EditBanner}\n                      alt=\"editavatar\"\n                    />\n                    <label>\n                      <div className=\"banner-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => onBannerChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"banner\"\n                      />\n                    </label>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                <div className=\"row g-4\">\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Username</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"username\"\n                        placeholder=\"User Name\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        onChange={(e) => setUsername(e.target.value)}\n                        defaultValue={username}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"username\", username, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Email Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"email\"\n                        placeholder=\"Email Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        readOnly\n                        value={email}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"email\", email, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Wallet Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"address\"\n                        placeholder=\"Wallet Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        value={address}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"address\", address, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-8\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Bio</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      {bioError && (\n                        <p className=\"text-danger \">Minimum 3 words required</p>\n                      )}\n                      <textarea\n                        name=\"bio\"\n                        placeholder=\"Bio\"\n                        maxLength=\"300\"\n                        onChange={(e) => setDescription(e.target.value)}\n                        defaultValue={description}\n                      ></textarea>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Links</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Twitter}\n                          alt=\"twitterlink\"\n                        />\n                        <input\n                          name=\"twitterlink\"\n                          placeholder=\"Twitter Link\"\n                          autocomplete=\"off\"\n                          type=\"url\"\n                          onChange={(e) => setTwitterLink(e.target.value)}\n                          defaultValue={twitterLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Insta}\n                          alt=\"instalink\"\n                        />\n                        <input\n                          name=\"instagramlink\"\n                          placeholder=\"Instagram Link\"\n                          type=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => setInstaLink(e.target.value)}\n                          defaultValue={instaLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Website}\n                          alt=\"websitelink\"\n                        />\n                        <input\n                          name=\"websitelink\"\n                          placeholder=\"Website Link\"\n                          ype=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => setWebLink(e.target.value)}\n                          defaultValue={webLink}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                <div className=\"\">\n                  <button className=\"btn btn-linear-gradient\">\n                    Save changes\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </form>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n})(EditProfile);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["549","550","551"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { ENV } from './../../config/config';\nimport { getTopSellers, beforeUser } from './../user/user.action';\nimport AvatarImg from '../../assets/images/seller-avatar.png';\nimport SellerTickIcon from '../../assets/images/seller-tick-icon.svg';\nimport './topseller.css';\nimport NavbarMain from '../navbar-main/NavbarMain';\nimport Footer from '../footer/footer';\nimport Breadcrumb from '../breadcrumb/breadcrumb';\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  // const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    // setPage(page);\n    //setLimit(limit + 10);\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    //console.log('testing qurty string', qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={'Sellers'} title2={'TopSellers'} />\n      <section className='top-seller-area padding-wrapper'>\n        <div className='container'>\n          <div className='row'>\n            <div className='col-12'>\n              {/* Intro */}\n              <div className='intro d-flex justify-content-between align-items-end m-0'>\n                <div className='intro-content'>\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className='mb-0'>Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className='row items'>\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className='col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards'\n                  >\n                    {/* Single Seller */}\n                    <div className='card'>\n                      <div className='single-seller d-flex align-items-center'>\n                        <div className='seller-avatar-container'>\n                          <img\n                            className='avatar-md rounded-circle'\n                            src={AvatarImg}\n                            alt=''\n                          />\n                          <span className='seller-avatar-active'>\n                            <img src={SellerTickIcon} alt='tick-icon' />\n                          </span>\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className='seller-info ml-3 w-100'>\n                          <Link\n                            className='seller mb-2'\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className='text-end'>\n                            {' '}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className='col-12'>\n              <div className='mt-5 text-center'>\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className='btn btn-linear-gradient px-5'\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore-all.js",["552","553","554","555","556","557"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["558","559","560","561","562","563","564","565","566"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["567","568","569","570","571","572","573","574","575","576","577","578","579","580","581","582","583","584","585","586","587","588","589","590","591","592","593","594","595","596","597","598","599","600","601","602","603","604","605","606","607","608"],"import React, { useEffect, useState } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./nftdetail.css\";\nimport PriceHistoy from \"../../assets/images/pricehistoryicon.svg\";\nimport OfferIcon from \"../../assets/images/offer-icon.svg\";\nimport ListingIcon from \"../../assets/images/listing-icon.svg\";\nimport ActivityIcon from \"../../assets/images/activity.svg\";\nimport MoreCollectionIcon from \"../../assets/images/morecollectionicon.svg\";\nimport { ListingImg } from \"../../assets/assets\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport DescriptionIcon from \"../../assets/images/detail-description-icon.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.png\";\nimport {\n  getNFT,\n  getNFTsByCollection,\n  getMyLikedNfts,\n  beforeNFT,\n  createActivity,\n  getActivities,\n  getItemsListing,\n} from \"../nfts/nfts.action.js\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader.js\";\nimport { connect } from \"react-redux\";\nimport { Modal } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport moment from \"moment\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport axios from \"axios\";\nimport {\n  AiFillHeart,\n  BsTagFill,\n  GrTransaction,\n  BiTransferAlt,\n  MdShoppingCart,\n  FaHandPaper,\n} from \"react-icons/all\";\nimport {\n  placeABid,\n  connectMetamask,\n  BuyFixedPriceNFT,\n  getWalletAddress,\n  getBalance,\n  validateNetwork,\n} from \"../../utils/web3\";\nimport {\n  placeBid,\n  getBids,\n  getBidSByNftId,\n  beforeBid,\n  deleteBid,\n} from \"../bids/bids.action\";\nimport {\n  makeOffer,\n  getOffers,\n  beforeOffer,\n  deleteOffer,\n  buyNow,\n} from \"../offers/offers.action\";\nimport { toast } from \"react-toastify\";\nimport BuyModal from \"../modals/BuyModal\";\nimport { iconByActivity } from \"../../utils/exportData\";\nimport BidModal from \"../modals/BidModal\";\nimport ReactTimeAgo from \"react-time-ago\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport VideoCard from \"../test-video-card/videoCard\";\n\nconst NFTDetail = (props) => {\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [listedItem, setListedItem] = useState([]);\n  const [nftsList, setNftList] = useState([]);\n  const [activities, setActivities] = useState([]);\n  const [itemsListing, setItemsListing] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [isOpen, setIsOpen] = useState(false);\n  const [price, setPrice] = useState(0);\n  const [liked, setLiked] = useState(false);\n  const [bids, setBids] = useState(null);\n  const [offers, setOffers] = useState(null);\n  const [modalShow, setModalShow] = useState(false);\n  const [modalShow1, setModalShow1] = useState(false);\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [modal, setModal] = useState(1);\n  const [confirmed, setConfirmed] = useState(\"\");\n  const [transactionHash, setTransactionHash] = useState(\"\");\n  const [transactionSuccess, setTransactionSuccess] = useState(false);\n  const [bidModalShow, setBidModalShow] = useState(false);\n  const [balance, setBalance] = useState(\"\");\n  const [disabled, setDisabled] = useState(false);\n\n  const history = useHistory();\n\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  let nftId = props.match.params.id;\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const initData = {\n    itemImg: \"/img/auction_2.jpg\",\n    date: \"2022-03-30\",\n    price_2: \"$500.89\",\n    bidBtn: \"Place a Bid\",\n    offerBtn: \"Buy Now\",\n    sellBtn: \"Sell\",\n  };\n  const { currencies } = ENV;\n  const expiryOptions = [\n    { label: \"5 Days\", value: moment().add(5, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"7 Days\", value: moment().add(7, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"A Month\", value: moment().add(1, \"months\").format(\"DD/MM/YYYY\") },\n    { label: \"Custom Date\", value: -1 },\n  ];\n\n  const config1 = {\n    price: {\n      currency: ENV.currency,\n      amount: \"\",\n    },\n    expiry: {\n      date: expiryOptions[0].value,\n      time: moment(new Date()).format(\"HH:mm\"),\n      type: 1, // 1 for time & 2 for datetime-local\n      datetime: \"\", // for payload\n    },\n  };\n  const [nftConfig, setNftConfig] = useState(config1);\n  const validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n\n  const propertiesData = [\n    {\n      id: 1,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 2,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 3,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 4,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 5,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 6,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 7,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 8,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n  ];\n\n  useEffect(async () => {\n    props.getNFT(nftId);\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n\n    let balance = await getBalance();\n    setBalance(balance);\n  }, []);\n\n  useEffect(() => {\n    if (props.createAuth) {\n      setLoader(false);\n      history.push(\"/explore/allNFT\");\n    }\n  }, [props.createAuth]);\n\n  useEffect(() => {\n    if (props.buyAuth) {\n      setLoader(false);\n      setDisabled(false);\n      setTransactionSuccess(true);\n      props.getNFT(nftId);\n      let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n      qs = ENV.objectToQueryString(qs);\n      props.getMyLikedNfts(qs);\n      validateIfLiked();\n      props.getBids();\n    }\n  }, [props.buyAuth]);\n\n  useEffect(() => {\n    if (props.createAuthOffer) {\n      setLoader(false);\n      history.push(\"/explore/allNFT\");\n    }\n  }, [props.createAuthOffer]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // validateIfLiked(props.myLikedNfts);\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.getAuthOffer) {\n      setOffers(props.offers);\n    }\n  }, [props.getAuthOffer]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setBids(props.bids);\n      // props.beforeBid();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n\n      //get activities\n      let activityQs = { nftId: props.nftDetail._id };\n      activityQs = ENV.objectToQueryString(activityQs);\n      props.getActivities(activityQs);\n\n      //getItemsListing\n      let itemsListingQS = { collectionId: props.nftDetail.collectionId };\n      itemsListingQS = ENV.objectToQueryString(itemsListingQS);\n      props.getItemsListing(itemsListingQS);\n\n      //get offers\n      if (props.nftDetail.sellingMethod) {\n        if (props.nftDetail.sellingMethod === 1) {\n          let qs = { nftId: props.nftDetail._id };\n          qs = ENV.objectToQueryString(qs);\n          props.getOffers(qs);\n        } else {\n          let qs = { nftId: props.nftDetail._id };\n          qs = ENV.objectToQueryString(qs);\n          props.getBids(qs);\n        }\n      }\n      //get bids\n      if (nftDetail?.sellingMethod === 2) {\n        let nftBidsQs = { nftId };\n        nftBidsQs = ENV.objectToQueryString(nftBidsQs);\n        props.getBidSByNftId(nftBidsQs);\n      }\n\n      let fivePerc = \"\";\n      if (props.nftDetail.highestBid === 0) {\n        fivePerc = (5 / 100) * props.nftDetail.currentPrice;\n        fivePerc = fivePerc + props.nftDetail.currentPrice;\n      } else {\n        fivePerc = (5 / 100) * props.nftDetail.highestBid;\n        fivePerc = fivePerc + props.nftDetail.highestBid;\n      }\n      let result = fivePerc.toString().slice(0, 8);\n\n      setPrice(result);\n      validateIfLiked(likedNfts, props.nftDetail);\n\n      props.getNFTsByCollection(props.nftDetail.collectionId);\n    }\n  }, [props.nftsAuth]);\n\n  useEffect(() => {\n    if (props.nftsByCollectionStatus) {\n      let moreCollection = [];\n      if (props.nftsByCollection && props.nftsByCollection?.length) {\n        moreCollection = props.nftsByCollection.filter(\n          (item) => item._id !== nftDetail._id\n        );\n      }\n      setNftList(moreCollection);\n    }\n  }, [props.nftsByCollectionStatus]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  useEffect(() => {\n    if (props.activitiesAuth) {\n      setActivities(props.activities);\n    }\n  }, [props.activitiesAuth]);\n  useEffect(() => {\n    if (props.itemsListingAuth) {\n      setItemsListing(props.itemsListing);\n    }\n  }, [props.itemsListingAuth]);\n\n  const handleRouting = async () => {\n    if (await validateNetwork()) {\n      if (ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId) {\n        history.push({\n          pathname: `/sell-item/${nftDetail._id}`,\n          state: nftDetail,\n        });\n      } else if (nftDetail.sellingMethod === 2) {\n        setBidModalShow(true);\n      } else {\n        // setLoader(true)\n        // makeOffer()\n        setModalShow(true);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  //toggleLikes\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const handleLikesTogleApi = async (nftId, status) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        setToggle(!toggle);\n\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let data = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if ((status === \"dislike\") & (nftDetail.likesCount > 0)) {\n          let nft = nftDetail;\n          nft.likesCount = nft.likesCount - 1;\n          setLiked(false);\n          setNftDetail(nft);\n          props.toggleLikeDislike(data);\n        } else {\n          let nft = nftDetail;\n          nft.likesCount = nft.likesCount + 1;\n\n          setNftDetail(nft);\n          setLiked(true);\n          props.toggleLikeDislike(data);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      // setLoader(false);\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      // setLoader(false);\n      return setToggle(false);\n    }\n  };\n  const onChangeModal = (e) => {\n    const { name, value } = e.target;\n    let data = nftConfig;\n\n    const keys = name.split(\".\"); // nftConfig, price, currency\n    if (keys && keys[2]) data[keys[1]][keys[2]] = value;\n    else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (keys && keys[1] === \"price\" && keys[2] === \"amount\")\n      data[keys[1]][\"amount\"] = Number(value);\n\n    if (keys && keys[1] === \"expiry\" && keys[2] === \"date\")\n      data[keys[1]][\"type\"] = Number(value) === -1 ? 2 : 1;\n\n    // set datetime for days / months\n    if (data.expiry.type === 1)\n      data.expiry.datetime = moment(\n        data.expiry.date + \" \" + data.expiry.time,\n        \"DD/MM/YYYY HH:mm\"\n      );\n    // set datetime for custom date\n    else if (data.expiry.type === 2) {\n      data.expiry.datetime = moment(data.expiry.time, \"DD/MM/YYYY HH:mm\");\n      data.expiry.date = moment(data.expiry.time, \"DD/MM/YYYY\");\n    }\n\n    setNftConfig(data);\n  };\n\n  const calculatePricePercantage = () => {\n    let fivePerc = \"\";\n    let result = \"\";\n    if (nftDetail.highestBid === 0) {\n      fivePerc = (5 / 100) * nftDetail.currentPrice;\n\n      result = fivePerc + nftDetail.currentPrice;\n\n      return result;\n    } else {\n      fivePerc = (5 / 100) * nftDetail.highestBid;\n      result = fivePerc + nftDetail.highestBid;\n      return result.toString().slice(0, 8);\n    }\n  };\n\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const closeModal = () => {\n    setIsOpen(false);\n  };\n  const onChange = (e) => {\n    let result = e.target.value.slice(0, 8);\n\n    setPrice(result);\n  };\n  const handleModalSubmit = async () => {\n    if (await validateNetwork()) {\n      setLoader(true);\n      setIsOpen(false);\n      if (nftDetail.sellingMethod === 2) {\n        placeBid();\n        const { _id, ownerId, ownerAddress, currentPrice } = nftDetail;\n      } else {\n        makeOffer();\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n  const placeBid = async () => {\n    if (await validateNetwork()) {\n    try {\n      let result = await placeABid(price, nftDetail.nftToken);\n      if (result) {\n        const payload = {\n          ownerId: nftDetail.ownerId,\n          bidAmount: price,\n          nftId: nftDetail._id,\n          bidBy: ENV.getUserKeys(\"_id\")._id,\n          isAccepted: false,\n          // expiryDate: nftConfig.expiry.datetime,\n          toAddress: nftDetail.ownerAddress,\n          fromAddress: await connectMetamask(),\n        };\n        const { _id, ownerId, ownerAddress, currentPrice } = nftDetail;\n\n        props.placeBid(payload);\n        createActivity(\"Bid\", price);\n      }\n    } catch (err) {\n      console.log(err, \"error\");\n      setLoader(false);\n      setIsOpen(false);\n      toast.error(err);\n    }\n  }else {\n    toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\")\n  }\n  };\n\n  const makeOffer = async () => {\n    setLoader(true);\n    try {\n      // let result = await placeABid(price, nftDetail.nftToken);\n      let result = true;\n      if (result) {\n        const payload = {\n          toAddress: nftDetail.ownerAddress,\n          fromAddress: await connectMetamask(),\n          offerBy: ENV.getUserKeys(\"_id\")._id,\n          ownerId: nftDetail.ownerId,\n          nftId: nftDetail._id,\n          price: price,\n          // expiryDate: nftConfig.expiry.datetime,\n          isAccepted: false,\n          isExpired: false,\n        };\n\n        props.makeOffer(payload);\n      }\n    } catch (err) {\n      setLoader(false);\n      setIsOpen(false);\n      toast.error(err);\n    }\n  };\n  const getPercentageChange = (oldNumber, newNumber) => {\n    var decreaseValue = oldNumber - newNumber;\n\n    return (decreaseValue / oldNumber) * 100;\n  };\n\n  const deleteBid = (id) => {\n    let result = bids.filter((bid) => bid._id !== id);\n    setBids(result);\n    props.deleteBid(id);\n    createActivity(\"Cancel Bid\");\n  };\n\n  const deleteOffer = (id) => {\n    let result = offers.filter((offer) => offer._id !== id);\n    setOffers(result);\n    props.deleteOffer(id);\n  };\n  const auctionEndTimeConversion = (auctionEndDate) => {\n    var dateString = moment.utc(auctionEndDate).format(\"MMMM D, Y\");\n    var timeString = moment.utc(auctionEndDate).format(\"h:mma\");\n    var totalDateTime = dateString + \" at \" + timeString + \" PKT\";\n    return totalDateTime;\n  };\n\n  const BuyNow = async () => {\n    if (await validateNetwork()) {\n      setDisabled(true);\n      try {\n        let currentPrice = \"\";\n        let nftToken = \"\";\n\n        if (modalShow1) {\n          currentPrice = listedItem.currentPrice;\n          nftToken = listedItem.tokenId;\n          nftId = listedItem._id;\n        } else {\n          currentPrice = nftDetail.currentPrice;\n          nftToken = nftDetail.nftToken;\n        }\n\n        const result = await BuyFixedPriceNFT(\n          currentPrice,\n          nftToken,\n          setConfirmed,\n          setTransactionHash\n        );\n        if (result) {\n          let ownerAddress = await getWalletAddress();\n          let payload = {\n            userId,\n            nftId,\n            ownerAddress,\n          };\n          props.beforeOffer();\n          props.buyNow(payload);\n          createActivity(\"Transfer\", false, ownerAddress);\n        }\n      } catch (err) {\n        setDisabled(false);\n        toast.error(err);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const createActivity = async (type, bidPrice, address) => {\n    const { _id, ownerId, ownerAddress, currentPrice } = nftDetail;\n    let price = \"\";\n    let toAddress = \"\";\n    if (bidPrice) {\n      price = bidPrice;\n    } else {\n      price = currentPrice;\n    }\n\n    if (type === \"Transfer\" || type === \"Bid\") {\n      toAddress = address;\n    }\n\n    let activityPayload = {\n      nftId: _id,\n      ownerId,\n      fromAddress:\n        type === \"Transfer\" ? ownerAddress : await getWalletAddress(),\n      activityType: type,\n      toAddress,\n      price: price,\n    };\n    props.createActivity(activityPayload);\n  };\n  const handleAcitivityIcon = (type) => {\n    if (type === \"Mint\") {\n      return <MdShoppingCart />;\n    } else if (type === \"List\") {\n      return <BsTagFill />;\n    } else if (type === \"Bid\") {\n      return <FaHandPaper />;\n    } else {\n      return <BiTransferAlt />;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate && endDate) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return true;\n    }\n  };\n\n  // console.log(itemsListing, \"itemsListing\");\n  // console.log(ENV.getUserKeys(\"_id\")._id, \"id\");\n  // console.log(nftDetail, \"nftDetail\");\n\n  // console.log(offers, \"offers\");\n  // console.log(props,\"props\")\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n      <>\n        <NavbarMain />\n        <section className=\"padding-wrapper nft-detail\">\n          <div className=\"container\">\n            <div className=\"row g-3\">\n              <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n                <div className=\"row\">\n                  <div className=\"col-12 order-2 order-md-1\">\n                    <div className=\"nftDetail-accordion\">\n                      <div\n                        className=\"accordion accordion-flush \"\n                        id=\"accordionFlushExample\"\n                      >\n                        {/* <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                              >\n                                <img\n                                  src={PriceHistoy}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price history\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseOne\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingOne\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div> */}\n\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingTwo\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseTwo\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseTwo\"\n                            >\n                              <img\n                                src={OfferIcon}\n                                alt=\"price-history\"\n                                className=\"me-2\"\n                              />\n                              Offers\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseTwo\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingTwo\"\n                          >\n                            <div className=\"accordion-body\">\n                              <div className=\"table-container listing-table\">\n                                <table class=\"table table-borderless\">\n                                  {bids && bids.length > 0 && (\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Floor Difference</th>\n                                        {/* <th scope=\"col\">Expiration</th> */}\n                                        <th scope=\"col\">From</th>\n                                        <th scope=\"col\">{\"\"}</th>\n                                      </tr>\n                                    </thead>\n                                  )}\n                                  <tbody>\n                                    {nftDetail?.sellingMethod === 2 ? (\n                                      <>\n                                        {bids && bids.length > 0 ? (\n                                          bids.map((bid) => {\n                                            return (\n                                              <tr>\n                                                <th scope=\"row\">\n                                                  {bid.bidAmount}\n                                                </th>\n                                                <td>\n                                                  $\n                                                  {(\n                                                    bid.bidAmount * exchangeRate\n                                                  ).toFixed(2)}\n                                                </td>\n                                                <td>\n                                                  {getPercentageChange(\n                                                    bid.bidAmount,\n                                                    nftDetail.lowestNftPrice\n                                                  ).toFixed(0)}\n                                                  %{\" \"}\n                                                  {bid.bidAmount >\n                                                  nftDetail.lowestNftPrice\n                                                    ? \"above\"\n                                                    : \"below\"}\n                                                </td>\n                                                {/* <td>an hour ago</td> */}\n                                                <td>\n                                                  {bid.fromAddress.slice(3, 8)}\n                                                </td>\n                                                {ENV.getUserKeys(\"_id\")._id ===\n                                                  bid.bidBy && (\n                                                  <td>\n                                                    <button\n                                                      className=\"cancel-Bid-btn\"\n                                                      onClick={() =>\n                                                        deleteBid(bid._id)\n                                                      }\n                                                    >\n                                                      Cancel\n                                                    </button>\n                                                  </td>\n                                                )}\n                                              </tr>\n                                            );\n                                          })\n                                        ) : (\n                                          <p className=\"text-center d-flex justify-content-center align-items-center\">\n                                            No Offers Found\n                                          </p>\n                                        )}\n                                      </>\n                                    ) : (\n                                      <>\n                                        {offers && offers.length > 0 ? (\n                                          offers.map((offer) => {\n                                            return (\n                                              <tr>\n                                                <th scope=\"row\">\n                                                  {offer.price}\n                                                </th>\n                                                <td>\n                                                  $\n                                                  {(\n                                                    offer.price * exchangeRate\n                                                  ).toFixed(2)}\n                                                </td>\n                                                <td>\n                                                  {getPercentageChange(\n                                                    offer.price,\n                                                    nftDetail.lowestNftPrice\n                                                  ).toFixed(0)}\n                                                  %{\" \"}\n                                                  {offer.price >\n                                                  nftDetail.lowestNftPrice\n                                                    ? \"above\"\n                                                    : \"below\"}\n                                                </td>\n                                                {/* <td>an hour ago</td> */}\n                                                <td>\n                                                  {offer.fromAddress.slice(-6)}\n                                                </td>\n                                                {ENV.getUserKeys(\"_id\")._id ===\n                                                  offer.offerBy && (\n                                                  <td>\n                                                    <button\n                                                      className=\"cancel-Bid-btn\"\n                                                      onClick={() =>\n                                                        deleteBid(offer._id)\n                                                      }\n                                                    >\n                                                      Accept\n                                                    </button>\n                                                  </td>\n                                                )}\n                                              </tr>\n                                            );\n                                          })\n                                        ) : (\n                                          <p className=\"text-center d-flex justify-content-center align-items-center\">\n                                            No Offers Found\n                                          </p>\n                                        )}\n                                      </>\n                                    )}\n                                  </tbody>\n                                </table>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                        {nftDetail?.sellingMethod === 1 && (\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={ListingIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Item listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"table-container listing-table\">\n                                  <table class=\"table table-borderless\">\n                                    {itemsListing &&\n                                    itemsListing.length > 0 &&\n                                    itemsListing.filter(\n                                      (item) =>\n                                        item.ownerId !== userId &&\n                                        item._id !== nftDetail._id\n                                    ).length > 0 ? (\n                                      <>\n                                        <thead>\n                                          <tr>\n                                            <th scope=\"col\">Price</th>\n                                            <th scope=\"col\">USD Price</th>\n\n                                            <th scope=\"col\">From</th>\n                                            <th scope=\"col\">{\"\"}</th>\n                                          </tr>\n                                        </thead>\n                                        <tbody>\n                                          {itemsListing &&\n                                            itemsListing.length > 0 &&\n                                            itemsListing\n                                              .filter(\n                                                (item) =>\n                                                  item.ownerId !== userId &&\n                                                  item._id !== nftDetail._id\n                                              )\n                                              .map((item) => {\n                                                return (\n                                                  <tr>\n                                                    <th scope=\"row\">\n                                                      {item.currentPrice}\n                                                    </th>\n                                                    <td>\n                                                      {\" \"}\n                                                      $\n                                                      {(\n                                                        item.currentPrice *\n                                                        exchangeRate\n                                                      ).toFixed(2)}\n                                                    </td>\n\n                                                    <td>\n                                                      {\" \"}\n                                                      {item.ownerAddress.slice(\n                                                        -6\n                                                      )}\n                                                    </td>\n                                                    <td>\n                                                      <button\n                                                        onClick={() => {\n                                                          setModalShow1(true);\n                                                          setListedItem(item);\n                                                        }}\n                                                        disabled={\n                                                          disabled &&\n                                                          listedItem._id !==\n                                                            item._id\n                                                        }\n                                                      >\n                                                        Buy\n                                                      </button>\n                                                    </td>\n                                                  </tr>\n                                                );\n                                              })}\n                                        </tbody>\n                                      </>\n                                    ) : (\n                                      <p className=\"text-white text-center\">\n                                        {\"No Items Found\"}\n                                      </p>\n                                    )}\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        )}\n                        {/* /// */}\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-11 col-md-12 col-lg-7 col-xl-5 order-1 order-md-2 mx-auto mb-5 mb-md-0  mx-md-0\">\n                    <div className=\"collection-filter-accordion nft-stats-accordion\">\n                      <div\n                        className=\"accordion accordion-flush \"\n                        id=\"accordionFlushExample\"\n                      >\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingFour\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseFour\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseFour\"\n                            >\n                              Properties\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseFour\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingFour\"\n                          >\n                            <div className=\"accordion-body\">\n                              <div className=\"row g-2 justify-content-center align-items-center\">\n                                {propertiesData &&\n                                  propertiesData.map((data) => {\n                                    return (\n                                      <div className=\"col-6 col-sm-4 col-md-6\">\n                                        <div className=\"properties-content-container d-flex flex-column justify-content-center align-items-center text-center\">\n                                          <div className=\"properties-content\">\n                                            <span>{data.subTitle}</span>\n                                            <h3>{data.title}</h3>\n                                            <p>{data.content}</p>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    );\n                                  })}\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingSix\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseSix\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseSix\"\n                            >\n                              Stats\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseSix\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingSix\"\n                          >\n                            <div className=\"accordion-body\"></div>\n                          </div>\n                        </div>\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingSeven\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseSeven\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseSeven\"\n                            >\n                              Levels\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseSeven\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingSeven\"\n                          >\n                            <div className=\"accordion-body\"></div>\n                          </div>\n                        </div>\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingEight\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseEight\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseEight\"\n                            >\n                              Boosts\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseEight\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingEight\"\n                          >\n                            <div className=\"accordion-body\"></div>\n                          </div>\n                        </div>\n\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingNine\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseNine\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseNine\"\n                            >\n                              Details\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseNine\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingNine\"\n                          >\n                            <div className=\"accordion-body\">\n                              <div className=\"contact-address d-flex justify-content-between\">\n                                <p>Contract Address</p>\n                                <span>\n                                  {ENV.mintsClubContractAddress.slice(0, 6) +\n                                    \"....\" +\n                                    ENV.mintsClubContractAddress.slice(-6)}\n                                </span>\n                              </div>\n                              <div className=\"d-flex justify-content-between\">\n                                <p>Token ID</p>\n                                <p>{nftDetail.nftToken}</p>\n                              </div>\n                              <div className=\"d-flex justify-content-between\">\n                                <p>Token Standard </p>\n                                <p>ERC-1155</p>\n                              </div>\n                              <div className=\"d-flex justify-content-between\">\n                                <p>Blockchain </p>\n                                <p>Ethereum</p>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n                <Card className=\"auction-card detail-card\">\n                  <div className=\"auction-img-wrapper\">\n                    {nftDetail.fileType === \"image\" ? (\n                      <Card.Img\n                        variant=\"top\"\n                        src={nftDetail.image}\n                        alt=\"AuctionTopImg\"\n                      />\n                    ) : (\n                      <div className=\"card-img-top\">\n                        <div className=\"video-wrapper\">\n                          <video\n                            src={nftDetail.image}\n                            ref={videoElement}\n                            onTimeUpdate={handleOnTimeUpdate}\n                          />\n                          <div className=\"controls\">\n                            <div className=\"actions\">\n                              <button\n                                className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                                onClick={togglePlay}\n                              >\n                                {playerState.isPlaying ? (\n                                  <BsFillPauseFill />\n                                ) : (\n                                  <BsFillPlayFill />\n                                )}\n                              </button>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    )}\n\n                    {/* //InCaseOfVideoCard */}\n                  </div>\n                  <Card.Body>\n                    <div className=\"detail-card-name-container d-flex align-items-center justify-content-between\">\n                      <div className=\"detail-nft-name \">\n                        <h5>{nftDetail.name}</h5>\n                      </div>\n                      <div className=\"likes-container d-flex align-items-center\">\n                        {toggle ? (\n                          <>\n                            <AiFillHeart\n                              className=\"heart-fill-icon \"\n                              onClick={() => {\n                                handleLikesTogleApi(nftDetail._id, \"dislike\");\n                              }}\n                            />\n                            <p className=\"text-white\">\n                              {nftDetail.likesCount ? nftDetail.likesCount : 0}{\" \"}\n                            </p>\n                          </>\n                        ) : (\n                          <>\n                            <img\n                              src={HeartIcon}\n                              alt=\"heart-icon\"\n                              className=\"ms-1\"\n                              onClick={() => {\n                                handleLikesTogleApi(nftDetail._id, \"like\");\n                              }}\n                            />\n\n                            <span className=\"ms-1\">\n                              {nftDetail.likesCount ? nftDetail.likesCount : 0}\n                            </span>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                    <div>\n                      {nftDetail.currentPrice !== null && (\n                        <>\n                          <h3>\n                            {nftDetail.currentPrice}\n                            <span>\n                              (${\" \"}\n                              {(nftDetail.currentPrice * exchangeRate).toFixed(\n                                2\n                              )}\n                              )\n                            </span>\n                          </h3>\n                        </>\n                      )}\n                    </div>\n                    <div className=\"detail-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n                      <div className=\"detail-nft-owner\">\n                        {nftDetail && (\n                          <p>\n                            Owned by{\" \"}\n                            <span>\n                              {nftDetail.ownerId === userId\n                                ? \"You\"\n                                : nftDetail.user.username}\n                            </span>\n                          </p>\n                        )}\n                      </div>\n                      <div className=\"detail-nft-copies\">\n                        <p>\n                          {nftDetail?.remainingCopies\n                            ? nftDetail?.remainingCopies\n                            : nftDetail.copies}{\" \"}\n                          {nftDetail.copies === 1 ? \"Copy\" : \"Copies\"}\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                      <div className=\"d-flex align-items-center\">\n                        {nftDetail.sellingMethod === 2 && (\n                          <>\n                            {nftDetail.auctionEndDate &&\n                              checkIfAuctionStartedorEnded(\n                                nftDetail?.auctionStartDate,\n                                nftDetail?.auctionEndDate\n                              ) && (\n                                <>\n                                  <img\n                                    src={ClockIcon}\n                                    alt=\"clock-icon\"\n                                    className=\"me-1\"\n                                  />\n                                  <span>\n                                    Sale ends{\" \"}\n                                    {auctionEndTimeConversion(\n                                      nftDetail.auctionEndDate\n                                    )}{\" \"}\n                                  </span>\n                                </>\n                              )}\n                          </>\n                        )}\n                      </div>\n                    </div>\n                    {(nftDetail?.sellingMethod ||\n                      ENV.getUserKeys(\"_id\")._id == nftDetail.ownerId) &&\n                      checkIfAuctionStartedorEnded(\n                        nftDetail?.auctionStartDate,\n                        nftDetail?.auctionEndDate\n                      ) && (\n                        <>\n                          <button\n                            className=\"btn btn-linear-gradient d-flex align-items-center justify-content-center w-75 mx-auto\"\n                            disabled={disabled}\n                            onClick={() => handleRouting()}\n                          >\n                            {(ENV.getUserKeys(\"_id\")._id == nftDetail.ownerId &&nftDetail.sellingMethod)?\"Resale\":\n                            ENV.getUserKeys(\"_id\")._id == nftDetail.ownerId\n                              ? \"Sell\"\n                              : nftDetail?.sellingMethod === 2\n                              ? \"Place Bid\"\n                              : nftDetail?.sellingMethod === 1\n                              ? \"Buy Now\"\n                              : \"\"}\n                          </button>\n                        </>\n                      )}\n                  </Card.Body>\n                </Card>\n                <div className=\"detail-description-content mt-5\">\n                  <div className=\"d-flex align-items-center mb-3\">\n                    <img\n                      src={DescriptionIcon}\n                      alt=\"descriptionIcon\"\n                      className=\"me-1\"\n                    />\n                    <h6>Discription</h6>\n                  </div>\n                  <p>{nftDetail.description}</p>\n                </div>\n              </div>\n              <div className=\"col-12 mt-0 mt-md-4 order-3\">\n                <div className=\"nftDetail-accordion\">\n                  <div\n                    className=\"accordion accordion-flush \"\n                    id=\"accordionFlushExample\"\n                  >\n                    <div className=\"accordion-item\">\n                      <h2 className=\"accordion-header\" id=\"flush-headingTen\">\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target=\"#flush-collapseTen\"\n                          aria-expanded=\"false\"\n                          aria-controls=\"flush-collapseTen\"\n                        >\n                          <img\n                            src={ActivityIcon}\n                            alt=\"price-history\"\n                            className=\"me-2\"\n                          />\n                          Activity\n                        </button>\n                      </h2>\n                      <div\n                        id=\"flush-collapseTen\"\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby=\"flush-headingTen\"\n                      >\n                        <div className=\"accordion-body\">\n                          <div className=\"table-container\">\n                            {activities && activities.length > 0 && (\n                              <table class=\"table table-borderless\">\n                                <thead>\n                                  <tr>\n                                    <th scope=\"col\">Event</th>\n                                    <th scope=\"col\">Price</th>\n                                    <th scope=\"col\">From</th>\n                                    <th scope=\"col\">To</th>\n                                    <th scope=\"col\">Date</th>\n                                  </tr>\n                                </thead>\n                                <tbody>\n                                  {activities.map((activity) => {\n                                    return (\n                                      <tr>\n                                        <th scope=\"row\">\n                                          <div className=\"d-flex align-items-center\">\n                                            {handleAcitivityIcon(\n                                              activity.activityType\n                                            )}\n                                            <p className=\"ps-1\">\n                                              {\" \"}\n                                              {activity.activityType}{\" \"}\n                                            </p>\n                                          </div>\n                                        </th>\n                                        <td>\n                                          {activity.price ? activity.price : \"\"}\n                                        </td>\n                                        <td>\n                                          {activity.fromAddress\n                                            ? activity.fromAddress.slice(-8)\n                                            : \"null address\"}\n                                        </td>\n                                        <td>\n                                          {activity.toAddress\n                                            ? activity.toAddress.slice(-8)\n                                            : \"\"}{\" \"}\n                                        </td>\n                                        <td>\n                                          <div>\n                                            <ReactTimeAgo\n                                              date={activity.createdAt}\n                                              locale=\"en-US\"\n                                            />\n                                          </div>\n                                        </td>\n                                      </tr>\n                                    );\n                                  })}\n                                </tbody>\n                              </table>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"accordion-item\">\n                      <h2 className=\"accordion-header\" id=\"flush-headingEleven\">\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target=\"#flush-collapseEleven\"\n                          aria-expanded=\"false\"\n                          aria-controls=\"flush-collapseEleven\"\n                        >\n                          <img\n                            src={MoreCollectionIcon}\n                            alt=\"price-history\"\n                            className=\"me-2\"\n                          />\n                          More from this collection\n                        </button>\n                      </h2>\n                      <div\n                        id=\"flush-collapseEleven\"\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby=\"flush-headingEleven\"\n                      >\n                        <div className=\"accordion-body\">\n                          <div className=\"row justify-content-center align-items-center g-3\">\n                            {nftsList && nftsList.length > 0 ? (\n                              nftsList.map((listing, id) => {\n                                if (id <= 3) {\n                                  return (\n                                    <div className=\"col-10 col-sm-6 col-md-4 col-lg-3 px-1\">\n                                      {listing.fileType === \"image\" ? (\n                                        <ListingCards\n                                          CardImg={listing.image}\n                                          name={listing.name}\n                                          price={listing.currentPrice}\n                                          handleLikesTogleApi={\n                                            handleLikesTogleApi\n                                          }\n                                          id={listing._id}\n                                          likesCount={listing.likeCount}\n                                          likedNfts={likedNfts}\n                                          ownerId={listing.ownerId}\n                                          fileType={listing.fileType}\n                                          sellingMethod={listing.sellingMethod}\n                                          auctionStartDate={\n                                            listing?.auctionStartDate\n                                          }\n                                          auctionEndDate={\n                                            listing?.auctionEndDate\n                                          }\n                                        />\n                                      ) : (\n                                        <VideoCard\n                                          CardImg={listing.image}\n                                          name={listing.name}\n                                          price={listing.currentPrice}\n                                          handleLikesTogleApi={\n                                            handleLikesTogleApi\n                                          }\n                                          id={listing._id}\n                                          likesCount={listing.likeCount}\n                                          likedNfts={likedNfts}\n                                          ownerId={listing.ownerId}\n                                          fileType={listing.fileType}\n                                          sellingMethod={listing.sellingMethod}\n                                          auctionStartDate={\n                                            listing?.auctionStartDate\n                                          }\n                                          auctionEndDate={\n                                            listing?.auctionEndDate\n                                          }\n                                        />\n                                      )}\n                                    </div>\n                                  );\n                                }\n                              })\n                            ) : (\n                              <p className=\"text-center mt-4\">No NFTs Found</p>\n                            )}\n                          </div>\n                          <div className=\"mt-4 detail-btn-collection text-center\">\n                            {nftsList.length > 0 && nftsList.length > 4 && (\n                              <button\n                                className=\"btn btn-rounded-bordered\"\n                                onClick={() =>\n                                  history.push(\n                                    `/collection/detailPage/${nftDetail.collectionId}`\n                                  )\n                                }\n                              >\n                                View collection\n                              </button>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <BuyModal\n            show={modalShow}\n            onHide={() => {\n              setModalShow(false);\n              setConfirmed(false);\n              setModal(1);\n              setTransactionSuccess(false);\n            }}\n            name={nftDetail.name}\n            price={nftDetail.currentPrice}\n            image={nftDetail.image}\n            exchangeRate={exchangeRate}\n            tokenId={nftDetail.nftToken}\n            modal={modal}\n            setModal={setModal}\n            buyNow={BuyNow}\n            confirmed={confirmed}\n            transactionHash={transactionHash}\n            transactionSuccess={transactionSuccess}\n            disabled={disabled}\n          />\n          <BuyModal\n            show={modalShow1}\n            onHide={() => {\n              setModalShow1(false);\n              setConfirmed(false);\n              setModal(1);\n              setTransactionSuccess(false);\n            }}\n            name={listedItem.name}\n            price={listedItem.currentPrice}\n            image={listedItem.image}\n            exchangeRate={exchangeRate}\n            tokenId={listedItem.nftToken}\n            modal={modal}\n            setModal={setModal}\n            buyNow={BuyNow}\n            confirmed={confirmed}\n            transactionHash={transactionHash}\n            transactionSuccess={transactionSuccess}\n            disabled={disabled}\n          />\n\n          <BidModal\n            show={bidModalShow}\n            calculatePricePercantage={calculatePricePercantage}\n            handleModalSubmit={handleModalSubmit}\n            onChange={onChange}\n            decimalNumberValidator={decimalNumberValidator}\n            balance={balance}\n            price={price}\n            onHide={() => setBidModalShow(false)}\n          />\n        </section>\n\n        <Footer />\n      </>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nftDetail: state.nft.nftsData,\n  nftsAuth: state.nft.nftsAuth,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  activities: state.nft.itemActivities,\n  activitiesAuth: state.nft.activitiesAuth,\n  itemsListing: state.nft.itemsListing,\n  itemsListingAuth: state.nft.itemsListingAuth,\n  createAuth: state.bid.createAuth,\n  createAuthOffer: state.offer.createAuth,\n  getAuth: state.bid.getAuth,\n  getAuthOffer: state.offer.getAuth,\n  offers: state.offer.offers,\n  buyAuth: state.offer.buyAuth,\n  bids: state.bid.bids,\n  bidsByNft: state.bid.bidsByNft,\n  bidsByNftAuth: state.bid.bidsBYNftAuth,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFT,\n  beforeNFT,\n  getNFTsByCollection,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  placeBid,\n  getBids,\n  getBidSByNftId,\n  beforeBid,\n  deleteBid,\n  beforeTogleLikeDislike,\n  makeOffer,\n  beforeOffer,\n  getOffers,\n  deleteOffer,\n  buyNow,\n  createActivity,\n  getActivities,\n  getItemsListing,\n})(NFTDetail);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/home/home.reducer.js",["609","610"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["611","612","613","614","615","616","617","618","619","620","621","622","623","624","625","626","627","628","629"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport \"./UserProfile.css\";\nimport { ENV } from \"../../config/config\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\nimport { getProfileNfts, beforeNFT, getMyLikedNfts } from \"../nfts/nfts.action\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport { getUserById, beforeUser } from \"../user/user.action\";\nimport { Images } from \"../../assets/assets\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Link } from \"react-router-dom\";\nimport VideoCard from \"../test-video-card/videoCard\";\nimport {\n  validateNetwork,\n} from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\n\nconst UserProfile = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [nftsCopy, setNFTsCopy] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [user, setUser] = useState(\"\");\n  const [likedNfts, setLikedNfts] = useState();\n  const [keyword, setKeyword] = useState(\"\");\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial,setInitial]=useState(true)\n  const [disabled,setDisabled]=useState(false)\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n  });\n  const [menuFilter, setMenuFilter] = useState(\"\");\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const priceoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  useEffect(() => {\n    let qs = { ownerId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getProfileNfts(qs);\n    let likedNftsQs = { userId: ENV.getUserKeys(\"_id\")._id };\n    likedNftsQs = ENV.objectToQueryString(likedNftsQs);\n    props.getMyLikedNfts(likedNftsQs);\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n\n  useEffect(() => {\n    if (props.profileNFTsStatus) {\n      if (!menuFilter) {\n        const Nfts = props.profileNFTs.nfts.filter(\n          (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n        );\n        if(Nfts.length>0){\n          setDisabled(false)\n        }\n        else {\n          if(initial){\n\n            setDisabled(true) \n          }\n\n        }\n        setNFTs(Nfts);\n        setNFTsCopy(props.profileNFTs.nfts);\n        setLoader(false);\n        setFilterationLoader(false);\n      } else {\n        setNFTsCopy(props.profileNFTs.nfts);\n        handleNftFilter(menuFilter);\n        setLoader(false);\n        setFilterationLoader(false);\n      }\n    }\n  }, [props.profileNFTsStatus]);\n\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    const { individualUserAuth, individualUser } = props;\n    if (individualUserAuth) {\n      setUser(individualUser);\n    }\n  }, [props.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const ChangeTooltip = () =>\n    setTimeout(() => {\n      setAddressCopied(false);\n    }, 1000);\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter,\n    keyword,\n    buy,\n    auction,\n    latest\n  ) => {\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    if (keyword) nftQS.keyword = keyword;\n    if (buy) nftQS.buy = buy;\n    if (auction) nftQS.auction = auction;\n    if (latest) nftQS.latest = latest;\n\n    nftQS.ownerId = ENV.getUserKeys(\"_id\")._id;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string\");\n    props.getProfileNfts(qs);\n  };\n  const handleSortOptions = (e) => {\n    setInitial(false)\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setInitial(false)\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    getNFTs(\n      filter.page,\n      filter.filter.limit + 10,\n      filter.collectionId,\n      filter.gtePrice,\n      filter.ltePrice,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false)\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setInitial(false)\n    setFilterationLoader(true);\n\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      id,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleSearchKeyword = () => {\n    setInitial(false)\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false)\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      id == \"Buy Now\" ? true : false,\n      id == \"On Auction\" ? true : false,\n      id == \"New\" ? true : false\n    );\n  };\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n    if (!likeButtonDisable) {\n      setLikeBtnDisable(true);\n      let userId = ENV.getUserKeys(\"_id\")._id;\n\n      let data = {\n        userId,\n        nftId,\n        count: 1,\n      };\n      if ((status === \"dislike\") & (likesCount > 0)) {\n        let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n        setLikedNfts(result);\n        increOrDecreLikes(nftId, \"dec\");\n        props.toggleLikeDislike(data);\n      }\n      if (status === \"like\") {\n        let myLikedNfts = [];\n        if (likedNfts && likedNfts.length > 0) {\n          myLikedNfts = likedNfts;\n        }\n\n        let obj = {\n          _id: \"1234455\",\n          nftId,\n        };\n\n        myLikedNfts.push(obj);\n\n        setLikedNfts(myLikedNfts);\n        increOrDecreLikes(nftId, \"inc\");\n        props.toggleLikeDislike(data);\n      }\n      // setNFTs(nfts);\n    }\n  }else {\n    toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n  }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  const handleNftFilter = (id) => {\n    if (id === \"Collected\") {\n      const Nfts = nftsCopy.filter(\n        (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else if (id === \"Created\") {\n      const Nfts = nftsCopy.filter(\n        (item) =>\n          item.ownerId === ENV.getUserKeys(\"_id\")._id &&\n          item.creatorId === ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else {\n      handleFavFilter();\n    }\n  };\n\n  const handleFavFilter = () => {\n    let favNfts = [];\n    nftsCopy.map((item) => {\n      let foundNft = likedNfts.find((liked) => liked.nftId === item._id);\n      if (foundNft) {\n        favNfts.push(item);\n      }\n    });\n\n    setNFTs(favNfts);\n  };\n\n  const menuData = [\"Collected\", \"Created\", \"Favourited\"];\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"User\"} title2={\"UserProfile\"} />\n      <div className=\"collection-detail-hero\">\n        <img\n          className=\"w-100\"\n          src={user?.bannerImage ? user?.bannerImage : BannerImg}\n          alt=\"BannerImg\"\n        />\n      </div>\n      <div className=\"collection-detail-content\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12\">\n              <div className=\"collection-owner-avatar user-avatar-container text-center\">\n                <img\n                  src={\n                    user?.profileImage\n                      ? user.profileImage\n                      : Images.placeholderImg\n                  }\n                  alt=\"owner-avatar\"\n                />\n                <div className=\"edit-btn-container\">\n                  <Link to=\"/editprofile\" className=\"btn-edit-profile\">\n                    <i class=\"fas fa-edit\"></i>\n                    <p className=\"ms-1\">Edit</p>\n                  </Link>\n                </div>\n              </div>\n              <div className=\"collection-owner-detail text-center mt-3\">\n                {user && (\n                  <div className=\"collection-owner-name\">\n                    <h3>{user.username ? user.username : \"unnamed\"}</h3>\n                  </div>\n                )}\n                <div\n                  className=\"user-address mt-4 d-flex align-items-center \"\n                  onClick={() => {\n                    navigator.clipboard.writeText(user.address);\n                    setAddressCopied(true);\n                    ChangeTooltip();\n                  }}\n                >\n                  <span>{isAddressCopied ? \"Copied\" : \"Copy\"}</span>\n                  {user && (\n                    <>\n                      <i className=\"fab fa-ethereum\"></i>\n                      <p className=\"acc-adress\">\n                        {user.address.slice(0, 10) +\n                          \"...\" +\n                          user.address.slice(-10)}\n                      </p>\n                    </>\n                  )}\n                </div>\n                {user && (\n                  <p>\n                    Joined <span>February 2022</span>\n                  </p>\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"collections-listing padding-wrapper\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12\">\n                <div className=\"explore-collection-section\">\n                  <div className=\"explore-collection-nav\">\n                    <div className=\"d-flex justify-content-center justify-content-md-end align-items-center\">\n                      {menuData.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleNftFilter(item);\n                              setMenuFilter(item);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                            // disabled={disabled}\n                          >\n                            {item}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img\n                    src={SearchIcon}\n                    alt=\"search-icon\"\n                    className=\"ms-3\"\n                    onClick={handleSearchKeyword}\n                  />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                    onChange={(e) => setKeyword(e.target.value)}\n                    onKeyPress={(e) =>\n                      e.key === \"Enter\" && handleSearchKeyword()\n                    }\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label} >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {priceoptions &&\n                      priceoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label} disabled={disabled}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                      collectionsLabel={\"Collections\"}\n                      onChangeMinPrice={onChangeMinPrice}\n                      onChangeMaxPrice={onChangeMaxPrice}\n                      minValue={minValue}\n                      maxValue={maxValue}\n                      applyMinMaxFilter={applyMinMaxFilter}\n                      handleCollectionsFilter={handleCollectionsFilter}\n                      handleStatusFilter={handleStatusFilter}\n                      disabled={disabled}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Chains={filterData.chains}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                  handleStatusFilter={handleStatusFilter}\n                  disabled={disabled}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                <div className=\"row g-3\">\n                  {filterationLoader ? (\n                    <div className=\"text-center\">\n                      <div\n                        class=\"spinner-border text-secondary text-white \"\n                        role=\"status\"\n                      >\n                        <span class=\"sr-only\">Loading...</span>\n                      </div>\n                    </div>\n                  ) : nfts && nfts.length > 0 ? (\n                    nfts.map((listing) => {\n                      return (\n                        <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                          {listing.fileType === \"image\" ? (\n                            <ListingCards\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                              ownerId={listing.ownerId}\n                              sellingMethod={listing.sellingMethod}\n                              // userProfile\n                            />\n                          ) : (\n                            <VideoCard\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                              ownerId={listing.ownerId}\n                              fileType={listing.fileType}\n                              sellingMethod={listing.sellingMethod}\n                            />\n                          )}\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-white text-center mt-5\">No NFTs Found</p>\n                  )}\n                </div>\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      props.profileNFTs.pagination > nfts.length &&\n                      nfts.length > 10 && (\n                        <button\n                          className=\"btn btn-linear-gradient px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  profileNFTs: state.nft.profileNFTs,\n  profileNFTsStatus: state.nft.profileNFTsStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  individualUser: state.user.individualUser,\n  individualUserAuth: state.user.individualUserAuth,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getProfileNfts,\n  beforeNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  getUserById,\n  beforeUser,\n  beforeTogleLikeDislike,\n})(UserProfile);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["630","631","632","633","634","635"],"import React, { Component } from 'react';\nimport NavbarMain from '../navbar-main/NavbarMain';\nimport Footer from '../footer/footer';\nimport Breadcrumb from '../breadcrumb/breadcrumb';\nimport './CreateCollections.css';\nimport { editImages } from '../../assets/assets';\nimport { ReactComponent as ProfileEditSVG } from '../../assets/images/edit-pen.svg';\nimport CollectionUploadIcon from '../../assets/images/collection-upload-icon.svg';\nimport { connect } from 'react-redux';\nimport {\n  beforeCollection,\n  upsertCollection,\n} from '../collections/collections.actions';\nimport { beforeCategory, getCategories } from '../categories/categories.action';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport SimpleReactValidator from 'simple-react-validator';\nimport { ENV } from '../../config/config';\nimport $ from 'jquery';\nimport { toast } from 'react-toastify';\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport UploadIcon from '../../assets/images/uploadIcon.png';\nimport { MdClose } from 'react-icons/md';\n\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: '',\n      collection: {\n        userId: ENV.getUserKeys('_id')._id,\n        categoryId: '',\n        logo: '',\n        featuredImg: '',\n        banner: '',\n        name: '',\n        url: '',\n        logoUrl: '',\n        bannerUrl: '',\n        featuredImgUrl: '',\n        description: '',\n      },\n      categories: null,\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: 'This field is required.', // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate() {\n    if (this.props.error) {\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push('/explore/exploreAll');\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      this.setState({ categories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes('image')) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html('File selected');\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys('_id')._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: '',\n      categoryId: '',\n      logo: '',\n      featuredImg: '',\n      banner: '',\n      name: '',\n      url: '',\n      description: '',\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys('_id')._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection('collection/create', formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: 'Please fill all required fields in valid format.',\n              formValid: false,\n            },\n            () => {\n              $('#create-collection').scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: '', featuredImgUrl: '' };\n    this.setState({ collection });\n  };\n\n  render() {\n    const { collection, errors, loader, isSubmitted, categories } = this.state;\n    if (!ENV.getUserKeys('_id')._id) {\n      toast.error('Please login to create Collection');\n      this.props.history.push('/');\n      return ' ';\n    } else {\n      return (\n        <>\n          <NavbarMain />\n          <Breadcrumb title1={'Create'} title2={'Create Collection'} />\n          <section className='edit-profile padding-wrapper create-collection-container'>\n            {loader && <FullPageLoader />}\n            <div className='container'>\n              <div className='row'>\n                <div className='col-12'>\n                  <div className='intro'>\n                    <div className='intro-content'>\n                      <span>Create Now</span>\n                      <h3 className='mb-0'>Create New Collection</h3>\n                    </div>\n                  </div>\n                </div>\n\n                <div className='col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3'>\n                  <div className='edit-inp-subheading'>\n                    <h6>Logo Image</h6>\n                    <span className='text-danger'>\n                      {this.validator.message(\n                        'logo',\n                        collection.logo,\n                        'required'\n                      )}\n                    </span>\n                  </div>\n                  <div className='collection-logo-container pt-2'>\n                    {collection && collection.logo ? (\n                      <img\n                        src={collection.logoUrl}\n                        className='colection-avatar-img'\n                      />\n                    ) : (\n                      <div className='colection-avatar'></div>\n                    )}\n                    <label>\n                      <div className='avatar-btn-pen'>\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        id='logo'\n                        type='file'\n                        accept='.png,.jpeg,.jpg'\n                        onChange={(e) => this.onFileChange(e)}\n                        style={{ display: 'none' }}\n                        name='logo'\n                      />\n                    </label>\n                  </div>\n                  <div className=''>\n                    <div className='edit-inp-subheading'>\n                      <h6>Featured Image</h6>\n                      <span className='text-danger'>\n                        {this.validator.message(\n                          'logo',\n                          collection.featuredImg,\n                          'required'\n                        )}\n                      </span>\n                    </div>\n                    <div className='upload-featured-container'>\n                      {collection && collection.featuredImg ? (\n                        <div className='uploaded-featured-container'>\n                          <img\n                            src={collection.featuredImgUrl}\n                            className='uploaded-featured-img'\n                          />\n                          <div className='uploaded-featured-hover w-100'>\n                            <div className='uploaded-featured-cross'>\n                              <MdClose\n                                color='#e33d0bc2'\n                                className='uploaded-cross-icon'\n                                onClick={() => this.clearData()}\n                              />\n                            </div>\n                            <label>\n                              <div className='text-center'>\n                                <img src={UploadIcon} alt='upload-icon' />\n                              </div>\n                              <input\n                                id='featuredImg'\n                                type='file'\n                                accept='.png,.jpeg,.jpg'\n                                style={{ display: 'none' }}\n                                name='featuredImg'\n                                onChange={(e) => this.onFileChange(e)}\n                              />\n                            </label>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className='upload-featured-img'>\n                          <label>\n                            <div className='text-center'>\n                              <img\n                                src={CollectionUploadIcon}\n                                alt='upload-icon'\n                              />\n                            </div>\n                            <div className='upload-featured-img-content pt-2'>\n                              <h6 className='pb-1'>Browse Files</h6>\n                              <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                            </div>\n                            <input\n                              id='featuredImg'\n                              type='file'\n                              accept='.png,.jpeg,.jpg'\n                              style={{ display: 'none' }}\n                              name='featuredImg'\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                          </label>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n                <div className='col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0'>\n                  <div className='row g-4'>\n                    <div className='col-md-4 col-lg-4'>\n                      <div className='edit-inp-subheading position-relative'>\n                        <h6>Name</h6>\n                        <span className='text-danger position-absolute top-0'>\n                          {this.validator.message(\n                            'name',\n                            collection.name,\n                            'required'\n                          )}\n                        </span>\n                      </div>\n                      <div className='edit-inp pt-4'>\n                        <input\n                          id='name'\n                          type='text'\n                          name='name'\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.name}\n                          placeholder='Name'\n                          maxLength='55'\n                          autoComplete='off'\n                        />\n                      </div>\n                    </div>\n                    <div className='col-md-4 col-lg-4'>\n                      <div className='edit-inp-subheading position-relative'>\n                        <h6>URL</h6>\n                        <span className='text-danger position-absolute top-0'>\n                          {this.validator.message('url', collection.url, 'url')}\n                        </span>\n                      </div>\n                      <div className='edit-inp pt-4'>\n                        <input\n                          id='url'\n                          type='text'\n                          name='url'\n                          placeholder='URL'\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.url}\n                          autoComplete='off'\n                        />\n                      </div>\n                    </div>\n                    <div className='col-md-4 col-lg-4'>\n                      <div className='edit-inp-subheading position-relative'>\n                        <h6>Select Category</h6>\n                        <span className='text-danger position-absolute top-0'>\n                          {this.validator.message(\n                            'category',\n                            collection.categoryId,\n                            'required'\n                          )}\n                        </span>\n                      </div>\n                      <div className='edit-inp pt-4'>\n                        <select\n                          id='category'\n                          name='categoryId'\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value='' className='d-none'>\n                            Select Collection\n                          </option>\n                          {categories &&\n                            categories.map((category, index) => {\n                              return (\n                                <option key={index} value={category._id}>\n                                  {category.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                      </div>\n                    </div>\n                    <div className='col-md-8'>\n                      <div className='edit-inp-subheading pt-4'>\n                        <h6>Discription</h6>\n                      </div>\n                      <div className='edit-inp pt-4'>\n                        <textarea\n                          name='description'\n                          placeholder='Discription'\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.description}\n                          maxLength='150'\n                        ></textarea>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className='col-12 mt-4 mt-md-5 text-center'>\n                  <div className=''>\n                    <button\n                      type='button'\n                      className='btn btn-linear-gradient'\n                      onClick={(e) => this.submit(e)}\n                    >\n                      Create Collections\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n          <Footer />\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["636"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["637"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["638"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/create-nft-reducer.js",["639"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/reducer/reducer.js",["640"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["641"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["642"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user/user.reducer.js",["643"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.reducer.js",["644"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["645"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["646"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["647"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout2/layout2.jsx",["648","649"],"import React, { Component } from \"react\";\nimport Particles from \"react-tsparticles\";\nimport NavbarMain from \"../../components/navbar-main/NavbarMain\";\nimport Footer from \"../../components/footer/footer\";\n// import Scrollup from '../../components/scroll-up/sroll-up';\n\nclass Layout2 extends Component {\n  render() {\n    const particlesData = {\n      fullScreen: {\n        zIndex: -5,\n      },\n      color: {\n        value: \"#5666fe\",\n      },\n      twinkle: {\n        lines: {\n          enable: true,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n        particles: {\n          enable: false,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n      },\n      wobble: {\n        distance: 5,\n        enable: false,\n        speed: 2,\n      },\n      particles: {\n        number: {\n          value: 25,\n          density: {\n            enable: true,\n            value_area: 800,\n          },\n        },\n        shape: {\n          type: \"circle\",\n          stroke: {\n            width: 0,\n            color: \"#5666fe\",\n          },\n          polygon: {\n            nb_sides: 5,\n          },\n          image: {\n            src: \"img/github.svg\",\n            width: 100,\n            height: 100,\n          },\n        },\n        opacity: {\n          value: 0.5,\n          random: false,\n          anim: {\n            enable: false,\n            speed: 1,\n            opacity_min: 0.1,\n            sync: false,\n          },\n        },\n        size: {\n          value: 3,\n          random: true,\n          anim: {\n            enable: false,\n            speed: 50,\n            size_min: 0.1,\n            sync: false,\n          },\n        },\n        line_linked: {\n          enable: true,\n          distance: 150,\n          color: \"#5666fe\",\n          opacity: 0.4,\n          width: 1,\n        },\n        move: {\n          enable: true,\n          speed: 1,\n          direction: \"none\",\n          random: false,\n          straight: false,\n          out_mode: \"out\",\n          bounce: false,\n          attract: {\n            enable: false,\n            rotateX: 600,\n            rotateY: 1200,\n          },\n        },\n      },\n      interactivity: {\n        detect_on: \"canvas\",\n        events: {\n          onhover: {\n            enable: true,\n            mode: \"grab\",\n          },\n          onclick: {\n            enable: true,\n            mode: \"push\",\n          },\n          resize: true,\n        },\n        modes: {\n          grab: {\n            distance: 140,\n            line_linked: {\n              opacity: 1,\n            },\n          },\n          bubble: {\n            distance: 400,\n            size: 40,\n            duration: 2,\n            opacity: 8,\n            speed: 2,\n          },\n          repulse: {\n            distance: 200,\n            duration: 0.4,\n          },\n          push: {\n            particles_nb: 4,\n          },\n          remove: {\n            particles_nb: 2,\n          },\n        },\n      },\n      retina_detect: true,\n      zLayers: 1,\n    };\n    return (\n      <>\n        {/* <NavbarMain /> */}\n        <div className=\"main\">\n          <Particles id=\"tsparticles\" options={{ ...particlesData }} />\n          {this.props.children}\n        </div>\n        {/* <Footer /> */}\n      </>\n    );\n  }\n}\n\nexport default Layout2;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/top-seller/topseller2.js",["650","651","652","653","654"],"import React, { useEffect, useState } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport { Link } from 'react-router-dom';\r\nimport { ENV } from './../../config/config';\r\nimport { getTopSellers, beforeUser } from './../user/user.action';\r\nimport ViewAllIcon from '../../assets/images/view-all-arrow.svg';\r\nimport AvatarImg from '../../assets/images/seller-avatar.png';\r\nimport SellerTickIcon from '../../assets/images/seller-tick-icon.svg';\r\nimport './topseller.css';\r\n\r\nconst exmpData = [\r\n  {\r\n    id: 1,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 2,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 3,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 4,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 5,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 6,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 7,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 8,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 9,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 10,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 11,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 12,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n];\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.user.topSellersAuth) {\r\n      setSellers(props.user.sellers.topSellers);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  return (\r\n    <section className='top-seller-area padding-wrapper'>\r\n      <div className='container'>\r\n        <div className='row'>\r\n          <div className='col-12'>\r\n            {/* Intro */}\r\n            <div className='intro d-flex justify-content-between align-items-end m-0'>\r\n              <div className='intro-content'>\r\n                <span>CREATIVE ARTIST</span>\r\n                <h3 className='mb-0'>Top Sellers</h3>\r\n              </div>\r\n              {sellers && sellers.length > 12 && props.viewAll ? (\r\n                <div className='intro-btn'>\r\n                  <Link\r\n                    className='btn btn-rounded-bordered btn-viewAll'\r\n                    to='/top-sellers-list'\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt='arrow-left' className='ms-2' />\r\n                  </Link>\r\n                </div>\r\n              ) : (\r\n                ''\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className='row items'>\r\n          {sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              if (idx <= 11) {\r\n                return (\r\n                  <div\r\n                    key={`ts_${idx}`}\r\n                    className='col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards'\r\n                  >\r\n                    {/* Single Seller */}\r\n                    <div className='card'>\r\n                      <div className='single-seller d-flex align-items-center'>\r\n                        <div className='seller-avatar-container'>\r\n                          <img\r\n                            className='avatar-md rounded-circle'\r\n                            src={AvatarImg}\r\n                            alt=''\r\n                          />\r\n                          <span className='seller-avatar-active'>\r\n                            <img src={SellerTickIcon} alt='tick-icon' />\r\n                          </span>\r\n                        </div>\r\n\r\n                        {/* Seller Info */}\r\n                        <div className='seller-info ml-3 w-100'>\r\n                          <Link\r\n                            className='seller mb-2'\r\n                            to={`/author/${author._id}`}\r\n                          >\r\n                            {author.username}\r\n                          </Link>\r\n                          <span className='text-end'>\r\n                            {' '}\r\n                            {author.totalETH.toFixed(2)}\r\n                          </span>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                );\r\n              }\r\n            })\r\n          ) : (\r\n            <p className='text-white text-center'>No Top Sellers Found</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["655","656","657","658","659","660","661","662","663"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.js",["664","665","666","667","668","669","670","671"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  // useEffect(() => {\n  //   if (props.settings.settingsAuth) {\n  //     setData(props.settings.settings);\n  //   }\n  // }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div className=\"input-group notify-form\">\n                  <div className=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/popular-collections.js",["672","673","674","675","676","677","678","679","680","681"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/types.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collections.actions.js",["682","683","684"],"import { toast } from 'react-toastify';\nimport {\n  GET_ERRORS,\n  BEFORE_COLLECTION,\n  SET_AUTH_STATE,\n  GET_COLLECTION,\n  GET_COLLECTIONS,\n  UPSERT_COLLECTION,\n  DELETE_COLLECTION,\n  ALL_COLLECTIONS,\n  BEFORE_CATEGORY,\n  GET_CATEGORIES,\n  COLLECTION_CATEGORES,\n  MY_COLLECTIONS,\n  GET_POPULAR_COLLECTIONS,\n  BEFORE_POPULAR_COLLECTION,\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport { CgData } from 'react-icons/cg';\n\nexport const beforeCollection = () => {\n  return {\n    type: BEFORE_COLLECTION,\n  };\n};\n\nexport const getCollection = (collectionId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}collection/get/${collectionId}`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        dispatch({\n          type: GET_COLLECTION,\n          payload: data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getCollections =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs) url += `?${qs}`;\n    //console.log(url, 'url sending');\n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        'content-type': 'application/json',\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        //console.log(data, 'collections api response');\n        if (data.success) {\n          dispatch({\n            type: GET_COLLECTIONS,\n            payload: data.data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\nexport const myCollections = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  // let url = `http://3.142.91.8/v1/front/collection/list`;\n  let url = `${ENV.url}collection/myCollectionList`;\n\n  if (userId) url += `?userId=${userId}`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        dispatch({\n          type: MY_COLLECTIONS,\n          payload: data.data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data.message,\n        });\n      }\n    })\n    .catch((error) => {\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const upsertCollection =\n  (apiURL, body, method = 'POST') =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_COLLECTION,\n            payload: data,\n          });\n        } else {         \n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        console.log(error.response.data)\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const deleteCollection = (collectionId) => (dispatch) => {\n  dispatch(emptyError());\n  let url = `${ENV.url}collection/delete/${collectionId}`;\n\n  fetch(url, {\n    method: 'DELETE',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        toast.success(data.message);\n        dispatch({\n          type: DELETE_COLLECTION,\n          payload: data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const setAuthState = () => (dispatch) => {\n  dispatch({\n    type: SET_AUTH_STATE,\n  });\n};\nexport const beforeCategory = () => {\n  return {\n    type: BEFORE_CATEGORY,\n  };\n};\nexport const getCategories = () => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}category/list`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: COLLECTION_CATEGORES,\n          payload: data.categories,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      //console.log(error, 'error==>');\n\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const toggleLikeDislike = (body) => (dispatch) => {\n  let data = JSON.stringify(body);\n  const url = `${ENV.url}collectionLikes/likeDislike`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    data,\n  })\n    .then((res) => res.json())\n    .then((data) => {})\n    .catch((error) => {\n      //console.log(error, 'error likes');\n    });\n};\n\nexport const beforePopularCollection = () => {\n  return {\n    type: BEFORE_POPULAR_COLLECTION,\n  };\n};\n\nexport const getPopularCollections =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}collection/popular`;\n\n    if (qs) url += `?${qs}`;\n    //console.log(url, 'url sending');\n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        'content-type': 'application/json',\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        //console.log(data, 'popular collections api response');\n        if (data.success) {\n          dispatch({\n            type: GET_POPULAR_COLLECTIONS,\n            payload: data.data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user/user.action.js",["685","686"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n    console.log(data,\"data\")\n      if (data.status) {\n        // ENV.encryptUserData(data.data);\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n        toast.success(data.message);\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n   \n       \n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["687","688","689","690","691"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  CREATE_ACITIVITY,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n} from \"./../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       \n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      // alert(\"called\")\n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const update =\n  (body, qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .put(url, body)\n      .then(function (response) {\n        if (response.data.success) {\n        } else {\n        }\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n  };\n\nexport const createActivity = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}activity/create`;\n\n  axios\n    .post(url, body)\n    .then(function (response) {\n    \n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const getActivities =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}activity/get`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {\n       \n\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n  export const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {    \n        dispatch({\n          type:  GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n \n      })\n      .catch(function (error) {\n        console.log(error)\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n   \n      });\n  };\n\nexport const getNFTsByCollection = (id) => (dispatch) => {\n  let data = {\n    collectionId: id,\n  };\n\n  dispatch(emptyError());\n\n  const url = `${ENV.url}nfts/getNFTsByCollection`;\n  axios\n    .post(url, data)\n    .then(function (response) {\n      if (response.data.success) {\n        dispatch({\n          type: GET_NFTS_BY_COLLECTION,\n          payload: response.data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: response.data,\n        });\n      }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .get(url)\n      .then(function (response) {\n        console.log();\n        if (response.data.success) {\n          dispatch({\n            type: GET_MYLIKED_NFTS,\n            payload: response.data.data,\n          });\n        } else {\n        }\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n  };\n\nexport const createNFT = async (formData) => {\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n  } catch (err) {}\n};\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  const res = await axiosPostFormData(\"nfts/storeNFTData\", formData, true);\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       \n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n        } else {\n        }\n      })\n      .catch((errors) => {});\n  };\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore.action.js",["692"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/hero/hero.js",["693"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["694","695"],"import React, { useState } from \"react\";\nimport { Link, useHistory, useLocation } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [activeTab, setActiveTab] = React.useState(null);\n  const [searchactive, setSearchActive] = useState(false);\n  const [searchValue,setSearchValue]=useState('')\n  const history = useHistory();\n  const location = useLocation();\n\n  const handleChange = (e) => {\n    setSearchValue(e.target.value)\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword=()=>{\n    if(searchValue!=='' && searchValue.length>=3){\n\n      history.push({\n        pathname:\"/explore/allNFT\",\n        state:searchValue\n      })\n    }\n\n  }\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n   \n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"dark\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <Navbar.Brand to=\"/\" href=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </Navbar.Brand>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav\n              className=\"mx-xl-auto\"\n              defaultActiveKey={`${location.pathname}`}\n            >\n              <Nav.Link to=\"/\" href=\"/\" className=\"nav-main-link\">\n                Home\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                active={activeTab === 1}\n                defaultactivekey={activeTab}\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item\n                  to=\"/explore/exploreAll\"\n                  href=\"/explore/exploreAll\"\n                  active={activeTab === 1}\n                  eventKey={1}\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/explore/exploreAll\"\n                      ? \"active-item\"\n                      : \"\"\n                  }`}\n                  onClick={() => {\n                    setActiveTab(1);\n                  }}\n                >\n                  Explore All\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/explore/allNFT\"\n                  href=\"/explore/allNFT\"\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/explore/allNFT\" ? \"active-item\" : \"\"\n                  }`}\n                  eventKey={2}\n                  active={activeTab === 2}\n                  onClick={() => {\n                    setActiveTab(2);\n                  }}\n                >\n                  All NFT\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                active={activeTab === 1}\n                defaultactivekey={activeTab}\n                className={`nav-main-link dropdown-bg ${\n                  location.pathname === \"/create\" ? \"active-item\" : \"\"\n                }`}\n              >\n                <NavDropdown.Item\n                  to=\"/create\"\n                  href=\"/create\"\n                  active={activeTab === 1}\n                  eventKey={1}\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/create\" ? \"active-item\" : \"\"\n                  }`}\n                  onClick={() => {\n                    setActiveTab(1);\n                  }}\n                >\n                  Create NFT\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/createcollection\"\n                  href=\"/createcollection\"\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/createcollection\"\n                      ? \"active-item\"\n                      : \"\"\n                  }`}\n                  eventKey={2}\n                  active={activeTab === 2}\n                  onClick={() => {\n                    setActiveTab(2);\n                  }}\n                >\n                  Create Collection\n                </NavDropdown.Item>\n              </NavDropdown>\n\n              {/* <Nav.Link to=\"/create\" href=\"/create\" className=\"nav-main-link\">\n                Create\n              </Nav.Link> */}\n              <Nav.Link\n                to=\"/userprofile\"\n                href=\"/userprofile\"\n                className=\"nav-main-link\"\n              >\n                Profile\n              </Nav.Link>\n           \n             \n             \n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) =>\n                    e.key === \"Enter\" && handleSearchKeyword()\n                  }\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={()=>handleSearchKeyword()}\n                >\n                  <img src={SearchIcon}  alt=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) =>\n                  e.key === \"Enter\" && handleSearchKeyword()\n                }\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={()=>handleSearchKeyword()}\n              >\n                <img src={SearchIcon} alt=\"search-icon\" />\n              </button>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/buy-sell/Buysell.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/assets/assets.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/test-video-card/videoCard.js",["696"],"import React, { useRef } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./videoCard.css\";\nimport useVideoPlayer from \"./components/useVideoPlayer\";\nimport { ENV } from \"../../config/config\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\n\nconst VideoCard = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  ownerId,\n  sellingMethod,\n  userProfile,\n  auctionStartDate,\n  auctionEndDate,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n  const videoElement = useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div className=\"auction-img-wrapper\">\n        <div className=\"card-img-top\">\n          <div className=\"video-wrapper\">\n            <video\n              src={CardImg}\n              ref={videoElement}\n              onTimeUpdate={handleOnTimeUpdate}\n            />\n            <div className=\"controls\">\n              <div className=\"actions\">\n                <button\n                  className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                  onClick={togglePlay}\n                >\n                  {playerState.isPlaying ? (\n                    <BsFillPauseFill />\n                  ) : (\n                    <BsFillPlayFill />\n                  )}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default VideoCard;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/filter-component/FilterComponent.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/types/types.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["697"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/offers/offers.action.js",["698"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice, acceptNftOffer} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"data\")\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n   \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n   console.log(data,\"data\")\n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            acceptNftOffer(body);\n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const buyNow = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}nfts/buyNft`;\nconsole.log(\"sending buy now djfjlkdjsfljsdklf\")\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            \n            dispatch({\n                type: BUY_NOW,\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      \n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/bids/bids.action.js",["699","700"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/utils/exportData.js",["701"],"import nft1 from \"../assets/images/nft1.jpg\";\nimport nft2 from \"../assets/images/nft2.webp\";\nimport nft3 from '../assets/images//nft3.jpeg';\nimport nft4 from \"../assets/images/nft4.webp\";\nimport nft5 from \"../assets/images/nft5.jpg\";\nimport {\n  AiFillHeart,\n  BsTagFill,\n  GrTransaction,\n  MdShoppingCart,\n} from \"react-icons/all\";\nexport const WordsFamousNfts = [\n    {\n      img: nft3,\n      link: \"https://niftygateway.com/itemdetail/primary/0x0151834a6997f89eb8372ac54ac077d79bb4d1e0/7\",\n    },\n    {\n      img: nft1,\n      link: \"https://onlineonly.christies.com/s/beeple-first-5000-days/beeple-b-1981-1/112924?ldp_breadcrumb=back\",\n    },\n    {\n      img: nft2,\n      link: \"https://niftygateway.com/marketplace?collection=0x12f28e2106ce8fd8464885b80ea865e98b465149&tokenId=100010001\",\n    },\n    { img: nft4, link: \"https://foundation.app/@snowden/~/24437\" },\n    { img: nft5, link: \"https://www.phillips.com/mdj\" },\n  ];\n\n\n  export const iconByActivity={\n    minted:<MdShoppingCart/>,\n    transfer:<GrTransaction/>,\n    list:<BsTagFill/>\n  }","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/utils/functions.js",["702","703","704","705","706","707","708","709","710"],"import axios from 'axios';\nimport { ENV } from '../config/config';\nimport { Redirect } from 'react-router-dom';\nimport { toast } from 'react-toastify';\nimport { useDispatch } from 'react-redux';\nimport { emptyError } from '../redux/shared/error/error.action';\nimport {\n  GET_ERRORS,\n  BEFORE_BID,\n  GET_BIDS,\n  DELETE_BID,\n  CREATE_BID,\n  ACCEPT_BID,\n} from '../redux/types';\nlet baseUrl = process.env.REACT_APP_BASE_URL;\n\nexport const axiosSyncPost = (url, data, isMultipart = false) => {\n  return new Promise((resolve, reject) => {\n    const params = new URLSearchParams();\n    let keys = Object.keys(data);\n    for (let x = 0; x < keys.length; x++) {\n      params.append(keys[x], data[keys[x]]);\n    }\n\n    const config = {\n      headers: {\n        'Content-Type': isMultipart\n          ? 'multipart/form-data'\n          : 'application/x-www-form-urlencoded',\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n    };\n\n    url = baseUrl + url;\n\n    axios.post(url, params, config).then(\n      (res) => {\n        resolve(res.data);\n      },\n      (error) => {\n        resolve(error);\n      }\n    );\n  });\n};\n\nexport const axiosPostFormData = (url, body, isMultipart = false) => {\n  return new Promise((resolve, reject) => {\n    const config = {\n      headers: {\n        // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n    };\n\n    // url = testingURl + url;\n\n    axios.post(ENV.url + url, body, config).then(\n      (res) => {\n        console.log(res, 'response');\n        // console.log(res,\"res success\");\n        resolve(res.data);\n      },\n      (error) => {\n        console.log(error.message, 'error');\n        console.log(error.data, 'error');\n        toast.error(error.message);\n        resolve(error);\n      }\n    );\n  });\n};\n\nexport const decimalNumberValidator = (evt) => {\n  let e = evt || window.event;\n\n  // Allow: backspace, delete, tab, escape, enter and .\n  const specialKeys = [46, 8, 9, 27, 13, 110];\n\n  // Allow: Ctrl+A,Ctrl+C,Ctrl+V, Command+A\n  if (\n    specialKeys.includes(e.keyCode) ||\n    // Allow: Ctrl+A,Ctrl+C,Ctrl+Z,Ctrl+X Command+A\n    ((e.keyCode === 65 ||\n      e.keyCode === 67 ||\n      e.keyCode === 90 ||\n      e.keyCode === 88) &&\n      (e.ctrlKey === true || e.metaKey === true)) ||\n    // Allow: home, end, left, right, down, up\n    (e.keyCode >= 35 && e.keyCode <= 40)\n  ) {\n    // let it happen, don't do anything\n    return;\n  }\n\n  let key = e.keyCode || e.which;\n  if (\n    !e.shiftKey &&\n    !e.altKey &&\n    !e.ctrlKey &&\n    (key === 190 ||\n      key === 110 ||\n      (key >= 48 && key <= 57) ||\n      (key >= 96 && key <= 105) ||\n      key === 8 ||\n      key === 9 ||\n      key === 13 ||\n      key === 35 ||\n      key === 36 ||\n      key === 37 ||\n      key === 39 ||\n      key === 46 ||\n      key === 45)\n  ) {\n  } else {\n    e.returnValue = false;\n    if (e.preventDefault) e.preventDefault();\n  }\n};\nexport const firstInputCharacterSpace = (evt, value) => {\n  let e = evt || window.event;\n  if (value === 0 && e.which === 32) e.preventDefault();\n};\nexport const setFixedPriceNftTOken = (body) => {\n  let url = `${ENV.url}nftFixedTokens/getFixedtokens`;\n  // let url = `http://3.142.91.8/v1/front/auctions/live`;\n\n  // console.log(url,\"url==>123\")\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body: body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      // console.log(data,\"created nft token\")\n      if (data.success) {\n      } else {\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'error');\n    });\n};\n\nexport const changeOwnerShip = (nftOwnerId, currentUserId) => {\n  // alert(\"changing ownership\")\n  let url = `${ENV.url}nfts/editNft`;\n  // console.log('fetch url', url)\n  let body = {\n    nftOwnerId,\n    currentUserId,\n  };\n  fetch(url, {\n    method: 'PATCH',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status === 'success') {\n        toast.success('Successfully bought nft');\n        window.location.href = '/explore-all';\n      }\n      // console.log(data,\"response from the change ownershiop\")\n    })\n    .catch((errors) => {\n      console.log('error', errors);\n    });\n};\nexport const acceptBit = (tokenId, body) => {\n  const url = `${ENV.url}bid/accept`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        // acceptNftOffer(tokenId,body);\n\n        toast.success(data.message);\n        window.location.href = '/explore-all';\n        // dispatch({\n        //     type: ACCEPT_BID,\n        //     payload: data\n        // })\n      } else {\n        toast.error(data.message);\n      }\n    })\n    .catch((error) => {\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n    });\n};\n\nexport const placeBidApi = (body) => {\n  const url = `${ENV.url}bid/create`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n\n        toast.success(data.message);\n        window.location.href = '/explore-all';\n        // dispatch({\n        //     type: CREATE_BID,\n        //     payload: data\n        // })\n      } else {\n        toast.error(data.message);\n        // dispatch({\n        //     type: GET_ERRORS,\n        //     payload: data\n        // })\n      }\n    })\n    .catch((error) => {\n      console.log('listing', error);\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      // dispatch({\n      //     type: GET_ERRORS,\n      //     payload: error\n      // })\n    });\n};\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/BidModal.js",["711","712","713","714"],"import React, { useState, useEffect } from \"react\";\nimport { Modal, Button } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport NftImg from \"../../assets/images/listingImg3.png\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport axios from \"axios\";\n\nconst BidModal = (props) => {\n  const [bid, setBid] = useState();\n  const [checkBox, setCheckBox] = useState(false);\n  const [exchangeRate, setExchangeRate] = useState(0);\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  const {\n    onChange,\n    decimalNumberValidator,\n    handleModalSubmit,\n    calculatePricePercantage,\n    onHide,\n    balance,\n    price,\n  } = props;\n\n  return (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal bid-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Place a Bid\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Price</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"bid-inp-container d-flex align-items-center\">\n          <div className=\"inp-container\">\n            <input\n              type=\"number\"\n              placeholder=\"Place Your Bid\"\n              name=\"nftConfig.price.amount\"\n              style={{ borderRadius: \"4px\" }}\n              onChange={(e) => onChange(e)}\n              onKeyDown={(e) => decimalNumberValidator(e)}\n              defaultValue={calculatePricePercantage()}\n              // disabled={balance===0?true:false}\n\n              value={price}\n            />\n\n            <div className=\"dollar-rate text-end\">\n              <p className=\"\">\n                ${price ? (price * exchangeRate).toFixed(2) : 0}\n              </p>\n            </div>\n          </div>\n          <div className=\"inp-currency\">\n            <h6>ETH</h6>\n          </div>\n        </div>\n        <div className=\"bid-balance\">\n          <p>Balance: {Number(balance).toFixed(4)} ETH</p>\n        </div>\n        {balance !== \"\" && balance === 0 && (\n          <p className=\"text-center text-danger\">\n            Please Add Balance to place bid\n          </p>\n        )}\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container\">\n            {checkBox ? (\n              <div\n                className=\"custom-checked-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <img src={TickIcon} alt=\"checked\" />\n              </div>\n            ) : (\n              <div\n                className=\"custom-uncheck-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></div>\n            )}\n            <p>\n              By checking this box,I agree to MintsClub{\" \"}\n              <Link>Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"btn btn-linear-gradient mt-2\"\n          onClick={() => {\n            handleModalSubmit();\n            onHide();\n          }}\n          disabled={price < calculatePricePercantage() || balance === 0}\n        >\n          Confirm Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default BidModal;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/BuyModal.js",["715","716","717","718","719","720","721","722","723"],"import React, { useState } from \"react\";\nimport { Modal, Button, Spinner } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport NftImg from \"../../assets/images/listingImg3.png\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nconst BuyModal = (props) => {\n  const [purchase, setPurchase] = useState(true);\n  const [checkBox, setCheckBox] = useState(false);\n  const {\n    name,\n    image,\n    price,\n    exchangeRate,\n    tokenId,\n    modal,\n    setModal,\n    buyNow,\n    confirmed,\n    transactionHash,\n    transactionSuccess,\n    onHide,\n    disabled,\n  } = props;\n\n  return confirmed === \"\" || confirmed === false ? (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Complete Checkout\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                <img src={image} alt=\"nft-img\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-conntent\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-6\">\n                  <p>{name}</p>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>{price} ETH</p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <p>\n                      {name} # {tokenId}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <p>Creator Fees: 5%</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>{price} ETH</h6>\n              <p>${(price * exchangeRate).toFixed(2)}</p>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container\">\n            {checkBox ? (\n              <div\n                className=\"custom-checked-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <img src={TickIcon} alt=\"checked\" />\n              </div>\n            ) : (\n              <div\n                className=\"custom-uncheck-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></div>\n            )}\n            <p>\n              By checking this box,I agree to MintsClub{\" \"}\n              <Link>Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => {\n            buyNow();\n          }}\n          disabled={disabled}\n          className=\"btn btn-linear-gradient mt-2\"\n        >\n          Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  ) : (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal purchase-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          {!transactionSuccess\n            ? \"Your Purchase is Processing\"\n            : \"Your Purchase has processed!\"}\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"modal-nft-container\">\n          <div className=\"modal-nft-img\">\n            <img src={image} alt=\"nft-img\" />\n          </div>\n        </div>\n        <div className=\"modal-nft-purchased mt-3\">\n          {!transactionSuccess ? (\n            <p>\n              Woo! You just Purchased FancyLaday. It should be confirmed on the\n              blockchain shortly\n            </p>\n          ) : (\n            <p>\n              {\" \"}\n              Woo! You just Purchased FancyLaday. It's been confirmed on the\n              blockchain shortly\n            </p>\n          )}\n        </div>\n        <div className=\"modal-nft-status mt-4\">\n          <div className=\"modal-status-subheadings d-flex align-items-center justify-content-between\">\n            <p> Status </p>\n            <p> Transaction Hash </p>\n          </div>\n          <div className=\"modal-status-content d-flex align-items-center justify-content-between\">\n            <div className=\"status-process d-flex align-items-center\">\n              {!transactionSuccess ? (\n                <>\n                  <Spinner\n                    animation=\"border\"\n                    role=\"status\"\n                    size=\"sm\"\n                    variant=\"primary\"\n                    className=\"me-1\"\n                  ></Spinner>\n                  <p>Processing</p>\n                </>\n              ) : (\n                <>\n                  <CheckCircleIcon />\n                </>\n              )}\n            </div>\n            <div className=\"status-address\" onClick={()=>window.open(`https://rinkeby.etherscan.io/tx/${transactionHash}`,'_blank')}>\n              <p>\n                {transactionHash.slice(0, 6) +\n                  \".....\" +\n                  transactionHash.slice(-6)}\n              </p>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <p>Share</p>\n        </div>\n        <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-linkedin-in\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-facebook-f\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-instagram\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-twitter\"} />\n          </a>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\nexport default BuyModal;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/auctions.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore-items.js",["724","725","726","727","728","729","730"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nimport NftCard from '../collections/components/NftCard/NftCard'\nconst initData = {\n    btn_1: \"Load More\",\n}\n\nfunction ExploreItems(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n\n    useEffect(() => {\n        // get NFTs for explore section\n        const nftQS = { page: 1, limit: 4, explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }, [])\n\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            if (nftsData) {\n                setNFTs(nftsData.nfts)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n                setLoader(false)\n                if (props.setView)\n                    props.setViewAll(nftsData.nfts && nftsData.nfts.length > 0)\n            }\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n\n        // get more NFTs for explore section\n        const nftQS = { page: 1, limit: limit * (page + 1), explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n    return (\n        <>\n            {/* <div className={`row items ${props.class1 ? props.class1 : ''} ${!nfts.length ? 'justify-content-center' : ''}`}> */}\n            <div className=\"row\">\n            <div className=\"row justify-content-center mt-5 w-100\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                {/* <span>{initData.pre_heading}</span> */}\n                                <span>Explore</span>\n                                {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                                    <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                            </div>\n                        </div>\n                    </div>\n\n                {\n                    props.nfts && props.nfts.length > 0 ?\n                        props.nfts.map((item, idx) => {\n                            return (\n                                \n                                // <div key={`${props.key}_${idx}`} className={`col-12 col-sm-6 col-lg-3 item d-block ${props.class2 ? props.class2 : ''}`}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <Link to=\"/author\">\n                                //                         <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6>\n                                //                     </Link>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     {/* <span>{item.sold} of {item.copies}</span> */}\n                                //                 </div>\n                                //                 {/* <Link className=\"btn btn-bordered-white btn-smaller mt-3\" to=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</Link> */}\n                                //             </div>http://3.142.91.8/authorshttp://3.142.91.8/authors\n                                //         </div>\n                                //     </div>\n                                // </div>\n                                     \n                      <>\n                     \n                                     <div className=\"col-4 mt-5\">\n                                     <NftCard/>\n                                     </div>\n\n                                     </>\n                              \n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Explore</p>\n                }  </div>\n            {/* </div> */}\n            {\n                props.loadMoreBtn &&\n                <div className=\"row\">\n                    <div className=\"col-12 text-center\">\n                        <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                    </div>\n                </div>\n            }\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs })(ExploreItems);","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["731"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/components/NftCard/NftCard.js",["732","733"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections-cards/CollectionsCard.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/hero/component/slider.js",["734","735","736","737","738","739"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",["740","741"],"import React from 'react';\nimport { Card } from 'react-bootstrap';\nimport AvatarImg from '../../assets/images/seller-avatar.png';\nimport ThreeDots from '../../assets/images/threeDots.svg';\nimport ArrowUp from '../../assets/images/arrowUp.png';\nimport Bucket from '../../assets/images/bucket.png';\nimport './HeroCards.css';\nimport { Images } from '../../assets/assets';\n\nconst HeroCards = ({\n  CardImg,\n  NftName,\n  OwnerName,\n  HighestBid,\n  BidsProfile,\n  TotalBids,\n}) => {\n  return (\n    <Card className='auction-card hero-card mx-2'>\n      <div className='auction-img-wrapper'>\n        <Card.Img variant='top' src={CardImg} alt='AuctionTopImg' />\n      </div>\n      <Card.Body className='d-flex flex-column'>\n        <div className='hero-card-title-container d-flex align-items-center justify-content-between'>\n          <Card.Title>{NftName}</Card.Title>\n          <div className='options-icon'>\n            <img src={ThreeDots} alt='OptionsIcon' />\n          </div>\n        </div>\n        <div className='auction-card-avatar d-flex align-items-center mb-4'>\n          {BidsProfile &&\n            BidsProfile.length > 0 &&\n            BidsProfile.map((item, i) => {\n              if (i <= 2) {\n                return (\n                  <img\n                    src={item === null ? Images.profilePic : item}\n                    alt='AvatarImg'\n                  />\n                );\n              }\n            })}\n          <span className='ms-4'>\n            {TotalBids > 0 ? TotalBids + '+ People Place Bid' : 'No Bid Found'}\n          </span>\n        </div>\n\n        <div className='auction-card-owner-container d-flex justify-content-between align-items-center mb-2'>\n          <div className='auction-owner-name'>\n            <p>\n              {'Owned by '}\n              {OwnerName && OwnerName.length > 8\n                ? OwnerName.substring(0, 6) + '...'\n                : OwnerName}\n            </p>\n          </div>\n          <div className='d-flex align-items-center'>\n            <img src={ArrowUp} alt='' className='me-1' />\n            <span>{HighestBid}</span>\n          </div>\n        </div>\n        <button className='auction-bit-btn d-flex align-items-center justify-content-center'>\n          <img src={Bucket} alt='' className='me-1' />\n          <p>Place a Bid</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default HeroCards;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["742","743"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <label\n      className=\"w-100\"\n      onDrop={(e) => onDrop(e)}\n      onDragOver={(e) => dragOver(e)}\n      onDragEnter={(e) => dragEnter(e)}\n      onDragLeave={(e) => dragLeave(e)}\n    >\n      <div className=\"upload-image-border p-4 position-relative\">\n        {imageURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose\n              color=\"#e33d0bc2\"\n              className=\"uploaded-cross-icon\"\n              onClick={() => clearData()}\n            />\n            <img className=\"upload-image\" src={imageURL} alt=\"upload-image\" />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : videoURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <VideoComponent\n              videoUrl={videoURL}\n              videoStyles={videoStyles}\n              videoWidth=\"300\"\n            />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n          </div>\n        ) : audioSrc ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <AudioPlayer audioSrc={audioSrc} />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : (\n          <>\n            {\" \"}\n            <img\n              className=\"upload-image-place-holder\"\n              src={Images.uploadImage}\n              alt=\"upload-image\"\n            />\n            <div className=\"upload-details text-center mt-2\">\n              <p>Drag and drop your file</p>\n              <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n            </div>\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={(e) => onFileChange(e, \"onChange\")}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </>\n        )}\n      </div>\n    </label>\n  );\n};\n\nexport default Upload;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/PropertiesModal.js",["744","745"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\n\nconst PropertiesModal = (props) => {\n  const { show, onHide } = props;\n  const [numbOfInp, setNumbOfInp] = useState(1);\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Add Properties\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row g-2 align-items-center justify-content-between\">\n          <div className=\"col-sm-5 order-1 order-sm-0\">\n            <div className=\"bid-inp-container d-flex align-items-center\">\n              <div className=\"ps-2\">\n                <h6>Type:</h6>\n              </div>\n              <div className=\"inp-container\">\n                <input type=\"text\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"col-sm-5 order-2 order-sm-1\">\n            <div className=\"bid-inp-container d-flex align-items-center\">\n              <div className=\"ps-2\">\n                <h6>Name:</h6>\n              </div>\n              <div className=\"inp-container\">\n                <input type=\"text\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"col-sm-1 order-0 order-sm-2\">\n            <div className=\"inp-close text-end\">\n              <button>\n                <img src={InputClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button className=\"btn btn-linear-gradient mt-2\">Add more</button>\n          <button className=\"btn btn-linear-gradient mt-2 ms-3\">Save</button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default PropertiesModal;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/LevelsModal.js",["746","747"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\n\nconst LevelsModal = (props) => {\n  const { show, onHide } = props;\n  const [numbOfInp, setNumbOfInp] = useState(1);\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Levels</Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row g-2 align-items-center justify-content-between\">\n          <div className=\"col-sm-5 order-1 order-sm-0\">\n            <div className=\"bid-inp-container d-flex align-items-center\">\n              <div className=\"ps-2\">\n                <h6>Name:</h6>\n              </div>\n              <div className=\"inp-container\">\n                <input type=\"text\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"col-sm-5 order-2 order-sm-1\">\n            <div className=\"bid-inp-container d-flex align-items-center\">\n              <div className=\"ps-2\">\n                <h6>Value:</h6>\n              </div>\n              <div className=\"inp-container\">\n                <input type=\"number\" />\n              </div>\n              <div className=\"w-100 d-flex align-items-center justify-content-between pe-3 pe-sm-4 pe-md-5\">\n                <h6>of</h6>\n                <h6>5</h6>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-sm-1 order-0 order-sm-2\">\n            <div className=\"inp-close text-end\">\n              <button>\n                <img src={InputClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button className=\"btn btn-linear-gradient mt-2\">Add more</button>\n          <button className=\"btn btn-linear-gradient mt-2 ms-3\">Save</button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default LevelsModal;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/StatsModal.js",["748","749"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\n\nconst StatsModal = (props) => {\n  const { show, onHide } = props;\n  const [numbOfInp, setNumbOfInp] = useState(1);\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contai