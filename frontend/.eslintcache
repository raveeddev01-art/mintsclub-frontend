ssages":"330","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"331","usedDeprecatedRules":"184"},{"filePath":"332","messages":"333","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"334","usedDeprecatedRules":"184"},{"filePath":"335","messages":"336","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"337","messages":"338","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"339","usedDeprecatedRules":"184"},{"filePath":"340","messages":"341","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"342","usedDeprecatedRules":"184"},{"filePath":"343","messages":"344","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"345","usedDeprecatedRules":"184"},{"filePath":"346","messages":"347","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"348","messages":"349","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"350","messages":"351","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"352","usedDeprecatedRules":"184"},{"filePath":"353","messages":"354","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"355","messages":"356","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"357","usedDeprecatedRules":"184"},{"filePath":"358","messages":"359","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"360","messages":"361","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"362","messages":"363","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"364","messages":"365","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"366","messages":"367","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"368","messages":"369","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"370","messages":"371","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"372","messages":"373","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"374","messages":"375","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"376","messages":"377","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"378","messages":"379","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"380","messages":"381","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"382","usedDeprecatedRules":"184"},{"filePath":"383","messages":"384","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"385","usedDeprecatedRules":"184"},{"filePath":"386","messages":"387","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"388","messages":"389","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"184"},{"filePath":"390","messages":"391","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"392","usedDeprecatedRules":"184"},{"filePath":"393","messages":"394","errorCount":0,"fatalErrorCount":0,"warningCount":11,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/index.js",[],["397","398"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/App.js",["399","400","401"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/store.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/serviceWorker.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/routes.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/privateRoute.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/config/config.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/web3.js",["402"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\n\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\n\nexport const validateNetwork = async () => {\n  let prevNetwork = await getNetworkNameByChainId();\n\n  if (prevNetwork === \"Ethereum Rinkby\") {\n    return true;\n  } else {\n    return false;\n  }\n};\nexport const getBalance = async () => {\n  let web3 = await getWeb3();\n  let address = await getWalletAddress();\n  let balance = await web3.eth.getBalance(address);\n  let ethBalance = web3.utils.fromWei(balance, \"ether\");\n\n  return ethBalance;\n};\n\nexport const mintNFt = async (metaData, id, amount, recipientValue) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, metaData)\n      .send({ from: connectedAddress, gassPrice: 5000000 });\n\n    return result;\n  } catch (err) {\n    console.log(err, \"error while minting\");\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\n\nexport const openNFTForBidding = async (\n  biddingTime,\n  startTime,\n  tokenId,\n  copies\n) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id = Number(tokenId);\n    console.log(biddingTime,startTime)\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id, copies)\n      .send({ from: connectedAddress });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"open for bid error\");\n    throw new Error(err);\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const bidAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n    // let bidAmount = Number(amount) * 1000000000000000000;\n\n    let id = Number(tokenId);\n\n    const result = await contractM.methods\n      .bid(id)\n      .send({ from: connectedAddress, value: bidAmount, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\n\nexport const putonsale = async (tokenId, amount, price) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let weiAmount = BigInt(Web3.utils.toWei(price, \"ether\"));\n\n    let id = Number(tokenId);\n    console.log(id, amount, weiAmount);\n    const result = await contractM.methods\n      .putonsale(id, amount, weiAmount)\n      .send({ from: connectedAddress, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const BuyFixedPriceNFT = async (\n  amount,\n  tokenId,\n  setConfirmed,\n  setTransactionHash\n) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n\n    const weiAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n\n    const result = await contractM.methods\n      .BuyFixedPriceNFT(tokenId)\n      .send({ from: connectedAddress, value: weiAmount, gas: 5000000 })\n      .on(\"transactionHash\", function (hash) {\n        setTransactionHash(hash);\n        setConfirmed(true);\n      })\n      .on(\"confirmation\", function (confirmationNumber, receipt) {});\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    setConfirmed(false);\n    console.log(err);\n\n    throw new Error(err);\n  }\n};\nexport const setApprovalForAll = async (setApprovalStatus) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const result = await contractM.methods\n      .setApprovalForAll(ENV.mintsClubContractAddress, true)\n      .send({\n        from: connectedAddress,\n      })\n      .on(\"transactionHash\", function (hash) {\n        // setTransactionHash(hash);\n        setApprovalStatus(\"in-progress\");\n      });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const endAuction=async (tokenId)=>{\n\n  try{\n    let connectedAddress=await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.auctionEnd(tokenId)\n    .send({\n      from: connectedAddress,\n      gassPrice: 5000000\n    })\n    if (result) {\n      console.log(result,\"result\")\n      return result;\n    }\n  }catch(err){\n    console.log(err,\"error\")\n    throw new Error(err);\n  }\n\n}\n\nexport const getMetamaskConnectedAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        // toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      // toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const mint = async () => {\n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n  } catch (e) {}\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = () => {};\n\nexport const createNft = async () => {};\n\nexport const setNftToken = (body) => {\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n  alert(\"calling\");\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        window.location.href = \"/explore-all\";\n      } else {\n      }\n    })\n    .catch((error) => {\n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {};\n\nexport const placeBidNft = async () => {};\n\nexport const SellOnFixedPrice = async () => {};\n\nexport const BuyFixedPriceNFTs = async () => {};\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async () => {};\nexport const signTransaction = async () => {};\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/index.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/full-page-loader/full-page-loader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.js",["403","404","405","406"],"import React, { useEffect } from \"react\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller\";\nimport { connect } from \"react-redux\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n      <Hero />\n\n      <Auctions />\n\n      <TopSeller viewAll={\"View All\"} />\n\n      <PopularCollections />\n\n      <Buysell />\n      <OwnCollectionToday />\n    </>\n  );\n}\n\nexport default Home;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/popular-collections-list/popular-collections-list.js",["407","408","409","410","411","412","413","414"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [popular, setpopular] = useState([]);\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"all\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getPopularCollections(null, 1);\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      const pagination = props.popularCollections.pagination;\n\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.finalCollectionListing) {\n        let finalCollectionListing = finalCollectionListing.filter(\n          (item) => item.userId === userId\n        );\n        setpopular(finalCollectionListing);\n      } else {\n        if (finalCollectionListing === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setpopular(finalCollectionListing);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.getPopularAuth]);\n\n  const getPopularCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getPopularCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getPopularCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getPopularCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setCategoryId(category);\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getPopularCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n  const bannerData = {\n    subHeading: \"Collections\",\n    heading: \"Popular Collections\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          {\" \"}\n          <Banner\n            subHeading={bannerData.subHeading}\n            heading={bannerData.heading}\n            content={bannerData.content}\n            bgImg={BannerBg}\n            bannerImg={BannerImage}\n          />\n          <section className=\"explore-collection-section padding-wrapper\">\n            <div className=\"container\">\n              <div className=\"row mb-5\">\n                <div className=\"col-12\">\n                  {/* Intro */}\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Most Popular</span>\n                      <h3 className=\"mb-0\">Popular Collections</h3>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 explore-collection-nav\">\n                  <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                    {categoryId === \"all\" &&\n                    popular &&\n                    popular?.length == 0 &&\n                    !loader\n                      ? \"\"\n                      : categories &&\n                        categories.length > 0 &&\n                        categories.map((item) => {\n                          return (\n                            <button\n                              onClick={() => {\n                                setIsActive(item.name);\n                                setSelectedCategory(item.description);\n                                handleFilterCategory(item.description);\n                              }}\n                              className={`${\n                                item.name === isActive\n                                  ? \"active-explore-nav\"\n                                  : \"\"\n                              } me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          );\n                        })}\n                  </div>\n                  <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                    {categoryId === \"all\" &&\n                    popular &&\n                    popular?.length == 0 &&\n                    !loader\n                      ? \"\"\n                      : categories &&\n                        categories.length > 0 &&\n                        categories.map((item) => {\n                          return (\n                            <div className=\"col-6 col-sm-3\">\n                              <button\n                                onClick={() => {\n                                  setIsActive(item.name);\n                                  setSelectedCategory(item.description);\n                                  handleFilterCategory(item.description);\n                                }}\n                                className={\n                                  isActive === item.name\n                                    ? \"active-explore-nav\"\n                                    : \"\"\n                                }\n                              >\n                                {item.name}\n                              </button>\n                            </div>\n                          );\n                        })}\n                  </div>\n                </div>\n              </div>\n              <div className=\"row g-4 align-items-center justify-content-center\">\n                {loader ? (\n                  <div class=\"spinner-border\" role=\"status\">\n                    <span class=\"sr-only\">Loading...</span>\n                  </div>\n                ) : popular && popular.length > 0 ? (\n                  popular.map((item) => {\n                    return (\n                      <div className=\"col-sm-6 col-lg-4\">\n                        <CollectionsCard\n                          CardImg={item.featuredImg}\n                          Subimg1={handleImage(item, 0)}\n                          Subimg2={handleImage(item, 1)}\n                          Subimg3={handleImage(item, 2)}\n                          name={item.name}\n                          id={item._id}\n                          collection={item}\n                          userName={item.username[0]}\n                          NFTCount={item.totalNfts}\n                          profileImage={item.profileImage[0]}\n                        />\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center  not-found-title mt-5\">\n                    No popular collections Found\n                  </p>\n                )}\n\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {!empty &&\n                      popular?.length === 10 &&\n                      pagination.totalRecords > popular.length && (\n                        <button\n                          className=\"btn btn-linear-gradient px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n        </>\n      )}\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforePopularCollection,\n    getPopularCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collection-details/collectiondetails.js",["415","416","417","418","419","420","421","422","423","424","425","426"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/explore-collections.js",["427","428","429","430"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/not-found/not-found.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user-profile/UserProfile.js",["431","432","433","434","435","436","437","438","439","440"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user-profile/user-edit-profile.js",["441","442","443","444","445","446","447","448","449","450","451","452","453","454","455","456","457","458","459","460","461"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/top-seller/topsellerlist.js",["462","463","464"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card top-seller-card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/creat-collections/CreateCollections.js",["465","466","467","468","469","470","471","472","473","474"],"import React, { Component } from \"react\";\nimport Footer from \"../footer/footer\";\nimport \"./CreateCollections.css\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport Select from \"react-select\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        logoUrl: \"\",\n        bannerUrl: \"\",\n        featuredImgUrl: \"\",\n        description: \"\",\n      },\n      categories: null,\n      selectedCategory: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate(prevProps) {\n    if (this.props.error !== null && prevProps.error === null) {\n      toast.error(this.props.error.message);\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      let updatedCategories = [];\n      for (var item of categories) {\n        let obj = {\n          value: item._id,\n          label: item.name,\n        };\n        updatedCategories.push(obj);\n      }\n      this.setState({ categories: updatedCategories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  handleSelectChange = (selectedOption) => {\n    console.log(selectedOption, \"selected \");\n    let { collection } = this.state;\n    collection = { ...collection, categoryId: selectedOption.value };\n    this.setState({\n      selectedOption,\n      collection,\n    });\n  };\n  handleValidation = () => {\n    console.log(\"func\");\n    const { categoryId, logo, name, description, featuredImg } =\n      this.state.collection;\n    console.log(this.state.collection, \"collection\");\n    if (\n      description === \"\" ||\n      logo === \"\" ||\n      categoryId === \"\" ||\n      name === \"\" ||\n      featuredImg === \"\"\n    ) {\n      return true;\n    } else {\n      return false;\n    }\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: \"\", featuredImgUrl: \"\" };\n    this.setState({ collection });\n  };\n\n  render() {\n    const {\n      collection,\n      errors,\n      loader,\n      isSubmitted,\n      categories,\n      selectedOption,\n    } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      const bannerData = {\n        subHeading: \"Create New\",\n        heading: \"Create New Collection\",\n        content:\n          \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n      };\n      return (\n        <>\n          {loader && <FullPageLoader />}\n          <section className=\"create-collection\">\n            <Banner\n              subHeading={bannerData.subHeading}\n              heading={bannerData.heading}\n              content={bannerData.content}\n              bgImg={BannerBg}\n              bannerImg={BannerImage}\n            />\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"upload-container flex-md-row flex-column align-items-center align-items-md-end ps-md-5 ps-0\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {collection && collection.logo ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={collection.logoUrl}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => this.onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => this.onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">Logo Image*</p>\n                  </div>\n                  <div className=\"feature-wrapper pt-md-0 pt-5\">\n                    <div className=\"feature-image\">\n                      <span className=\"feature-img-round\">\n                        {collection && collection.featuredImg ? (\n                          <img\n                            className=\"uploaded-feature-img\"\n                            src={collection.featuredImgUrl}\n                          />\n                        ) : (\n                          <label className=\"upload-icon\">\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                            <img src={Images.featureImageInputBG} />\n                            <div className=\"feature-img-round-info\">\n                              <p className=\"text-center mb-2 browse-file\">\n                                Browse Files\n                              </p>\n                              {/* <p className=\"mb-0\">PNG, GIF, WEBP, MP4, MP3 </p> */}\n                              <p className=\"text-center mb-0\">Max 100mb</p>\n                            </div>\n                          </label>\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-feature-icon\">\n                      <label>\n                        <input\n                          id=\"featuredImg\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          style={{ display: \"none\" }}\n                          name=\"featuredImg\"\n                          onChange={(e) => this.onFileChange(e)}\n                        />\n                        <img src={Images.editIconLarge} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2 text-center text-md-start\">\n                      Feature Image*\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Name:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.name}\n                    placeholder=\"Name\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">URL:</label>\n                  <span className=\"text-danger position-absolute top-0\">\n                    {this.validator.message(\"url\", collection.url, \"url\")}\n                  </span>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"URL\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.url}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Select Category:*\n                  </label>\n\n                  <Select\n                    className=\"react-select-cls\"\n                    classNamePrefix=\"react-select\"\n                    value={selectedOption}\n                    isSearchable={false}\n                    onChange={this.handleSelectChange}\n                    options={categories}\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Description:*\n                  </label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Description\"\n                    maxLength=\"500\"\n                    rows=\"3\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.description}\n                  ></textarea>\n                </div>\n\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    disabled={this.handleValidation()}\n                    onClick={(e) => this.submit(e)}\n                  >\n                    Create Collection\n                  </button>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n\n          {/* <section className=\"edit-profile padding-wrapper create-collection-container\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Create Now</span>\n                      <h3 className=\"mb-0\">Create New Collection</h3>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Logo Image*</h6>\n                    <span className=\"text-danger\">\n                      {this.validator.message(\n                        \"logo\",\n                        collection.logo,\n                        \"required\"\n                      )}\n                    </span>\n                  </div>\n                  <div className=\"collection-logo-container pt-2\">\n                    {collection && collection.logo ? (\n                      <img\n                        src={collection.logoUrl}\n                        className=\"colection-avatar-img\"\n                      />\n                    ) : (\n                      <div className=\"colection-avatar\"></div>\n                    )}\n                    <label>\n                      <div className=\"avatar-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        id=\"logo\"\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => this.onFileChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"logo\"\n                      />\n                    </label>\n                  </div>\n                  <div className=\"\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Featured Image*</h6>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"logo\",\n                          collection.featuredImg,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-featured-container\">\n                      {collection && collection.featuredImg ? (\n                        <div className=\"uploaded-featured-container\">\n                          <img\n                            src={collection.featuredImgUrl}\n                            className=\"uploaded-featured-img\"\n                          />\n                          <div className=\"uploaded-featured-hover w-100\">\n                            <div className=\"uploaded-featured-cross\">\n                              <MdClose\n                                color=\"#e33d0bc2\"\n                                className=\"uploaded-cross-icon\"\n                                onClick={() => this.clearData()}\n                              />\n                            </div>\n                            <label>\n                              <div className=\"text-center\">\n                                <img src={UploadIcon} alt=\"upload-icon\" />\n                              </div>\n                              <input\n                                id=\"featuredImg\"\n                                type=\"file\"\n                                accept=\".png,.jpeg,.jpg\"\n                                style={{ display: \"none\" }}\n                                name=\"featuredImg\"\n                                onChange={(e) => this.onFileChange(e)}\n                              />\n                            </label>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className=\"upload-featured-img\">\n                          <label>\n                            <div className=\"text-center\">\n                              <img\n                                src={CollectionUploadIcon}\n                                alt=\"upload-icon\"\n                              />\n                            </div>\n                            <div className=\"upload-featured-img-content pt-2\">\n                              <h6 className=\"pb-1\">Browse Files</h6>\n                              <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                            </div>\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                          </label>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Name*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"name\",\n                            collection.name,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"name\"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.name}\n                          placeholder=\"Name\"\n                          maxLength=\"55\"\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>URL</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\"url\", collection.url, \"url\")}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"url\"\n                          type=\"text\"\n                          name=\"url\"\n                          placeholder=\"URL\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.url}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Select Category*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"category\",\n                            collection.categoryId,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <select\n                          id=\"category\"\n                          name=\"categoryId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Select Collection\n                          </option>\n                          {categories &&\n                            categories.map((category, index) => {\n                              return (\n                                <option key={index} value={category._id}>\n                                  {category.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                      </div>\n                    </div>\n                    <div className=\"col-md-8\">\n                      <div className=\"edit-inp-subheading pt-4\">\n                        <h6>Discription</h6>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <textarea\n                          name=\"description\"\n                          placeholder=\"Discription\"\n                          maxLength=\"500\"\n                          rows=\"3\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.description}\n                          \n                        ></textarea>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                  <div className=\"\">\n                    <button\n                      type=\"button\"\n                      className=\"btn btn-linear-gradient\"\n                      onClick={(e) => this.submit(e)}\n                    >\n                      Create Collection\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section> */}\n          {/* <Footer /> */}\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nft-detail/nftdetail.js",["475","476","477","478","479","480","481","482","483","484","485","486","487","488","489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504","505","506","507","508","509","510","511","512","513","514","515","516","517","518","519"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/home-auction-list.js",["520","521","522","523","524","525","526"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { connect } from \"react-redux\";\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\nimport { getCreators } from \"./../user/user.action\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst AuctionsList = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [auctions, setAuctions] = useState(null);\n  const [loader, setLoader] = useState(true); // auctions loader\n  const [categories, setCategories] = useState([]);\n  const [categoryId, setCategoryId] = useState(\"all\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    // get live auctions\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n    props.getCreators();\n  }, []);\n\n  // set live auctions\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions } = props.auction;\n\n      setAuctions(auctions);\n      setLoader(false);\n      props.beforeAuction();\n    }\n  }, [props.auction.auctionsAuth]);\n  useEffect(() => {\n    props.getCategories();\n  }, []);\n  useEffect(() => {\n    if (props.collectionFlag) {\n      setCategories(props.categories);\n    }\n  }, [props.collectionFlag]);\n\n  const handleCategoryFilter = (desc) => {\n    setLoader(true);\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getLiveAuctions(qs);\n  };\n  const bannerData = {\n    subHeading: \"Auctions\",\n    heading: \"Live Auctions\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <section className=\"explore-collection-section padding-wrapper\">\n        {\n          // loader ? (\n          //   <FullPageLoader />\n          // ) : (\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Auctions</span>\n                    <h3 className=\"mb-0\">Live Auctions</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <div className=\"col-6 col-sm-3\">\n                            <button\n                              onClick={() => {\n                                setIsActive(id);\n                                handleCategoryFilter(item.description);\n                              }}\n                              className={`${\n                                id === isActive ? \"active-explore-nav\" : \"\"\n                              } me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          </div>\n                        );\n                      })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border\" role=\"status\"></div>\n              ) : auctions && auctions.length > 0 ? (\n                auctions.map((item, index) => {\n                  return (\n                    <div className=\"col-11 col-sm-6 col-md-5 col-lg-4 col-xl-3\">\n                      <AuctionsCards\n                        key={index}\n                        item={item}\n                        ownerName={item.owner.username}\n                        userId={ENV.getUserKeys(\"_id\")._id}\n                        ownerId={item.owner._id}\n                        bidsProfile={item.bidInfo.bidByProfile}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center mt-5\">No Live Auctions Found</p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {auctions &&\n                    props.auction.pagination.total > auctions.length &&\n                    auctions.length > 10 && (\n                      <button className=\"btn btn-linear-gradient px-5\">\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        }\n        <OwnCollectionToday />\n      </section>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  auction: state.auction,\n  user: state.user,\n  collectionFlag: state.collection.collectionFlag,\n  categories: state.collection.categories,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n  getCreators,\n  getCategories,\n  beforeCategory,\n})(AuctionsList);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/sell-nft/SellNFT.js",["527","528","529","530","531","532","533","534","535","536","537","538","539","540","541","542","543","544","545","546","547","548","549","550","551","552","553","554","555","556","557","558","559","560","561"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.js",["562","563","564","565","566","567","568","569","570"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.reducer.js",["571","572"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.reducer.js",["573"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/auctions.reducer.js",["574"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/signup/signup.js",["575","576","577","578","579","580","581"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/create-nft.js",["582","583","584","585","586","587"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/collections.reducer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/explore.reducer.js",["588"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/all-nft/allnft.js",["589","590","591","592","593","594","595","596","597","598"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout4/layout4.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/reducer/reducer.js",["599"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nfts/nfts.reducer.js",["600"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/categories/categories.reducer.js",["601"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user/user.reducer.js",["602"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/offers/offers.reducer.js",["603"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/bids/bids.reducer.js",["604"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/shared/error/error.reducer.js",["605"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout3/layout3.jsx",["606","607"],"import React, { Component } from \"react\";\nimport Footer from \"../../components/footer/footer\";\n\nimport Scrollup from \"../../components/scroll-up/sroll-up\";\n\nclass Layout3 extends Component {\n  render() {\n    return <div className=\"main\">{this.props.children}</div>;\n  }\n}\n\nexport default Layout3;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/assets/assets.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/top-seller/topseller.js",["608","609","610"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/home-auctions.js",["611","612","613","614","615","616","617"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\n\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\n\r\nimport { getCreators } from \"./../user/user.action\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  // const [creators, setCreator] = useState([]);\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"all\");\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  const [isActive, setIsActive] = useState(0);\r\n  const [filterationLoader,setFilterationLoader]=useState(true)\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n\r\n\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n      if (auctions) {\r\n        auctions.forEach((element, i) => {\r\n          auctions[i].totalBids = element.bidInfo?.bidBy?.length;\r\n        });\r\n      }\r\n\r\n      setAuctions(auctions);\r\n      setFilterationLoader(false)\r\n\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setFilterationLoader(true)\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-md-8\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content clr-yellow\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products.{\" \"}\r\n                    <br className=\"d-none d-xl-block\" />\r\n                    We want to be a part of your smile, success and future\r\n                    growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\r\n              {categoryId === \"all\" && (!auctions || (auctions&&auctions?.length <= 1)) &&!filterationLoader? (\r\n                \"\"\r\n              ) : (\r\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                  {categories &&\r\n                    categories.length > 0 &&\r\n                    categories.map((item, id) => {\r\n                      if (id <= 3) {\r\n                        return (\r\n                          <button\r\n                            key={id}\r\n                            className={`${\r\n                              id === isActive ? \"home-active-category\" : \"\"\r\n                            } me-1 me-sm-3 me-lg-4`}\r\n                            onClick={() => {\r\n                              setIsActive(id);\r\n                              handleCategoryFilter(item.description);\r\n                            }}\r\n                          >\r\n                            {item.name}\r\n                          </button>\r\n                        );\r\n                      }\r\n                    })}\r\n                  <div className=\"intro-btn\">\r\n                    <Link\r\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                      to=\"/auctions\"\r\n                    >\r\n                      View All\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auctions-slides\">\r\n            <div className=\"\">\r\n              {filterationLoader ? (\r\n                <div className=\"text-center\">\r\n                  <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                    <span className=\"sr-only\">Loading...</span>\r\n                  </div>\r\n                </div>\r\n              ) : auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item, index) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        cardBg={\"card-bg-gray\"}\r\n                        key={index}\r\n                        item={item}\r\n                        ownerName={item.owner.username}\r\n                        userId={ENV.getUserKeys(\"_id\")._id}\r\n                        ownerId={item.owner._id}\r\n                        bidsProfile={item.bidInfo.bidByProfile}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className=\"text-center\">No Live Auctions Found</p>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/popular-collections.js",["618","619","620","621","622","623","624","625","626","627"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\n\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n} from \"../collections/collections.actions\";\nimport { connect } from \"react-redux\";\nimport { CollectionImages } from \"../../assets/assets.js\";\nimport { Images } from \"../../assets/assets\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst PopularCollections = (props) => {\n  const [popular, setpopular] = useState([]);\n  const [categories, setCategories] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [popularSettings, settPopularSettings] = useState();\n  const [isActive, setIsActive] = useState(0);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.category.getAuth) {\n      setCategories(props.category.categories);\n    }\n  }, [props.category.getAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n      let popularCollectionsSettings = ENV.popularCollectionsSettings;\n      if (finalCollectionListing.length > 3) {\n        popularCollectionsSettings.infinite = true;\n      } else {\n        popularCollectionsSettings.infinite = false;\n      }\n      settPopularSettings(popularCollectionsSettings);\n      setpopular(finalCollectionListing);\n      setFilterationLoader(false);\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  const handleCategoryFilter = (desc) => {\n    setFilterationLoader(true);\n    props.beforePopularCollection();\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getPopularCollections(qs);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-md-8\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content clr-yellow\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-1\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products.{\" \"}\n                    <br className=\"d-none d-xl-block\" /> We want to be a part of\n                    your smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\n              {categoryId === \"all\" && popular && popular?.length == 0 ? (\n                \"\"\n              ) : (\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      if (id <= 3) {\n                        return (\n                          <button\n                            key={id}\n                            className={`collection-category ${\n                              id === isActive ? \"home-active-category\" : \"\"\n                            } me-1 me-sm-3 me-lg-4`}\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      }\n                    })}\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\n                      to=\"/popular-collections\"\n                    >\n                      View All\n                      <img\n                        src={ViewAllIcon}\n                        alt=\"arrow-left\"\n                        className=\"ms-2 d-none d-sm-none\"\n                      />\n                    </Link>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n          {filterationLoader ? (\n            <div className=\"text-center\">\n              <div className=\"spinner-border text-secondary\" role=\"status\">\n                <span className=\"sr-only\">Loading...</span>\n              </div>\n            </div>\n          ) : popular && popular.length && popular.length > 0 ? (\n            <CardSlider\n              settings={ENV.popularCollectionsSettings}\n              data={popular}\n              homeAuction\n            >\n              {popular.map((item, i) => {\n                if (i < 8) {\n                  return (\n                    <CollectionsCard\n                      key={i}\n                      Subimg1={handleImage(item, 0)}\n                      Subimg2={handleImage(item, 1)}\n                      Subimg3={handleImage(item, 2)}\n                      collection={item}\n                      CardImg={item.featuredImg}\n                      name={item.name}\n                      id={item._id}\n                      userName={item.username[0]}\n                      NFTCount={item.totalNfts}\n                      profileImage={item.profileImage[0]}\n                    />\n                  );\n                }\n              })}\n            </CardSlider>\n          ) : (\n            <p className=\"text-center not-found-title mt-5\">\n              No popular collections Found\n            </p>\n          )}\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(mapStateToProps, {\n  beforePopularCollection,\n  beforeCategory,\n  getCategories,\n  getPopularCollections,\n})(PopularCollections);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/collections.actions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/types.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/shared/error/error.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nfts/nfts.action.js",["628","629","630","631","632"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/functions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/navbar-main/NavbarMain.js",["633","634","635","636"],"import React, { useState } from \"react\";\nimport { Link, useHistory, useLocation, NavLink } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport { ReactComponent as SearchIcon } from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [activeTab, setActiveTab] = React.useState(null);\n  const [searchactive, setSearchActive] = useState(false);\n  const [searchValue, setSearchValue] = useState(\"\");\n  const history = useHistory();\n  const location = useLocation();\n\n  const handleChange = (e) => {\n    setSearchValue(e.target.value);\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword = () => {\n    if (searchValue !== \"\" && searchValue.length >= 3) {\n      history.push({\n        pathname: \"/explore/allNFT\",\n        state: searchValue,\n      });\n    }\n  };\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n\n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"light\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <NavLink to=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </NavLink>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className={\"mx-xl-auto\"}>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/\">Home</NavLink>\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/exploreAll\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Explore All\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/allNFT\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    All NFT\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/create\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Create NFT\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/createcollection\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Create Collection\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/userprofile\" className=\"nav-main-link\">\n                  Profile\n                </NavLink>\n              </Nav.Link>\n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={() => handleSearchKeyword()}\n                >\n                  <SearchIcon className=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={() => handleSearchKeyword()}\n              >\n                <SearchIcon className=\"search-icon\" />\n              </button>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient btn-login\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/hero/hero.js",["637","638","639","640"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/buy-sell/Buysell.js",["641","642"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\nimport BuyIcon from \"../../assets/images/buy-icon.svg\";\nimport SellIcon from \"../../assets/images/sell-icon.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./Buysell.css\";\n\nconst Buysell = () => {\n  return (\n    <section className=\"buy-sell-section padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row \">\n          <div className=\"col-sm-6\">\n            <div className=\"buy-card d-md-flex align-items-center\">\n              <div className=\"buy-card-img d-flex\">\n                <img src={Images.buyNft} alt=\"buy-logo\" className=\"mx-auto\" />\n              </div>\n              <div className=\"buy-card-content\">\n                <h5>Buy NFT Products</h5>\n                <p>Purchase digital NFT products from the biggest directory.</p>\n                <div className=\"d-flex justify-content-lg-end justify-content-center\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-start-selling text-right\"\n                    to=\"/explore/allNFT\"\n                  >\n                    Start buying\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-sm-6\">\n            <div className=\"sell-card d-md-flex align-items-center\">\n              <div className=\"buy-card-img d-flex\">\n                <img src={Images.sellNft} alt=\"buy-logo\" className=\"mx-auto\" />\n              </div>\n              <div className=\"buy-card-content \">\n                <h5>Sell Your NFT Products</h5>\n                <p>Sell one of your NFT products to make a huge profit.</p>\n                <div className=\"d-flex justify-content-lg-end justify-content-center\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-start-selling\"\n                    to=\"/userprofile\"\n                  >\n                    Start selling\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nexport default Buysell;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/owncollection/OwnCollection.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/footer/footer.js",["643","644","645","646","647","648"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div className=\"input-group notify-form\">\n                  <div className=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections-cards/CollectionsCard.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/statsinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/levelsinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/upload.js",["649","650"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <div className=\"upload-image-border p-4 position-relative\">\n      <div className=\"nft-uploaded-img-container\">\n        {imageURL || videoURL || audioSrc ? (\n          <MdClose\n            color=\"#e33d0bc2\"\n            className=\"uploaded-cross-icon\"\n            onClick={() => clearData()}\n          />\n        ) : (\n          \"\"\n        )}\n        <label\n          className=\"w-100\"\n          onDrop={(e) => onDrop(e)}\n          onDragOver={(e) => dragOver(e)}\n          onDragEnter={(e) => dragEnter(e)}\n          onDragLeave={(e) => dragLeave(e)}\n        >\n          <div className=\"\">\n            {imageURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <img\n                  className=\"upload-image\"\n                  src={imageURL}\n                  alt=\"upload-image\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : videoURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <VideoComponent\n                  videoUrl={videoURL}\n                  videoStyles={videoStyles}\n                  videoWidth=\"300\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : audioSrc ? (\n              <div className=\"nft-uploaded-img-container\">\n                <AudioPlayer audioSrc={audioSrc} />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : (\n              <>\n                {\" \"}\n                <img\n                  className=\"upload-image-place-holder\"\n                  src={Images.uploadImage}\n                  alt=\"upload-image\"\n                />\n                <div className=\"upload-details text-center mt-2\">\n                  <p>Drag and drop your file</p>\n                  <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n                </div>\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={(e) => onFileChange(e, \"onChange\")}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </>\n            )}\n          </div>\n        </label>\n      </div>\n    </div>\n  );\n};\n\nexport default Upload;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/LevelsModal.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/breadcrumb/breadcrumb.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/PropertiesModal.js",["651"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\n\nconst PropertiesModal = (props) => {\n  const {\n    show,\n    onHide,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    properties,\n    onSave,\n  } = props;\n  const handleSubmit = () => {\n    if (properties && properties.length > 0) {\n      let isEmpty = properties.filter(\n        (item) => item.name === \"\" || item.type === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"properties\");\n      }\n    }\n  };\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Add Properties\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {properties.map((item, i) => {\n            return (\n              <div className=\"row g-2 align-items-center justify-content-between mt-3\">\n                <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Type:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"type\"\n                        maxLength=\"40\"\n                        value={item.type}\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Name:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"name\"\n                        maxLength=\"40\"\n                        value={item.name}\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                  <div className=\"inp-close text-end\">\n                    <button onClick={() => removeFormFields(i, \"properties\")}>\n                      <img src={InputClose} alt=\"closemodal\" />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"properties\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={properties && properties.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default PropertiesModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/StatsModal.js",["652"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nconst StatsModal = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {stats &&\n            stats.length > 0 &&\n            stats.map((item, i) => {\n              return (\n                <div\n                  className=\"row g-2 align-items-center justify-content-between mt-3\"\n                  key={i}\n                >\n                  <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                    <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                      <div className=\"ps-2\">\n                        <h6>Name:</h6>\n                      </div>\n                      <div className=\"inp-container\">\n                        <input\n                          type=\"text\"\n                          name=\"name\"\n                          maxLength=\"40\"\n                          value={item.name}\n                          onChange={(e) => handleChange(i, e, \"stats\")}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                    <div className=\"d-flex align-items-center justify-content-between\">\n                      <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                        <div className=\"ps-2\">\n                          <h6>Value:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={item.value}\n                            onChange={(e) => {\n                              console.log(typeof e.target.value);\n                              if (\n                                +e.target.value > 5 ||\n                                e.target.value === \"0\"\n                              ) {\n                                return \"\";\n                              }\n                              handleChange(i, e, \"stats\");\n                            }}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"value-inp-of mx-3\">\n                        <h6>of</h6>\n                      </div>\n                      <div className=\"bid-inp-container modal-value-inp\">\n                        <div className=\"inp-container \">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={5}\n                            autoComplete=\"off\"\n                            className=\"text-center\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                    <div className=\"inp-close text-end\">\n                      <button>\n                        <img\n                          src={InputClose}\n                          alt=\"closemodal\"\n                          onClick={() => removeFormFields(i, \"stats\")}\n                        />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/types/types.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/test-video-card/videoCard.js",["653"],"import React, { useRef } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./videoCard.css\";\nimport useVideoPlayer from \"./components/useVideoPlayer\";\nimport { ENV } from \"../../config/config\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\n\nconst VideoCard = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  likedNfts,\n  ownerId,\n  sellingMethod,\n  userProfile,\n  auctionStartDate,\n  auctionEndDate,\n  copies,\n  remainingCopies,\n  ownerName\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n  const videoElement = useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div className=\"auction-img-wrapper\">\n        <div className=\"card-img-top\">\n          <div className=\"video-wrapper\">\n            <video\n              src={CardImg}\n              ref={videoElement}\n              onTimeUpdate={handleOnTimeUpdate}\n            />\n            <div className=\"controls\">\n              <div className=\"actions\">\n                <button\n                  className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                  onClick={togglePlay}\n                >\n                  {playerState.isPlaying ? (\n                    <BsFillPauseFill />\n                  ) : (\n                    <BsFillPlayFill />\n                  )}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          <div className=\"auction-owner-name\">\n            <p>{copies-remainingCopies} Sold</p>\n          </div>\n          <div className=\"auction-owner-name\">\n            <p>{remainingCopies} Remaining</p>\n          </div>\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owner</p>\n          </div>\n          <div className=\"d-flex align-items-center ps-1\">\n            <span>{ownerName}</span>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default VideoCard;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user/user.action.js",["654","655"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n    console.log(data,\"data\")\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/explore.action.js",["656"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/scroll-up/sroll-up.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/ApprovalModal.js",["657","658"],"import React, { useState, useEffect } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport MetaImg from \"../../assets/images/metamask.png\";\nimport TickImg from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n\n\n  return (\n    <>\n      {approvalStatus === \"in-progress\" || approvalStatus === \"approved\" ? (\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title>\n              {approvalStatus === \"approved\"  ? \"Congratulations\" : \"We’re on it\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\">\n              <button onClick={onHide}>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n            <hr></hr>\n          </Modal.Header>\n          <Modal.Body>\n            <div className=\"approval-container text-center\">\n              {approvalStatus === \"approved\" ? (\n                <div className=\"approval-confirmed\">\n                  <img src={TickImg} alt=\"confirmed\" />\n                </div>\n              ) : (\n                <div className=\"approval-spinner\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n              )}\n\n              <div className=\"approval-status\">\n                {approvalStatus === \"approved\" ? (\n                  <h4>Your Account has been approved</h4>\n                ) : (\n                  <h4>Processing</h4>\n                )}\n              </div>\n              {approvalStatus === \"approved\" ? (\n                \"\"\n              ) : (\n                <div className=\"approval-status-address d-flex align-items-center\">\n                  <p>Wallet Address</p>\n                  <p className=\"ps-4\">\n                    {address.slice(0, 6) + \"...\" + address.slice(-6)}\n                  </p>\n                </div>\n              )}\n            </div>\n          </Modal.Body>\n        </Modal>\n      ) : (\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title>Your account is not approved yet.</Modal.Title>\n            <div className=\"modal-close-container\">\n              <button onClick={onHide}>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n            <hr></hr>\n          </Modal.Header>\n          <Modal.Body>\n            <div className=\"text-center\">\n              <div>\n                <img src={MetaImg} alt=\"metamask\" />\n              </div>\n              <div className=\"modal-nft-status mt-4\">\n                <div className=\"modal-status-subheadings\">\n                  <p> Please approve your Wallet address to reach us </p>\n                </div>\n                <hr></hr>\n                <div className=\"modal-status-address\">\n                  <p>{address}</p>\n                </div>\n              </div>\n            </div>\n          </Modal.Body>\n\n          <Modal.Footer>\n            <button\n              className=\"btn btn-linear-gradient mt-2\"\n              onClick={() => approveAccount()}\n            >\n              {approvalStatus === \"pending\" ? (\n                <div class=\"spinner-border text-white approve-spinner\" role=\"status\"></div>\n              ) : (\n                \"Get Approved\"\n              )}\n            </button>\n          </Modal.Footer>\n        </Modal>\n      )}\n    </>\n  );\n};\nexport default ApprovalModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/filter-component/FilterComponent.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/listing-cards/ListingCards.js",["659"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/auctions.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions-cards/AuctionsCards.js",["660","661","662"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/categories/categories.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/card-slider/CardSlider.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/footer/footer.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/videoComponent/videoComponent.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/hero-cards/HeroCards.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/BidModal.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/BuyModal.js",["663","664","665","666"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/bids/bids.action.js",["667","668"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/offers/offers.action.js",["669"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"data\")\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n   \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n   console.log(data,\"data\")\n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            \n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const buyNow = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}nfts/buyNft`;\nconsole.log(\"sending buy now djfjlkdjsfljsdklf\")\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            \n            dispatch({\n                type: BUY_NOW,\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      \n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout/layout.jsx",[],"/Users/adnanrafique-butt/Des