th":"332","messages":"333","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"334","usedDeprecatedRules":"182"},{"filePath":"335","messages":"336","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"337","usedDeprecatedRules":"182"},{"filePath":"338","messages":"339","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"340","usedDeprecatedRules":"182"},{"filePath":"341","messages":"342","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"343","messages":"344","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"345","messages":"346","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"347","messages":"348","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"349","messages":"350","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"351","usedDeprecatedRules":"182"},{"filePath":"352","messages":"353","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"354","usedDeprecatedRules":"182"},{"filePath":"355","messages":"356","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"357","messages":"358","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"359","messages":"360","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"361","messages":"362","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"363","messages":"364","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"365","messages":"366","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"367","messages":"368","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"369","messages":"370","errorCount":0,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"371","messages":"372","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"373","messages":"374","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"375","messages":"376","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"377","usedDeprecatedRules":"182"},{"filePath":"378","messages":"379","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"380","usedDeprecatedRules":"182"},{"filePath":"381","messages":"382","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"383","messages":"384","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"385","usedDeprecatedRules":"182"},{"filePath":"386","messages":"387","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"388","usedDeprecatedRules":"182"},{"filePath":"389","messages":"390","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"391","messages":"392","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"182"},{"filePath":"393","messages":"394","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/index.js",[],["397","398"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/store.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/App.js",["399","400","401"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\n\nconst App = React.memo((props) => {\n  let walletAddress = false;\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const history = useHistory();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  // ///set Interval\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address) {\n        toast.info(\"Please sign in  with new connected address\");\n        walletAddress = address;\n        // setWalletAddress(address)\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n      // setWalletAddress(address);\n    }\n    // }\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={\n                    ENV.getUserKeys(\"_id\")._id || route.path === \"/login\"||route.path==='Signup' \n                      ? true\n                      : false\n                  }\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nexport default App;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/serviceWorker.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/routes.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/privateRoute.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/index.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/config/config.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/web3.js",["402"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\n\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\n\nexport const validateNetwork = async () => {\n  let prevNetwork = await getNetworkNameByChainId();\n\n  if (prevNetwork === \"Ethereum Rinkby\") {\n    return true;\n  } else {\n    return false;\n  }\n};\nexport const getBalance = async () => {\n  let web3 = await getWeb3();\n  let address = await getWalletAddress();\n  let balance = await web3.eth.getBalance(address);\n  let ethBalance = web3.utils.fromWei(balance, \"ether\");\n\n  return ethBalance;\n};\n\nexport const mintNFt = async (metaData, id, amount, recipientValue) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, metaData)\n      .send({ from: connectedAddress, gassPrice: 5000000 });\n\n    return result;\n  } catch (err) {\n    console.log(err, \"error while minting\");\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\n\nexport const openNFTForBidding = async (\n  biddingTime,\n  startTime,\n  tokenId,\n  copies\n) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id = Number(tokenId);\n    console.log(biddingTime,startTime)\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id, copies)\n      .send({ from: connectedAddress });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"open for bid error\");\n    throw new Error(err);\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const bidAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n    // let bidAmount = Number(amount) * 1000000000000000000;\n\n    let id = Number(tokenId);\n\n    const result = await contractM.methods\n      .bid(id)\n      .send({ from: connectedAddress, value: bidAmount, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\n\nexport const putonsale = async (tokenId, amount, price) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let weiAmount = BigInt(Web3.utils.toWei(price, \"ether\"));\n\n    let id = Number(tokenId);\n    console.log(id, amount, weiAmount);\n    const result = await contractM.methods\n      .putonsale(id, amount, weiAmount)\n      .send({ from: connectedAddress, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const BuyFixedPriceNFT = async (\n  amount,\n  tokenId,\n  setConfirmed,\n  setTransactionHash\n) => {\n  setConfirmed(\"pending\")\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n\n    const weiAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n\n    const result = await contractM.methods\n      .BuyFixedPriceNFT(tokenId)\n      .send({ from: connectedAddress, value: weiAmount, gas: 5000000 })\n      .on(\"transactionHash\", function (hash) {\n        setTransactionHash(hash);\n        setConfirmed(true);\n      })\n      .on(\"confirmation\", function (confirmationNumber, receipt) {});\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    setConfirmed(false);\n    console.log(err);\n\n    throw new Error(err);\n  }\n};\nexport const setApprovalForAll = async (setApprovalStatus) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const result = await contractM.methods\n      .setApprovalForAll(ENV.mintsClubContractAddress, true)\n      .send({\n        from: connectedAddress,\n      })\n      .on(\"transactionHash\", function (hash) {\n        // setTransactionHash(hash);\n        setApprovalStatus(\"in-progress\");\n      });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const endAuction=async (tokenId)=>{\n\n  try{\n    let connectedAddress=await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.auctionEnd(tokenId)\n    .send({\n      from: connectedAddress,\n      gassPrice: 5000000\n    })\n    if (result) {\n      console.log(result,\"result\")\n      return result;\n    }\n  }catch(err){\n    console.log(err,\"error\")\n    throw new Error(err);\n  }\n\n}\n\nexport const getMetamaskConnectedAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        // toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      // toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const mint = async () => {\n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n  } catch (e) {}\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = () => {};\n\nexport const createNft = async () => {};\n\nexport const setNftToken = (body) => {\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n  alert(\"calling\");\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        window.location.href = \"/explore-all\";\n      } else {\n      }\n    })\n    .catch((error) => {\n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {};\n\nexport const placeBidNft = async () => {};\n\nexport const SellOnFixedPrice = async () => {};\n\nexport const BuyFixedPriceNFTs = async () => {};\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async () => {};\nexport const signTransaction = async () => {};\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/full-page-loader/full-page-loader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.reducer.js",["403"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/signup/signup.js",["404","405","406","407","408","409","410","411"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/sell-nft/SellNFT.js",["412","413","414","415","416","417","418","419","420","421","422","423","424","425","426","427","428"],"import React, { useState, useEffect } from \"react\";\nimport \"./SellNFT.css\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport \"bootstrap-daterangepicker/daterangepicker.css\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  getMyLikedNfts,\n  createActivity,\n} from \"../nfts/nfts.action\";\nimport {\n  openNFTForBidding,\n  putonsale,\n  getWalletAddress,\n  setApprovalForAll,\n  validateNetwork,\n  getMetamaskConnectedAddress,\n} from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport axios from \"axios\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { updateProfile } from \"../user/user.action\";\nimport ApprovalModal from \"../modals/ApprovalModal\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst { dateRangeInitialSettings } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\n\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n};\n\nconst SellNFT = (props) => {\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [loader, setLoader] = useState(true); // NFT loader\n  const location = useLocation();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [likedNfts, setLikedNfts] = useState();\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const [copies, setCopies] = useState(\"\");\n  const [show, setShow] = useState(false);\n  const [approvalStatus, setApprovalStatus] = useState(\"not-approved\");\n  const [address, setAddress] = useState(\"\");\n  const [copiesError, setCopiesError] = useState(false);\n  let nftId = props.match.params.id;\n\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  useEffect(async () => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n    let connectedAddress = await getMetamaskConnectedAddress();\n    setAddress(connectedAddress);\n  }, []);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getNFT(nftId);\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n  }, []);\n\n  useEffect(() => {\n    if (props.error !== null) {\n      toast.error(props.error.message);\n      setLoader(false);\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n      validateIfLiked(likedNfts, props.nftDetail);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const { nft } = props.nft.nftsData;\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) {\n      data = fixedPriceConfig;\n    } else {\n      data = timedAuctionConfig;\n    }\n\n    const keys = name.split(\".\");\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) {\n      setFixedPriceConfig({ ...data });\n    } else {\n      setTimedAuctionConfig({ ...data });\n    }\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    if (copies > nftDetail.copies) {\n      if (Number(nftDetail.copies) === 1) {\n        toast.info(`Copies should be equal to ${nftDetail.copies}`);\n      } else {\n        toast.info(\n          `Copies should be less than or equal to ${nftDetail.copies}`\n        );\n      }\n      return \"\";\n    }\n    if (await validateNetwork()) {\n      if (!nftDetail.user.isApproved) {\n        setShow(true);\n        return \"\";\n      }\n\n      let price = \"\";\n      let payload = \"\";\n\n      let timedConfig = { ...timedAuctionConfig };\n\n      let fixedConfig = { ...fixedPriceConfig };\n      const { _id, ownerId } = nftDetail;\n\n      let activityPayload = {\n        nftId: _id,\n        ownerId,\n        fromAddress: await getWalletAddress(),\n        activityType: \"List\",\n      };\n\n      if (sellingMethod === 2) {\n        if (Number(timedConfig.startPrice.amount) === 0) {\n          toast.error(\"Price should be greater then 0\");\n          return \"\";\n        }\n        let timedAuctionStartTime = new Date(timedConfig.duration.startDate);\n        let timedAuctionEndTime = new Date(timedConfig.duration.endDate);\n\n        //calculate end time\n        timedAuctionEndTime = timedAuctionEndTime.toString();\n        timedAuctionEndTime =\n          timedAuctionEndTime.slice(0, 15) +\n          \" \" +\n          timedConfig.duration.endTime +\n          \":00\" +\n          timedAuctionEndTime.slice(24);\n        timedConfig.duration.endDate = timedAuctionEndTime;\n\n        //calculate start time\n        timedAuctionStartTime = timedAuctionStartTime.toString();\n        timedAuctionStartTime =\n          timedAuctionStartTime.slice(0, 15) +\n          \" \" +\n          timedConfig.duration.startTime +\n          \":00\" +\n          timedAuctionStartTime.slice(24);\n        timedConfig.duration.startDate = timedAuctionStartTime;\n\n        //Deleting unused data from payload\n        let auctionConfig = timedConfig;\n        delete auctionConfig.duration.startTime;\n        delete auctionConfig.duration.endTime;\n        delete auctionConfig.method;\n        price = Number(auctionConfig.startPrice.amount);\n        auctionConfig.startPrice.amount = Number(\n          auctionConfig.startPrice.amount\n        );\n\n        payload = {\n          _id: location.state._id,\n          sellingMethod,\n          sellingConfig: JSON.stringify(auctionConfig),\n          copiesForAuction: copies,\n        };\n      } else {\n        price = Number(fixedConfig.price.amount);\n        if (price === 0) {\n          toast.error(\"Price should be greater then 0\");\n          return \"\";\n        }\n        payload = {\n          _id: location.state._id,\n          sellingMethod,\n          sellingConfig: JSON.stringify(fixedConfig),\n          copiesForAuction: copies,\n        };\n      }\n\n      setLoader(true);\n\n      var formData = new FormData();\n      for (const key in payload) formData.append(key, payload[key]);\n      if (sellingMethod === 2) {\n        try {\n          let auctionEndDate = timedAuctionConfig.duration.endDate;\n          let auctionStartDate = timedAuctionConfig.duration.startDate;\n\n          const biddingTime = new Date(auctionEndDate).getTime();\n          const startTime = new Date(auctionStartDate).getTime();\n\n          let result = await openNFTForBidding(\n            biddingTime,\n            startTime,\n            location.state.nftToken,\n            copies\n          );\n          if (result) {\n            activityPayload.price = price;\n\n            props.createActivity(activityPayload);\n            props.upsertNFT(\"edit\", formData, \"PUT\");\n          }\n        } catch (err) {\n          setLoader(false);\n          toast.error(err);\n        }\n      } else {\n        try {\n          let result = await putonsale(\n            nftDetail.nftToken,\n            1,\n            fixedConfig.price.amount\n          );\n\n          if (result) {\n            activityPayload.price = price;\n\n            props.createActivity(activityPayload);\n            props.upsertNFT(\"edit\", formData, \"PUT\");\n          }\n        } catch (err) {\n          setLoader(false);\n          toast.error(err);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const handleLikesTogleApi = (nftId, status) => {\n    if (!likeButtonDisable) {\n      setLikeBtnDisable(true);\n      setToggle(!toggle);\n\n      let userId = ENV.getUserKeys(\"_id\")._id;\n\n      let data = {\n        userId,\n        nftId,\n        count: 1,\n      };\n\n      if ((status === \"dislike\") & (nftDetail.likesCount > 0)) {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount - 1;\n\n        setNftDetail(nft);\n        props.toggleLikeDislike(data);\n      } else {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount + 1;\n\n        setNftDetail(nft);\n\n        props.toggleLikeDislike(data);\n      }\n    }\n  };\n\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      setLoader(false);\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      setLoader(false);\n      return setToggle(false);\n    }\n  };\n  const auctionEndTimeConversion = (auctionEndDate) => {\n    var dateString = moment.utc(auctionEndDate).format(\"MMMM D, Y\");\n    var timeString = moment.utc(auctionEndDate).format(\"h:mma\");\n    var totalDateTime = dateString + \" at \" + timeString + \" PKT\";\n    return totalDateTime;\n  };\n  const approveAccount = async () => {\n    setApprovalStatus(\"pending\");\n    var formData = new FormData();\n    formData.append(\"isApproved\", true);\n    formData.append(\"userId\", nftDetail.user._id);\n    try {\n      let accApproved = await setApprovalForAll(setApprovalStatus);\n      if (accApproved) {\n        let updatedNFTDetail = { ...nftDetail };\n        updatedNFTDetail.user.isApproved = true;\n        setNftDetail(updatedNFTDetail);\n        props.updateProfile(formData);\n        setApprovalStatus(\"approved\");\n        toast.success(\"Your Account is Approved!.\");\n        return \"\";\n      }\n    } catch (err) {\n      setApprovalStatus(\"not-approved\");\n      return \"\";\n    }\n  };\n\n  const { image, name, description, remainingCopies, fileType } = nftDetail;\n\n  const bannerData = {\n    subHeading: \"NFT\",\n    heading: \"NFT Details\",\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      {loader && <FullPageLoader />}\n      <section className=\"padding-wrapper sell-nft new-nft-detail\">\n        <div className=\"container\">\n          <div className=\"row g-4 g-xl-5\">\n            <div className=\"col-12\">\n              <div className=\"row g-4\">\n                <div className=\" col-lg-6 col-xl-5\">\n                  {fileType === \"image\" ? (\n                    <div className=\"nft-img-container mx-auto mx-lg-0\">\n                      <img src={image} alt=\"nft-image\" />\n                    </div>\n                  ) : (\n                    <div className=\"card-img-top\">\n                      <div className=\"video-wrapper\">\n                        <video\n                          src={image}\n                          ref={videoElement}\n                          onTimeUpdate={handleOnTimeUpdate}\n                        />\n                        <div className=\"controls\">\n                          <div className=\"actions\">\n                            <button\n                              className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                              onClick={togglePlay}\n                            >\n                              {playerState.isPlaying ? (\n                                <BsFillPauseFill />\n                              ) : (\n                                <BsFillPlayFill />\n                              )}\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  )}\n                </div>\n                <div className=\"col-lg-6 col-xl-7\">\n                  <div className=\"nft-img-detail\">\n                    <h5>NFT Details:</h5>\n                  </div>\n                  <div className=\"nft-img-detail-box\">\n                    <div className=\"nft-detail-rounded-box\">\n                      <p>\n                        {name && name.length > 30\n                          ? name.slice(0, 30) + \"...\"\n                          : name}\n                      </p>\n                    </div>\n                    <div className=\"row g-2 g-sm-4\">\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4\">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Total Copies: <span>{nftDetail?.copies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4 \">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Sold:{\" \"}\n                            <span>{nftDetail?.copies - remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4\">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Remaining: <span>{remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div>\n                    <div className=\"detail-bg-box nft-img-detail\">\n                      <h5>Descriptions:</h5>\n                      <hr />\n                      <p>{description}</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12\">\n              <div className=\"sale-btn-container mt-5\">\n                <button\n                  className={` ${\n                    activeBtn === 0 ? \"sell-btn-active\" : \"sell-btn-not-active\"\n                  }  me-3 `}\n                  onClick={() => {\n                    setActiveBtn(0);\n                    setSellingMethod(1);\n                    setCopies(\"\");\n                    setCopiesError(false);\n                  }}\n                >\n                  Fixed Prize\n                </button>\n                <button\n                  className={` ${\n                    activeBtn === 1 ? \"sell-btn-active\" : \"sell-btn-not-active\"\n                  } `}\n                  onClick={() => {\n                    setActiveBtn(1);\n                    setSellingMethod(2);\n                    setCopies(\"\");\n                    setCopiesError(false);\n                  }}\n                >\n                  Timed Auction\n                </button>\n              </div>\n            </div>\n            {activeBtn === 0 ? (\n              <form onSubmit={submit}>\n                <div className=\"row g-4 g-xl-5\">\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Price:</h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"text\"\n                          name=\"fixedPriceConfig.price.amount\"\n                          placeholder=\"Amount\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          maxLength={\"8\"}\n                          onChange={(e) => {\n                            if (e.target.value == \"00\") {\n                              return \"\";\n                            }\n                            onChange(e);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={fixedPriceConfig.price.amount}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">ETH</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>\n                        No of Copies:*{\" \"}\n                        {copiesError && (\n                          <span className=\"text-danger ms-2 error-msg\">{`This NFT has only ${nftDetail.copies} copies`}</span>\n                        )}\n                      </h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"number\"\n                          name=\"copies\"\n                          placeholder=\"Copies\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          min={\"1\"}\n                          onChange={(e) => {\n                            console.log(e.target.value.includes('.'),\"e.target.value.includes('.')\",+e.target.value==0)\n                            if (+e.target.value > nftDetail.copies) {\n                              setCopiesError(true);\n                              return false;\n                            }\n                            if ((e.target.value==0&&copies==='')||e.target.value.includes('.')) {\n                              return false;\n                            }\n                            setCopiesError(false);\n                            setCopies(e.target.value);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={copies}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">Copies</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Fees:</h5>\n                      <hr />\n                      <div className=\"fee-details d-flex align-items-center justify-content-between\">\n                        <div>\n                          <p>\n                            Service Fees:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                        <div>\n                          <p>\n                            Creator Royalty:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"sell-btn-container d-flex justify-content-center justify-content-lg-start\">\n                    <button\n                      className=\"btn btn-linear-gradient sell-btn-completed\"\n                      type=\"submit\"\n                    >\n                      Complete Listing\n                    </button>\n                  </div>\n                </div>\n              </form>\n            ) : (\n              <form onSubmit={submit}>\n                <div className=\"row g-4 g-xl-5\">\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Price:*</h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"text\"\n                          name=\"timedAuctionConfig.startPrice.amount\"\n                          placeholder=\"Amount\"\n                          maxLength=\"8\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          onChange={(e) => {\n                            if (e.target.value === \"00\") {\n                              return false;\n                            } else {\n                              onChange(e);\n                            }\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={timedAuctionConfig.startPrice.amount}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">ETH</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>\n                        No of Copies:*{\" \"}\n                        {copiesError && (\n                          <span className=\"text-danger ms-2 error-msg\">{`This NFT has only ${nftDetail.copies} copies`}</span>\n                        )}\n                      </h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"number\"\n                          name=\"copies\"\n                          placeholder=\"Copies\"\n                          maxLength={\"3\"}\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          min={\"1\"}\n                          max={`${nftDetail.copies}`}\n                          onChange={(e) => {\n                            if (+e.target.value > nftDetail.copies) {\n                              setCopiesError(true);\n                              return false;\n                            }\n                            setCopiesError(false);\n\n                            setCopies(e.target.value);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={copies}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">Copies</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Duration:</h5>\n                      <hr />\n                      <div className=\"sell-date-picker\">\n                        <DateRangePicker\n                          initialSettings={dateRangeInitialSettings}\n                          onApply={handleDateChange}\n                        >\n                          <button\n                            name=\"timedAuctionConfig.duration\"\n                            className=\"calender-btn\"\n                            type=\"button\"\n                          >\n                            {moment(\n                              timedAuctionConfig.duration.startDate\n                            ).format(\"MMMM D, YYYY\")}{\" \"}\n                            -{\" \"}\n                            {moment(timedAuctionConfig.duration.endDate).format(\n                              \"MMMM D, YYYY\"\n                            )}\n                            &nbsp;&nbsp;&nbsp;\n                            <svg\n                              width=\"21\"\n                              height=\"17\"\n                              viewBox=\"0 0 21 17\"\n                              fill=\"none\"\n                              xmlns=\"http://www.w3.org/2000/svg\"\n                            >\n                              <path\n                                d=\"M21 1.54739V16.5821C20.8581 16.8395 20.6576 17 20.3179 17C15.0009 16.9966 9.68439 16.9956 4.3682 16.997C3.94412 16.997 3.69482 16.7648 3.69318 16.3732C3.69318 15.8887 3.69318 15.4043 3.69318 14.9193V14.7311H3.4395C2.51682 14.7311 1.59413 14.7311 0.671455 14.7311C0.36079 14.7311 0.139436 14.5973 0.0430038 14.3622C-0.0534283 14.127 0.0123195 13.9024 0.24025 13.7172C0.775972 13.2754 1.23759 12.7628 1.61002 12.1962C3.00993 10.1145 3.62742 7.82482 3.68769 5.39843C3.71783 4.19078 3.69427 2.98162 3.69591 1.77297C3.69591 1.35764 3.94083 1.13306