2/frontend-v2/frontend/src/pages/wallet/wallet.reducer.js",["547"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/home/home.reducer.js",["548","549"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/auctions.reducer.js",["550"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/explore.reducer.js",["551"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/User/user.reducer.js",["552"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n",["553","554"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Nfts/nfts.reducer.js",["555"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION,\n  CREATE_NFT_AUTH\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  createNFTauth:false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n      case  CREATE_NFT_AUTH:\n        return {\n          ...state,\n          createNFTauth:true,\n        }\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n        createNFTauth:false\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n      case BEFORE_NFTS_BY_COLLECTION:\n        return {\n          ...state,\n          nftsByCollectionStatus: false,\n        }\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Categories/categories.reducer.js",["556"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Offers/offers.reducer.js",["557"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/collections.reducer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/footer.reducer.js",["558"],"import {SUBSCRIBE, BEFORE_FOOTER,SUBSCRIBE_RESPONSE } from '../../redux/types';\n\nconst initialState = {\n    subscribeAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n            case BEFORE_FOOTER:\n                return {\n                    ...state,\n                    subscribeAuth: false,\n                }\n                case SUBSCRIBE:\n                    return {\n                        ...state,\n                        subscribeAuth:false,  \n                    }\n                    case SUBSCRIBE_RESPONSE:\n                        return {\n                            ...state,\n                            subscribeAuth:true,\n                        }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Bids/bids.reducer.js",["559"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["560"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/home-auction-list.tsx",["561","562","563","564"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/not-found/not-found.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/aboutus/aboutus.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/faqs/faqs.tsx",["565","566"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/privacy-policy/privacyPolicy.tsx",["567"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/terms-conditions/termsConditions.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/connect-wallet/connect-wallet.tsx",["568","569"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collection-details/collectiondetails.tsx",["570","571","572","573","574","575"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/all-nfts/allnft.tsx",["576","577","578","579","580","581","582","583","584"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/darkmode/DarkModeContext.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/errorHandler/ErrorHandlerContext.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/home/home.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/popular-collections-list/popular-collections-list.tsx",["585","586","587"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/explore-collections/explore-collections.tsx",["588","589","590","591","592"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout/layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/home-layout/home-layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/User/user.action.js",["593","594"],"import { toast } from 'react-toastify';\nimport { ENV } from '../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../../pages/collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/collections.actions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/web3.js",["595"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Banner/Banner.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/explore.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Nfts/nfts.action.js",["596","597"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION,\n  CREATE_NFT_AUTH,\n} from \"../../redux/types\";\nimport { ENV } from \"../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { axiosPostFormData, handleRequest } from \"../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\n\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(method, `/nfts/${type}`, body);\n      console.log(result, \"result\");\n      const { data, success, message } = result.data;\n      if (success) {\n        toast.success(message);\n        dispatch({\n          type: UPSERT_NFT,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(\"get\", \"nfts/list\", null, qs);\n      const { data, success } = result.data;\n      if (success) {\n        dispatch({\n          type: GET_NFTS,\n          payload: data,\n        });\n        dispatch({\n          type: NFTALL,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const getNFT = (nftId) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let result = await handleRequest(\"get\", `nfts/get/${nftId}`);\n    const { data, success } = result.data;\n    if (success) {\n      dispatch({\n        type: NFTALL,\n        payload: data,\n      });\n      dispatch({\n        type: GET_NFT,\n        payload: data,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: result.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const createActivity = (body) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let res = await handleRequest(\"post\", \"activity/create\", body);\n    const { success, data } = res.data;\n    if (!success) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: res.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getActivities =\n  (qs = null) =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(\"get\", \"activity/get\", null, qs);\n      const { data, success } = result.data;\n      if (success) {\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\nexport const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n    axios\n      .get(url)\n      .then(function (response) {\n        dispatch({\n          type: GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\nexport const beforeNFTByCollection = () => (dispatch) => {\n  dispatch({\n    type: BEFORE_NFTS_BY_COLLECTION,\n  });\n};\n\nexport const getNFTsByCollection = (id) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let payload = {\n      collectionId: id,\n    };\n    let result = await handleRequest(\n      \"post\",\n      \"nfts/getNFTsByCollection\",\n      payload\n    );\n    const { data, success } = result.data;\n    if (success) {\n      dispatch({\n        type: GET_NFTS_BY_COLLECTION,\n        payload: data,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: result.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      const res = await handleRequest(\"get\", \"nftLikes/userNftLikes\", null, qs);\n      const { success, data } = res.data;\n      if (success) {\n        dispatch({\n          type: GET_MYLIKED_NFTS,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: res.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const createNFT = async (formData) => async (dispatch) => {\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  try {\n    const res = await handleRequest(\"post\", \"nfts/storeNFTData\", formData);\n    const { success } = res.data;\n    if (success) {\n      toast.success(\"NFT created successfully\");\n      dispatch({\n        type: CREATE_NFT_AUTH,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: res.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n\n    try {\n      const res = await handleRequest(\"get\", \"nfts/list\", null, qs);\n      const { data, success } = res.data;\n      if (success) {\n        dispatch({\n          type: GET_PROFILE_NFTS,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: res.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/exportData.js",["598"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/Footer.tsx",["599","600","601","602","603","604","605"],"import { useEffect, useState,FC } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter, beforeFooter, subscribeUser } from \"../Footer/footer.action\";\nimport { firstInputCharacterSpace } from \"../../utils/functions\";\nimport EmailIcon from \"../../assets/images/mailbox-icon.svg\";\nimport { useLocation } from \"react-router-dom\";\nimport \"./Footer.css\";\nimport { toast } from \"react-toastify\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {footerInt} from \"../../interfaces/components\";\n\nconst Footer:FC<footerInt> = (props) => {\n  const [email, setEmail] = useState<any>(\"\");\n  const [loader, setLoader] = useState<any>(false);\n\n  useEffect(() => {\n    if (props.subscribeAuth && props.error === null) {\n      setLoader(false);\n      toast.success(\"Subscribed successfully\");\n      props.beforeFooter();\n    }\n  }, [props.subscribeAuth]);\n\n\n  useEffect(() => {\n    if (props.error !== null) {\n      toast.error(props.error.message);\n      setLoader(false);\n\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  const subscribe = () => {\n    if (email.trim() === \"\") {\n      return toast.error(\"Please enter an email to subscribe\");\n    }\n    if (validateEmail(email)) {\n      props.beforeFooter();\n      setLoader(true);\n      props.subscribeUser(email);\n    } else {\n      toast.error(\"Please enter a valid email address\");\n    }\n  };\n\n  const validateEmail = (email:any) => {\n    return String(email)\n      .toLowerCase()\n      .match(\n        /^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/\n      );\n  };\n  const location = useLocation();\n  return (\n    <footer className=\"footer-area\">\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin  text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Who Are We?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/aboutus\">About Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/faqs\">FAQs</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Join MintsClub\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/login\">Sign In</Link>\n                  </li>\n\n                  <li>\n                    <Link to=\"/Signup\">Sign Up</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Quick Links\"}</h4>\n                <ul>\n                  {location.pathname !== \"/login\" &&\n                    location.pathname !== \"/Signup\" && (\n                      <>\n                        <li>\n                          <Link to=\"/auctions\">Live Auction</Link>\n                        </li>\n                        <li>\n                          <Link to=\"/popular-collections\">\n                            Popular Collections\n                          </Link>\n                        </li>\n                      </>\n                    )}\n                  <li>\n                    <Link to=\"/privacypolicy\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/termsandconditions\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin\">\n              <div className=\"footer-items footer-notify-item text-center text-lg-end\">\n                <h4 className=\"footer-title\">\n                  Never Miss The NFT Beat! <br /> Subscribe To Our Latest News\n                </h4>\n                <div className=\"notify-form\">\n                  <div className=\"email-icon\">\n                    <img src={EmailIcon} alt=\"mail-box\" />\n                  </div>\n                  <input\n                    type=\"email\"\n                    maxLength={50}\n                    onKeyDown={(e) => firstInputCharacterSpace(e, email)}\n                    onChange={(e) => setEmail(e.target.value)}\n                    placeholder=\"youremail@xyz.com\"\n                  />\n                  <div>\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                      disabled={loader}\n                      onClick={() => subscribe()}\n                    >\n                      {loader ? (\n                        <div className=\"spinner-border footer-loader\" role=\"status\">\n                          <span className=\"sr-only\">Loading...</span>\n                        </div>\n                      ) : (\n                        \"Subscribe\"\n                      )}\n                    </button>\n                  </div>\n                </div>\n                {/* <p>{data.desc}</p> */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-end\">\n                  <a\n                    href={\"https://www.linkedin.com/showcase/mints-club\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a\n                    href={\"https://www.facebook.com/MintsClub.io/\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a\n                    href={\"https://www.instagram.com/mintsclub/\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={\"https://twitter.com/MintsClub\"} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              <div className=\"copyright-text\">\n                © 2022 All rights reserved by mintsclub.io\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state:any) => ({\n  error: state.error,\n  settings: state.settings,\n  subscribeAuth: state.footer.subscribeAuth,\n});\n\nexport default connect(mapStateToProps, {\n  subscribeUser,\n  emptyError,\n  beforeFooter,\n})(Footer);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/OwnCollectionToday/OwnCollectionToday.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Breadcrumb/Breadcrumb.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/NavbarMain/NavbarMain.tsx",["606","607","608","609","610"],"import  { useEffect,useState, useContext,FC } from \"react\";\nimport { Link, useHistory, useLocation, NavLink } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport { ReactComponent as LoginIcon } from \"../../assets/images/login-icon.svg\";\nimport { ReactComponent as SearchIcon } from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport DarkModeButton from \"../DarkModeButton/DarkModeButton\";\nimport { beforeCollection } from \"../../pages/collections/collections.actions\";\nimport { headerImages } from \"../../assets/assets\";\nimport darkModeContext from \"../../context/darkmode/DarkModeContext\";\n\nconst NavbarMain= () => {\n  const [searchactive, setSearchActive] = useState<any>(false);\n  const [searchValue, setSearchValue] = useState<any>(\"\");\n  const history = useHistory();\n  const { darkMode, setDarkMode } = useContext(darkModeContext);\n\n  const handleChange = (e:any) => {\n    setSearchValue(e.target.value);\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword = () => {\n    if (searchValue !== \"\" && searchValue.length >= 3) {\n      history.push({\n        pathname: \"/explore/allNFT\",\n        state: searchValue,\n      });\n    }\n  };\n  const clearLocalStorage = () => {\n      if(ENV?.getUserKeys(\"_id\")?._id){\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n  };\n\n  const setDark = () => {\n    localStorage.setItem(\"theme\", \"dark\");\n    document.documentElement.setAttribute(\"data-theme\", \"dark\");\n  };\n\n  const setLight = () => {\n    localStorage.setItem(\"theme\", \"light\");\n    document.documentElement.setAttribute(\"data-theme\", \"light\");\n  };\n  const storedTheme = localStorage.getItem(\"theme\");\n  const prefersDark =\n    window.matchMedia &&\n    window.matchMedia(\"(prefers-color-scheme: dark)\").matches;\n\n  const defaultDark =\n    storedTheme === \"dark\" || (storedTheme === null && prefersDark);\n\n  const toggleTheme = (e:any) => {\n    if (e.target.checked) {\n      setDark();\n      setDarkMode(true);\n    } else {\n      setLight();\n      setDarkMode(false);\n    }\n  };\n\n  useEffect(() => {\n    if (defaultDark) {\n      setDark();\n      setDarkMode(true);\n    }\n  }, []);\n  console.log(ENV?.getUserKeys(\"_id\"))\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          expand=\"xl\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <NavLink to=\"/\" className=\"navbar-brand-logo\">\n            <img\n              src={darkMode ? headerImages.logoDark : MintsClub}\n              alt=\"logo\"\n            />\n          </NavLink>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className={\"ms-xl-auto\"}>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/\">Home</NavLink>\n              </Nav.Link>\n\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/exploreAll\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Explore All\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/allNFT\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    All NFT\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/create\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Create NFT\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/createcollection\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Create Collection\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Profile\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/userprofile\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Profile\n                  </NavLink>\n                </NavDropdown.Item>\n                {/* <NavDropdown.Item> */}\n                <DarkModeButton\n                  toggleTheme={toggleTheme}\n                  defaultDark={defaultDark}\n                />\n                {/* </NavDropdown.Item> */}\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/login\"\n                    className={`nav-main-link main-nav-dd-items`}\n                    onClick={() => clearLocalStorage()}\n                  >\n                    {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              {/* <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/userprofile\" className=\"nav-main-link\">\n                  Profile\n                </NavLink>\n              </Nav.Link> */}\n              {/* <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <span className=\"me-2\">\n                    <LoginIcon />\n                  </span>\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link> */}\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={() => handleSearchKeyword()}\n                >\n                  <SearchIcon className=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={() => handleSearchKeyword()}\n              >\n                <SearchIcon className=\"search-icon\" />\n              </button>\n            </div>\n            {/* <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient btn-login\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <span className=\"me-2\">\n                  <LoginIcon />\n                </span>\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link> */}\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = () => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Listing/Listing.tsx",["611","612","613"],"import { useState, useEffect, FC } from \"react\";\nimport \"./Listing.css\";\nimport SearchIcon from \"../../assets/images/search-inp.svg\";\nimport NftCard from \"../NftCard/NftCard\";\nimport FullPageLoader from \"../FullPageLoader/FullPageLoader\";\nimport Select from \"react-select\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { listingInt } from \"../../interfaces/components\";\n\nconst Listing: FC<listingInt> = (props) => {\n  const [minValue, setMinValue] = useState<any>(\"\");\n  const [maxValue, setMaxValue] = useState<any>(\"\");\n  const [statusActive, setStatusActive] = useState<any>(null);\n  const [filterActive, setFilterActive] = useState<any>(false);\n  const [initial, setInitial] = useState<any>(true);\n  const [selectedOption, setSelectedOption] = useState<any>();\n  const [collectionActive, setCollectionActive] = useState<any>(null);\n  const [isActive, setIsActive] = useState<any>(1);\n  const [keyword, setKeyword] = useState<any>(\n    props.initialKeyword ? props.initialKeyword : \"\"\n  );\n  const [filter, setFilter] = useState<any>({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n    keyword: props.initialKeyword ? props.initialKeyword : \"\",\n  });\n\n  const priceOptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recently Created\" },\n  ];\n  useEffect(() => {\n    const { initialKeyword } = props;\n    if (initialKeyword) {\n      let capitalizeValue = capitalize(initialKeyword);\n      setKeyword(capitalizeValue);\n      handleSearchKeyword(capitalizeValue);\n    }\n  }, [props.initialKeyword]);\n\n  useEffect(() => {\n    fetchData(filter);\n  }, [filter]);\n  const handleSelectChange = (selectedOption: any) => {\n    setSelectedOption(selectedOption);\n  };\n  const selectCustomStyles = {};\n\n  const statusData = [\"Buy Now\", \"On Auction\", \"New\"];\n  const handleFilters = () => {\n    setFilterActive(!filterActive);\n  };\n  const isHideCollection = () => {\n    if (props.collectionDetail) {\n      return false;\n    }\n    if (props.UserProfile) {\n      if (isActive === 1) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return true;\n    }\n  };\n\n  const handleSortOptions = (e: any) => {\n    setFilterationLoader(true);\n    setInitial(false);\n\n    const { label } = e;\n    if (label === \"Low To High\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"High To Low\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"Oldest\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n    } else if (label === \"Recently Created\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e: any) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e: any) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    if (!UserProfile) {\n      setInitial(false);\n      setFilterationLoader(true);\n      setFilter((prev: any) => ({ ...prev, limit: filter.limit + 10 }));\n    } else {\n      getPaginatedData?.();\n    }\n  };\n\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev: any) => ({\n      ...prev,\n      gtePrice: minValue,\n      ltePrice: maxValue,\n    }));\n  };\n\n  const handleCollectionsFilter = (id: string) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev: any) => ({ ...prev, collectionId: id }));\n  };\n\n  const handleSearchKeyword = (value: any) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    let capitalizeValue = \"\";\n    if (value) {\n      capitalizeValue = capitalize(value);\n    }\n    setFilter((prev: any) => ({ ...prev, keyword: capitalizeValue }));\n  };\n\n  const handleStatusFilter = (id: string) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    if (id === \"Buy Now\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        buy: true,\n        auction: false,\n        newest: false,\n      }));\n    } else if (id === \"On Auction\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        auction: true,\n        buy: false,\n        newest: false,\n      }));\n    } else {\n      setFilter((prev: any) => ({\n        ...prev,\n        newest: true,\n        buy: false,\n        auction: false,\n      }));\n    }\n  };\n  const handleClearFilter = (id: any) => {\n    if (id === \"status\") {\n      setFilterationLoader(true);\n      setFilter((prev: any) => ({\n        ...prev,\n        buy: false,\n        auction: false,\n        new: false,\n      }));\n    } else if (id === \"price\") {\n      setFilterationLoader(true);\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setFilter((prev: any) => ({ ...prev, ltePrice: false, gtePrice: false }));\n    } else if (id === \"collections\") {\n      setFilterationLoader(true);\n      setFilter((prev: any) => ({ ...prev, collectionId: false }));\n    } else {\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setStatusActive(null);\n      setCollectionActive(null);\n      setSelectedOption(null);\n      setFilterActive(null);\n      setKeyword(\"\");\n      setFilter({\n        collectionId: false,\n        gtePrice: false,\n        ltePrice: false,\n        categoryId: false,\n        oldest: false,\n        lowToHigh: false,\n        highToLow: false,\n        newest: false,\n        page: filter.page,\n        limit: filter.limit,\n        buy: false,\n        auction: false,\n        latest: false,\n      });\n    }\n  };\n  const capitalize = (word: string) => {\n    return word[0].toUpperCase() + word.slice(1).toLowerCase();\n  };\n\n  const {\n    collections,\n    disabled,\n    menuData,\n    handleNftFilter,\n    setMenuFilter,\n    filterationLoader,\n    setFilterationLoader,\n    nfts,\n    loader,\n    likedNfts,\n    nftPagination,\n    handleLikesTogleApi,\n    fetchData,\n    path,\n    getPaginatedData,\n    UserProfile,\n  } = props;\n\n  return (\n    <div className=\"filterhoc-wrapper padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row justify-content-center justify-content-lg-start\">\n          <div className=\"col-12 order-0\">\n            <div\n              className={`d-flex flex-column flex-md-row align-items-center justify-content-md-between`}\n            >\n              <div className=\"search-input mb-4 mb-md-0\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Search items and accounts\"\n                  maxLength={50}\n                  onChange={(e: any) => {\n                    if (keyword.trim() === \"\" && e.target.value.trim() === \"\") {\n                      return false;\n                    } else if (e.target.value === \"\") {\n                      handleSearchKeyword(false);\n                      setKeyword(e.target.value);\n                    } else {\n                      setKeyword(e.target.value);\n                    }\n                  }}\n                  onKeyPress={(e: any) =>\n                    e.key === \"Enter\" && handleSearchKeyword(keyword)\n                  }\n                  value={keyword}\n                />\n                <img src={SearchIcon} alt=\"search-input\" />\n              </div>\n              <div className=\"sort-by-select mb-4 mb-md-0\">\n                <p className=\"me-3\">Sort by:</p>\n                <Select\n                  className=\"react-select-cls\"\n                  classNamePrefix=\"react-select\"\n                  styles={selectCustomStyles}\n                  // defaultValue={priceOptions[3]}\n                  value={selectedOption}\n                  isSearchable={false}\n                  onChange={(value) => {\n                    handleSelectChange(value);\n                    handleSortOptions(value);\n                  }}\n                  options={priceOptions}\n                />\n              </div>\n              <div className=\"mob-filters-btn d-flex d-lg-none align-items-center justify-content-center\">\n                <button\n                  className={`${filterActive ? \"mob-active-filter\" : \"\"}`}\n                  onClick={handleFilters}\n                >\n                  Filters\n                </button>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-12 my-5 order-2 order-lg-1 \">\n            <div className=\"hero-nav d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n              <div>\n                {\" \"}\n                {menuData &&\n                  menuData.length > 0 &&\n                  menuData.map((item, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          setIsActive(id);\n                          handleNftFilter?.(item);\n                          setMenuFilter?.(item);\n                        }}\n                        className={`${\n                          id === isActive ? \"active-hero-nav\" : \"\"\n                        } me-2 me-xl-3`}\n                      >\n                        {item}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"total-items mt-3 mt-sm-0\">\n                <p>\n                  Total items:{\" \"}\n                  <span>{nftPagination?.total ? nftPagination?.total : 0}</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div\n            className={`${\n              filterActive ? \"d-block d-lg-block\" : \"d-none d-lg-block\"\n            } col-md-5 col-lg-4 col-xl-3 order-1 order-lg-2 mt-4 mt-lg-0`}\n          >\n            <div className=\"filter-container mb-4\">\n              <h6>Status</h6>\n              <hr />\n              <div className=\"d-flex flex-wrap align-items-center \">\n                {statusData &&\n                  statusData.map((status: any, id: any) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          handleStatusFilter(status);\n                          setStatusActive(status);\n                        }}\n                        className={`${\n                          status === statusActive ? \"active-filter-btn\" : \"\"\n                        } filter-btn me-3`}\n                      >\n                        {status}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {statusActive && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => {\n                      setStatusActive(null);\n                      handleClearFilter(\"status\");\n                    }}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            <div className=\"filter-container mb-4\">\n              <h6>Price</h6>\n              <hr />\n              <div className=\"min-max-inp d-flex flex-column flex-sm-row align-items-center justify-content-center justify-content-sm-between mb-2\">\n                <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-center\">\n                  <input\n                    type=\"number\"\n                    placeholder=\"Min\"\n                    className=\"me-sm-2\"\n                    value={minValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMinPrice}\n                  ></input>\n                  <input\n                    type=\"number\"\n                    placeholder=\"Max\"\n                    className=\"mt-3 mt-sm-0 me-sm-2\"\n                    value={maxValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMaxPrice}\n                  ></input>\n                </div>\n                <button\n                  className=\"mt-3 mt-sm-0\"\n                  onClick={() => applyMinMaxFilter()}\n                  disabled={disabled || minValue === \"\" || maxValue === \"\"}\n                >\n                  Apply\n                </button>\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {minValue && maxValue && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => handleClearFilter(\"price\")}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            {isHideCollection() && (\n              <div className=\"filter-container hoc-collections-container mb-4\">\n                <h6>Collections</h6>\n                <hr />\n                <div className=\"d-flex flex-wrap align-items-center \">\n                  {collections && collections.length > 0 ? (\n                    collections.map((collection: any, id: any) => {\n                      return (\n                        <button\n                          key={id}\n                          onClick={() => {\n                            handleCollectionsFilter(collection._id);\n                            setCollectionActive(id);\n                          }}\n                          className={`${\n                            id === collectionActive ? \"active-filter-btn\" : \"\"\n                          } filter-btn me-2 me-xl-3`}\n                        >\n                          {collection.name}\n                        </button>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center mx-auto\">No Collections Found</p>\n                  )}\n                </div>\n                <div className=\"d-flex align-items-end justify-content-end\">\n                  {collectionActive !== null && (\n                    <button\n                      className=\"filter-clear-btn\"\n                      onClick={() => {\n                        setCollectionActive(null);\n                        handleClearFilter(\"collections\");\n                      }}\n                    >\n                      Clear\n                    </button>\n                  )}\n                </div>\n              </div>\n            )}\n            <div className=\"d-flex align-items-center justify-content-center btn-clear-all\">\n              <button onClick={() => handleClearFilter(null)}>\n                Clear All Filters\n              </button>\n            </div>\n          </div>\n          <div className=\"col-lg-8 col-xl-9 order-3\">\n            {loader ? (\n              <FullPageLoader />\n            ) : (\n              <div className=\"row g-1\">\n                {filterationLoader ? (\n                  <div className=\"text-center\">\n                    <div\n                      className=\"spinner-border text-secondary\"\n                      role=\"status\"\n                    >\n                      <span className=\"sr-only\">Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((nft: any, index: number) => {\n                    return (\n                      <div\n                        key={index}\n                        className=\"col-12 col-sm-6 col-md-4 col-lg-6 col-xl-4\"\n                      >\n                        {\n                          <NftCard\n                            data={nft}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            likedNfts={likedNfts}\n                            owner={nft.owner}\n                            path={path}\n                            index={index}\n                          />\n                        }\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center mt-5 no-nft-title\">No NFTs Found</p>\n                )}\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      nftPagination?.total > nfts.length &&\n                      !filterationLoader && (\n                        <button\n                          className=\"btn btn-rounded-bordered px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more...\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Listing;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/footer.action.js",["614"],"import { ENV } from \"../../config/config\";\nimport {\n  GET_ERRORS,\n  BEFORE_FOOTER,\n  GET_FOOTER,\n  SUBSCRIBE_RESPONSE,\n  SUBSCRIBE,\n} from \"../../redux/types\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport axios from \"axios\";\n\nexport const beforeFooter = () => {\n  return {\n    type: BEFORE_FOOTER,\n  };\n};\n\nexport const getFooter = () => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({ type: SUBSCRIBE });\n  const url = `${ENV.url}/settings/get`;\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        dispatch({\n          type: GET_FOOTER,\n          payload: data.settings,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const subscribeUser = (email) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    const response = await axios.post(`${ENV.url}users/subscribe`, { email });\n    dispatch({\n      type: SUBSCRIBE_RESPONSE,\n    });\n    // console.log(response, \"response\");\n  } catch (error) {\n    // console.log(error.response, \"error\");\n    dispatch({\n      type: GET_ERRORS,\n      payload: error.response.data,\n    });\n  }\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/DarkModeButton/DarkModeButton.tsx",["615"],"import \"./DarkModeButton.css\";\nimport { styled } from \"@mui/material/styles\";\nimport FormGroup from \"@mui/material/FormGroup\";\nimport FormControlLabel from \"@mui/material/FormControlLabel\";\nimport Switch, { SwitchProps } from \"@mui/material/Switch\";\nimport SunImg from \"../../assets/images/sun-fill.svg\";\n\nconst DarkModeButton = (props:any) => {\n  return (\n    <div className=\"toggle-theme-wrapper\">\n      <p>Dark Mode</p>\n      <FormGroup>\n        <FormControlLabel\n          sx={{ mr: 0 }}\n          control={<Android12Switch\n            checked={props.defaultDark}\n            onChange={props.toggleTheme} />} label={undefined}        />\n      </FormGroup>\n    </div>\n  );\n};\n\nexport default DarkModeButton;\n\nconst Android12Switch = styled(Switch)(({ theme }) => ({\n  padding: 8,\n  \"& .Mui-checked\": { color: \"#fff\" },\n  \"& .Mui-checked+.MuiSwitch-track\": {\n    backgroundColor: \"#000 !important\",\n  },\n  \"& .MuiSwitch-track\": {\n    borderRadius: 22 / 2,\n    \"&:before, &:after\": {\n      content: '\"\"',\n      position: \"absolute\",\n      top: \"50%\",\n      transform: \"translateY(-50%)\",\n      width: 16,\n      height: 16,\n    },\n    \"&:before\": {\n      backgroundImage: `url(${SunImg})`,\n      left: \"15px\",\n      backgroundRepeat: \"no-repeat\",\n      height: \"11px\",\n      width: \"11px\",\n    },\n    \"&:after\": {\n      backgroundImage: `url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" height=\"16\" width=\"16\" viewBox=\"0 0 24 24\"><path fill=\"${encodeURIComponent(\n        theme.palette.getContrastText(theme.palette.primary.main)\n      )}\" d=\"M19,13H5V11H19V13Z\" /></svg>')`,\n      right: 12,\n    },\n  },\n  \"& .MuiSwitch-thumb\": {\n    boxShadow: \"none\",\n    width: 16,\n    height: 16,\n    margin: 2,\n  },\n}));\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/top-seller/topseller.js",["616","617"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/PopularCollections.ts",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/NftCard/NftCard.tsx",["618","619","620","621"],"import React, { useState, FC } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport useVideoPlayer from \"../TestVideoCard/Components/UseVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport placeholderImg from \"../../assets/images/placeholder.png\";\nimport { connect } from \"react-redux\";\nimport \"./NftCard.css\";\nimport { Images } from \"../../assets/assets\";\nimport ImageLoader from \"../ContentLoader/ImageLoader\";\nimport Audio from \"../Audio/Audio\";\nimport { NFTCardInt } from \"../../interfaces/components\";\nconst NFTCard: FC<NFTCardInt> = (props) => {\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay } = useVideoPlayer(videoElement);\n  const [loader, setLoader] = useState<any>(true);\n  const {\n    image,\n    name,\n    _id,\n    fileType,\n    cardBg,\n    ownerId,\n    likeCount,\n    currentPrice,\n    copies,\n    remainingCopies,\n    ownerAddress,\n  } = props.data;\n  const { username, profileImage, profilePhoto } = props?.owner;\n  const { likedNfts } = props;\n  const validateIfLiked = (likedNfts1: any, id: string) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n\n  return (\n    <Card className={`auction-card nft-card ${cardBg} m-1 mx-auto mx-sm-1`}>\n      <div className=\"auction-img-wrapper\">\n        {fileType === \"image\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Card.Img\n              variant=\"top\"\n              onLoad={() => setLoader(false)}\n              onClick={() => history.push(`${props.path}${_id}`)}\n              src={image}\n              alt=\"AuctionTopImg\"\n              style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n            />\n          </>\n        ) : fileType === \"video\" ? (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n                <ImageLoader />\n              </div>\n              <video\n                id=\"video1\"\n                src={image}\n                ref={videoElement}\n                onEnded={() => {\n                  togglePlay();\n                }}\n                onCanPlay={() => {\n                  setLoader(false);\n                }}\n                style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : fileType === \"audio\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Audio\n              src={image}\n              onLoadCallback={() => {\n                setLoader(false)\n                return false\n                 \n              } }\n              loader={loader}\n              fileType={fileType}\n            />\n          </>\n        ) : (\n          \" \"\n        )}\n      </div>\n      <Card.Body>\n        <Card.Title>\n          <div>\n            {name && name.length > 15 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <span className=\"me-2\">{likeCount ? likeCount : 0}</span>\n            {!validateIfLiked(likedNfts, _id) ? (\n              <img\n                src={Images.whiteEmptyHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"like\", likeCount);\n                }}\n              />\n            ) : (\n              <img\n                src={Images.whiteFillHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"dislike\", likeCount);\n                }}\n              />\n            )}\n          </div>\n        </Card.Title>\n        <div className=\"nft-status \">\n          <div className=\"status-info status-sold\">\n            <span className=\"status\">\n              Sold:{\" \"}\n              <span className=\"status-count\">{copies - remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n          <div className=\"status-info status-remaining\">\n            <span className=\"status\">\n              Remaining: <span className=\"status-count\">{remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-3\">\n          <span className=\"nft-price mt-2\">\n            <img className=\"me-2\" src={Images.nftPriceTag} />\n            Price:<a className=\"price ms-1\">{currentPrice} ETH</a>\n          </span>\n        </div>\n        <div className=\"auction-card-owner-container d-flex align-items-center mb-2 mt-3\">\n          <div className=\"auction-owner-avatar\">\n            <img\n              src={\n                !profilePhoto && !profileImage\n                  ? placeholderImg\n                  : profilePhoto\n                  ? profilePhoto\n                  : profileImage\n              }\n              alt=\"avatar\"\n            />\n          </div>\n          <div className=\"ms-2 auction-owner-name\">\n            <p>\n              {\"Owned by:\"}\n              <span className=\"text-capitalize ms-1\">\n                {ownerAddress?.toUpperCase() ===\n                props.connectedAddress?.toUpperCase()\n                  ? \"You\"\n                  : username && username?.length > 19\n                  ? username.substring(0, 19) + \"...\"\n                  : username?.length <= 19\n                  ? username\n                  : \"unnamed\"}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn\"\n          onClick={() => history.push(`${props.path}${_id}`)}\n        >\n          {\"View Detail\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state: any) => ({\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {})(NFTCard);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/levelsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/statsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Offers/offers.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Bids/bids.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/popular-collections.tsx",["622","623","624","625","626","627"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/home-auctions.tsx",["628","629","630","631","632","633","634"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/propertiesinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/CollectionsCards/CollectionsCard.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/BuySell/BuySell.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Hero/Hero.tsx",["635","636"],"import { useEffect, useState,FC } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport \"./Hero.css\";\nimport Play from \"../../assets/images/play.svg\";\nimport CardSlider from \"../CardSlider/CardSlider\";\nimport HeroCards from \"../HeroCards/HeroCards\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeAuction,\n  getLiveAuctions,\n} from \"../../pages/auctions/auctions.action\";\nimport { connect } from \"react-redux\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\nimport { HeroInt } from \"../../interfaces/components\";\nconst Hero:FC< HeroInt>= (props) => {\n  const [connectedAddress, setConnectedAddress] = useState<any>(\"\");\n  const [data, setData] = useState<any>(null);\n  const [status, setStatus] = useState<any>(null);\n  const heroSettings = ENV.heroSettings;\n\n  useEffect( () => {\n    const setAddress=async ()=>{\n\n      let connectedAddress = await connectMetamaskCopy();\n      setConnectedAddress(connectedAddress);\n    }\n    setAddress()\n  }, []);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n  }, []);\n\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions } = props.auction;\n      let updatedAuctions = [];\n      if (auctions && auctions.length > 1) {\n        props.beforeAuction();\n        setStatus(\"auctions\");\n        updatedAuctions = auctions.filter((item:any) => item.fileType === \"image\");\n        if (updatedAuctions?.length > 6) {\n          updatedAuctions = updatedAuctions.slice(0, 6);\n        }\n        setData(updatedAuctions);\n      } else {\n        setStatus(\"nfts\");\n        setData(WordsFamousNfts);\n      }\n    }\n  }, [props.auction.auctionsAuth]);\n\n  return (\n    <section className=\"hero-section padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row align-items-center\">\n          <div className=\"col-12 col-lg-6\">\n            <h1 className=\"mt-4\">\n              Discover, Collect, <br /> <span>and sell</span> Rare\n              <br />\n              Digital Art <span> NFTs </span>\n            </h1>\n            <p className=\"mp-explore-text\">\n              Build the leading platform for cutting-edge and next gen\n              Blockchain.\n            </p>\n            {/* Buttons */}\n            <div className=\"button-group mt-lg-5 d-flex\">\n              <Link\n                className=\"btn btn-linear-gradient btn-hero-create me-sm-4\"\n                to={connectedAddress ? \"/create\" : \"/login\"}\n              >\n                Create\n              </Link>\n              <div className=\"watch-video d-flex align-items-center\">\n                <button className=\"hero-play-btn\">\n                  <img src={Play} alt=\"play\" />\n                </button>\n                <span className=\"ms-4\">Watch video to learn more ...</span>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-12 col-lg-6\">\n            <CardSlider settings={heroSettings}>\n              {data &&\n                data.length > 0 &&\n                data.map((auction:any, id:any) => {\n                  return (\n                    <HeroCards\n                      key={id}\n                      data={auction}\n                      status={status}\n                      // className=\"slide\"\n                    />\n                  );\n                })}\n            </CardSlider>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state:any) => ({\n  auction: state.auction,\n  nft: state.nft,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n})(Hero);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/AuctionsCards/AuctionsCards.tsx",["637"],"import React, { useState,FC } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport ArrowUp from \"../../assets/images/arrowUp.svg\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../config/config\";\nimport useVideoPlayer from \"../TestVideoCard/Components/UseVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { connect } from \"react-redux\";\nimport \"./AuctionsCard.css\";\nimport { Images } from \"../../assets/assets\";\nimport ImageLoader from \"../ContentLoader/ImageLoader\";\nimport AuctionAudio from \"../AuctionAudio/AuctionAudio\";\nimport {AuctionCardInterface} from '../../interfaces/components';\n\n\nconst AuctionsCards:FC<AuctionCardInterface> = ({\n  ownerName,\n  userId,\n  bidsProfile,\n  item,\n  cardBg,\n  key,\n  connectedAddress,\n}) => {\n  const { countDownRenderer } = ENV;\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay } =\n    useVideoPlayer(videoElement);\n  const [loader, setLoader] = useState<any>(true);\n  const {\n    image,\n    auctionEndDate,\n    name,\n    _id,\n    highestBid,\n    totalBids,\n    currentPrice,\n    fileType,\n    ownerAddress,\n  } = item;\n  const { profilePhoto } = item?.owner;\n  \n  return (\n    <Card key={key} className={`auction-card ${cardBg} mx-auto mx-sm-2`}>\n      <div className=\"auction-img-wrapper\">\n        {fileType === \"image\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Card.Img\n              variant=\"top\"\n              onLoad={() => setLoader(false)}\n              onClick={() => history.push(`explore/nftdetail/${_id}`)}\n              src={image}\n              alt=\"AuctionTopImg\"\n              style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n            />\n          </>\n        ) : fileType === \"video\" ? (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n                <ImageLoader />\n              </div>\n\n              <video\n                src={image}\n                onEnded={() => {\n                  togglePlay();\n                }}\n                onCanPlay={() => {\n                  setLoader(false);\n                }}\n                ref={videoElement}\n                // onTimeUpdate={handleOnTimeUpdate}\n                style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : fileType === \"audio\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n\n            <AuctionAudio\n              src={image}\n              onLoadCallback={() => setLoader(false)}\n              loader={loader}\n            />\n          </>\n        ) : (\n          \" \"\n        )}\n\n        <div className=\"auction-countdown d-flex flex-column justify-content-center align-items-center\">\n          <Countdown date={auctionEndDate} renderer={countDownRenderer} />\n          <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n            <div className=\"auction-card-avatar d-flex align-items-center\">\n              {bidsProfile &&\n                bidsProfile.length > 0 &&\n                bidsProfile.map((item:any, i:any) => {\n                  if (i <= 2) {\n                    return (\n                      <img\n                        src={item === null ? Images.placeholderImg : item}\n                        alt=\"AvatarImg\"\n                        key={i}\n                      />\n                    );\n                  }\n                })}\n\n              <span className={`${totalBids === 0 ? \"\" : \"ms-4\"}`}>\n                {totalBids === 0\n                  ? \"No Bids Found\"\n                  : totalBids < 4\n                  ? totalBids + \" People Placed Bid\"\n                  : totalBids - 1 + \"+ People Placed Bid\"}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body>\n        <Card.Title onClick={() => history.push(`explore/nftdetail/${_id}`)}>\n          <div>\n            {name && name.length > 10 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>{totalBids > 0 ? highestBid : currentPrice}</span>\n          </div>\n        </Card.Title>\n        <div className=\"auction-card-owner-container d-flex align-items-center mb-2\">\n          <div className=\"auction-owner-avatar\">\n            <img\n              src={profilePhoto ? profilePhoto : Images.placeholderImg}\n              alt=\"avatar\"\n            />\n          </div>\n\n          <div className=\"ms-2 auction-owner-name\">\n            <p>\n              {\"Owned by:\"}\n              <span className=\"text-capitalize ms-1\">\n                {!ownerName\n                  ? \"unnamed\"\n                  : connectedAddress?.toUpperCase() ===\n                    ownerAddress?.toUpperCase()\n                  ? \"You\"\n                  : ownerName && ownerName.length > 12\n                  ? ownerName.substring(0, 12) + \"....\"\n                  : ownerName}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn\"\n          onClick={() => history.push(`explore/nftdetail/${_id}`)}\n        >\n          {connectedAddress?.toUpperCase() === ownerAddress?.toUpperCase() ||\n          !userId\n            ? \"View\"\n            : \"Place a Bid\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state:any) => ({\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {})(AuctionsCards);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Table/Table.tsx",["638"],"import { useEffect, useState } from \"react\";\nimport {\n  BsTagFill,\n  BiTransferAlt,\n  MdShoppingCart,\n  FaHandPaper,\n} from \"react-icons/all\";\nimport ReactTimeAgo from \"react-time-ago\";\nimport { TableInterface } from \"../../interfaces/components\";\nconst Table: React.FC<TableInterface> = ({\n  titles,\n  data,\n  lowestNftPrice,\n  exchangeRate,\n  status,\n}) => {\n  const [info, setInfo] = useState<any>(null);\n\n  useEffect(() => {\n    if (status === \"Offers\") {\n      formateBidsInfo();\n    } else {\n      formateActivityInfo();\n    }\n  }, [data]);\n\n  const getPercentageChange = (oldNumber: number, newNumber: number) => {\n    var decreaseValue = oldNumber - newNumber;\n\n    return (decreaseValue / oldNumber) * 100;\n  };\n\n  const handleAcitivityIcon = (type: string) => {\n    if (type === \"Mint\") {\n      return <MdShoppingCart />;\n    } else if (type === \"List\") {\n      return <BsTagFill />;\n    } else if (type === \"Bid\") {\n      return <FaHandPaper />;\n    } else {\n      return <BiTransferAlt />;\n    }\n  };\n\n  const formateBidsInfo = () => {\n    if (data && data.length > 0) {\n      let formatedData = data.map((item: any) => {\n        return {\n          item1: item.bidAmount,\n          item2: `$ ${(item.bidAmount * exchangeRate).toFixed(2)}`,\n          item3: `${\n            Number(\n              getPercentageChange(item.bidAmount, lowestNftPrice).toFixed(0)\n            ) %\n              item.bidAmount >\n            lowestNftPrice\n              ? \"above\"\n              : \"below\"\n          }`,\n          item4: `${\n            item.fromAddress.slice(0, 4) + \"...\" + item.fromAddress.slice(-4)\n          }`,\n        };\n      });\n      setInfo(formatedData);\n    }\n  };\n\n  const formateActivityInfo = () => {\n    if (data && data.length > 0) {\n      let formatedData: any = data.map((item: any) => {\n        return {\n          item1: (\n            <div className=\"d-flex align-items-center\">\n              {handleAcitivityIcon(item.activityType)}\n              <p className=\"ps-1\"> {item.activityType} </p>\n            </div>\n          ),\n          item2: item.price,\n          item3: `${\n            item.fromAddress\n              ? item.fromAddress.slice(0, 4) +\n                \"...\" +\n                item.fromAddress.slice(-6)\n              : \"null address\"\n          }`,\n          item4: `${\n            item.toAddress\n              ? item.toAddress.slice(0, 4) + \"...\" + item.toAddress.slice(-4)\n              : \"\"\n          }`,\n          item5: (\n            <div>\n              <ReactTimeAgo date={item.createdAt} locale=\"en-US\" />\n            </div>\n          ),\n        };\n      });\n      setInfo(formatedData);\n    }\n  };\n  return (\n    <div className=\"table-container\">\n      <table className=\"table table-borderless\">\n        {data && data.length > 0 && (\n          <thead>\n            <tr>\n              {titles.map((item: any) => {\n                return <th scope=\"col\">{item}</th>;\n              })}\n            </tr>\n          </thead>\n        )}\n        <tbody>\n          {info && info.length > 0 ? (\n            <>\n              {info.map((val: any, index: any) => {\n                return (\n                  <tr key={index}>\n                    <th scope=\"row\">{val.item1}</th>\n                    <td>{val.item2}</td>\n                    <td>{val.item3}</td>\n                    <td>{val.item4}</td>\n                    {val.item5 && <td>{val.item5}</td>}\n                  </tr>\n                );\n              })}\n            </>\n          ) : (\n            <p className=\"text-center d-flex justify-content-center align-items-center\">\n              {` No ${status} Found`}\n            </p>\n          )}\n        </tbody>\n      </table>\n    </div>\n  );\n};\nexport default Table;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/NftDetailLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Audio/Audio.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/SellNFTLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/TestVideoCard/Components/UseVideoPlayer.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/BidModal/BidModal.tsx",["639"],"import React, { useState, useEffect,FC } from \"react\";\nimport { Modal, Button } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport \"../BuyModal/BuyModal.css\"\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport axios from \"axios\";\nimport { BidModalInt } from \"../../../interfaces/components\";\n\nconst BidModal:FC<BidModalInt> = (props) => {\n  const [checkBox, setCheckBox] = useState<any>(false);\n  const [exchangeRate, setExchangeRate] = useState<any>(0);\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  const {\n    onChange,\n    decimalNumberValidator,\n    handleModalSubmit,\n    calculatePricePercantage,\n    onHide,\n    balance,\n    price,\n    show,\n  } = props;\n  \n  return (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className={`buy-modal bid-modal ${show === true ? \"modal-is-open\" : \" \"}`}\n      centered\n      autoFocus={true}\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Place a Bid\n        </Modal.Title>\n\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to place bid!\"}\n        </p>\n\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Price</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"bid-inp-container d-flex align-items-center\">\n          <div className=\"inp-container d-flex align-items-center justify-content-between\">\n            <div>\n              <input\n                type=\"number\"\n                placeholder=\"Place Your Bid\"\n                name=\"nftConfig.price.amount\"\n                style={{ borderRadius: \"4px\" }}\n                onChange={(e) => onChange(e)}\n                onKeyDown={(e) => decimalNumberValidator(e)}\n                defaultValue={calculatePricePercantage()}\n                value={price}\n              />\n            </div>\n            <div className=\"dollar-rate text-end\">\n              <p className=\"\">\n                ${price ? (price * exchangeRate).toFixed(2) : 0}\n              </p>\n            </div>\n          </div>\n          <div className=\"inp-currency\">\n            <h6>ETH</h6>\n          </div>\n        </div>\n        <div className=\"bid-balance text-start\">\n          <p>Balance: {Number(balance).toFixed(4)} ETH</p>\n        </div>\n        {balance !== \"\" && balance === 0 && (\n          <p className=\"text-center insufcient-funds text-danger\">\n            Please Add Balance to place bid\n          </p>\n        )}\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\">Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n          onClick={() => {\n            handleModalSubmit();\n            onHide();\n          }}\n          disabled={\n            +price < calculatePricePercantage() ||\n            balance === 0 ||\n            !checkBox ||\n            +price > +balance\n          }\n        >\n          Confirm Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default BidModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/BuyModal/BuyModal.tsx",["640","641","642"],"import { useState,FC } from \"react\";\nimport { Modal, Button, Spinner } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../../assets/images/tick-checkbox.svg\";\nimport { ReactComponent as FbIcon } from \"../../../assets/images/fb-blue.svg\";\nimport { ReactComponent as TwitterIcon } from \"../../../assets/images/twitter-blue.svg\";\nimport { ReactComponent as LinkedinIcon } from \"../../../assets/images/linkedin-blue.svg\";\nimport { ReactComponent as InstaIcon } from \"../../../assets/images/insta-blue.svg\";\nimport { ReactComponent as VideoIcon } from \"../../../assets/images/buy-video-icon.svg\";\nimport { ReactComponent as AudioIcon } from \"../../../assets/images/audio-icon.svg\";\nimport ModalSmiley from \"../../../assets/images/model-smiley.svg\";\nimport { Buy } from \"../../../interfaces/components\";\nconst BuyModal:FC<Buy> = (props) => {\n  const [purchase, setPurchase] = useState<any>(true);\n  const [checkBox, setCheckBox] = useState<any>(false);\n  const {\n    name,\n    image,\n    price,\n    exchangeRate,\n    tokenId,\n    buyNow,\n    confirmed,\n    transactionHash,\n    transactionSuccess,\n    onHide,\n    disabled,\n    balance,\n    fileType,\n  } = props;\n\n  return confirmed === \"\" || confirmed === false || confirmed === \"pending\" ? (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Complete Checkout\n        </Modal.Title>\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to buy this NFT\"}\n        </p>\n        <div className=\"modal-close-container\">\n          <Button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                {fileType === \"image\" ? (\n                  <img src={image} alt=\"nft-img\" />\n                ) : fileType === \"video\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <VideoIcon />\n                  </div>\n                ) : fileType === \"audio\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <AudioIcon />\n                  </div>\n                ) : (\n                  \"\"\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\" target=\"_blank\">Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => {\n            buyNow();\n          }}\n          disabled={!checkBox || disabled || +price > +balance}\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n        >\n          {confirmed === \"pending\" ? (\n            <div className=\"spinner-border approve-spinner\" role=\"status\"></div>\n          ) : (\n            \"Confirm Checkout\"\n          )}\n        </button>\n      </Modal.Footer>\n    </Modal>\n  ) : (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal purchase-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          {!transactionSuccess\n            ? \"Your Purchase is Processing\"\n            : \"Your Purchase has processed!\"}\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        {transactionSuccess && (\n          <div className=\"modal-nft-purchased  mt-3\">\n            <p>\n              <span className=\"me-4\">\n                <img src={ModalSmiley} alt=\"smiley\" />\n              </span>\n              {`  Woo! You just Purchased ${\n                name && name.length > 10 ? name.slice(0, 10) + \"...\" : name\n              }. It should be confirmed on the\n              blockchain`}\n            </p>\n          </div>\n        )}\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                {fileType === \"image\" ? (\n                  <img src={image} alt=\"nft-img\" />\n                ) : fileType === \"video\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <VideoIcon />\n                  </div>\n                ) : fileType === \"audio\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <AudioIcon />\n                  </div>\n                ) : (\n                  \"\"\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n        <div className=\"buy-modal-subheadings-container buy-modal-status w-100 d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Status</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Transaction Hash</p>\n          </div>\n        </div>\n        <div className=\"modal-status-content d-flex align-items-center justify-content-between mt-2 pb-5\">\n          <div className=\"status-process d-flex align-items-center\">\n            {!transactionSuccess ? (\n              <>\n                <Spinner\n                  animation=\"border\"\n                  role=\"status\"\n                  size=\"sm\"\n                  variant=\"primary\"\n                  className=\"me-2\"\n                ></Spinner>\n                <p>Processing</p>\n              </>\n            ) : (\n              <>\n                <CheckCircleIcon />\n              </>\n            )}\n          </div>\n          <div\n            className=\"status-address\"\n            onClick={() =>\n              window.open(\n                `https://rinkeby.etherscan.io/tx/${transactionHash}`,\n                \"_blank\"\n              )\n            }\n          >\n            <p>\n              {transactionHash.slice(0, 6) +\n                \".....\" +\n                transactionHash.slice(-6)}\n            </p>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <p>Share</p>\n        </div>\n        <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n\n          <FbIcon className=\"social-icon\" onClick={()=>window.open(\"https://www.facebook.com/MintsClub.io/\")} />\n          <TwitterIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://twitter.com/MintsClub\")}/>\n          <LinkedinIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://www.linkedin.com/showcase/mints-club\")}/>\n          <InstaIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://www.instagram.com/mintsclub/\")}/>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\nexport default BuyModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/ApprovalModal/ApprovalModal.tsx",["643","644","645"],"import {FC} from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport { Images } from \"../../../assets/assets\";\nimport { ApprovalModalInt } from \"../../../interfaces/components\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal:FC<ApprovalModalInt> = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n  return (\n    <>\n      {\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title className=\"acc-title mt-lg-3 mt-5\">\n              {approvalStatus === \"approved\"\n                ? \"Congratulations\"\n                : approvalStatus === \"in-progress\"\n                ? \"We’re on it\"\n                : \"Your account if not approved yet.\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\" onClick={onHide}>\n              <button>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </Modal.Header>\n          <Modal.Body>\n            {approvalStatus === \"approved\" ? (\n              <>\n                <img src={Images.sellerTickIcon} className=\"success-icon\" />\n                <div className=\"w-100 px-4 mb-2\">\n                  <div className=\"acc-approved-container mt-5 mb-5\">\n                    <p className=\"acc-approved ms-4 mb-0\">\n                      Your Account has been approved.\n                    </p>\n                    <img src={Images.smile} className=\"smile-img\" />\n                  </div>\n                </div>\n              </>\n            ) : approvalStatus === \"in-progress\" ? (\n              <>\n                <div className=\"approval-spinner mb-4\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n                <p className=\"processing-title text-center w-100\">\n                  Processing...\n                </p>\n                <div className=\"w-100 px-3\">\n                  <p className=\"approve-msg text-start ms-3 mt-3 \">\n                    Wallet Address\n                  </p>\n                  <input\n                    className=\"input-common mb-5\"\n                    value={address}\n                    readOnly\n                  />\n                </div>\n              </>\n            ) : (\n              <>\n                <img\n                  src={Images.metamaskImg}\n                  className=\"approve-metamask-img\"\n                />\n                <div className=\" w-100 px-3\">\n                  <p className=\"approve-msg w-100 text-start ms-3 mt-3 \">\n                    Please approve your wallet address to reach us\n                  </p>\n                  <input className=\"input-common\" value={address} readOnly />\n                </div>\n                <button\n                  className=\"btn btn-linear-gradient mt-4 my-4 get-approved-btn\"\n                  disabled={approvalStatus === \"pending\"}\n                  onClick={() => approveAccount()}\n                >\n                  {approvalStatus === \"pending\" ? (\n                    <div\n                      className=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>\n                  ) : (\n                    \"Get Approved\"\n                  )}\n                </button>\n              </>\n            )}\n          </Modal.Body>\n        </Modal>\n       \n      }\n    </>\n  );\n};\nexport default ApprovalModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/StatsModal/StatsModal.tsx",["646"],"import {FC} from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport InputClose from \"../../../assets/images/inp-close.svg\";\nimport \"../PropertiesModal/PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"../../../utils/functions\";\nimport {StatsInt} from \"../../../interfaces/components\";\nconst StatsModal:FC<StatsInt> = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item:any) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <form>\n          <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n            {stats &&\n              stats.length > 0 &&\n              stats.map((item:any, i:any) => {\n                return (\n                  <div\n                    className=\"row g-2 align-items-center justify-content-between mt-3\"\n                    key={i}\n                  >\n                    <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                      <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                        <div className=\"ps-2\">\n                          <h6>Name:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"text\"\n                            name=\"name\"\n                            value={item.name}\n                            onKeyDown={(e) =>\n                              firstInputCharacterSpace(e, item.name.length)\n                            }\n                            onChange={(e) => handleChange(i, e, \"stats\")}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                      <div className=\"d-flex align-items-center justify-content-between\">\n                        <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                          <div className=\"ps-2\">\n                            <h6>Value:</h6>\n                          </div>\n                          <div className=\"inp-container\">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              min=\"1\"\n                              onKeyDown={(e) => {\n                                decimalNumberValidator(e);\n                              }}\n                              value={item.value}\n                              onChange={(e) => {\n                                if (\n                                  +e.target.value > 5 ||\n                                  (+e.target.value <= 0 && item.value == \"\")\n                                  ||e.target.value.includes(\".\")\n                                ) {\n                                  return \"\";\n                                }\n                                handleChange(i, e, \"stats\");\n                              }}\n                              autoComplete=\"off\"\n                            />\n                          </div>\n                        </div>\n                        <div className=\"value-inp-of mx-3\">\n                          <h6>of</h6>\n                        </div>\n                        <div className=\"bid-inp-container modal-value-inp\">\n                          <div className=\"inp-container \">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              value={5}\n                              autoComplete=\"off\"\n                              className=\"text-center\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                      <div className=\"inp-close text-end me-2\">\n                        <button type=\"submit\">\n                          <img\n                            src={InputClose}\n                            alt=\"closemodal\"\n                            onClick={() => removeFormFields(i, \"stats\")}\n                          />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n          </div>\n        </form>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/LevelsModal/LevelsModal.tsx",["647"],"import {FC} from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport InputClose from \"../../../assets/images/inp-close.svg\";\nimport \"../PropertiesModal/PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"../../../utils/functions\";\nimport { Levels } from \"../../../interfaces/components\";\nconst LevelsModal:FC<Levels> = (props) => {\n  const {\n    show,\n    onHide,\n    levels,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    onSave,\n  } = props;\n\n  const handleSubmit = () => {\n    if (levels && levels.length > 0) {\n      let isEmpty = levels.filter(\n        (item:any) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"levels\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Levels</Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {levels &&\n            levels.length > 0 &&\n            levels.map((item:any, i:number) => {\n              return (\n                <div\n                  className=\"row g-2 align-items-center justify-content-between  mt-3\"\n                  key={i}\n                >\n                  <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                    <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                      <div className=\"ps-2\">\n                        <h6>Name:</h6>\n                      </div>\n                      <div className=\"inp-container\">\n                        <input\n                          type=\"text\"\n                          name=\"name\"\n                          value={item.name}\n                          onKeyDown={(e) =>\n                            firstInputCharacterSpace(e, item.name.length)\n                          }\n                          onChange={(e) => handleChange(i, e, \"levels\")}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                    <div className=\"d-flex align-items-center justify-content-between\">\n                      <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                        <div className=\"ps-2\">\n                          <h6>Value:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={item.value}\n                            min=\"1\"\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            onChange={(e) => {\n                              if (\n                                +e.target.value > 5 ||\n                                (+e.target.value <= 0 && item.value == \"\") ||e.target.value.includes(\".\")\n                              ) {\n                                return \"\";\n                              }\n                              handleChange(i, e, \"levels\");\n                            }}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"value-inp-of mx-3\">\n                        <h6>of</h6>\n                      </div>\n                      <div className=\"bid-inp-container modal-value-inp\">\n                        <div className=\"inp-container \">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={5}\n                            autoComplete=\"off\"\n                            className=\"text-center\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                    <div className=\"inp-close text-end me-2\">\n                      <button>\n                        <img\n                          src={InputClose}\n                          alt=\"closemodal\"\n                          onClick={() => removeFormFields(i, \"levels\")}\n                        />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"levels\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3 \"\n            disabled={levels && levels.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default LevelsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/PropertiesModal/PropertiesModal.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/CardSlider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/ImageLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/CollectionSubLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/HeroCards/HeroCards.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/AuctionAudio/AuctionAudio.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/HeroLoader.tsx",["648"