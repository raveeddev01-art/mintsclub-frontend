:"535"},{"filePath":"536","messages":"537","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"538"},{"filePath":"539","messages":"540","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/index.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/store.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/App.js",["541"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\n\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\n// import 'swiper/swiper-bundle.css';\n\nconst App = () => {\n\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  useEffect(() => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={true}\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n};\n\nexport default App;\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/redux/index.js",["542"],"import { combineReducers } from 'redux'\nimport homeReducer from './../components/home/home.reducer'\nimport mintsReducer from '../redux/reducer/reducer'\nimport auctionReducer from './../components/auctions/auctions.reducer'\nimport nftReducer from './../components/nfts/nfts.reducer'\nimport userReducer from './../components/user/user.reducer'\nimport walletReducer from './../components/wallet/wallet.reducer'\nimport categoryReducer from './../components/categories/categories.reducer'\nimport collectionReducer from './../components/collections/collections.reducer'\nimport errorReducer from './shared/error/error.reducer'\nimport settingsReducer from '../components/footer/footer.reducer'\nimport faqReducer from '../components/faq/faq.reducer'\nimport offersReducer from '../components/offers/offers.reducer'\nimport bidsReducer from '../components/bids/bids.reducer'\nimport contactReducer from '../components/contact/contact.reducer'\nimport exploreAllReducer from '../components/explore/explore.reducer'\nimport createNftReducer from '../components/create-nft/create-nft-reducer'\n\nexport default combineReducers({\n    home: homeReducer,\n    dashboard:mintsReducer,\n    auction: auctionReducer,\n    nft: nftReducer,\n    user: userReducer,\n    wallet: walletReducer,\n    category: categoryReducer,\n    collection: collectionReducer,\n    error: errorReducer,\n    settings: settingsReducer,\n    faqs: faqReducer,\n    offer: offersReducer,\n    bid: bidsReducer,\n    contact: contactReducer,\n    explore:exploreAllReducer,\n    \n    \n})","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/privateRoute.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/routes.js",["543"],"import layout2 from \"./layouts/layout2/layout2\";\nimport layout3 from \"./layouts/layout3/layout3\";\nimport layout4 from \"./layouts/layout4/layout4\";\n// components\nimport Home from \"./components/home/home\";\nimport ExploreAll from \"./components/explore/explore-all\";\nimport LiveAuctions from \"./components/auctions/live-auctions-list\";\nimport ItemDetails from \"./components/item-detail/item-detail\";\nimport Activity from \"./components/activity/activity\";\nimport Blog from \"./components/blog/blog\";\nimport BlogSingle from \"./components/blog-single/blog-single\";\nimport HelpCenter from \"./components/help-center/help-center\";\nimport Populars from \"./components/popular-collections-list/popular-collections-list\";\nimport Author from \"./components/author/author\";\nimport Profile from \"./components/profile/profile\";\nimport CreateNFT from \"./components/create-nft/create-nft\";\nimport MyCollections from \"./components/collections/my-collections\";\nimport CreateCollection from \"./components/create-collection/create-collection\";\nimport CollectionDetails from \"./components/collections/collection-details\";\nimport Wallet from \"./components/wallet/wallet\";\nimport Signup from \"./components/signup/signup\";\nimport Contact from \"./components/contact/contact\";\nimport SellNFT from \"./components/sell-nft/SellNFT\";\nimport Sell from \"./components/nfts/sell-nft\";\nimport NotFound from \"./components/not-found/not-found\";\nimport HowItWorks from \"./components/how-it-works/how-it-works\";\nimport PrivacyTerms from \"./components/privacy-&-terms/privacy-&-terms\";\nimport ExploreCollections from \"./components/collections/explore-collections\";\nimport AllNFT from \"./components/explore/all-nft/allnft\";\nimport CollectionDetailsPage from \"./components/collection-details/collectiondetails\";\nimport NFTDetail from \"./components/nft-detail/nftdetail\";\nimport UserProfile from \"./components/user-profile/UserProfile\";\nimport TopSellerList from \"./components/top-seller/topsellerlist\";\nimport AuctionsList from \"./components/auctions/home-auction-list\";\nimport EditProfile from \"./components/user-profile/user-edit-profile\";\n\n// routes\nconst routes = [\n  {\n    path: \"/\",\n    access: true,\n    exact: true,\n    title: \"Home\",\n    layout: layout2,\n    component: Home,\n  },\n  {\n    path: \"/explore-all\",\n    access: true,\n    exact: true,\n    title: \"Explore\",\n    layout: layout2,\n    component: ExploreAll,\n  },\n  {\n    path: \"/auctions\",\n    access: true,\n    exact: true,\n    title: \"Live Auctions\",\n    layout: layout2,\n    component: AuctionsList,\n  },\n  {\n    path: \"/item-details\",\n    access: true,\n    exact: true,\n    title: \"Item Details\",\n    layout: layout2,\n    component: ItemDetails,\n  },\n  {\n    path: \"/sell-item/:itemId?\",\n    access: true,\n    exact: true,\n    title: \"Sell Item\",\n    layout: layout2,\n    component: SellNFT,\n  },\n  {\n    path: \"/sell\",\n    access: true,\n    exact: true,\n    title: \"Sell\",\n    layout: layout2,\n    component: Sell,\n  },\n  {\n    path: \"/activity\",\n    access: true,\n    exact: true,\n    title: \"Activity\",\n    layout: layout2,\n    component: Activity,\n  },\n  {\n    path: \"/blog\",\n    access: true,\n    exact: true,\n    title: \"Blog\",\n    layout: layout2,\n    component: Blog,\n  },\n  {\n    path: \"/blog-single\",\n    access: true,\n    exact: true,\n    title: \"Blog Single\",\n    layout: layout2,\n    component: BlogSingle,\n  },\n  {\n    path: \"/help-center\",\n    access: true,\n    exact: true,\n    title: \"Help Center\",\n    layout: layout2,\n    component: HelpCenter,\n  },\n  {\n    path: \"/popular-collections\",\n    access: true,\n    exact: true,\n    title: \"Popular Collections\",\n    layout: layout2,\n    component: Populars,\n  },\n  {\n    path: \"/top-sellers-list\",\n    access: true,\n    exact: true,\n    title: \"Popular Collections\",\n    layout: layout2,\n    component: TopSellerList,\n  },\n\n  {\n    path: \"/author/:authorId?\",\n    access: true,\n    exact: true,\n    title: \"Author Profile\",\n    layout: layout2,\n    component: Author,\n  },\n  {\n    path: \"/profile\",\n    access: true,\n    exact: true,\n    title: \"Profile\",\n    layout: layout2,\n    component: Profile,\n  },\n  {\n    path: \"/create\",\n    access: true,\n    exact: true,\n    title: \"Create\",\n    layout: layout2,\n    component: CreateNFT,\n  },\n  {\n    path: \"/nftdetail/:id\",\n    access: true,\n    exact: true,\n    title: \"Detail\",\n    layout: layout2,\n    component: NFTDetail,\n  },\n  {\n    path: \"/collections\",\n    access: true,\n    exact: true,\n    title: \"Collections\",\n    layout: layout2,\n    component: MyCollections,\n  },\n  {\n    path: \"/collection/create\",\n    access: true,\n    exact: true,\n    title: \"Create Collection\",\n    layout: layout2,\n    component: CreateCollection,\n  },\n  {\n    path: \"/collection-details/:collectionId?\",\n    access: true,\n    exact: true,\n    title: \"Collection Details\",\n    layout: layout2,\n    component: CollectionDetails,\n  },\n  {\n    path: \"/explore/exploreAll\",\n    access: true,\n    exact: true,\n    title: \"Explore All\",\n    layout: layout2,\n    component: ExploreCollections,\n  },\n  {\n    path: \"/explore/allNFT\",\n    access: true,\n    exact: true,\n    title: \"All NFTs\",\n    layout: layout2,\n    component: AllNFT,\n  },\n  {\n    path: \"/sellnft\",\n    access: true,\n    exact: true,\n    title: \"Sell NFT\",\n    layout: layout2,\n    component: SellNFT,\n  },\n  {\n    path: \"/collection/detailPage/:id\",\n    access: true,\n    exact: true,\n    title: \"Collection Detail Page\",\n    layout: layout2,\n    component: CollectionDetailsPage,\n  },\n  {\n    path: \"/userprofile\",\n    access: true,\n    exact: true,\n    title: \"User Profile\",\n    layout: layout2,\n    component: UserProfile,\n  },\n  {\n    path: \"/editprofile\",\n    access: true,\n    exact: true,\n    title: \"Edit Profile\",\n    layout: layout2,\n    component: EditProfile,\n  },\n  {\n    path: \"/login\",\n    access: true,\n    exact: true,\n    title: \"login\",\n    layout: layout4,\n    component: Wallet,\n  },\n  {\n    path: \"/signup\",\n    access: true,\n    exact: true,\n    title: \"Signup\",\n    layout: layout4,\n    component: Signup,\n  },\n  {\n    path: \"/contact\",\n    access: true,\n    exact: true,\n    title: \"Contact\",\n    layout: layout2,\n    component: Contact,\n  },\n  {\n    path: \"/how-it-works\",\n    access: true,\n    exact: true,\n    title: \"How It Works\",\n    layout: layout2,\n    component: HowItWorks,\n  },\n  {\n    path: \"/privacy-and-terms\",\n    access: true,\n    exact: true,\n    title: \"Privacy & Terms\",\n    layout: layout2,\n    component: PrivacyTerms,\n  },\n  {\n    path: \"/*\",\n    access: true,\n    exact: true,\n    name: \"Not Found\",\n    layout: layout3,\n    component: NotFound,\n  },\n];\n\nexport default routes;\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/config/config.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",["544"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/redux/reducer/reducer.js",["545"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/home/home.reducer.js",["546","547"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["548"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["549"],"import { BEFORE_NFT, GET_NFTS, GET_NFT, UPSERT_NFT,NFTALL,GET_NFTS_BY_COLLECTION, GET_MYLIKED_NFTS,GET_PROFILE_NFTS } from '../../redux/types';\n\nconst initialState = {\n    nftsData: {},\n    nftAll:{},\n    nftsAuth: false,\n    upsertAuth: false,\n    createNFTResult:[],\n    createNFTerror:false,\n    nftsByCollection:[],\n    nftsByCollectionStatus:false,\n    myLikedNfts:[],\n    myLikedNftsStatus:false,\n    profileNFTs:[],\n    profileNFTsStatus:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case UPSERT_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                upsertAuth: true\n            }\n        case GET_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n            case NFTALL:\n        \n                return {\n                    ...state,\n                    nftAll: action.payload,\n                }\n            \n        case GET_NFTS:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n        case BEFORE_NFT:\n            return {\n                ...state,\n                nftsData: {},\n                nftsAuth: false,\n                upsertAuth: false,\n                profileNFTsStatus:false,\n            }\n            \n            case GET_NFTS_BY_COLLECTION:\n                return {\n                    ...state,\n                    nftsByCollection:action.payload,\n                    nftsByCollectionStatus:true,\n\n                }\n                case  GET_MYLIKED_NFTS:\n                  \n                    return {\n                        ...state,\n                        myLikedNfts:action.payload,\n                        myLikedNftsStatus:true,\n                    }\n                    case GET_PROFILE_NFTS:\n                        return {\n                            ...state,\n                            profileNFTs:action.payload,\n                            profileNFTsStatus:true,\n                        }\n                    \n        default:\n            return {\n                ...state,\n               \n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/user/user.reducer.js",["550"],"import { BEFORE_USER, SET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, GET_USER } from '../../redux/types';\n\nconst initialState = {\n    userData: null,\n    userAuth: false,\n    creatorsAuth: false,\n    topSellersAuth: false,\n    individualUserAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_USER:\n            return {\n                ...state,\n                userData: action.payload,\n                userAuth: true\n            }\n        case GET_USER:\n            return {\n                ...state\n            }\n        case SET_CREATORS:\n            return {\n                ...state,\n                creators: action.payload,\n                creatorsAuth: true\n            }\n        case TOP_SELLERS:\n            return {\n                ...state,\n                sellers: action.payload,\n                topSellersAuth: true\n            }\n        case SET_INDIVIDUAL_USER:\n            return {\n                ...state,\n                individualUser: action.payload,\n                individualUserAuth: true\n            }\n        case BEFORE_USER:\n            return {\n                ...state,\n                userData: null,\n                userAuth: false,\n                creatorsAuth: false,\n                topSellersAuth: false,\n                individualUserAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["551"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["552"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/collections.reducer.js",["553"],"import { BEFORE_COLLECTION, GET_COLLECTION, SET_AUTH_STATE, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION,MY_COLLECTIONS, ALL_COLLECTIONS,COLLECTION_CATEGORES } from '../../redux/types';\n\nconst initialState = {\n    collection: null,\n    collections: null,\n    allCollections:null,\n    pagination: null,\n    deleteAuth: false,\n    upsertAuth: false,\n    getAuth: false,\n    categories:null,\n    collectionFlag:false,\n    myCollections:null,\n    myCollectionsResult:false,\n  \n    \n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n            case ALL_COLLECTIONS:\n                return {\n                    ...state,\n                    collection: action.payload.allCollections,\n                    getAuth: true\n                }\n        case SET_AUTH_STATE:\n            return {\n                ...state,\n                getAuth: false\n            }\n\n        case UPSERT_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                upsertAuth: true\n            }\n        case DELETE_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                deleteAuth: true\n            }\n        case GET_COLLECTIONS:\n    \n            return {\n                ...state,\n                collections: action.payload.collections,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n            case MY_COLLECTIONS:\n        \n                return {\n                    ...state,\n                    myCollections:action.payload,\n                    myCollectionsResult:true,\n                }\n            case COLLECTION_CATEGORES:\n\n                return {\n                    ...state,\n                    categories: action.payload,\n                    collectionFlag:true\n\n                 \n                }\n        case BEFORE_COLLECTION:\n         \n            return {\n                ...state,\n                collection: null,\n                collections: null,\n                pagination: null,\n                deleteAuth: false,\n                upsertAuth: false,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/footer/footer.reducer.js",["554"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/faq/faq.reducer.js",["555"],"import { BEFORE_FAQ, GET_FAQS } from '../../redux/types';\n\nconst initialState = {\n    faqs: null,\n    faqsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FAQS:\n            return {\n                ...state,\n                faqs: action.payload,\n                faqsAuth: true\n            }\n        case BEFORE_FAQ:\n            return {\n                ...state,\n                faqs: null,\n                faqsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["556"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["557"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            return {\n                ...state,\n                bids: action.payload.bids,\n                pagination: action.payload.pagination,\n                highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/contact/contact.reducer.js",["558"],"import { BEFORE_CONTACT, CREATE_CONTACT } from '../../redux/types';\n\nconst initialState = {\n    contactAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case CREATE_CONTACT:\n            return {\n                ...state,\n                contactAuth: true\n            }\n        case BEFORE_CONTACT:\n            return {\n                ...state,\n                contactAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["559"],"import { GET_COLLECTION } from '../../redux/types';\n\nconst initialState = {\n    collection:[],\n    getAuth: true\n    \n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n        \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/create-nft/create-nft-reducer.js",["560"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/home/home.js",["561","562","563","564","565","566","567","568"],"import React, { useEffect } from \"react\";\nimport { Table, Pagination } from \"react-bootstrap\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller2\";\nimport Collections from \"../collections/popular-collections\";\nimport MyCollections from \"../collections/my-collections\";\nimport Explore from \"../explore/explore-home\";\nimport Work from \"../work/work\";\nimport Authors from \"../authors/authors\";\nimport Header from \"../header/header\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n      {/* <Header /> */}\n      <NavbarMain />\n      <Hero />\n      {/* <button onClick={()=>Redirection('/explore-all')}>test cases</button>  */}\n      <Auctions />\n      {/* <AuctionsCards /> */}\n      <Work />\n      <TopSeller viewAll={\"View All\"} />\n      {/* <Collections /> */}\n      <PopularCollections />\n      {/* <CardSlider /> */}\n      {/* <Authors /> */}\n      {/* <MyCollections /> */}\n      {/* <Explore /> */}\n      <OwnCollection />\n      <Buysell />\n      <Footer />\n    </>\n  );\n}\n\nexport default Home;\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/explore/explore-all.js",["569","570","571","572","573","574","575","576","577"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFTs } from \"../nfts/nfts.action\";\nimport { ENV } from \"../../config/config\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport ExploreItems from \"./explore-items\";\nimport NftCard from \"../collections/components/NftCard/NftCard\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { getCreators, beforeUser } from \"./../user/user.action\";\n\nconst initData = {\n  pre_heading: \"Explore\",\n  heading: \"Exclusive Digital Assets\",\n  content: \"\",\n  btn_1: \"Load More\",\n};\n\nfunction ExploreAll(props) {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const pathname = useHistory().location.pathname;\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (pathname === \"/explore-all\") setIntro(true);\n    getNFTs();\n    props.getCreators();\n  }, []);\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      setCreator(props.user.sellers);\n    }\n  }, [props.user.topSellersAuth]);\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      setCreator(props.user.creators);\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nftsData } = props.nft;\n      if (nftsData) {\n        setNFTs(nftsData);\n        setNFTPagination(nftsData.pagination);\n        props.beforeNFT();\n        if (props.setLoader) props.setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  const loadMore = () => {\n    const { page, limit } = nftPagination;\n    setLoader(true);\n    getNFTs(1, limit * (page + 1));\n  };\n\n  const getNFTs = (page = 1, limit = 4) => {\n    const nftQS = { page, limit, explore: true };\n\n    if (props.collectionId) nftQS.collectionId = props.collectionId;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    props.getNFTs(qs);\n  };\n\n  return (\n    <section\n      className=\"explore-area\"\n      style={{ paddingTop: `${intro ? \"150\" : \"30\"}px` }}\n    >\n      {loader && <FullPageLoader />}\n      <div className=\"container\">\n        {intro && (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              <div className=\"intro text-center mb-4\">\n                <span>{initData.pre_heading}</span>\n                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n              </div>\n            </div>\n          </div>\n        )}\n        <div className=\"row items gx-4 explore-items\">\n          {nfts && nfts.length > 0 && creators.length > 0 ? (\n            nfts.map((item, idx) => {\n              return (\n                <div className=\"col-3 mt-5\" style={{}}>\n                  <NftCard\n                    nft={item}\n                    creators={creators}\n                    userId={ENV.getUserKeys(\"_id\")._id}\n                  />\n                </div>\n              );\n            })\n          ) : (\n            <p className=\"text-center\">No Items Found to Exploree</p>\n          )}\n        </div>\n        {loadMoreBtn && (\n          <div className=\"row\">\n            <div className=\"col-12 text-center\">\n              <a\n                id=\"load-btn\"\n                className=\"btn btn-bordered-white mt-5\"\n                onClick={() => loadMore()}\n              >\n                {initData.btn_1}\n              </a>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs, getCreators })(\n  ExploreAll\n);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/auctions/live-auctions-list.js",["578","579","580","581","582","583","584","585","586"],"import React, { useState, useEffect } from 'react';\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { beforeAuction, getLiveAuctions } from './auctions.action';\nimport { ENV } from '../../config/config';\nimport Countdown from 'react-countdown';\nimport {getCreators, beforeUser} from './../user/user.action';\nimport image from '../../assets/images/placeholder.png'\nconst { globalPlaceholderImage, countDownRenderer } = ENV\n\nconst initData = {\n    pre_heading: \"Auctions\",\n    heading: \"Live Auctions\",\n    content: \"\",\n    btn_1: \"Load More\"\n}\n\nconst LiveAuctions = (props) => {\n    const [pagination, setPagination] = useState(null);\n    const [auctions, setAuctions] = useState(null)\n    const [loader, setLoader] = useState(true) // auctions loader\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n    const [creators,setCreator]=useState([])\n\n    useEffect(() => {\n        window.scroll(0, 0)\n        // get live auctions\n        getLiveAuctions()\n        props.getCreators()\n    }, [])\n\n    useEffect(()=>{\n      \n        if(props.user.topSellersAuth ){\n        //    console.log(props.user.sellers,\"sellers blah blah blah\");\n           setCreator(props.user.sellers)\n           setLoader(false)\n           \n        }\n      },[props.user.topSellersAuth])\n    // set live auctions\n    useEffect(() => {\n        if (props.auction.getAuth) {\n            const { auctions, pagination } = props.auction\n            if (auctions) {\n                setAuctions(auctions)\n                setPagination(pagination)\n                props.beforeAuction()\n             \n            }\n        }\n    }, [props.auction.getAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (pagination)\n            setLoadMoreBtn((pagination.total > 0 && pagination.total > auctions.length && auctions.length > 0))\n    }, [pagination])\n\n    const loadMore = () => {\n        const { page, limit } = pagination\n        setLoader(true)\n\n        // get more live auctions\n        getLiveAuctions(1, limit * (page + 1))\n    }\n\n    const getLiveAuctions = (page = 1, limit = 8) => {\n        const qs = ENV.objectToQueryString({ page, limit })\n        props.getLiveAuctions(qs)\n    }\n    const filterCreator=(nft,field)=>{\n        const result= creators.find((item)=>item._id===nft.nftOwnerId)\n     \n        if(field===\"userName\"){\n\n         if(result?.username){\n       \n             return result?.username\n         }\n         else {\n             return \"no username found\"\n         }\n        }\n        else if(field==\"profileImage\"){\n            if(result?.profileImage)\n            {\n\n                return result?.profileImage\n            }\n            else {\n                return image\n            }\n        }\n\n\n       }\n\n\n\n    return (\n        <section className=\"live-auctions-area load-more padding-wrapper\">\n            {\n                loader ?\n                    <FullPageLoader /> :\n                    <div className=\"container\">\n                        <div className=\"row justify-content-center\">\n                            <div className=\"col-12 col-md-8 col-lg-7\">\n                                {/* Intro */}\n                                <div className=\"intro text-center\">\n                                    <span>{initData.pre_heading}</span>\n                                    <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                                    <p>{initData.content}</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"row items\">\n                            {auctions && auctions.length > 0 ?\n                                auctions.map((item, idx) => {\n                                    return (\n                                        <div className=\"col-4\" key={`auc_${idx}`} id={`#auc-${idx}`}>\n                                            <div className=\"card m-3\">\n                                                <div className=\"image-over\">\n                                                    <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                                        <img className=\"card-img-top\" src={item.image} alt=\"NFT image\" width=\"600\" height=\"600\" />\n                                                    </Link>\n                                                </div>\n                                                <div className=\"card-caption col-12 p-0\">\n                                                    <div className=\"card-body\">\n                                                        <div className=\"mb-3\">\n                                                            <Countdown\n                                                                // date={new Date(item.auctionEndDate) + 10000}\n                                                                date={1651851923270}\n                                                                renderer={countDownRenderer}\n                                                            />\n                                                        </div>\n                                                        <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                                            <h5 className=\"mb-0\">{item.name}</h5>\n                                                        </Link>\n                                                        <Link className=\"seller d-flex align-items-center my-3\" to={`/author`}>\n                                                            \n                                                           <img className=\"avatar-sm rounded-circle\" src={filterCreator(item,\"profileImage\")} alt=\"User Avatar\" />\n                                                             <span className=\"ml-2\">{filterCreator(item,\"userName\")}</span> \n                                                        </Link>\n                                                        <div className=\"card-bottom d-flex justify-content-between\">\n                                                            <span>{item.currentPrice} {ENV.currency}</span>\n                                                            <span>{item.sold} of {item.copies}</span>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    );\n                                })\n                                : <p className=\"text-center ml-3\">No Live Auctions Found</p>\n                            }\n                        </div>\n                        {\n                            loadMoreBtn &&\n                            <div className=\"row\">\n                                <div className=\"col-12 text-center\">\n                                    <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                                </div>\n                            </div>\n                        }\n                    </div>\n            }\n        </section>\n    );\n}\n\nconst mapStateToProps = state => ({\n    auction: state.auction,\n    error: state.error,\n    user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeAuction,getCreators, getLiveAuctions })(LiveAuctions);","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/my-collections.js",["587","588"],"import React, { useState, useEffect, useRef } from 'react';\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { beforeCategory, getCategories } from '../categories/categories.action';\nimport Collections from './collections';\n\nconst initData = {\n    pre_heading: \"Collections\",\n    heading: \"My Collections\",\n    content: \"\",\n    btnText: \"Create New\"\n}\n\nconst MyCollections = (props) => {\n    const [categories, setCategories] = useState(null)\n    const [categoriesLoader, setCatLoader] = useState(true) // categories loader\n    const [collectionsLoader, setColLoader] = useState(true) // collections loader\n    const collectionsRef = useRef(null)\n\n    useEffect(() => {\n        window.scroll(0, 0)\n        props.getCategories()\n    }, [])\n\n    // when categories data is received\n    useEffect(() => {\n        if (props.category.getAuth) {\n            const { categories } = props.category\n            const allCat = { active: true, name: 'all' }\n            setCategories([allCat, ...categories])\n            props.beforeCategory()\n            setCatLoader(false)\n        }\n    }, [props.category.getAuth])\n\n    const getColLoader = (loader) => {\n        setColLoader(loader)\n    }\n\n    const getCatCollections = (catId) => {\n        collectionsRef.current?.getCatCollections(catId)\n    }\n    // alert(\"cdskjfdkjf\")\n  console.log(categories,\"categories==>\")\n    return (\n        <>\n            {(categoriesLoader || collectionsLoader) && <FullPageLoader />}\n            <section className=\"explore-area padding-wrapper\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12\">\n                            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                                <div className=\"intro-content\">\n                                    <span>{initData.pre_heading}</span>\n                                    <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                                </div>\n                                <div className=\"intro-btn\">\n                                    <Link className=\"btn content-btn text-left\" to=\"/collection/create\">{initData.btnText}</Link>\n                                </div>\n                            </div>\n                            <div className=\"intro my-3\">\n                                <p>{initData.content}</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div className=\"row justify-content-center text-center\">\n                        <div className=\"col-12\">\n                            {/* Explore Menu */}\n                            <div className=\"explore-menu btn-group btn-group-toggle flex-wrap justify-content-center text-center mb-4\" data-toggle=\"buttons\">\n                                {\n                                    categories && categories.length > 0 &&\n                                    categories.map((item, index) => {\n                                        return (\n                                            <label onClick={() => getCatCollections(item._id)} key={`cat_${index}`} className={`btn ${item.active ? 'active' : ''} d-table text-uppercase p-2`}>\n                                                <input type=\"radio\" defaultValue={item.name} defaultChecked className=\"explore-btn\" />\n                                                <span>{item.name}</span>\n                                            </label>\n                                        )\n                                    })\n                                }\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <Collections all={true} userId='61408000cef27850fdea272b' setLoader={getColLoader} ref={collectionsRef} mycollections />\n            </section>\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    error: state.error,\n    category: state.category\n});\n\nexport default connect(mapStateToProps, { beforeCategory, getCategories })(MyCollections);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/collection-details.js",["589","590","591","592","593","594","595","596","597","598","599","600","601","602","603","604","605","606","607"],"import React, { useState, useEffect, useRef } from \"react\";\nimport CollectionPreview from \"./collection-preview\";\nimport Explore from \"../explore/explore-all\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection, getCollection } from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"../../config/config\";\nimport { Accordion, Dropdown } from \"react-bootstrap\";\nimport Select from 'react-select'\nimport FilterSearch from \"../filter-search/filtersearch\";\nimport NftCard from './components/NftCard/NftCard';\nimport {getNFTs} from '../nfts/nfts.action'\nimport {getCreators, beforeUser} from './../user/user.action';\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV;\n\nconst CollectionDetails = (props) => {\n  const [collection, setCollection] = useState(null);\n  const [nfts, setNfts] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [limit, setLimit] = useState(2);\n  const [collectionLoader, setColLoader] = useState(true); // collections loader\n  const [nftsLoader, setNftsLoader] = useState(true); // NFTs loader\n  const [creators,setCreator]=useState([])\n  const nftsRef = useRef(null);\n\n  useEffect(() => {\n   \n    props.getNFTs()\n    window.scroll(0, 0);\n    const { collectionId } = props.match.params;\n    if (collectionId) props.getCollection(window.atob(collectionId));\n    else props.history.push(\"/collections\");\n  }, []);\n\n  // when collection data is received\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collection } = props.collection;\n  \n      setCollection(collection);\n      props.beforeCollection();\n      setColLoader(false);\n    }\n  }, [props.collection.getAuth]);\n   \n  useEffect(()=>{\n      \n    if(props.user.topSellersAuth ){\n    \n       setCreator(props.user.sellers)\n\n    }\n  },[props.user.topSellersAuth])\n\n  // handle show load more button state when pagination is set\n  useEffect(() => {\n   \n    if (nftPagination)\n        setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length && nfts.length > 0))\n  }, [nftPagination])\n\n  const loadMore = () => {\n    \n    // const { page, limit } = nftPagination\n    setLoader(true)\n    setLimit(limit + 2)\n    // get more NFTs for explore section\n    // getNFTs(1, limit * (page + 1));\n  }\n\n  const filterNfts=(nfts)=>{\n\n    if(collection)\n    {\n      const result_nft = nfts.filter((nft)=>nft?.collectionId===collection._id);\n      nfts.pagination = { page: 1, limit: 10, total: result_nft.length, pages: 1 }\n      setNfts(result_nft.slice(0, limit));\n      setNFTPagination(nfts.pagination)\n      getNftsLoader(false);\n    }\n  }\n\n\n\n\n  const getNFTs = (page = 1, limit = 2) => {\n      const nftQS = { page, limit }\n      if (props.collectionId)\n          nftQS.collectionId = props.collectionId\n      const qs = ENV.objectToQueryString(nftQS)\n      props.getNFTs(qs)\n  }\n\n  useEffect(()=>{\n    if(props.nft.nftsAuth)\n    {\n      const {nftsData}=props.nft;\n      filterNfts(nftsData)  \n    }\n\n  },[props?.nft?.nftsAuth,collection, limit])\n\n\n\n  const getNftsLoader = (loader) => {\n    setNftsLoader(loader);\n  };\n\n  return (\n    <section\n      className=\"author-area explore-area  popular-collections-area\"\n      style={{ padding: \"0px\" }}\n    >\n      {(collectionLoader || nftsLoader) && <FullPageLoader />}\n      <div className=\"\">\n        {collection  && (\n          <div className=\"row p-5\" style={{width:\"80%\",margin:\"auto\"}}>\n            <div className=\"col-4 p-4\">\n              <CollectionPreview collection={collection} creators={creators} />\n            </div>\n            <div className=\"col-8 \">\n              <div className=\"row justify-content-center mt-5\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  <div className=\"intro text-center mb-4\">\n                      {/* <span>{initData.pre_heading}</span> */}\n                      <span>Explore</span>\n                      {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                          <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row gx-5 p-4\">\n              \n                {\n                  nfts && creators && nfts.map((nft)=>{\n                  return (\n                    <div className=\"col-6 mt-5\" style={{}}>\n                      <NftCard nft={nft} creators={creators}/>\n                    </div>\n                    )\n                  })\n                }\n                {\n                  loadMoreBtn &&\n                  <div className=\"row w-100\">\n                      <div className=\"col-12 w-100 text-center\">\n                          <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>Load More</a>\n                      </div>\n                  </div>\n                }\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  {\n\n  error: state.error,\n  collection: state.collection,\n  nft:state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollection,\n  getNFTs,\n  getCreators\n})(CollectionDetails);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/contact/contact.js",["608"],"import { useEffect, useState } from 'react';\r\n\r\nimport validator from 'validator';\r\nimport { connect } from \"react-redux\";\r\nimport { beforeContact, submitContact } from \"./contact.action\";\r\n\r\nimport Alert from 'react-bootstrap/Alert'\r\n\r\nconst Contact = (props) => {\r\n\r\n    const [data, setData] = useState({\r\n        name: '',\r\n        email: '',\r\n        subject: '',\r\n        message: ''\r\n    })\r\n\r\n    const [msg, setMsg] = useState({\r\n        name: '',\r\n        email: '',\r\n        subject: '',\r\n        message: ''\r\n    })\r\n\r\n    const [submitCheck, setSubmitCheck] = useState(false)\r\n    const [alertCheck, setAlertCheck] = useState(false)\r\n\r\n    useEffect(() => {\r\n        window.scroll(0, 0)\r\n    }, [])\r\n\r\n    useEffect(() => {\r\n        if (props.contact.contactAuth) {\r\n            setAlertCheck(true)\r\n            setTimeout(()=>{\r\n                setAlertCheck(false)\r\n            }, 3000)\r\n            props.beforeContact()\r\n        }\r\n    }, [props.contact.contactAuth])\r\n\r\n    const showAlert = () => {\r\n        if (alertCheck) {\r\n            return (\r\n                <Alert variant=\"success\" onClose={() => setAlertCheck(false)} dismissible>\r\n                    <span>\r\n                        Contact message sent successfully.\r\n                    </span>\r\n                </Alert>\r\n            );\r\n        }\r\n    }\r\n\r\n    const formSubmission = (e) => {\r\n        e.preventDefault()\r\n        setSubmitCheck(true)\r\n        if (!validator.isEmpty(data.name) && validator.isEmail(data.email)\r\n            && !validator.isEmpty(data.subject) && !validator.isEmpty(data.message)) {\r\n            let formData = new FormData()\r\n            for (const key in data)\r\n                formData.append(key, data[key])\r\n            props.submitContact(formData)\r\n            setData({ name: '', email: '', subject: '', message: '' })\r\n            setMsg({ name: '', email: '', subject: '', message: '' })\r\n            e.target[0].value = ''\r\n            e.target[1].value = ''\r\n            e.target[2].value = ''\r\n            e.target[3].value = ''\r\n        }\r\n        else {\r\n            let name = ''\r\n            let email = ''\r\n            let subject = ''\r\n            let message = ''\r\n            if (validator.isEmpty(data.name)) {\r\n                name = 'Name Is Required.'\r\n            }\r\n            if (!validator.isEmail(data.email)) {\r\n                email = 'Email Is Required.'\r\n            }\r\n            if (validator.isEmpty(data.subject)) {\r\n                subject = 'Subject Is Required.'\r\n            }\r\n            if (validator.isEmpty(data.message)) {\r\n                message = 'Message Is Required.'\r\n            }\r\n            setMsg({ name, email, subject, message })\r\n        }\r\n    }\r\n\r\n    return (\r\n        <section className=\"author-area\">\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>{\"Contact\"}</span>\r\n                            <h3 className=\"mt-3 mb-0\">{\"Get In Touch\"}</h3>\r\n                        </div>\r\n                        {/* Item Form */}\r\n                        <form id=\"contact-form\" className=\"item-form card no-hover\" onSubmit={(e) => formSubmission(e)}>\r\n                            <div className=\"row\">\r\n                                <div className=\"col-12\">\r\n                                    {showAlert()}\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"name\" placeholder=\"Name\" value={data.name}\r\n                                            id=\"contact-name\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, name: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, name: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, name: 'Name Is Required.' })\r\n                                                    }\r\n\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.name ? `` : `d-none`}`}>{msg.name}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"email\" placeholder=\"Email\" value={data.email}\r\n                                            id=\"contact-email\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, email: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (validator.isEmail(e.target.value)) {\r\n                                                        setMsg({ ...msg, email: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, email: 'Email Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.email ? `` : `d-none`}`}>{msg.email}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"subject\" placeholder=\"Subject\" value={data.subject}\r\n                                            id=\"contact-subject\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, subject: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, subject: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, subject: 'Subject Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            }\r\n                                        />\r\n                                        <label className={`text-danger pl-1 ${msg.subject ? `` : `d-none`}`}>{msg.subject}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <textarea className=\"form-control\" name=\"message\" placeholder=\"Message\" cols={30} rows={3} defaultValue={\"\"} value={data.message}\r\n                                            id=\"contact-message\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, message: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, message: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, message: 'Message Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.message ? `` : `d-none`}`}>{msg.message}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <button className=\"btn w-100 mt-3 mt-sm-4\" type=\"submit\"><i className=\"icon-paper-plane mr-2\" />Send Message</button>\r\n                                </div>\r\n                            </div>\r\n                        </form>\r\n                        <p className=\"form-message\" />\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n    error: state.error,\r\n    contact: state.contact,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeContact, submitContact })(Contact);","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/nfts/sell-nft.js",["609","610","611","612","613","614","615","616","617","618","619","620","621","622"],"import React, { useState, useEffect } from \"react\";\r\nimport { Container, Row, Col, Nav } from \"react-bootstrap\";\r\nimport Tab from \"react-bootstrap/Tab\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeNFT, getNFT, upsertNFT } from \"./nfts.action\";\r\nimport { useLocation } from \"react-router-dom\";\r\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\r\nimport NFTPreview from \"../nft-preview/nft-preview\";\r\nimport { decimalNumberValidator } from \"../../utils/functions\";\r\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\r\nimport \"bootstrap-daterangepicker/daterangepicker.css\";\r\nimport moment from \"moment\";\r\nimport currencyIcon from \"../../assets/images/binance.svg\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { openNFTForBidding } from \"../../utils/web3\";\r\nimport { SellOnFixedPrice } from \"../../utils/web3\";\r\nimport { toast } from \"react-toastify\";\r\nconst { currencies, dateRangeInitialSettings, serviceFee } = ENV;\r\n\r\nconst config1 = {\r\n  price: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n  listingSchedule: {\r\n    startDate: moment(),\r\n    endDate: moment().add(6, \"months\"),\r\n    startTime: moment(new Date()).format(\"HH:mm\"),\r\n    endTime: \"23:59\",\r\n  },\r\n  reserveFor: \"\", // if user selects reserve buyer\r\n};\r\nconst config2 = {\r\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\r\n  startPrice: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n  duration: {\r\n    startDate: moment(),\r\n    endDate: moment().add(6, \"months\"),\r\n    startTime: moment(new Date()).format(\"HH:mm\"),\r\n    endTime: \"23:59\",\r\n  },\r\n  // if user includes reserve price\r\n  reservePrice: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n};\r\n\r\nconst Sell = (props) => {\r\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\r\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\r\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\r\n  const [nft, setNft] = useState(null);\r\n  const [loader, setLoader] = useState(true); // NFT loader\r\n  const [reserveBuyer, setReserveBuyer] = useState(false);\r\n  const [reservePrice, setReservePrice] = useState(false);\r\n  const [tokensData, setTokensData] = useState([]);\r\n  const location = useLocation();\r\n  console.log(location.state, \"location.state\");\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    const { itemId } = props.match.params;\r\n    // if (itemId) props.getNFT(window.atob(itemId));\r\n    // else props.history.push(\"/explore-all\");\r\n    getTokens();\r\n  }, []);\r\n\r\n  // when NFT data is received\r\n  useEffect(() => {\r\n    if (props.nft.nftsAuth) {\r\n      const nft = props.nft.nftsData;\r\n      setNft(nft);\r\n      setLoader(false);\r\n      props.beforeNFT();\r\n    }\r\n  }, [props.nft.nftsAuth]);\r\n\r\n  // when NFT data is updated\r\n  useEffect(() => {\r\n    if (props.nft.upsertAuth) {\r\n      const { nft } = props.nft.nftsData;\r\n      // const pathname = nft.sellingMethod === 1 ? '/explore-all' : '/auctions'\r\n      const pathname = \"/\";\r\n      setLoader(false);\r\n      props.beforeNFT();\r\n      props.history.push(pathname);\r\n    }\r\n  }, [props.nft.upsertAuth]);\r\n\r\n  // when an error is received\r\n  useEffect(() => {\r\n    setLoader(false);\r\n  }, [props.error]);\r\n\r\n  const onChange = (e) => {\r\n    const { name, value } = e.target;\r\n    let data = null;\r\n    if (sellingMethod === 1) data = fixedPriceConfig;\r\n    else data = timedAuctionConfig;\r\n\r\n    console.log(data,\"data\")\r\n    const keys = name.split(\".\"); // fixedPriceConfig, price, currency\r\n    if (keys && keys[2]) data[keys[1]][keys[2]] = value;\r\n    else if (keys && keys[1]) data[keys[1]] = value;\r\n    console.log(keys,\"keys\")\r\n\r\n    if (sellingMethod === 1) setFixedPriceConfig({ ...data });\r\n    else setTimedAuctionConfig({ ...data });\r\n  };\r\n\r\n  const handleDateChange = (e, picker) => {\r\n    const { name } = e.target;\r\n    const { startDate, endDate } = picker;\r\n\r\n    // set start date\r\n    onChange({\r\n      target: {\r\n        name: `${name}.startDate`,\r\n        value: startDate,\r\n      },\r\n    });\r\n\r\n    // set end date\r\n    onChange({\r\n      target: {\r\n        name: `${name}.endDate`,\r\n        value: endDate,\r\n      },\r\n    });\r\n  };\r\n\r\n  const submit = () => {\r\n    const payload = {\r\n      _id: location.state._id,\r\n      sellingMethod,\r\n      sellingConfig: JSON.stringify(\r\n        sellingMethod === 1 ? fixedPriceConfig : timedAuctionConfig\r\n      ),\r\n    };\r\n    console.log(\r\n      \"🚀 ~ file: sell-nft.js ~ line 172 ~ submit ~ timedAuctionConfig\",\r\n      payload\r\n    );\r\n    console.log(payload, \"paylaod=>\");\r\n    //  return  \" \"\r\n\r\n    let test = new Date(timedAuctionConfig.duration.endDate).getTime();\r\n    let time = timedAuctionConfig.duration.endTime;\r\n\r\n    var r = Number(time.split(\":\")[0]) * 60 + Number(time.split(\":\")[1]) * 1000;\r\n    //\r\n    const timeInMiliSeconds = r + test;\r\n\r\n    // console.log('yoken data', tokensData)\r\n    // const nftToken=tokensData.data.find((item)=>item?.nftId===nft?._id)\r\n\r\n    //  if(nftToken){\r\n    //   sellingMethod==1?SellOnFixedPrice(nftToken?.nftToken,fixedPriceConfig.price.amount):openNFTForBidding(nftToken.nftToken,timeInMiliSeconds)\r\n\r\n    setLoader(true);\r\n\r\n    var formData = new FormData();\r\n    console.log(payload, \"payload\");\r\n    for (const key in payload) formData.append(key, payload[key]);\r\n\r\n    props.upsertNFT(\"edit\", formData, \"PUT\");\r\n    //  }\r\n    //  else {\r\n    //   toast.error(\"there was an issue while creating nft, please try later\")\r\n    //  }\r\n  };\r\n\r\n  const getTokens = () => {\r\n    const url = process.env.REACT_APP_BASE_URL + \"nftTokens/tokens\";\r\n\r\n    fetch(url, {\r\n      method: \"GET\",\r\n      headers: {\r\n        \"content-type\": \"application/json\",\r\n        Authorization: ENV.Authorization,\r\n        \"x-auth-token\": ENV.x_auth_token,\r\n        \"Access-Control-Allow-Origin\": \"*\",\r\n        \"x-access-token\":\r\n          ENV.getUserKeys(\"accessToken\") &&\r\n          ENV.getUserKeys(\"accessToken\").accessToken\r\n            ? ENV.getUserKeys(\"accessToken\").accessToken\r\n            : \"\",\r\n      },\r\n    })\r\n      .then((res) => res.json())\r\n      .then((data) => {\r\n        setTokensData(data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(error, \"error in catch blcok\");\r\n      });\r\n  };\r\n\r\n  console.log(nft, \"nft\");\r\n\r\n  return (\r\n    <div className=\"padding-wrapper\">\r\n      {loader && <FullPageLoader />}\r\n      <div\r\n        className=\"\"\r\n        style={{\r\n          maxWidth: \"85%\",\r\n          margin: \"auto\",\r\n        }}\r\n      >\r\n        <div className=\"d-flex\">\r\n          <div className=\"tabs-container\">\r\n            <span className=\"head-wrapper\">List of Bundle for Sale</span>\r\n            <div className=\"market-tabs-wrapper\">\r\n              <Tab.Container\r\n                id=\"marketplace-tabs\"\r\n                defaultActiveKey=\"fixedPrice\"\r\n              >\r\n                <Row>\r\n                  <Col lg=\"12\" md=\"12\" sm=\"12\" xs=\"12\">\r\n                    <Nav variant=\"pills\" className=\"flex-row\">\r\n                      <Nav.Item className=\"nav-item-wrapper\">\r\n                        <div className=\"mb-2\">Type</div>\r\n                        <Nav.Link\r\n                          eventKey=\"fixedPrice\"\r\n                          onClick={() => setSellingMethod(1)}\r\n                        >\r\n                          <i className=\"fas fa-dollar-sign\" />\r\n                          <div>Fixed Price</div>\r\n                        </Nav.Link>\r\n                      </Nav.Item>\r\n                      <Nav.Item className=\"nav-item-wrapper\">\r\n                        <div className=\"text-right mr-4 mb-2\">\r\n                          <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                        </div>\r\n                        <Nav.Link\r\n                          eventKey=\"timedAuction\"\r\n                          onClick={() => setSellingMethod(2)}\r\n                        >\r\n                          <i className=\"fas fa-clock\" />\r\n                          <div>Timed Auction</div>\r\n                        </Nav.Link>\r\n                      </Nav.Item>\r\n                    </Nav>\r\n                  </Col>\r\n                </Row>\r\n                <div className=\"market-tab-content\">\r\n                  <Container fluid>\r\n                    <Tab.Content>\r\n                      <Tab.Pane eventKey=\"fixedPrice\">\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text position-relative\">\r\n                            <div className=\"text-white mb-2 absolute-wrapper\">\r\n                              <b>Price</b>\r\n                            </div>\r\n                            <div className=\"text-right mb-2\">\r\n                              <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                            </div>\r\n                            <div className=\"d-flex\">\r\n                              <button type=\"button\" className=\"ethereum-btn\">\r\n                                <svg\r\n                                  viewBox=\"0 0 126.61 126.61\"\r\n                                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                                  fill=\"currentColor\"\r\n                                  height=\"18\"\r\n                                  width=\"18\"\r\n                                >\r\n                                  <g>\r\n                                    <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                    <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                    <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                    <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                    <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                  </g>\r\n                                </svg>\r\n                                <span className=\"ml-2\">{ENV.currency}</span>\r\n                              </button>\r\n                              <input\r\n                                type=\"text\"\r\n                                name=\"fixedPriceConfig.price.amount\"\r\n                                placeholder=\"Amount\"\r\n                                className=\"amount-btn ml-3\"\r\n                                style={{\r\n                                  borderRadius: \"4px\",\r\n                                }}\r\n                                onChange={(e) => onChange(e)}\r\n                                onKeyDown={(e) => decimalNumberValidator(e)}\r\n                                defaultValue={fixedPriceConfig.price.amount}\r\n                                required\r\n                              />\r\n                              {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                $ 0.00\r\n                              </div> */}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>Schedule Listing</b>\r\n                            </div>\r\n                            <div className=\"date-picker\">\r\n                              <DateRangePicker\r\n                                initialSettings={dateRangeInitialSettings}\r\n                                onApply={handleDateChange}\r\n                              >\r\n                                <button\r\n                                  name=\"fixedPriceConfig.listingSchedule\"\r\n                                  className=\"calender-btn\"\r\n                                >\r\n                                  {fixedPriceConfig.listingSchedule.startDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}{\" \"}\r\n                                  -{\" \"}\r\n                                  {fixedPriceConfig.listingSchedule.endDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}\r\n                                  &nbsp;&nbsp;&nbsp;\r\n                                  <i className=\"fas fa-calendar-week\" />\r\n                                </button>\r\n                              </DateRangePicker>\r\n                            </div>\r\n\r\n                            <div className=\"row\">\r\n                              <div className=\"mr-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"fixedPriceConfig.listingSchedule.startTime\"\r\n                                  placeholder=\"Start Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    fixedPriceConfig.listingSchedule.startTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n\r\n                              <div className=\"ml-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"fixedPriceConfig.listingSchedule.endTime\"\r\n                                  placeholder=\"End Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    fixedPriceConfig.listingSchedule.endTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        {/* <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>\r\n                                Reserve for\r\n                                specific buyer\r\n                              </b>\r\n                            </div>\r\n                          </div>\r\n                          <div>\r\n                            <label className=\"switch\">\r\n                              <input\r\n                                type=\"checkbox\"\r\n                                checked={\r\n                                  reserveBuyer\r\n                                }\r\n                                onChange={() =>\r\n                                  setReserveBuyer(\r\n                                    !reserveBuyer\r\n                                  )\r\n                                }\r\n                              />\r\n                              <span className=\"slider round\"></span>\r\n                            </label>\r\n                          </div>\r\n                        </div> */}\r\n                        {reserveBuyer && (\r\n                          <div\r\n                            className=\"mb-3 budle-wrapper\"\r\n                            style={{\r\n                              borderBottom: \"1px solid\",\r\n                              paddingBottom: \"2rem\",\r\n                            }}\r\n                          >\r\n                            <span>\r\n                              <input\r\n                                type=\"text\"\r\n                                placeholder=\"0xf45a189...\"\r\n                                required\r\n                                defaultValue={fixedPriceConfig.reserveFor}\r\n                                onChange={(e) => onChange(e)}\r\n                                name=\"fixedPriceConfig.reserveFor\"\r\n                              />\r\n                            </span>\r\n                          </div>\r\n                        )}\r\n                      </Tab.Pane>\r\n                      <Tab.Pane eventKey=\"timedAuction\">\r\n                        <div className=\"form-group\">\r\n                          <label htmlFor=\"method\" className=\"text-white mb-2\">\r\n                            <b>Method</b>\r\n                          </label>\r\n                          <select\r\n                            className=\"form-control\"\r\n                            id=\"timed-auction-method\"\r\n                            name=\"timedAuctionConfig.method\"\r\n                            onChange={(e) => onChange(e)}\r\n                          >\r\n                            <option value={1}>\r\n                              Sell to the highest bidder\r\n                            </option>\r\n                            {/* <option value={2}>\r\n                              Sell with the\r\n                              declining price\r\n                            </option> */}\r\n                          </select>\r\n                        </div>\r\n\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text position-relative\">\r\n                            <div className=\"text-white mb-2 absolute-wrapper\">\r\n                              <b>Starting Price</b>\r\n                            </div>\r\n                            <div className=\"text-right mb-2\">\r\n                              <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                            </div>\r\n                            <div className=\"d-flex\">\r\n                              <button type=\"button\" className=\"ethereum-btn\">\r\n                                <svg\r\n                                  viewBox=\"0 0 126.61 126.61\"\r\n                                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                                  fill=\"currentColor\"\r\n                                  height=\"18\"\r\n                                  width=\"18\"\r\n                                >\r\n                                  <g>\r\n                                    <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                    <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                    <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                    <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                    <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                  </g>\r\n                                </svg>\r\n                                <span className=\"ml-2\">{ENV.currency}</span>\r\n                              </button>\r\n                              <input\r\n                                type=\"text\"\r\n                                name=\"timedAuctionConfig.startPrice.amount\"\r\n                                placeholder=\"Amount\"\r\n                                className=\"amount-btn ml-3\"\r\n                                style={{\r\n                                  borderRadius: \"4px\",\r\n                                }}\r\n                                onChange={(e) => onChange(e)}\r\n                                onKeyDown={(e) => decimalNumberValidator(e)}\r\n                                defaultValue={\r\n                                  timedAuctionConfig.startPrice.amount\r\n                                }\r\n                                required\r\n                              />\r\n                              {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                $ 0.00\r\n                              </div> */}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>Duration</b>\r\n                            </div>\r\n                            <div className=\"date-picker\">\r\n                              <DateRangePicker\r\n                                initialSettings={dateRangeInitialSettings}\r\n                                onApply={handleDateChange}\r\n                              >\r\n                                <button\r\n                                  name=\"timedAuctionConfig.duration\"\r\n                                  className=\"calender-btn\"\r\n                                >\r\n                                  <i className=\"fas fa-calendar-week\" />\r\n                                  &nbsp;&nbsp;&nbsp;\r\n                                  {timedAuctionConfig.duration.startDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}{\" \"}\r\n                                  -{\" \"}\r\n                                  {timedAuctionConfig.duration.endDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}\r\n                                </button>\r\n                              </DateRangePicker>\r\n                            </div>\r\n\r\n                            <div className=\"row\">\r\n                              <div className=\"mr-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"timedAuctionConfig.duration.startTime\"\r\n                                  placeholder=\"Start Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    timedAuctionConfig.duration.startTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n\r\n                              <div className=\"ml-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"timedAuctionConfig.duration.endTime\"\r\n                                  placeholder=\"End Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    timedAuctionConfig.duration.endTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        {/* <div className=\"reverse-price d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>\r\n                                Include reserve\r\n                                price\r\n                              </b>\r\n                            </div>\r\n                          </div>\r\n                          <div>\r\n                            <label className=\"switch\">\r\n                              <input\r\n                                type=\"checkbox\"\r\n                                checked={\r\n                                  reservePrice\r\n                                }\r\n                                onChange={() =>\r\n                                  setReservePrice(\r\n                                    !reservePrice\r\n                                  )\r\n                                }\r\n                              />\r\n                              <span className=\"slider round\"></span>\r\n                            </label>\r\n                          </div>\r\n                        </div> */}\r\n                        {reservePrice && (\r\n                          <div className=\"d-flex\">\r\n                            <button type=\"button\" className=\"ethereum-btn\">\r\n                              <svg\r\n                                viewBox=\"0 0 126.61 126.61\"\r\n                                xmlns=\"http://www.w3.org/2000/svg\"\r\n                                fill=\"currentColor\"\r\n                                height=\"18\"\r\n                                width=\"18\"\r\n                              >\r\n                                <g>\r\n                                  <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                  <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                  <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                  <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                  <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                </g>\r\n                              </svg>\r\n                              <span className=\"ml-2\">{ENV.currency}</span>\r\n                            </button>\r\n                            <input\r\n                              type=\"text\"\r\n                              name=\"timedAuctionConfig.reservePrice.amount\"\r\n                              placeholder=\"Amount\"\r\n                              className=\"amount-btn ml-3\"\r\n                              style={{\r\n                                borderRadius: \"4px\",\r\n                              }}\r\n                              onChange={(e) => onChange(e)}\r\n                              onKeyDown={(e) => decimalNumberValidator(e)}\r\n                              defaultValue={\r\n                                timedAuctionConfig.reservePrice.amount\r\n                              }\r\n                              required\r\n                            />\r\n                            {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                              $ 0.00\r\n                            </div> */}\r\n                          </div>\r\n                        )}\r\n                      </Tab.Pane>\r\n                    </Tab.Content>\r\n\r\n                    <div className=\"d-flex justify-content-between my-3 text-white\">\r\n                      <div>\r\n                        <b>Fees</b>\r\n                      </div>\r\n                      <div>\r\n                        <i className=\"fas fa-exclamation-circle\" />\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"d-flex justify-content-between text-white mb-4\">\r\n                      <div>Service Fee</div>\r\n                      <div>{serviceFee}%</div>\r\n                    </div>\r\n                    <div className=\"d-flex justify-content-between text-white mb-4\">\r\n                      <div>Creator Royalty</div>\r\n                      <div>{nft?.royalty || 0}%</div>\r\n                    </div>\r\n\r\n                    <button\r\n                      className=\"complete-listing-btn p-3\"\r\n                      onClick={() => submit()}\r\n                    >\r\n                      Complete Listing\r\n                    </button>\r\n                  </Container>\r\n                </div>\r\n              </Tab.Container>\r\n            </div>\r\n          </div>\r\n          <div className=\"summary-container\">\r\n            {nft && <NFTPreview {...nft} />}\r\n            {/* IMPORTED NFT PREVIEW SO THIS CODE IS NOT NEEDED ANYMORE */}\r\n            {/* <div className=\"d-flex justify-content-center align-items-center\">\r\n              <img src=\"img/auction_1.jpg\" className=\"img-fluid\" style={{ height: \"250px\", width: \"300px\" }} />\r\n            </div>\r\n            <div className=\"pt-3 pb-3\">\r\n              <div className=\"d-flex justify-content-between text-white pb-2\">\r\n                <div>WannaPanda - PnPIbqI9ZF</div>\r\n                <div>Price</div>\r\n              </div>\r\n              <div className=\"d-flex justify-content-between text-white pb-2\">\r\n                <div>1</div>\r\n                <div><i className=\"fab fa-ethereum\" />0</div>\r\n              </div>\r\n            </div> */}\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  nft: state.nft,\r\n  error: state.error,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n  beforeNFT,\r\n  getNFT,\r\n  upsertNFT,\r\n})(Sell);\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["623"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/item-detail/item-detail.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/activity/activity.js",["624"],"import React, { useState, useEffect } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-1/activity\";\r\n\r\nconst Activity = ()  => {\r\n    const [data, setData] = useState({});\r\n    const [tabData_1, setTabData_1] = useState([]);\r\n    const [tabData_2, setTabData_2] = useState([]);\r\n    const [tabData_3, setTabData_3] = useState([]);\r\n    const [filterData, setFilterData] = useState([]);\r\n    \r\n    useEffect(()=>{\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                setData(res.data)\r\n                setTabData_1(res.data.tabData_1)\r\n                setTabData_2(res.data.tabData_2)\r\n                setTabData_3(res.data.tabData_3)\r\n                setFilterData(res.data.filterData)\r\n            })\r\n            \r\n    }, [])\r\n\r\n    return (\r\n        <section className=\"activity-area load-more padding-wrapper\">\r\n            <div className=\"container\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro mb-4\">\r\n                            <div className=\"intro-content\">\r\n                                <span>{data.preHeading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{data.heading}</h3>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    <div className=\"col-12 col-md-6 col-lg-8\">\r\n                        {/* Netstorm Tab */}\r\n                        <ul className=\"netstorm-tab nav nav-tabs\" id=\"nav-tab\">\r\n                            <li>\r\n                                <a className=\"active\" id=\"nav-home-tab\" data-toggle=\"pill\" href=\"#nav-home\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_1}</h5>\r\n                                </a>\r\n                            </li>\r\n                            <li>\r\n                                <a id=\"nav-profile-tab\" data-toggle=\"pill\" href=\"#nav-profile\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_2}</h5>\r\n                                </a>\r\n                            </li>\r\n                            <li>\r\n                                <a id=\"nav-contact-tab\" data-toggle=\"pill\" href=\"#nav-contact\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_3}</h5>\r\n                                </a>\r\n                            </li>\r\n                        </ul>\r\n                        {/* Tab Content */}\r\n                        <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                            <div className=\"tab-pane fade show active\" id=\"nav-home\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_1.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`ato_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                            <div className=\"tab-pane fade\" id=\"nav-profile\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_2.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`att_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                            <div className=\"tab-pane fade\" id=\"nav-contact\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_3.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`atth_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"col-12 col-md-6 col-lg-4\">\r\n                        {/* Activity Content */}\r\n                        <div className=\"activity-content mt-5 mt-lg-0\">\r\n                            {/* Single Widget */}\r\n                            <div className=\"single-widget\">\r\n                                {/* Search Widget */}\r\n                                <div className=\"widget-content search-widget\">\r\n                                    <form action=\"#\">\r\n                                        <input type=\"text\" placeholder=\"Enter your keywords\" />\r\n                                    </form>\r\n                                </div>\r\n                            </div>\r\n                            {/* Single Widget */}\r\n                            <div className=\"single-widget\">\r\n                                {/* Filter Widget */}\r\n                                <div className=\"widget filter-widget\">\r\n                                    <h4 className=\"title\">{data.widgetTitle}</h4>\r\n                                    {/* Filter Widget Content */}\r\n                                    <div className=\"widget-content\">\r\n                                        {/* Tags Widget Items */}\r\n                                        <div className=\"widget-content filter-widget-items mt-3\">\r\n                                            {filterData.map((item, idx) => {\r\n                                                return (\r\n                                                    <a key={`fd_${idx}`} href=\"#\" className=\"badge tag\">{item.title}</a>\r\n                                                );\r\n                                            })}\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\nexport default Activity;\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/blog/blog.js",["625","626"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/blog\";\r\n\r\nclass Blog extends Component {\r\n    state = {\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data.blogData\r\n                })\r\n              \r\n            })\r\n        .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"blog-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`bd_${idx}`} className=\"col-12 col-md-4 item\">\r\n                                    {/* Single Blog */}\r\n                                    <div className=\"card blog-card\">\r\n                                        {/* Blog Thumb */}\r\n                                        <div className=\"blog-thumb\">\r\n                                            <a href=\"/blog-single\"><img src={item.img} alt=\"\" /></a>\r\n                                        </div>\r\n                                        {/* Blog Content */}\r\n                                        <div className=\"blog-content\">\r\n                                            {/* Meta Info */}\r\n                                            <ul className=\"meta-info d-flex justify-content-between list-unstyled mt-4\">\r\n                                                <li>By <a href=\"#\">{item.author}</a></li>\r\n                                                <li><a href=\"#\">{item.date}</a></li>\r\n                                            </ul>\r\n                                            {/* Blog Title */}\r\n                                            <a href=\"/blog-single\">\r\n                                                <h4>{item.title}</h4>\r\n                                            </a>\r\n                                            <p>{item.content}</p>\r\n                                            {/* Blog Button */}\r\n                                            <a className=\"btn content-btn\" href=\"/blog-single\">{item.btnText}</a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Blog;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/help-center/help-center.js",["627"],"import React, { Component } from 'react';\nimport Help from '../help/help';\nimport Faq from '../faq/faq';\n\nclass HelpCenter extends Component {\n\n    componentDidMount() {\n        window.scroll(0, 0)\n    }\n\n    render() {\n        return (\n            <>\n                {/* <Help /> */}\n                <Faq />\n            </>\n        );\n    }\n}\n\nexport default HelpCenter;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/blog-single/blog-single.js",["628","629"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\nimport Sidebar from '../sidebar/sidebar';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/blogSingle\";\r\n\r\nclass BlogSingle extends Component {\r\n    state = {\r\n        data: {}\r\n    }\r\n    componentDidMount(){\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data\r\n                })\r\n            \r\n            })\r\n        .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"single featured post-details\">\r\n                <div className=\"container\">\r\n                    <div className=\"row\">\r\n                        {/* Main */}\r\n                        <div className=\"col-12 col-lg-8 p-0\">\r\n                            <div className=\"row\">\r\n                                <div className=\"col-12 align-self-center\">\r\n                                    {/* Image */}\r\n                                    <div className=\"blog-thumb\">\r\n                                        <img className=\"w-100\" src={this.state.data.image} alt=\"\" />\r\n                                    </div>\r\n                                    <h2 className=\"featured ml-0\">{this.state.data.title}</h2>\r\n                                    <p>{this.state.data.content_1}</p>\r\n                                    <p>\r\n                                    </p>\r\n                                    <blockquote>{this.state.data.quote}</blockquote>\r\n                                    <p>{this.state.data.content_2}</p>\r\n                                    <p>{this.state.data.content_3}</p>\r\n                                    {/* Post Holder */}\r\n                                    <ul className=\"mb-5 post-holder\">\r\n                                        <li className=\"post-meta-item\">\r\n                                            <div className=\"date\">\r\n                                                <span className=\"posted-on\">Posted On <a href=\"#\" rel=\"bookmark\"><time className=\"entry-date published updated\" dateTime=\"2018-11-01T06:18:46+00:00\">{this.state.data.date}</time></a></span>\r\n                                            </div>\r\n                                        </li>\r\n                                    </ul>\r\n                                    {/* Comments */}\r\n                                    <h3 className=\"comments-reply-text mb-3\">{this.state.data.commentTitle}</h3>\r\n                                    <p className=\"mt-3\">{this.state.data.commentContent}</p>\r\n                                    <form>\r\n                                        <fieldset>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-12 col-lg-6 input-group p-0 pr-lg-3 mb-3\">\r\n                                                    <input type=\"text\" name=\"name\" data-minlength={3} placeholder=\"Name\" required />\r\n                                                </div>\r\n                                                <div className=\"col-12 col-lg-6 input-group p-0 mb-3\">\r\n                                                    <input type=\"email\" name=\"email\" data-minlength={3} placeholder=\"Email\" required />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-12 input-group p-0 mb-3\">\r\n                                                    <textarea name=\"message\" data-minlength={3} rows={4} placeholder=\"Message\" required defaultValue={\"\"} />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 input-group p-0\">\r\n                                                <a className=\"btn btn-bordered-white text-white\">{this.state.data.commentBtn}<i className=\"icon-login ml-2\" /></a>\r\n                                            </div>\r\n                                        </fieldset>\r\n                                    </form>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        {/* Sidebar */}\r\n                        <Sidebar />\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default BlogSingle;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/author/author.js",["630","631","632","633","634","635","636","637"],"import React, { useEffect, useState } from \"react\";\r\nimport { useParams } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport AuthorProfile from \"../author-profile/author-profile\";\r\nimport Explore from \"../explore/explore-all\";\r\nimport { getUserById, beforeUser } from \"./../user/user.action\";\r\nimport FilterSearch from \"../filter-search2/filtersearch2\";\r\nimport { ENV } from \"./../../config/config\";\r\n\r\nconst Author = (props) => {\r\n  const params = useParams();\r\n  const [authorProfile, setAuthorProfile] = useState({});\r\n  useEffect(() => {\r\n    props.getUserById(params.authorId);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.user.individualUserAuth) {\r\n      setAuthorProfile(props.user.individualUser);\r\n      props.beforeUser();\r\n    }\r\n  }, [props.user.individualUserAuth]);\r\n  return (\r\n    <section\r\n      className=\"author-area explore-area popular-collections-area\"\r\n      style={{ padding: \"0px\" }}\r\n    >\r\n      <div className=\"\">\r\n        <div className=\"d-flex author-detail-container\">\r\n          <div className=\"author-preview author-card\">\r\n            <div className=\"seller\">\r\n              <div className=\"seller-thumb avatar-lg\">\r\n                <img\r\n                  className=\"rounded-circle\"\r\n                  src={props.profileImage ? props.profileImage : ENV.globalPlaceholderImage}\r\n                  alt=\"User Profile\"\r\n                  style={{ height: \"110px\" }}\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"card-caption p-0 text-center\">\r\n            <div className=\"card-body\">\r\n              <h5 className=\"mb-3\">{authorProfile.username}</h5>\r\n              <p className=\"my-3\">{authorProfile.description}</p>\r\n              <div className=\"input-group\">\r\n                <input type=\"text\" className=\"form-control\" placeholder=\"0x000000000000000000\" readOnly value={authorProfile.address}\r\n                  style={{\r\n                    borderRadius: \"100px\",\r\n                    backgroundColor: \"transparent\",\r\n                    border: \"2px solid\",\r\n                    height: \"40px\",\r\n                    padding: \"1.5rem\",\r\n                    boxShadow: \"none\",\r\n                    outline: \"none\",\r\n\r\n                  }}\r\n                />\r\n                <div className=\"input-group-append\"\r\n                  style={{\r\n                    position: \"absolute\",\r\n                    height: \"100%\",\r\n                    top: \"0\",\r\n                    right: \"0\",\r\n                    borderRadius: \"100px\",\r\n                    overflow: \"hidden\",\r\n                  }}\r\n                >\r\n                  <button style={{\r\n                    marginRight: \"5px\",\r\n                    padding: \"12px 16px\",\r\n                    backgroundColor: \"transparent\",\r\n                    color: \"#fff\",\r\n                    border: \"0\",\r\n                    outline: \"none\",\r\n                  }}><i className=\"icon-docs\" /></button>\r\n                </div>\r\n              </div>\r\n              <div className=\"social-icons d-flex justify-content-center my-3\">\r\n                {\r\n                  authorProfile.facebookLink && <a className=\"facebook\" href={authorProfile.facebookLink} target=\"_blank\">\r\n                    <i className=\"fab fa-facebook-f\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.twitterLink && <a className=\"twitter\" href={authorProfile.twitterLink} target=\"_blank\">\r\n                    <i className=\"fab fa-twitter\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.gPlusLink && <a className=\"google-plus\" href={authorProfile.gPlusLink} target=\"_blank\">\r\n                    <i className=\"fab fa-google-plus-g\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.vineLink && <a className=\"vine\" href={authorProfile.vineLink} target=\"_blank\">\r\n                    <i className=\"fab fa-vine\" />\r\n                  </a>\r\n                }\r\n              </div>\r\n              {\r\n                props.followText &&\r\n                <a className=\"btn btn-bordered-white btn-smaller\" href=\"#\">{props.followText}</a>\r\n              }\r\n            </div>\r\n          </div>\r\n          <div className=\"d-flex collection-wrapper\">\r\n            <FilterSearch />\r\n            <div className=\"nfts-collection-wrapper w-100\">\r\n              <Explore />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  error: state.error,\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { getUserById, beforeUser })(Author);\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["638","639","640","641"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"music\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Collections\"} title2={\"PopularCollections\"} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Most Popular</span>\n                    <h3 className=\"mb-0\">Popular Collections</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-lg-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={collection.banner}\n                        Subimg1={collection.logo}\n                        Subimg2={collection.featuredImg}\n                        Subimg3={collection.banner}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.user[0]?.username\n                            ? collection?.user[0]?.username\n                            : \"\"\n                        }\n                        NFTCount={collection.NFTCount}\n                        // handleLikesTogle={handleLikesTogleApi}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    collections?.length > 10 &&\n                    pagination.totalRecords <= collections.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/profile/profile.js",["642","643","644","645","646"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport AuthorProfile from \"../author-profile/author-profile\";\nimport { SET_INDIVIDUAL_USER } from \"../../redux/types\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { signRequest } from \"./../../utils/web3\";\nimport { ENV } from \"./../../config/config\";\nimport { toast } from \"react-toastify\";\nimport { useHistory } from \"react-router-dom\";\n\n\nconst Profile = (props) => {\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [facebookLink, setFbLink] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [gPlusLink, setgPlusLink] = useState(\"\");\n  const [vineLink, setVineLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n    props.setIndividualUserData(user);\n    setConnectedAddress(user.address ? user.address : \"\");\n    setAddress(user.address ? user.address : \"\");\n    setEmail(user.email ? user.email : \"\");\n    setUserId(user._id ? user._id : \"\");\n    setDescription(user.description ? user.description : \"\");\n    setFbLink(user.facebookLink ? user.facebookLink : \"\");\n    setgPlusLink(user.gPlusLink ? user.gPlusLink : \"\");\n    setTwitterLink(user.twitterLink ? user.twitterLink : \"\");\n    setVineLink(user.vineLink ? user.vineLink : \"\");\n    setUsername(user.username ? user.username : \"\");\n    setImageUrl(user.profileImage ? user.profileImage : \"\");\n  }, []);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      props.beforeUser();\n      setLoader(false);\n    }\n  }, [props.user.userAuth]);\n\n  useEffect(() => {\n    if (props.error) {\n      setErrors(props.error.message);\n      goToTop();\n    }\n  }, [props.error]);\n\n  const goToTop = () => {\n    $(\"html, body\").animate(\n      {\n        scrollTop: 0,\n      },\n      600\n    );\n  };\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setImageUrl(fileURL);\n      setImage(file);\n    }\n  };\n\n  const onBannerChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setBannerUrl(fileURL);\n      setBannerImage(file);\n    }\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    setErrors(\"\");\n    setIsSubmitted(true);\n    let isFormValid = validator.allValid() ? true : false;\n    if (isFormValid) {\n      try {\n        let signature = await signRequest();\n        setLoader(true);\n        var formData = new FormData();\n        formData.append(\"profileImage\", image);\n        formData.append(\"bannerImage\", banner);\n        formData.append(\"description\", description);\n        formData.append(\"facebookLink\", facebookLink);\n        formData.append(\"twitterLink\", twitterLink);\n        formData.append(\"gPlusLink\", gPlusLink);\n        formData.append(\"vineLink\", vineLink);\n        formData.append(\"username\", username);\n        formData.append(\"signature\", signature);\n        props.updateProfile(formData);\n      } catch (e) {}\n    } else {\n      validator.showMessages();\n      setErrors(\"Please fill all required fields in valid format.\");\n      goToTop();\n    }\n  };\n  if (!ENV.getUserKeys(\"_id\")._id) {\n    toast.error(\"Please login to view profile\");\n    history.push(\"/\");\n    return \" \";\n  } else {\n    return (\n      <section className=\"author-area\">\n        <div className=\"container\">\n          <div className=\"row justify-content-between\">\n            <div className=\"col-12 col-md-4\">\n              <AuthorProfile\n                profileImage={imageUrl}\n                username={username}\n                description={description}\n                address={connectedAddress}\n                facebookLink={facebookLink}\n                twitterLink={twitterLink}\n                gPlusLink={gPlusLink}\n                vineLink={vineLink}\n              />\n            </div>\n            <div className=\"col-12 col-md-7\">\n              <div className=\"mt-5 mt-lg-0 mb-4 mb-lg-5\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Your Profile</span>\n                    <h3 className=\"mt-3 mb-0\">Update your profile</h3>\n                  </div>\n                </div>\n              </div>\n              <form id=\"create-nft\" className=\"item-form card no-hover\">\n                {isSubmitted && errors && (\n                  <div className=\"row pb-2\">\n                    <div className=\"col-12\">\n                      <span id=\"create-nft-err\" className=\"text-danger\">\n                        {errors}\n                      </span>\n                    </div>\n                  </div>\n                )}\n                <div className=\"row\">\n                  <div className=\"col-12\">\n                    <div className=\"input-group form-group\">\n                      <div className=\"custom-file\">\n                        <input\n                          type=\"file\"\n                          className=\"custom-file-input\"\n                          id=\"banner\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onBannerChange(e)}\n                          name=\"banner\"\n                        />\n                        <label\n                          id=\"nft-imasge-label\"\n                          className=\"custom-file-label\"\n                          htmlFor=\"banner\"\n                        >\n                          {banner && banner.name\n                            ? banner.name\n                            : \"Choose Banner Image\"}\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"input-group form-group\">\n                      <div className=\"custom-file\">\n                        <input\n                          type=\"file\"\n                          className=\"custom-file-input\"\n                          id=\"image\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onFileChange(e)}\n                          name=\"image\"\n                        />\n                        <label\n                          id=\"nft-imasge-label\"\n                          className=\"custom-file-label\"\n                          htmlFor=\"image\"\n                        >\n                          {image && image.name\n                            ? image.name\n                            : \"Choose Profile Picture\"}\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"address\"\n                        placeholder=\"Wallet Address *\"\n                        required=\"required\"\n                        value={address}\n                        readOnly\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"address\", address, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"email\"\n                        placeholder=\"Email *\"\n                        required=\"required\"\n                        value={email}\n                        readOnly\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"email\", email, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"username\"\n                        placeholder=\"Username *\"\n                        required=\"required\"\n                        onChange={(e) => setUsername(e.target.value)}\n                        defaultValue={username}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"username\", username, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <textarea\n                        className=\"form-control\"\n                        name=\"description\"\n                        placeholder=\"About\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setDescription(e.target.value)}\n                        defaultValue={description}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"facebookLink\"\n                        placeholder=\"Facebook Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setFbLink(e.target.value)}\n                        defaultValue={facebookLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"twitterLink\"\n                        placeholder=\"Twitter Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setTwitterLink(e.target.value)}\n                        defaultValue={twitterLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"gPlusLink\"\n                        placeholder=\"Google Plus Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setgPlusLink(e.target.value)}\n                        defaultValue={gPlusLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"vineLink\"\n                        placeholder=\"Vine Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setVineLink(e.target.value)}\n                        defaultValue={vineLink}\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"col-12\">\n                    <button\n                      disabled={loader}\n                      className=\"btn w-100 mt-3 mt-sm-4\"\n                      type=\"button\"\n                      onClick={(e) => submit(e)}\n                    >\n                      Update Profile\n                    </button>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        </div>\n      </section>\n    );\n  }\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n})(Profile);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/create-collection/create-collection.js",["647","648"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { getUser } from \"../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport $ from \"jquery\";\nimport { ENV } from \"../../config/config\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { toast } from \"react-toastify\";\nimport \"./create-collection.css\";\nimport { Images } from \"../../assets/assets.js\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nclass CreateCollection extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        description: \"\",\n      },\n      categories: null,\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate() {\n    if (this.props.error) {\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      this.setState({ categories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n    console.log(collection, \"collection input\");\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  render() {\n    const { collection, errors, loader, isSubmitted, categories } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      return (\n        <div>\n          <NavbarMain />\n          <Breadcrumb title1={\"Collections\"} title2={\"CreateCollection\"} />\n          <section className=\"author-area padding-form-wrapper\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row justify-content-between\">\n                <div className=\"col-12 col-md-12\">\n                  <div className=\"mt-5 mt-lg-0 mb-4 mb-lg-5\">\n                    <div className=\"intro\">\n                      <div className=\"intro-content\">\n                        <span>Get Started</span>\n                        <h3 className=\"mb-0\">Create Collection</h3>\n                      </div>\n                    </div>\n                    {isSubmitted && errors && (\n                      <div className=\"row\">\n                        <div className=\"col-12\">\n                          <span\n                            id=\"create-collection-err\"\n                            className=\"text-danger\"\n                          >\n                            {errors}\n                          </span>\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                  <form\n                    id=\"create-collection\"\n                    className=\"item-form card no-hover\"\n                  >\n                    <div className=\"row\">\n                      <div className=\"col-12\">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"logo\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"logo\"\n                            />\n                            <label\n                              id=\"collection-logo-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"logo\"\n                            >\n                              Choose Logo *\n                            </label>\n                          </div>\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"logo\",\n                              collection.logo,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-3\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border \">\n                          <div className=\"image-over \">\n                            <img\n                              id=\"logo-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.logoUrl\n                                  ? collection.logoUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"featuredImg\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"featuredImg\"\n                            />\n                            <label\n                              id=\"collection-featuredImg-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"featuredImg\"\n                            >\n                              {\" \"}\n                              Choose Featured Image\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-4\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border\">\n                          <div className=\"image-over\">\n                            <img\n                              id=\"featuredImg-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.featuredImgUrl\n                                  ? collection.featuredImgUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 \">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"banner\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"banner\"\n                            />\n                            <label\n                              id=\"collection-banner-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"banner\"\n                            >\n                              Choose Banner\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-8\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border\">\n                          <div className=\"image-over\">\n                            <img\n                              id=\"banner-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.bannerUrl\n                                  ? collection.bannerUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-6\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control\"\n                            name=\"name\"\n                            placeholder=\"Name *\"\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.name}\n                            maxLength=\"55\"\n                            autoComplete=\"off\"\n                          />\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"name\",\n                              collection.name,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-6\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control\"\n                            name=\"url\"\n                            placeholder=\"URL\"\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.url}\n                            maxLength=\"70\"\n                            autoComplete=\"off\"\n                          />\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"url\",\n                              collection.url,\n                              \"url\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group\">\n                          {/* <label\n                            htmlFor=\"category\"\n                            className=\"create-nft-form-title mb-3\"\n                          >\n                            Select Category*\n                          </label> */}\n                          <select\n                            className=\"form-control p-0\"\n                            id=\"category\"\n                            name=\"categoryId\"\n                            onChange={(e) => this.onChange(e)}\n                          >\n                            <option value=\"\">Select Category</option>\n                            {categories &&\n                              categories.map((category, index) => {\n                                return (\n                                  <option key={index} value={category._id}>\n                                    {category.name}\n                                  </option>\n                                );\n                              })}\n                          </select>\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"category\",\n                              collection.categoryId,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group\">\n                          <textarea\n                            className=\"form-control\"\n                            name=\"description\"\n                            placeholder=\"Description\"\n                            cols={30}\n                            rows={3}\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.description}\n                            maxLength=\"230\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"text-center\">\n                          <button\n                            disabled={loader}\n                            className=\"create-collection-btn mx-auto mt-3 mt-sm-4\"\n                            type=\"button\"\n                            onClick={(e) => this.submit(e)}\n                          >\n                            Create Collection\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </form>\n                </div>\n              </div>\n            </div>\n          </section>\n          <Footer />\n        </div>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollection);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/create-nft/create-nft.js",["649","650","651","652","653","654"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n} from \"./../../utils/functions\";\nimport { toast } from \"react-toastify\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport {\n  beforeCollection,\n  getCollections,\n  myCollections,\n} from \"../collections/collections.actions\";\nimport { setNftToken, createNFT } from \"../nfts/nfts.action\";\nimport { getCurrentAddress, mintNFt } from \"../../utils/web3\";\nimport { RiArrowDropDownLine } from \"react\";\nimport \"./createNft.css\";\nimport { Images } from \"../../assets/assets.js\";\nimport Upload from \"./components/upload\";\nimport Footer from \"../footer/footer\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst placeholderImg = \"\";\nclass CreateNFT extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      nft: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        ownerId: ENV.getUserKeys(\"_id\")._id,\n        creatorId: ENV.getUserKeys(\"_id\")._id,\n        image: \"\",\n        videoURL: \"\",\n        audioUrl: \"\",\n        name: \"\",\n        description: \"\",\n        currentPrice: \"\",\n        royalty: \"\",\n        size: \"\",\n        copies: \"\",\n        collectionId: \"\",\n        ownerAddress: \"\",\n        categoryId: \"\",\n        status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n      },\n      imageURL: \"\",\n      videoURL: \"\",\n      collections: [],\n      allcollections: null,\n      error: false,\n      errorMessage: \"\",\n      audioUrl: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount = async () => {\n    window.scroll(0, 0);\n\n    this.props.myCollections(ENV.getUserKeys(\"_id\")._id);\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      this.props.history.push(\"/login\");\n    }\n\n    let ownerAddress = await getCurrentAddress();\n\n    let { nft } = this.state;\n    nft = { ...nft, ownerAddress: ownerAddress };\n    this.setState({\n      nft,\n    });\n  };\n\n  componentDidUpdate(prevProps) {\n    if (\n      this.props.collection.myCollectionsResult &&\n      prevProps.collection.myCollectionsResult !==\n        this.props.collection.myCollectionsResult\n    ) {\n      const collections =\n        this.props.collection.myCollections.collections.Collections;\n\n      this.props.beforeCollection();\n\n      if (!collections.length) {\n        toast.info(\"Please add a collection first\");\n        return this.props.history.push(\"/collection/create\");\n      } else {\n        this.setState({\n          collections: collections,\n          loader: false,\n        });\n      }\n    }\n  }\n\n  onChange(e, status = null) {\n    let { name, value } = e.target;\n\n    // if status is provided\n    if (status) value = status;\n    let category = this.state.collections.find(\n      (item) => item._id === value\n    )?.categoryId;\n\n    let { nft } = this.state;\n    nft = { ...nft, [name]: value, categoryId: category };\n    this.setState({ nft });\n  }\n\n  reset = () => {\n    const nft = {\n      userId: ENV.getUserKeys(\"_id\")._id,\n      ownerId: ENV.getUserKeys(\"_id\")._id,\n      image: \"\",\n      name: \"\",\n      description: \"\",\n      currentPrice: \"\",\n      royalty: \"\",\n      size: \"\",\n      copies: \"\",\n      collectionId: \"\",\n      ownerAddress: this.state.ownerAddress,\n      status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n    };\n    this.setState({ nft });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n\n    const { nft } = this.state;\n\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() && nft.collectionId ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              var formData = new FormData();\n              for (const key in nft)\n                if (nft[key]) formData.append(key, nft[key]);\n\n              const res = await axiosPostFormData(\n                \"nfts/create\",\n                formData,\n                true\n              );\n\n              console.log(res, \"nft crate\");\n\n              if (res.success) {\n                // this.reset();\n                // toast.success(`Success! ${res.message}`)\n\n                if (res.nft && res.nft.metaData) {\n                  try {\n                    let nftId = res.nft._id;\n                    let createNftResult = await mintNFt(\n                      res.nft.metaData,\n                      res.nft._id\n                    );\n\n                    if (createNftResult.events.TransferSingle.returnValues.id) {\n                      let data = {\n                        nftToken:\n                          createNftResult.events.TransferSingle.returnValues.id,\n                        nftId: res.nft._id,\n                        data: this.state.nft,\n                        image: res.nft.image,\n                      };\n                      console.log(data, \"data==>\");\n                      this.props.setNftToken(data);\n                      toast.success(\"Nft created successfully\");\n                      this.props.history.push(\"/explore/allNFT\");\n                    }\n                  } catch (err) {\n                    toast.error(err);\n                  }\n                }\n              } else this.setState({ errors: res.message, loader: false });\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-nft\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n\n  onFileChange = (e, status) => {\n    if (this.handleFilesValidation(e, status) === \"file matched\") {\n      let file = \"\";\n      let url = \"\";\n      let fileId = \"\";\n      if (status === \"onDrag\") {\n        file = e.dataTransfer.files[0];\n        url = URL.createObjectURL(e.dataTransfer.files[0]);\n        fileId = e.dataTransfer.id;\n      } else {\n        file = e.target.files[0];\n        url = URL.createObjectURL(e.target.files[0]);\n        fileId = e.target.id;\n      }\n      if (file)\n        if (file.type.includes(\"image\")) {\n          let { nft } = this.state;\n          nft = { ...nft, [e.target.name]: file };\n          nft = { ...nft, videoURL: \"\" };\n\n          this.setState(\n            {\n              nft,\n              imageURL: url,\n              videoURL: \"\",\n              error: false,\n              errorMessage: \"\",\n            },\n            () => {\n              if (file) {\n                var reader = new FileReader();\n\n                reader.onload = function (e) {\n                  $(`#nft-${fileId}`).attr(\"src\", e.target.result);\n                  $(\"#nft-image-label\").html(\"File selected\");\n                };\n                reader.readAsDataURL(file);\n              }\n            }\n          );\n        } else if (file.type.includes(\"video\")) {\n          let { nft } = this.state;\n          nft = { ...nft, videoURL: file };\n          nft = { ...nft, image: \"\" };\n          this.setState({\n            nft,\n            videoURL: url,\n            imageURL: \"\",\n            error: false,\n            errorMessage: \"\",\n          });\n        } else if (file.type.includes(\"audio\")) {\n          let { nft } = this.state;\n          nft = { ...nft, videoURL: file, audioUrl: file, image: \"\" };\n\n          this.setState({\n            nft,\n            videoURL: \"\",\n            imageURL: \"\",\n            error: false,\n            errorMessage: \"\",\n            audioUrl: url,\n          });\n        } else {\n          $(`#nft-${fileId}`).attr(\"src\", placeholderImg);\n          file = {};\n        }\n    } else {\n      let message = this.handleFilesValidation(e, status);\n      this.setState({\n        error: true,\n        errorMessage: message,\n      });\n    }\n  };\n  dragOver = (e) => {\n    e.preventDefault();\n  };\n\n  dragEnter = (e) => {\n    e.preventDefault();\n  };\n\n  dragLeave = (e) => {\n    e.preventDefault();\n  };\n  onDrop = (e) => {\n    e.nativeEvent.preventDefault();\n    if (!e) return;\n\n    this.onFileChange(e, \"onDrag\");\n  };\n\n  handleFilesValidation = (e, status) => {\n    let files = \"\";\n    let type = \"\";\n    if (status === \"onDrag\") {\n      files = e.dataTransfer.files[0];\n      type = e.dataTransfer.files[0].type;\n    } else {\n      files = e.target.files[0];\n      type = e.target.files[0].type;\n    }\n    if (files) {\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\" ||\n        type === \"audio/mpeg\"\n      ) {\n        let fileSize = this.formatBytes(files.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          return \"File size limit is exceeded\";\n        } else {\n          return \"file matched\";\n        }\n      } else {\n        return \"File not supported!\";\n      }\n    }\n  };\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n  clearData = () => {\n    this.setState({\n      imageURL: \"\",\n      audioUrl: \"\",\n      videoURL: \"\",\n    });\n  };\n\n  render() {\n    const {\n      nft,\n      errors,\n      loader,\n      isSubmitted,\n      collections,\n      imageURL,\n      videoURL,\n      error,\n      errorMessage,\n      audioUrl,\n    } = this.state;\n\n    const { onDrop, dragOver, dragEnter, dragLeave } = this;\n\n    return (\n      <div>\n        <NavbarMain />\n        <Breadcrumb title1={\"NFT\"} title2={\"CreateNft\"} />\n        <section className=\"author-area padding-wrapper\">\n          {loader && <FullPageLoader />}\n\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Get started</span>\n                    <h3 className=\"mb-0\">Create NFT</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-sm-6 col-md-6 col-lg-4 left-container\">\n                <p className=\"upload-title\">Upload</p>\n                <div className=\"nft-left-upload p-3\">\n                  <div\n                    className=\"upload-image-container\"\n                    onDrop={(e) => onDrop(e)}\n                    onDragOver={(e) => dragOver(e)}\n                    onDragEnter={(e) => dragEnter(e)}\n                    onDragLeave={(e) => dragLeave(e)}\n                  >\n                    <Upload\n                      onFileChange={(e, status) => this.onFileChange(e, status)}\n                      clearData={this.clearData}\n                      Images={Images}\n                      imageURL={imageURL}\n                      videoURL={videoURL}\n                      audioSrc={audioUrl}\n                      dragOver={dragOver}\n                      onDrop={onDrop}\n                      dragEnter={dragEnter}\n                      dragLeave={dragLeave}\n                    />\n                    <span className=\"text-danger text-center mt-3\">\n                      {this.validator.message(\"image\", nft.image, \"required\")}\n                    </span>\n\n                    {error && (\n                      <p className=\"text-danger text-center mt-3\">\n                        {errorMessage}\n                      </p>\n                    )}\n\n                    <div className=\"choose-file text-center my-5 \">\n                      <p className=\"mb-4\">or choose a file</p>\n\n                      <label>\n                        <span className=\"browse-files-btn mt-2\">\n                          browse file\n                        </span>\n                        <input\n                          type=\"file\"\n                          style={{ display: \"none\" }}\n                          onChange={(e) => this.onFileChange(e, \"onChange\")}\n                          accept=\".mp4, .png,.jpeg\"\n                          name=\"image\"\n                        />\n                      </label>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"col-sm-6 col-md-6 col-lg-8 mt-5 mt-sm-0\">\n                <p className=\"upload-title\">Create</p>\n                <div className=\"nft-inputs-container p-4\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-12\">\n                      <input\n                        name=\"name\"\n                        placeholder=\"Title\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.name}\n                        defaultValue={nft.name}\n                        autoComplete=\"off\"\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.name, \"required\")}\n                      </span>\n                    </div>\n                    <div className=\"col-12\">\n                      <textarea\n                        name=\"description\"\n                        rows=\"3\"\n                        placeholder=\"Description*\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.description}\n                        defaultValue={nft.description}\n                      ></textarea>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.description,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n\n                    <div className=\"col-12\">\n                      <input\n                        name=\"currentPrice\"\n                        placeholder=\"Item Price*\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        onKeyDown={(e) => decimalNumberValidator(e)}\n                        value={nft.currentPrice}\n                        defaultValue={nft.currentPrice}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.currentPrice,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n\n                    <div className=\"col-12 col-lg-6\">\n                      <input\n                        name=\"size\"\n                        value=\"\"\n                        placeholder=\"Size\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.size}\n                        defaultValue={nft.size}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.size, \"required\")}\n                      </span>\n                    </div>\n                    <div className=\"col-12 col-lg-6\">\n                      <input\n                        name=\"copies\"\n                        value=\"\"\n                        placeholder=\"No. of Copies*\"\n                        required=\"required\"\n                        onKeyDown={(e) => decimalNumberValidator(e)}\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.copies}\n                        defaultValue={nft.copies}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.copies, \"required\")}\n                      </span>\n                    </div>\n\n                    <div className=\"col-12\">\n                      <select\n                        id=\"collectionId\"\n                        name=\"collectionId\"\n                        onChange={(e) => this.onChange(e)}\n                      >\n                        <option value=\"\">Select Collection</option>\n                        {collections &&\n                          collections.length > 0 &&\n                          collections.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection._id}>\n                                {collection.name}\n                              </option>\n                            );\n                          })}\n                      </select>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.collectionId,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"col-12\">\n                      <div className=\"nft-form-btns text-center \">\n                        <div className=\"d-flex  flex-column flex-md-row justify-content-center align-items-center\">\n                          <button\n                            disabled={loader}\n                            className=\"create-collection-btn mt-2 me-md-2\"\n                            typ=\"submit\"\n                            onClick={(e) => this.submit(e)}\n                          >\n                            Create Item\n                          </button>\n                          <button className=\"cancel-collection-btn mt-2\">\n                            Cancel\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n        <Footer />\n      </div>\n    );\n    // }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  collection: state.collection,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollections,\n  setNftToken,\n  createNFT,\n  myCollections,\n})(CreateNFT);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/signup/signup.js",["655","656"],"import React, { Component } from \"react\";\r\n\r\nconst initData = {\r\n  pre_heading: \"Signup\",\r\n  heading: \"Create an Account\",\r\n  content: \"\",\r\n};\r\n\r\nconst socialData = [\r\n  {\r\n    id: \"1\",\r\n    link: \"facebook\",\r\n    icon: \"fab fa-facebook-f\",\r\n  },\r\n  {\r\n    id: \"2\",\r\n    link: \"twitter\",\r\n    icon: \"fab fa-twitter\",\r\n  },\r\n  {\r\n    id: \"3\",\r\n    link: \"google-plus\",\r\n    icon: \"fab fa-google-plus-g\",\r\n  },\r\n];\r\n\r\nclass Signup extends Component {\r\n  state = {\r\n    initData: {},\r\n    data: [],\r\n  };\r\n  componentDidMount() {\r\n    this.setState({\r\n      initData: initData,\r\n      data: socialData,\r\n    });\r\n  }\r\n  render() {\r\n    return (\r\n      <section className=\"author-area\">\r\n        <div className=\"container\">\r\n          <div className=\"row justify-content-center\">\r\n            <div className=\"col-12 col-md-8 col-lg-7\">\r\n              {/* Intro */}\r\n              <div className=\"intro text-center\">\r\n                <span>{this.state.initData.pre_heading}</span>\r\n                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                <p>{this.state.initData.content}</p>\r\n              </div>\r\n              {/* Item Form */}\r\n              <form className=\"item-form card no-hover\">\r\n                <div className=\"row\">\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <input\r\n                        type=\"text\"\r\n                        className=\"form-control\"\r\n                        name=\"name\"\r\n                        placeholder=\"Enter your Name\"\r\n                        required=\"required\"\r\n                      />\r\n                    </div>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <input\r\n                        type=\"email\"\r\n                        className=\"form-control\"\r\n                        name=\"email\"\r\n                        placeholder=\"Enter your Email\"\r\n                        required=\"required\"\r\n                      />\r\n                    </div>\r\n                  </div>\r\n                  {/* <div className=\"col-12\">\r\n                                        <div className=\"form-group mt-3\">\r\n                                            <input type=\"password\" className=\"form-control\" name=\"password\" placeholder=\"Enter your Password\" required=\"required\" />\r\n                                        </div>\r\n                                    </div> */}\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <div className=\"form-check form-check-inline\">\r\n                        <input\r\n                          className=\"form-check-input\"\r\n                          type=\"radio\"\r\n                          name=\"inlineRadioOptions\"\r\n                          id=\"inlineRadio1\"\r\n                          defaultValue=\"option1\"\r\n                        />\r\n                        <label\r\n                          className=\"form-check-label\"\r\n                          htmlFor=\"inlineRadio1\"\r\n                        >\r\n                          I agree to <a href=\"#\">Privacy Policy</a>\r\n                        </label>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <button className=\"btn w-100 mt-3 mt-sm-4\" type=\"submit\">\r\n                      Sign Up\r\n                    </button>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <span className=\"d-block text-center mt-4\">\r\n                      Already have an account? <a href=\"/login\">Login</a>\r\n                    </span>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <hr />\r\n                    <div className=\"other-option\">\r\n                      <span className=\"d-block text-center mb-4\">Or</span>\r\n                      {/* Social Icons */}\r\n                      <div className=\"social-icons d-flex justify-content-center\">\r\n                        {this.state.data.map((item, idx) => {\r\n                          return (\r\n                            <a\r\n                              key={`lsd_${idx}`}\r\n                              className={item.link}\r\n                              href=\"#\"\r\n                            >\r\n                              <i className={item.icon} />\r\n                              <i className={item.icon} />\r\n                            </a>\r\n                          );\r\n                        })}\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n}\r\n\r\nexport default Signup;\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["657","658","659","660","661","662","663","664","665","666","667","668","669","670","671","672"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./SellNFT.css\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport PriceIcon from \"../../assets/images/priceIcon.svg\";\nimport DollarIcon from \"../../assets/images/dollarIcon.svg\";\nimport FeeIcon from \"../../assets/images/feeIcon.svg\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFT, upsertNFT } from \"../nfts/nfts.action\";\n\nconst { currencies, dateRangeInitialSettings, serviceFee } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  listingSchedule: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  // if user includes reserve price\n  reservePrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n};\n\nconst SellNFT = (props) => {\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [activeBidBtn, setActiveBidBtn] = useState(false);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nft, setNft] = useState(null);\n  const [loader, setLoader] = useState(true); // NFT loader\n  const [reserveBuyer, setReserveBuyer] = useState(false);\n  const [reservePrice, setReservePrice] = useState(false);\n  const [tokensData, setTokensData] = useState([]);\n  const location = useLocation();\n  console.log(location, \"location\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    const { itemId } = props.match.params;\n    // if (itemId) props.getNFT(window.atob(itemId));\n    // else props.history.push(\"/explore-all\");\n    getTokens();\n  }, []);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNft(nft);\n      setLoader(false);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const { nft } = props.nft.nftsData;\n      // const pathname = nft.sellingMethod === 1 ? '/explore-all' : '/auctions'\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n\n  // when an error is received\n  useEffect(() => {\n    setLoader(false);\n  }, [props.error]);\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) data = fixedPriceConfig;\n    else data = timedAuctionConfig;\n\n    const keys = name.split(\".\"); // fixedPriceConfig, price, currency\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) setFixedPriceConfig({ ...data });\n    else setTimedAuctionConfig({ ...data });\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n  const submit = () => {\n    let payload='';\n    console.log(sellingMethod,\"sellingMethod\")\n    if(sellingMethod===2){\n\n      payload = {\n       _id: location.state._id,\n       sellingMethod,\n       sellingConfig:JSON.stringify(timedAuctionConfig),\n     };\n   \n    }\n    else {\n      payload = {\n        _id: location.state._id,\n        sellingMethod, \n        sellingConfig:JSON.stringify(fixedPriceConfig),\n      };\n      // console.log(payload,\"payload\")\n      \n\n    }\n\n    //  return  \" \"\n\n    let test = new Date(timedAuctionConfig.duration.endDate).getTime();\n    let time = timedAuctionConfig.duration.endTime;\n\n    var r = Number(time.split(\":\")[0]) * 60 + Number(time.split(\":\")[1]) * 1000;\n    //\n    const timeInMiliSeconds = r + test;\n\n    // console.log('yoken data', tokensData)\n    // const nftToken=tokensData.data.find((item)=>item?.nftId===nft?._id)\n\n    //  if(nftToken){\n    //   sellingMethod==1?SellOnFixedPrice(nftToken?.nftToken,fixedPriceConfig.price.amount):openNFTForBidding(nftToken.nftToken,timeInMiliSeconds)\n\n    setLoader(true);\n\n    var formData = new FormData();\n    console.log(payload, \"payload\");\n    for (const key in payload) formData.append(key, payload[key]);\n\n    props.upsertNFT(\"edit\", formData, \"PUT\");\n    //  }\n    //  else {\n    //   toast.error(\"there was an issue while creating nft, please try later\")\n    //  }\n  };\n\n  const getTokens = () => {\n    const url = process.env.REACT_APP_BASE_URL + \"nftTokens/tokens\";\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        setTokensData(data);\n      })\n      .catch((error) => {\n        console.log(error, \"error in catch blcok\");\n      });\n  };\n  return (\n    <>\n      <NavbarMain />\n      <section className=\"padding-wrapper nft-detail\">\n        <div className=\"container\">\n          <div className=\"row g-3\">\n            <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n              <div className=\"row\">\n                <div className=\"col-12 order-2 order-md-1\">\n                  <div className=\"intro mb-5\">\n                    <div className=\"intro-content\">\n                      <span>SellNFTs</span>\n                      <h3 className=\"mb-0\">List of bundles for sale</h3>\n                    </div>\n                  </div>\n                  <div className=\"sale-btn-container mt-5 mb-4\">\n                    <button\n                      className={` ${\n                        activeBtn === 0\n                          ? \"sell-btn-active\"\n                          : \"sell-btn-not-active\"\n                      } me-3 `}\n                      onClick={() => {\n                        setActiveBtn(0);\n                        setSellingMethod(1);\n                      }}\n                    >\n                      <img\n                        src={DollarIcon}\n                        alt=\"fixedPrize\"\n                        className=\"me-1 me-sm-2\"\n                      />\n                      Fixed Prize\n                    </button>\n                    <button\n                      className={` ${\n                        activeBtn === 1\n                          ? \"sell-btn-active\"\n                          : \"sell-btn-not-active\"\n                      } `}\n                      onClick={() => {\n                        setActiveBtn(1);\n                        setSellingMethod(2);\n                      }}\n                    >\n                      <img src={ClockIcon} alt=\"timeAuction\" className=\"me-2\" />\n                      Timed Auction\n                    </button>\n                  </div>\n                  <div className=\"nftDetail-accordion\">\n                    <div\n                      className=\"accordion accordion-flush \"\n                      id=\"accordionFlushExample\"\n                    >\n                      {activeBtn === 0 ? (\n                        <>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseOne\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingOne\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-price-container mx-auto\">\n                                  <div className=\"sell-price-inp d-flex align-items-center\">\n                                    <div className=\"sell-price-currency text-center\">\n                                      <span> ETH </span>\n                                    </div>\n                                    <input\n                                      type=\"text\"\n                                      name=\"fixedPriceConfig.price.amount\"\n                                      placeholder=\"Amount\"\n                                      style={{\n                                        borderRadius: \"4px\",\n                                      }}\n                                      onChange={(e) => onChange(e)}\n                                      onKeyDown={(e) =>\n                                        decimalNumberValidator(e)\n                                      }\n                                      defaultValue={\n                                        fixedPriceConfig.price.amount\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingTwo\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Schedule Listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"fixedPriceConfig.listingSchedule\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </>\n                      ) : (\n                        <>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Bid option\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-bid-opt-container mx-auto\">\n                                  <button\n                                    className={`${\n                                      activeBidBtn ? \"sell-bid-active\" : \"\"\n                                    } sell-bid-opt-btn`}\n                                    onClick={() =>\n                                      setActiveBidBtn(!activeBidBtn)\n                                    }\n                                  >\n                                    Sell To The Highest Bidder\n                                  </button>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingFour\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseFour\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseFour\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseFour\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingFour\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-price-container mx-auto\">\n                                  <div className=\"sell-price-inp d-flex align-items-center\">\n                                    <div className=\"sell-price-currency text-center\">\n                                      <span> ETH </span>\n                                    </div>\n                                    <input\n                                      type=\"text\"\n                                      name=\"timedAuctionConfig.startPrice.amount\"\n                                      placeholder=\"Amount\"\n                                      style={{\n                                        borderRadius: \"4px\",\n                                      }}\n                                      onChange={(e) => onChange(e)}\n                                      onKeyDown={(e) =>\n                                        decimalNumberValidator(e)\n                                      }\n                                      defaultValue={\n                                        fixedPriceConfig.price.amount\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSix\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSix\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSix\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Duration\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSix\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSix\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"timedAuctionConfig.duration\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"timedAuctionConfig.duration.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"timedAuctionConfig.duration.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"row\">\n                    <div className=\"col-10 col-sm-6 col-md-8 col-lg-6  col-xl-4\">\n                      <div className=\"sell-fee-container\">\n                        <div className=\"sell-fee-title d-flex align-items-center mb-2\">\n                          <img src={FeeIcon} alt=\"feeIcon\" className=\"me-2\" />\n                          <h6>Fees</h6>\n                        </div>\n                        <div className=\"sell-fee-content d-flex align-items-center justify-content-between mb-1\">\n                          <p>Service Fee</p>\n                          <p>2.5 %</p>\n                        </div>\n                        <div className=\"sell-fee-content d-flex align-items-center justify-content-between\">\n                          <p>Creator Royalty</p>\n                          <p>3 %</p>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-12 text-center mt-5\">\n                      <button\n                        className=\"sell-btn-active px-5\"\n                        onClick={() => submit()}\n                      >\n                        {\" \"}\n                        Complete Listing{\" \"}\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n              <Card className=\"auction-card detail-card\">\n                <div className=\"auction-img-wrapper\">\n                  <Card.Img\n                    variant=\"top\"\n                    src={location.state.image}\n                    alt=\"AuctionTopImg\"\n                  />\n                </div>\n                <Card.Body>\n                  <div>\n                    <span>Current price</span>\n                    <h3>\n                      {location.state.currentPrice}\n                      <span>($2.28)</span>\n                    </h3>\n                  </div>\n                  <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                    <div className=\"d-flex align-items-center\">\n                      <img src={ClockIcon} alt=\"clock-icon\" className=\"me-1\" />\n                      <span>Sale ends March 8, 2022 at 7:40am PKT </span>\n                    </div>\n                    <div className=\"likes-container d-flex align-items-center\">\n                      <span>{}</span>\n                      <img src={HeartIcon} alt=\"heart-icon\" className=\"ms-1\" />\n                    </div>\n                  </div>\n                </Card.Body>\n              </Card>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n})(SellNFT);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/how-it-works/how-it-works.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/privacy-&-terms/privacy-&-terms.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/wallet/wallet.js",["673","674","675","676","677","678"],"import React, { useState, useEffect } from \"react\";\nimport { Redirect, useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"../wallet/wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  getCollections,\n  beforeCategory,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport { login, signup } from \"../user/user.action\";\nimport \"./wallet.css\";\n\nconst Wallet = (props) => {\n  const history = useHistory();\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n\n  const connectMetamaskCall = async () => {\n    let connectedAddress = await connectMetamaskCopy();\n    setConnectedAddress(connectedAddress);\n    setWalletAddress(connectedAddress);\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      console.log(\"errors\", props.error);\n\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.collection.getAuth === true) {\n      let collections = props.collection.collections;\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n\n      let myCollections = collections.filter((el) => el.userId === userId);\n\n      if (myCollections && myCollections.length > 0) {\n     \n        history.push(\"/\");\n      } else {\n       \n        history.push(\"/\");\n      }\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    e.preventDefault();\n    try {\n      if (validator.isEmail(email)) {\n        let sign = await signRequest();\n        let payload = {\n          address: connectedAddress,\n          // password: sign,\n          email: email,\n          username: username,\n        };\n        props.signup(payload);\n      } else {\n        setErrorMessage(\"please enter valid email\");\n      }\n    } catch (err) {\n      toast.error(err.message);\n    }\n  };\n\n  const login = async () => {\n    try {\n      let sign = await signRequest();\n      let payload = {\n        address: connectedAddress,\n      };\n      props.login(payload);\n    } catch (err) {\n      toast.error(err.message);\n    }\n  };\n\n  const switchSignup = () => {\n    setShowSignUpComponent(true);\n  };\n\n  // if (props.user.userAuth) {\n  //     console.log(\"@@@@Collection-----@\", collections);\n  //     if(collections && collections.length>){\n  //         console.log(\"In Upper\")\n  //         return <Redirect to=\"/create\" />\n  //     }\n  //     else {\n  //         console.log(\"In Down\");\n  //         return <Redirect to=\"/collection/create\" />\n  //     }\n  // }\n\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div className=\"container\">\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Sign In</span>\n                  <h3 className=\"mt-3 mb-0\">SignIn to your account</h3>\n              \n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                <div className=\"card single-wallet sign-in-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <h4 className=\"mb-0\">Address</h4>\n                    <p id=\"connected-address mt-2\">{connectedAddress}</p>\n                    {errorMessage && (\n                      <p className=\"text-gray\">{errorMessage}</p>\n                    )}\n                    <button\n                      className=\"btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                      type=\"button\"\n                      onClick={() => login()}\n                    >\n                      Sign In\n                    </button>\n                    {showSignUp && (\n                      <button\n                        className=\"btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                        type=\"button\"\n                        onClick={() => switchSignup()}\n                      >\n                        Would you like to Signup?\n                      </button>\n                    )}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              {/* Intro */}\n              <div className=\"intro text-center\">\n                <span>SIGNUP</span>\n                <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                <p className=\"text-gray\">Create the account with the address</p>\n              </div>\n              {/* Item Form */}\n              <form\n                className=\"item-form card no-hover signup-card\"\n                onSubmit={(e) => signup(e)}\n              >\n                <div className=\"row\">\n                  {errorMessage && (\n                    <p className=\"text-center text-gray\">{errorMessage}</p>\n                  )}\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"address\"\n                        placeholder=\"Address\"\n                        required=\"required\"\n                        disabled={true}\n                        value={connectedAddress}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"email\"\n                        className=\"form-control sign-up-input\"\n                        name=\"email\"\n                        placeholder=\"Enter your Email\"\n                        required=\"required\"\n                        defaultValue={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"username\"\n                        placeholder=\"Enter your Username\"\n                        required=\"required\"\n                        defaultValue={username}\n                        onChange={(e) => setUsername(e.target.value)}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3 text-center\">\n                      <div className=\"form-check form-check-inline\">\n                        <input\n                          className=\"form-check-input\"\n                          type=\"radio\"\n                          name=\"inlineRadioOptions\"\n                          id=\"inlineRadio1\"\n                          defaultValue=\"option1\"\n                        />\n                        <label\n                          className=\"form-check-label text-center text-gray\"\n                          htmlFor=\"inlineRadio1\"\n                        >\n                          I agree to{\" \"}\n                          <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <button\n                      className=\"btn-signin w-75 mx-auto mt-3 mt-sm-4  text-white \"\n                      type=\"submit\"\n                    >\n                      Sign Up\n                    </button>\n                  </div>\n                 \n                </div>\n              </form>\n            </div>\n          </div>\n        ) : (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Wallet Connect</span>\n                  <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                  <p className=\"text-white mt-3\">\n                    Please select the wallet you want to connect to.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              {errorMessage && <p className=\"text-white\">{errorMessage}</p>}\n              <div\n                className=\"col-12 col-md-6 col-lg-4 item\"\n                onClick={() => connectMetamaskCall()}\n              >\n                {/* Single Wallet */}\n                <div className=\"card single-wallet whole-hover wallet-metamask-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <img\n                      className=\"avatar-lg\"\n                      src=\"/img/metamask2.png\"\n                      alt=\"\"\n                    />\n                    <h4 className=\"mb-0 my-3\">MetaMask</h4>\n                    <p>\n                      A browser extension with great flexibility. The web's most\n                      popular wallet\n                    </p>\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n})(Wallet);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["679","680","681","682","683","684","685","686","687","688","689","690","691","692","693","694"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./collectiondetails.css\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst CollectionDetailsPage = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n  });\n  const location = useLocation();\n\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    chains: {\n      label: \"Chains\",\n      option: [\"Ethereum\"],\n    },\n  };\n\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNfts(props.nfts);\n      props.beforeNFT();\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 40,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    setFilterationLoader(true);\n\n    const nftQS = { page, limit };\n\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      newest,\n      highToLow,\n    } = filter;\n    nftQS.collectionId = location.state._id;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getNFTs(qs);\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n  const handleLikesTogleApi = (nftId, status) => {\n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const { name, banner, logo, description } = location.state;\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <Breadcrumb title1={\"Collections\"} title2={\"CollectionDetail\"} />\n          <div className=\"collection-detail-hero w-100\">\n            <img className=\"w-100\" src={banner} alt=\"BannerImg\" />\n          </div>\n          <div className=\"collection-detail-content\">\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"collection-owner-avatar\">\n                    <img src={banner} alt=\"owner-avatar\" />\n                  </div>\n                  <div className=\"d-md-flex align-items-center justify-content-between mt-5\">\n                    <div className=\"collection-owner-detail\">\n                      <div className=\"collection-owner-name d-flex align-items-center\">\n                        <h3>{name}</h3>\n                        <img src={TickIcon} alt=\"tick-icon\" className=\"ms-2\" />\n                      </div>\n                      <p>\n                        Created by <span>brendannorth</span>\n                      </p>\n                    </div>\n                    <div className=\" d-block d-md-none\">\n                      <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                        <p>{description}</p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-btns mt-3 mt-md-0 ms-auto\">\n                      <button className=\"me-1 me-sm-2 me-lg-3\">\n                        <img src={FlagIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button className=\"me-1 me-sm-1 me-lg-3\">\n                        <img src={ShareIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button>+ Add to wishlist</button>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-sm-7 col-md-6 col-lg-5 d-none d-md-block\">\n                  <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                    <p>{description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 col-lg-7 mt-3 mt-sm-5\">\n                  <div className=\"d-flex align-items-center justify-content-center justify-content-lg-end\">\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>items</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Owner</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Prize floor</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Volume trade</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"collections-listing padding-wrapper\">\n                <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <img\n                        src={SearchIcon}\n                        alt=\"search-icon\"\n                        className=\"ms-3\"\n                      />\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        placeholder=\"Search\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Item:</p>\n                      </div>\n\n                      <select name=\"collection-select\">\n                        {itemoptions &&\n                          itemoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Sort:</p>\n                      </div>\n\n                      <select\n                        name=\"collection-select\"\n                        onChange={handleSortOptions}\n                      >\n                        {sortoptions &&\n                          sortoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 d-sm-none\">\n                    <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                      <button\n                        className={`${\n                          activeFilter\n                            ? \"filter-btn-active\"\n                            : \"filter-btn-inactive\"\n                        } ps-2`}\n                        onClick={() => setActiveFilter(!activeFilter)}\n                      >\n                        Filters\n                      </button>\n                    </div>\n                    <div\n                      className={`${\n                        activeFilter ? \"d-block\" : \"d-none\"\n                      } sm-filter-options`}\n                    >\n                      <div className=\"col-10 mx-auto mt-2\">\n                        <FilterComponent\n                          Status={filterData.status}\n                          Chains={filterData.chains}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row mt-5\">\n                <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                  <FilterComponent\n                    Status={filterData.status}\n                    Chains={filterData.chains}\n                    onChangeMinPrice={onChangeMinPrice}\n                    onChangeMaxPrice={onChangeMaxPrice}\n                    minValue={minValue}\n                    maxValue={maxValue}\n                    applyMinMaxFilter={applyMinMaxFilter}\n                  />\n                </div>\n                <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                  <div className=\"row g-3\">\n                    {filterationLoader ? (\n                      <div className=\"text-center\">\n                        <div\n                          class=\"spinner-border text-secondary text-white \"\n                          role=\"status\"\n                        >\n                          <span class=\"sr-only\">Loading...</span>\n                        </div>\n                      </div>\n                    ) : nfts && nfts.length > 0 ? (\n                      nfts.map((listing) => {\n                        return (\n                          <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                            <ListingCards\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                            />\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-white mt-5 text-center no-nfts-title\">\n                        No NFT's Found\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftAll.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n})(CollectionDetailsPage);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["695","696","697","698","699","700","701","702","703","704","705","706"],"import React, { useEffect, useState } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./nftdetail.css\";\nimport PriceHistoy from \"../../assets/images/pricehistoryicon.svg\";\nimport OfferIcon from \"../../assets/images/offer-icon.svg\";\nimport ListingIcon from \"../../assets/images/listing-icon.svg\";\nimport ActivityIcon from \"../../assets/images/activity.svg\";\nimport MoreCollectionIcon from \"../../assets/images/morecollectionicon.svg\";\nimport { ListingImg } from \"../../assets/assets\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport DescriptionIcon from \"../../assets/images/detail-description-icon.svg\";\nimport { getNFT, getNFTsByCollection } from \"../nfts/nfts.action.js\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader.js\";\nimport { connect } from \"react-redux\";\nimport { Modal } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport moment from \"moment\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport axios from \"axios\";\n\nconst NFTDetail = (props) => {\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const history = useHistory();\n  let nftId = props.match.params.id;\n  const initData = {\n    itemImg: \"/img/auction_2.jpg\",\n    date: \"2022-03-30\",\n    price_2: \"$500.89\",\n    bidBtn: \"Place a Bid\",\n    offerBtn: \"Buy Now\",\n    sellBtn: \"Sell\",\n  };\n  const { currencies } = ENV;\n  const expiryOptions = [\n    { label: \"5 Days\", value: moment().add(5, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"7 Days\", value: moment().add(7, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"A Month\", value: moment().add(1, \"months\").format(\"DD/MM/YYYY\") },\n    { label: \"Custom Date\", value: -1 },\n  ];\n\n  const config1 = {\n    price: {\n      currency: ENV.currency,\n      amount: \"\",\n    },\n    expiry: {\n      date: expiryOptions[0].value,\n      time: moment(new Date()).format(\"HH:mm\"),\n      type: 1, // 1 for time & 2 for datetime-local\n      datetime: \"\", // for payload\n    },\n  };\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [nftsList, setNftList] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [nftConfig, setNftConfig] = useState(config1);\n  const validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n\n  const propertiesData = [\n    {\n      id: 1,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 2,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 3,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 4,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 5,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 6,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 7,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 8,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n  ];\n  useEffect(() => {\n    props.getNFT(nftId);\n  }, []);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n\n      props.getNFTsByCollection(props.nftDetail.collectionId);\n    }\n  }, [props.nftsAuth]);\n\n  useEffect(() => {\n    if (props.nftsByCollectionStatus) {\n      let moreCollection = [];\n      if (props.nftsByCollection && props.nftsByCollection?.length) {\n        moreCollection = props.nftsByCollection.filter(\n          (item) => item._id !== nftDetail._id\n        );\n      }\n      setNftList(moreCollection);\n    }\n  }, [props.nftsByCollectionStatus]);\n\n  const handleRouting = () => {\n    if (ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId) {\n      history.push({\n        pathname: `/sell-item/${nftDetail._id}`,\n        state: nftDetail,\n      });\n    }\n  };\n\n  console.log(ENV.getUserKeys(\"_id\")._id, \"user id\");\n  console.log(nftDetail, \"nftDetail\");\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        console.log(res, \"exchangeapires\");\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <section className=\"padding-wrapper nft-detail\">\n            <div className=\"container\">\n              <div className=\"row g-3\">\n                <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n                  <div className=\"row\">\n                    <div className=\"col-12 order-2 order-md-1\">\n                      <div className=\"nftDetail-accordion\">\n                        <div\n                          className=\"accordion accordion-flush \"\n                          id=\"accordionFlushExample\"\n                        >\n                          {/* <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                 