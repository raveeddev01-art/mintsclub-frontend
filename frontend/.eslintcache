rorCount":0,"fixableWarningCount":1,"source":"408","usedDeprecatedRules":"200"},{"filePath":"409","messages":"410","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"200"},{"filePath":"411","messages":"412","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"413","usedDeprecatedRules":"200"},{"filePath":"414","messages":"415","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"416"},{"filePath":"417","messages":"418","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"200"},{"filePath":"419","messages":"420","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"200"},{"filePath":"421","messages":"422","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"423","messages":"424","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"200"},{"filePath":"425","messages":"426","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/index.js",[],["427","428"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/store.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/App.js",["429","430","431"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\n\nconst App = React.memo((props) => {\n  let walletAddress = false;\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const history = useHistory();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  // ///set Interval\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n    if (walletAddress) {\n      if (walletAddress !== address || !address) {\n        toast.info(\"Please sign in  with new connected address\");\n        walletAddress = address;\n        // setWalletAddress(address)\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n      // setWalletAddress(address);\n    }\n    // }\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={\n                    ENV.getUserKeys(\"_id\")._id || route.path === \"/login\"||route.path==='Signup' \n                      ? true\n                      : false\n                  }\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nexport default App;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/serviceWorker.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/routes.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/privateRoute.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/index.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/config/config.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/web3.js",["432"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/full-page-loader/full-page-loader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.reducer.js",["433"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/signup/signup.js",["434","435","436","437"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/sell-nft/SellNFT.js",["438","439","440","441","442","443","444","445","446","447","448","449","450","451","452","453"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.js",["454","455","456"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/explore-collections.js",["457","458","459","460"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/collections.reducer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/not-found/not-found.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collection-details/collectiondetails.js",["461","462","463","464","465","466"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport \"./collectiondetails.css\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport FilterComponent from \"../filterComponent/filterComponent\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport { Images } from \"../../assets/assets\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst CollectionDetailsPage = (props) => {\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const location = useLocation();\n\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      if (props?.nfts?.length > 0) {\n        setDisabled(false);\n      } else {\n        if (initial) {\n          setDisabled(true);\n        }\n      }\n      setNfts(props.nfts);\n      setNFTPagination(props.pagination);\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        limit,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      nftQS.collectionId = location.state._id;\n\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n      if (page) {\n        nftQS.page = page;\n      } else {\n        nftQS.page = 1;\n      }\n      if (limit) {\n        nftQS.limit = limit;\n      } else {\n        nftQS.limit = 10;\n      }\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n  ///////////Likes\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const fetchData = (filterObj) => {\n    getNFTs(filterObj);\n  };\n  const { name, logo, description, username } = location.state;\n  const bannerData = {\n    subHeading: \"Nfts\",\n    heading: \"Collections Info\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"d-flex flex-column flex-md-row align-items-center align-items-sm-start\">\n                  <div className=\"ms-lg-5 collection-owner-avatar user-avatar-container me-3 flex-fill\">\n                    <img\n                      src={logo ? logo : Images.profilePlaceholder}\n                      alt=\"owner-avatar\"\n                    />\n                  </div>\n                  <div className=\"collection-owner-detail text-center text-sm-start mt-2 mt-sm-4\">\n                    <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n                      <div className=\"collection-owner-name\">\n                        <h3>\n                          {name}{\" \"}\n                          <span>\n                            <img\n                              src={TickIcon}\n                              alt=\"tick-icon\"\n                              className=\"ms-2\"\n                            />\n                          </span>\n                        </h3>\n                      </div>\n                      <div>\n                        <p>\n                          Created By: <span>{username?.[0]}</span>\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-description mt-3\">\n                      <p>{description && description} </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-7 col-md-6 col-lg-5\"></div>\n            </div>\n          </div>\n        </div>\n        {loader && <FullPageLoader />}\n        <FilterComponent\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={loader}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          path=\"/explore/nftdetail/\"\n          collectionDetail\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftsData.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n})(CollectionDetailsPage);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user-profile/user-edit-profile.js",["467","468","469","470","471","472","473","474","475","476","477","478"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user-profile/UserProfile.js",["479","480","481","482","483","484","485","486","487"],"import React, { useState, useEffect } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./UserProfile.css\";\nimport { ENV } from \"../../config/config\";\nimport {\n  getProfileNfts,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport { getUserById, beforeUser } from \"../user/user.action\";\nimport { Images } from \"../../assets/assets\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport moment from \"moment\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport EthIcon from \"../../assets/images/eth-icon.svg\";\nimport CopyIcon from \"../../assets/images/copy-icon.svg\";\nimport FilterComponent from \"../filterComponent/filterComponent\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst UserProfile = (props) => {\n  const [isAddressCopied, setAddressCopied] = useState(false);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [nftsCopy, setNFTsCopy] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [user, setUser] = useState(\"\");\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const [copy, setCopy] = useState(false);\n  const [collections, setCollections] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [dataLimit, setDataLimit] = useState(10);\n  const [menuFilter, setMenuFilter] = useState(false);\n  const userId = ENV.getUserKeys(\"_id\")._id;\n\n  useEffect(() => {\n    const {\n      getProfileNfts,\n      getMyLikedNfts,\n      beforeUser,\n      getUserById,\n      getCollections,\n    } = props;\n    let searchQs = { page: 1, limit: 99999 };\n    searchQs = ENV.objectToQueryString(searchQs);\n    getProfileNfts(searchQs);\n    let likedNftsQs = { userId };\n    likedNftsQs = ENV.objectToQueryString(likedNftsQs);\n    getMyLikedNfts(likedNftsQs);\n    beforeUser();\n    getUserById(ENV.getUserKeys(\"_id\")._id);\n    getCollections();\n  }, []);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      let myCollections = props.collections.filter(\n        (item) => item.userId === userId\n      );\n      setCollections(myCollections);\n      props.beforeCollection();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    const { profileNFTsStatus, profileNFTs } = props;\n    if (profileNFTsStatus) {\n      const data = profileNFTs.nfts;\n      if (!menuFilter) {\n        const Nfts = data?.filter((item) => item.ownerId === userId);\n        if (Nfts?.length > 0) {\n          setDisabled(false);\n        } else {\n          if (initial) {\n            setDisabled(true);\n          }\n        }\n        setNFTs(Nfts);\n        setNFTPagination({ total: Nfts?.length });\n      } else {\n        setNFTPagination(data.length);\n        handleNftFilter(menuFilter, data);\n      }\n      setInitial(false);\n      setNFTsCopy(data);\n      setLoader(false);\n      setFilterationLoader(false);\n    }\n  }, [props.profileNFTsStatus]);\n\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    const { individualUserAuth, individualUser } = props;\n    if (individualUserAuth) {\n      setUser(individualUser);\n    }\n  }, [props.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const ChangeTooltip = () =>\n    setTimeout(() => {\n      setAddressCopied(false);\n    }, 3000);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      nftQS = { page, limit: 99999 };\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    props.getProfileNfts(qs);\n  };\n\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n\n        let data = {\n          userId,\n          nftId,\n          count: 1,\n        };\n        if ((status === \"dislike\") & (likesCount > 0)) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n          props.toggleLikeDislike(data);\n        }\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(data);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  const handleNftFilter = (id, data = false) => {\n    let itemsToFilter = data ? data : nftsCopy;\n    setInitial(false);\n    if (id === \"Collected\") {\n      const Nfts = itemsToFilter.filter(\n        (item) => item.creatorId !== userId && item.ownerId === userId\n      );\n      setDataLimit(10);\n      setNFTPagination({ total: Nfts.length });\n      setNFTs(Nfts);\n    } else if (id === \"Created\") {\n      const Nfts = itemsToFilter.filter(\n        (item) => item.ownerId === userId && item.creatorId === userId\n      );\n\n      setDataLimit(10);\n      setNFTPagination({ total: Nfts.length });\n      setNFTs(Nfts);\n    } else {\n      handleFavFilter(itemsToFilter);\n    }\n  };\n\n  const handleFavFilter = (data = false) => {\n    let itemToFilter = data ? data : nftsCopy;\n    let favNfts = [];\n    for (var item of itemToFilter) {\n      let foundNft = likedNfts.find((liked) => liked.nftId === item._id);\n      if (foundNft) {\n        favNfts.push(item);\n      }\n    }\n    setDataLimit(10);\n    setNFTPagination({ total: favNfts.length });\n    setNFTs(favNfts);\n  };\n\n  const fetchData = (filterObj) => {\n    getNFTs(filterObj);\n  };\n  const getPaginatedData = () => {\n    setDataLimit((prev) => prev + 10);\n  };\n\n  const bannerData = {\n    subHeading: \"Information\",\n    heading: \"User Profile\",\n  };\n  const menuData = [\"Collected\", \"Created\", \"Favourited\"];\n  return (\n    <>\n      <section className=\"user-profile pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"d-flex flex-column flex-md-row align-items-center align-items-sm-start\">\n                  <div className=\"user-avatar-edit\">\n                    <div className=\"ms-lg-5 collection-owner-avatar user-avatar-container me-3\">\n                      <img\n                        src={\n                          user?.profileImage\n                            ? user.profileImage\n                            : Images.placeholderImg\n                        }\n                        alt=\"owner-avatar\"\n                      />\n                    </div>\n                    <Link to=\"/editprofile\" className=\"user-edit-icon\">\n                      <img src={Images.editIconSmall} />\n                    </Link>\n                  </div>\n                  <div className=\"collection-owner-detail text-center text-sm-start mt-4\">\n                    {user && (\n                      <div className=\"collection-owner-name\">\n                        <h3>{user.username ? user.username : \"unnamed\"}</h3>\n                      </div>\n                    )}\n\n                    <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n                      {user.address && (\n                        <div className=\"user-address mt-2 d-flex  align-items-center \">\n                          <span className={`${copy ? \"d-block\" : \"d-none\"}`}>\n                            {isAddressCopied ? \"Copied\" : \"Copy\"}\n                          </span>\n                          {user && (\n                            <>\n                              <img\n                                src={EthIcon}\n                                alt=\"eth-icon\"\n                                className=\"me-1\"\n                              />\n\n                              <p className=\"acc-adress d-none d-md-block\">\n                                {user.address}\n                              </p>\n                              <p className=\"acc-address d-md-none\">\n                                {user.address.slice(0, 10) +\n                                  \"...\" +\n                                  user.address.slice(-10)}\n                              </p>\n\n                              <img\n                                onMouseLeave={() => {\n                                  setCopy(false);\n                                }}\n                                onMouseOver={() => {\n                                  setCopy(true);\n                                }}\n                                onClick={() => {\n                                  navigator.clipboard.writeText(user.address);\n                                  setAddressCopied(true);\n                                  ChangeTooltip();\n                                }}\n                                src={CopyIcon}\n                                alt=\"copy-icon\"\n                                className=\"user-address-copy ms-4\"\n                              />\n                            </>\n                          )}\n                        </div>\n                      )}\n\n                      <div className=\"mt-2 mt-sm-0\">\n                        {user && (\n                          <p>\n                            Joined:{\" \"}\n                            <span>\n                              {moment(user.createdAt).format(\"MMMM DD YYYY\")}\n                            </span>\n                          </p>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <FilterComponent\n          collections={collections}\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts?.slice(0, dataLimit)}\n          loader={loader}\n          likedNfts={likedNfts}\n          handleLikesTogleApi={handleLikesTogleApi}\n          handleNftFilter={handleNftFilter}\n          nftPagination={nftPagination}\n          fetchData={fetchData}\n          setMenuFilter={setMenuFilter}\n          menuData={menuData}\n          path=\"/explore/nftdetail/\"\n          getPaginatedData={getPaginatedData}\n          UserProfile\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  profileNFTs: state.nft.profileNFTs,\n  profileNFTsStatus: state.nft.profileNFTsStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  individualUser: state.user.individualUser,\n  individualUserAuth: state.user.individualUserAuth,\n  togleLikeRes: state.explore.togleLikeRes,\n  collections: state.collection.collections,\n  getAuth: state.collection.getAuth,\n  nft: state.nft,\n});\n\nexport default connect(mapStateToProps, {\n  getProfileNfts,\n  getNFTs,\n  beforeNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  getUserById,\n  beforeUser,\n  beforeTogleLikeDislike,\n  getCollections,\n  beforeCollection,\n})(UserProfile);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/top-seller/topsellerlist.js",["488","489","490"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card top-seller-card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller text-capitalize mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/auctions.reducer.js",["491"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nft-detail/nftdetail.js",["492","493","494","495","496","497","498","499","500","501","502","503","504","505","506","507","508","509","510","511","512","513","514","515","516","517","518","519","520","521","522","523"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/home-auction-list.js",["524","525","526","527"],"import React, { useState, useEffect } from \"react\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport { connect } from \"react-redux\";\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\nimport { getCreators } from \"./../user/user.action\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst AuctionsList = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [auctions, setAuctions] = useState(null);\n  const [loader, setLoader] = useState(true); // auctions loader\n  const [categories, setCategories] = useState([]);\n  const [categoryId, setCategoryId] = useState(\"all\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    // get live auctions\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n    props.getCreators();\n  }, []);\n\n  // set live auctions\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions } = props.auction;\n\n      setAuctions(auctions);\n      setLoader(false);\n      props.beforeAuction();\n    }\n  }, [props.auction.auctionsAuth]);\n  useEffect(() => {\n    props.getCategories();\n  }, []);\n  useEffect(() => {\n    if (props.collectionFlag) {\n      setCategories(props.categories);\n    }\n  }, [props.collectionFlag]);\n\n  const handleCategoryFilter = (desc) => {\n    setLoader(true);\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getLiveAuctions(qs);\n  };\n  const bannerData = {\n    subHeading: \"Auctions\",\n    heading: \"Live Auctions\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      \n      <section className=\"explore-collection-section home-auction-list padding-wrapper\">\n        {\n          // loader ? (\n          //   <FullPageLoader />\n          // ) : (\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                            key={id}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <div className=\"col-6 col-sm-3\" key={id}>\n                            <button\n                              onClick={() => {\n                                setIsActive(id);\n                                handleCategoryFilter(item.description);\n                              }}\n                              className={`${\n                                id === isActive ? \"active-explore-nav\" : \"\"\n                              } me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          </div>\n                        );\n                      })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-3 align-items-center justify-content-center\">\n              {loader ? (\n                <div className=\"spinner-border\" role=\"status\"></div>\n              ) : auctions && auctions.length > 0 ? (\n                auctions.map((item, index) => {\n                  return (\n                    <div className=\"col-sm-6 col-md-4 col-xl-3\" key={index}>\n                      <AuctionsCards\n                        key={index}\n                        item={item}\n                        ownerName={item.owner.username}\n                        userId={ENV.getUserKeys(\"_id\")._id}\n                        ownerId={item.owner._id}\n                        bidsProfile={item.bidInfo.bidByProfile}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center mt-5\">No Live Auctions Found</p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {auctions &&\n                    props.auction.pagination.total > auctions.length &&\n                    auctions.length > 10 && (\n                      <button className=\"btn btn-linear-gradient px-5\">\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        }\n        <OwnCollectionToday />\n      </section>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  auction: state.auction,\n  user: state.user,\n  collectionFlag: state.collection.collectionFlag,\n  categories: state.collection.categories,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n  getCreators,\n  getCategories,\n  beforeCategory,\n})(AuctionsList);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/popular-collections-list/popular-collections-list.js",["528","529","530","531","532","533","534","535"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [popular, setpopular] = useState([]);\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"all\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getPopularCollections(null, 1);\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      const pagination = props.popularCollections.pagination;\n\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.finalCollectionListing) {\n        let finalCollectionListing = finalCollectionListing.filter(\n          (item) => item.userId === userId\n        );\n        setpopular(finalCollectionListing);\n      } else {\n        if (finalCollectionListing === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setpopular(finalCollectionListing);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.getPopularAuth]);\n\n  const getPopularCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getPopularCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getPopularCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    setPage(page);\n    setLimit(limit + 10);\n    getPopularCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setCategoryId(category);\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getPopularCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n  const bannerData = {\n    subHeading: \"Collections\",\n    heading: \"Popular Collections\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          {\" \"}\n          <section className=\"explore-collection-section padding-wrapper\">\n            <div className=\"container\">\n              <div className=\"row mb-5\">\n                <div className=\"col-12 explore-collection-nav\">\n                  <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                    {categoryId === \"all\" &&\n                    popular &&\n                    popular?.length == 0 &&\n                    !loader\n                      ? \"\"\n                      : categories &&\n                        categories.length > 0 &&\n                        categories.map((item,index) => {\n                          return (\n                            <button\n                              onClick={() => {\n                                setIsActive(item.name);\n                                setSelectedCategory(item.description);\n                                handleFilterCategory(item.description);\n                              }}\n                              key={index}\n                              className={`${\n                                item.name === isActive\n                                  ? \"active-explore-nav\"\n                                  : \"\"\n                              } me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          );\n                        })}\n                  </div>\n                  <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                    {categoryId === \"all\" &&\n                    popular &&\n                    popular?.length == 0 &&\n                    !loader\n                      ? \"\"\n                      : categories &&\n                        categories.length > 0 &&\n                        categories.map((item,index) => {\n                          return (\n                            <div className=\"col-6 col-sm-3\" key={index}>\n                              <button\n                                onClick={() => {\n                                  setIsActive(item.name);\n                                  setSelectedCategory(item.description);\n                                  handleFilterCategory(item.description);\n                                }}\n                                className={\n                                  isActive === item.name\n                                    ? \"active-explore-nav\"\n                                    : \"\"\n                                }\n                              >\n                                {item.name}\n                              </button>\n                            </div>\n                          );\n                        })}\n                  </div>\n                </div>\n              </div>\n              <div className=\"row g-1 align-items-center justify-content-center\">\n                {loader ? (\n                  <div class=\"spinner-border\" role=\"status\">\n                    <span class=\"sr-only\">Loading...</span>\n                  </div>\n                ) : popular && popular.length > 0 ? (\n                  popular.map((item,index) => {\n                    return (\n                      <div className=\"col-sm-6 col-lg-4 col-xl-3\" key={index}>\n                        <CollectionsCard\n                          CardImg={item.featuredImg}\n                          Subimg1={handleImage(item, 0)}\n                          Subimg2={handleImage(item, 1)}\n                          Subimg3={handleImage(item, 2)}\n                          name={item.name}\n                          id={item._id}\n                          collection={item}\n                          userName={item.username[0]}\n                          NFTCount={item.totalNfts}\n                          profileImage={item.profileImage[0]}\n                        />\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center  not-found-title mt-5\">\n                    No Popular Collections Found\n                  </p>\n                )}\n\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {!empty &&\n                      popular?.length === 10 &&\n                      pagination.totalRecords > popular.length && (\n                        <button\n                          className=\"btn btn-rounded-bordered px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more...\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n        </>\n      )}\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforePopularCollection,\n    getPopularCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/aboutus/aboutus.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.reducer.js",["536","537"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/create-nft.js",["538","539","540","541","542"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/creat-collections/CreateCollections.js",["543","544","545","546","547","548","549","550","551","552"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/faqs/faqs.js",["553","554"],"import React, { useEffect } from \"react\";\nimport \"./faqs.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport { Accordion, Card } from \"react-bootstrap\";\n\nconst bannerData = {\n  subHeading: \"Ask\",\n  heading: \"FAQ\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nconst faqsData = [\n  {\n    question: \"What is MintsClub?\",\n    ans: \"MintsClub is a revolutionary 21st Century blockchain product that brings users one step closer to experiencing Metaverse. The users can mint their digital assets such as images, GIFs, games, sports accessories and more into the cryptomarket and establish a stable revenue stream.\",\n  },\n  {\n    question: \"What is a MintsClub token?\",\n    ans: \"MintsClub token, famously known as Non-fungible Token (NFT) is a distinct cryptographic token that exists on the blockchain platform and cannot be replicated. Tokenization of digital assets has made it easier to buy and sell while reducing the threat of fraudulent acts.\",\n  },\n  {\n    question: \"What is the total supply of MINT?\",\n    ans: \"The total supply of 1-inch Mint tokens is 1.5 billion.\",\n  },\n  {\n    question: \"Where can I buy/sell MINT?\",\n    ans: \"You can sell your NFTs on blockchain marketplaces such as Binance, Cardano, Solana and Algoran and now, MintsClub.\",\n  },\n];\n\nconst Faqs = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper faqs\">\n        <div className=\"container\">\n          <div className=\"row align-items-center justify-content-center\">\n            <div className=\"col-12\">\n              <div\n                className=\"faqs-accordion accordion accordion-flush mx-auto\"\n                id=\"accordionFlushExample\"\n              >\n                {faqsData.map((faq, id) => {\n                  return (\n                    <div className=\"accordion-item mb-4\">\n                      <h2 className=\"accordion-header\" id={`${id}`}>\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target={`#c${id}`}\n                          aria-expanded=\"false\"\n                          aria-controls={`c${id}`}\n                        >\n                          <span>Q{`${id + 1}.`}</span>\n                          {faq.question}\n                        </button>\n                      </h2>\n                      <div\n                        id={`c${id}`}\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby={`${id}`}\n                      >\n                        <div className=\"accordion-body\">\n                          <p>{faq.ans}</p>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Faqs;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/explore.reducer.js",["555"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/all-nft/allnft.js",["556","557","558","559","560","561","562","563","564"],"import React, { useState, useEffect } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./allnft.css\";\nimport { beforeNFT, getNFTs, getMyLikedNfts } from \"../../nfts/nfts.action\";\nimport { ENV } from \"../../../config/config\";\nimport { getCreators, beforeUser } from \"./../../user/user.action\";\nimport { toggleLikeDislike, beforeTogleLikeDislike } from \"../explore.action\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../../collections/collections.actions\";\nimport { validateNetwork } from \"../../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport FilterComponent from \"../../filterComponent/filterComponent\";\nimport Banner from \"../../banner/banner\";\nimport BannerBg from \"../../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../../own-collection-today/own-collection-today\";\n\nconst bannerData = {\n  subHeading: \"Explore\",\n  heading: \"All NFTs\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n\nconst AllNFT = (props) => {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [collections, setCollections] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getCreators();\n    props.getCollections();\n    if (props?.location?.state) {\n      props.beforeNFT();\n      let searchQs = { keyword: props.location.state, page: 1, limit: 10 };\n      window.history.replaceState(null, \"\");\n      searchQs = ENV.objectToQueryString(searchQs);\n      console.log(searchQs, \"searchQs\");\n      setFilterationLoader(true);\n      props.getNFTs(searchQs);\n    } else {\n      getNFTs();\n    }\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // props.beforeUser()\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  //Get NFt's\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nfts, pagination } = props.nft.nftsData;\n      if (nfts) {\n        if (nfts.length > 0) {\n          setDisabled(false);\n        } else {\n          if (initial) {\n            setDisabled(true);\n          }\n        }\n        setNFTs(nfts);\n        setNFTPagination(pagination);\n        setFilterationLoader(false);\n        props.beforeNFT();\n\n        setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  //pagination\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setCollections(props.collections);\n      props.beforeCollection();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        limit,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n      if(page){\n        nftQS.page=page;\n      } else {\n        nftQS.page=1;\n      }\n      if(limit){\n        nftQS.limit=limit;\n      } else {\n        nftQS.limit=10;\n      }\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable || likeButtonDisable === null) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n  const fetchData = (filterObj) => {\n  \n      getNFTs(filterObj);\n  };\n \n  return (\n    <>\n      <section className=\"explore-collection-section padding-wrapper pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          content={bannerData.content}\n          bgImg={BannerBg}\n          bannerImg={BannerImage}\n        />\n\n        <FilterComponent\n          collections={collections}\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={loader}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          initialKeyword={props?.location?.state}\n          path=\"/explore/nftdetail/\"\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFTs,\n  getCreators,\n  toggleLikeDislike,\n  getCollections,\n  getMyLikedNfts,\n  beforeCollection,\n  beforeUser,\n  beforeTogleLikeDislike,\n})(AllNFT);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/categories/categories.reducer.js",["565"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user/user.reducer.js",["566"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nfts/nfts.reducer.js",["567"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n      case BEFORE_NFTS_BY_COLLECTION:\n        return {\n          ...state,\n          nftsByCollectionStatus: false,\n        }\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/bids/bids.reducer.js",["568"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/reducer/reducer.js",["569"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/offers/offers.reducer.js",["570"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout4/layout4.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/shared/error/error.reducer.js",["571"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout3/layout3.jsx",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout/layout.jsx",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/top-seller/topseller.js",["572","573"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/home-auctions.js",["574","575","576","577","578","579","580"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/types.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/popular-collections.js",["581","582","583","584","585","586"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/shared/error/error.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/categories/categories.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/collections.actions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/hero/hero.js",["587","588","589","590"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport \"./hero.css\";\r\nimport Play from \"../../assets/images/play.svg\";\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport HeroCards from \"../hero-cards/HeroCards\";\r\nimport { ListingImg } from \"../../assets/assets\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeAuction, getLiveAuctions } from \"../auctions/auctions.action\";\r\nimport { connect } from \"react-redux\";\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n  const [auctions, setAuctions] = useState(null);\r\n  const heroSettings = ENV.heroSettings;\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n  useEffect(() => {\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions } = props.auction;\r\n      let updatedAuctions = [];\r\n      if (auctions.length > 0) {\r\n        updatedAuctions = auctions.filter((item) => item.fileType === \"image\");\r\n      }\r\n      if (updatedAuctions?.length > 6) {\r\n        updatedAuctions = updatedAuctions.slice(0, 6);\r\n      }\r\n      setAuctions(updatedAuctions);\r\n\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, <br /> <span>and sell </span>\r\n              <br />\r\n              Extraordinary <span> NFTs </span>\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create me-sm-4\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                Create\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                Explore\r\n              </Link>\r\n            </div>\r\n            <div className=\"watch-video d-flex align-items-center mt-5 mb-4\">\r\n              <button className=\"hero-play-btn\">\r\n                <img src={Play} alt=\"play\" />\r\n              </button>\r\n              <span className=\"ms-2\">Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6\">\r\n            <CardSlider settings={heroSettings}>\r\n              {auctions &&\r\n                auctions.length > 0 &&\r\n                auctions.map((auction, id) => {\r\n                  return (\r\n                    <HeroCards key={id} auction={auction} className=\"slide\" />\r\n                  );\r\n                })}\r\n            </CardSlider>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n})(Hero);\r\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/buy-sell/Buysell.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/banner/banner.js",["591"],"import React from \"react\";\nimport \"./banner.css\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst Banner = ({ subHeading, heading, content, bgImg, bannerImg }) => {\n  return (\n    <>\n      <div\n        className=\"banner-wrapper padding-wrapper\"\n        style={{ backgroundImage: `url(${bgImg})` }}\n      >\n        <div className=\"container\">\n          <div className=\"row align-items-end\">\n            <div className=\"col-md-9 col-lg-7\">\n              <div className=\"intro\">\n                <div className=\"intro-content clr-blue\">\n                  {subHeading && <span>{subHeading}</span>}\n                  {heading && <h3 className=\"mb-0\">{heading}</h3>}\n                  {content && <p className=\"pt-4\">{content}</p>}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-lg-5 d-none d-lg-block\">\n              <div className=\"banner-img\">\n                {bannerImg && <img src={bannerImg} alt=\"banner-img\" />}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Banner;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/own-collection-today/own-collection-today.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/assets/assets.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/footer/footer.js",["592","593","594","595","596","597"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/filterComponent/filterComponent.js",["598","599","600","601","602"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/types/types.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/scroll-up/sroll-up.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/navbar-main/NavbarMain.js",["603","604"],"import React, { useState } from \"react\";\nimport { Link, useHistory, useLocation, NavLink } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport { ReactComponent as LoginIcon } from \"../../assets/images/login-icon.svg\";\nimport { ReactComponent as SearchIcon } from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [searchactive, setSearchActive] = useState(false);\n  const [searchValue, setSearchValue] = useState(\"\");\n  const history = useHistory();\n  const location = useLocation();\n\n  const handleChange = (e) => {\n    setSearchValue(e.target.value);\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword = () => {\n    if (searchValue !== \"\" && searchValue.length >= 3) {\n      history.push({\n        pathname: \"/explore/allNFT\",\n        state: searchValue,\n      });\n    }\n  };\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n\n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"light\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <NavLink to=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </NavLink>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className={\"mx-xl-auto\"}>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/\">Home</NavLink>\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/exploreAll\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Explore All\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/allNFT\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    All NFT\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/create\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Create NFT\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/createcollection\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Create Collection\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/userprofile\" className=\"nav-main-link\">\n                  Profile\n                </NavLink>\n              </Nav.Link>\n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <span className=\"me-2\">\n                    <LoginIcon />\n                  </span>\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={() => handleSearchKeyword()}\n                >\n                  <SearchIcon className=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={() => handleSearchKeyword()}\n              >\n                <SearchIcon className=\"search-icon\" />\n              </button>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient btn-login\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <span className=\"me-2\">\n                  <LoginIcon />\n                </span>\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/explore.action.js",["605"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user/user.action.js",["606","607"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nfts/nfts.action.js",["608","609"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/functions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/levelsinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/statsinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/PropertiesModal.js",["610"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/StatsModal.js",["611","612"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/LevelsModal.js",["613"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections-cards/CollectionsCard.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions-cards/AuctionsCards.js",["614"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/card-slider/CardSlider.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/auctions.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/footer/footer.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/hero-cards/HeroCards.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nft-card/nft-card.js",["615","616","617"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/BuyModal.js",["618","619","620","621","622"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/BidModal.js",["623"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/offers/offers.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/bids/bids.action.js",["624","625"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/breadcrumb/breadcrumb.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/listing-cards/ListingCards.js",["626"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n",["627","628"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/ApprovalModal.js",["629","630","631"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n  return (\n    <>\n      {\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title className=\"acc-title mt-lg-3 mt-5\">\n              {approvalStatus === \"approved\"\n                ? \"Congratulations\"\n                : approvalStatus === \"in-progress\"\n                ? \"We’re on it\"\n                : \"Your account if not approved yet.\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\" onClick={onHide}>\n              <button>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </Modal.Header>\n          <Modal.Body>\n            {approvalStatus === \"approved\" ? (\n              <>\n                <img src={Images.sellerTickIcon} className=\"success-icon\" />\n                <div className=\"w-100 px-4 mb-2\">\n                  <div className=\"acc-approved-container mt-5 mb-5\">\n                    <p className=\"acc-approved ms-4 mb-0\">\n                      Your Account has been approved.\n                    </p>\n                    <img src={Images.smile} className=\"smile-img\" />\n                  </div>\n                </div>\n              </>\n            ) : approvalStatus === \"in-progress\" ? (\n              <>\n                <div className=\"approval-spinner mb-4\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n                <p className=\"processing-title text-center w-100\">\n                  Processing...\n                </p>\n                <div className=\"w-100 px-3\">\n                  <p className=\"approve-msg text-start ms-3 mt-3 \">\n                    Wallet Address\n                  </p>\n                  <input\n                    className=\"input-common mb-5\"\n                    value={address}\n                    readOnly\n                  />\n                </div>\n              </>\n            ) : (\n              <>\n                <img\n                  src={Images.metamaskImg}\n                  className=\"approve-metamask-img\"\n                />\n                <div className=\" w-100 px-3\">\n                  <p className=\"approve-msg w-100 text-start ms-3 mt-3 \">\n                    Please approve your wallet address to reach us\n                  </p>\n                  <input className=\"input-common\" value={address} readOnly />\n                </div>\n                <button\n                  className=\"btn btn-linear-gradient mt-4 my-4 get-approved-btn\"\n                  disabled={approvalStatus === \"pending\"}\n                  onClick={() => approveAccount()}\n                >\n                  {approvalStatus === \"pending\" ? (\n                    <div\n                      class=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>\n                  ) : (\n                    \"Get Approved\"\n                  )}\n                </button>\n              </>\n            )}\n          </Modal.Body>\n        </Modal>\n       \n      }\n    </>\n  );\n};\nexport default ApprovalModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/contentLoader/imageLoader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/cardImage/auctionsCardImage.js",["632"],"import { useState } from \"react\";\nimport ImageLoader from \"../contentLoader/imageLoader\";\nimport { Card } from \"react-bootstrap\";\n\nconst AuctionCardImage = ({ image, index }) => {\n  const [loader, setLoader] = useState(true);\nconsole.log(index,\"indexauctions\")\n  return (\n    <>\n      {index % 2 === 0 ? (\n        <ImageLoader />\n      ) : (\n        <Card.Img variant=\"top\"   onLoad={() => setLoader(false)} src={image} alt=\"AuctionTopImg\" />\n\n      )}\n    </>\n  );\n};\nexport default AuctionCardImage;\n",["633","634"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/contentLoader/collectionSubLoader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/privacy-policy/privacyPolicy.js",["635"],"import React, { useEffect } from \"react\";\nimport \"./privacyPolicy.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\n\nconst bannerData = {\n  subHeading: \"Our Privacy Policy\",\n  heading: \"Privacy Policy\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nconst PrivacyPolicy = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper privacy\">\n        <div className=\"container\">\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Privacy Policy</h5>\n            <p>\n              MintsClub is committed to protecting your privacy. We have\n              prepared this Privacy Policy to describe our working practices\n              regarding the Personal Data we collect, use, and share in\n              connection with the MintsClub website, as described in our Terms\n              of Service (collectively, the “Service”). “NFT” as per this\n              Privacy Policy refers to a non-fungible token or similar digital\n              item implemented on a blockchain (such as the Ethereum\n              blockchain), which uses smart contracts to link to or otherwise be\n              associated with certain content or data.\n              <br />\n              By using our platform and the Services, you accept the terms of\n              this Policy and our Terms of Use, and consent to our collection,\n              use, disclosure, and retention of your information as described in\n              this Policy. If you have not done so already, please also review\n              our terms of use. The terms of use contain provisions that limit\n              our liability to you and require you to resolve any dispute with\n              us on an individual basis and not as part of any class or\n              representative action. <br />\n              <span>\n                IF YOU DO NOT AGREE WITH ANY PART OF THIS PRIVACY POLICY OR OUR\n                TERMS OF USE, THEN PLEASE DO NOT USE ANY OF THE SERVICES.\n              </span>\n              <br />\n              Please note that this Policy does not apply to information\n              collected through third-party websites or services that you may\n              access through the Services or that you submit to us through\n              email, text message or other electronic message or offline.\n            </p>\n          </div>\n          <div className=\"privacy-content\">\n            <h5>Information We Collect</h5>\n            <p>We may collect information about you in a range of ways.</p>\n            <ul>\n              <li>\n                {\" \"}\n                Identity information, such as your first name, last name,\n                username or similar identifier, title, date of birth and gender.\n              </li>\n              <li>\n                {\" \"}\n                Contact information, such as your postal address, email address\n                and telephone number.\n              </li>\n              <li>\n                {\" \"}\n                Profile information, such as your, profile picture, username and\n                wallet address, interests, preferences, feedback and survey\n                responses.\n              </li>\n              <li>\n                {\" \"}\n                Feedback and correspondence, such as information you provide in\n                your responses to surveys, when you participate in market\n                research activities, report a problem with Service, receive\n                customer support or otherwise correspond with us.\n              </li>\n              <li>\n                {\" \"}\n                Financial information, such as your credit card or other payment\n                card details.\n              </li>\n              <li>\n                {\" \"}\n                Transaction information, such details about purchases you make\n                through the Service and billing details.\n              </li>\n              <li>\n                {\" \"}\n                Usage information, such as information about how you use the\n                Service and interact with us.\n              </li>\n              <li>\n                {\" \"}\n                Marketing information, such as your preferences for receiving\n                marketing communications and details about how you engage with\n                them.\n              </li>\n              <li>\n                {\" \"}\n                Financial information, such as bank account number and bank\n                routing number; financial assets holdings.\n              </li>\n              <li>\n                {\" \"}\n                Technical information, such as your Ethereum wallet address,\n                application programming interface (API)-key and network\n                information regarding transactions. Please note that your\n                Ethereum wallet address is not collected by{\" \"}\n                <a href=\"https://metamask.io/\" target=\"_blank\">\n                  Metamask{\" \"}\n                </a>\n                or associated plugins and mobile applications.\n              </li>\n            </ul>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected by other means</h5>\n            <p>\n              As you navigate through and interact with the MintsClub website,\n              we may use automatic data collection technologies to collect\n              certain information about your equipment, browsing actions, and\n              patterns, including:\n              <br />\n              Information Collected by Our Servers. To provide our Service and\n              make it more useful to you, we (or a third party service provider)\n              collect information from you, including, but not limited to, your\n              browser type, operating system, Internet Protocol (“IP”) address,\n              mobile device ID, blockchain address, wallet type, and date/time\n              stamps.\n              <br />\n              Log Files. We gather certain information automatically and store\n              it in log files. This information includes IP addresses, browser\n              type, Internet service provider (“ISP”), referring/exit pages,\n              operating system, date/time stamps, and clickstream data. We use\n              this information to analyze trends, administer the Service, track\n              users’ movements around the Service, and better tailor our\n              Services to match our users’ needs and improve their experience.\n              <br />\n              Cookies. Like many online services, we use cookies to collect\n              information. We may use both session Cookies (which expire once\n              you close your web browser) and persistent Cookies (which stay on\n              your computer until you delete them) to analyze how users interact\n              with our Service, make improvements to our product quality, and\n              provide users with a more personalized experience.\n              <br />\n              Pixel Tag. In addition, we use “Pixel Tags” (also referred to as\n              clear Gifs, Web beacons, or Web bugs). Pixel Tags allow us to\n              analyze how users find our Service, make the Service more useful\n              to you, and tailor your experience with us to meet your particular\n              interests and needs.\n              <br />\n              Analytics Services. In addition to the tracking technologies we\n              place like Cookies and Pixel Tags, other companies may set their\n              own cookies or similar tools when you visit our Service. This\n              includes third-party analytics services (“Analytics Services”)\n              that we engage to help analyze how users use the Service. The\n              information generated by the Cookies or other technologies about\n              your use of our Service (the “Analytics Information”) is\n              transmitted to the Analytics Services. The Analytics Services use\n              Analytics Information to compile reports on user activity, which\n              we may receive on an individual or aggregate basis. We use the\n              information we get from Analytics Services to improve our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected from Third-Parties</h5>\n            <p>\n              We may receive Personal and/or Anonymous Data about you from\n              companies that offer their products and/or services for use in\n              conjunction with our Service or whose products and/or services may\n              be linked from our Service. For example, third-party wallet\n              providers provide us with your blockchain address and certain\n              other information you choose to share with those wallets\n              providers. We may add this to the data we have already collected\n              from or about you through our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected from Public Blockchains</h5>\n            <p>\n              We may collect data from your activity that is publicly visible\n              and/or accessible on blockchains. This may include blockchain\n              addresses and information regarding purchases, sales, or transfers\n              of NFTs, which may then be associated with other data you have\n              provided to us.e have already collected from or about you through\n              our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Use of Your Personal Data</h5>\n            <p>\n              When we collect your Personal Data from you, we will inform you at\n              the time as to the reason we are requesting such Personal Data.\n              The Company uses your Personal Data in any or all of the following\n              ways:\n            </p>\n            <ul>\n              <li> To facilitate you in the creation of your account.</li>\n              <li> Recognise you as a legitimate user of our platform.</li>\n              <li>\n                {\" \"}\n                Provide you with our Service, which includes helping you view,\n                explore, and create NFTs using our platform and, at your own\n                risk, connect with other users to purchase, sell NFTs on public\n                blockchains.\n              </li>\n              <li>\n                {\" \"}\n                Administration of our Service and quality of experience when you\n                interact with our platform.\n              </li>\n              <li> Provide customer support and respond to your queries.</li>\n              <li>\n                {\" \"}\n                Show your username next to the NFTs currently or previously\n                accessible in your third-party wallet, and next to NFTs on which\n                you have interacted.\n              </li>\n              <li>\n                {\" \"}\n                Send you notifications related to activity on the platform,\n                including notifications of offers on your NFTs.\n              </li>\n              <li>\n                {\" \"}\n                Send you newsletters, promotional materials, and other notices\n                related to our Services.\n              </li>\n              <li>\n                {\" \"}\n                To comply with applicable laws and cooperate with investigations\n                by law enforcement agencies.\n              </li>\n            </ul>\n          </div>\n          <div className=\"privacy-content\">\n            <h5>Disclosure of your Personal Data</h5>\n            <h6>\n              Third Party Service Providers:{\" \"}\n              <span>\n                We may share your Personal Data with third party service\n                providers.\n              </span>\n            </h6>\n            <h6>\n              Analytics:{\" \"}\n              <span>\n                We may share your data to be used by analytic platforms or other\n                such equivalent tools which make use of statistical information.\n              </span>\n            </h6>\n            <h6>\n              Legal Rights:{\" \"}\n              <span>\n                We may also share information as required by law, regulation,\n                legal process, or governmental request.\n              </span>\n            </h6>\n            <h6>\n              Other Disclosures:{\" \"}\n              <span>\n                We may also disclose your Personal Data: to fulfill the purpose\n                for which you provide it; for any other purpose disclosed by us\n                when you provide it; or with your consent.\n              </span>\n            </h6>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Third-Party Websites</h5>\n            <p>\n              Our platform may contain links to third-party websites. When you\n              click on a link to any other website or location, you will leave\n              our website and go to another site, and another entity may collect\n              Personal Data from you. We have no control over, do not review,\n              and cannot be responsible for these third-party websites or their\n              content. Please be aware that the terms of this Privacy Policy do\n              not apply to these third-party websites or their content, or to\n              any collection of your Personal Data after you click on links to\n              such third-party websites.\n              <br />\n              You may access other third-party services through the Site, for\n              example by clicking on links to those third-party services from\n              within the Site. We are not responsible for the privacy policies\n              and/or practices of these third-party services, and we encourage\n              you to carefully review their privacy policies.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Third-Party Wallets</h5>\n            <p>\n              To use the MintsClub NFT platform, you must use a third-party\n              wallet which allows you to engage in transactions on public\n              blockchains. Your interactions with any third-party wallet\n              provider are governed by the applicable terms of service and\n              privacy policy of the respective third party.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Security of Data</h5>\n            <p>\n              We care about the security of your data and use adequate physical,\n              administrative, and technological measures to maintain the\n              security of the data collected through our platform. Nonetheless,\n              no physical and logical security framework is perfect, and hence\n              no guarantee can be provided. In the unfortunate event where any\n              data is compromised as a result of a security breach, we will take\n              steps to investigate and remedy the situation at the earliest. We\n              will also notify any such individuals whose information may have\n              been compromised.\n              <br />\n              It is imperative that you understand the seriousness associated\n              with the security of your digital wallet, the responsibility of\n              which is yours. We insist that you take steps to ensure it and any\n              information related to your wallet remains secure at all times. If\n              you discover an issue related to your wallet, please contact your\n              wallet provider.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Data Storage and Retention</h5>\n            <p>\n              Your Personal Data may be retained for as long as you continue to\n              use our platform, have an account registered with us, or for as\n              long as it is necessary to fulfill the purposes mentioned in this\n              Privacy Policy. Personal Data may be retained even after your\n              account has been deactivated, if such retention is reasonably\n              necessary to comply with our legal obligations, to resolve\n              disputes, prevent fraud and abuse, enforce our Terms or other\n              agreements, and/or protect our legitimate interests. We will\n              delete any Personal Data where it is no longer required for\n              purposes mentioned in this privacy policy.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Your Rights</h5>\n            <p>\n              If you are a user belonging from the European Economic Area or\n              United Kingdom, or are a California resident, you have certain\n              rights under the respective European and UK General Data\n              Protection Regulations (“GDPR”) and the respective California\n              Consumer Privacy Act (“CCPA”).\n              <br />\n              ​Collectively, depending the situation you have the following data\n              protection rights:\n            </p>\n            <ul>\n              <li>\n                {\" \"}\n                The right to access, update or to delete the information we have\n                on you. Whenever made possible, you can access, update or\n                request deletion of your Personal Data.\n              </li>\n              <li>\n                {\" \"}\n                The right of rectification. You have the right to have your\n                information rectified if that information is inaccurate or\n                incomplete.\n              </li>\n              <li>\n                {\" \"}\n                The right of restriction. You have the right to request that we\n                restrict processing of your personal information.\n              </li>\n              <li>\n                {\" \"}\n                The right to erasure or right to be forgotten. If at any time\n                you do not agree with the collection or use of your personal\n                information as mentioned in this privacy policy and you want us\n                to delete your data.\n              </li>\n              <li>\n                {\" \"}\n                The right to data portability. You have the right to be given a\n                copy of the information we have on you in a structured,\n                machine-readable and commonly used format and have the right to\n                transmit that data to another controller on request.\n              </li>\n              <li>\n                {\" \"}\n                The right to withdraw consent. You may withdraw your consent to\n                the processing of data or information for the purposes as\n                mentioned in this privacy policy.\n              </li>\n              <li>\n                {\" \"}\n                The right to deactivate cookies. If you wish to restrict or\n                block all the cookies which are set by our websites, please use\n                the tool available on the particular website (if applicable), or\n                refer to the Help function within your browser to learn how to\n                manage your settings within your browser.\n              </li>\n            </ul>\n            <p>\n              In some situations we may not be able to enact upon your request,\n              if there is lawful reason or legal obligation that prevents us\n              from timely compliance with such request.\n              <br />\n              In order to exercise any of the above rights you may drop your\n              request with our chatbot.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Changes to Privacy Policy </h5>\n            <p>\n              MintsClub may make changes to this Privacy Policy at any time. We\n              insist all visitors and users to our website to frequently review\n              the Privacy Policy, to learn about the latest changes to our\n              privacy practices and other operational mechanisms. Any changes to\n              our privacy policy will be accompanied with a ‘last updated date’\n              for your convenience.\n              <br />\n              Your continued use of the Website or our platform’s services\n              indicates your acknowledgement and/or acceptance of any changes to\n              the updated Privacy Policy.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Privacy for Children</h5>\n            <p>\n              MintsClub does not target, and is not intended to attract, users\n              under the age of eighteen (18) years. We do not knowingly collect\n              Personal Data from users under the age of eighteen (18) years or\n              send requests to users under the age of eighteen (18) years for\n              Personal Data.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Contact and Queries</h5>\n            <p>\n              If you have any questions or concerns regarding this Privacy\n              Policy or Mints.Club data collection or processing practices, or\n              if you want to report any security violations to us, drop your\n              queries with our chatbot.\n            </p>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default PrivacyPolicy;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/terms-conditions/termsConditions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/audioPlayer/waveform/WaveForm.js",["636","637"],"import React, { Component } from \"react\";\nimport WaveSurfer from \"wavesurfer.js\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { ReactComponent as AudioIcon } from \"../../../assets/images/audio-icon.svg\";\nimport { WaveformContianer, Wave, PlayButton } from \"./Waveform.styled\";\nimport BackgroundImg from \"../../../assets/images/audio-bg.svg\";\n\nimport \"./WaveForm.css\";\n\nclass Waveform extends Component {\n  constructor(props) {\n    super(props);\n  }\n  state = {\n    playing: false,\n  };\n  componentDidMount() {\n    const track = document.querySelector(\"#track\");\n\n    this.waveform = WaveSurfer.create({\n      barWidth: 2,\n      cursorWidth: 1,\n      container: \"#waveform\",\n      backend: \"WebAudio\",\n      height: 80,\n      progressColor: \"#FFFFFF\",\n      responsive: true,\n      waveColor: \"#838383\",\n      cursorColor: \"transparent\",\n    });\n\n    this.waveform.load(track);\n  }\n\n  componentWillUnmount() {\n    this.setState({ playing: false });\n    this.waveform.playPause();\n  }\n\n  handlePlay = () => {\n    this.setState({ playing: !this.state.playing });\n    this.waveform.playPause();\n  };\n\n  render() {\n    return (\n      <WaveformContianer\n        className=\"wave-container px-4 px-xl-5\"\n        style={{\n          background: `rgba(0, 0, 0, 0.79)`,\n          display: `${!this.props.loader ? \"block\" : \"none\"}`,\n        }}\n      >\n        <PlayButton className=\"audio-btn\" onClick={this.handlePlay}>\n          {this.state.playing ? <BsFillPauseFill /> : <BsFillPlayFill />}\n        </PlayButton>\n        <div\n          className={`${\n            this.props.auction ? \"d-none\" : \"\"\n          } audio-icon-wrapper mt-5 d-flex justify-content-center`}\n        >\n          <AudioIcon />\n        </div>\n       <Wave\n          className={`${this.props.auction ? \"mt-5\" : \"\"} waves mb-3`}\n          id=\"waveform\"\n        />\n\n         <audio\n          id=\"track\"\n          onLoadStart={() => console.log(\"onload start\")}\n          oncanplay={() => {\n            this.props.onLoadCallback();\n          }}\n          onEnded={() => {\n            this.handlePlay();\n          }}\n          src={this.props.url}\n        /> \n        {\" \"}\n      </WaveformContianer>\n    );\n  }\n}\n\nexport default Waveform;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/audioPlayer/AudioPlayer.js",[],["638","639"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/audioPlayer/waveform/Waveform.styled.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/contentLoader/nftDetailLoader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/audio/audio.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/contentLoader/sellNFTLoader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auction-audio/auctionAudio.js",[],{"ruleId":"640","replacedBy":"641"},{"ruleId":"642","replacedBy":"643"},{"ruleId":"644","severity":1,"message":"645","line":18,"column":13,"nodeType":"646","endLine":20,"endColumn":4},{"ruleId":"644