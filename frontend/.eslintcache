recatedRules":"186"},{"filePath":"300","messages":"301","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"302","messages":"303","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"304","messages":"305","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"306","messages":"307","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"308","usedDeprecatedRules":"186"},{"filePath":"309","messages":"310","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"311","usedDeprecatedRules":"186"},{"filePath":"312","messages":"313","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"314","messages":"315","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"316","messages":"317","errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":4,"source":"318","usedDeprecatedRules":"186"},{"filePath":"319","messages":"320","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"321","messages":"322","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"323","messages":"324","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"325","messages":"326","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"327","messages":"328","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"329","messages":"330","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"331","usedDeprecatedRules":"186"},{"filePath":"332","messages":"333","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"334","usedDeprecatedRules":"186"},{"filePath":"335","messages":"336","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"337","usedDeprecatedRules":"186"},{"filePath":"338","messages":"339","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"340","messages":"341","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"342","messages":"343","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"344","messages":"345","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"346","messages":"347","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"348","messages":"349","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"350","messages":"351","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"352","messages":"353","errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"354"},{"filePath":"355","messages":"356","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"357","messages":"358","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"359","messages":"360","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"361","messages":"362","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"363","messages":"364","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"365","messages":"366","errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"367"},{"filePath":"368","messages":"369","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"370","messages":"371","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"372","messages":"373","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"374","messages":"375","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"376","usedDeprecatedRules":"186"},{"filePath":"377","messages":"378","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"379","messages":"380","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"381","usedDeprecatedRules":"186"},{"filePath":"382","messages":"383","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"384","usedDeprecatedRules":"186"},{"filePath":"385","messages":"386","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"387","messages":"388","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"389","messages":"390","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"391","messages":"392","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"393","messages":"394","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/index.js",[],["397","398"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/store.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/App.js",["399","400","401"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/serviceWorker.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/routes.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/privateRoute.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/index.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/config/config.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/web3.js",["402"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/full-page-loader/full-page-loader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.reducer.js",["403"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/signup/signup.js",["404","405","406","407","408","409","410","411"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/sell-nft/SellNFT.js",["412","413","414","415","416","417","418","419","420","421","422","423","424","425","426","427","428"],"import React, { useState, useEffect } from \"react\";\nimport \"./SellNFT.css\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport \"bootstrap-daterangepicker/daterangepicker.css\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  getMyLikedNfts,\n  createActivity,\n} from \"../nfts/nfts.action\";\nimport {\n  openNFTForBidding,\n  putonsale,\n  getWalletAddress,\n  setApprovalForAll,\n  validateNetwork,\n  getMetamaskConnectedAddress,\n} from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport axios from \"axios\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { updateProfile } from \"../user/user.action\";\nimport ApprovalModal from \"../modals/ApprovalModal\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst { dateRangeInitialSettings } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\n\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n};\n\nconst SellNFT = (props) => {\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [loader, setLoader] = useState(true); // NFT loader\n  const location = useLocation();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [likedNfts, setLikedNfts] = useState();\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const [copies, setCopies] = useState(\"\");\n  const [show, setShow] = useState(false);\n  const [approvalStatus, setApprovalStatus] = useState(\"not-approved\");\n  const [address, setAddress] = useState(\"\");\n  const [copiesError, setCopiesError] = useState(false);\n  let nftId = props.match.params.id;\n\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  useEffect(async () => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n    let connectedAddress = await getMetamaskConnectedAddress();\n    setAddress(connectedAddress);\n  }, []);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getNFT(nftId);\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n  }, []);\n\n  useEffect(() => {\n    if (props.error !== null) {\n      toast.error(props.error.message);\n      setLoader(false);\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n      validateIfLiked(likedNfts, props.nftDetail);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const { nft } = props.nft.nftsData;\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) {\n      data = fixedPriceConfig;\n    } else {\n      data = timedAuctionConfig;\n    }\n\n    const keys = name.split(\".\");\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) {\n      setFixedPriceConfig({ ...data });\n    } else {\n      setTimedAuctionConfig({ ...data });\n    }\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    if (copies > nftDetail.copies) {\n      if (Number(nftDetail.copies) === 1) {\n        toast.info(`Copies should be equal to ${nftDetail.copies}`);\n      } else {\n        toast.info(\n          `Copies should be less than or equal to ${nftDetail.copies}`\n        );\n      }\n      return \"\";\n    }\n    if (await validateNetwork()) {\n      if (!nftDetail.user.isApproved) {\n        setShow(true);\n        return \"\";\n      }\n\n      let price = \"\";\n      let payload = \"\";\n\n      let timedConfig = { ...timedAuctionConfig };\n\n      let fixedConfig = { ...fixedPriceConfig };\n      const { _id, ownerId } = nftDetail;\n\n      let activityPayload = {\n        nftId: _id,\n        ownerId,\n        fromAddress: await getWalletAddress(),\n        activityType: \"List\",\n      };\n\n      if (sellingMethod === 2) {\n        if (Number(timedConfig.startPrice.amount) === 0) {\n          toast.error(\"Price should be greater then 0\");\n          return \"\";\n        }\n        let timedAuctionStartTime = new Date(timedConfig.duration.startDate);\n        let timedAuctionEndTime = new Date(timedConfig.duration.endDate);\n\n        //calculate end time\n        timedAuctionEndTime = timedAuctionEndTime.toString();\n        timedAuctionEndTime =\n          timedAuctionEndTime.slice(0, 15) +\n          \" \" +\n          timedConfig.duration.endTime +\n          \":00\" +\n          timedAuctionEndTime.slice(24);\n        timedConfig.duration.endDate = timedAuctionEndTime;\n\n        //calculate start time\n        timedAuctionStartTime = timedAuctionStartTime.toString();\n        timedAuctionStartTime =\n          timedAuctionStartTime.slice(0, 15) +\n          \" \" +\n          timedConfig.duration.startTime +\n          \":00\" +\n          timedAuctionStartTime.slice(24);\n        timedConfig.duration.startDate = timedAuctionStartTime;\n\n        //Deleting unused data from payload\n        let auctionConfig = timedConfig;\n        delete auctionConfig.duration.startTime;\n        delete auctionConfig.duration.endTime;\n        delete auctionConfig.method;\n        price = Number(auctionConfig.startPrice.amount);\n        auctionConfig.startPrice.amount = Number(\n          auctionConfig.startPrice.amount\n        );\n\n        payload = {\n          _id: location.state._id,\n          sellingMethod,\n          sellingConfig: JSON.stringify(auctionConfig),\n          copiesForAuction: copies,\n        };\n      } else {\n        price = Number(fixedConfig.price.amount);\n        if (price === 0) {\n          toast.error(\"Price should be greater then 0\");\n          return \"\";\n        }\n        payload = {\n          _id: location.state._id,\n          sellingMethod,\n          sellingConfig: JSON.stringify(fixedConfig),\n          copiesForAuction: copies,\n        };\n      }\n\n      setLoader(true);\n\n      var formData = new FormData();\n      for (const key in payload) formData.append(key, payload[key]);\n      if (sellingMethod === 2) {\n        try {\n          let auctionEndDate = timedAuctionConfig.duration.endDate;\n          let auctionStartDate = timedAuctionConfig.duration.startDate;\n\n          const biddingTime = new Date(auctionEndDate).getTime();\n          const startTime = new Date(auctionStartDate).getTime();\n\n          let result = await openNFTForBidding(\n            biddingTime,\n            startTime,\n            location.state.nftToken,\n            copies\n          );\n          if (result) {\n            activityPayload.price = price;\n\n            props.createActivity(activityPayload);\n            props.upsertNFT(\"edit\", formData, \"PUT\");\n          }\n        } catch (err) {\n          setLoader(false);\n          toast.error(err);\n        }\n      } else {\n        try {\n          let result = await putonsale(\n            nftDetail.nftToken,\n            1,\n            fixedConfig.price.amount\n          );\n\n          if (result) {\n            activityPayload.price = price;\n\n            props.createActivity(activityPayload);\n            props.upsertNFT(\"edit\", formData, \"PUT\");\n          }\n        } catch (err) {\n          setLoader(false);\n          toast.error(err);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const handleLikesTogleApi = (nftId, status) => {\n    if (!likeButtonDisable) {\n      setLikeBtnDisable(true);\n      setToggle(!toggle);\n\n      let userId = ENV.getUserKeys(\"_id\")._id;\n\n      let data = {\n        userId,\n        nftId,\n        count: 1,\n      };\n\n      if ((status === \"dislike\") & (nftDetail.likesCount > 0)) {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount - 1;\n\n        setNftDetail(nft);\n        props.toggleLikeDislike(data);\n      } else {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount + 1;\n\n        setNftDetail(nft);\n\n        props.toggleLikeDislike(data);\n      }\n    }\n  };\n\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      setLoader(false);\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      setLoader(false);\n      return setToggle(false);\n    }\n  };\n  const auctionEndTimeConversion = (auctionEndDate) => {\n    var dateString = moment.utc(auctionEndDate).format(\"MMMM D, Y\");\n    var timeString = moment.utc(auctionEndDate).format(\"h:mma\");\n    var totalDateTime = dateString + \" at \" + timeString + \" PKT\";\n    return totalDateTime;\n  };\n  const approveAccount = async () => {\n    setApprovalStatus(\"pending\");\n    var formData = new FormData();\n    formData.append(\"isApproved\", true);\n    formData.append(\"userId\", nftDetail.user._id);\n    try {\n      let accApproved = await setApprovalForAll(setApprovalStatus);\n      if (accApproved) {\n        let updatedNFTDetail = { ...nftDetail };\n        updatedNFTDetail.user.isApproved = true;\n        setNftDetail(updatedNFTDetail);\n        props.updateProfile(formData);\n        setApprovalStatus(\"approved\");\n        toast.success(\"Your Account is Approved!.\");\n        return \"\";\n      }\n    } catch (err) {\n      setApprovalStatus(\"not-approved\");\n      return \"\";\n    }\n  };\n\n  const { image, name, description, remainingCopies, fileType } = nftDetail;\n\n  const bannerData = {\n    subHeading: \"NFT\",\n    heading: \"NFT Details\",\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      {loader && <FullPageLoader />}\n      <section className=\"padding-wrapper sell-nft new-nft-detail\">\n        <div className=\"container\">\n          <div className=\"row g-4 g-xl-5\">\n            <div className=\"col-12\">\n              <div className=\"row g-4\">\n                <div className=\" col-lg-6 col-xl-5\">\n                  {fileType === \"image\" ? (\n                    <div className=\"nft-img-container mx-auto mx-lg-0\">\n                      <img src={image} alt=\"nft-image\" />\n                    </div>\n                  ) : (\n                    <div className=\"card-img-top\">\n                      <div className=\"video-wrapper\">\n                        <video\n                          src={image}\n                          ref={videoElement}\n                          onTimeUpdate={handleOnTimeUpdate}\n                        />\n                        <div className=\"controls\">\n                          <div className=\"actions\">\n                            <button\n                              className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                              onClick={togglePlay}\n                            >\n                              {playerState.isPlaying ? (\n                                <BsFillPauseFill />\n                              ) : (\n                                <BsFillPlayFill />\n                              )}\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  )}\n                </div>\n                <div className=\"col-lg-6 col-xl-7\">\n                  <div className=\"nft-img-detail\">\n                    <h5>NFT Details:</h5>\n                  </div>\n                  <div className=\"nft-img-detail-box\">\n                    <div className=\"nft-detail-rounded-box\">\n                      <p>\n                        {name && name.length > 30\n                          ? name.slice(0, 30) + \"...\"\n                          : name}\n                      </p>\n                    </div>\n                    <div className=\"row g-2 g-sm-4\">\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4\">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Total Copies: <span>{nftDetail?.copies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4 \">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Sold:{\" \"}\n                            <span>{nftDetail?.copies - remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-lg-6 col-xl-4\">\n                        <div className=\"nft-detail-rounded-box mb-0\">\n                          <p>\n                            Remaining: <span>{remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div>\n                    <div className=\"detail-bg-box nft-img-detail\">\n                      <h5>Descriptions:</h5>\n                      <hr />\n                      <p>{description}</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12\">\n              <div className=\"sale-btn-container mt-5\">\n                <button\n                  className={` ${\n                    activeBtn === 0 ? \"sell-btn-active\" : \"sell-btn-not-active\"\n                  }  me-3 `}\n                  onClick={() => {\n                    setActiveBtn(0);\n                    setSellingMethod(1);\n                    setCopies(\"\");\n                    setCopiesError(false);\n                  }}\n                >\n                  Fixed Prize\n                </button>\n                <button\n                  className={` ${\n                    activeBtn === 1 ? \"sell-btn-active\" : \"sell-btn-not-active\"\n                  } `}\n                  onClick={() => {\n                    setActiveBtn(1);\n                    setSellingMethod(2);\n                    setCopies(\"\");\n                    setCopiesError(false);\n                  }}\n                >\n                  Timed Auction\n                </button>\n              </div>\n            </div>\n            {activeBtn === 0 ? (\n              <form onSubmit={submit}>\n                <div className=\"row g-4 g-xl-5\">\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Price:</h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"text\"\n                          name=\"fixedPriceConfig.price.amount\"\n                          placeholder=\"Amount\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          maxLength={\"8\"}\n                          onChange={(e) => {\n                            if (e.target.value == \"00\") {\n                              return \"\";\n                            }\n                            onChange(e);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={fixedPriceConfig.price.amount}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">ETH</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>\n                        No of Copies:*{\" \"}\n                        {copiesError && (\n                          <span className=\"text-danger ms-2 error-msg\">{`This NFT has only ${nftDetail.copies} copies`}</span>\n                        )}\n                      </h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"number\"\n                          name=\"copies\"\n                          placeholder=\"Copies\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          min={\"1\"}\n                          onChange={(e) => {\n                            console.log(e.target.value.includes('.'),\"e.target.value.includes('.')\",+e.target.value==0)\n                            if (+e.target.value > nftDetail.copies) {\n                              setCopiesError(true);\n                              return false;\n                            }\n                            if ((e.target.value==0&&copies==='')||e.target.value.includes('.')) {\n                              return false;\n                            }\n                            setCopiesError(false);\n                            setCopies(e.target.value);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={copies}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">Copies</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Fees:</h5>\n                      <hr />\n                      <div className=\"fee-details d-flex align-items-center justify-content-between\">\n                        <div>\n                          <p>\n                            Service Fees:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                        <div>\n                          <p>\n                            Creator Royalty:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"sell-btn-container d-flex justify-content-center justify-content-lg-start\">\n                    <button\n                      className=\"btn btn-linear-gradient sell-btn-completed\"\n                      type=\"submit\"\n                    >\n                      Complete Listing\n                    </button>\n                  </div>\n                </div>\n              </form>\n            ) : (\n              <form onSubmit={submit}>\n                <div className=\"row g-4 g-xl-5\">\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Price:*</h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"text\"\n                          name=\"timedAuctionConfig.startPrice.amount\"\n                          placeholder=\"Amount\"\n                          maxLength=\"8\"\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          onChange={(e) => {\n                            if (e.target.value === \"00\") {\n                              return false;\n                            } else {\n                              onChange(e);\n                            }\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={timedAuctionConfig.startPrice.amount}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">ETH</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>\n                        No of Copies:*{\" \"}\n                        {copiesError && (\n                          <span className=\"text-danger ms-2 error-msg\">{`This NFT has only ${nftDetail.copies} copies`}</span>\n                        )}\n                      </h5>\n                      <hr />\n                      <div className=\"sell-inp-container d-flex align-items-center\">\n                        <input\n                          type=\"number\"\n                          name=\"copies\"\n                          placeholder=\"Copies\"\n                          maxLength={\"3\"}\n                          style={{\n                            borderRadius: \"4px\",\n                          }}\n                          min={\"1\"}\n                          max={`${nftDetail.copies}`}\n                          onChange={(e) => {\n                            if (+e.target.value > nftDetail.copies) {\n                              setCopiesError(true);\n                              return false;\n                            }\n                            setCopiesError(false);\n\n                            setCopies(e.target.value);\n                          }}\n                          onKeyDown={(e) => decimalNumberValidator(e)}\n                          value={copies}\n                          required\n                          autoComplete=\"off\"\n                        />\n                        <div className=\"inp-tag\">Copies</div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Duration:</h5>\n                      <hr />\n                      <div className=\"sell-date-picker\">\n                        <DateRangePicker\n                          initialSettings={dateRangeInitialSettings}\n                          onApply={handleDateChange}\n                        >\n                          <button\n                            name=\"timedAuctionConfig.duration\"\n                            className=\"calender-btn\"\n                            type=\"button\"\n                          >\n                            {moment(\n                              timedAuctionConfig.duration.startDate\n                            ).format(\"MMMM D, YYYY\")}{\" \"}\n                            -{\" \"}\n                            {moment(timedAuctionConfig.duration.endDate).format(\n                              \"MMMM D, YYYY\"\n                            )}\n                            &nbsp;&nbsp;&nbsp;\n                            <svg\n                              width=\"21\"\n                              height=\"17\"\n                              viewBox=\"0 0 21 17\"\n                              fill=\"none\"\n                              xmlns=\"http://www.w3.org/2000/svg\"\n                            >\n                              <path\n                                d=\"M21 1.54739V16.5821C20.8581 