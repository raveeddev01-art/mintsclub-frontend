                          <option value={1}>\r\n                              Sell to the highest bidder\r\n                            </option>\r\n                            {/* <option value={2}>\r\n                              Sell with the\r\n                              declining price\r\n                            </option> */}\r\n                          </select>\r\n                        </div>\r\n\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text position-relative\">\r\n                            <div className=\"text-white mb-2 absolute-wrapper\">\r\n                              <b>Starting Price</b>\r\n                            </div>\r\n                            <div className=\"text-right mb-2\">\r\n                              <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                            </div>\r\n                            <div className=\"d-flex\">\r\n                              <button type=\"button\" className=\"ethereum-btn\">\r\n                                <svg\r\n                                  viewBox=\"0 0 126.61 126.61\"\r\n                                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                                  fill=\"currentColor\"\r\n                                  height=\"18\"\r\n                                  width=\"18\"\r\n                                >\r\n                                  <g>\r\n                                    <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                    <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                    <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                    <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                    <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                  </g>\r\n                                </svg>\r\n                                <span className=\"ml-2\">{ENV.currency}</span>\r\n                              </button>\r\n                              <input\r\n                                type=\"text\"\r\n                                name=\"timedAuctionConfig.startPrice.amount\"\r\n                                placeholder=\"Amount\"\r\n                                className=\"amount-btn ml-3\"\r\n                                style={{\r\n                                  borderRadius: \"4px\",\r\n                                }}\r\n                                onChange={(e) => onChange(e)}\r\n                                onKeyDown={(e) => decimalNumberValidator(e)}\r\n                                defaultValue={\r\n                                  timedAuctionConfig.startPrice.amount\r\n                                }\r\n                                required\r\n                              />\r\n                              {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                $ 0.00\r\n                              </div> */}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>Duration</b>\r\n                            </div>\r\n                            <div className=\"date-picker\">\r\n                              <DateRangePicker\r\n                                initialSettings={dateRangeInitialSettings}\r\n                                onApply={handleDateChange}\r\n                              >\r\n                                <button\r\n                                  name=\"timedAuctionConfig.duration\"\r\n                                  className=\"calender-btn\"\r\n                                >\r\n                                  <i className=\"fas fa-calendar-week\" />\r\n                                  &nbsp;&nbsp;&nbsp;\r\n                                  {timedAuctionConfig.duration.startDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}{\" \"}\r\n                                  -{\" \"}\r\n                                  {timedAuctionConfig.duration.endDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}\r\n                                </button>\r\n                              </DateRangePicker>\r\n                            </div>\r\n\r\n                            <div className=\"row\">\r\n                              <div className=\"mr-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"timedAuctionConfig.duration.startTime\"\r\n                                  placeholder=\"Start Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    timedAuctionConfig.duration.startTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n\r\n                              <div className=\"ml-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"timedAuctionConfig.duration.endTime\"\r\n                                  placeholder=\"End Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    timedAuctionConfig.duration.endTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        {/* <div className=\"reverse-price d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>\r\n                                Include reserve\r\n                                price\r\n                              </b>\r\n                            </div>\r\n                          </div>\r\n                          <div>\r\n                            <label className=\"switch\">\r\n                              <input\r\n                                type=\"checkbox\"\r\n                                checked={\r\n                                  reservePrice\r\n                                }\r\n                                onChange={() =>\r\n                                  setReservePrice(\r\n                                    !reservePrice\r\n                                  )\r\n                                }\r\n                              />\r\n                              <span className=\"slider round\"></span>\r\n                            </label>\r\n                          </div>\r\n                        </div> */}\r\n                        {reservePrice && (\r\n                          <div className=\"d-flex\">\r\n                            <button type=\"button\" className=\"ethereum-btn\">\r\n                              <svg\r\n                                viewBox=\"0 0 126.61 126.61\"\r\n                                xmlns=\"http://www.w3.org/2000/svg\"\r\n                                fill=\"currentColor\"\r\n                                height=\"18\"\r\n                                width=\"18\"\r\n                              >\r\n                                <g>\r\n                                  <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                  <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                  <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                  <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                  <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                </g>\r\n                              </svg>\r\n                              <span className=\"ml-2\">{ENV.currency}</span>\r\n                            </button>\r\n                            <input\r\n                              type=\"text\"\r\n                              name=\"timedAuctionConfig.reservePrice.amount\"\r\n                              placeholder=\"Amount\"\r\n                              className=\"amount-btn ml-3\"\r\n                              style={{\r\n                                borderRadius: \"4px\",\r\n                              }}\r\n                              onChange={(e) => onChange(e)}\r\n                              onKeyDown={(e) => decimalNumberValidator(e)}\r\n                              defaultValue={\r\n                                timedAuctionConfig.reservePrice.amount\r\n                              }\r\n                              required\r\n                            />\r\n                            {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                              $ 0.00\r\n                            </div> */}\r\n                          </div>\r\n                        )}\r\n                      </Tab.Pane>\r\n                    </Tab.Content>\r\n\r\n                    <div className=\"d-flex justify-content-between my-3 text-white\">\r\n                      <div>\r\n                        <b>Fees</b>\r\n                      </div>\r\n                      <div>\r\n                        <i className=\"fas fa-exclamation-circle\" />\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"d-flex justify-content-between text-white mb-4\">\r\n                      <div>Service Fee</div>\r\n                      <div>{serviceFee}%</div>\r\n                    </div>\r\n                    <div className=\"d-flex justify-content-between text-white mb-4\">\r\n                      <div>Creator Royalty</div>\r\n                      <div>{nft?.royalty || 0}%</div>\r\n                    </div>\r\n\r\n                    <button\r\n                      className=\"complete-listing-btn p-3\"\r\n                      onClick={() => submit()}\r\n                    >\r\n                      Complete Listing\r\n                    </button>\r\n                  </Container>\r\n                </div>\r\n              </Tab.Container>\r\n            </div>\r\n          </div>\r\n          <div className=\"summary-container\">\r\n            {nft && <NFTPreview {...nft} />}\r\n            {/* IMPORTED NFT PREVIEW SO THIS CODE IS NOT NEEDED ANYMORE */}\r\n            {/* <div className=\"d-flex justify-content-center align-items-center\">\r\n              <img src=\"img/auction_1.jpg\" className=\"img-fluid\" style={{ height: \"250px\", width: \"300px\" }} />\r\n            </div>\r\n            <div className=\"pt-3 pb-3\">\r\n              <div className=\"d-flex justify-content-between text-white pb-2\">\r\n                <div>WannaPanda - PnPIbqI9ZF</div>\r\n                <div>Price</div>\r\n              </div>\r\n              <div className=\"d-flex justify-content-between text-white pb-2\">\r\n                <div>1</div>\r\n                <div><i className=\"fab fa-ethereum\" />0</div>\r\n              </div>\r\n            </div> */}\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  nft: state.nft,\r\n  error: state.error,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n  beforeNFT,\r\n  getNFT,\r\n  upsertNFT,\r\n})(Sell);\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/shared/error/error.reducer.js",["1155"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/item-detail/item-detail.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/blog/blog.js",["1156","1157"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/blog\";\r\n\r\nclass Blog extends Component {\r\n    state = {\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data.blogData\r\n                })\r\n              \r\n            })\r\n        .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"blog-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`bd_${idx}`} className=\"col-12 col-md-4 item\">\r\n                                    {/* Single Blog */}\r\n                                    <div className=\"card blog-card\">\r\n                                        {/* Blog Thumb */}\r\n                                        <div className=\"blog-thumb\">\r\n                                            <a href=\"/blog-single\"><img src={item.img} alt=\"\" /></a>\r\n                                        </div>\r\n                                        {/* Blog Content */}\r\n                                        <div className=\"blog-content\">\r\n                                            {/* Meta Info */}\r\n                                            <ul className=\"meta-info d-flex justify-content-between list-unstyled mt-4\">\r\n                                                <li>By <a href=\"#\">{item.author}</a></li>\r\n                                                <li><a href=\"#\">{item.date}</a></li>\r\n                                            </ul>\r\n                                            {/* Blog Title */}\r\n                                            <a href=\"/blog-single\">\r\n                                                <h4>{item.title}</h4>\r\n                                            </a>\r\n                                            <p>{item.content}</p>\r\n                                            {/* Blog Button */}\r\n                                            <a className=\"btn content-btn\" href=\"/blog-single\">{item.btnText}</a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Blog;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/activity/activity.js",["1158"],"import React, { useState, useEffect } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-1/activity\";\r\n\r\nconst Activity = ()  => {\r\n    const [data, setData] = useState({});\r\n    const [tabData_1, setTabData_1] = useState([]);\r\n    const [tabData_2, setTabData_2] = useState([]);\r\n    const [tabData_3, setTabData_3] = useState([]);\r\n    const [filterData, setFilterData] = useState([]);\r\n    \r\n    useEffect(()=>{\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                setData(res.data)\r\n                setTabData_1(res.data.tabData_1)\r\n                setTabData_2(res.data.tabData_2)\r\n                setTabData_3(res.data.tabData_3)\r\n                setFilterData(res.data.filterData)\r\n            })\r\n            \r\n    }, [])\r\n\r\n    return (\r\n        <section className=\"activity-area load-more padding-wrapper\">\r\n            <div className=\"container\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro mb-4\">\r\n                            <div className=\"intro-content\">\r\n                                <span>{data.preHeading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{data.heading}</h3>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    <div className=\"col-12 col-md-6 col-lg-8\">\r\n                        {/* Netstorm Tab */}\r\n                        <ul className=\"netstorm-tab nav nav-tabs\" id=\"nav-tab\">\r\n                            <li>\r\n                                <a className=\"active\" id=\"nav-home-tab\" data-toggle=\"pill\" href=\"#nav-home\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_1}</h5>\r\n                                </a>\r\n                            </li>\r\n                            <li>\r\n                                <a id=\"nav-profile-tab\" data-toggle=\"pill\" href=\"#nav-profile\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_2}</h5>\r\n                                </a>\r\n                            </li>\r\n                            <li>\r\n                                <a id=\"nav-contact-tab\" data-toggle=\"pill\" href=\"#nav-contact\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_3}</h5>\r\n                                </a>\r\n                            </li>\r\n                        </ul>\r\n                        {/* Tab Content */}\r\n                        <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                            <div className=\"tab-pane fade show active\" id=\"nav-home\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_1.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`ato_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                            <div className=\"tab-pane fade\" id=\"nav-profile\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_2.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`att_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                            <div className=\"tab-pane fade\" id=\"nav-contact\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_3.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`atth_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"col-12 col-md-6 col-lg-4\">\r\n                        {/* Activity Content */}\r\n                        <div className=\"activity-content mt-5 mt-lg-0\">\r\n                            {/* Single Widget */}\r\n                            <div className=\"single-widget\">\r\n                                {/* Search Widget */}\r\n                                <div className=\"widget-content search-widget\">\r\n                                    <form action=\"#\">\r\n                                        <input type=\"text\" placeholder=\"Enter your keywords\" />\r\n                                    </form>\r\n                                </div>\r\n                            </div>\r\n                            {/* Single Widget */}\r\n                            <div className=\"single-widget\">\r\n                                {/* Filter Widget */}\r\n                                <div className=\"widget filter-widget\">\r\n                                    <h4 className=\"title\">{data.widgetTitle}</h4>\r\n                                    {/* Filter Widget Content */}\r\n                                    <div className=\"widget-content\">\r\n                                        {/* Tags Widget Items */}\r\n                                        <div className=\"widget-content filter-widget-items mt-3\">\r\n                                            {filterData.map((item, idx) => {\r\n                                                return (\r\n                                                    <a key={`fd_${idx}`} href=\"#\" className=\"badge tag\">{item.title}</a>\r\n                                                );\r\n                                            })}\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\nexport default Activity;\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/help-center/help-center.js",["1159"],"import React, { Component } from 'react';\nimport Help from '../help/help';\nimport Faq from '../faq/faq';\n\nclass HelpCenter extends Component {\n\n    componentDidMount() {\n        window.scroll(0, 0)\n    }\n\n    render() {\n        return (\n            <>\n                {/* <Help /> */}\n                <Faq />\n            </>\n        );\n    }\n}\n\nexport default HelpCenter;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/author/author.js",["1160","1161","1162","1163","1164","1165","1166","1167"],"import React, { useEffect, useState } from \"react\";\r\nimport { useParams } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport AuthorProfile from \"../author-profile/author-profile\";\r\nimport Explore from \"../explore/explore-all\";\r\nimport { getUserById, beforeUser } from \"./../user/user.action\";\r\nimport FilterSearch from \"../filter-search2/filtersearch2\";\r\nimport { ENV } from \"./../../config/config\";\r\n\r\nconst Author = (props) => {\r\n  const params = useParams();\r\n  const [authorProfile, setAuthorProfile] = useState({});\r\n  useEffect(() => {\r\n    props.getUserById(params.authorId);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.user.individualUserAuth) {\r\n      setAuthorProfile(props.user.individualUser);\r\n      props.beforeUser();\r\n    }\r\n  }, [props.user.individualUserAuth]);\r\n  return (\r\n    <section\r\n      className=\"author-area explore-area popular-collections-area\"\r\n      style={{ padding: \"0px\" }}\r\n    >\r\n      <div className=\"\">\r\n        <div className=\"d-flex author-detail-container\">\r\n          <div className=\"author-preview author-card\">\r\n            <div className=\"seller\">\r\n              <div className=\"seller-thumb avatar-lg\">\r\n                <img\r\n                  className=\"rounded-circle\"\r\n                  src={props.profileImage ? props.profileImage : ENV.globalPlaceholderImage}\r\n                  alt=\"User Profile\"\r\n                  style={{ height: \"110px\" }}\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"card-caption p-0 text-center\">\r\n            <div className=\"card-body\">\r\n              <h5 className=\"mb-3\">{authorProfile.username}</h5>\r\n              <p className=\"my-3\">{authorProfile.description}</p>\r\n              <div className=\"input-group\">\r\n                <input type=\"text\" className=\"form-control\" placeholder=\"0x000000000000000000\" readOnly value={authorProfile.address}\r\n                  style={{\r\n                    borderRadius: \"100px\",\r\n                    backgroundColor: \"transparent\",\r\n                    border: \"2px solid\",\r\n                    height: \"40px\",\r\n                    padding: \"1.5rem\",\r\n                    boxShadow: \"none\",\r\n                    outline: \"none\",\r\n\r\n                  }}\r\n                />\r\n                <div className=\"input-group-append\"\r\n                  style={{\r\n                    position: \"absolute\",\r\n                    height: \"100%\",\r\n                    top: \"0\",\r\n                    right: \"0\",\r\n                    borderRadius: \"100px\",\r\n                    overflow: \"hidden\",\r\n                  }}\r\n                >\r\n                  <button style={{\r\n                    marginRight: \"5px\",\r\n                    padding: \"12px 16px\",\r\n                    backgroundColor: \"transparent\",\r\n                    color: \"#fff\",\r\n                    border: \"0\",\r\n                    outline: \"none\",\r\n                  }}><i className=\"icon-docs\" /></button>\r\n                </div>\r\n              </div>\r\n              <div className=\"social-icons d-flex justify-content-center my-3\">\r\n                {\r\n                  authorProfile.facebookLink && <a className=\"facebook\" href={authorProfile.facebookLink} target=\"_blank\">\r\n                    <i className=\"fab fa-facebook-f\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.twitterLink && <a className=\"twitter\" href={authorProfile.twitterLink} target=\"_blank\">\r\n                    <i className=\"fab fa-twitter\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.gPlusLink && <a className=\"google-plus\" href={authorProfile.gPlusLink} target=\"_blank\">\r\n                    <i className=\"fab fa-google-plus-g\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.vineLink && <a className=\"vine\" href={authorProfile.vineLink} target=\"_blank\">\r\n                    <i className=\"fab fa-vine\" />\r\n                  </a>\r\n                }\r\n              </div>\r\n              {\r\n                props.followText &&\r\n                <a className=\"btn btn-bordered-white btn-smaller\" href=\"#\">{props.followText}</a>\r\n              }\r\n            </div>\r\n          </div>\r\n          <div className=\"d-flex collection-wrapper\">\r\n            <FilterSearch />\r\n            <div className=\"nfts-collection-wrapper w-100\">\r\n              <Explore />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  error: state.error,\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { getUserById, beforeUser })(Author);\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/blog-single/blog-single.js",["1168","1169"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\nimport Sidebar from '../sidebar/sidebar';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/blogSingle\";\r\n\r\nclass BlogSingle extends Component {\r\n    state = {\r\n        data: {}\r\n    }\r\n    componentDidMount(){\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data\r\n                })\r\n            \r\n            })\r\n        .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"single featured post-details\">\r\n                <div className=\"container\">\r\n                    <div className=\"row\">\r\n                        {/* Main */}\r\n                        <div className=\"col-12 col-lg-8 p-0\">\r\n                            <div className=\"row\">\r\n                                <div className=\"col-12 align-self-center\">\r\n                                    {/* Image */}\r\n                                    <div className=\"blog-thumb\">\r\n                                        <img className=\"w-100\" src={this.state.data.image} alt=\"\" />\r\n                                    </div>\r\n                                    <h2 className=\"featured ml-0\">{this.state.data.title}</h2>\r\n                                    <p>{this.state.data.content_1}</p>\r\n                                    <p>\r\n                                    </p>\r\n                                    <blockquote>{this.state.data.quote}</blockquote>\r\n                                    <p>{this.state.data.content_2}</p>\r\n                                    <p>{this.state.data.content_3}</p>\r\n                                    {/* Post Holder */}\r\n                                    <ul className=\"mb-5 post-holder\">\r\n                                        <li className=\"post-meta-item\">\r\n                                            <div className=\"date\">\r\n                                                <span className=\"posted-on\">Posted On <a href=\"#\" rel=\"bookmark\"><time className=\"entry-date published updated\" dateTime=\"2018-11-01T06:18:46+00:00\">{this.state.data.date}</time></a></span>\r\n                                            </div>\r\n                                        </li>\r\n                                    </ul>\r\n                                    {/* Comments */}\r\n                                    <h3 className=\"comments-reply-text mb-3\">{this.state.data.commentTitle}</h3>\r\n                                    <p className=\"mt-3\">{this.state.data.commentContent}</p>\r\n                                    <form>\r\n                                        <fieldset>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-12 col-lg-6 input-group p-0 pr-lg-3 mb-3\">\r\n                                                    <input type=\"text\" name=\"name\" data-minlength={3} placeholder=\"Name\" required />\r\n                                                </div>\r\n                                                <div className=\"col-12 col-lg-6 input-group p-0 mb-3\">\r\n                                                    <input type=\"email\" name=\"email\" data-minlength={3} placeholder=\"Email\" required />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-12 input-group p-0 mb-3\">\r\n                                                    <textarea name=\"message\" data-minlength={3} rows={4} placeholder=\"Message\" required defaultValue={\"\"} />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 input-group p-0\">\r\n                                                <a className=\"btn btn-bordered-white text-white\">{this.state.data.commentBtn}<i className=\"icon-login ml-2\" /></a>\r\n                                            </div>\r\n                                        </fieldset>\r\n                                    </form>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        {/* Sidebar */}\r\n                        <Sidebar />\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default BlogSingle;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/create-collection/create-collection.js",["1170","1171"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { getUser } from \"../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport $ from \"jquery\";\nimport { ENV } from \"../../config/config\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { toast } from \"react-toastify\";\nimport \"./create-collection.css\";\nimport { Images } from \"../../assets/assets.js\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nclass CreateCollection extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        description: \"\",\n      },\n      categories: null,\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate() {\n    if (this.props.error) {\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      this.setState({ categories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n    console.log(collection, \"collection input\");\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  render() {\n    const { collection, errors, loader, isSubmitted, categories } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      return (\n        <div>\n          <NavbarMain />\n\n          <section className=\"author-area padding-form-wrapper\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row justify-content-between\">\n                <div className=\"col-12 col-md-12\">\n                  <div className=\"mt-5 mt-lg-0 mb-4 mb-lg-5\">\n                    <div className=\"intro\">\n                      <div className=\"intro-content\">\n                        <span>Get Started</span>\n                        <h3 className=\"mb-0\">Create Collection</h3>\n                      </div>\n                    </div>\n                    {isSubmitted && errors && (\n                      <div className=\"row\">\n                        <div className=\"col-12\">\n                          <span\n                            id=\"create-collection-err\"\n                            className=\"text-danger\"\n                          >\n                            {errors}\n                          </span>\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                  <form\n                    id=\"create-collection\"\n                    className=\"item-form card no-hover\"\n                  >\n                    <div className=\"row\">\n                      <div className=\"col-12\">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"logo\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"logo\"\n                            />\n                            <label\n                              id=\"collection-logo-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"logo\"\n                            >\n                              Choose Logo *\n                            </label>\n                          </div>\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"logo\",\n                              collection.logo,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-3\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border \">\n                          <div className=\"image-over \">\n                            <img\n                              id=\"logo-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.logoUrl\n                                  ? collection.logoUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"featuredImg\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"featuredImg\"\n                            />\n                            <label\n                              id=\"collection-featuredImg-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"featuredImg\"\n                            >\n                              {\" \"}\n                              Choose Featured Image\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-4\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border\">\n                          <div className=\"image-over\">\n                            <img\n                              id=\"featuredImg-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.featuredImgUrl\n                                  ? collection.featuredImgUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 \">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"banner\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"banner\"\n                            />\n                            <label\n                              id=\"collection-banner-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"banner\"\n                            >\n                              Choose Banner\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-8\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border\">\n                          <div className=\"image-over\">\n                            <img\n                              id=\"banner-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.bannerUrl\n                                  ? collection.bannerUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-6\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control\"\n                            name=\"name\"\n                            placeholder=\"Name *\"\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.name}\n                            maxLength=\"55\"\n                            autoComplete=\"off\"\n                          />\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"name\",\n                              collection.name,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-6\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control\"\n                            name=\"url\"\n                            placeholder=\"URL\"\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.url}\n                            maxLength=\"70\"\n                            autoComplete=\"off\"\n                          />\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"url\",\n                              collection.url,\n                              \"url\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group\">\n                          {/* <label\n                            htmlFor=\"category\"\n                            className=\"create-nft-form-title mb-3\"\n                          >\n                            Select Category*\n                          </label> */}\n                          <select\n                            className=\"form-control p-0\"\n                            id=\"category\"\n                            name=\"categoryId\"\n                            onChange={(e) => this.onChange(e)}\n                          >\n                            <option value=\"\">Select Category</option>\n                            {categories &&\n                              categories.map((category, index) => {\n                                return (\n                                  <option key={index} value={category._id}>\n                                    {category.name}\n                                  </option>\n                                );\n                              })}\n                          </select>\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"category\",\n                              collection.categoryId,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group\">\n                          <textarea\n                            className=\"form-control\"\n                            name=\"description\"\n                            placeholder=\"Description\"\n                            cols={30}\n                            rows={3}\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.description}\n                            maxLength=\"230\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"text-center\">\n                          <button\n                            disabled={loader}\n                            className=\"create-collection-btn mx-auto mt-3 mt-sm-4\"\n                            type=\"button\"\n                            onClick={(e) => this.submit(e)}\n                          >\n                            Create Collection\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </form>\n                </div>\n              </div>\n            </div>\n          </section>\n          <Footer />\n        </div>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollection);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/profile/profile.js",["1172","1173","1174","1175","1176"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport AuthorProfile from \"../author-profile/author-profile\";\nimport { SET_INDIVIDUAL_USER } from \"../../redux/types\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { signRequest } from \"./../../utils/web3\";\nimport { ENV } from \"./../../config/config\";\nimport { toast } from \"react-toastify\";\nimport { useHistory } from \"react-router-dom\";\n\n\nconst Profile = (props) => {\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [facebookLink, setFbLink] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [gPlusLink, setgPlusLink] = useState(\"\");\n  const [vineLink, setVineLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n    props.setIndividualUserData(user);\n    setConnectedAddress(user.address ? user.address : \"\");\n    setAddress(user.address ? user.address : \"\");\n    setEmail(user.email ? user.email : \"\");\n    setUserId(user._id ? user._id : \"\");\n    setDescription(user.description ? user.description : \"\");\n    setFbLink(user.facebookLink ? user.facebookLink : \"\");\n    setgPlusLink(user.gPlusLink ? user.gPlusLink : \"\");\n    setTwitterLink(user.twitterLink ? user.twitterLink : \"\");\n    setVineLink(user.vineLink ? user.vineLink : \"\");\n    setUsername(user.username ? user.username : \"\");\n    setImageUrl(user.profileImage ? user.profileImage : \"\");\n  }, []);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      props.beforeUser();\n      setLoader(false);\n    }\n  }, [props.user.userAuth]);\n\n  useEffect(() => {\n    if (props.error) {\n      setErrors(props.error.message);\n      goToTop();\n    }\n  }, [props.error]);\n\n  const goToTop = () => {\n    $(\"html, body\").animate(\n      {\n        scrollTop: 0,\n      },\n      600\n    );\n  };\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setImageUrl(fileURL);\n      setImage(file);\n    }\n  };\n\n  const onBannerChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setBannerUrl(fileURL);\n      setBannerImage(file);\n    }\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    setErrors(\"\");\n    setIsSubmitted(true);\n    let isFormValid = validator.allValid() ? true : false;\n    if (isFormValid) {\n      try {\n        let signature = await signRequest();\n        setLoader(true);\n        var formData = new FormData();\n        formData.append(\"profileImage\", image);\n        formData.append(\"bannerImage\", banner);\n        formData.append(\"description\", description);\n        formData.append(\"facebookLink\", facebookLink);\n        formData.append(\"twitterLink\", twitterLink);\n        formData.append(\"gPlusLink\", gPlusLink);\n        formData.append(\"vineLink\", vineLink);\n        formData.append(\"username\", username);\n        formData.append(\"signature\", signature);\n        props.updateProfile(formData);\n      } catch (e) {}\n    } else {\n      validator.showMessages();\n      setErrors(\"Please fill all required fields in valid format.\");\n      goToTop();\n    }\n  };\n  if (!ENV.getUserKeys(\"_id\")._id) {\n    toast.error(\"Please login to view profile\");\n    history.push(\"/\");\n    return \" \";\n  } else {\n    return (\n      <section className=\"author-area\">\n        <div className=\"container\">\n          <div className=\"row justify-content-between\">\n            <div className=\"col-12 col-md-4\">\n              <AuthorProfile\n                profileImage={imageUrl}\n                username={username}\n                description={description}\n                address={connectedAddress}\n                facebookLink={facebookLink}\n                twitterLink={twitterLink}\n                gPlusLink={gPlusLink}\n                vineLink={vineLink}\n              />\n            </div>\n            <div className=\"col-12 col-md-7\">\n              <div className=\"mt-5 mt-lg-0 mb-4 mb-lg-5\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Your Profile</span>\n                    <h3 className=\"mt-3 mb-0\">Update your profile</h3>\n                  </div>\n                </div>\n              </div>\n              <form id=\"create-nft\" className=\"item-form card no-hover\">\n                {isSubmitted && errors && (\n                  <div className=\"row pb-2\">\n                    <div className=\"col-12\">\n                      <span id=\"create-nft-err\" className=\"text-danger\">\n                        {errors}\n                      </span>\n                    </div>\n                  </div>\n                )}\n                <div className=\"row\">\n                  <div className=\"col-12\">\n                    <div className=\"input-group form-group\">\n                      <div className=\"custom-file\">\n                        <input\n                          type=\"file\"\n                          className=\"custom-file-input\"\n                          id=\"banner\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onBannerChange(e)}\n                          name=\"banner\"\n                        />\n                        <label\n                          id=\"nft-imasge-label\"\n                          className=\"custom-file-label\"\n                          htmlFor=\"banner\"\n                        >\n                          {banner && banner.name\n                            ? banner.name\n                            : \"Choose Banner Image\"}\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"input-group form-group\">\n                      <div className=\"custom-file\">\n                        <input\n                          type=\"file\"\n                          className=\"custom-file-input\"\n                          id=\"image\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onFileChange(e)}\n                          name=\"image\"\n                        />\n                        <label\n                          id=\"nft-imasge-label\"\n                          className=\"custom-file-label\"\n                          htmlFor=\"image\"\n                        >\n                          {image && image.name\n                            ? image.name\n                            : \"Choose Profile Picture\"}\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"address\"\n                        placeholder=\"Wallet Address *\"\n                        required=\"required\"\n                        value={address}\n                        readOnly\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"address\", address, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"email\"\n                        placeholder=\"Email *\"\n                        required=\"required\"\n                        value={email}\n                        readOnly\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"email\", email, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"username\"\n                        placeholder=\"Username *\"\n                        required=\"required\"\n                        onChange={(e) => setUsername(e.target.value)}\n                        defaultValue={username}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"username\", username, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <textarea\n                        className=\"form-control\"\n                        name=\"description\"\n                        placeholder=\"About\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setDescription(e.target.value)}\n                        defaultValue={description}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"facebookLink\"\n                        placeholder=\"Facebook Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setFbLink(e.target.value)}\n                        defaultValue={facebookLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"twitterLink\"\n                        placeholder=\"Twitter Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setTwitterLink(e.target.value)}\n                        defaultValue={twitterLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"gPlusLink\"\n                        placeholder=\"Google Plus Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setgPlusLink(e.target.value)}\n                        defaultValue={gPlusLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"vineLink\"\n                        placeholder=\"Vine Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setVineLink(e.target.value)}\n                        defaultValue={vineLink}\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"col-12\">\n                    <button\n                      disabled={loader}\n                      className=\"btn w-100 mt-3 mt-sm-4\"\n                      type=\"button\"\n                      onClick={(e) => submit(e)}\n                    >\n                      Update Profile\n                    </button>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        </div>\n      </section>\n    );\n  }\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n})(Profile);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/signup/signup.js",["1177","1178"],"import React, { Component } from \"react\";\r\n\r\nconst initData = {\r\n  pre_heading: \"Signup\",\r\n  heading: \"Create an Account\",\r\n  content: \"\",\r\n};\r\n\r\nconst socialData = [\r\n  {\r\n    id: \"1\",\r\n    link: \"facebook\",\r\n    icon: \"fab fa-facebook-f\",\r\n  },\r\n  {\r\n    id: \"2\",\r\n    link: \"twitter\",\r\n    icon: \"fab fa-twitter\",\r\n  },\r\n  {\r\n    id: \"3\",\r\n    link: \"google-plus\",\r\n    icon: \"fab fa-google-plus-g\",\r\n  },\r\n];\r\n\r\nclass Signup extends Component {\r\n  state = {\r\n    initData: {},\r\n    data: [],\r\n  };\r\n  componentDidMount() {\r\n    this.setState({\r\n      initData: initData,\r\n      data: socialData,\r\n    });\r\n  }\r\n  render() {\r\n    return (\r\n      <section className=\"author-area\">\r\n        <div className=\"container\">\r\n          <div className=\"row justify-content-center\">\r\n            <div className=\"col-12 col-md-8 col-lg-7\">\r\n              {/* Intro */}\r\n              <div className=\"intro text-center\">\r\n                <span>{this.state.initData.pre_heading}</span>\r\n                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                <p>{this.state.initData.content}</p>\r\n              </div>\r\n              {/* Item Form */}\r\n              <form className=\"item-form card no-hover\">\r\n                <div className=\"row\">\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <input\r\n                        type=\"text\"\r\n                        className=\"form-control\"\r\n                        name=\"name\"\r\n                        placeholder=\"Enter your Name\"\r\n                        required=\"required\"\r\n                      />\r\n                    </div>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <input\r\n                        type=\"email\"\r\n                        className=\"form-control\"\r\n                        name=\"email\"\r\n                        placeholder=\"Enter your Email\"\r\n                        required=\"required\"\r\n                      />\r\n                    </div>\r\n                  </div>\r\n                  {/* <div className=\"col-12\">\r\n                                        <div className=\"form-group mt-3\">\r\n                                            <input type=\"password\" className=\"form-control\" name=\"password\" placeholder=\"Enter your Password\" required=\"required\" />\r\n                                        </div>\r\n                                    </div> */}\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <div className=\"form-check form-check-inline\">\r\n                        <input\r\n                          className=\"form-check-input\"\r\n                          type=\"radio\"\r\n                          name=\"inlineRadioOptions\"\r\n                          id=\"inlineRadio1\"\r\n                          defaultValue=\"option1\"\r\n                        />\r\n                        <label\r\n                          className=\"form-check-label\"\r\n                          htmlFor=\"inlineRadio1\"\r\n                        >\r\n                          I agree to <a href=\"#\">Privacy Policy</a>\r\n                        </label>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <button className=\"btn w-100 mt-3 mt-sm-4\" type=\"submit\">\r\n                      Sign Up\r\n                    </button>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <span className=\"d-block text-center mt-4\">\r\n                      Already have an account? <a href=\"/login\">Login</a>\r\n                    </span>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <hr />\r\n                    <div className=\"other-option\">\r\n                      <span className=\"d-block text-center mb-4\">Or</span>\r\n                      {/* Social Icons */}\r\n                      <div className=\"social-icons d-flex justify-content-center\">\r\n                        {this.state.data.map((item, idx) => {\r\n                          return (\r\n                            <a\r\n                              key={`lsd_${idx}`}\r\n                              className={item.link}\r\n                              href=\"#\"\r\n                            >\r\n                              <i className={item.icon} />\r\n                              <i className={item.icon} />\r\n                            </a>\r\n                          );\r\n                        })}\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n}\r\n\r\nexport default Signup;\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/not-found/not-found.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/how-it-works/how-it-works.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/privacy-&-terms/privacy-&-terms.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/explore-collections.js",["1179","1180","1181","1182","1183"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/user-profile/UserProfile.js",["1184","1185","1186","1187","1188","1189","1190","1191","1192","1193","1194","1195","1196","1197","1198","1199","1200","1201","1202","1203","1204","1205","1206","1207","1208","1209","1210","1211","1212","1213","1214","1215","1216"],"import React, { useState,useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport \"./UserProfile.css\";\nimport { ENV } from \"../../config/config\";\nimport Avatar from \"../../assets/images/detail-avatar.png\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { ListingImg } from \"../../assets/assets\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\nimport { getProfileNfts, beforeNFT, getMyLikedNfts } from \"../nfts/nfts.action\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport {getUserById,beforeUser} from '../user/user.action';\n\n\nconst UserProfile = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [nftsCopy, setNFTsCopy] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [user,setUser]=useState('')\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n  });\n  const [menuFilter, setMenuFilter] = useState(\"\");\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const priceoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  useEffect(() => {\n    let qs = { ownerId: ENV.getUserKeys(\"_id\")._id };\n    console.log(qs, \"qs for user profile\");\n    qs = ENV.objectToQueryString(qs);\n    props.getProfileNfts(qs);\n    let likedNftsQs = { userId: ENV.getUserKeys(\"_id\")._id };\n    likedNftsQs = ENV.objectToQueryString(likedNftsQs);\n    props.getMyLikedNfts(likedNftsQs);\n    props.getUserById(ENV.getUserKeys(\"_id\")._id)\n  }, []);\n\n  useEffect(() => {\n    if (props.profileNFTsStatus) {\n      if (!menuFilter) {\n        const Nfts = props.profileNFTs.nfts.filter(\n          (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n        );\n        setNFTs(Nfts);\n        setNFTsCopy(props.profileNFTs.nfts);\n        setLoader(false);\n        setFilterationLoader(false);\n      } else {\n        setNFTsCopy(props.profileNFTs.nfts);\n        handleNftFilter(menuFilter);\n        setLoader(false);\n        setFilterationLoader(false);\n      }\n    }\n  }, [props.profileNFTsStatus]);\n\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(()=>{\n    const {individualUserAuth,individualUser}=props;\n    if(individualUserAuth){\n      setUser(individualUser)\n    }\n  },[props.individualUserAuth])\n\n  const ChangeTooltip = () =>\n    setTimeout(() => {\n      setAddressCopied(false);\n    }, 1000);\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      newest,\n      highToLow,\n    } = filter;\n\n    // if (!collectionIdFilter) collectionIdFilter = collectionId;\n    // if (!gtePriceFilter) gtePriceFilter = gtePrice;\n    // if (!ltePriceFilter) ltePriceFilter = ltePrice;\n    // if (!categoryIdFilter) categoryIdFilter = categoryId;\n    // if (!oldestFilter) oldestFilter = oldest;\n    // if (!lowToHighFilter) lowToHighFilter = lowToHigh;\n    // if (!highToLowFilter) highToLowFilter = highToLow;\n    // if (!newestFilter) newestFilter = newest;\n\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    nftQS.ownerId = ENV.getUserKeys(\"_id\")._id;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"qs indknf\");\n    props.getProfileNfts(qs);\n  };\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n    console.log(value, \"value\");\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      page,\n      limit,\n      id,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n  const handleLikesTogleApi = (nftId, status) => {\n   \n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n    // setNFTs(nfts);\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  const handleNftFilter = (id) => {\n    if (id === \"Collected\") {\n      const Nfts = nftsCopy.filter(\n        (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else if (id === \"Created\") {\n      const Nfts = nftsCopy.filter(\n        (item) =>\n          item.ownerId === ENV.getUserKeys(\"_id\")._id &&\n          item.creatorId === ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else {\n      handleFavFilter();\n    }\n  };\n\n  const handleFavFilter = () => {\n    let favNfts = [];\n    nftsCopy.map((item) => {\n      let foundNft = likedNfts.find((liked) => liked.nftId === item._id);\n      if (foundNft) {\n        favNfts.push(item);\n      }\n    });\n\n    setNFTs(favNfts);\n  };\n\n  const accountAddress = \"0xe0106f010067b130e4c96f119c214c30c94cead1\";\n  const menuData = [\"Collected\", \"Created\", \"Favourited\"];\n  console.log(user,\"user\")\n\n  return (\n    <>\n      <NavbarMain />\n      <div className=\"collection-detail-hero\">\n        <img src={BannerImg} alt=\"BannerImg\" />\n      </div>\n      <div className=\"collection-detail-content\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12\">\n              <div className=\"collection-owner-avatar text-center\">\n                <img src={Avatar} alt=\"owner-avatar\" />\n              </div>\n              <div className=\"collection-owner-detail text-center mt-3\">\n                {\n                  user &&\n                <div className=\"collection-owner-name\">\n                  <h3>{user.username?user.username:'unnamed'}</h3>\n                </div>\n                }\n                <div\n                  className=\"user-address mt-4 d-flex align-items-center \"\n                  onClick={() => {\n                    navigator.clipboard.writeText(accountAddress);\n                    setAddressCopied(true);\n                    ChangeTooltip();\n                  }}\n                >\n                  <i className=\"fab fa-ethereum\"></i>\n                  <span>{isAddressCopied ? \"Copied\" : \"Copy\"}</span>\n                  {\n                 user &&\n                  <p className=\"acc-adress\">\n                    {user.address.slice(0, 10) +\n                      \"...\" +\n                      user.address.slice(-10)}\n                  </p>\n                  }\n                </div>\n                <p>\n                  Joined <span>February 2022</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div className=\"collections-listing padding-wrapper\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12\">\n                <div className=\"explore-collection-section\">\n                  <div className=\"explore-collection-nav\">\n                    <div className=\"d-flex justify-content-center justify-content-md-end align-items-center\">\n                      {menuData.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleNftFilter(item);\n                              setMenuFilter(item);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img src={SearchIcon} alt=\"search-icon\" className=\"ms-3\" />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {priceoptions &&\n                      priceoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Chains={filterData.chains}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                <div className=\"row g-3\">\n                  {filterationLoader ? (\n                    <div className=\"text-center\">\n                      <div\n                        class=\"spinner-border text-secondary text-white \"\n                        role=\"status\"\n                      >\n                        <span class=\"sr-only\">Loading...</span>\n                      </div>\n                    </div>\n                  ) : nfts && nfts.length > 0 ? (\n                    nfts.map((listing) => {\n                      return (\n                        <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                          <ListingCards\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            // userProfile\n                          />\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-white text-center mt-5\">No NFTs Found</p>\n                  )}\n                </div>\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      props.profileNFTs.pagination > nfts.length &&\n                      nfts.length > 10 && (\n                        <button\n                          className=\"btn btn-linear-gradient px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state,\"state in userProfile\"),\n  {\n  profileNFTs: state.nft.profileNFTs,\n  profileNFTsStatus: state.nft.profileNFTsStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  individualUser:state.user.individualUser,\n  individualUserAuth:state.user.individualUserAuth,\n});\n\nexport default connect(mapStateToProps, {\n  getProfileNfts,\n  beforeNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  getUserById,\n  beforeUser\n})(UserProfile);\n\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/explore/all-nft/allnft.js",["1217","1218","1219","1220","1221","1222","1223","1224","1225","1226","1227","1228","1229","1230","1231","1232","1233","1234","1235","1236","1237","1238","1239","1240","1241","1242","1243","1244","1245","1246","1247","1248"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collection-details/collectiondetails.js",["1249","1250","1251","1252","1253","1254","1255","1256","1257","1258","1259","1260","1261","1262","1263","1264","1265","1266","1267"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./collectiondetails.css\";\nimport Avatar from \"../../assets/images/detail-avatar.png\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { ListingImg } from \"../../assets/assets\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\n\nconst CollectionDetailsPage = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n  });\n  const location = useLocation();\n\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    chains: {\n      label: \"Chains\",\n      option: [\"Ethereum\"],\n    },\n  };\n\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNfts(props.nfts);\n      props.beforeNFT();\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 40,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    setFilterationLoader(true);\n\n    const nftQS = { page, limit };\n\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      newest,\n      highToLow,\n    } = filter;\n\n    // if (!collectionIdFilter) collectionIdFilter = collectionId;\n    // if (!gtePriceFilter) gtePriceFilter = gtePrice;\n    // if (!ltePriceFilter) ltePriceFilter = ltePrice;\n    // if (!categoryIdFilter) categoryIdFilter = categoryId;\n    // if (!oldestFilter) oldestFilter = oldest;\n    // if (!lowToHighFilter) lowToHighFilter = lowToHigh;\n    // if (!highToLowFilter) highToLowFilter = highToLow;\n    // if (!newestFilter) newestFilter = newest;\n\n    nftQS.collectionId = location.state._id;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getNFTs(qs);\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n  ///////////Likes\n  const handleLikesTogleApi = (nftId, status) => {\n    // const {\n    //   collectionId,\n    //   gtePrice,\n    //   ltePrice,\n    //   categoryId,\n    //   oldest,\n    //   lowToHigh,\n    //   highToLow,\n    //   newest,\n    //   page,\n    //   limit,\n    // } = filter;\n    // getNFTs(\n    //   page,\n    //   limit,\n    //   false,\n    //   minValue,\n    //   maxValue,\n    //   categoryId,\n    //   oldest,\n    //   lowToHigh,\n    //   highToLow,\n    //   newest\n    // );\n    // let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    // qs = ENV.objectToQueryString(qs);\n    // props.getMyLikedNfts(qs);\n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n    // setNFTs(nfts);\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const { name, banner, logo, description } = location.state;\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <div className=\"collection-detail-hero w-100\">\n            <img className=\"w-100\" src={banner} alt=\"BannerImg\" />\n          </div>\n          <div className=\"collection-detail-content\">\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"collection-owner-avatar\">\n                    <img src={banner} alt=\"owner-avatar\" />\n                  </div>\n                  <div className=\"d-md-flex align-items-center justify-content-between mt-5\">\n                    <div className=\"collection-owner-detail\">\n                      <div className=\"collection-owner-name d-flex align-items-center\">\n                        <h3>{name}</h3>\n                        <img src={TickIcon} alt=\"tick-icon\" className=\"ms-2\" />\n                      </div>\n                      <p>\n                        Created by <span>brendannorth</span>\n                      </p>\n                    </div>\n                    <div className=\" d-block d-md-none\">\n                      <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                        <p>{description}</p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-btns mt-3 mt-md-0 ms-auto\">\n                      <button className=\"me-1 me-sm-2 me-lg-3\">\n                        <img src={FlagIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button className=\"me-1 me-sm-1 me-lg-3\">\n                        <img src={ShareIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button>+ Add to wishlist</button>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-sm-7 col-md-6 col-lg-5 d-none d-md-block\">\n                  <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                    <p>{description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 col-lg-7 mt-3 mt-sm-5\">\n                  <div className=\"d-flex align-items-center justify-content-center justify-content-lg-end\">\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>items</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Owner</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Prize floor</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Volume trade</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"collections-listing padding-wrapper\">\n                <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <img\n                        src={SearchIcon}\n                        alt=\"search-icon\"\n                        className=\"ms-3\"\n                      />\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        placeholder=\"Search\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Item:</p>\n                      </div>\n\n                      <select name=\"collection-select\">\n                        {itemoptions &&\n                          itemoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Sort:</p>\n                      </div>\n\n                      <select\n                        name=\"collection-select\"\n                        onChange={handleSortOptions}\n                      >\n                        {sortoptions &&\n                          sortoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 d-sm-none\">\n                    <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                      <button\n                        className={`${\n                          activeFilter\n                            ? \"filter-btn-active\"\n                            : \"filter-btn-inactive\"\n                        } ps-2`}\n                        onClick={() => setActiveFilter(!activeFilter)}\n                      >\n                        Filters\n                      </button>\n                    </div>\n                    <div\n                      className={`${\n                        activeFilter ? \"d-block\" : \"d-none\"\n                      } sm-filter-options`}\n                    >\n                      <div className=\"col-10 mx-auto mt-2\">\n                        <FilterComponent\n                          Status={filterData.status}\n                          Chains={filterData.chains}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row mt-5\">\n                <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                  <FilterComponent\n                    Status={filterData.status}\n                    Chains={filterData.chains}\n                    onChangeMinPrice={onChangeMinPrice}\n                    onChangeMaxPrice={onChangeMaxPrice}\n                    minValue={minValue}\n                    maxValue={maxValue}\n                    applyMinMaxFilter={applyMinMaxFilter}\n                  />\n                </div>\n                <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                  <div className=\"row g-3\">\n                    {filterationLoader ? (\n                      <div className=\"text-center\">\n                        <div\n                          class=\"spinner-border text-secondary text-white \"\n                          role=\"status\"\n                        >\n                          <span class=\"sr-only\">Loading...</span>\n                        </div>\n                      </div>\n                    ) : nfts && nfts.length > 0 ? (\n                      nfts.map((listing) => {\n                        return (\n                          <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                            <ListingCards\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                            />\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-white mt-5 text-center no-nfts-title\">\n                        No NFT's Found\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftAll.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n})(CollectionDetailsPage);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/nft-detail/nftdetail.js",["1268","1269","1270","1271","1272","1273","1274","1275","1276","1277","1278","1279"],"import React, { useEffect, useState } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./nftdetail.css\";\nimport PriceHistoy from \"../../assets/images/pricehistoryicon.svg\";\nimport OfferIcon from \"../../assets/images/offer-icon.svg\";\nimport ListingIcon from \"../../assets/images/listing-icon.svg\";\nimport ActivityIcon from \"../../assets/images/activity.svg\";\nimport MoreCollectionIcon from \"../../assets/images/morecollectionicon.svg\";\nimport { ListingImg } from \"../../assets/assets\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport DescriptionIcon from \"../../assets/images/detail-description-icon.svg\";\nimport { getNFT, getNFTsByCollection } from \"../nfts/nfts.action.js\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader.js\";\nimport { connect } from \"react-redux\";\nimport { Modal } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport moment from \"moment\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport axios from \"axios\";\n\nconst NFTDetail = (props) => {\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const history = useHistory();\n  let nftId = props.match.params.id;\n  const initData = {\n    itemImg: \"/img/auction_2.jpg\",\n    date: \"2022-03-30\",\n    price_2: \"$500.89\",\n    bidBtn: \"Place a Bid\",\n    offerBtn: \"Buy Now\",\n    sellBtn: \"Sell\",\n  };\n  const { currencies } = ENV;\n  const expiryOptions = [\n    { label: \"5 Days\", value: moment().add(5, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"7 Days\", value: moment().add(7, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"A Month\", value: moment().add(1, \"months\").format(\"DD/MM/YYYY\") },\n    { label: \"Custom Date\", value: -1 },\n  ];\n\n  const config1 = {\n    price: {\n      currency: ENV.currency,\n      amount: \"\",\n    },\n    expiry: {\n      date: expiryOptions[0].value,\n      time: moment(new Date()).format(\"HH:mm\"),\n      type: 1, // 1 for time & 2 for datetime-local\n      datetime: \"\", // for payload\n    },\n  };\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [nftsList, setNftList] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [nftConfig, setNftConfig] = useState(config1);\n  const validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n\n  const propertiesData = [\n    {\n      id: 1,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 2,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 3,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 4,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 5,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 6,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 7,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 8,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n  ];\n  useEffect(() => {\n    props.getNFT(nftId);\n  }, []);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n\n      props.getNFTsByCollection(props.nftDetail.collectionId);\n    }\n  }, [props.nftsAuth]);\n\n  useEffect(() => {\n    if (props.nftsByCollectionStatus) {\n      let moreCollection = [];\n      if (props.nftsByCollection && props.nftsByCollection?.length) {\n        moreCollection = props.nftsByCollection.filter(\n          (item) => item._id !== nftDetail._id\n        );\n      }\n      setNftList(moreCollection);\n    }\n  }, [props.nftsByCollectionStatus]);\n\n  const handleRouting = () => {\n    if (ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId) {\n      history.push({\n        pathname: `/sell-item/${nftDetail._id}`,\n        state: nftDetail,\n      });\n    }\n  };\n\n  console.log(ENV.getUserKeys(\"_id\")._id, \"user id\");\n  console.log(nftDetail, \"nftDetail\");\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        console.log(res, \"exchangeapires\");\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <section className=\"padding-wrapper nft-detail\">\n            <div className=\"container\">\n              <div className=\"row g-3\">\n                <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n                  <div className=\"row\">\n                    <div className=\"col-12 order-2 order-md-1\">\n                      <div className=\"nftDetail-accordion\">\n                        <div\n                          className=\"accordion accordion-flush