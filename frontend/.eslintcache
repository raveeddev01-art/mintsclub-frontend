then((res)=>{\n           \n//         // console.log(res,\"res of accept bid result===>\")\n//         // toast.success(\"Bid accepted successfully\")\n//         acceptBit(tokenId,body)\n    \n// })\n// .catch((err)=>{\n//    console.log(err,\"err in catch block error===>\")\n// })\n//     }\n// export const signTransaction=async ()=>{\n\n//     const web3 = new Web3(Web3.givenProvider);\n//     // const nonce = await web3.eth.getTransactionCount(\"myAddress\", 'latest');\n//     const rawTransaction = {\n//         \"from\": \"Keystore account id\",\n//         \"to\": \"Account you want to transfer to\",\n//         \"value\": 100,\n//         \"gas\": 0.21000,\n    \n//       };\n\n//       const signedTx = await web3.eth.accounts.signTransaction(rawTransaction, \"PRIVATE_KEY\");\n\n//       web3.eth.sendSignedTransaction(signedTx.rawTransaction, function(error, hash) {\n//         if (!error) {\n//         //   console.log(\"🎉 The hash of your transaction is: \", hash, \"\\n Check Alchemy's Mempool to view the status of your transaction!\");\n//         } else {\n//         //   console.log(\"❗Something went wrong while submitting your transaction:\", error)\n//         }\n//        });\n   \n// }\n","/Users/zain/Documents/projects/ariswap/frontend/src/components/filter-search2/filtersearch2.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/author-profile/author-profile.js",["619","620","621","622","623"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/nft-preview/nft-preview.js",["624"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/collections/components/NftCard/NftCard.js",["625","626"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/footer/footer.js",["627","628","629","630","631","632","633"],"import { useEffect, useState } from 'react';\nimport { Link } from 'react-router-dom';\nimport logo from '../../assets/images/logo.png'\nimport { connect } from 'react-redux'\nimport { getFooter } from './footer.action'\nimport {ENV} from './../../config/config';\n\nconst Footer = (props) => {\n\n    const [data, setData] = useState({\n        facebook: '',\n        twitter: '',\n        instagram: '',\n        youtube: '',\n        vine: '',\n        desc: ''\n    })\n\n    useEffect(() => {\n        props.getFooter()\n    }, [])\n\n    useEffect(() => {\n        if (props.settings.settingsAuth) {\n            setData(props.settings.settings)\n        }\n    }, [props.settings.settingsAuth])\n\n    return (\n        <footer className=\"footer-area\">\n            {/* Footer Top */}\n            <div className=\"footer-top\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Logo */}\n                                <Link className=\"navbar-brand\" to=\"/\">\n                                    <img src={logo} alt=\"\" />\n                                </Link>\n                                <p>{data.desc}</p>\n                                {/* Social Icons */}\n                                <div className=\"social-icons d-flex\">\n                                    {\n                                        data.facebook ?\n                                            <a href={data.facebook} target=\"_blank\">\n                                                <i className={\"fab fa-facebook-f\"} />\n                                                <i className={\"fab fa-facebook-f\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.twitter ?\n                                            <a href={data.twitter} target=\"_blank\">\n                                                <i className={\"fab fa-twitter\"} />\n                                                <i className={\"fab fa-twitter\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.instagram ?\n                                            <a href={data.instagram} target=\"_blank\">\n                                                <i className={\"fab fa-instagram\"} />\n                                                <i className={\"fab fa-instagram\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.youtube ?\n                                            <a href={data.youtube} target=\"_blank\">\n                                                <i className={\"fab fa-youtube\"} />\n                                                <i className={\"fab fa-youtube\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.vine ?\n                                            <a href={data.vine} target=\"_blank\">\n                                                <i className={\"fab fa-vine\"} />\n                                                <i className={\"fab fa-vine\"} />\n                                            </a> : ''\n                                    }\n\n\n\n\n\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Useful Links\"}</h4>\n                                <ul>\n                                    <li><Link to=\"/explore-all\">All NFTs</Link></li>\n                                    <li><Link to=\"/how-it-works\">How It Works</Link></li>\n                                    <li><Link to=\"/create\">Create</Link></li>\n                                    <li><Link to=\"/privacy-and-terms\">Privacy & Terms</Link></li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Community\"}</h4>\n                                <ul>\n                                    <li><Link to=\"/help-center\">Help Center</Link></li>\n                                    <li><Link to=\"/contact\">Contact</Link></li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Subscribe Us\"}</h4>\n                                {/* Subscribe Form */}\n                                <div className=\"subscribe-form d-flex align-items-center\">\n                                    <input type=\"email\" className=\"form-control\" placeholder=\"info@yourmail.com\" />\n                                    <button type=\"submit\" className=\"btn\"><i className=\"icon-paper-plane\" /></button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            {/* Footer Bottom */}\n            <div className=\"footer-bottom\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12\">\n                            {/* Copyright Area */}\n                            <div className=\"copyright-area d-flex flex-wrap justify-content-center justify-content-sm-between text-center py-4\">\n                                {/* Copyright Left */}\n                                <div className=\"copyright-left\">©2021 {ENV.appName}, All Rights Reserved.</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    );\n}\n\nconst mapStateToProps = state => ({\n    error: state.error,\n    settings: state.settings\n});\n\n\nexport default connect(mapStateToProps, { getFooter })(Footer);","/Users/zain/Documents/projects/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/contact/contact.action.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/collections/collections.actions.js",["634"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_COLLECTION, SET_AUTH_STATE, GET_COLLECTION, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\n\nexport const beforeCollection = () => {\n    return {\n        type: BEFORE_COLLECTION\n    }\n}\n\nexport const getCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}collection/get/${collectionId}`;\n \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getCollections = (qs = null) => dispatch => {\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        // console.log(error,\"all collections error\");\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const upsertCollection = (apiURL, body, method = 'POST') => dispatch => {\n\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n   \n    // const url = `http://localhost:5000/v1/front/${apiURL}`;\n\n\n    fetch(url, {\n        method,\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: UPSERT_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}collection/delete/${collectionId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const setAuthState = () => (dispatch) => {\n    dispatch({\n        type: SET_AUTH_STATE,\n    })\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/header/header.js",["635","636","637","638","639","640","641"],"import React, { useState, useEffect } from 'react';\nimport { Link, useHistory } from 'react-router-dom';\nimport { connect } from 'react-redux';\nimport { setWalletAddress, getWalletAddress } from '../wallet/wallet.action'\nimport { connectMetamaskCopy } from '../../utils/web3'\nimport { logoutUser } from '../user/user.action';\nimport { ENV } from './../../config/config';\n\nconst Header = (props) => {\n    const history = useHistory();\n    // console.log(\"history\", history);\n    const [connectedAddress, setConnectedAddress] = useState('');\n    const [loader, setLoader] = useState(true);\n    const { _id } = ENV.getUserKeys('_id');\n\n    useEffect(async () => {\n        // COMMENTED TEMPORARILY\n        // METHOD 1\n        // props.getWalletAddress()\n\n        // METHOD 2 - a\n        // let connectedAddress = await connectMetamask();\n        // setConnectedAddress(connectedAddress)\n\n        // METHOD 3\n        // if (localStorage.getItem('wa')) {\n        //     let connectedAddress = window.atob(localStorage.getItem('wa'))\n        //     setConnectedAddress(connectedAddress)\n        // }\n\n        // METHOD 4\n        let connectedAddress = await connectMetamaskCopy();\n        setConnectedAddress(connectedAddress)\n        props.setWalletAddress(connectedAddress)\n    }, [])\n\n    // set loader to false when address is received\n    useEffect(() => {\n        if (connectedAddress)\n            setLoader(false)\n    }, [connectedAddress])\n\n    // COMMENTED TEMPORARILY\n    // METHOD 2 - b\n    // useEffect(() => {\n    //     if (props.wallet.walletAuth) {\n    //         const { connectedAddress } = props.wallet\n    //         setConnectedAddress(connectedAddress)\n    //     }\n    // }, [props.wallet.walletAuth])\n    const formatAddress = (address) => {\n        return address ? address.substr(0, 6) + '...' + address.substr(-4) : null;\n    }\n    const logoutUser = () => {\n        props.logoutUser();\n        history.push('/login');\n    }\n    \n    return (\n        <header id=\"header\">\n            {/* Navbar */}\n            <nav data-aos=\"zoom-out\" data-aos-delay={800} className=\"navbar navbar-expand\">\n                <div className=\"container header\">\n                    {/* Navbar Brand*/}\n                    <Link className=\"navbar-brand\" to=\"/\">\n                        <img className=\"navbar-brand-sticky\" src=\"/img/new_logo.jpeg\" alt=\"sticky brand-logo\" />\n                    </Link>\n                    <div className=\"ml-auto\" />\n                    {/* Navbar */}\n                    <ul className=\"navbar-nav items mx-auto\">\n                        <li className=\"nav-item dropdown\">\n                            <Link className=\"nav-link\" to=\"/\">Home</Link>\n                        </li>\n                        <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\">Explore <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><Link to=\"/explore-all\" className=\"nav-link\">Explore</Link></li>\n                                <li className=\"nav-item\"><Link to=\"/auctions\" className=\"nav-link\">Live Auctions</Link></li>\n                                {/* <li className=\"nav-item\"><Link to=\"/item-details\" className=\"nav-link\">Item Details</Link></li> */}\n                            </ul>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/activity\" className=\"nav-link\">Activity</Link>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/collections\" className=\"nav-link\">Collections</Link>\n                        </li>\n                        {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Community <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/blog\" className=\"nav-link\">Blog</a></li>\n                                <li className=\"nav-item\"><a href=\"/blog-single\" className=\"nav-link\">Blog Single</a></li>\n                                <li className=\"nav-item\"><a href=\"/help-center\" className=\"nav-link\">Help Center</a></li>\n                            </ul>\n                        </li> */}\n                        {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Pages <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/authors\" className=\"nav-link\">Authors</a></li>\n                                <li className=\"nav-item\"><a href=\"/author\" className=\"nav-link\">Author</a></li>\n                                <li className=\"nav-item\"><a href=\"/wallet-connect\" className=\"nav-link\">Wallet Connect</a></li>\n                                <li className=\"nav-item\"><a href=\"/create\" className=\"nav-link\">Create</a></li>\n                                <li className=\"nav-item\"><a href=\"/login\" className=\"nav-link\">Login</a></li>\n                                <li className=\"nav-item\"><a href=\"/signup\" className=\"nav-link\">Signup</a></li>\n                            </ul>\n                        </li> */}\n                        <li className=\"nav-item\">\n                            <Link to=\"/contact\" className=\"nav-link\">Contact</Link>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/history\" className=\"nav-link\">History</Link>\n                        </li>\n                    </ul>\n                    {/* Navbar Icons */}\n                    <ul className=\"navbar-nav icons\">\n                        <li className=\"nav-item\">\n                            <a href=\"#\" className=\"nav-link\" data-toggle=\"modal\" data-target=\"#search\">\n                                <i className=\"fas fa-search\" />\n                            </a>\n                        </li>\n                    </ul>\n                    {/* Navbar Toggler */}\n                    <ul className=\"navbar-nav toggle\">\n                        <li className=\"nav-item\">\n                            <a href=\"#\" className=\"nav-link\" data-toggle=\"modal\" data-target=\"#menu\">\n                                <i className=\"fas fa-bars toggle-icon m-0\" />\n                            </a>\n                        </li>\n                    </ul>\n                    {/* Navbar Action Button */}\n                    <ul className=\"navbar-nav action\">\n                        <li className=\"nav-item ml-3\">\n                            {\n                                connectedAddress && _id ?\n                                    <button className=\"btn ml-lg-auto btn-bordered-white\" onClick={logoutUser}><i className=\"icon-logout mr-md-2\" /> Logout</button>\n                                    // <span id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />{formatAddress(connectedAddress)}</span>\n                                    :\n                                    <Link to=\"/login\" id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />Login</Link>\n                            }\n\n                        </li>\n                    </ul>\n                </div>\n            </nav>\n        </header>\n    );\n};\n\nconst mapStateToProps = state => ({\n    wallet: state.wallet\n});\nexport default connect(mapStateToProps, { setWalletAddress, getWalletAddress, logoutUser })(Header);\n","/Users/zain/Documents/projects/ariswap/frontend/src/components/collections/collection-preview.js",["642","643"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/filter-search/filtersearch.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/utils/abiSetup.js",["644"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/faq/faq.action.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/bids/bids.action.js",["645","646"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/offers/offers.action.js",["647"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/footer/footer.action.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/index.js",["648"],"import { useState } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport {\n  currentStepAction,\n  currentStepDecrement,\n  clearCurrentStep,\n  deployContract,\n  mintToken,\n  connectWallet,\n} from \"../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport \"./index.css\";\nimport Step1 from \"./StepsComponents/Step1/Step1\";\nimport Step2 from \"./StepsComponents/Step2/Step2\";\nimport Step3 from \"./StepsComponents/Step3/Step3\";\nimport Step4 from \"./StepsComponents/Step4/Step4\";\nimport { ProgressBar } from \"react-bootstrap\";\nimport { HiOutlineChevronDoubleLeft } from \"react-icons/hi\";\nimport { connectMetamaskCopy,getNetworkNameByChainId } from \"../../utils/web3\";\n// import { toast } from \"react-toastify\";\n// import ProppertiesModal from \"../../Components/PropertiesModal/ProppertiesModal\";\n\nconst FourStepForm = (props) => {\n  // console.log(props, \"currentStep==>\");\n\n  //step 1 form\n  const [imgFile, setImgFile] = useState({});\n  const [img, setImge] = useState(\"\");\n  const [videoUrl, setVideoUrl] = useState(\"\");\n  //step 2 form\n  const [name, setName] = useState(\"\");\n  const [symbol, setSymbol] = useState(\"\");\n  const [externalLink, setExternalLink] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [supply, setSupply] = useState(1);\n\n  //step 3 form\n  const [properties, setProperties] = useState([]);\n  const [levels, setLevels] = useState([]);\n\n  //step 4 form\n  const [email, setEmail] = useState(\"\");\n  // const [deployNetwork, setDeployNetwork] = useState(\"\");\n  const [isValidate, setIsvalidate] = useState(false);\n  const [walletAddress,setWalletAddress]=useState('');\n  const [connectedNetwork,setNetworkConnected]=useState('')\n\n  /////////\n  const history = useHistory();\n  const { currentStep } = props;\n\n  const handleGoBack = () => {\n    if (currentStep === 1) {\n      history.push(\"/\");\n    } else {\n      props.currentStepDecrement();\n    }\n  };\n\n  const handleBackHome = () => {\n    history.push(\"/\");\n    props.clearCurrentStep();\n  };\n  const handleStep1Info = (file, video, imgUrl) => {\n    // console.log(file, \"file==>\");\n    setImgFile(file);\n    if (video) {\n      setVideoUrl(video);\n      setImge(\"\");\n    }\n    if (imgUrl) {\n      setImge(imgUrl);\n      setVideoUrl(\"\");\n    }\n  };\n  const handleStep2Info = (\n    nameValue,\n    symbolvalue,\n    externalLinkValue,\n    descriptionValue,\n    supplyValue\n  ) => {\n    // console.log(nameValue, \"NAME\");\n\n    setName(nameValue);\n\n    setSymbol(symbolvalue);\n\n    setExternalLink(externalLinkValue);\n\n    setDescription(descriptionValue);\n\n    setSupply(supplyValue);\n  };\n\n  const handleStep3PropertiesInfo = (propertiesValues) => {\n    setProperties(propertiesValues);\n  };\n  const handleStep3LevelsInfo = (levelsInputs) => {\n    setLevels(levelsInputs);\n  };\n\n  const handleStep4Info = (emailValue, network) => {\n    setEmail(emailValue);\n    // setDeployNetwork(network);\n  };\n\n  const handleMinting = async (contractInfo, email) => {\n    // alert(\"deploying contract\");\n    // console.log(properties, \"properties\");\n    // console.log(levels, \"levels==>\");\n    // let result=await props.connectWallet()\n    // connectMetamaskCopy()\n    //   .then((address) => {\n    //     let obj = {\n    //       name,\n    //       description,\n    //       symbol,\n    //       externalLink,\n    //       supply,\n    //       image: imgFile,\n    //       deployNetwork: \"test\",\n    //       email,\n    //       address,\n    //     };\n        // console.log(obj, \"obj in the front end\");\n        // console.log(properties,\"properties\")\n        // console.log(levels,\"levels==>\")\n\n        // var test = new FormData();\n\n        // test.append(\"username\", \"Groucho\");\n        // test.append(\"accountnum\", 123456);\n        // for (const key in obj) {\n        //   if (obj[key]) formData.append(key, obj[key]);\n        // }\n\n        // console.log(\"props contract info\", props.contractInfo);\n\n        // console.log(props.deployContract,\"result==>\")\n        props.mintToken(contractInfo, walletAddress, +supply, email);\n  \n      // })\n      // .catch((err) => console.log(err, \"error\"));\n  };\n\n  // const connectWalletAddress=()=>{\n\n  // }\n  const handleDeployContract = async () => {\n    connectMetamaskCopy(walletAddress)\n      .then((address) => {\n        // let obj = {\n        //   name,\n        //   description,\n        //   symbol,\n        //   externalLink,\n        //   supply,\n        //   image: imgFile,\n        //   email,\n        //   address,\n        // };\n        if(address){\n\n          // props.deployContract(jsonToFormData(obj), address, +supply);\n          if(walletAddress){\n            \n          }\n          setWalletAddress(address)\n        }\n\n      })\n      .catch((err) => console.log(err, \"err1\"));\n\n      handleNetwork()\n      \n  };\n\n\n  const handleNetwork=()=>{\n    getNetworkNameByChainId().then((network)=>{\n      // console.log(network,\"connected network==>\")\n      setNetworkConnected(network)\n    }).catch((err)=>{\n\n    })\n  }\n\n  const handleDeployment=()=>{\n    let obj = {\n      name,\n      description,\n      symbol,\n      externalLink,\n      supply,\n      image: imgFile,\n      email,\n      walletAddress,\n    };\n    props.deployContract(jsonToFormData(obj), walletAddress, +supply);\n  }\n\n  function buildFormData(formData, data, parentKey) {\n    if (\n      data &&\n      typeof data === \"object\" &&\n      !(data instanceof Date) &&\n      !(data instanceof File)\n    ) {\n      Object.keys(data).forEach((key) => {\n        buildFormData(\n          formData,\n          data[key],\n          parentKey ? `${parentKey}[${key}]` : key\n        );\n      });\n    } else {\n      const value = data == null ? \"\" : data;\n\n      formData.append(parentKey, value);\n    }\n  }\n  function jsonToFormData(data) {\n    const formData = new FormData();\n\n    buildFormData(formData, data);\n\n    // for (var key of formData.entries()) {\n    //   // console.log(key[0] + ', ' + key[1]);\n    // }\n    // let attributesDummy=[{\n    //   type:\"type\",\n    //   name:\"name\"\n    // }]\n\n    // let levelsDummy=[{\n    //   name:\"name\",\n    //   total:3,\n    //   value:5,\n    // }]\n    formData.append(\"attributes\", JSON.stringify(properties));\n    formData.append(\"levels\", JSON.stringify(levels));\n\n    return formData;\n  }\n\n  // const handleEmail = (value) => {\n  //   setEmail(value);\n  // };\n\n  const handleCaptchaValidation = (value) => {\n    setIsvalidate(value);\n  };\n  return (\n    <div className=\"steps-container\">\n      <div className=\"steps \">\n        <div className=\"steps-menu py-5\">\n          {currentStep > 0 && (\n            <div\n              className=\"text-white d-flex align-items-center\"\n              style={{ cursor: \"pointer\" }}\n              onClick={() => handleGoBack()}\n            >\n              <HiOutlineChevronDoubleLeft\n                style={{ marginRight: \"0.4rem\" }}\n                color=\"#44D1F9\"\n              />\n              <p className=\"mb-0 mt-0\">Go Back</p>\n            </div>\n          )}\n          {currentStep === 4 && (\n            <div\n              className=\"text-white\"\n              style={{ cursor: \"pointer\" }}\n              onClick={() => handleBackHome()}\n            >\n              Back to Home\n            </div>\n          )}\n        </div>\n        {currentStep && currentStep === 1 ? (\n          <Step1\n            handleStep1Info={handleStep1Info}\n            imageURl={img}\n            videoURL={videoUrl}\n          />\n        ) : currentStep === 2 ? (\n          <Step2\n            handleStep2Info={handleStep2Info}\n            name={name}\n            symbol={symbol}\n            externalLink={externalLink}\n            description={description}\n            supply={supply}\n          />\n        ) : currentStep === 3 ? (\n          <Step3\n            handleStep3PropertiesInfo={handleStep3PropertiesInfo}\n            handleStep3LevelsInfo={handleStep3LevelsInfo}\n            properties={properties}\n            levels={levels}\n          />\n        ) : currentStep === 4 ? (\n          <Step4\n            handleStep4Info={handleStep4Info}\n            handleDeployContract={handleDeployContract}\n            handleMinting={handleMinting}\n            supply={supply}\n            email={email}\n            handleCaptchaValidation={handleCaptchaValidation}\n            isValidate={isValidate}\n            walletAddress={walletAddress}\n            handleDeployment={handleDeployment}\n            info={{name,symbol,externalLink,description,properties,levels,img,videoUrl,email,supply}}\n            connectedNetwork={connectedNetwork}\n\n          />\n        ) : (\n          \"\"\n        )}\n        <div className=\"mt-5\" style={{ width: \"64%\", margin: \"auto\" }}>\n          <ProgressBar\n            className={`${\n              currentStep === 4 ? \"progress-bar-green\" : \"progress-bar-yellow\"\n            }`}\n            now={currentStep * 25}\n          />\n          <p className=\"text-white text-center mt-2\">{currentStep}/4</p>\n          \n        </div>\n      </div>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n\n(\n    console.log(state, \"state\"),\n    {\n    currentStep: state.dashboard.currentStep,\n    contractInfo: state.dashboard.contractInfo,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n  currentStepDecrement,\n  clearCurrentStep,\n  deployContract,\n  mintToken,\n  connectWallet,\n})(FourStepForm);\n","/Users/zain/Documents/projects/ariswap/frontend/src/Screens/Home/home.js",["649"],"// import { useState,useEffect } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { connect } from \"react-redux\";\n// import { hometest } from \"../../Redux/actions/actions\";\nimport Navbar from \"../../components/Navbar/navbar\";\nimport SimpleSlider from \"../../components/Slider/slider\";\n// import image from \"../../assets/images/test.jpg\";\nimport Polygon from \"../../assets/images/icon 2.svg\";\n// import Ethereum from \"../../assets/images/Ethereum.svg\";\nimport Cardano from \"../../assets/images/icon 3.svg\";\nimport Binance from \"../../assets/images/icon4.svg\";\nimport Ethereum from \"../../assets/images/icon1.png\";\n// import nft2 from \"../../assets/images/icon4.svg\";\n// import nft3 from \"../../assets/images/icon 2.svg\";\n////////////////////////\nimport nft1 from \"../../assets/images/nft1.jpg\";\nimport nft2 from \"../../assets/images/nft2.webp\";\nimport nft3 from \"../../assets/images/nft3.jpeg\";\nimport nft4 from \"../../assets/images/nft4.webp\";\nimport nft5 from \"../../assets/images/nft5.jpg\";\n\nimport \"./home.css\";\n\nconst Home = (props) => {\n  // const [network, setNetwork] = useState(\"Ethereum\");\n  // const [spinner,setSpinner]=useState(true)\n\n  // const [flag, setFlag] = useState(false);\n  const networksData = [\n    { name: \"Ethereum\", image: Ethereum },\n    { name: \"Polygon\", image: Polygon },\n    { name: \"Cardano\", image: Cardano },\n    { name: \" Binance SmartChain\", image: Binance },\n  ];\n  // const handleSpinner=()=>{\n\n  // return spinner\n  // }\n  // setTimeout(()=>{\n  //   setSpinner(false)\n  // },2000)\n  // useEffect(()=>{\n\n  // },[spinner])\n  const history = useHistory();\n  const wordsFamousNfts = [\n    {\n      img: nft3,\n      link: \"https://niftygateway.com/itemdetail/primary/0x0151834a6997f89eb8372ac54ac077d79bb4d1e0/7\",\n    },\n    {\n      img: nft1,\n      link: \"https://onlineonly.christies.com/s/beeple-first-5000-days/beeple-b-1981-1/112924?ldp_breadcrumb=back\",\n    },\n    {\n      img: nft2,\n      link: \"https://niftygateway.com/marketplace?collection=0x12f28e2106ce8fd8464885b80ea865e98b465149&tokenId=100010001\",\n    },\n    { img: nft4, link: \"https://foundation.app/@snowden/~/24437\" },\n    { img: nft5, link: \"https://www.phillips.com/mdj\" },\n  ];\n\n  return (\n    <div className=\"home-container p-1\">\n      <div className=\"content\">\n        <div className=\"home-navbar\">\n          <Navbar />\n        </div>\n        <div className=\"mt-4 details-container\">\n          <div className=\" d-flex justify-content-between home-info-container\" >\n\n            <div className=\" \">\n              <div className=\"details\">\n                <div className=\"\" style={{ maxWidth: \"31rem\" }}>\n                  <p\n                    className=\"text-white mint-title\"\n                    style={{ fontSize: \"46px\", fontWeight: \"bold\" }}\n                  >\n                    Let's Mint Your NFT's\n                  </p>\n                  {/* <p className=\"text-white\" style={{ fontSize: \"20px\" }}>\n                    Lorem Ipsum is simply dummy text of the printing and\n                    typesetting industry.{\" \"}\n                  </p> */}\n                </div>\n              </div>\n\n              <div className=\"networks \">\n                <p className=\"text-white select-network-heading\" style={{fontSize:\"36px\"}}>Select Network</p>\n                <div className=\"networks-list-container mt-4 d-flex \">\n                  {networksData.map((item, index) => {\n                    return (\n                      <div\n                        className=\"network\"\n                        disabled={true}\n                        key={index}\n                        // onClick={() => {\n                        //   if (item.name === \"Ethereum\") {\n                        //     setNetwork(item.name);\n                        //     // setFlag(true);\n                        //   }\n                        // }}\n                      >\n                        {/* <div\n                        className=\"position-relative network-image\"\n                          style={{\n                            backgroundColor: \"white\",\n                            width: \"4.7rem\",\n                            borderRadius: \"10px\",\n                            cursor: \"pointer\",\n                          }}\n                        > */}\n                          <img\n                            src={item.image}\n                            alt=\"coming soon\"\n                            style={{\n                              width: \"4rem\",\n                              cursor:\"pointer\"\n                              // padding: \"0rem 0rem 0rem 1rem\",\n                            }}\n                            className={`network-img ${\n                              \"Ethereum\" === item.name ? \"\" : \"selected-network\"\n                            }`}\n                          />\n                          {\n                            \"Ethereum\" !== item.name &&\n                            <span className=\"tooltiptext\">Coming soon</span>\n                          }\n                        {/* </div> */}\n                        <p\n                          className={`ml-1 mt-2 ${\n                            \"Ethereum\" === item.name\n                              ? \"network-title-yellow\"\n                              : \"network-title-white\"\n                          }`}\n                          style={{fontSize:\"14px\"}}\n                        >\n                          {item.name}\n                        </p>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-4\"\n                \n                onClick={() => history.push(\"/fourStepForm\")}\n              >\n                Lets Start\n              </button>\n            </div>\n\n\n\n            <div className=\"d-flex  home-slider-wrapper \">\n              <div\n                className=\"home-slider-container\"\n                style={{ marginLeft: \"2rem\" }}\n              >\n                <SimpleSlider wordsFamousNfts={wordsFamousNfts} />\n                {/* {\n                  !spinner &&\n                  \n                  } \n                  <div className=\"d-flex justify-content-center align-items-center h-100\" style={{display:`${spinner?\"none\":\"block\"}`}}>\n\n                    <div className=\"lds-ellipsis\"><div></div><div></div><div></div><div></div></div>\n                  </div>  */}\n              </div>\n            </div>\n\n          </div>\n\n\n\n\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// const mapStateToProps = (state) =>\n//   // console.log(state, \"state\"),\n//   ({\n//     hometest: state.home,\n//   });\n\n// export default connect(mapStateToProps, {\n//   hometest,\n// })(Home);\nexport default Home\n","/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/Step3.js",["650","651","652","653"],"import { useState } from \"react\";\nimport PropertiesImage from \"../../../../assets/images/Properties.svg\";\nimport AddBtnImage from \"../../../../assets/images/Add Button.svg\";\nimport LevelsBtn from \"../../../../assets/images/Levels.svg\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport PropertiesModal from \"../../../../components/PropertiesModal/ProppertiesModal\";\nimport LevelsModal from \"../../../../components/LevelsModal/LevelsModal\";\nimport \"./Step3.css\";\n\nconst Step3 = (props) => {\n  const [open, setOpen] = useState(false);\n  const [openLevelModal, setOpenLevelModal] = useState(false);\n\n  //for levels Modal\n  const [levelsInputs, setlevelsInputs] = useState(props.levels);\n  const [addMore, setAddMore] = useState(false);\n\n  //for properties Modal\n  const [propertiesValues, setPropertiesValues] = useState(props.properties);\n  const [addMoreProperty,setAddMoreProperty]=useState(false)\n\n  ///////\n  const handleOpen = () => setOpen(true);\n  const handleClose = () => setOpen(false);\n\n  const handleOpenLevel = () => setOpenLevelModal(true);\n  const handleCloseLevel = () => {\n  \n    setOpenLevelModal(false);\n  }\n  //levels Methods\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n\n  let handleChange = (i, e) => {\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    // console.log(newFormValues,\"levels handle change\")\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n      // let newFormValues = [...levelsInputs];\n      if ( levelsInputs.length> 1) {\n      let newFormValues = [...levelsInputs];\n      newFormValues.splice(i, 1);\n      setlevelsInputs(newFormValues);\n    }\n  };\n\n  //propertiesMethods\n  const addMoreProperties=()=>{\n    setAddMoreProperty(!addMoreProperty)\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }])\n  }\n  let handleChangeProperties = (i, e) => {\n    let newFormValues = [...propertiesValues];\n    // console.log(newFormValues,\"new form values before\")\n    newFormValues[i][e.target.name] = e.target.value;\n    // console.log(newFormValues,\"properties handle change\")\n    setPropertiesValues(newFormValues);\n }\n\n let removeFormProperties = (i) => {\n      let newFormValues = [...propertiesValues];\n      newFormValues.splice(i, 1);\n      setPropertiesValues(newFormValues)\n  \n}\nconst onSubmit =(propertiesField)=>{\n  setPropertiesValues(propertiesField)\n  props.handleStep3PropertiesInfo(propertiesField)\n  // props.currentStepAction()\n\n}\nconst onSubmitLevels=(levelsFields)=>{\n  setlevelsInputs(levelsFields)\n  props.handleStep3LevelsInfo(levelsFields)\n}\n  return (\n    <div className=\"step3-container \" style={{ height: \"45vh\" }}>\n      <div className=\"properties-container d-flex justify-content-between \">\n        <div>\n          <div className=\"d-flex align-items-center \">\n            <img src={PropertiesImage} style={{ height: \"2rem\" }} />\n            <p className=\"mb-0 text-white\" style={{ marginLeft: \"1rem\" }}>\n              Properties\n            </p>\n          </div>\n          <p className=\"text-white mt-1\">\n         Textual traits that show up as a rectangles\n          </p>\n        </div>\n\n        <div onClick={() => handleOpen()}>\n          <img src={AddBtnImage} style={{ height: \"1.5rem\",cursor:\"pointer\"  }} />\n        </div>\n      </div>\n\n      <div className=\"properties-container d-flex justify-content-between mt-4 \">\n        <div>\n          <div className=\"d-flex align-items-center \">\n            <img src={LevelsBtn} style={{ height: \"2rem\" }} />\n            <p className=\"mb-0 text-white\" style={{ marginLeft: \"1rem\" }}>\n              Levels\n            </p>\n          </div>\n          <p className=\"text-white mt-1\">\n            Numerical traits that show as a progress bar\n          </p>\n        </div>\n\n        <div onClick={() => handleOpenLevel()}>\n          <img src={AddBtnImage} style={{ height: \"1.5rem\",cursor:\"pointer\" }} />\n        </div>\n      </div>\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary start-btn mt-5 mb-5\"\n        onClick={() =>  props.currentStepAction()}\n      >\n        Next\n      </button>\n\n      <PropertiesModal\n        open={open}\n        handleOpen={handleOpen}\n        handleClose={handleClose}\n        addMoreProperties={addMoreProperties}\n        handleChangeProperties={handleChangeProperties}\n        removeFormProperties={removeFormProperties}\n        propertiesValues={propertiesValues}\n        addMoreProperty={addMoreProperty}\n        onSubmit={onSubmit}\n      />\n      <LevelsModal\n        open={openLevelModal}\n        handleOpen={handleOpenLevel}\n        handleClose={handleCloseLevel}\n        addMoreValues={addMoreValues}\n        handleChange={handleChange}\n        removeFormFields={removeFormFields}\n        levelsInputs={levelsInputs}\n        addMore={addMore}\n        onSubmitLevels={onSubmitLevels}\n      />\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  // console.log(state, \"state\"),\n  {\n    currentStep: state.dashboard.currentStep,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step3);\n","/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step4/Step4.js",["654","655","656","657","658","659","660"],"import { useState, useEffect } from \"react\";\nimport MetamaskImg from \"../../../../assets/images/metamask.svg\";\nimport RefreshImg from \"../../../../assets/images/Refresh.svg\";\nimport DetailsImg from \"../../../../assets/images/Details.svg\";\nimport DiscordImg from \"../../../../assets/images/Discord.svg\";\nimport ReactCaptcha from \"../../../../components/Captcha/Captcha\";\n// import { connectMetamaskCopy } from \"../../../../Utils/web3\";\nimport PreviewModal from \"../../../../components/PreviewModal/PreviewModal\";\n// import { CopyToClipboard } from \"react-copy-to-clipboard\";\nimport { MdContentCopy } from \"react-icons/md\";\nimport { getNetworkNameByChainId} from \"../../../../utils/web3\";\n\n\nimport {\n  connectWallet,\n  contractResponse,\n} from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\n\n\nimport \"./Step4.css\";\nimport copy from \"copy-to-clipboard\";\n\nimport { toast } from \"react-toastify\";\n// import Stepper from \"../../../../Components/Stepper/Stepper\";\n// import { propTypes } from \"react-bootstrap/esm/Image\";\nconst Step4 = (props) => {\n  const [isVisible, setIsvisible] = useState(false);\n  // const [isValidate, setIsvalidate] = useState(false);\n  const [captchaStatus, setCaptchaStatus] = useState(false);\n  const [captchaError, setCaptchaError] = useState(false);\n  const [captchaMessage, setCaptchaMessage] = useState(\n    \"Invalid Captchca Please Try Again\"\n  );\n  const [email, setEmail] = useState(props.email);\n  const [deployNetwork, setDeployNetwork] = useState(\"\");\n  const [deploy, setDeploy] = useState(false);\n  // const [compile, setCompile] = useState(false);\n  const [loadingMessage, setLoadingMessage] = useState(\"\");\n  const [error, setError] = useState(false);\n  const [emailError, setEmailError] = useState(false);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n\n  //previewModal\n  const [previewModal, setPreviewModal] = useState(false);\n  const [previewModalStep, setPreviewModalStep] = useState(1);\n  // const [textCopy,setTextCopy]=useState(false)\n\n  ///copy text ////////////////\n\n  // const [copySuccess, setCopySuccess] = useState('');\n  // const textAreaRef = useRef(null);\n\n  // function copyToClipboard(e) {\n  //   textAreaRef.current.select();\n  //   document.execCommand('copy');\n  //   // This is just personal preference.\n  //   // I prefer to not show the the whole text area selected.\n  //   e.target.focus();\n  //   setCopySuccess('Copied!');\n  // };\n  ////////////\n  const handleCaptcha = (value) => {\n    // console.log(value);\n    setCaptchaStatus(value);\n    setCaptchaError(false);\n    // if (value) {\n    //   setIsvalidate(true);\n    // }\n  };\n  const onChangeEmail = (e) => {\n    setError(false);\n    setEmailError(false);\n    setEmail(e.target.value);\n    props.handleStep4Info(e.target.value);\n  };\n\n  const handleVisible = () => {\n    setIsvisible(true);\n  };\n\n  const submitCaptcha = () => {\n    // console.log(captchaStatus, \"captchaStatus\");\n    if (captchaStatus) {\n      // setIsvalidate(true);\n      props.handleCaptchaValidation(true);\n    } else {\n      setCaptchaError(true);\n    }\n  };\n\n  const onConnect = () => {\n    // props.connectWallet()\n    if (!email) {\n      setEmailError(true);\n      setErrorMessage(\"Email is required\");\n      return \"\";\n    }\n    if (\n      !String(email)\n        .toLowerCase()\n        .match(\n          /^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/\n        )\n    ) {\n      setEmailError(true);\n      setErrorMessage(\"Email must be valid\");\n      return \"\";\n    } else {\n      // alert(\"else\")\n    }\n    let count = localStorage.getItem(email);\n    if (count > 5) {\n      toast.error(\"Maximum Deployment Limit Reached with This Email!\");\n      return \"\";\n    }\n\n    if (email === \"\") {\n      setError(true);\n      return \"\";\n    }\n    // setLoadingMessage(\"Please wait your contract is Deploying!\");\n    // setDeploy(true);\n    // props.handleStep4Info(email, deployNetwork);\n    props.handleDeployContract();\n  };\n\n  const onReload = () => {\n    if (!props.contractReponse) {\n      setDeploy(true);\n\n      // props.contractResponse();\n      props.handleStep4Info(email, deployNetwork);\n      props.handleDeployContract();\n    }\n  };\n  const onMint = () => {\n    if (email === \"\") {\n      setError(true);\n      return \"\";\n    }\n\n    getNetworkNameByChainId()\n      .then((network) => {\n        // console.log(props,\"props==>\")\n        if (network === props.connectedNetwork) {\n          setLoadingMessage(\"Please wait your NFT is Minting...\");\n\n          setDeploy(true);\n          props.handleStep4Info(email, deployNetwork);\n\n          props.handleMinting(props.contractInfo, email);\n        } else {\n          toast.error(`Please connect with ${props.connectedNetwork} network`);\n        }\n      })\n      .catch((err) => {});\n  };\n  useEffect(() => {}, [props.connectedAddressFlag]);\n\n  useEffect(() => {\n    // console.log('all props ', props)\n    // console.log('response for contract ', props.contractResponse)\n  }, [props.contractResponse]);\n\n  // if (props.contractInfo) {\n  //   var { contractAddress } = props?.contractInfo;\n  //   // console.log(typeof(contractAddress),\"type=============>\")\n  // }\n  const handlePreviewModal = () => {\n    // if(!email)\n    setPreviewModalStep(1);\n    setPreviewModal(!previewModal);\n  };\n\n  const handlePreviewModalSteps = (action) => {\n    if (action === \"next\") {\n      setPreviewModalStep(2);\n    } else {\n      setPreviewModalStep(1);\n    }\n  };\n\n  const onDeploy = () => {\n    setPreviewModal(false);\n    setLoadingMessage(\"Please wait your contract is Deploying...\");\n    setDeploy(true);\n    props.handleStep4Info(email, deployNetwork);\n    props.handleDeployment();\n  };\n  // console.log(props,\"tokenId===>\")\n  const displayToken = () => {\n    if (props?.tokenId) {\n      return props.tokenId;\n    }\n    if (props.tokenMinted) {\n      // if (+props.supply === 2) {\n      //   return \"1,2\";\n      // } else if (+props.supply === 3) {\n      //   return \"1,2,3\";\n      // } else if (+props.supply === 4) {\n      //   return \"1,2,3,4\";\n      // } else if (+props.supply === 5) {\n      //   return \"1,2,3,4,5\";\n      // }\n      if(+props.supply >1) {\n        return ` 1-${props.supply}`\n      }\n    }\n  };\n  // console.log(props);\n  return (\n\n    <div className=\"step4-container w-80\">\n      {/* Metamask container */}\n      <div className=\"metamask-container \">\n        <div className=\" justify-content-between w-100 step-4-wrapper\">\n          <div>\n            <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n              <div className=\"position-relative\">\n                <label className=\"text-white step4-label\">Email</label>\n                {error && (\n                  <p className=\"mb-0\" style={{ color: \"red\" }}>\n                    Please Enter Email\n                  </p>\n                )}\n                <p\n                  className=\"position-absolute\"\n                  style={{ color: \"red\", top: \"0\", left: \"3.4rem\" }}\n                >\n                  *\n                </p>\n                <p className=\"mb-1\" style={{ color: \"red\" }}>\n                  {emailError && errorMessage}\n                </p>\n              </div>\n              <input\n                className=\"step-4-input mt-2\"\n                type=\"text\"\n                onChange={(e) => onChangeEmail(e)}\n                disabled={false}\n                value={email}\n                placeholder=\"example@gmail.com\"\n                style={{ maxWidth: \"22rem\", color: \"white\" }}\n              />\n            </div>\n            {/* <div className=\"position-relative mt-3\">\n              <label className=\"text-white step4-label\">Network</label>\n              <p\n                className=\"position-absolute\"\n                style={{ color: \"red\", top: \"0\", left: \"5.4rem\" }}\n              >\n                *\n              </p>\n            </div>\n            <select\n              class=\"form-select mt-2 network-dropdown\"\n              style={{\n                color: \"white\",\n                border: \"none\",\n                outline: \"none\",\n                maxWidth: \"22rem\",\n              }}\n              aria-label=\"Default select example\"\n              onChange={(e) => setDeployNetwork(e.target.value)}\n            >\n              <option className=\"network-option\" selected>\n                Select Network\n              </option>\n              <option className=\"network-option\" value=\"TestNet\">\n                TestNet\n              </option>\n              <option className=\"network-option\" value=\"MainNet\">\n                MainNet\n              </option>\n            </select> */}\n\n            {props.isValidate === false ? (\n              <div className=\"mt-4\">\n                <label className=\"text-white mb-2 step4-label\">\n                  Verify Captcha\n                </label>\n                <ReactCaptcha\n                  handleCaptcha={handleCaptcha}\n                  handleVisible={handleVisible}\n                  isVisible={isVisible}\n                />\n                <p className=\"text-danger mb-0 mt-1\">\n                  {captchaError && captchaMessage}\n                </p>\n                <button\n                  className=\"btn btn-primary step4-btn\"\n                  style={{ marginTop: \"0.8rem\" }}\n                  onClick={() => submitCaptcha()}\n                >\n                  Submit\n                </button>\n              </div>\n            ) : (\n              <div className=\"d-flex mt-4\" style={{ flexDirection: \"column\" }}>\n                <div>\n                  <img\n                    src={MetamaskImg}\n                    style={{ width: \"2rem\", marginRight: \"0.8rem\" }}\n                  />\n                  <div className=\"position-relative\">\n                    <label className=\"text-white step4-label\">\n                      Connect Wallet\n                    </label>\n                    <p\n                      className=\"position-absolute\"\n                      style={{ color: \"red\", top: \"0\", left: \"9.5rem\" }}\n                    >\n                      *\n                    </p>\n                  </div>\n                </div>\n                <p className=\"mb-0 mt-2\" style={{ color: \"#aaabab\" }}>\n                  {\" \"}\n                  Connect Wallet with Metamask\n                </p>\n                <div className=\"d-flex align-items-center\">\n                  <button\n                    className=\"btn btn-primary step4-btn\"\n                    style={{ marginTop: \"0.8rem\" }}\n                    disabled={\n                      props.contractReponse || props.walletAddress\n                        ? true\n                        : false\n                    }\n                    onClick={() => onConnect()}\n                  >\n                    {props.walletAddress ? props.walletAddress : \"Connect\"}\n                  </button>\n                  {!props.loader && !props.contractReponse && (\n                    <img\n                      src={RefreshImg}\n                      style={{\n                        width: \"2rem\",\n                        marginLeft: \"0.8rem\",\n                        cursor: \"pointer\",\n                      }}\n                      disabled={props.contractReponse ? true : false}\n                      onClick={() => onReload()}\n                    />\n                  )}\n                </div>\n              </div>\n            )}\n          </div>\n\n          <div className=\"discord-container  \">\n            <div className=\"d-flex align-items-center\">\n              <img\n                src={DiscordImg}\n                style={{ width: \"2rem\", marginRight: \"1rem\" }}\n                alt=\"\"\n              />\n              <p className=\"step4-label text-white mb-0\"> Join Discord</p>\n            </div>\n            <p className=\"\" style={{ color: \"#aaabab\" }}>\n              Join the Discord Community\n            </p>\n            <button className=\"btn btn-primary step4-btn\">Join</button>\n          </div>\n        </div>\n        {props.walletAddress && (\n          <div className=\"w-100 text-center mt-4\">\n            <button\n              className=\"btn btn-primary step4-btn\"\n              style={{ marginTop: \"0.8rem\" }}\n              disabled={props.contractReponse ? true : false}\n              onClick={handlePreviewModal}\n            >\n              Deploy\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* Details */}\n\n      {props.loader &&\n      (props.contractReponse == false || props.mintingResponse === false) ? (\n        <div className=\"w-100 text-center mt-4\">\n          <div\n            className=\"spinner-border\"\n            style={{ color: \"white\" }}\n            role=\"status\"\n          ></div>\n          <p className=\"text-white\">{loadingMessage}</p>\n          {/* <Stepper/> */}\n        </div>\n      ) : (\n        (props.contractReponse || props.mintingResponse) &&\n        !props.contractError && (\n          <div className=\"step4-details-container mb-2 d-flex  w-100 justify-content-center w-100\">\n            <div>\n              <div className=\" w-100 d-flex justify-content-center mt-4\">\n                <div className=\"d-flex align-items-center\">\n                  <img\n                    src={DetailsImg}\n                    style={{ width: \"1.4rem\", marginRight: \"0.5rem\" }}\n                  />\n                  <p className=\"text-white details-title mb-0\">Details</p>\n                </div>\n              </div>\n              <div className=\"details-box \">\n                <div className=\"d-flex justify-content-between flex-row p-4 mt-4\">\n                  <div>\n                    <p className=\"info\">Contract Address</p>\n              \n                      \n                          {props.tokenMinted && props.tokenMinted.length >0  ?\n                           <p className=\"info\">   {\"Token ID's\"} </p>\n                            : props.tokenId ?\n                            <p className=\"info\">   {\"Token ID\"} </p>\n                            : \"\"}\n                       \n                    \n                    <p className=\"info\">Token Standard</p>\n                    <p className=\"info\">Blockchain</p>\n                  </div>\n\n                  <div>\n                    <div className=\"d-flex\">\n                      <p\n                        className=\"info\"\n                        style={{\n                          color: \"rgb(68, 209, 249)\",\n                          marginRight: \"0.3rem\",\n                        }}\n                      >\n                        {\" \"}\n                        {props.contractAddress\n                          ? `${String(props.contractAddress).substr(\n                              0,\n                              10\n                            )}.....${String(props.contractAddress).substr(\n                              -10,\n                              String(props.contractAddress).length\n                            )}`\n                          : \"0xsbms....dks33\"}\n                      </p>\n\n                      <MdContentCopy\n                        onClick={() => {\n                          copy(props?.contractAddress);\n                        }}\n                        style={{\n                          color: \"white\",\n                          width: \"1.3rem\",\n                          height: \"1.3rem\",\n                          cursor: \"pointer\",\n                        }}\n                      />\n                    </div>\n\n                    {\n                      props.tokenId ? (\n                        <p className=\"info\"> {displayToken()} </p>\n                      ) : props.tokenMinted && props.tokenMinted.length > 0 ? (\n                        <p className=\"info\"> {displayToken()} </p>\n                      ) : (\n                        \"\"\n                      )\n                      // props.tokenId ||(props.tokenMinted && props.tokenMinted.length >0) && (\n                      //   <p className=\"info\"> {displayToken()} </p>\n                      // )\n                    }\n\n                    <p className=\"info \">ERC-721</p>\n                    <p className=\"info \">Ethereum</p>\n                    {/* //if mint successfull */}\n                  </div>\n                </div>\n                <div className=\"w-100 text-center \">\n                  {!props.mintingResponse && (\n                    <button\n                      className=\"btn btn-primary mintbtn\"\n                      onClick={() => onMint()}\n                    >\n                      Let's Mint\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )\n      )}\n      <PreviewModal\n        previewModal={previewModal}\n        handlePreviewModal={handlePreviewModal}\n        handlePreviewModalSteps={handlePreviewModalSteps}\n        previewModalStep={previewModalStep}\n        onDeploy={onDeploy}\n        info={props.info}\n      />\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  // console.log(state, \"state\"),\n  {\n    connectedAddress: state.dashboard.connectedAddress,\n    connectedAddressFlag: state.dashboard.connectedAddressFlag,\n    contractReponse: state.dashboard.contractReponse,\n    contractError: state.dashboard.contractError,\n    contractInfo: state.dashboard.contractInfo,\n    mintingResponse: state.dashboard.mintingResponse,\n    loader: state.dashboard.loader,\n    tokenId: state.dashboard.tokenId,\n    contractAddress: state.dashboard.contractAddress,\n    tokenMinted: state.dashboard.tokenMinted,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  connectWallet,\n  contractResponse,\n})(Step4);\n","/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step1/Step1.js",["661","662"],"import { useState } from \"react\";\nimport \"./Step1.css\";\n// import { RiFolderUploadLine} from \"react-icons/ri\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport {BsImageFill} from 'react-icons/bs'\nimport uploadIcon from \"../../../../assets/images/uploadIcon.png\";\nimport { connect } from \"react-redux\";\nimport { BsUpload } from \"react-icons/bs\";\n\nconst Step1 = (props) => {\n  const [file, setFile] = useState(\"\");\n  const [img, setImage] = useState(props.imageURl);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [videoUrl, setVideoUrl] = useState(props.videoURL);\n  // console.log(process.env,\"config.baseurl===>\")\n\n  const onFileChange = (event) => {\n    setErrorMessage(\"\");\n\n    if (event.target.files[0]) {\n      // console.log(event.target.files[0], \"event.target.files[0]==>\");\n\n      let type = event.target.files[0].type;\n      // console.log(type,\"typee\")\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\"\n      ) {\n        let fileSize = formatBytes(event.target.files[0].size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          setErrorMessage(\"File size limit is exceeded\");\n        } else {\n          let url = URL.createObjectURL(event.target.files[0]);\n          if (event.target.files[0].type === \"video/mp4\") {\n            setVideoUrl(url);\n            setImage(\"\");\n          } else {\n            setImage(url);\n            setVideoUrl(\"\");\n            // console.log(formatBytes(event.target.files[0].size).split(' ') ,\"event.target.files[0]==>\")\n            setFile(event.target.files[0]);\n          }\n        }  if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\"\n      ) {\n        let fileSize = formatBytes(event.target.files[0].size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          setErrorMessage(\"File size limit is exceeded\");\n        } else {\n          let url = URL.createObjectURL(event.target.files[0]);\n          if (event.target.files[0].type === \"video/mp4\") {\n            setVideoUrl(url);\n            setImage(\"\");\n          } else {\n            setImage(url);\n            setVideoUrl(\"\");\n            // console.log(formatBytes(event.target.files[0].size).split(' ') ,\"event.target.files[0]==>\")\n            setFile(event.target.files[0]);\n          }\n        }\n      } else {\n        setErrorMessage(\"File not supported!\");\n      }\n      } else {\n        setErrorMessage(\"File not supported!\");\n      }\n    }\n  };\n  function formatBytes(bytes, decimals = 2) {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  }\n\n  // On file upload (click the upload button)\n  const onFileUpload = () => {\n    if (img === \"\" && videoUrl === \"\") {\n      setErrorMessage(\"Please upload a file\");\n      return \"\";\n    }\n    // console.log(file);\n    props.handleStep1Info(file, videoUrl, img);\n    props.currentStepAction();\n  };\n  const dragOver = (e) => {\n    e.preventDefault();\n}\n\nconst dragEnter = (e) => {\n    e.preventDefault();\n}\n\nconst dragLeave = (e) => {\n    e.preventDefault();\n}\nconst onDrop=(e)=>{\n  e.preventDefault();\n  setErrorMessage(\"\");\n  const files = e.dataTransfer.files[0];\n  if(files){\n\n    const type=e.dataTransfer.files[0].type;\n    console.log(files);\n    if (\n      type === \"image/jpeg\" ||\n      type === \"image/png\" ||\n      type === \"image/gif\" ||\n      type === \"video/mp4\"\n    ) {\n      let fileSize = formatBytes(files.size).split(\" \");\n      if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n        setErrorMessage(\"File size limit is exceeded\");\n      } else {\n        let url = URL.createObjectURL(files);\n        if (files.type === \"video/mp4\") {\n          setVideoUrl(url);\n          setImage(\"\");\n        } else {\n          setImage(url);\n          setVideoUrl(\"\");\n          // console.log(formatBytes(e.target.files[0].size).split(' ') ,\"e.target.files[0]==>\")\n          setFile(files);\n        }\n      }\n    } else {\n      setErrorMessage(\"File not supported!\");\n    }\n  }\n}\n\n  // console.log(props,\"props==>\")\n  return (\n    <div className=\"\">\n      <p className=\"text-white upload-img-title mb-1\" >Upload Image</p>\n\n      <p className=\"text-white testingkkk \" style={{fontSize:\"14px\",padding:\"0rem\",margin:\"0rem\"}}>\n        File type supported:JPEG/PNG/GIF/MP4 max size 100 MB.{\" \"}\n      </p>\n      {videoUrl && (\n        <video width=\"210\" controls>\n          <source src={videoUrl} />\n        </video>\n      )}\n      <p style={{ color: \"red\" }}>{errorMessage && errorMessage}</p>\n      {!img ? (\n        <>\n          {!videoUrl && !img && (\n            <label className=\"text-center d-flex\" style={{cursor:\"pointer\",width:\"14vw\"}}>\n            <div className=\"file-container text-white d-flex justify-content-center align-items-center mt-2 mb-5\"\n            onDrop={(e) => onDrop(e)}\n            onDragOver={(e) => dragOver(e)}\n            onDragEnter={(e) => dragEnter(e)}\n            onDragLeave={(e) => dragLeave(e)}\n            >\n              <div\n                className=\"d-flex h-100 justify-content-center align-items-center\"\n                style={{ flexDirection: \"column\",cursor:\"pointer\" }}\n                \n              >\n                  {/* <RiFolderUploadLine className=\"upload-icon\" /> */}\n                  <img className=\"upload-icon mb-3\" src={uploadIcon} />\n\n                  <p style={{ color: \"#aaabab\",fontSize:\"14px\",margin:\"0rem\" }}>\n                    Add photo or video <br /> or Drag and drop\n                  </p>\n                  <input\n                    type=\"file\"\n                    style={{ display: \"none\" }}\n                    onChange={onFileChange}\n                    accept=\".mp4, .png,.jpeg\"\n                  />\n              </div>\n            </div>\n                </label>\n          )}\n          {videoUrl && (\n            <div     onDrop={(e) => onDrop(e)}\n            onDragOver={(e) => dragOver(e)}\n            onDragEnter={(e) => dragEnter(e)}\n            onDragLeave={(e) => dragLeave(e)}>\n              <label>\n                <div\n                  className=\"d-flex align-items-center justify-content-center mb-3\"\n                  style={{\n                    backgroundColor: \"#001d43\",\n                    width: \"13.2rem\",\n                    height: \"3rem\",\n                    borderRadius: \"10px\",\n                    cursor: \"pointer\",\n                  }}\n                >\n                  <BsUpload style={{ fontSize: \"1.4rem\", color: \"white\" }} />\n                </div>\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  onDrop={(e) => onFileChange(e)}\n                  onDragOver={(e) => onFileChange(e)}\n                  onDragEnter={(e) => onFileChange(e)}\n                  onDragLeave={(e) => onFileChange(e)}\n                />\n              </label>\n            </div>\n          )}\n        </>\n      ) : (\n        <div className=\"text-white d-flex  mt-2 mb-5\" style={{cursor:\"pointer\"}}     onDrop={(e) => onDrop(e)}\n        onDragOver={(e) => dragOver(e)}\n        onDragEnter={(e) => dragEnter(e)}\n        onDragLeave={(e) => dragLeave(e)}>\n          <label className=\"text-center position-relative label-parent\">\n            <img className=\"selected-file \" src={img} alt=\"uploaded image\" style={{cursor:\"pointer\"}}     />\n               <BsImageFill className=\"position-absolute upload-img-icon\" style={{fontSize:\"1.2rem\",cursor:\"pointer\"}}/>\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n            />\n          </label>\n        </div>\n      )}\n\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary start-btn mt-5 mb-5\"\n        onClick={() => onFileUpload()}\n      >\n        Next\n      </button>\n    </div>\n  );\n};\n\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step1);\n","/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step2/Step2.js",["663","664","665"],"import { useState } from \"react\";\nimport \"./Step2.css\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\n\nconst Step2 = (props) => {\n  const [name, setName] = useState(props.name);\n  const [symbol, setSymbol] = useState(props.symbol);\n  const [externalLink, setExternalLink] = useState(props.externalLink);\n  const [description, setDescription] = useState(props.description);\n  const [supply, setSupply] = useState(props.supply);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [error, setError] = useState(false);\n  const [linkError,setLinkError]=useState(false)\n  const patternValidation = val => {\n    return /\\s/g.test(val);\n  };\n  const onChangeName = (e) => {\n if(!name)\n {\n\n   if (patternValidation(e.target.value)) {\n     e.preventDefault();\n   }\n   else {\n\n     setName(e.target.value);\n   }\n }\n else {\n  setName(e.target.value);\n }\n  };\n\n  const onChangeSymbol = (e) => {\n  \n\n    if(!symbol)\n    {\n   \n      if (patternValidation(e.target.value)) {\n        e.preventDefault();\n      }\n      else {\n   \n        setSymbol(e.target.value);\n      }\n    }\n    else {\n\n      setSymbol(e.target.value);\n    }\n   \n  };\n\n  const onChangeExternalLink = (e) => {\n    if(!externalLink)\n    {\n   \n      if (patternValidation(e.target.value)) {\n        e.preventDefault();\n      }\n      else {\n        setLinkError(false)\n        setExternalLink(e.target.value);\n      }\n    }\n    else{\n\n      setLinkError(false)\n      setExternalLink(e.target.value);\n    }\n  };\n\n  const onChangeDescription = (e) => {\n    \n    if(!description)\n    {\n   \n      if (patternValidation(e.target.value)) {\n        e.preventDefault();\n      }\n      else {\n   \n        setDescription(e.target.value);\n      }\n    }\n    else {\n\n      setDescription(e.target.value);\n    }\n  };\n  const onChangeSupply = (e) => {\n    setSupply(e.target.value);\n  };\n\n  const onSubmit = (e) => {\n    e.preventDefault()\n    // console.log(name, \"name==>\");\n    if (name.trim() === \"\") {\n      setErrorMessage(\"Please Fill required fields!\");\n      setName('')\n      setError(true);\n      return \"\";\n    }\n    // console.log(name.trim().length <3)\n    if(name.trim().length <3)\n    {\n      setErrorMessage(\"Name should have atleast 3 characters\");\n      setError(true);\n      return \" \"\n\n    }\n    if(externalLink){\n\n      if (\n        !externalLink.match(\n          /(http(s)?:\\/\\/.)?(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{2,256}\\.[a-z]{2,6}\\b([-a-zA-Z0-9@:%_\\+.~#?&//=]*)/g\n        )\n      ) {\n        // alert(\"external link must be a valid uri\")\n        setLinkError(true)\n        return  \"\"\n      }\n    }\n\n    props.handleStep2Info(name, symbol, externalLink, description, supply);\n    props.currentStepAction();\n  };\n  return (\n    <div className=\"step2-container \" style={{marginBottom:\"14%\"}}>\n      <form onSubmit={onSubmit}>\n        \n      <div className=\"row\">\n        <p style={{ color: \"red\" }}>{error && errorMessage} </p>\n        <div className=\"col-md-6 col-sm-12\">\n          <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n            <div className=\"position-relative\">\n              <label className=\"text-white step-2-label\">Name</label>\n              <p\n                className=\"position-absolute\"\n                style={{ color: \"red\", top: \"0\", left: \"3.8rem\" }}\n              >\n                *\n              </p>\n            </div>\n            <input\n              className=\"step-2-input mt-2\"\n              type=\"text\"\n              onChange={(e) => onChangeName(e)}\n              value={name}\n              placeholder=\"item name\"\n              required={true}\n              maxLength=\"50\"\n              minLength=\"3\"\n            />\n          </div>\n\n          <div className=\"d-flex mt-4\" style={{ flexDirection: \"column\" }}>\n            <label className=\"text-white step-2-label\">Symbol</label>\n\n            {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              {\" \"}\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n            <input\n              className=\"step-2-input mt-2\"\n              type=\"text\"\n              onChange={(e) => onChangeSymbol(e)}\n              value={symbol}\n              placeholder=\"NFT Symbol\"\n              maxLength=\"50\"\n            />\n          </div>\n\n          <div className=\"d-flex  mt-4\" style={{ flexDirection: \"column\" }}>\n            <label className=\"text-white step-2-label\">External Link</label>\n            {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n            {/* <p style={{color:\"red\"}}>{linkError &&\"External Link must be a valid Url\"}</p> */}\n            <input\n              className=\"step-2-input mt-1\"\n              type=\"url\"\n              onChange={(e) => onChangeExternalLink(e)}\n              value={externalLink}\n              placeholder=\"https://yousite.com/item.1004\"\n              maxLength=\"50\"\n            />\n          </div>\n          <button\n            type=\"submit\"\n            className=\"btn btn-secondary start-btn mt-5\"\n            // onClick={() => onSubmit()}\n          >\n            Next\n          </button>\n        </div>\n\n        <div className=\"col-md-6 col-sm-12 mt-5 mt-md-0\">\n          <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n            <label className=\"text-white step-2-label\">Supply</label>\n            <p className=\"mb-0\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              The number of copies that can be minted{\" \"}\n            </p>\n            <input\n              className=\"step-2-input mt-2\"\n              type=\"number\"\n              onChange={(e) => onChangeSupply(e)}\n              value={supply}\n              placeholder=\"supply\"\n              max=\"100\"\n              min=\"1\"\n            />\n            {/* <select\n              className=\"form-select mt-2 network-dropdown\"\n              style={{\n                color: \"white\",\n                border: \"none\",\n                outline: \"none\",\n                maxWidth: \"22rem\",\n              }}\n              aria-label=\"Default select example\"\n              value={supply}\n              onChange={(e) => onChangeSupply(e)}\n            >\n              <option className=\"network-option\" value=\"1\" defaultValue={\"1\"}>\n                1\n              </option>\n              <option className=\"network-option\" value=\"2\">\n                2\n              </option>\n              <option className=\"network-option\" value=\"3\">\n                3\n              </option>\n              <option className=\"network-option\" value=\"4\">\n                4\n              </option>\n              <option className=\"network-option\" value=\"5\">\n                5\n              </option>\n            </select> */}\n          </div>\n          {/* //////////////////////// */}\n          <div className=\"d-flex  mt-4\" style={{ flexDirection: \"column\" }}>\n            <label className=\"text-white step-2-label\">Description</label>\n\n            {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n            <textarea\n              className=\"description p-3 mt-2\"\n              placeholder=\"Add Description\"\n              onChange={onChangeDescription}\n              value={description}\n              style={{ color: \"white\" }}\n              maxLength=\"600\"\n            />\n          </div>\n        </div>\n      </div>\n\n      </form>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step2);\n","/Users/zain/Documents/projects/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["666","667"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 630,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(\n    props.levelsInputs\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage,setErrorMessage]=React.useState(\"\")\n  const [validate,setValidate]=React.useState(false)\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n      let newFormValues = [...levelsInputs];\n      newFormValues.splice(i, 1);\n      setlevelsInputs(newFormValues);\n \n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault()\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total ===\"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\")\n        return \"\";\n      }\n      if(+item.value > +item.total){\n        alert(\"inside\")\n        setError(true)\n        setValidate(true)\n        setErrorMessage(\"Value should be less then total!\")\n        return \"\";\n      }\n \n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n//  const handleValue=(item)=>{\n//    if(item.value > item.total){\n\n//      setError(true)\n//      return true\n//    }\n//    return false\n//  }\n//  const handleTotal=(item)=>{\n\n//  }\n// console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor:\"pointer\"\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={LevelsImage} alt={\"levels\"} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Add Levels\n              </p>\n            </div>\n              {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p className=\"text-center w-100 p-4 text-white\" style={{color:\"#FFFFFF\",opacity:\"0.70\",width:\"80%\",fontSize:\"14px\" }}>\n           Levels show up underneath your item, are clickable, and can be\nfiltered in you collection’s sidebar.\n            </p>\n       <form onSubmit={handleSubmit}>\n            <div className=\"row levels-scroll p-3\" style={{height:`${levelsInputs &&   levelsInputs.length > 0 ?\" 22vh\":\"14vh\"}`}}>\n              {levelsInputs &&\n                levelsInputs.length > 0 &&\n              levelsInputs.map((item, i) => {\n                return (\n                  <div className=\"d-flex\" key={i}>\n                    <div className=\"col-6 mt-2 \" key={i}>\n                      <div\n                        className=\"d-flex\"\n                        style={{ flexDirection: \"column\" }}\n                      >\n                     \n                        <label\n                          className=\"text-white\"\n                          style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                        >\n                          Name\n                        </label>\n\n                        <input\n                          className=\"step-2-input mt-3 \"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => handleChange(i, e)}\n                          value={item.name || \"\"}\n                          placeholder=\"Name\"\n                          maxLength=\"50\"\n                          style={{\n                            backgroundColor: \"#000e29\",\n                            maxWidth: \"84%\",\n                            padding: \"0.6rem 1rem\",\n                          }}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-6 mt-3\">\n               \n                      <div\n                        className=\"d-flex position-relative\"\n                        style={{ flexDirection: \"column\" }}\n                      >\n                          \n                          \n                        <label\n                          className=\"text-white\"\n                          style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                        >\n                          Value\n                        </label>\n                        {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                        <div className=\"d-flex align-items-center  w-100\">\n\n                          <input\n                            className={`step-2-input first-value mt-2 ${validate && item.value > item.total ? \"levels-value\":\"\"}`}\n                            type=\"number\"      \n                            min=\"1\"\n                            max={item.total ?item.total :\"1\"}\n                            onChange={(e) => handleChange(i, e)}\n                            value={item.value || \"\"}\n                            placeholder=\"Value\"\n                            name=\"value\"\n                    \n                            style={{\n                              backgroundColor: \"#000e29\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                       \n                          \n                          <p className=\"text-white mb-0 value-label\">Of</p>\n                          <input\n                            className={`step-2-input first-value mt-2 ${validate && item.total < item.value ? \"levels-value\":\"\"}`}\n                            type=\"number\"\n                            min={item.value ?item.value :\"1\"}\n                            max=\"9999\"\n                            name=\"total\"\n                            placeholder=\"total\"\n                   \n                            onChange={(e) => handleChange(i, e)}\n                            value={item.total || \"\"}\n                            style={{\n                              backgroundColor: \"#000e29\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                        </div>\n                        <BsFillXCircleFill\n                          className=\"position-absolute levels-cross-icon\"\n                          style={{\n                            color: \"#00d3f3\",\n                            top: \"3rem\",\n                            right: \"0\",\n                            cursor: \"pointer\",\n                          }}\n                          onClick={() => removeFormFields(i)}\n                          />\n                      </div>\n                        \n                    </div>\n                  </div>\n                );\n              })}\n\n              <p\n                className=\" mt-4\"\n                style={{ color: \"#00d3f3\" ,cursor:\"pointer\"}}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n        \n            <div className=\"w-100 text-center\">\n              <button\n                type=\"submit\"\n                className=\"btn btn-secondary start-btn mt-5 text-center\"\n                style={{ width: \"9rem\" }}\n                disabled={\n                  levelsInputs && levelsInputs?.length > 0\n                    ? false\n                    : true\n                }\n                // onClick={() => {\n                //   handleSubmit()\n                // }}\n              >\n                Save\n              </button>\n            </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) => (\n  // console.log(state, \"state\"),\n  {\n    currentStep: state.dashboard.currentStep,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/Users/zain/Documents/projects/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["668","669"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 630,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.propertiesValues\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 22vh\"\n                    : \"14vh\"\n                }`,\n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" key={i}>\n                      <div className=\"col-6 mt-4\" key={i}>\n                        <div\n                          className=\"d-flex\"\n                          style={{ flexDirection: \"column\" }}\n                        >\n                          <label\n                            className=\"text-white\"\n                            style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                          >\n                            Name\n                          </label>\n                          <input\n                            className=\"step-2-input mt-2 \"\n                            type=\"text\"\n                            name=\"name\"\n                            onChange={(e) => handleChange(i, e)}\n                            placeholder=\"Name\"\n                            value={item.name || \"\"}\n                            maxLength=\"40\"\n                            style={{\n                              backgroundColor: \"#000e29 !important\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                        </div>\n                      </div>\n\n                      <div className=\"col-6 mt-4\">\n                        <div\n                          className=\"d-flex position-relative\"\n                          style={{ flexDirection: \"column\" }}\n                        >\n                          <label\n                            className=\"text-white\"\n                            style={{\n                              fontSize: \"1.2rem\",\n                              fontWeight: \"bold\",\n                              marginLeft: \"2rem\",\n                            }}\n                          >\n                            Value\n                          </label>\n                          <input\n                            className=\"step-2-input  mt-2\"\n                            type=\"text\"\n                            name=\"value\"\n                            onChange={(e) => handleChange(i, e)}\n                            placeholder=\"Value\"\n                            value={item.value || \"\"}\n                            maxLength=\"40\"\n                            style={{\n                              backgroundColor: \"#000e29 \",\n                              maxWidth: \"84%\",\n                              marginLeft: \"2rem\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                          <BsFillXCircleFill\n                            className=\"position-absolute cross-icon\"\n                            style={{\n                              color: \"#00d3f3\",\n                              top: \"3rem\",\n                              left: \"15.8rem\",\n                              cursor: \"pointer\",\n                            }}\n                            onClick={() => removeFormFields(i)}\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n\n              <p\n                className=\" mt-4\"\n                style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Property\n              </p>\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-5 text-center\"\n                style={{ width: \"9rem\" }}\n                disabled={\n                  propertiesValues && propertiesValues?.length > 0\n                    ? false\n                    : true\n                }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/Users/zain/Documents/projects/ariswap/frontend/src/redux/actions/actions.js",["670","671"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/Navbar/navbar.js",["672","673","674","675","676"],"// import react from 'react'\nimport './navbar.css'\nimport {useHistory} from 'react-router-dom'\n\nconst Navbar =()=>{\n  const history=useHistory()\n    return (\n        <div className=\"nav \">\n  <input type=\"checkbox\" id=\"nav-check\"/>\n  <div className=\"nav-header\">\n    <div className=\"nav-title\" onClick={()=>history.push('/')}>\n      MintsClub\n    </div>\n  </div>\n  <div className=\"nav-btn\">\n    <label htmlFor=\"nav-check\">\n      <span></span>\n      <span></span>\n      <span></span>\n    </label>\n  </div>\n  \n  <div className=\"nav-links\">\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\" style={{color:\"#ffd33e\"}}>Home</a>\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\">Twitter</a>\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\">Discord</a>\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\">Telegram</a>\n    <a className=\"navbar-item\" href=\"#\" target=\"_blank\">Reddit</a>\n  </div>\n</div>\n    )\n}\n\n\nexport default Navbar","/Users/zain/Documents/projects/ariswap/frontend/src/components/Slider/slider.js",["677"],"import React from \"react\";\nimport \"./slider.css\";\nimport Slider from \"react-slick\";\nimport \"slick-carousel/slick/slick.css\";\nimport \"slick-carousel/slick/slick-theme.css\";\n\n// import image from \"../../assets/images/test.jpg\";\nimport nftBack from \"../../assets/images/nftBack.png\";\n// import nftImage from \"../../assets/images/nftImage.png\";\n\nconst  SimpleSlider=(props)=>{\n\n    const settings = {\n      dots: true,\n      infinite: true,\n      speed: 500,\n      slidesToShow: 1,\n      slidesToScroll: 1,\n    };\n  \n    return (\n      <div className=\"position-relative\" style={{ backgroundColor: \"\" }}>\n        {/* <h2> Single Item</h2> */}\n\n        <img src={nftBack} style={{ width: \"26rem\", minWidth: \"26rem\" }} />\n\n        <div\n          className=\"position-absolute nfts-title-container\"\n          style={{ top: \"-3rem\", right: \"9rem\" }}\n        >\n          <p\n            className=\"text-white mb-0 worlds-famous\"\n            style={{\n              fontSize: \"34px\",\n              fontWeight: \"bold\",\n              // fontFamily: \"Manrope\",\n            }}\n          >\n            World's Famous\n          </p>\n          <p\n            className=\"mb-0 text-white nfts-title\"\n            style={{\n              // fontSize: \"165px\",\n              fontSize:\"8.2vw\",\n              fontWeight: \"bold\",\n              marginTop: \"-3rem\",\n              // fontFamily: \"Manrope\",\n            }}\n          >\n            NFT's\n          </p>\n        </div>\n        <div className=\"position-relative slider-wrapper\" style={{bottom:\"22rem\",right:\"-2rem\",cursor:\"pointer\"}} >\n          <Slider {...settings}>\n            {props.wordsFamousNfts.map((nft,index) => {\n              return (\n                <div key={index} onClick={()=>window.open(nft.link)}>\n                  <img src={nft.img} className=\"slider-img\" alt={nft} />\n                </div>\n              );\n            })}\n          </Slider>\n        </div>\n      </div>\n    );\n  }\n  export default SimpleSlider\n\n","/Users/zain/Documents/projects/ariswap/frontend/src/redux/types/types.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/redux/reducer/reducer.js",["678"],{"ruleId":"679","replacedBy":"680"},{"ruleId":"681","replacedBy":"682"},{"ruleId":"683","severity":1,"message":"684","line":1,"column":28,"nodeType":"685","messageId":"686","endLine":1,"endColumn":36},{"ruleId":"683","severity":1,"message":"687","line":2,"column":10,"nodeType":"685","messageId":"686","endLine":2,"endColumn":15},{"ruleId":"683","severity":1,"message":"688","line":2,"column":17,"nodeType":"685","messageId":"686","endLine":2,"endColumn":27},{"ruleId":"683","severity":1,"message":"689","line":7,"column":8,"nodeType":"685","messageId":"686","endLine":7,"endColumn":21},{"ruleId":"683","severity":1,"message":"690","line":8,"column":8,"nodeType":"685","messageId":"686","endLine":8,"endColumn":15},{"ruleId":"683","severity":1,"message":"691","line":8,"column":22,"nodeType":"685","messageId":"686","endLine":8,"endColumn":32},{"ruleId":"683","severity":1,"message":"692","line":10,"column":9,"nodeType":"685","messageId":"686","endLine":10,"endColumn":31},{"ruleId":"693","severity":1,"message":"694","line":31,"column":8,"nodeType":"695","endLine":31,"endColumn":10,"suggestions":"696"},{"ruleId":"693","severity":1,"message":"697","line":41,"column":9,"nodeType":"695","endLine":41,"endColumn":36,"suggestions":"698"},{"ruleId":"693","severity":1,"message":"699","line":53,