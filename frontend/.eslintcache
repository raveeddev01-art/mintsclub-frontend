tsClub-ariswap/ariswap/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["293","294"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["295","296"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Captcha/Captcha.js",[],["297","298"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["299"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\nimport Modal from \"@mui/material/Modal\";\nimport { AiOutlineClose } from \"react-icons/ai\";\nimport { BiArrowBack } from \"react-icons/bi\";\n\nimport \"./PreviewModal.css\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 830,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst genStyle = {\n row:{\n   display: 'grid'\n }\n};\n// let array = [1];\n\nconst PreviewModal = (props) => {\n  console.log(props,\"props\")\n  const {\n    previewModal,\n    handlePreviewModal,\n    previewModalStep,\n    handlePreviewModalSteps,\n    onDeploy,\n    info,\n  } = props;\n  const handleNextStep = () => {\n    if (previewModalStep === 1) {\n      handlePreviewModalSteps(\"next\");\n    } else {\n      onDeploy();\n    }\n  };\n  // console.log(props,\"props\")\n  return (\n    <div>\n      <Modal\n        open={previewModal}\n        onClose={handlePreviewModal}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"preview-modal-container \">\n            <div className=\"w-100 d-flex justify-content-between \">\n              {previewModalStep > 1 ? (\n                <BiArrowBack\n                  className=\"text-white \"\n                  style={{\n                    fontSize: \"1.8rem\",\n                    marginLeft: \"2rem\",\n                    cursor: \"pointer\",\n                  }}\n                  onClick={() => handlePreviewModalSteps(\"back\")}\n                />\n              ) : (\n                <span></span>\n              )}\n              <AiOutlineClose\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.8rem\",\n                  marginRight: \"2rem\",\n                  cursor: \"pointer\",\n                }}\n                onClick={() => handlePreviewModal()}\n              />\n            </div>\n\n            {previewModalStep === 1 ? (\n              <div className=\"row  preview-modal-info\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text\">Preview</p>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-between flex-column\">\n                  {info.img && (\n                    <img\n                      src={info.img ? info.img : \"\"}\n                      style={{\n                        width: \"100%\",\n                        height: \"33.6vh\",\n                        borderRadius: \"10px\",\n                      }}\n                      alt=\"preview\"\n                    />\n                  )}\n                  {info.videoUrl && (\n                    <video width=\"260\" controls>\n                      <source src={info.videoUrl} />\n                    </video>\n                  )}\n\n                  <div\n                    className=\"d-flex  mt-4\"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"url\"\n                      value={\n                        (info.externalLink && info.externalLink.trim()) ||\n                        \"- externalLink -\"\n                      }\n                      placeholder=\"- externalLink -\"\n                      style={{ margin: \"0\" ,width:\"100%\"}}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                </div>\n\n                <div className=\"col-md-6 col-sm-12 mt-4\">\n                  <input\n                    className=\"preview-input \"\n                    type=\"text\"\n                    value={info.name || \"\"}\n                    placeholder=\"name\"\n                    maxLength=\"50\"\n                    disabled={true}\n                  />\n                  <input\n                    className=\"preview-input mt-4\"\n                    type=\"email\"\n                    value={info.email || \"\"}\n                    maxLength=\"50\"\n                    disabled={true}\n                  />\n                  <input\n                    className=\"preview-input mt-4\"\n                    type=\"text\"\n                    value={(info.symbol && info.symbol.trim()) || \"- symbol -\"}\n                    placeholder=\"- symbol -\"\n                    maxLength=\"50\"\n                    disabled={true}\n                  />\n                  <textarea\n                    className=\"preview-description p-3 mt-4 w-100\"\n                    placeholder=\"- Description -\"\n                    value={\n                      (info.description && info.description.trim()) ||\n                      \"- Description -\"\n                    }\n                    style={{ color: \"#aaabab\", marginLeft: \"2rem\" }}\n                    maxLength=\"600\"\n                    disabled={true}\n                  />\n                  <input\n                    className=\"preview-input mt-4\"\n                    type=\"number\"\n                    value={info.supply || \"- supply -\"}\n                    disabled={true}\n                    placeholder=\"- supply -\"\n                    maxLength=\"50\"\n                  />\n                </div>\n              </div>\n            ) : (\n              <div className=\" preview-modal-info rowCust\" >\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text\">Preview</p>\n                </div>\n            \n\n                <p className=\"text-white preview-properties-title\">\n                  Properties{\" \"}\n                </p>\n              \n                <div\n                  className=\"rowCust\"\n                  style={{ overflowY: \"auto\", height: \"5rem\",overflowX:\"hidden\" }}\n                >\n                  {info.properties && info.properties.length > 0 ? (\n                    info.properties.map((item, index) => {\n                      return (\n                        <div className=\"row col-md-12\" key={index}>\n                          <div className=\"col-6  mt-4 centerCls\" key={index}>\n                            <input\n                              className=\"preview-input-step-2  \"\n                              type=\"url\"\n                              value={item.name || \"\"}\n                              maxLength=\"50\"\n                              placeholder=\"item name\"\n                              disabled={true}\n                            />\n                          </div>\n\n                          <div className=\"col-6  mt-4 centerCls\">\n                            <input\n                              className=\"preview-input-step-2 value-input-preview \"\n                              style={{maxWidth:\"91%\"}}\n                              type=\"url\"\n                              value={item.value || \"\"}\n                              placeholder=\"Value\"\n                              maxLength=\"50\"\n                              disabled={true}\n                            />\n                          </div>\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center\" style={{ color: \"#A9A9A9\" }}>\n                      {\"No Properties Found\"}\n                    </p>\n                  )}\n                </div>\n\n                {/* ////////////////////////////////////////////// */}\n                <div\n                  className=\"rowCust mt-5\"\n                  style={{\n                    overflowY: \"auto\",\n                    overflowX: \"hidden\",\n                    height: \"6rem\",\n                  }}\n                >\n                  <p className=\"text-white preview-levels-title\">Levels </p>\n                {info.levels && info.levels.length > 0 ? (\n                    info.levels.map((item, index) => {\n                      return (\n                        <div className=\"row col-md-12\" key={index}>\n                          <div className=\"col-6 mt-2 centerCls\" key={index}>\n                            <input\n                              className=\"preview-input-step-2  \"\n                              type=\"url\"\n                              value={item.name || \"\"}\n                              placeholder=\"Levels\"\n                              style={{\n                                marginTop: `${index === 0 ? \"0rem\" : \"1.2rem\"}`,\n                              }}\n                              // maxLength=\"50\"\n                              disabled={true}\n                            />\n                          </div>\n\n                          <div className=\"col-6\">\n                            <div\n                              className=\"d-flex align-items-center  w-100 \"\n                              style={{\n                                marginTop: `${\n                                  index === 0 ? \"0.3rem\" : \"1.2rem\"\n                                }`,\n                              }}\n                            >\n                              <input\n                                className=\"preview-input-step-2  first-value  mt-2 \"\n                                type=\"number\"\n                                pattern=\"[0-9]+\"\n                                // maxlength=\"4\"\n                                value={item.value || \"\"}\n                                placeholder=\"Value\"\n                                name=\"value\"\n                                disabled={true}\n                                style={{\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n\n                              <p className=\"text-white mb-0 of-text\">Of</p>\n                              <input\n                                className=\"preview-input-step-2  first-value mt-2 \"\n                                type=\"number\"\n                                min=\"1\"\n                                max=\"5\"\n                                name=\"total\"\n                                placeholder=\"total\"\n                                disabled={true}\n                                // onInput=\"javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);\"\n                                value={item.total || \"\"}\n                                style={{\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\" text-center\" style={{ color: \"#A9A9A9\" }}>\n                      {\"No levels Found\"}\n                    </p>\n                  )}\n                </div>\n              </div>\n            )}\n\n            <div className=\"w-100 text-center\">\n              <p className=\"text-white\">{previewModalStep}/2</p>\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary preview-btn mt-4\"\n                onClick={() => handleNextStep()}\n              >\n                {previewModalStep === 1 ? \"Next\" : \"Deploy\"}\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nexport default PreviewModal;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.action.js",["300"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.actions.js",["301"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/gaTracker/gaTracket.js",["302"],{"ruleId":"303","severity":1,"message":"304","line":6,"column":8,"nodeType":"305","messageId":"306","endLine":6,"endColumn":17},{"ruleId":"307","severity":1,"message":"308","line":19,"column":6,"nodeType":"309","endLine":19,"endColumn":11,"suggestions":"310"},{"ruleId":"303","severity":1,"message":"311","line":2,"column":8,"nodeType":"305","messageId":"306","endLine":2,"endColumn":15},{"ruleId":"303","severity":1,"message":"312","line":4,"column":8,"nodeType":"305","messageId":"306","endLine":4,"endColumn":15},{"ruleId":"303","severity":1,"message":"313","line":5,"column":8,"nodeType":"305","messageId":"306","endLine":5,"endColumn":15},{"ruleId":"303","severity":1,"message":"314","line":1,"column":28,"nodeType":"305","messageId":"306","endLine":1,"endColumn":36},{"ruleId":"315","severity":1,"message":