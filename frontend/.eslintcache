lePath":"373","messages":"374","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"375","usedDeprecatedRules":"197"},{"filePath":"376","messages":"377","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"378","messages":"379","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"380","usedDeprecatedRules":"197"},{"filePath":"381","messages":"382","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"383","usedDeprecatedRules":"197"},{"filePath":"384","messages":"385","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"386","usedDeprecatedRules":"197"},{"filePath":"387","messages":"388","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"389","messages":"390","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"391","messages":"392","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"393","messages":"394","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"397","messages":"398","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"399","messages":"400","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"401","usedDeprecatedRules":"197"},{"filePath":"402","messages":"403","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"404","messages":"405","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"406","usedDeprecatedRules":"197"},{"filePath":"407","messages":"408","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"409","messages":"410","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"411","usedDeprecatedRules":"197"},{"filePath":"412","messages":"413","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"414","messages":"415","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"416","usedDeprecatedRules":"197"},{"filePath":"417","messages":"418","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"419","usedDeprecatedRules":"197"},{"filePath":"420","messages":"421","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"422","usedDeprecatedRules":"197"},{"filePath":"423","messages":"424","errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"425","usedDeprecatedRules":"197"},{"filePath":"426","messages":"427","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"428","messages":"429","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},{"filePath":"430","messages":"431","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"197"},"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/index.js",["432"],"import React from \"react\";\nimport ReactDOM from \"react-dom\";\nimport \"./index.css\";\nimport App from \"./App\";\nimport * as serviceWorker from \"./serviceWorker\";\nimport { BrowserRouter } from \"react-router-dom\";\nimport { Provider } from \"react-redux\";\nimport store from \"./store\";\nimport { toast, ToastContainer } from \"react-toastify\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport \"bootstrap/dist/css/bootstrap.min.css\";\nimport TimeAgo from \"javascript-time-ago\";\n\nimport en from \"javascript-time-ago/locale/en.json\";\n\nTimeAgo.addDefaultLocale(en);\n\nReactDOM.render(\n  <Provider store={store}>\n    <ToastContainer\n      position=\"top-right\"\n      pauseOnHover={true}\n      newestOnTop={true}\n      autoClose={3000}\n    />\n    <BrowserRouter>\n      <App />\n    </BrowserRouter>\n  </Provider>,\n  document.getElementById(\"root\")\n);\n\nserviceWorker.unregister();\n",["433","434"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/App.js",["435","436","437","438","439","440","441"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\nimport useGaTracker from \"./gaTracker/gaTracket\";\nimport { connect } from \"react-redux\";\nimport { useLocation } from \"react-router\";\n\nimport {\n  beforeWallet,\n  setWalletAddress,\n} from \"./components/wallet/wallet.action\";\n\nconst App = React.memo((props) => {\n  useGaTracker();\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const location = useLocation();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  useEffect(() => {\n    if (!window.ethereum) {\n      return toast.error(\"This app requires metamask,Please Install Metamask \");\n    }\n    const accountWasChanged = (accounts) => {\n      setWallet(accounts[0]);\n    };\n    const getAndSetAccount = async () => {\n      const changedAccounts = await window.ethereum.request({\n        method: \"eth_requestAccounts\",\n      });\n      if (changedAccounts.length === 0) {\n        toast.error(\"you are not connected with metamask\");\n      }\n      setWallet(changedAccounts[0]);\n    };\n    const clearAccount = () => {};\n    window.ethereum.on(\"accountsChanged\", accountWasChanged);\n    window.ethereum.on(\"connect\", getAndSetAccount);\n    // window.ethereum.on(\"disconnect\", ()=>alert(\"account cleared\"));\n    window.ethereum.request({ method: \"eth_requestAccounts\" }).then(\n      (accounts) => {\n        setWallet(accounts[0]);\n      },\n      (error) => {}\n    );\n    return () => {};\n  }, []);\n  const setWallet = (address) => {\n    props.beforeWallet();\n    props.setWalletAddress(address);\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={route.access}\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, {\n  setWalletAddress,\n  beforeWallet,\n})(App);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/serviceWorker.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/store.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/routes.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/privateRoute.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/config/config.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/utils/web3.js",["442"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/gaTracker/gaTracket.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/redux/index.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/wallet/wallet.js",["443","444","445","446","447","448"],"import React, { useState, useEffect } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport {\n  signRequest,\n  connectWithMetamask,\n  getChainId,\n  switchNetworkToChainId,\n} from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"../wallet/wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  beforeCategory,\n  beforeCollection,\n} from \"../collections/collections.actions\";\nimport { login, signup } from \"../user/user.action\";\n// import {setWalletAddress} from \"../../redux/shared/shared/shared.action\"\nimport { Images } from \"../../assets/assets\";\nimport \"./wallet.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport { getWalletAddress, validateNetwork } from \"../../utils/web3\";\nimport { ENV } from \"../../config/config\";\nconst Wallet = (props) => {\n  const history = useHistory();\n  let walletAddress = false;\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [disabled, setDisabled] = useState(false);\n  const [loader, setLoader] = useState(false);\n  useEffect(async () => {\n    let address = await getWalletAddress();\n    if (address) {\n      setConnectedAddress(address);\n    }\n    window.ethereum.on(\"disconnect\", () => setConnectedAddress(null));\n  }, []);\n\n  const connectMetamaskCall = async () => {\n    if (detectMobile() && !window.ethereum) {\n      window.open(\"https://metamask.app.link/dapp/mintsclub.io/\");\n    } else {\n      // if (await validateNetwork()) {\n      if (getChainId !== ENV.chainId) {\n        try {\n          await switchNetworkToChainId(ENV.chainId);\n        } catch (error) {\n          return toast.error(error.message);\n        }\n      }\n      let connectedAddress = false;\n      setDisabled(true);\n      if (detectMobile()) {\n        connectedAddress = await getWalletAddress();\n      } else {\n        connectedAddress = await connectWithMetamask();\n      }\n      if (connectedAddress) {\n        setDisabled(false);\n      }\n      setConnectedAddress(connectedAddress);\n      // } else {\n      //   toast.error(\n      //     \"Please Connect Your Metamask With Ethereum Rinkby Network\"\n      //   );\n      // }\n    }\n  };\n  const detectMobile = () => {\n    if (\n      /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(\n        navigator.userAgent\n      )\n    ) {\n      return true;\n    } else {\n      return false;\n    }\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setDisabled(false);\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.collection.getAuth && ENV.getUserKeys(\"_id\")?._id) {\n      props.beforeCollection();\n      toast.success(\"User logged in successfully\");\n      history.push(\"/\");\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    e.preventDefault();\n    if (getChainId !== ENV.chainId) {\n      try {\n        let newAcc = await switchNetworkToChainId(ENV.chainId);\n        props.setWalletAddress(newAcc);\n        setConnectedAddress(newAcc);\n      } catch (error) {\n        return toast.error(error.message);\n      }\n    }\n    setDisabled(true);\n    try {\n      if (validator.isEmail(email)) {\n        await signRequest();\n        let payload = {\n          address: connectedAddress,\n          email: email,\n          username: username,\n          isApproved: false,\n        };\n        props.signup(payload);\n      } else {\n        setErrorMessage(\"please enter valid email\");\n      }\n    } catch (err) {\n      toast.error(err.message);\n      setDisabled(false);\n    }\n  };\n\n  const login = async () => {\n    if (getChainId !== ENV.chainId) {\n      try {\n        let newAcc = await switchNetworkToChainId(ENV.chainId);\n        props.setWalletAddress(newAcc);\n        setConnectedAddress(newAcc);\n      } catch (error) {}\n    }\n    try {\n      setDisabled(true);\n      setLoader(true);\n      await signRequest();\n      let payload = {\n        address: connectedAddress,\n      };\n      props.setWalletAddress(connectedAddress);\n\n      props.login(payload);\n    } catch (err) {\n      setDisabled(false);\n      setLoader(false);\n      toast.error(err.message);\n    }\n    // } else {\n    //   toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    // }\n  };\n\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address) {\n        walletAddress = address;\n        setShowSignUpComponent(false);\n        setShowSignUp(false);\n        setErrorMessage(false);\n        setConnectedAddress(address);\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n    }\n  };\n\n  const signInbannerData = {\n    subHeading: \"Login\",\n    heading: \"Login Information\",\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div>\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n            <div className=\"padding-wrapper\">\n              <div className=\"container\">\n                <div className=\"row justify-content-center\">\n                  <div className=\"col-12 col-md-8 col-lg-7\">\n                    {/* Intro */}\n                    <div className=\"intro wallet-intro  text-center\">\n                      <span>Sign in</span>\n                      <h3 className=\"mt-3 mb-0\">Sign in to your account</h3>\n                      <p className=\"mt-3\">\n                        Please Click to Sign in your Account.\n                      </p>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"row justify-content-center items mb-5\">\n                  <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                    <div className=\"sign-in-card\">\n                      <span\n                        className=\"sign-content-wrapper text-center\"\n                        href=\"/login\"\n                      >\n                        <h4 className=\"mb-0\">Address</h4>\n                        <p className=\"mt-4\">{connectedAddress}</p>\n                        {errorMessage && (\n                          <p className=\"text-danger\">{errorMessage}</p>\n                        )}\n                        {!showSignUp && (\n                          <>\n                            <button\n                              className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4\"\n                              type=\"button\"\n                              disabled={disabled || loader}\n                              onClick={() => login()}\n                            >\n                              {loader ? (\n                                <div className=\"text-center\">\n                                  <div\n                                    className=\"spinner-border sign-in-spinner text-white\"\n                                    role=\"status\"\n                                  >\n                                    <span className=\"sr-only\">Loading...</span>\n                                  </div>\n                                </div>\n                              ) : (\n                                \"Sign in\"\n                              )}\n                            </button>\n                          </>\n                        )}\n\n                        {showSignUp && (\n                          <button\n                            className=\"btn btn-linear-gradient btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                            type=\"button\"\n                            onClick={() => history.push(\"/signup\")}\n                          >\n                            Would you like to Signup?\n                          </button>\n                        )}\n                      </span>\n                    </div>\n                    <button\n                      className=\"change-wallet-btn mt-5 d-flex mx-auto\"\n                      onClick={() => setConnectedAddress(null)}\n                    >\n                      Change Wallet Address\n                    </button>\n\n                    <span className=\"new-member mt-5 d-flex justify-content-center\">\n                      New Member?\n                      {!detectMobile() ? (\n                        <a className=\"register-member mx-1\" href={\"/signup\"}>\n                          {\" \"}\n                          Register\n                        </a>\n                      ) : (\n                        <a\n                          className=\"register-member mx-1\"\n                          onClick={() =>\n                            window.open(\n                              \"https://metamask.app.link/dapp/mintsclub-v2-marketplace.invo.zone/signup\"\n                            )\n                          }\n                        >\n                          {\" \"}\n                          Register\n                        </a>\n                      )}\n                      here.\n                    </span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n\n            <div className=\"container\">\n              <div className=\"row justify-content-center\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  {/* Intro */}\n                  <div className=\"intro text-center\">\n                    <span>SIGNUP</span>\n                    <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                    <p className=\"text-gray\">\n                      Create the account with the address\n                    </p>\n                  </div>\n                  {/* Item Form */}\n                  <form\n                    className=\"item-form card no-hover signup-card\"\n                    onSubmit={(e) => signup(e)}\n                  >\n                    <div className=\"row\">\n                      {errorMessage && (\n                        <p className=\"text-center text-gray\">{errorMessage}</p>\n                      )}\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control sign-up-input\"\n                            name=\"address\"\n                            placeholder=\"Address\"\n                            required=\"required\"\n                            disabled={true}\n                            value={connectedAddress}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"email\"\n                            className=\"form-control sign-up-input\"\n                            name=\"email\"\n                            placeholder=\"Enter your Email\"\n                            required=\"required\"\n                            defaultValue={email}\n                            onChange={(e) => setEmail(e.target.value)}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control sign-up-input\"\n                            name=\"username\"\n                            placeholder=\"Enter your Username\"\n                            required=\"required\"\n                            defaultValue={username}\n                            onChange={(e) => setUsername(e.target.value)}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3 text-center\">\n                          <div className=\"form-check form-check-inline\">\n                            <input\n                              className=\"form-check-input\"\n                              type=\"radio\"\n                              name=\"inlineRadioOptions\"\n                              id=\"inlineRadio1\"\n                              defaultValue=\"option1\"\n                              autoComplete=\"off\"\n                            />\n                            <label\n                              className=\"form-check-label text-center text-gray\"\n                              htmlFor=\"inlineRadio1\"\n                            >\n                              I agree to{\" \"}\n                              <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"text-center\">\n                          <button\n                            className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4  text-white \"\n                            type=\"submit\"\n                            disabled={disabled}\n                          >\n                            Sign Up\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </form>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n            <div className=\"padding-wrapper\">\n              <div className=\"container mb-5\">\n                <div className=\"row justify-content-center\">\n                  <div className=\"col-12 col-md-8 col-lg-7\">\n                    <div className=\"intro wallet-intro text-center\">\n                      <span>Wallet Connect</span>\n                      <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                      {/* <p className=\" mt-3\">\n                        Please select the wallet you want to connect to.\n                      </p> */}\n                    </div>\n                  </div>\n                </div>\n                <div\n                  className=\"connect-metamask-container text-center mx-auto\"\n                  onClick={() => connectMetamaskCall()}\n                >\n                  <img\n                    className=\"avatar-lg mt-4\"\n                    src={Images.metamaskImg}\n                    alt=\"\"\n                  />\n                  <p className=\"metamask-title mt-2\">Metamask</p>\n                  <p className=\"metamask-desc px-sm-0 px-3\">\n                    A browser extension with great flexibility.\n                    <br className=\"d-none d-sm-block\" /> The web's most popular\n                    wallet\n                  </p>\n                </div>\n\n                <span className=\"new-member d-block text-center mt-5\">\n                  Don't have Metamask ? Click\n                  <span\n                    className=\"register-member mx-1\"\n                    onClick={() => window.open(\"https://metamask.io/download/\")}\n                  >\n                    {\" \"}\n                    Here{\" \"}\n                  </span>\n                  to Install.\n                </span>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n  beforeCollection,\n})(Wallet);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/home/home.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["449","450","451","452","453","454","455","456"],"import React, { useState, useEffect, forwardRef, useImperativeHandle } from 'react';\nimport CollectionsCard from '../collections-cards/CollectionsCard';\nimport { connect } from 'react-redux';\nimport { ENV } from '../../config/config';\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories\n} from '../collections/collections.actions';\nimport FullPageLoader from '../full-page-loader/full-page-loader';\nimport { Images } from '../../assets/assets';\nimport Banner from '../banner/banner';\nimport BannerBg from '../../assets/images/hero-bg.png';\nimport BannerImage from '../../assets/images/bannerimg.png';\nimport OwnCollectionToday from '../own-collection-today/own-collection-today';\n\nconst Populars = forwardRef((props, ref) => {\n  const [popular, setpopular] = useState([]);\n  const [isActive, setIsActive] = useState('All');\n  const [collections, setCollections] = useState(null);\n  const [categoryId, setCategoryId] = useState('all');\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(12);\n  const [selectedCategory, setSelectedCategory] = useState('all');\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getPopularCollections(null, 1);\n    const qs = ENV.objectToQueryString({\n      myFilter: 'all'\n    });\n\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      const pagination = props.popularCollections.pagination;\n\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image ? element.nfts?.length : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n\n      setPagination(pagination);\n      const userId = ENV.getUserKeys('_id')._id;\n      if (props.finalCollectionListing) {\n        let finalCollectionListing = finalCollectionListing.filter((item) => item.userId === userId);\n        setpopular(finalCollectionListing);\n      } else {\n        if (finalCollectionListing === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setpopular(finalCollectionListing);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.getPopularAuth]);\n\n  const getPopularCollections = (category, page, pageLimit) => {\n    const filter = {\n      page\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 12;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getPopularCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getPopularCollections(catId, page);\n    },\n    colCount: collections?.length || 0\n  }));\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    setPage(page);\n    setLimit(limit + 12);\n    getPopularCollections(selectedCategory, page, limit + 12);\n  };\n\n  const handleFilterCategory = (category) => {\n    setCategoryId(category);\n    setLoader(true);\n    setPage(1);\n    setLimit(12);\n    getPopularCollections(category, 1, 12);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === 'image');\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n  const bannerData = {\n    subHeading: 'Collections',\n    heading: 'Popular Collections',\n    content:\n      ' Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.'\n  };\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          {' '}\n          <section className='explore-collection-section padding-wrapper'>\n            <div className='container'>\n              <div className='row mb-5'>\n                <div className='col-12 explore-collection-nav'>\n                  <div className='d-none d-xxl-flex justify-content-lg-end text-end align-items-center'>\n                    {categoryId === 'all' && popular && popular?.length == 0 && !loader\n                      ? ''\n                      : categories &&\n                        categories.length > 0 &&\n                        categories.map((item, index) => {\n                          return (\n                            <button\n                              onClick={() => {\n                                setIsActive(item.name);\n                                setSelectedCategory(item.description);\n                                handleFilterCategory(item.description);\n                              }}\n                              key={index}\n                              className={`${item.name === isActive ? 'active-explore-nav' : ''} me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          );\n                        })}\n                  </div>\n                  <div className='row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none'>\n                    {categoryId === 'all' && popular && popular?.length == 0 && !loader\n                      ? ''\n                      : categories &&\n                        categories.length > 0 &&\n                        categories.map((item, index) => {\n                          return (\n                            <div className='col-6 col-sm-3' key={index}>\n                              <button\n                                onClick={() => {\n                                  setIsActive(item.name);\n                                  setSelectedCategory(item.description);\n                                  handleFilterCategory(item.description);\n                                }}\n                                className={isActive === item.name ? 'active-explore-nav' : ''}\n                              >\n                                {item.name}\n                              </button>\n                            </div>\n                          );\n                        })}\n                  </div>\n                </div>\n              </div>\n              <div className='row g-1 align-items-center'>\n                {loader ? (\n                  <div className='d-flex align-items-center justify-content-center'>\n                    <div class='spinner-border' role='status'>\n                      <span class='sr-only'>Loading...</span>\n                    </div>\n                  </div>\n                ) : popular && popular.length > 0 ? (\n                  popular.map((item, index) => {\n                    return (\n                      <div className='col-sm-6 col-lg-4 col-xl-3' key={index}>\n                        <CollectionsCard\n                          CardImg={item.featuredImg}\n                          Subimg1={handleImage(item, 0)}\n                          Subimg2={handleImage(item, 1)}\n                          Subimg3={handleImage(item, 2)}\n                          name={item.name}\n                          id={item._id}\n                          collection={item}\n                          userName={item.username[0]}\n                          NFTCount={item.totalNfts}\n                          profileImage={item.profileImage[0]}\n                          ownerAddress={item.ownerAddress}\n                          connectedAddress={props.connectedAddress}\n                        />\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className='text-center  not-found-title mt-5'>No Popular Collections Found</p>\n                )}\n\n                <div className='col-12'>\n                  <div className='mt-5 text-center'>\n                    {!empty && popular?.length === 12 && pagination.totalRecords > popular.length && (\n                      <button className='btn btn-rounded-bordered px-5' onClick={() => handlePagination()}>\n                        Load more...\n                      </button>\n                    )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n        </>\n      )}\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n  connectedAddress: state.wallet.connectedAddress\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforePopularCollection,\n    getPopularCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/signup/signup.js",["457","458","459"],"import React, { useEffect, useState } from \"react\";\r\nimport { useHistory } from \"react-router\";\r\nimport Banner from \"../banner/banner\";\r\nimport BannerBg from \"../../assets/images/hero-bg.png\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\r\nimport { toast } from \"react-toastify\";\r\nimport { signup } from \"../user/user.action\";\r\nimport \"./signup.css\";\r\n\r\nconst SignUp = (props) => {\r\n  const [checkBox, setCheckBox] = useState(false);\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [username, setUsername] = useState(\"\");\r\n  const [loader, setLoader] = useState(false);\r\n\r\n  const history = useHistory();\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n     setConnectedAddress(connectedAddress);\r\n  }, []);\r\n  \r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.error?.message) {\r\n      toast.error(props.error.message);\r\n      setLoader(false);\r\n    }\r\n  }, [props.error]);\r\n  useEffect(() => {\r\n    if (props.userAuth) {\r\n      toast.success(\"Signed up successfully\");\r\n      history.push(\"/\");\r\n    }\r\n  }, [props.userAuth]);\r\n\r\n  const signup = async (e) => {\r\n    e.preventDefault();\r\n    try {\r\n      setLoader(true);\r\n      let sign = await signRequest();\r\n      let payload = {\r\n        address: connectedAddress,\r\n        email: email,\r\n        username: username,\r\n        isApproved: false,\r\n      };\r\n      props.signup(payload);\r\n    } catch (err) {\r\n      setLoader(false);\r\n      toast.error(err.message);\r\n    }\r\n  };\r\n\r\n  const signInbannerData = {\r\n    subHeading: \"Sign Up\",\r\n    heading: \"Create an Account\",\r\n    content:\r\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <Banner\r\n        subHeading={signInbannerData.subHeading}\r\n        heading={signInbannerData.heading}\r\n        content={signInbannerData.content}\r\n        bgImg={BannerBg}\r\n      />\r\n      <section className=\"signup-section padding-wrapper mb-5\">\r\n        <div className=\"container\">\r\n          <form onSubmit={signup}>\r\n            <div className=\"row\">\r\n              <div className=\"signup-title\">\r\n                <p className=\"create-acc mt-5\">Create Account</p>\r\n                <p className=\"acc-info\">\r\n                  There’s no account linked to the address, Please SingUp first.\r\n                </p>\r\n              </div>\r\n              <div className=\"col-12 mt-5\">\r\n                <label className=\"label-common\">Address:*</label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  id=\"url\"\r\n                  type=\"text\"\r\n                  name=\"url\"\r\n                  placeholder={connectedAddress}\r\n                  readOnly\r\n                />\r\n              </div>\r\n              <div className=\"col-md-6 col-sm-12 mt-5\">\r\n                <label className=\"label-common \">\r\n                  Enter your email address:*\r\n                </label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  type=\"email\"\r\n                  name=\"email\"\r\n                  placeholder=\"Enter your Email\"\r\n                  required\r\n                  defaultValue={email}\r\n                  onChange={(e) => setEmail(e.target.value)}\r\n                  maxLength=\"55\"\r\n                  autoComplete=\"off\"\r\n                />\r\n              </div>\r\n              <div className=\"col-md-6 col-sm-12 mt-5\">\r\n                <label className=\"label-common\">Enter your username:*</label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  type=\"text\"\r\n                  name=\"username\"\r\n                  maxLength=\"55\"\r\n                  placeholder=\"Enter your Username\"\r\n                  required\r\n                  defaultValue={username}\r\n                  onChange={(e) => setUsername(e.target.value)}\r\n                  autoComplete=\"off\"\r\n                />\r\n              </div>\r\n              <div>\r\n                <div className=\"checkbox-container d-flex align-items-center mt-5\">\r\n                  {checkBox ? (\r\n                    <span\r\n                      className=\"custom-checked-box me-2\"\r\n                      onClick={() => setCheckBox(!checkBox)}\r\n                    >\r\n                      <svg\r\n                        xmlns=\"http://www.w3.org/2000/svg\"\r\n                        width=\"13\"\r\n                        height=\"10\"\r\n                      >\r\n                        <path\r\n                          fill-rule=\"evenodd\"\r\n                          fill=\"#FFF\"\r\n                          d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\r\n                        />\r\n                      </svg>\r\n                    </span>\r\n                  ) : (\r\n                    <span\r\n                      className=\"custom-uncheck-box me-2\"\r\n                      onClick={() => setCheckBox(!checkBox)}\r\n                    ></span>\r\n                  )}\r\n                  <p>\r\n                    By checking this box, I agree to MintsClub{\" \"}\r\n                    <Link to=\"/termsandconditions\" target=\"_blank\">{\"Terms & Conditions\" }</Link>\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <button\r\n              disabled={\r\n                !checkBox || email.trim() === \"\" || username.trim() === \"\"\r\n              }\r\n              type=\"submit\"\r\n              className=\"btn btn-linear-gradient sign-up-btn mt-5\"\r\n            >\r\n              {loader ? (\r\n                <div className=\"text-center\">\r\n                  <div\r\n                    className=\"spinner-border text-white sign-up-loader\"\r\n                    role=\"status\"\r\n                  >\r\n                    <span className=\"sr-only\">Loading...</span>\r\n                  </div>\r\n                </div>\r\n              ) : (\r\n                \"Sign Up\"\r\n              )}\r\n            </button>\r\n          </form>\r\n        </div>\r\n      </section>\r\n    </>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => (\r\n  {\r\n    wallet: state.wallet,\r\n    collection: state.collection,\r\n    user: state.user,\r\n    userAuth: state.user.userAuth,\r\n    error: state.error,\r\n  }\r\n);\r\n\r\nexport default connect(mapStateToProps, {\r\n  signup,\r\n})(SignUp);\r\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/create-nft/create-nft.js",["460","461","462","463","464"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["465","466","467","468","469","470","471","472","473","474","475","476","477","478","479","480","481","482","483"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/collections/explore-collections.js",["484","485","486","487"],"import React, { useState, useEffect, forwardRef, useImperativeHandle } from 'react';\nimport './explore-collections.css';\nimport CollectionsCard from '../collections-cards/CollectionsCard';\nimport { connect } from 'react-redux';\nimport { ENV } from '../../config/config';\nimport { beforeCollection, getCollections, toggleLikeDislike } from './collections.actions';\nimport { Images } from '../../assets/assets';\n\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { beforeCategory, getCategories } from './collections.actions';\nimport OwnCollectionToday from '../own-collection-today/own-collection-today';\nimport Banner from '../banner/banner';\nimport BannerBg from '../../assets/images/hero-bg.png';\nimport BannerImage from '../../assets/images/bannerimg.png';\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState('All');\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(12);\n  const [selectedCategory, setSelectedCategory] = useState('');\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      const userId = ENV.getUserKeys('_id')._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter((item) => item.userId === userId);\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 12;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0\n  }));\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    setPage(page);\n    setLimit(limit + 12);\n    getCollections(selectedCategory, page, limit + 12);\n  };\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(12);\n    getCollections(category, 1, 12);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter((nft) => nft.fileType === 'image');\n      if (result.length >= index && result.length !== 0) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  const bannerData = {\n    subHeading: 'Collections',\n    heading: 'Explore all',\n    content:\n      ' Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.'\n  };\n  return (\n    <>\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className='explore-collection-section padding-wrapper pt-0'>\n          <Banner\n            subHeading={bannerData.subHeading}\n            heading={bannerData.heading}\n            content={bannerData.content}\n            bgImg={BannerBg}\n            bannerImg={BannerImage}\n          />\n          <div className='container'>\n            <div className='row mb-5'>\n              <div className='col-12 explore-collection-nav'>\n                <div className='d-none d-xxl-flex justify-content-lg-end text-end align-items-center'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, index) => {\n                      return (\n                        <button\n                          key={index}\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${item.name === isActive ? 'active-explore-nav' : ''} me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className='row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, index) => {\n                      return (\n                        <div className='col-6 col-sm-3' key={index}>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={isActive === item.name ? 'active-explore-nav' : ''}\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className='row g-1 align-items-center'>\n              {loader ? (\n                <div className='d-flex align-items-center justify-content-center'>\n                  <div className='spinner-border mx-auto' role='status'>\n                    <span className='sr-only'>Loading...</span>\n                  </div>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection, index) => {\n                  return (\n                    <div className='col-sm-6 col-md-4 col-xl-3' key={index}>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={collection?.username[0] ? collection.username[0] : ''}\n                        NFTCount={collection.nftDetail[0].image ? collection.nftDetail?.length : 0}\n                        profileImage={collection?.profileImage[0]}\n                        ownerAddress={collection?.ownerAddress}\n                        connectedAddress={props.connectedAddress}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className='text-center not-found-title mt-5'>No Collections found</p>\n              )}\n              <div className='col-12'>\n                <div className='mt-5 d-flex justify-content-center align-items-center'>\n                  {!empty && collections?.length === 12 && !loader && pagination.totalRecords > collections.length && (\n                    <button className='btn btn-rounded-bordered px-5' onClick={() => handlePagination()}>\n                      Load more...\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n          <OwnCollectionToday />\n        </section>\n      )}\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  connectedAddress: state.wallet.connectedAddress\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["488","489","490","491","492","493"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["494","495","496","497","498","499","500","501","502","503"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["504","505","506","507","508","509","510","511","512","513","514","515","516","517","518","519","520","521","522","523","524","525","526","527","528","529","530","531","532","533","534","535","536","537","538"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["539","540","541","542","543","544","545","546","547","548","549","550"],"import React, { useEffect, useState } from \"react\";\n\nimport \"./user-edit-profile.css\";\n\n/////////\n\nimport { connect } from \"react-redux\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { ENV } from \"./../../config/config\";\nimport { Images } from \"../../assets/assets\";\nimport { useHistory } from \"react-router-dom\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport Compressor from \"compressorjs\";\nimport axios from \"axios\";\nconst EditProfile = (props) => {\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n\n  useEffect(() => {\n    if (props.error !== null) {\n      setLoader(false);\n      toast.error(props.error.messasge);\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      props.beforeUser();\n      setLoader(false);\n\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      console.log(profileImage);\n      if (profileImage) {\n        setImage(null);\n      } else {\n        setImage(profileImage ? profileImage : \"\");\n      }\n\n      setBannerImage(bannerImage ? bannerImage : \"\");\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      setLoader(false);\n      props.beforeUser();\n      toast.success(\"Profile updated successfully\");\n      history.push(\"/userprofile\");\n    }\n  }, [props.user.userAuth]);\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    let sizeBeforeCompress = formatBytes(file.size);\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n        return toast.error(\"Invalid File\");\n      }\n      setImageUrl(fileURL);\n      // setImage(file);\n\n      new Compressor(file, {\n        quality: 0.2,\n        success(result) {\n          setImage(result);\n\n          let sizeAfterCompress = formatBytes(result.size);\n        },\n        error(err) {\n          console.log(err.message);\n        },\n      });\n    }\n  };\n  const formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    setErrors(\"\");\n    setLoader(true);\n    // let signature = await signRequest();\n    setLoader(true);\n\n    var formData = new FormData();\n    formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n    if (image) {\n      let result = await uploadFileToIpfs(image);\n      let url = `https://mintsclub.mypinata.cloud/ipfs/${result.data.IpfsHash}`;\n      formData.append(\"profileImage\", url);\n    } else {\n      formData.append(\"profileImage\", imageUrl);\n    }\n    if (banner) {\n      formData.append(\"bannerImage\", banner);\n    }\n    formData.append(\"bio\", description);\n    formData.append(\"twitterLink\", twitterLink);\n    formData.append(\"username\", username);\n    formData.append(\"email\", email);\n    formData.append(\"webLink\", webLink);\n    formData.append(\"instaLink\", instaLink);\n\n    // return ''\n    props.updateProfile(formData);\n  };\n  const uploadFileToIpfs = async (file) => {\n    var data = new FormData();\n    data.append(\"file\", file);\n    try {\n      const url = `https://api.pinata.cloud/pinning/pinFileToIPFS`;\n      const response = await axios.post(url, data, {\n        headers: {\n          \"Content-Type\": `multipart/form-data; boundary= ${data._boundary}`,\n          Authorization: `Bearer ${ENV.pinataJWT}`,\n          // pinata_api_key: `${process.env.REACT_APP_PINATA_API_KEY}`,\n          // pinata_secret_api_key: `${process.env.REACT_APP_PINATA_API_SECRET}`,\n        },\n      });\n      return response;\n    } catch (err) {\n      toast.error(err);\n      this.setState({ loader: false });\n    }\n  };\n  const bannerData = {\n    subHeading: \"Information\",\n    heading: \"User Profile\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile padding-wrapper pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        {loader && <FullPageLoader />}\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <form onSubmit={submit}>\n              <div className=\"row\">\n                <div className=\"col-12 mt-5\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {imageUrl && imageUrl ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={imageUrl ? imageUrl : Images.logoImage}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={imageUrl ? imageUrl : Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">\n                      Profile Image*\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Username:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    required\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && username === \"\") {\n                        return false;\n                      } else {\n                        setUsername(e.target.value);\n                      }\n                    }}\n                    value={username}\n                    placeholder=\"Username\"\n                    maxLength=\"55\"\n                    minLength=\"3\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">\n                    Email Address:*\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Email Address\"\n                    required\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && email === \"\") {\n                        return \"\";\n                      } else {\n                        setEmail(e.target.value);\n                      }\n                    }}\n                    value={email}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Wallet Address:\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder={address}\n                    required\n                    readOnly={true}\n                    autoComplete=\"off\"\n                    // value={address}\n                    disabled={true}\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">BioData:</label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Enter BioData\"\n                    maxLength=\"500\"\n                    minLength=\"3\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && description === \"\") {\n                        return false;\n                      } else {\n                        setDescription(e.target.value);\n                      }\n                    }}\n                    value={description}\n                  ></textarea>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Twitter Link:\n                  </label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && twitterLink === \"\") {\n                        return false;\n                      } else {\n                        setTwitterLink(e.target.value);\n                      }\n                    }}\n                    value={twitterLink}\n                    placeholder=\"Twitter Link\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0  mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Instagram Link:\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Instagram Link\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && instaLink === \"\") {\n                        return false;\n                      } else {\n                        setInstaLink(e.target.value);\n                      }\n                    }}\n                    value={instaLink}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0  mt-3 mt-lg-5 \">\n                  <label className=\"create-collection-label\">\n                    Website Link:\n                  </label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Website Link\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && webLink === \"\") {\n                        return false;\n                      } else {\n                        setWebLink(e.target.value);\n                      }\n                    }}\n                    value={webLink}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    type=\"submit\"\n                  >\n                    Save Changes\n                  </button>\n                </div>\n              </div>\n            </form>\n          </div>\n        </div>\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n  emptyError,\n})(EditProfile);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["551","552","553"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card top-seller-card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller text-capitalize mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["554","555","556","557"],"import React, { useState, useEffect } from \"react\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport { connect } from \"react-redux\";\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\nimport { getCreators } from \"./../user/user.action\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst AuctionsList = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [auctions, setAuctions] = useState(null);\n  const [loader, setLoader] = useState(true); // auctions loader\n  const [categories, setCategories] = useState([]);\n  const [categoryId, setCategoryId] = useState(\"all\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    // get live auctions\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n    props.getCreators();\n  }, []);\n\n  // set live auctions\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions } = props.auction;\n      if (auctions) {\n        auctions.forEach((element, i) => {\n          auctions[i].totalBids = element.bidInfo?.bidBy?.length;\n        });\n      }\n\n      setAuctions(auctions);\n      setLoader(false);\n      props.beforeAuction();\n    }\n  }, [props.auction.auctionsAuth]);\n\n  useEffect(() => {\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collectionFlag) {\n      setCategories(props.categories);\n    }\n  }, [props.collectionFlag]);\n\n  const handleCategoryFilter = (desc) => {\n    setLoader(true);\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getLiveAuctions(qs);\n  };\n  const bannerData = {\n    subHeading: \"Auctions\",\n    heading: \"Live Auctions\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n\n      <section className=\"explore-collection-section home-auction-list padding-wrapper\">\n        {\n          // loader ? (\n          //   <FullPageLoader />\n          // ) : (\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                            key={id}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <div className=\"col-6 col-sm-3\" key={id}>\n                            <button\n                              onClick={() => {\n                                setIsActive(id);\n                                handleCategoryFilter(item.description);\n                              }}\n                              className={`${\n                                id === isActive ? \"active-explore-nav\" : \"\"\n                              } me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          </div>\n                        );\n                      })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-3 align-items-center\">\n              {loader ? (\n                <div className=\"d-flex justify-content-center\">\n                  <div className=\"spinner-border\" role=\"status\"></div>\n                </div>\n              ) : auctions && auctions.length > 0 ? (\n                auctions.map((item, index) => {\n                  return (\n                    <div className=\"col-sm-6 col-md-4 col-xl-3\" key={index}>\n                      <AuctionsCards\n                        key={index}\n                        item={item}\n                        ownerName={item.owner.username}\n                        userId={ENV.getUserKeys(\"_id\")._id}\n                        ownerId={item.owner._id}\n                        bidsProfile={item.bidInfo.bidByProfile}\n                        index={index}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center mt-5\">No Live Auctions Found</p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {auctions &&\n                    props.auction.pagination.total > auctions.length &&\n                    auctions.length > 10 && (\n                      <button className=\"btn btn-linear-gradient px-5\">\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        }\n        <OwnCollectionToday />\n      </section>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  auction: state.auction,\n  user: state.user,\n  collectionFlag: state.collection.collectionFlag,\n  categories: state.collection.categories,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n  getCreators,\n  getCategories,\n  beforeCategory,\n})(AuctionsList);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/aboutus/aboutus.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/faqs/faqs.js",["558","559"],"import React, { useEffect } from \"react\";\nimport \"./faqs.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport { Accordion, Card } from \"react-bootstrap\";\n\nconst bannerData = {\n  subHeading: \"Ask\",\n  heading: \"FAQ\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nconst faqsData = [\n  {\n    question: \"What is MintsClub?\",\n    ans: \"MintsClub is a revolutionary 21st Century blockchain product that brings users one step closer to experiencing Metaverse. The users can mint their digital assets such as images, GIFs, games, sports accessories and more into the cryptomarket and establish a stable revenue stream.\",\n  },\n  {\n    question: \"What is a MintsClub token?\",\n    ans: \"MintsClub token, famously known as Non-fungible Token (NFT) is a distinct cryptographic token that exists on the blockchain platform and cannot be replicated. Tokenization of digital assets has made it easier to buy and sell while reducing the threat of fraudulent acts.\",\n  },\n  {\n    question: \"What is the total supply of MINT?\",\n    ans: \"The total supply of 1-inch Mint tokens is 1.5 billion.\",\n  },\n  {\n    question: \"Where can I buy/sell MINT?\",\n    ans: \"You can sell your NFTs on blockchain marketplaces such as Binance, Cardano, Solana and Algoran and now, MintsClub.\",\n  },\n];\n\nconst Faqs = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper faqs\">\n        <div className=\"container\">\n          <div className=\"row align-items-center justify-content-center\">\n            <div className=\"col-12\">\n              <div\n                className=\"faqs-accordion accordion accordion-flush mx-auto\"\n                id=\"accordionFlushExample\"\n              >\n                {faqsData.map((faq, id) => {\n                  return (\n                    <div className=\"accordion-item mb-4\">\n                      <h2 className=\"accordion-header\" id={`${id}`}>\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target={`#c${id}`}\n                          aria-expanded=\"false\"\n                          aria-controls={`c${id}`}\n                        >\n                          <span>Q{`${id + 1}.`}</span>\n                          {faq.question}\n                        </button>\n                      </h2>\n                      <div\n                        id={`c${id}`}\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby={`${id}`}\n                      >\n                        <div className=\"accordion-body\">\n                          <p>{faq.ans}</p>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Faqs;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["560","561","562","563","564","565","566","567","568","569","570"],"import React, { Component } from \"react\";\nimport Footer from \"../footer/footer\";\nimport \"./CreateCollections.css\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport Select from \"react-select\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport axios from \"axios\";\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        ownerAddress: this.props.connectedAddress,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        logoUrl: \"\",\n        bannerUrl: \"\",\n        featuredImgUrl: \"\",\n        description: \"\",\n      },\n      categories: null,\n      selectedCategory: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate(prevProps) {\n    const { connectedAddress } = this.props;\n\n    if (\n      prevProps.connectedAddress !== \"\" &&\n      prevProps.connectedAddress.toUpperCase() !==\n        connectedAddress.toUpperCase() &&\n      connectedAddress !== \"\"\n    ) {\n      toast.info(\"Please login with new connected account\");\n      return this.props.history.push(\"/login\");\n    }\n    if (prevProps.connectedAddress === \"\" && connectedAddress) {\n      let { collection } = this.state;\n      collection = { ...collection, ownerAddress: connectedAddress };\n      this.setState({\n        collection,\n      });\n    }\n    if (this.props.error !== null && prevProps.error === null) {\n      toast.error(this.props.error.message);\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      let updatedCategories = [];\n      for (var item of categories) {\n        let obj = {\n          value: item._id,\n          label: item.name,\n        };\n        updatedCategories.push(obj);\n      }\n      this.setState({ categories: updatedCategories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let fileSize = this.formatBytes(file.size).split(\" \");\n        if (\n          (+fileSize[0] > 100 && fileSize[1] === \"MB\") ||\n          fileSize[1] === \"GB\"\n        ) {\n          return toast.error(\"File Max Limit Reached.\");\n        }\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n              var formData = new FormData();\n              for (var val in collection) {\n                if (val === \"logo\" || val === \"featuredImg\") {\n                  let result = await this.uploadFileToIpfs(collection[val]);\n                  let url = `https://mintsclub.mypinata.cloud/ipfs/${result.data.IpfsHash}`;\n                  formData.append(val, url);\n                }\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  uploadFileToIpfs = async (file) => {\n    var data = new FormData();\n    data.append(\"file\", file);\n    try {\n      const url = `https://api.pinata.cloud/pinning/pinFileToIPFS`;\n      const response = await axios.post(url, data, {\n        headers: {\n          \"Content-Type\": `multipart/form-data; boundary= ${data._boundary}`,\n          Authorization: `Bearer ${ENV.pinataJWT}`,\n          // pinata_api_key: `${process.env.REACT_APP_PINATA_API_KEY}`,\n          // pinata_secret_api_key: `${process.env.REACT_APP_PINATA_API_SECRET}`,\n        },\n      });\n      return response;\n    } catch (err) {\n      toast.error(err);\n      this.setState({ loader: false });\n    }\n  };\n  handleSelectChange = (selectedOption) => {\n    let { collection } = this.state;\n    collection = { ...collection, categoryId: selectedOption.value };\n    this.setState({\n      selectedOption,\n      collection,\n    });\n  };\n  handleValidation = () => {\n    const { categoryId, logo, name, description, featuredImg } =\n      this.state.collection;\n    if (\n      description === \"\" ||\n      logo === \"\" ||\n      categoryId === \"\" ||\n      name === \"\" ||\n      featuredImg === \"\"\n    ) {\n      return true;\n    } else {\n      return false;\n    }\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: \"\", featuredImgUrl: \"\" };\n    this.setState({ collection });\n  };\n\n  render() {\n    const {\n      collection,\n      errors,\n      loader,\n      isSubmitted,\n      categories,\n      selectedOption,\n    } = this.state;\n\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      const bannerData = {\n        subHeading: \"Create New\",\n        heading: \"Create New Collection\",\n        content:\n          \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n      };\n      //create collection max size validation\n      return (\n        <>\n          {loader && <FullPageLoader />}\n          <section className=\"create-collection\">\n            <Banner\n              subHeading={bannerData.subHeading}\n              heading={bannerData.heading}\n              content={bannerData.content}\n              bgImg={BannerBg}\n              bannerImg={BannerImage}\n            />\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"upload-container flex-md-row flex-column align-items-center align-items-md-end ps-md-5 ps-0\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {collection && collection.logo ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={collection.logoUrl}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => this.onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => this.onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">Logo Image*</p>\n                  </div>\n                  <div className=\"feature-wrapper pt-md-0 pt-5\">\n                    <div className=\"feature-image\">\n                      <span className=\"feature-img-round\">\n                        {collection && collection.featuredImg ? (\n                          <img\n                            className=\"uploaded-feature-img\"\n                            src={collection.featuredImgUrl}\n                          />\n                        ) : (\n                          <label className=\"upload-icon\">\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                            <img src={Images.featureImageInputBG} />\n                            <div className=\"feature-img-round-info\">\n                              <p className=\"text-center mb-2 browse-file\">\n                                Browse Files\n                              </p>\n                              {/* <p className=\"mb-0\">PNG, GIF, WEBP, MP4, MP3 </p> */}\n                              <p className=\"text-center mb-0\">Max 100mb</p>\n                            </div>\n                          </label>\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-feature-icon\">\n                      <label>\n                        <input\n                          id=\"featuredImg\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          style={{ display: \"none\" }}\n                          name=\"featuredImg\"\n                          onChange={(e) => this.onFileChange(e)}\n                        />\n                        <img src={Images.editIconLarge} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2 text-center text-md-start\">\n                      Feature Image*\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Name:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.name}\n                    onKeyDown={(e) =>\n                      firstInputCharacterSpace(e, collection.name.length)\n                    }\n                    placeholder=\"Enter name\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">URL:</label>\n                  <span className=\"text-danger position-absolute top-0\">\n                    {this.validator.message(\"url\", collection.url, \"url\")}\n                  </span>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Enter URL\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.url}\n                    onKeyDown={(e) =>\n                      firstInputCharacterSpace(e, collection.url.length)\n                    }\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Select Category:*\n                  </label>\n\n                  <Select\n                    className=\"react-select-cls\"\n                    classNamePrefix=\"react-select\"\n                    value={selectedOption}\n                    isSearchable={false}\n                    onChange={this.handleSelectChange}\n                    options={categories}\n                    placeholder=\"Select Category\"\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Description:*\n                  </label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Max 500 characters\"\n                    maxLength=\"500\"\n                    rows=\"3\"\n                    onChange={(e) => this.onChange(e)}\n                    onKeyDown={(e) =>\n                      firstInputCharacterSpace(e, collection.description.length)\n                    }\n                    value={collection.description}\n                  ></textarea>\n                </div>\n\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    disabled={this.handleValidation()}\n                    onClick={(e) => this.submit(e)}\n                  >\n                    Create Collection\n                  </button>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/privacy-policy/privacyPolicy.js",["571"],"import React, { useEffect } from \"react\";\nimport \"./privacyPolicy.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\n\nconst bannerData = {\n  subHeading: \"Our Privacy Policy\",\n  heading: \"Privacy Policy\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nconst PrivacyPolicy = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper privacy\">\n        <div className=\"container\">\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Privacy Policy</h5>\n            <p>\n              MintsClub is committed to protecting your privacy. We have\n              prepared this Privacy Policy to describe our working practices\n              regarding the Personal Data we collect, use, and share in\n              connection with the MintsClub website, as described in our Terms\n              of Service (collectively, the “Service”). “NFT” as per this\n              Privacy Policy refers to a non-fungible token or similar digital\n              item implemented on a blockchain (such as the Ethereum\n              blockchain), which uses smart contracts to link to or otherwise be\n              associated with certain content or data.\n              <br />\n              By using our platform and the Services, you accept the terms of\n              this Policy and our Terms of Use, and consent to our collection,\n              use, disclosure, and retention of your information as described in\n              this Policy. If you have not done so already, please also review\n              our terms of use. The terms of use contain provisions that limit\n              our liability to you and require you to resolve any dispute with\n              us on an individual basis and not as part of any class or\n              representative action. <br />\n              <span>\n                IF YOU DO NOT AGREE WITH ANY PART OF THIS PRIVACY POLICY OR OUR\n                TERMS OF USE, THEN PLEASE DO NOT USE ANY OF THE SERVICES.\n              </span>\n              <br />\n              Please note that this Policy does not apply to information\n              collected through third-party websites or services that you may\n              access through the Services or that you submit to us through\n              email, text message or other electronic message or offline.\n            </p>\n          </div>\n          <div className=\"privacy-content\">\n            <h5>Information We Collect</h5>\n            <p>We may collect information about you in a range of ways.</p>\n            <ul>\n              <li>\n                {\" \"}\n                Identity information, such as your first name, last name,\n                username or similar identifier, title, date of birth and gender.\n              </li>\n              <li>\n                {\" \"}\n                Contact information, such as your postal address, email address\n                and telephone number.\n              </li>\n              <li>\n                {\" \"}\n                Profile information, such as your, profile picture, username and\n                wallet address, interests, preferences, feedback and survey\n                responses.\n              </li>\n              <li>\n                {\" \"}\n                Feedback and correspondence, such as information you provide in\n                your responses to surveys, when you participate in market\n                research activities, report a problem with Service, receive\n                customer support or otherwise correspond with us.\n              </li>\n              <li>\n                {\" \"}\n                Financial information, such as your credit card or other payment\n                card details.\n              </li>\n              <li>\n                {\" \"}\n                Transaction information, such details about purchases you make\n                through the Service and billing details.\n              </li>\n              <li>\n                {\" \"}\n                Usage information, such as information about how you use the\n                Service and interact with us.\n              </li>\n              <li>\n                {\" \"}\n                Marketing information, such as your preferences for receiving\n                marketing communications and details about how you engage with\n                them.\n              </li>\n              <li>\n                {\" \"}\n                Financial information, such as bank account number and bank\n                routing number; financial assets holdings.\n              </li>\n              <li>\n                {\" \"}\n                Technical information, such as your Ethereum wallet address,\n                application programming interface (API)-key and network\n                information regarding transactions. Please note that your\n                Ethereum wallet address is not collected by{\" \"}\n                <a href=\"https://metamask.io/\" target=\"_blank\">\n                  Metamask{\" \"}\n                </a>\n                or associated plugins and mobile applications.\n              </li>\n            </ul>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected by other means</h5>\n            <p>\n              As you navigate through and interact with the MintsClub website,\n              we may use automatic data collection technologies to collect\n              certain information about your equipment, browsing actions, and\n              patterns, including:\n              <br />\n              Information Collected by Our Servers. To provide our Service and\n              make it more useful to you, we (or a third party service provider)\n              collect information from you, including, but not limited to, your\n              browser type, operating system, Internet Protocol (“IP”) address,\n              mobile device ID, blockchain address, wallet type, and date/time\n              stamps.\n              <br />\n              Log Files. We gather certain information automatically and store\n              it in log files. This information includes IP addresses, browser\n              type, Internet service provider (“ISP”), referring/exit pages,\n              operating system, date/time stamps, and clickstream data. We use\n              this information to analyze trends, administer the Service, track\n              users’ movements around the Service, and better tailor our\n              Services to match our users’ needs and improve their experience.\n              <br />\n              Cookies. Like many online services, we use cookies to collect\n              information. We may use both session Cookies (which expire once\n              you close your web browser) and persistent Cookies (which stay on\n              your computer until you delete them) to analyze how users interact\n              with our Service, make improvements to our product quality, and\n              provide users with a more personalized experience.\n              <br />\n              Pixel Tag. In addition, we use “Pixel Tags” (also referred to as\n              clear Gifs, Web beacons, or Web bugs). Pixel Tags allow us to\n              analyze how users find our Service, make the Service more useful\n              to you, and tailor your experience with us to meet your particular\n              interests and needs.\n              <br />\n              Analytics Services. In addition to the tracking technologies we\n              place like Cookies and Pixel Tags, other companies may set their\n              own cookies or similar tools when you visit our Service. This\n              includes third-party analytics services (“Analytics Services”)\n              that we engage to help analyze how users use the Service. The\n              information generated by the Cookies or other technologies about\n              your use of our Service (the “Analytics Information”) is\n              transmitted to the Analytics Services. The Analytics Services use\n              Analytics Information to compile reports on user activity, which\n              we may receive on an individual or aggregate basis. We use the\n              information we get from Analytics Services to improve our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected from Third-Parties</h5>\n            <p>\n              We may receive Personal and/or Anonymous Data about you from\n              companies that offer their products and/or services for use in\n              conjunction with our Service or whose products and/or services may\n              be linked from our Service. For example, third-party wallet\n              providers provide us with your blockchain address and certain\n              other information you choose to share with those wallets\n              providers. We may add this to the data we have already collected\n              from or about you through our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected from Public Blockchains</h5>\n            <p>\n              We may collect data from your activity that is publicly visible\n              and/or accessible on blockchains. This may include blockchain\n              addresses and information regarding purchases, sales, or transfers\n              of NFTs, which may then be associated with other data you have\n              provided to us.e have already collected from or about you through\n              our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Use of Your Personal Data</h5>\n            <p>\n              When we collect your Personal Data from you, we will inform you at\n              the time as to the reason we are requesting such Personal Data.\n              The Company uses your Personal Data in any or all of the following\n              ways:\n            </p>\n            <ul>\n              <li> To facilitate you in the creation of your account.</li>\n              <li> Recognise you as a legitimate user of our platform.</li>\n              <li>\n                {\" \"}\n                Provide you with our Service, which includes helping you view,\n                explore, and create NFTs using our platform and, at your own\n                risk, connect with other users to purchase, sell NFTs on public\n                blockchains.\n              </li>\n              <li>\n                {\" \"}\n                Administration of our Service and quality of experience when you\n                interact with our platform.\n              </li>\n              <li> Provide customer support and respond to your queries.</li>\n              <li>\n                {\" \"}\n                Show your username next to the NFTs currently or previously\n                accessible in your third-party wallet, and next to NFTs on which\n                you have interacted.\n              </li>\n              <li>\n                {\" \"}\n                Send you notifications related to activity on the platform,\n                including notifications of offers on your NFTs.\n              </li>\n              <li>\n                {\" \"}\n                Send you newsletters, promotional materials, and other notices\n                related to our Services.\n              </li>\n              <li>\n                {\" \"}\n                To comply with applicable laws and cooperate with investigations\n                by law enforcement agencies.\n              </li>\n            </ul>\n          </div>\n          <div className=\"privacy-content\">\n            <h5>Disclosure of your Personal Data</h5>\n            <h6>\n              Third Party Service Providers:{\" \"}\n              <span>\n                We may share your Personal Data with third party service\n                providers.\n              </span>\n            </h6>\n            <h6>\n              Analytics:{\" \"}\n              <span>\n                We may share your data to be used by analytic platforms or other\n                such equivalent tools which make use of statistical information.\n              </span>\n            </h6>\n            <h6>\n              Legal Rights:{\" \"}\n              <span>\n                We may also share information as required by law, regulation,\n                legal process, or governmental request.\n              </span>\n            </h6>\n            <h6>\n              Other Disclosures:{\" \"}\n              <span>\n                We may also disclose your Personal Data: to fulfill the purpose\n                for which you provide it; for any other purpose disclosed by us\n                when you provide it; or with your consent.\n              </span>\n            </h6>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Third-Party Websites</h5>\n            <p>\n              Our platform may contain links to third-party websites. When you\n              click on a link to any other website or location, you will leave\n              our website and go to another site, and another entity may collect\n              Personal Data from you. We have no control over, do not review,\n              and cannot be responsible for these third-party websites or their\n              content. Please be aware that the terms of this Privacy Policy do\n              not apply to these third-party websites or their content, or to\n              any collection of your Personal Data after you click on links to\n              such third-party websites.\n              <br />\n              You may access other third-party services through the Site, for\n              example by clicking on links to those third-party services from\n              within the Site. We are not responsible for the privacy policies\n              and/or practices of these third-party services, and we encourage\n              you to carefully review their privacy policies.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Third-Party Wallets</h5>\n            <p>\n              To use the MintsClub NFT platform, you must use a third-party\n              wallet which allows you to engage in transactions on public\n              blockchains. Your interactions with any third-party wallet\n              provider are governed by the applicable terms of service and\n              privacy policy of the respective third party.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Security of Data</h5>\n            <p>\n              We care about the security of your data and use adequate physical,\n              administrative, and technological measures to maintain the\n              security of the data collected through our platform. Nonetheless,\n              no physical and logical security framework is perfect, and hence\n              no guarantee can be provided. In the unfortunate event where any\n              data is compromised as a result of a security breach, we will take\n              steps to investigate and remedy the situation at the earliest. We\n              will also notify any such individuals whose information may have\n              been compromised.\n              <br />\n              It is imperative that you understand the seriousness associated\n              with the security of your digital wallet, the responsibility of\n              which is yours. We insist that you take steps to ensure it and any\n              information related to your wallet remains secure at all times. If\n              you discover an issue related to your wallet, please contact your\n              wallet provider.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Data Storage and Retention</h5>\n            <p>\n              Your Personal Data may be retained for as long as you continue to\n              use our platform, have an account registered with us, or for as\n              long as it is necessary to fulfill the purposes mentioned in this\n              Privacy Policy. Personal Data may be retained even after your\n              account has been deactivated, if such retention is reasonably\n              necessary to comply with our legal obligations, to resolve\n              disputes, prevent fraud and abuse, enforce our Terms or other\n              agreements, and/or protect our legitimate interests. We will\n              delete any Personal Data where it is no longer required for\n              purposes mentioned in this privacy policy.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Your Rights</h5>\n            <p>\n              If you are a user belonging from the European Economic Area or\n              United Kingdom, or are a California resident, you have certain\n              rights under the respective European and UK General Data\n              Protection Regulations (“GDPR”) and the respective California\n              Consumer Privacy Act (“CCPA”).\n              <br />\n              ​Collectively, depending the situation you have the following data\n              protection rights:\n            </p>\n            <ul>\n              <li>\n                {\" \"}\n                The right to access, update or to delete the information we have\n                on you. Whenever made possible, you can access, update or\n                request deletion of your Personal Data.\n              </li>\n              <li>\n                {\" \"}\n                The right of rectification. You have the right to have your\n                information rectified if that information is inaccurate or\n                incomplete.\n              </li>\n              <li>\n                {\" \"}\n                The right of restriction. You have the right to request that we\n                restrict processing of your personal information.\n              </li>\n              <li>\n                {\" \"}\n                The right to erasure or right to be forgotten. If at any time\n                you do not agree with the collection or use of your personal\n                information as mentioned in this privacy policy and you want us\n                to delete your data.\n              </li>\n              <li>\n                {\" \"}\n                The right to data portability. You have the right to be given a\n                copy of the information we have on you in a structured,\n                machine-readable and commonly used format and have the right to\n                transmit that data to another controller on request.\n              </li>\n              <li>\n                {\" \"}\n                The right to withdraw consent. You may withdraw your consent to\n                the processing of data or information for the purposes as\n                mentioned in this privacy policy.\n              </li>\n              <li>\n                {\" \"}\n                The right to deactivate cookies. If you wish to restrict or\n                block all the cookies which are set by our websites, please use\n                the tool available on the particular website (if applicable), or\n                refer to the Help function within your browser to learn how to\n                manage your settings within your browser.\n              </li>\n            </ul>\n            <p>\n              In some situations we may not be able to enact upon your request,\n              if there is lawful reason or legal obligation that prevents us\n              from timely compliance with such request.\n              <br />\n              In order to exercise any of the above rights you may drop your\n              request with our chatbot.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Changes to Privacy Policy </h5>\n            <p>\n              MintsClub may make changes to this Privacy Policy at any time. We\n              insist all visitors and users to our website to frequently review\n              the Privacy Policy, to learn about the latest changes to our\n              privacy practices and other operational mechanisms. Any changes to\n              our privacy policy will be accompanied with a ‘last updated date’\n              for your convenience.\n              <br />\n              Your continued use of the Website or our platform’s services\n              indicates your acknowledgement and/or acceptance of any changes to\n              the updated Privacy Policy.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Privacy for Children</h5>\n            <p>\n              MintsClub does not target, and is not intended to attract, users\n              under the age of eighteen (18) years. We do not knowingly collect\n              Personal Data from users under the age of eighteen (18) years or\n              send requests to users under the age of eighteen (18) years for\n              Personal Data.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Contact and Queries</h5>\n            <p>\n              If you have any questions or concerns regarding this Privacy\n              Policy or Mints.Club data collection or processing practices, or\n              if you want to report any security violations to us, drop your\n              queries with our chatbot.\n            </p>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default PrivacyPolicy;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/terms-conditions/termsConditions.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/home/home.reducer.js",["572","573"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["574"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["575"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/explore/explore.reducer.js",["576"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["577","578","579","580","581","582","583","584","585"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["586"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n      case BEFORE_NFTS_BY_COLLECTION:\n        return {\n          ...state,\n          nftsByCollectionStatus: false,\n        }\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/user/user.reducer.js",["587"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/categories/categories.reducer.js",["588"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/offers/offers.reducer.js",["589"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/bids/bids.reducer.js",["590"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/footer/footer.reducer.js",["591"],"import {SUBSCRIBE, BEFORE_FOOTER,SUBSCRIBE_RESPONSE } from '../../redux/types';\n\nconst initialState = {\n    subscribeAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n            case BEFORE_FOOTER:\n                return {\n                    ...state,\n                    subscribeAuth: false,\n                }\n                case SUBSCRIBE:\n                    return {\n                        ...state,\n                        subscribeAuth:false,  \n                    }\n                    case SUBSCRIBE_RESPONSE:\n                        return {\n                            ...state,\n                            subscribeAuth:true,\n                        }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["592"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/layouts/layout/layout.jsx",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/collections/collections.actions.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/user/user.action.js",["593","594"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/auctions/home-auctions.js",["595","596","597","598","599","600","601"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\n\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\n\r\nimport { getCreators } from \"./../user/user.action\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"all\");\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  const [isActive, setIsActive] = useState(0);\r\n  const [filterationLoader, setFilterationLoader] = useState(true);\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions } = props.auction;\r\n      if (auctions) {\r\n        auctions.forEach((element, i) => {\r\n          auctions[i].totalBids = element.bidInfo?.bidBy?.length;\r\n        });\r\n      }\r\n      setAuctions(auctions);\r\n      setFilterationLoader(false);\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  useEffect(() => {\r\n    const interval = setInterval(() => {\r\n      checkIfAuctionEnded();\r\n    }, 3000);\r\n    return () => clearInterval(interval);\r\n  }, [auctions]);\r\n\r\n  const checkIfAuctionEnded = () => {\r\n    if (auctions && auctions?.length > 0) {\r\n      auctions.forEach((item, index) => {\r\n        let auctionEndDate = new Date(item.auctionEndDate);\r\n        let currentDate = new Date();\r\n        if (currentDate > auctionEndDate) {\r\n          let updatedAuctions = [...auctions];\r\n          updatedAuctions.splice(index, 1);\r\n          setAuctions(updatedAuctions);\r\n        }\r\n      });\r\n    }\r\n  };\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setFilterationLoader(true);\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-md-8\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content clr-blue\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products.{\" \"}\r\n                    <br className=\"d-none d-xxl-block\" />\r\n                    We want to be a part of your smile, success and future\r\n                    growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\r\n              {categoryId === \"all\" &&\r\n              (!auctions || (auctions && auctions?.length <= 1)) &&\r\n              !filterationLoader ? (\r\n                \"\"\r\n              ) : (\r\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                  {categories &&\r\n                    categories.length > 0 &&\r\n                    categories.map((item, id) => {\r\n                      if (id <= 3) {\r\n                        return (\r\n                          <button\r\n                            key={id}\r\n                            className={`${\r\n                              id === isActive ? \"home-active-category\" : \"\"\r\n                            } me-1 me-sm-3 me-lg-4`}\r\n                            onClick={() => {\r\n                              setIsActive(id);\r\n                              handleCategoryFilter(item.description);\r\n                            }}\r\n                          >\r\n                            {item.name}\r\n                          </button>\r\n                        );\r\n                      }\r\n                    })}\r\n                  <div className=\"intro-btn\">\r\n                    <Link\r\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                      to=\"/auctions\"\r\n                    >\r\n                      View All\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auctions-slides\">\r\n            <>\r\n              {filterationLoader ? (\r\n                <div className=\"spinner-loader-wrapper\">\r\n                  <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                    <span className=\"sr-only\">Loading...</span>\r\n                  </div>\r\n                </div>\r\n              ) : auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item, index) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        cardBg={\"card-bg-gray\"}\r\n                        key={index}\r\n                        item={item}\r\n                        ownerName={item?.owner?.username}\r\n                        userId={ENV.getUserKeys(\"_id\")?._id}\r\n                        ownerId={item.owner?._id}\r\n                        bidsProfile={item?.bidInfo?.bidByProfile}\r\n                        index={index}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className=\"text-center py-5\">No Live Auctions Found</p>\r\n              )}\r\n            </>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/assets/assets.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/top-seller/topseller.js",["602","603"],"import React, { useEffect, useState } from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { getTopSellers, beforeUser } from \"../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\r\nimport \"./topseller.css\";\r\nimport { Images } from \"../../assets/assets\";\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n  const [loader, setLoader] = useState(true);\r\n\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.user.topSellersAuth) {\r\n      const { topSellers } = props.user.sellers;\r\n      setLoader(false);\r\n      if (topSellers?.length > 11) {\r\n        setSellers(topSellers.slice(0, 11));\r\n      } else {\r\n        setSellers(topSellers);\r\n      }\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content clr-blue\">\r\n                <span>Creative Artists</span>\r\n                <h3 className=\"mb-5\">Top Sellers</h3>\r\n              </div>\r\n              {sellers && sellers.length > 12 && props.viewAll && (\r\n                <div className=\"intro-btn mb-5\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll \"\r\n                    to=\"/top-sellers-list\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row g-3 items\">\r\n          {loader ? (\r\n            <div className=\"top-seller spinner-loader-wrapper\">\r\n              <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                <span className=\"sr-only\">Loading...</span>\r\n              </div>\r\n            </div>\r\n          ) : sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              return (\r\n                <div\r\n                  key={`ts_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                >\r\n                  {/* Single Seller */}\r\n                  <div className=\"card top-seller-card\">\r\n                    <div className=\"single-seller d-flex align-items-center\">\r\n                      <div className=\"seller-avatar-container\">\r\n                        <img\r\n                          className=\"avatar-md rounded-circle\"\r\n                          src={\r\n                            !author.profileImage\r\n                              ? Images.placeholderImg\r\n                              : author.profileImage\r\n                          }\r\n                          alt=\"AvatarImg\"\r\n                        />\r\n                        {author.profileImage ? (\r\n                          <span className=\"seller-avatar-active\">\r\n                            <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                          </span>\r\n                        ) : (\r\n                          \"\"\r\n                        )}\r\n                      </div>\r\n\r\n                      {/* Seller Info */}\r\n                      <div className=\"seller-info ml-3 w-100\">\r\n                        <p className=\"seller text-capitalize mb-2\">\r\n                          {author.username}\r\n                        </p>\r\n                        <span className=\"text-end\">\r\n                          {\" \"}\r\n                          {author.totalETH.toFixed(2)}\r\n                        </span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          ) : (\r\n            <p className=\"text-center\">No Top Sellers Found</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/banner/banner.js",["604"],"import React from \"react\";\nimport \"./banner.css\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst Banner = ({ subHeading, heading, content, bgImg, bannerImg }) => {\n  return (\n    <>\n      <div\n        className=\"banner-wrapper padding-wrapper\"\n        style={{ backgroundImage: `url(${bgImg})` }}\n      >\n        <div className=\"container\">\n          <div className=\"row align-items-end\">\n            <div className=\"col-md-9 col-lg-7\">\n              <div className=\"intro\">\n                <div className=\"intro-content clr-blue\">\n                  {subHeading && <span>{subHeading}</span>}\n                  {heading && <h3 className=\"mb-0\">{heading}</h3>}\n                  {content && <p className=\"pt-4\">{content}</p>}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-lg-5 d-none d-lg-block\">\n              <div className=\"banner-img\">\n                {bannerImg && <img src={bannerImg} alt=\"banner-img\" />}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Banner;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/footer/footer.js",["605","606","607","608","609","610","611","612"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter, beforeFooter, subscribeUser } from \"./footer.action\";\nimport { firstInputCharacterSpace } from \"./../../utils/functions\";\nimport EmailIcon from \"../../assets/images/mailbox-icon.svg\";\nimport { useLocation } from \"react-router-dom\";\nimport \"./footer.css\";\nimport { toast } from \"react-toastify\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n  const [email, setEmail] = useState(\"\");\n  const [loader, setLoader] = useState(false);\n  useEffect(() => {\n    if (props.subscribeAuth && props.error === null) {\n      setLoader(false);\n      toast.success(\"Subscribed successfully\");\n      props.beforeFooter();\n    }\n  }, [props.subscribeAuth]);\n\n  useEffect(() => {\n    if (props.error !== null) {\n      toast.error(props.error.message);\n      setLoader(false);\n\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  const subscribe = () => {\n    if (email.trim() === \"\") {\n      return toast.error(\"Please enter an email to subscribe\");\n    }\n    if (validateEmail(email)) {\n      props.beforeFooter();\n      setLoader(true);\n      props.subscribeUser(email);\n    } else {\n      toast.error(\"Please enter a valid email address\");\n    }\n  };\n  const validateEmail = (email) => {\n    return String(email)\n      .toLowerCase()\n      .match(\n        /^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/\n      );\n  };\n  const location = useLocation();\n  return (\n    <footer className=\"footer-area\">\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin  text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Who Are We?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/aboutus\">About Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/faqs\">FAQs</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Join MintsClub\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/login\">Sign In</Link>\n                  </li>\n\n                  <li>\n                    <Link to=\"/Signup\">Sign Up</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Quick Links\"}</h4>\n                <ul>\n                  {location.pathname !== \"/login\" &&\n                    location.pathname !== \"/Signup\" && (\n                      <>\n                        <li>\n                          <Link to=\"/auctions\">Live Auction</Link>\n                        </li>\n                        <li>\n                          <Link to=\"/popular-collections\">\n                            Popular Collections\n                          </Link>\n                        </li>\n                      </>\n                    )}\n                  <li>\n                    <Link to=\"/privacypolicy\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/termsandconditions\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin\">\n              <div className=\"footer-items footer-notify-item text-center text-lg-end\">\n                <h4 className=\"footer-title\">\n                  Never Miss The NFT Beat! <br /> Subscribe To Our Latest News\n                </h4>\n                <div className=\"notify-form\">\n                  <div className=\"email-icon\">\n                    <img src={EmailIcon} alt=\"mail-box\" />\n                  </div>\n                  <input\n                    type=\"email\"\n                    maxLength=\"50\"\n                    onKeyDown={(e) => firstInputCharacterSpace(e, email)}\n                    onChange={(e) => setEmail(e.target.value)}\n                    placeholder=\"youremail@xyz.com\"\n                  />\n                  <div>\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                      disabled={loader}\n                      onClick={() => subscribe()}\n                    >\n                      {loader ? (\n                        <div class=\"spinner-border footer-loader\" role=\"status\">\n                          <span class=\"sr-only\">Loading...</span>\n                        </div>\n                      ) : (\n                        \"Subscribe\"\n                      )}\n                    </button>\n                  </div>\n                </div>\n                <p>{data.desc}</p>\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-end\">\n                  <a\n                    href={\"https://www.linkedin.com/showcase/mints-club\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a\n                    href={\"https://www.facebook.com/MintsClub.io/\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a\n                    href={\"https://www.instagram.com/mintsclub/\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={\"https://twitter.com/MintsClub\"} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              <div className=\"copyright-text\">\n                © 2022 All rights reserved by mintsclub.io\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n  subscribeAuth: state.footer.subscribeAuth,\n});\n\nexport default connect(mapStateToProps, {\n  subscribeUser,\n  emptyError,\n  beforeFooter,\n})(Footer);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/hero/hero.js",["613","614","615","616"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport \"./hero.css\";\r\nimport Play from \"../../assets/images/play.svg\";\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport HeroCards from \"../hero-cards/HeroCards\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeAuction, getLiveAuctions } from \"../auctions/auctions.action\";\r\nimport { connect } from \"react-redux\";\r\nimport { WordsFamousNfts } from \"../../utils/exportData\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n  const [data, setData] = useState(null);\r\n  const [status, setStatus] = useState(null);\r\n  const heroSettings = ENV.heroSettings;\r\n\r\n  useEffect(async () => {\r\n    let address = await connectMetamaskCopy(connectedAddress);\r\n    setConnectedAddress(address);\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions } = props.auction;\r\n      let updatedAuctions = [];\r\n      if (auctions && auctions.length > 1) {\r\n        props.beforeAuction();\r\n        setStatus(\"auctions\");\r\n        updatedAuctions = auctions.filter((item) => item.fileType === \"image\");\r\n        if (updatedAuctions?.length > 6) {\r\n          updatedAuctions = updatedAuctions.slice(0, 6);\r\n        }\r\n        setData(updatedAuctions);\r\n      } else {\r\n        setStatus(\"nfts\");\r\n        setData(WordsFamousNfts);\r\n      }\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, <br /> <span>and sell </span>\r\n              <br />\r\n              Extraordinary <span> NFTs </span>\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create me-sm-4\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                Create\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                Explore\r\n              </Link>\r\n            </div>\r\n            <div className=\"watch-video d-flex align-items-center mt-5 mb-4\">\r\n              <button className=\"hero-play-btn\">\r\n                <img src={Play} alt=\"play\" />\r\n              </button>\r\n              <span className=\"ms-2\">Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6\">\r\n            <CardSlider settings={heroSettings}>\r\n              {data &&\r\n                data.length > 0 &&\r\n                data.map((auction, id) => {\r\n                  return (\r\n                    <HeroCards\r\n                      key={id}\r\n                      data={auction}\r\n                      status={status}\r\n                      className=\"slide\"\r\n                    />\r\n                  );\r\n                })}\r\n            </CardSlider>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  nft: state.nft,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n})(Hero);\r\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/own-collection-today/own-collection-today.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/explore/explore.action.js",["617"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        // console.log(error);\n      });\n   };","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/nfts/nfts.action.js",["618","619"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n  axiosPostFormData,\n} from \"./../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n        \n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n      \n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const update =\n  (body, qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .put(url, body)\n      .then(function (response) {\n        if (response.data.success) {\n        } else {\n        }\n      })\n      .catch(function (error) {\n        // console.log(error);\n      });\n  };\n\nexport const createActivity = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}activity/create`;\n\n  axios\n    .post(url, body)\n    .then(function (response) {\n    \n    })\n    .catch(function (error) {\n      // console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const getActivities =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}activity/get`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {\n       \n\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        // console.log(error);\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n  export const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {    \n        dispatch({\n          type:  GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n \n      })\n      .catch(function (error) {\n        // console.log(error)\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n   \n      });\n  };\nexport const beforeNFTByCollection=()=>(dispatch)=>{\n  dispatch({\n    type: BEFORE_NFTS_BY_COLLECTION,\n  });\n}\nexport const getNFTsByCollection = (id) => (dispatch) => {\n  let data = {\n    collectionId: id,\n  };\n\n  dispatch(emptyError());\n\n  const url = `${ENV.url}nfts/getNFTsByCollection`;\n  axios\n    .post(url, data)\n    .then(function (response) {\n      if (response.data.success) {\n        dispatch({\n          type: GET_NFTS_BY_COLLECTION,\n          payload: response.data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: response.data,\n        });\n      }\n    })\n    .catch(function (error) {\n      // console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .get(url)\n      .then(function (response) {\n        console.log();\n        if (response.data.success) {\n          dispatch({\n            type: GET_MYLIKED_NFTS,\n            payload: response.data.data,\n          });\n        } else {\n        }\n      })\n      .catch(function (error) {\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const createNFT = async (formData) => async (dispatch)=>{\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n    \n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  try{\n\n    const res = await axiosPostFormData(\"nfts/storeNFTData\", formData, true);\n  }catch(error){\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       \n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n        } else {\n        }\n      })\n      .catch((errors) => {});\n  };\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["620","621"],"import React, { useState } from \"react\";\nimport { Link, useHistory, useLocation, NavLink } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport { ReactComponent as LoginIcon } from \"../../assets/images/login-icon.svg\";\nimport { ReactComponent as SearchIcon } from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [searchactive, setSearchActive] = useState(false);\n  const [searchValue, setSearchValue] = useState(\"\");\n  const history = useHistory();\n  const location = useLocation();\n\n  const handleChange = (e) => {\n    setSearchValue(e.target.value);\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword = () => {\n    if (searchValue !== \"\" && searchValue.length >= 3) {\n      history.push({\n        pathname: \"/explore/allNFT\",\n        state: searchValue,\n      });\n    }\n  };\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n\n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"light\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <NavLink to=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </NavLink>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className={\"mx-xl-auto\"}>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/\">Home</NavLink>\n              </Nav.Link>\n              \n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/exploreAll\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Explore All\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/allNFT\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    All NFT\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/create\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Create NFT\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/createcollection\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Create Collection\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/userprofile\" className=\"nav-main-link\">\n                  Profile\n                </NavLink>\n              </Nav.Link>\n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <span className=\"me-2\">\n                    <LoginIcon />\n                  </span>\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={() => handleSearchKeyword()}\n                >\n                  <SearchIcon className=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={() => handleSearchKeyword()}\n              >\n                <SearchIcon className=\"search-icon\" />\n              </button>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient btn-login\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <span className=\"me-2\">\n                  <LoginIcon />\n                </span>\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/listing/listing.js",["622","623","624","625","626"],"import React, { useState, useEffect } from 'react';\nimport './listing.css';\nimport SearchIcon from '../../assets/images/search-inp.svg';\nimport NftCard from '../nft-card/nft-card';\nimport FullPageLoader from '../full-page-loader/full-page-loader';\nimport Select from 'react-select';\nimport { decimalNumberValidator, firstInputCharacterSpace } from '../../utils/functions';\nconst Listing = (props) => {\n  const [minValue, setMinValue] = useState('');\n  const [maxValue, setMaxValue] = useState('');\n  const [statusActive, setStatusActive] = useState(null);\n  const [filterActive, setFilterActive] = useState(false);\n  const [initial, setInitial] = useState(true);\n  const [selectedOption, setSelectedOption] = useState();\n  const [collectionActive, setCollectionActive] = useState(null);\n  const [isActive, setIsActive] = useState(1);\n  const [keyword, setKeyword] = useState(props.initialKeyword ? props.initialKeyword : '');\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 9,\n    buy: false,\n    auction: false,\n    latest: false,\n    keyword: props.initialKeyword ? props.initialKeyword : ''\n  });\n\n  const priceOptions = [\n    { value: 'lowtohigh', label: 'Low To High' },\n    { value: 'hightolow', label: 'High To Low' },\n    { value: 'oldest', label: 'Oldest' },\n    { value: 'newest', label: 'Recently Created' }\n  ];\n  useEffect(() => {\n    const { initialKeyword } = props;\n    if (initialKeyword) {\n      let capitalizeValue = capitalize(initialKeyword);\n      setKeyword(capitalizeValue);\n      handleSearchKeyword(capitalizeValue);\n    }\n  }, [props.initialKeyword]);\n\n  useEffect(() => {\n    fetchData(filter);\n  }, [filter]);\n  const handleSelectChange = (selectedOption) => {\n    setSelectedOption(selectedOption);\n  };\n  const selectCustomStyles = {};\n\n  const statusData = ['Buy Now', 'On Auction', 'New'];\n  const handleFilters = () => {\n    setFilterActive(!filterActive);\n  };\n  const isHideCollection = () => {\n    if (props.collectionDetail) {\n      return false;\n    }\n    if (props.UserProfile) {\n      if (isActive === 1) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return true;\n    }\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n    setInitial(false);\n\n    const { label } = e;\n    if (label === 'Low To High') {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false\n      }));\n    } else if (label === 'High To Low') {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false\n      }));\n    } else if (label === 'Oldest') {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false\n      }));\n    } else if (label === 'Recently Created') {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false\n      }));\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    window.scroll(0, 200);\n    if (!UserProfile) {\n      setInitial(false);\n      setFilterationLoader(true);\n      setFilter((prev) => ({ ...prev, limit: filter.limit + 9 }));\n    } else {\n      getPaginatedData();\n    }\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n  };\n\n  const handleSearchKeyword = (value) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    let capitalizeValue = '';\n    if (value) {\n      capitalizeValue = capitalize(value);\n    }\n    setFilter((prev) => ({ ...prev, keyword: capitalizeValue }));\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    if (id === 'Buy Now') {\n      setFilter((prev) => ({\n        ...prev,\n        buy: true,\n        auction: false,\n        newest: false\n      }));\n    } else if (id === 'On Auction') {\n      setFilter((prev) => ({\n        ...prev,\n        auction: true,\n        buy: false,\n        newest: false\n      }));\n    } else {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        buy: false,\n        auction: false\n      }));\n    }\n  };\n  const handleClearFilter = (id) => {\n    if (id === 'status') {\n      setFilterationLoader(true);\n      setFilter((prev) => ({\n        ...prev,\n        buy: false,\n        auction: false,\n        new: false\n      }));\n    } else if (id === 'price') {\n      setFilterationLoader(true);\n      setMinValue('');\n      setMaxValue('');\n      setFilter((prev) => ({ ...prev, ltePrice: false, gtePrice: false }));\n    } else if (id === 'collections') {\n      setFilterationLoader(true);\n      setFilter((prev) => ({ ...prev, collectionId: false }));\n    } else {\n      setMinValue('');\n      setMaxValue('');\n      setStatusActive(null);\n      setCollectionActive(null);\n      setSelectedOption(null);\n      setFilterActive(null);\n      setKeyword('');\n      setFilter({\n        collectionId: false,\n        gtePrice: false,\n        ltePrice: false,\n        categoryId: false,\n        oldest: false,\n        lowToHigh: false,\n        highToLow: false,\n        newest: false,\n        page: filter.page,\n        limit: filter.limit,\n        buy: false,\n        auction: false,\n        latest: false\n      });\n    }\n  };\n  const capitalize = (word) => {\n    return word[0].toUpperCase() + word.slice(1).toLowerCase();\n  };\n\n  const {\n    collections,\n    disabled,\n    menuData,\n    totalItems,\n    handleNftFilter,\n    setMenuFilter,\n    filterationLoader,\n    setFilterationLoader,\n    nfts,\n    loader,\n    likedNfts,\n    nftPagination,\n    handleLikesTogleApi,\n    fetchData,\n    path,\n    getPaginatedData,\n    UserProfile\n  } = props;\n  return (\n    <div className='filterhoc-wrapper padding-wrapper'>\n      <div className='container'>\n        <div className='row justify-content-center justify-content-lg-start'>\n          <div className='col-12 order-0'>\n            <div className={`d-flex flex-column flex-md-row align-items-center justify-content-md-between`}>\n              <div className='search-input mb-4 mb-md-0'>\n                <input\n                  type='text'\n                  placeholder='Search items and accounts'\n                  maxLength='50'\n                  onChange={(e) => {\n                    if (keyword.trim() === '' && e.target.value.trim() === '') {\n                      return false;\n                    } else if (e.target.value === '') {\n                      handleSearchKeyword(false);\n                      setKeyword(e.target.value);\n                    } else {\n                      setKeyword(e.target.value);\n                    }\n                  }}\n                  onKeyPress={(e) => e.key === 'Enter' && handleSearchKeyword(keyword)}\n                  value={keyword}\n                />\n                <img src={SearchIcon} alt='search-input' />\n              </div>\n              <div className='sort-by-select mb-4 mb-md-0'>\n                <p className='me-3'>Sort by:</p>\n                <Select\n                  className='react-select-cls'\n                  classNamePrefix='react-select'\n                  styles={selectCustomStyles}\n                  // defaultValue={priceOptions[3]}\n                  value={selectedOption}\n                  isSearchable={false}\n                  onChange={(value) => {\n                    handleSelectChange(value);\n                    handleSortOptions(value);\n                  }}\n                  options={priceOptions}\n                />\n              </div>\n              <div className='mob-filters-btn d-flex d-lg-none align-items-center justify-content-center'>\n                <button className={`${filterActive ? 'mob-active-filter' : ''}`} onClick={handleFilters}>\n                  Filters\n                </button>\n              </div>\n            </div>\n          </div>\n          <div className='col-12 my-5 order-2 order-lg-1 '>\n            <div className='hero-nav d-flex flex-column flex-sm-row align-items-center justify-content-between'>\n              <div>\n                {' '}\n                {menuData &&\n                  menuData.length > 0 &&\n                  menuData.map((item, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          setIsActive(id);\n                          handleNftFilter(item);\n                          setMenuFilter(item);\n                        }}\n                        className={`${id === isActive ? 'active-hero-nav' : ''} me-2 me-xl-3`}\n                      >\n                        {item}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className='total-items mt-3 mt-sm-0'>\n                <p>\n                  Total items: <span>{nftPagination?.total ? nftPagination?.total : 0}</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div\n            className={`${\n              filterActive ? 'd-block d-lg-block' : 'd-none d-lg-block'\n            } col-md-5 col-lg-4 col-xl-3 order-1 order-lg-2 mt-4 mt-lg-0`}\n          >\n            <div className='filter-container mb-4'>\n              <h6>Status</h6>\n              <hr />\n              <div className='d-flex flex-wrap align-items-center '>\n                {statusData &&\n                  statusData.map((status, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          handleStatusFilter(status);\n                          setStatusActive(status);\n                        }}\n                        className={`${status === statusActive ? 'active-filter-btn' : ''} filter-btn me-3`}\n                      >\n                        {status}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className='d-flex align-items-end justify-content-end'>\n                {statusActive && (\n                  <button\n                    className='filter-clear-btn'\n                    onClick={() => {\n                      setStatusActive();\n                      handleClearFilter('status');\n                    }}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            <div className='filter-container mb-4'>\n              <h6>Price</h6>\n              <hr />\n              <div className='min-max-inp d-flex flex-column flex-sm-row align-items-center justify-content-center justify-content-sm-between mb-2'>\n                <div className='d-flex flex-column flex-sm-row align-items-center justify-content-center'>\n                  <input\n                    type='number'\n                    placeholder='Min'\n                    className='me-sm-2'\n                    value={minValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMinPrice}\n                  ></input>\n                  <input\n                    type='number'\n                    placeholder='Max'\n                    className='mt-3 mt-sm-0 me-sm-2'\n                    value={maxValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMaxPrice}\n                  ></input>\n                </div>\n                <button\n                  className='mt-3 mt-sm-0'\n                  onClick={() => applyMinMaxFilter()}\n                  disabled={disabled || minValue === '' || maxValue === ''}\n                >\n                  Apply\n                </button>\n              </div>\n              <div className='d-flex align-items-end justify-content-end'>\n                {minValue && maxValue && (\n                  <button className='filter-clear-btn' onClick={() => handleClearFilter('price')}>\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            {isHideCollection() && (\n              <div className='filter-container hoc-collections-container mb-4'>\n                <h6>Collections</h6>\n                <hr />\n                <div className='d-flex flex-wrap align-items-center '>\n                  {collections && collections.length > 0 ? (\n                    collections.map((collection, id) => {\n                      return (\n                        <button\n                          key={id}\n                          onClick={() => {\n                            handleCollectionsFilter(collection._id);\n                            setCollectionActive(id);\n                          }}\n                          className={`${id === collectionActive ? 'active-filter-btn' : ''} filter-btn me-2 me-xl-3`}\n                        >\n                          {collection.name}\n                        </button>\n                      );\n                    })\n                  ) : (\n                    <p className='text-center mx-auto'>No Collections Found</p>\n                  )}\n                </div>\n                <div className='d-flex align-items-end justify-content-end'>\n                  {collectionActive !== null && (\n                    <button\n                      className='filter-clear-btn'\n                      onClick={() => {\n                        setCollectionActive(null);\n                        handleClearFilter('collections');\n                      }}\n                    >\n                      Clear\n                    </button>\n                  )}\n                </div>\n              </div>\n            )}\n            <div className='d-flex align-items-center justify-content-center btn-clear-all'>\n              <button onClick={() => handleClearFilter()}>Clear All Filters</button>\n            </div>\n          </div>\n          <div className='col-lg-8 col-xl-9 order-3'>\n            {loader ? (\n              <FullPageLoader />\n            ) : (\n              <div className='row g-1'>\n                {filterationLoader ? (\n                  <div className='text-center'>\n                    <div className='spinner-border text-secondary' role='status'>\n                      <span className='sr-only'>Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((nft, index) => {\n                    return (\n                      <div key={index} className='col-12 col-sm-6 col-md-4 col-lg-6 col-xl-4'>\n                        {\n                          <NftCard\n                            data={nft}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            likedNfts={likedNfts}\n                            owner={nft.owner}\n                            path={path}\n                            index={index}\n                          />\n                        }\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className='text-center mt-5 no-nft-title'>No NFT Found</p>\n                )}\n                <div className='col-12'>\n                  <div className='mt-5 text-center'>\n                    {nfts && nftPagination?.total > nfts.length && !filterationLoader && (\n                      <button className='btn btn-rounded-bordered px-5' onClick={() => handlePagination()}>\n                        Load more...\n                      </button>\n                    )}\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Listing;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/auctions/auctions.action.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["627"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/audio/audio.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/contentLoader/nftDetailLoader.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/nft-card/nft-card.js",["628","629","630","631","632"],"import React, { useState } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\n\nimport { ENV } from \"../../config/config\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport placeholderImg from \"../../assets/images/placeholder.png\";\n\nimport { connect } from \"react-redux\";\nimport \"./nft-card.css\";\nimport { Images } from \"../../assets/assets\";\nimport ImageLoader from \"../contentLoader/imageLoader\";\nimport Audio from \"../audio/audio\";\nconst NFTCard = (props) => {\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n  const [loader, setLoader] = useState(true);\n  const {\n    image,\n    name,\n    _id,\n    fileType,\n    cardBg,\n    ownerId,\n    likeCount,\n    currentPrice,\n    copies,\n    remainingCopies,\n    ownerAddress,\n  } = props.data;\n  const { username, profileImage, profilePhoto } = props?.owner;\n  const user = ENV.getUserKeys(\"_id\")?._id;\n  const { likedNfts } = props;\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className={`auction-card nft-card ${cardBg} m-1 mx-auto mx-sm-1`}>\n      <div className=\"auction-img-wrapper\">\n        {fileType === \"image\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Card.Img\n              variant=\"top\"\n              onLoad={() => setLoader(false)}\n              onClick={() => history.push(`${props.path}${_id}`)}\n              src={image}\n              alt=\"AuctionTopImg\"\n              style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n            />\n          </>\n        ) : fileType === \"video\" ? (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n                <ImageLoader />\n              </div>\n              <video\n                id=\"video1\"\n                src={image}\n                ref={videoElement}\n                onTimeUpdate={handleOnTimeUpdate}\n                onEnded={() => {\n                  togglePlay();\n                }}\n                onCanPlay={() => {\n                  setLoader(false);\n                }}\n                style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : fileType === \"audio\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Audio\n              src={image}\n              onLoadCallback={() => setLoader(false)}\n              loader={loader}\n              fileType={fileType}\n            />\n          </>\n        ) : (\n          \" \"\n        )}\n      </div>\n      <Card.Body>\n        <Card.Title>\n          <div>\n            {name && name.length > 25 ? name.slice(0, 25) + \"...\" : name}\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <span className=\"me-2\">{likeCount ? likeCount : 0}</span>\n            {!validateIfLiked(likedNfts, _id) ? (\n              <img\n                src={Images.whiteEmptyHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"like\", likeCount);\n                }}\n              />\n            ) : (\n              <img\n                src={Images.whiteFillHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"dislike\", likeCount);\n                }}\n              />\n            )}\n          </div>\n        </Card.Title>\n        <div className=\"nft-status \">\n          <div className=\"status-info status-sold\">\n            <span className=\"status\">\n              Sold:{\" \"}\n              <span className=\"status-count\">{copies - remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n          <div className=\"status-info status-remaining\">\n            <span className=\"status\">\n              Remaining: <span className=\"status-count\">{remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-3\">\n          <span className=\"nft-price mt-2\">\n            <img className=\"me-2\" src={Images.nftPriceTag} />\n            Price:<a className=\"price ms-1\">{currentPrice} ETH</a>\n          </span>\n        </div>\n        <div className=\"auction-card-owner-container d-flex align-items-center mb-2 mt-3\">\n          <div className=\"auction-owner-avatar\">\n            <img\n              src={\n                !profilePhoto && !profileImage\n                  ? placeholderImg\n                  : profilePhoto\n                  ? profilePhoto\n                  : profileImage\n              }\n              alt=\"avatar\"\n            />\n          </div>\n          <div className=\"ms-2 auction-owner-name\">\n            <p>\n              {\"Owned by:\"}\n              <span className=\"text-capitalize ms-1\">\n                {ownerAddress?.toUpperCase() ===\n                props.connectedAddress?.toUpperCase()\n                  ? \"You\"\n                  : username && username?.length > 25\n                  ? username.substring(0, 25) + \"...\"\n                  : username?.length <= 25\n                  ? username\n                  : \"unnamed\"}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn\"\n          onClick={() => history.push(`${props.path}${_id}`)}\n        >\n          {\"View Detail\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {})(NFTCard);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/create-nft/components/levelsinfo.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/create-nft/components/statsinfo.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/modals/BidModal.js",["633"],"import React, { useState, useEffect } from \"react\";\nimport { Modal, Button } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\n\nimport \"./BuyModal.css\";\n\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport axios from \"axios\";\n\nconst BidModal = (props) => {\n  const [checkBox, setCheckBox] = useState(false);\n  const [exchangeRate, setExchangeRate] = useState(0);\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  const {\n    onChange,\n    decimalNumberValidator,\n    handleModalSubmit,\n    calculatePricePercantage,\n    onHide,\n    balance,\n    price,\n    show,\n  } = props;\n\n  return (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className={`buy-modal bid-modal ${show === true ? \"modal-is-open\" : \" \"}`}\n      centered\n      autoFocus={true}\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Place a Bid\n        </Modal.Title>\n\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to place bid!\"}\n        </p>\n\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Price</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"bid-inp-container d-flex align-items-center\">\n          <div className=\"inp-container d-flex align-items-center justify-content-between\">\n            <div>\n              <input\n                type=\"number\"\n                placeholder=\"Place Your Bid\"\n                name=\"nftConfig.price.amount\"\n                style={{ borderRadius: \"4px\" }}\n                onChange={(e) => onChange(e)}\n                onKeyDown={(e) => decimalNumberValidator(e)}\n                defaultValue={calculatePricePercantage()}\n                value={price}\n              />\n            </div>\n            <div className=\"dollar-rate text-end\">\n              <p className=\"\">\n                ${price ? (price * exchangeRate).toFixed(2) : 0}\n              </p>\n            </div>\n          </div>\n          <div className=\"inp-currency\">\n            <h6>ETH</h6>\n          </div>\n        </div>\n        <div className=\"bid-balance text-start\">\n          <p>Balance: {Number(balance).toFixed(4)} ETH</p>\n        </div>\n        {balance !== \"\" && balance === 0 && (\n          <p className=\"text-center insufcient-funds text-danger\">\n            Please Add Balance to place bid\n          </p>\n        )}\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\" target=\"_blank\">\n                Terms of Services\n              </Link>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n          onClick={() => {\n            handleModalSubmit();\n            onHide();\n          }}\n          disabled={\n            +price < calculatePricePercantage() ||\n            balance === 0 ||\n            !checkBox ||\n            +price > +balance\n          }\n        >\n          Confirm Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default BidModal;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/footer/footer.action.js",["634"],"import { ENV } from \"./../../config/config\";\nimport {\n  GET_ERRORS,\n  BEFORE_FOOTER,\n  GET_FOOTER,\n  SUBSCRIBE_RESPONSE,\n  SUBSCRIBE,\n} from \"../../redux/types\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport axios from \"axios\";\n\nexport const beforeFooter = () => {\n  return {\n    type: BEFORE_FOOTER,\n  };\n};\n\nexport const getFooter = () => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({ type: SUBSCRIBE });\n  const url = `${ENV.url}/settings/get`;\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        dispatch({\n          type: GET_FOOTER,\n          payload: data.settings,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const subscribeUser = (email) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    const response = await axios.post(`${ENV.url}users/subscribe`, { email });\n    dispatch({\n      type: SUBSCRIBE_RESPONSE,\n    });\n    // console.log(response, \"response\");\n  } catch (error) {\n    // console.log(error.response, \"error\");\n    dispatch({\n      type: GET_ERRORS,\n      payload: error.response.data,\n    });\n  }\n};\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/utils/exportData.js",["635"],"import nft1 from \"../assets/images/famous1.jpeg\";\nimport nft2 from \"../assets/images/famous2.webp\";\nimport nft3 from \"../assets/images/famous3.jpg\";\nimport nft4 from \"../assets/images/famous4.jpg\";\nimport nft5 from \"../assets/images/famous5.png\";\nimport nft6 from \"../assets/images/famous6.jpeg\";\nimport nft7 from \"../assets/images/famous7.jpeg\";\nimport {\n  AiFillHeart,\n  BsTagFill,\n  GrTransaction,\n  MdShoppingCart,\n} from \"react-icons/all\";\nexport const WordsFamousNfts = [\n  {\n    img: nft3,\n  },\n  {\n    img: nft2,\n  },\n  {\n    img: nft1,\n  },\n  { img: nft4 },\n  { img: nft5 },\n  { img: nft6 },\n  { img: nft7 },\n];\n\nexport const iconByActivity = {\n  minted: <MdShoppingCart />,\n  transfer: <GrTransaction />,\n  list: <BsTagFill />,\n};\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",["636"],"import React, { useState } from \"react\";\nimport { useHistory } from \"react-router\";\nimport ImageLoader from \"../contentLoader/heroLoader\";\nimport { connect } from \"react-redux\";\n\nimport \"./HeroCards.css\";\nconst HeroCards = ({ data, connectedAddress, status }) => {\n  const { image, totalBids, owner, _id, ownerAddress, name } = data;\n  const [loader, setLoader] = useState(true);\n  const history = useHistory();\n  return (\n    <div className=\"hero-new-card\">\n      <div className=\"hero-img-container\">\n        <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n          <ImageLoader />\n        </div>\n        <img\n          src={status === \"nfts\" ? data.img : image}\n          onLoad={() => setLoader(false)}\n          alt=\"heroImg\"\n          style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n        />\n        {status !== \"nfts\" && (\n          <>\n            <div className=\"hero-owner text-center\">\n              <p>\n                Owned by:{\" \"}\n                <span className=\"text-capitalize\">\n                  {connectedAddress.toUpperCase() === ownerAddress.toUpperCase()\n                    ? \"You\"\n                    : owner?.username\n                    ? owner.username\n                    : \"unnamed\"}\n                </span>\n              </p>\n            </div>\n            <button\n              className=\"hero-btn-bid cursor-pointer\"\n              onClick={() => history.push(`/explore/nftdetail/${_id}`)}\n            >\n              View Detail\n            </button>\n          </>\n        )}\n      </div>\n      <div className=\"hero-placed-bid text-center\">\n        {status !== \"nfts\" ? (\n          <h6>\n            {totalBids > 0 ? `${totalBids} Person placed Bid` : \"No bid found\"}\n          </h6>\n        ) : (\n          <h6>{\"World's Famous NFTs \"}</h6>\n        )}\n      </div>\n    </div>\n  );\n};\nconst mapStateToProps = (state) => ({\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {})(HeroCards);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/auction-audio/auctionAudio.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/contentLoader/imageLoader.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/contentLoader/heroLoader.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/modals/BuyModal.js",["637","638","639","640","641"],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/offers/offers.action.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/bids/bids.action.js",["642","643"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n    //   console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        // console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/contentLoader/sellNFTLoader.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/modals/ApprovalModal.js",["644","645","646"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n  return (\n    <>\n      {\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title className=\"acc-title mt-lg-3 mt-5\">\n              {approvalStatus === \"approved\"\n                ? \"Congratulations\"\n                : approvalStatus === \"in-progress\"\n                ? \"We’re on it\"\n                : \"Your account if not approved yet.\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\" onClick={onHide}>\n              <button>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </Modal.Header>\n          <Modal.Body>\n            {approvalStatus === \"approved\" ? (\n              <>\n                <img src={Images.sellerTickIcon} className=\"success-icon\" />\n                <div className=\"w-100 px-4 mb-2\">\n                  <div className=\"acc-approved-container mt-5 mb-5\">\n                    <p className=\"acc-approved ms-4 mb-0\">\n                      Your Account has been approved.\n                    </p>\n                    <img src={Images.smile} className=\"smile-img\" />\n                  </div>\n                </div>\n              </>\n            ) : approvalStatus === \"in-progress\" ? (\n              <>\n                <div className=\"approval-spinner mb-4\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n                <p className=\"processing-title text-center w-100\">\n                  Processing...\n                </p>\n                <div className=\"w-100 px-3\">\n                  <p className=\"approve-msg text-start ms-3 mt-3 \">\n                    Wallet Address\n                  </p>\n                  <input\n                    className=\"input-common mb-5\"\n                    value={address}\n                    readOnly\n                  />\n                </div>\n              </>\n            ) : (\n              <>\n                <img\n                  src={Images.metamaskImg}\n                  className=\"approve-metamask-img\"\n                />\n                <div className=\" w-100 px-3\">\n                  <p className=\"approve-msg w-100 text-start ms-3 mt-3 \">\n                    Please approve your wallet address to reach us\n                  </p>\n                  <input className=\"input-common\" value={address} readOnly />\n                </div>\n                <button\n                  className=\"btn btn-linear-gradient mt-4 my-4 get-approved-btn\"\n                  disabled={approvalStatus === \"pending\"}\n                  onClick={() => approveAccount()}\n                >\n                  {approvalStatus === \"pending\" ? (\n                    <div\n                      class=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>\n                  ) : (\n                    \"Get Approved\"\n                  )}\n                </button>\n              </>\n            )}\n          </Modal.Body>\n        </Modal>\n       \n      }\n    </>\n  );\n};\nexport default ApprovalModal;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/collections-cards/CollectionsCard.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/audioPlayer/waveform/WaveForm.js",["647","648"],"import React, { Component } from \"react\";\nimport WaveSurfer from \"wavesurfer.js\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { ReactComponent as AudioIcon } from \"../../../assets/images/audio-icon.svg\";\nimport { WaveformContianer, Wave, PlayButton } from \"./Waveform.styled\";\nimport BackgroundImg from \"../../../assets/images/audio-bg.svg\";\n\nimport \"./WaveForm.css\";\n\nclass Waveform extends Component {\n  constructor(props) {\n    super(props);\n  }\n  state = {\n    playing: false,\n  };\n  componentDidMount() {\n    const track = document.querySelector(\"#track\");\n\n    this.waveform = WaveSurfer.create({\n      barWidth: 2,\n      cursorWidth: 1,\n      container: \"#waveform\",\n      backend: \"WebAudio\",\n      height: 80,\n      progressColor: \"#FFFFFF\",\n      responsive: true,\n      waveColor: \"#838383\",\n      cursorColor: \"transparent\",\n    });\n\n    this.waveform.load(track);\n  }\n\n  componentWillUnmount() {\n    this.setState({ playing: false });\n    this.waveform.playPause();\n  }\n\n  handlePlay = () => {\n    this.setState({ playing: !this.state.playing });\n    this.waveform.playPause();\n  };\n\n  render() {\n    return (\n      <WaveformContianer\n        className=\"wave-container px-4 px-xl-5\"\n        style={{\n          background: `rgba(0, 0, 0, 0.79)`,\n          display: `${!this.props.loader ? \"block\" : \"none\"}`,\n        }}\n      >\n        <PlayButton className=\"audio-btn\" onClick={this.handlePlay}>\n          {this.state.playing ? <BsFillPauseFill /> : <BsFillPlayFill />}\n        </PlayButton>\n        <div\n          className={`${\n            this.props.auction ? \"d-none\" : \"\"\n          } audio-icon-wrapper mt-5 d-flex justify-content-center`}\n        >\n          <AudioIcon />\n        </div>\n       <Wave\n          className={`${this.props.auction ? \"mt-5\" : \"\"} waves mb-3`}\n          id=\"waveform\"\n        />\n\n         <audio\n          id=\"track\"\n          onLoadStart={() => console.log(\"onload start\")}\n          oncanplay={() => {\n            this.props.onLoadCallback();\n          }}\n          onEnded={() => {\n            this.handlePlay();\n          }}\n          src={this.props.url}\n        /> \n        {\" \"}\n      </WaveformContianer>\n    );\n  }\n}\n\nexport default Waveform;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/modals/StatsModal.js",["649","650"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nconst StatsModal = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <form>\n          <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n            {stats &&\n              stats.length > 0 &&\n              stats.map((item, i) => {\n                return (\n                  <div\n                    className=\"row g-2 align-items-center justify-content-between mt-3\"\n                    key={i}\n                  >\n                    <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                      <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                        <div className=\"ps-2\">\n                          <h6>Name:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"text\"\n                            name=\"name\"\n                            maxLength=\"40\"\n                            value={item.name}\n                            onKeyDown={(e) =>\n                              firstInputCharacterSpace(e, item.name.length)\n                            }\n                            onChange={(e) => handleChange(i, e, \"stats\")}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                      <div className=\"d-flex align-items-center justify-content-between\">\n                        <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                          <div className=\"ps-2\">\n                            <h6>Value:</h6>\n                          </div>\n                          <div className=\"inp-container\">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              min=\"1\"\n                              maxLength=\"1\"\n                              onKeyDown={(e) => {\n                                decimalNumberValidator(e);\n                              }}\n                              value={item.value}\n                              onChange={(e) => {\n                                if (\n                                  +e.target.value > 5 ||\n                                  (+e.target.value <= 0 && item.value == \"\")\n                                  ||e.target.value.includes(\".\")\n                                ) {\n                                  return \"\";\n                                }\n                                handleChange(i, e, \"stats\");\n                              }}\n                              autoComplete=\"off\"\n                            />\n                          </div>\n                        </div>\n                        <div className=\"value-inp-of mx-3\">\n                          <h6>of</h6>\n                        </div>\n                        <div className=\"bid-inp-container modal-value-inp\">\n                          <div className=\"inp-container \">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              value={5}\n                              autoComplete=\"off\"\n                              className=\"text-center\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                      <div className=\"inp-close text-end me-2\">\n                        <button type=\"submit\">\n                          <img\n                            src={InputClose}\n                            alt=\"closemodal\"\n                            onClick={() => removeFormFields(i, \"stats\")}\n                          />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n          </div>\n        </form>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/modals/PropertiesModal.js",["651"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport { firstInputCharacterSpace } from \"./../../utils/functions\";\nconst PropertiesModal = (props) => {\n  const {\n    show,\n    onHide,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    properties,\n    onSave,\n  } = props;\n  const handleSubmit = () => {\n    if (properties && properties.length > 0) {\n      let isEmpty = properties.filter(\n        (item) => item.name === \"\" || item.type === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"properties\");\n      }\n    }\n  };\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Add Properties\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {properties.map((item, i) => {\n            return (\n              <div\n                className=\"row g-2 align-items-center justify-content-between mt-3\"\n                key={i}\n              >\n                <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Type:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"type\"\n                        maxLength=\"40\"\n                        value={item.type}\n                        onKeyDown={(e) =>\n                          firstInputCharacterSpace(e, item.type.length)\n                        }\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Name:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"name\"\n                        maxLength=\"40\"\n                        value={item.name}\n                        onKeyDown={(e) =>\n                          firstInputCharacterSpace(e, item.name.length)\n                        }\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                  <div className=\"inp-close text-end me-2\">\n                    <button onClick={() => removeFormFields(i, \"properties\")}>\n                      <img src={InputClose} alt=\"closemodal\" />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"properties\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={properties && properties.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default PropertiesModal;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/modals/LevelsModal.js",["652"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nconst LevelsModal = (props) => {\n  const {\n    show,\n    onHide,\n    levels,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    onSave,\n  } = props;\n\n  const handleSubmit = () => {\n    if (levels && levels.length > 0) {\n      let isEmpty = levels.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"levels\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Levels</Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {levels &&\n            levels.length > 0 &&\n            levels.map((item, i) => {\n              return (\n                <div\n                  className=\"row g-2 align-items-center justify-content-between  mt-3\"\n                  key={i}\n                >\n                  <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                    <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                      <div className=\"ps-2\">\n                        <h6>Name:</h6>\n                      </div>\n                      <div className=\"inp-container\">\n                        <input\n                          type=\"text\"\n                          name=\"name\"\n                          maxLength=\"40\"\n                          value={item.name}\n                          onKeyDown={(e) =>\n                            firstInputCharacterSpace(e, item.name.length)\n                          }\n                          onChange={(e) => handleChange(i, e, \"levels\")}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                    <div className=\"d-flex align-items-center justify-content-between\">\n                      <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                        <div className=\"ps-2\">\n                          <h6>Value:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={item.value}\n                            min=\"1\"\n                            maxLength=\"1\"\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            onChange={(e) => {\n                              if (\n                                +e.target.value > 5 ||\n                                (+e.target.value <= 0 && item.value == \"\") ||e.target.value.includes(\".\")\n                              ) {\n                                return \"\";\n                              }\n                              handleChange(i, e, \"levels\");\n                            }}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"value-inp-of mx-3\">\n                        <h6>of</h6>\n                      </div>\n                      <div className=\"bid-inp-container modal-value-inp\">\n                        <div className=\"inp-container \">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={5}\n                            autoComplete=\"off\"\n                            className=\"text-center\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                    <div className=\"inp-close text-end me-2\">\n                      <button>\n                        <img\n                          src={InputClose}\n                          alt=\"closemodal\"\n                          onClick={() => removeFormFields(i, \"levels\")}\n                        />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"levels\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3 \"\n            disabled={levels && levels.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default LevelsModal;\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/collections/popular-collections.js",["653","654","655","656","657","658"],"import React, { useState, useEffect } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n} from \"../collections/collections.actions\";\nimport { connect } from \"react-redux\";\nimport { Images } from \"../../assets/assets\";\n\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst PopularCollections = (props) => {\n  const [popular, setpopular] = useState([]);\n  const [categories, setCategories] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [popularSettings, settPopularSettings] = useState();\n  const [isActive, setIsActive] = useState(0);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.category.getAuth) {\n      setCategories(props.category.categories);\n    }\n  }, [props.category.getAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n      let popularCollectionsSettings = ENV.popularCollectionsSettings;\n      if (finalCollectionListing.length > 3) {\n        popularCollectionsSettings.infinite = true;\n      } else {\n        popularCollectionsSettings.infinite = false;\n      }\n      settPopularSettings(popularCollectionsSettings);\n      if (finalCollectionListing.length && finalCollectionListing.length > 8) {\n        setFilterationLoader(false);\n        setpopular(finalCollectionListing.slice(0, 7));\n      } else {\n        setpopular(finalCollectionListing);\n\n        setFilterationLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  const handleCategoryFilter = (desc) => {\n    setFilterationLoader(true);\n    props.beforePopularCollection();\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getPopularCollections(qs);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index && result.length !== 0) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-md-8\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content clr-blue\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-1\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products.{\" \"}\n                    <br className=\"d-none d-xxl-block\" /> We want to be a part\n                    of your smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\n              {categoryId === \"all\" && popular && popular?.length == 0 ? (\n                \"\"\n              ) : (\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      if (id <= 3) {\n                        return (\n                          <button\n                            key={id}\n                            className={`collection-category ${\n                              id === isActive ? \"home-active-category\" : \"\"\n                            } me-1 me-sm-3 me-lg-4`}\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      }\n                    })}\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\n                      to=\"/popular-collections\"\n                    >\n                      View All\n                      <img\n                        src={ViewAllIcon}\n                        alt=\"arrow-left\"\n                        className=\"ms-2 d-none d-sm-none\"\n                      />\n                    </Link>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n          {filterationLoader ? (\n            <div className=\"spinner-loader-wrapper\">\n              <div className=\"spinner-border text-secondary\" role=\"status\">\n                <span className=\"sr-only\">Loading...</span>\n              </div>\n            </div>\n          ) : popular && popular.length && popular.length > 0 ? (\n            <CardSlider\n              settings={ENV.popularCollectionsSettings}\n              data={popular}\n              homeAuction\n            >\n              {popular.map((item, i) => {\n                return (\n                  <CollectionsCard\n                    key={i}\n                    Subimg1={handleImage(item, 0)}\n                    Subimg2={handleImage(item, 1)}\n                    Subimg3={handleImage(item, 2)}\n                    collection={item}\n                    CardImg={item.featuredImg}\n                    name={item.name}\n                    id={item._id}\n                    userName={item.username[0]}\n                    NFTCount={item.totalNfts}\n                    profileImage={item.profileImage[0]}\n                    ownerAddress={item.ownerAddress}\n                    connectedAddress={props.connectedAddress}\n                    index={i}\n                  />\n                );\n              })}\n            </CardSlider>\n          ) : (\n            <p className=\"text-center not-found-title mt-5 py-5\">\n              No Popular Collections Found\n            </p>\n          )}\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n  connectedAddress: state.wallet.connectedAddress,\n\n});\n\nexport default connect(mapStateToProps, {\n  beforePopularCollection,\n  beforeCategory,\n  getCategories,\n  getPopularCollections,\n})(PopularCollections);\n","/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/buy-sell/Buysell.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/contentLoader/collectionSubLoader.js",[],"/home/usman/mintsclub-v2-io/frontend-v2/frontend/src/components/audioPlayer/waveform/Waveform.styled.js",[],{"ruleId":"659","severity":1,"message":"660","line":9,"column":10,"nodeType":"661","messageId":"662","endLine":9,"endColumn":15},{"ruleId":"663","replacedBy":"664"},{"ruleId":"665","replacedBy":"666"},{"ruleId":"659","severity":1,"message":"667","line":6,"column":10,"nodeType":"661","messageId":"662","endLine":6,"endColumn":20},{"ruleId":"659","severity":1,"message":"668","line":10,"column":10,"nodeType":"661","messageId":"662","endLine":10,"endColumn":26},{"ruleId":"659","severity":1,"message":"669","line":25,"column":9,"nodeType":"661","messageId":"662","endLine":25,"endColumn":17},{"ruleId":"670","severity":1,"message":"671","line":26,"column":13,"nodeType":"672","endLine":28,"endColumn":4},{"ruleId":"670","severity":1,"message":"673","line":28,"column":6,"nodeType":"674","endLine":28,"endColumn":11,"suggestions":"675"},{"ruleId":"659","severity":1,"message":"676","line":46,"column":11,"nodeType":"661","messageId":"662","endLine":46,"endColumn":23},{"ruleId":"670","severity":1,"message":"677","line":57,"column":6,"nodeType":"674","endLine":57,"endColumn":8,"suggestions":"678"},{"ruleId":"679","severity":1,"message":"680","line"