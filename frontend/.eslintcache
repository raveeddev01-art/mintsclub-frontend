277 5.16924 14.7311H4.93145V15.8539H19.7601V10.9895Z\"\n                                fill=\"#387FFF\"\n                              />\n                            </svg>\n                          </button>\n                        </DateRangePicker>\n                      </div>\n\n                      <div className=\"sell-time-inp mx-auto my-3\">\n                        <input\n                          type=\"time\"\n                          name=\"timedAuctionConfig.duration.startTime\"\n                          placeholder=\"Start Time\"\n                          className=\"py-1\"\n                          onChange={(e) => onChange(e)}\n                          defaultValue={timedAuctionConfig.duration.startTime}\n                          required\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                      <div className=\"sell-time-inp mx-auto my-3\">\n                        <input\n                          type=\"time\"\n                          name=\"timedAuctionConfig.duration.endTime\"\n                          placeholder=\"End Time\"\n                          className=\"py-1\"\n                          onChange={(e) => onChange(e)}\n                          defaultValue={timedAuctionConfig.duration.endTime}\n                          required\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"sell-detail-box\">\n                      <h5>Fees:</h5>\n                      <hr />\n                      <div className=\"fee-details d-flex align-items-center justify-content-between\">\n                        <div>\n                          <p>\n                            Service Fees:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                        <div>\n                          <p>\n                            Creator Royalty:\n                            <span className=\"ms-2\">2.5%</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"sell-btn-container d-flex justify-content-center justify-content-lg-start\">\n                    <button\n                      className=\"btn btn-linear-gradient sell-btn-completed\"\n                      type=\"submit\"\n                    >\n                      Complete Listing\n                    </button>\n                  </div>\n                </div>\n              </form>\n            )}\n            \n          </div>\n        </div>\n        <ApprovalModal\n          show={show}\n          approveAccount={approveAccount}\n          approvalStatus={approvalStatus}\n          onHide={() => setShow(false)}\n          address={address}\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  error: state.error,\n  nftDetail: state.nft.nftsData,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  beforeTogleLikeDislike,\n  createActivity,\n  updateProfile,\n  emptyError,\n})(SellNFT);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/explore-collections.js",["468","469","470","471"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport \"./explore-collections.css\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"./collections.actions\";\nimport { Images } from \"../../assets/assets\";\n\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { beforeCategory, getCategories } from \"./collections.actions\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index&&result.length!==0) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  const bannerData = {\n    subHeading: \"Collections\",\n    heading: \"Explore all\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper pt-0\">\n          <Banner\n            subHeading={bannerData.subHeading}\n            heading={bannerData.heading}\n            content={bannerData.content}\n            bgImg={BannerBg}\n            bannerImg={BannerImage}\n          />\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, index) => {\n                      return (\n                        <button\n                          key={index}\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, index) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\" key={index}>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-1 align-items-center justify-content-center\">\n              {loader ? (\n                <div className=\"spinner-border\" role=\"status\">\n                  <span className=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection, index) => {\n                  return (\n                    <div className=\"col-sm-6 col-md-4 col-xl-3\" key={index}>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : \"\"\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 d-flex justify-content-center align-items-center\">\n                  {!empty &&\n                    collections?.length === 10 &&!loader&&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-rounded-bordered px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more...\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n          <OwnCollectionToday />\n        </section>\n      )}\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["472","473","474","475","476","477"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport \"./collectiondetails.css\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport FilterComponent from \"../filterComponent/filterComponent\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport { Images } from \"../../assets/assets\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst CollectionDetailsPage = (props) => {\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const location = useLocation();\n\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      if (props?.nfts?.length > 0) {\n        setDisabled(false);\n      } else {\n        if (initial) {\n          setDisabled(true);\n        }\n      }\n      setNfts(props.nfts);\n      setNFTPagination(props.pagination);\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        limit,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      nftQS.collectionId = location.state._id;\n\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n      if (page) {\n        nftQS.page = page;\n      } else {\n        nftQS.page = 1;\n      }\n      if (limit) {\n        nftQS.limit = limit;\n      } else {\n        nftQS.limit = 10;\n      }\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n  ///////////Likes\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const fetchData = (filterObj) => {\n    getNFTs(filterObj);\n  };\n  const { name, logo, description, username } = location.state;\n  const bannerData = {\n    subHeading: \"Nfts\",\n    heading: \"Collections Info\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"d-flex flex-column flex-md-row align-items-center align-items-sm-start\">\n                  <div className=\"ms-lg-5 collection-owner-avatar user-avatar-container me-3 flex-fill\">\n                    <img\n                      src={logo ? logo : Images.profilePlaceholder}\n                      alt=\"owner-avatar\"\n                    />\n                  </div>\n                  <div className=\"collection-owner-detail text-center text-sm-start mt-2 mt-sm-4\">\n                    <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n                      <div className=\"collection-owner-name\">\n                        <h3>\n                          {name}{\" \"}\n                          <span>\n                            <img\n                              src={TickIcon}\n                              alt=\"tick-icon\"\n                              className=\"ms-2\"\n                            />\n                          </span>\n                        </h3>\n                      </div>\n                      <div>\n                        <p>\n                          Created By: <span>{username?.[0]}</span>\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-description mt-3\">\n                      <p>{description && description} </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-7 col-md-6 col-lg-5\"></div>\n            </div>\n          </div>\n        </div>\n        {loader && <FullPageLoader />}\n        <FilterComponent\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={loader}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          path=\"/explore/nftdetail/\"\n          collectionDetail\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftsData.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n})(CollectionDetailsPage);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["478","479","480","481","482","483","484","485","486","487","488","489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504","505","506","507","508","509","510","511","512","513","514"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["515","516","517","518","519","520","521","522","523","524","525","526","527","528","529","530","531","532","533","534","535"],"import React, { useEffect, useState } from \"react\";\n\nimport \"./user-edit-profile.css\";\n\n/////////\n\nimport { connect } from \"react-redux\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { ENV } from \"./../../config/config\";\nimport { Images } from \"../../assets/assets\";\nimport { useHistory } from \"react-router-dom\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport Compressor from \"compressorjs\";\nconst EditProfile = (props) => {\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [copy, setCopy] = useState(false);\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const [bioError, setBioError] = useState(false);\n  const [userProfile, setUserProfile] = useState({});\n  const [user, setUser] = useState(null);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n  \n  useEffect(() => {\n    if (props.error !== null) {\n      setLoader(false);\n      toast.error(props.error.messasge);\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      setUser(props.user.individualUser);\n      props.beforeUser();\n      setLoader(false);\n\n      setConnectedAddress(address ? address : \"\");\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      setBannerUrl(bannerImage ? bannerImage : \"\");\n      setImage(profileImage ? profileImage : \"\");\n      setBannerImage(bannerImage ? bannerImage : \"\");\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      setLoader(false);\n      props.beforeUser();\n      toast.success(\"Profile Updated SuccessFully\");\n      history.push(\"/userprofile\");\n    }\n  }, [props.user.userAuth]);\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    let sizeBeforeCompress = formatBytes(file.size);\n    console.log(sizeBeforeCompress, \"seizeBeforecompress\");\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n        return toast.error(\"Invalid File\");\n      }\n      setImageUrl(fileURL);\n      // setImage(file);\n\n      new Compressor(file, {\n        quality: 0.2,\n        success(result) {\n          console.log(result, \"result==>\");\n          setImage(result);\n\n          let sizeAfterCompress = formatBytes(result.size);\n          console.log(sizeAfterCompress, \"sizeAfterCompress\");\n        },\n        error(err) {\n          console.log(err.message);\n        },\n      });\n    }\n  };\n  const formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n\n    if (description && description.length < 3) {\n      setBioError(true);\n      return \"\";\n    } else {\n      setBioError(false);\n    }\n    setErrors(\"\");\n    setLoader(true);\n    // let signature = await signRequest();\n    setLoader(true);\n\n    var formData = new FormData();\n    formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n    console.log(image,\"image while submiting\")\n    if (image) {\n      formData.append(\"profileImage\", image);\n    }\n    if (banner) {\n      formData.append(\"bannerImage\", banner);\n    }\n    formData.append(\"bio\", description);\n    formData.append(\"twitterLink\", twitterLink);\n    formData.append(\"username\", username);\n    formData.append(\"email\", email);\n    formData.append(\"webLink\", webLink);\n    formData.append(\"instaLink\", instaLink);\n\n    // return ''\n    props.updateProfile(formData);\n  };\n  const bannerData = {\n    subHeading: \"Information\",\n    heading: \"User Profile\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile padding-wrapper pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        {loader && <FullPageLoader />}\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <form onSubmit={submit}>\n              <div className=\"row\">\n                <div className=\"col-12 mt-5\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {image && image ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={imageUrl ? imageUrl : Images.logoImage}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={imageUrl ? imageUrl : Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">\n                      Profile Image*\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Username:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    required\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && username === \"\") {\n                        return false;\n                      } else {\n                        setUsername(e.target.value);\n                      }\n                    }}\n                    value={username}\n                    placeholder=\"Username\"\n                    maxLength=\"55\"\n                    minLength=\"3\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">\n                    Email Address:*\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Email Address\"\n                    required\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && email === \"\") {\n                        return \"\";\n                      } else {\n                        setEmail(e.target.value);\n                      }\n                    }}\n                    value={email}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Wallet Address:\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"URL\"\n                    required\n                    readOnly={true}\n                    autoComplete=\"off\"\n                    value={address}\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">BioData:</label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Enter BioData\"\n                    maxLength=\"500\"\n                    minLength=\"3\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && description === \"\") {\n                        return false;\n                      } else {\n                        setDescription(e.target.value);\n                      }\n                    }}\n                    value={description}\n                  ></textarea>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Twitter Link:\n                  </label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && twitterLink === \"\") {\n                        return false;\n                      } else {\n                        setTwitterLink(e.target.value);\n                      }\n                    }}\n                    value={twitterLink}\n                    placeholder=\"Twitter Link\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0  mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Instagram Link:\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Instagram Link\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && instaLink === \"\") {\n                        return false;\n                      } else {\n                        setInstaLink(e.target.value);\n                      }\n                    }}\n                    value={instaLink}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0  mt-3 mt-lg-5 \">\n                  <label className=\"create-collection-label\">\n                    Website Link:\n                  </label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Website Link\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && webLink === \"\") {\n                        return false;\n                      } else {\n                        setWebLink(e.target.value);\n                      }\n                    }}\n                    value={webLink}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    type=\"submit\"\n                  >\n                    Save Changes\n                  </button>\n                </div>\n              </div>\n            </form>\n          </div>\n        </div>\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n  emptyError,\n})(EditProfile);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["536","537","538","539","540","541","542","543","544"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["545","546","547"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card top-seller-card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["548","549","550","551","552","553","554"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { connect } from \"react-redux\";\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\nimport { getCreators } from \"./../user/user.action\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst AuctionsList = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [auctions, setAuctions] = useState(null);\n  const [loader, setLoader] = useState(true); // auctions loader\n  const [categories, setCategories] = useState([]);\n  const [categoryId, setCategoryId] = useState(\"all\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    // get live auctions\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n    props.getCreators();\n  }, []);\n\n  // set live auctions\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions } = props.auction;\n\n      setAuctions(auctions);\n      setLoader(false);\n      props.beforeAuction();\n    }\n  }, [props.auction.auctionsAuth]);\n  useEffect(() => {\n    props.getCategories();\n  }, []);\n  useEffect(() => {\n    if (props.collectionFlag) {\n      setCategories(props.categories);\n    }\n  }, [props.collectionFlag]);\n\n  const handleCategoryFilter = (desc) => {\n    setLoader(true);\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getLiveAuctions(qs);\n  };\n  const bannerData = {\n    subHeading: \"Auctions\",\n    heading: \"Live Auctions\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <section className=\"explore-collection-section padding-wrapper\">\n        {\n          // loader ? (\n          //   <FullPageLoader />\n          // ) : (\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Auctions</span>\n                    <h3 className=\"mb-0\">Live Auctions</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categoryId === \"all\" &&\n                  (!auctions || (auctions && auctions?.length <= 1)) &&\n                  !loader\n                    ? \"\"\n                    : categories &&\n                      categories.length > 0 &&\n                      categories.map((item, id) => {\n                        return (\n                          <div className=\"col-6 col-sm-3\">\n                            <button\n                              onClick={() => {\n                                setIsActive(id);\n                                handleCategoryFilter(item.description);\n                              }}\n                              className={`${\n                                id === isActive ? \"active-explore-nav\" : \"\"\n                              } me-2 me-xl-3`}\n                            >\n                              {item.name}\n                            </button>\n                          </div>\n                        );\n                      })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border\" role=\"status\"></div>\n              ) : auctions && auctions.length > 0 ? (\n                auctions.map((item, index) => {\n                  return (\n                    <div className=\"col-11 col-sm-6 col-md-5 col-lg-4 col-xl-3\">\n                      <AuctionsCards\n                        key={index}\n                        item={item}\n                        ownerName={item.owner.username}\n                        userId={ENV.getUserKeys(\"_id\")._id}\n                        ownerId={item.owner._id}\n                        bidsProfile={item.bidInfo.bidByProfile}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center mt-5\">No Live Auctions Found</p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {auctions &&\n                    props.auction.pagination.total > auctions.length &&\n                    auctions.length > 10 && (\n                      <button className=\"btn btn-linear-gradient px-5\">\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        }\n        <OwnCollectionToday />\n      </section>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  auction: state.auction,\n  user: state.user,\n  collectionFlag: state.collection.collectionFlag,\n  categories: state.collection.categories,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n  getCreators,\n  getCategories,\n  beforeCategory,\n})(AuctionsList);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["555","556","557","558","559","560","561","562","563","564"],"import React, { Component } from \"react\";\nimport Footer from \"../footer/footer\";\nimport \"./CreateCollections.css\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport Select from \"react-select\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        logoUrl: \"\",\n        bannerUrl: \"\",\n        featuredImgUrl: \"\",\n        description: \"\",\n      },\n      categories: null,\n      selectedCategory: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate(prevProps) {\n    if (this.props.error !== null && prevProps.error === null) {\n      toast.error(this.props.error.message);\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      let updatedCategories = [];\n      for (var item of categories) {\n        let obj = {\n          value: item._id,\n          label: item.name,\n        };\n        updatedCategories.push(obj);\n      }\n      this.setState({ categories: updatedCategories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let fileSize = this.formatBytes(file.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n         return  toast.error(\"File Max Limit Reached.\")\n        }\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n        \n      }\n  }\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  handleSelectChange = (selectedOption) => {\n    console.log(selectedOption, \"selected \");\n    let { collection } = this.state;\n    collection = { ...collection, categoryId: selectedOption.value };\n    this.setState({\n      selectedOption,\n      collection,\n    });\n  };\n  handleValidation = () => {\n    console.log(\"func\");\n    const { categoryId, logo, name, description, featuredImg } =\n      this.state.collection;\n    console.log(this.state.collection, \"collection\");\n    if (\n      description === \"\" ||\n      logo === \"\" ||\n      categoryId === \"\" ||\n      name === \"\" ||\n      featuredImg === \"\"\n    ) {\n      return true;\n    } else {\n      return false;\n    }\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: \"\", featuredImgUrl: \"\" };\n    this.setState({ collection });\n  };\n\n  render() {\n    const {\n      collection,\n      errors,\n      loader,\n      isSubmitted,\n      categories,\n      selectedOption,\n    } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      const bannerData = {\n        subHeading: \"Create New\",\n        heading: \"Create New Collection\",\n        content:\n          \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n      };\n      //create collection max size validation\n      return (\n        <>\n          {loader && <FullPageLoader />}\n          <section className=\"create-collection\">\n            <Banner\n              subHeading={bannerData.subHeading}\n              heading={bannerData.heading}\n              content={bannerData.content}\n              bgImg={BannerBg}\n              bannerImg={BannerImage}\n            />\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"upload-container flex-md-row flex-column align-items-center align-items-md-end ps-md-5 ps-0\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {collection && collection.logo ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={collection.logoUrl}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => this.onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => this.onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">Logo Image*</p>\n                  </div>\n                  <div className=\"feature-wrapper pt-md-0 pt-5\">\n                    <div className=\"feature-image\">\n                      <span className=\"feature-img-round\">\n                        {collection && collection.featuredImg ? (\n                          <img\n                            className=\"uploaded-feature-img\"\n                            src={collection.featuredImgUrl}\n                          />\n                        ) : (\n                          <label className=\"upload-icon\">\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                            <img src={Images.featureImageInputBG} />\n                            <div className=\"feature-img-round-info\">\n                              <p className=\"text-center mb-2 browse-file\">\n                                Browse Files\n                              </p>\n                              {/* <p className=\"mb-0\">PNG, GIF, WEBP, MP4, MP3 </p> */}\n                              <p className=\"text-center mb-0\">Max 100mb</p>\n                            </div>\n                          </label>\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-feature-icon\">\n                      <label>\n                        <input\n                          id=\"featuredImg\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          style={{ display: \"none\" }}\n                          name=\"featuredImg\"\n                          onChange={(e) => this.onFileChange(e)}\n                        />\n                        <img src={Images.editIconLarge} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2 text-center text-md-start\">\n                      Feature Image*\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Name:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.name}\n                    placeholder=\"Name\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">URL:</label>\n                  <span className=\"text-danger position-absolute top-0\">\n                    {this.validator.message(\"url\", collection.url, \"url\")}\n                  </span>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"URL\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.url}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Select Category:*\n                  </label>\n\n                  <Select\n                    className=\"react-select-cls\"\n                    classNamePrefix=\"react-select\"\n                    value={selectedOption}\n                    isSearchable={false}\n                    onChange={this.handleSelectChange}\n                    options={categories}\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Description:*\n                  </label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Description\"\n                    maxLength=\"500\"\n                    rows=\"3\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.description}\n                  ></textarea>\n                </div>\n\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    disabled={this.handleValidation()}\n                    onClick={(e) => this.submit(e)}\n                  >\n                    Create Collection\n                  </button>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n\n          {/* <section className=\"edit-profile padding-wrapper create-collection-container\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Create Now</span>\n                      <h3 className=\"mb-0\">Create New Collection</h3>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Logo Image*</h6>\n                    <span className=\"text-danger\">\n                      {this.validator.message(\n                        \"logo\",\n                        collection.logo,\n                        \"required\"\n                      )}\n                    </span>\n                  </div>\n                  <div className=\"collection-logo-container pt-2\">\n                    {collection && collection.logo ? (\n                      <img\n                        src={collection.logoUrl}\n                        className=\"colection-avatar-img\"\n                      />\n                    ) : (\n                      <div className=\"colection-avatar\"></div>\n                    )}\n                    <label>\n                      <div className=\"avatar-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        id=\"logo\"\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => this.onFileChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"logo\"\n                      />\n                    </label>\n                  </div>\n                  <div className=\"\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Featured Image*</h6>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"logo\",\n                          collection.featuredImg,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-featured-container\">\n                      {collection && collection.featuredImg ? (\n                        <div className=\"uploaded-featured-container\">\n                          <img\n                            src={collection.featuredImgUrl}\n                            className=\"uploaded-featured-img\"\n                          />\n                          <div className=\"uploaded-featured-hover w-100\">\n                            <div className=\"uploaded-featured-cross\">\n                              <MdClose\n                                color=\"#e33d0bc2\"\n                                className=\"uploaded-cross-icon\"\n                                onClick={() => this.clearData()}\n                              />\n                            </div>\n                            <label>\n                              <div className=\"text-center\">\n                                <img src={UploadIcon} alt=\"upload-icon\" />\n                              </div>\n                              <input\n                                id=\"featuredImg\"\n                                type=\"file\"\n                                accept=\".png,.jpeg,.jpg\"\n                                style={{ display: \"none\" }}\n                                name=\"featuredImg\"\n                                onChange={(e) => this.onFileChange(e)}\n                              />\n                            </label>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className=\"upload-featured-img\">\n                          <label>\n                            <div className=\"text-center\">\n                              <img\n                                src={CollectionUploadIcon}\n                                alt=\"upload-icon\"\n                              />\n                            </div>\n                            <div className=\"upload-featured-img-content pt-2\">\n                              <h6 className=\"pb-1\">Browse Files</h6>\n                              <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                            </div>\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                          </label>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Name*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"name\",\n                            collection.name,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"name\"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.name}\n                          placeholder=\"Name\"\n                          maxLength=\"55\"\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>URL</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\"url\", collection.url, \"url\")}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"url\"\n                          type=\"text\"\n                          name=\"url\"\n                          placeholder=\"URL\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.url}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Select Category*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"category\",\n                            collection.categoryId,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <select\n                          id=\"category\"\n                          name=\"categoryId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Select Collection\n                          </option>\n                          {categories &&\n                            categories.map((category, index) => {\n                              return (\n                                <option key={index} value={category._id}>\n                                  {category.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                      </div>\n                    </div>\n                    <div className=\"col-md-8\">\n                      <div className=\"edit-inp-subheading pt-4\">\n                        <h6>Discription</h6>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <textarea\n                          name=\"description\"\n                          placeholder=\"Discription\"\n                          maxLength=\"500\"\n                          rows=\"3\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.description}\n                          \n                        ></textarea>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                  <div className=\"\">\n                    <button\n                      type=\"button\"\n                      className=\"btn btn-linear-gradient\"\n                      onClick={(e) => this.submit(e)}\n                    >\n                      Create Collection\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section> */}\n          {/* <Footer /> */}\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.reducer.js",["565","566"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["567"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["568"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["569"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["570","571","572","573","574","575","576","577","578"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/reducer/reducer.js",["579"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.reducer.js",["580"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["581"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["582"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["583"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["584"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["585"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",["586","587"],"import React, { Component } from \"react\";\nimport Footer from \"../../components/footer/footer\";\n\nimport Scrollup from \"../../components/scroll-up/sroll-up\";\n\nclass Layout3 extends Component {\n  render() {\n    return <div className=\"main\">{this.props.children}</div>;\n  }\n}\n\nexport default Layout3;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout/layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["588","589","590","591","592","593","594","595"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\n\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\n\r\nimport { getCreators } from \"./../user/user.action\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"all\");\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  const [isActive, setIsActive] = useState(0);\r\n  const [filterationLoader, setFilterationLoader] = useState(true);\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n      if (auctions) {\r\n        auctions.forEach((element, i) => {\r\n          auctions[i].totalBids = element.bidInfo?.bidBy?.length;\r\n        });\r\n      }\r\n\r\n      setAuctions(auctions);\r\n      setFilterationLoader(false);\r\n\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  useEffect(() => {\r\n    const interval = setInterval(() => {\r\n      checkIfAuctionEnded();\r\n    }, 3000);\r\n    return () => clearInterval(interval);\r\n  }, [auctions]);\r\n\r\n  const checkIfAuctionEnded = () => {\r\n    if (auctions&&auctions?.length > 0) {\r\n      auctions.forEach((item, index) => {\r\n        let auctionEndDate = new Date(item.auctionEndDate);\r\n        let currentDate = new Date();\r\n        if (currentDate > auctionEndDate) {\r\n          let updatedAuctions = [...auctions];\r\n          updatedAuctions.splice(index, 1);\r\n          setAuctions(updatedAuctions);\r\n        }\r\n      });\r\n    }\r\n  };\r\n\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setFilterationLoader(true);\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-md-8\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content clr-yellow\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products.{\" \"}\r\n                    <br className=\"d-none d-xl-block\" />\r\n                    We want to be a part of your smile, success and future\r\n                    growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\r\n              {categoryId === \"all\" &&\r\n              (!auctions || (auctions && auctions?.length <= 1)) &&\r\n              !filterationLoader ? (\r\n                \"\"\r\n              ) : (\r\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                  {categories &&\r\n                    categories.length > 0 &&\r\n                    categories.map((item, id) => {\r\n                      if (id <= 3) {\r\n                        return (\r\n                          <button\r\n                            key={id}\r\n                            className={`${\r\n                              id === isActive ? \"home-active-category\" : \"\"\r\n                            } me-1 me-sm-3 me-lg-4`}\r\n                            onClick={() => {\r\n                              setIsActive(id);\r\n                              handleCategoryFilter(item.description);\r\n                            }}\r\n                          >\r\n                            {item.name}\r\n                          </button>\r\n                        );\r\n                      }\r\n                    })}\r\n                  <div className=\"intro-btn\">\r\n                    <Link\r\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                      to=\"/auctions\"\r\n                    >\r\n                      View All\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auctions-slides\">\r\n            <>\r\n              {filterationLoader ? (\r\n                <div className=\"spinner-loader-wrapper\">\r\n                  <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                    <span className=\"sr-only\">Loading...</span>\r\n                  </div>\r\n                </div>\r\n              ) : auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item, index) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        cardBg={\"card-bg-gray\"}\r\n                        key={index}\r\n                        item={item}\r\n                        ownerName={item.owner.username}\r\n                        userId={ENV.getUserKeys(\"_id\")._id}\r\n                        ownerId={item.owner._id}\r\n                        bidsProfile={item.bidInfo.bidByProfile}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className=\"text-center\">No Live Auctions Found</p>\r\n              )}\r\n            </>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topseller.js",["596","597"],"import React, { useEffect, useState } from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { getTopSellers, beforeUser } from \"../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\r\nimport \"./topseller.css\";\r\nimport { Images } from \"../../assets/assets\";\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n  const [loader, setLoader] = useState(true);\r\n\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.user.topSellersAuth) {\r\n      const { topSellers } = props.user.sellers;\r\n      setLoader(false);\r\n      if (topSellers?.length > 11) {\r\n        setSellers(topSellers.slice(0, 11));\r\n      } else {\r\n        setSellers(topSellers);\r\n      }\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content clr-blue\">\r\n                <span>Creative Artists</span>\r\n                <h3 className=\"mb-5\">Top Sellers</h3>\r\n              </div>\r\n              {sellers && sellers.length > 12 && props.viewAll && (\r\n                <div className=\"intro-btn mb-5\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll \"\r\n                    to=\"/top-sellers-list\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row g-3 items\">\r\n          {loader ? (\r\n            <div className=\"top-seller spinner-loader-wrapper\">\r\n              <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                <span className=\"sr-only\">Loading...</span>\r\n              </div>\r\n            </div>\r\n          ) : sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              return (\r\n                <div\r\n                  key={`ts_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                >\r\n                  {/* Single Seller */}\r\n                  <div className=\"card top-seller-card\">\r\n                    <div className=\"single-seller d-flex align-items-center\">\r\n                      <div className=\"seller-avatar-container\">\r\n                        <img\r\n                          className=\"avatar-md rounded-circle\"\r\n                          src={\r\n                            author.profileImage === null\r\n                              ? Images.placeholderImg\r\n                              : author.profileImage\r\n                          }\r\n                          alt=\"AvatarImg\"\r\n                        />\r\n                        {author.profileImage ? (\r\n                          <span className=\"seller-avatar-active\">\r\n                            <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                          </span>\r\n                        ) : (\r\n                          \"\"\r\n                        )}\r\n                      </div>\r\n\r\n                      {/* Seller Info */}\r\n                      <div className=\"seller-info ml-3 w-100\">\r\n                        <p className=\"seller mb-2\">{author.username}</p>\r\n                        <span className=\"text-end\">\r\n                          {\" \"}\r\n                          {author.totalETH.toFixed(2)}\r\n                        </span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          ) : (\r\n            <p className=\"text-center\">No Top Sellers Found</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/popular-collections.js",["598","599","600","601","602","603"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.actions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.action.js",["604","605"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n    console.log(data,\"data\")\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero/hero.js",["606","607","608","609"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport \"./hero.css\";\r\nimport Play from \"../../assets/images/play.svg\";\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport HeroCards from \"../hero-cards/HeroCards\";\r\nimport { ListingImg } from \"../../assets/assets\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeAuction, getLiveAuctions } from \"../auctions/auctions.action\";\r\nimport { connect } from \"react-redux\";\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n  const [auctions, setAuctions] = useState(null);\r\n  const heroSettings = ENV.heroSettings;\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n  useEffect(() => {\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions } = props.auction;\r\n      let updatedAuctions = [];\r\n      if (auctions.length > 0) {\r\n        updatedAuctions = auctions.filter((item) => item.fileType === \"image\");\r\n      }\r\n      if (updatedAuctions?.length > 6) {\r\n        updatedAuctions = updatedAuctions.slice(0, 6);\r\n      }\r\n      setAuctions(updatedAuctions);\r\n\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n  \r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, <br /> <span>and sell </span>\r\n              <br />\r\n              extraordinary <span> NFTs </span>\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                <p className=\"ms-1\">Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"watch-video d-flex align-items-center mt-5 mb-4\">\r\n              <button className=\"hero-play-btn\">\r\n                <img src={Play} alt=\"play\" />\r\n              </button>\r\n              <span className=\"ms-2\">Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6\">\r\n            <CardSlider settings={heroSettings}>\r\n              {auctions &&\r\n                auctions.length > 0 &&\r\n                auctions.map((auction, id) => {\r\n                  return (\r\n                    <HeroCards key={id} auction={auction} className=\"slide\" />\r\n                  );\r\n                })}\r\n            </CardSlider>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n})(Hero);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["610","611"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.js",["612","613","614","615","616","617"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport EmailIcon from \"../../assets/images/mailbox-icon.svg\";\nimport \"./footer.css\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  return (\n    <footer className=\"footer-area\">\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin  text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Who Are We?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/aboutus\">About Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/faqs\">FAQs</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Join MintsClub\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/login\">Sign In</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/Signup\">Sign Up</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Quick Links\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/auctions\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/popular-collections\">Popular Collections</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin\">\n              <div className=\"footer-items footer-notify-item text-center text-lg-end\">\n                <h4 className=\"footer-title\">\n                  Never Miss The NFT Beat! <br /> Subscribe To Our Latest News\n                </h4>\n                <div className=\"notify-form\">\n                  <div className=\"email-icon\">\n                    <img src={EmailIcon} alt=\"mail-box\" />\n                  </div>\n                  <input type=\"email\" placeholder=\"yourname@gmail.com\" />\n                  <div>\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Subscribe\n                    </button>\n                  </div>\n                </div>\n                <p>{data.desc}</p>\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-end\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/buy-sell/Buysell.js",["618","619"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\nimport BuyIcon from \"../../assets/images/buy-icon.svg\";\nimport SellIcon from \"../../assets/images/sell-icon.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./Buysell.css\";\n\nconst Buysell = () => {\n  return (\n    <section className=\"buy-sell-section padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row \">\n          <div className=\"col-sm-6\">\n            <div className=\"buy-card d-md-flex align-items-center\">\n              <div className=\"buy-card-img d-flex\">\n                <img src={Images.buyNft} alt=\"buy-logo\" className=\"mx-auto\" />\n              </div>\n              <div className=\"buy-card-content\">\n                <h5>Buy NFT Products</h5>\n                <p>Purchase digital NFT products from the biggest directory.</p>\n                <div className=\"d-flex justify-content-lg-end justify-content-center\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-start-selling text-right\"\n                    to=\"/explore/allNFT\"\n                  >\n                    Start buying\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-sm-6\">\n            <div className=\"sell-card d-md-flex align-items-center\">\n              <div className=\"buy-card-img d-flex\">\n                <img src={Images.sellNft} alt=\"buy-logo\" className=\"mx-auto\" />\n              </div>\n              <div className=\"buy-card-content \">\n                <h5>Sell Your NFT Products</h5>\n                <p>Sell one of your NFT products to make a huge profit.</p>\n                <div className=\"d-flex justify-content-lg-end justify-content-center\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-start-selling\"\n                    to=\"/userprofile\"\n                  >\n                    Start selling\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nexport default Buysell;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/own-collection-today/own-collection-today.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections-cards/CollectionsCard.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/banner/banner.js",["620"],"import React from \"react\";\nimport \"./banner.css\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst Banner = ({ subHeading, heading, content, bgImg, bannerImg }) => {\n  return (\n    <>\n      <div\n        className=\"banner-wrapper padding-wrapper\"\n        style={{ backgroundImage: `url(${bgImg})` }}\n      >\n        <div className=\"container\">\n          <div className=\"row align-items-end\">\n            <div className=\"col-md-9 col-lg-7\">\n              <div className=\"intro\">\n                <div className=\"intro-content clr-blue\">\n                  {subHeading && <span>{subHeading}</span>}\n                  {heading && <h3 className=\"mb-0\">{heading}</h3>}\n                  {content && <p className=\"pt-4\">{content}</p>}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-lg-5 d-none d-lg-block\">\n              <div className=\"banner-img\">\n                {bannerImg && <img src={bannerImg} alt=\"banner-img\" />}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Banner;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/filterComponent/filterComponent.js",["621","622","623"],"import React, { useState, useEffect } from \"react\";\nimport \"./filterComponent.css\";\nimport SearchIcon from \"../../assets/images/search-inp.svg\";\nimport NftCard from \"../nft-card/nft-card\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport Select from \"react-select\";\n\nconst FilterHoc = (props) => {\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [statusActive, setStatusActive] = useState(null);\n  const [filterActive, setFilterActive] = useState(false);\n  const [initial, setInitial] = useState(true);\n  const [selectedOption, setSelectedOption] = useState();\n  const [collectionActive, setCollectionActive] = useState(null);\n  const [isActive, setIsActive] = useState(1);\n  const [keyword, setKeyword] = useState(\n    props.initialKeyword ? props.initialKeyword : \"\"\n  );\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n    keyword: props.initialKeyword ? props.initialKeyword : \"\",\n  });\n\n  const priceOptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n  useEffect(() => {\n    const { initialKeyword } = props;\n    if (initialKeyword) {\n      setKeyword(initialKeyword);\n      handleSearchKeyword(initialKeyword);\n    }\n  }, [props.initialKeyword]);\n\n  useEffect(() => {\n    fetchData(filter);\n  }, [filter]);\n  const handleSelectChange = (selectedOption) => {\n    setSelectedOption(selectedOption);\n  };\n  const selectCustomStyles = {};\n\n  const statusData = [\"Buy Now\", \"On Auction\", \"New\"];\n  const handleFilters = () => {\n    setFilterActive(!filterActive);\n  };\n  const isHideCollection = () => {\n    if (props.UserProfile || props.collectionDetail) {\n      if (isActive === 1) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return true;\n    }\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n    setInitial(false);\n\n    const { label } = e;\n    if (label === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n    } else if (label === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    if (!UserProfile) {\n      setInitial(false);\n      setFilterationLoader(true);\n      setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    } else {\n      getPaginatedData();\n    }\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n  };\n\n  const handleSearchKeyword = (value) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, keyword: value }));\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    if (id === \"Buy Now\") {\n      setFilter((prev) => ({\n        ...prev,\n        buy: true,\n        auction: false,\n        newest: false,\n      }));\n    } else if (id === \"On Auction\") {\n      setFilter((prev) => ({\n        ...prev,\n        auction: true,\n        buy: false,\n        newest: false,\n      }));\n    } else {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        buy: false,\n        auction: false,\n      }));\n    }\n  };\n  const handleClearFilter = (id) => {\n    if (id === \"status\") {\n      setFilterationLoader(true);\n      setFilter((prev) => ({\n        ...prev,\n        buy: false,\n        auction: false,\n        new: false,\n      }));\n    } else if (id === \"price\") {\n      setFilterationLoader(true);\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setFilter((prev) => ({ ...prev, ltePrice: false, gtePrice: false }));\n    } else if (id === \"collections\") {\n      setFilterationLoader(true);\n      setFilter((prev) => ({ ...prev, collectionId: false }));\n    } else {\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setStatusActive(null);\n      setCollectionActive(null);\n      setSelectedOption(null);\n      setFilterActive(null);\n      setKeyword(\"\");\n      setFilter({\n        collectionId: false,\n        gtePrice: false,\n        ltePrice: false,\n        categoryId: false,\n        oldest: false,\n        lowToHigh: false,\n        highToLow: false,\n        newest: false,\n        page: filter.page,\n        limit: filter.limit,\n        buy: false,\n        auction: false,\n        latest: false,\n      });\n    }\n  };\n\n  const {\n    collections,\n    disabled,\n    menuData,\n    totalItems,\n    handleNftFilter,\n    setMenuFilter,\n    filterationLoader,\n    setFilterationLoader,\n    nfts,\n    loader,\n    likedNfts,\n    nftPagination,\n    handleLikesTogleApi,\n    fetchData,\n    path,\n    getPaginatedData,\n    UserProfile,\n  } = props;\n  return (\n    <div className=\"filterhoc-wrapper padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row justify-content-center justify-content-lg-start\">\n          <div className=\"col-12 order-0\">\n            <div\n              className={`d-flex flex-column flex-md-row align-items-center justify-content-md-between`}\n            >\n              <div className=\"search-input mb-4 mb-md-0\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Type here to Search...\"\n                  maxLength=\"50\"\n                  onChange={(e) => {\n                    if (keyword.trim() === \"\" && e.target.value.trim() === \"\") {\n                      return false;\n                    } else if (e.target.value === \"\") {\n                      handleSearchKeyword(false);\n                      setKeyword(e.target.value);\n                    } else {\n                      setKeyword(e.target.value);\n                    }\n                  }}\n                  onKeyPress={(e) =>\n                    e.key === \"Enter\" && handleSearchKeyword(keyword)\n                  }\n                  value={keyword}\n                />\n                <img src={SearchIcon} alt=\"search-input\" />\n              </div>\n              <div className=\"sort-by-select mb-4 mb-md-0\">\n                <p className=\"me-3\">Sort by:</p>\n                <Select\n                  className=\"react-select-cls\"\n                  classNamePrefix=\"react-select\"\n                  styles={selectCustomStyles}\n                  // defaultValue={priceOptions[3]}\n                  value={selectedOption}\n                  isSearchable={false}\n                  onChange={(value) => {\n                    handleSelectChange(value);\n                    handleSortOptions(value);\n                  }}\n                  options={priceOptions}\n                />\n              </div>\n              <div className=\"mob-filters-btn d-flex d-lg-none align-items-center justify-content-center\">\n                <button\n                  className={`${filterActive ? \"mob-active-filter\" : \"\"}`}\n                  onClick={handleFilters}\n                >\n                  Filters\n                </button>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-12 my-5 order-2 order-lg-1 \">\n            <div className=\"hero-nav d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n              <div>\n                {\" \"}\n                {menuData &&\n                  menuData.length > 0 &&\n                  menuData.map((item, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          setIsActive(id);\n                          handleNftFilter(item);\n                          setMenuFilter(item);\n                        }}\n                        className={`${\n                          id === isActive ? \"active-hero-nav\" : \"\"\n                        } me-2 me-xl-3`}\n                      >\n                        {item}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"total-items mt-3 mt-sm-0\">\n                <p>\n                  Total items: <span>{totalItems ? totalItems : 0}</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div\n            className={`${\n              filterActive ? \"d-block d-lg-block\" : \"d-none d-lg-block\"\n            } col-md-5 col-lg-4 col-xl-3 order-1 order-lg-2 mt-4 mt-lg-0`}\n          >\n            <div className=\"filter-container mb-4\">\n              <h6>Status</h6>\n              <hr />\n              <div className=\"d-flex flex-wrap align-items-center \">\n                {statusData &&\n                  statusData.map((status, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          handleStatusFilter(status);\n                          setStatusActive(id);\n                        }}\n                        className={`${\n                          id === statusActive ? \"active-filter-btn\" : \"\"\n                        } filter-btn me-3`}\n                      >\n                        {status}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {statusActive && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => {\n                      setStatusActive();\n                      handleClearFilter(\"status\");\n                    }}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            <div className=\"filter-container mb-4\">\n              <h6>Price</h6>\n              <hr />\n              <div className=\"min-max-inp d-flex flex-column flex-sm-row align-items-center justify-content-center justify-content-sm-between mb-2\">\n                <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-center\">\n                  <input\n                    type=\"number\"\n                    placeholder=\"Min\"\n                    className=\"me-sm-2\"\n                    value={minValue}\n                    onChange={onChangeMinPrice}\n                  ></input>\n                  <input\n                    type=\"number\"\n                    placeholder=\"Max\"\n                    className=\"mt-3 mt-sm-0\"\n                    value={maxValue}\n                    onChange={onChangeMaxPrice}\n                  ></input>\n                </div>\n                <button\n                  className=\"mt-3 mt-sm-0\"\n                  onClick={() => applyMinMaxFilter()}\n                  disabled={disabled || minValue === \"\" || maxValue === \"\"}\n                >\n                  Apply\n                </button>\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {minValue && maxValue && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => handleClearFilter(\"price\")}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            {isHideCollection() && (\n              <div className=\"filter-container mb-4\">\n                <h6>Collections</h6>\n                <hr />\n                <div className=\"d-flex flex-wrap align-items-center \">\n                  {collections &&\n                    collections.map((collection, id) => {\n                      return (\n                        <button\n                          key={id}\n                          onClick={() => {\n                            handleCollectionsFilter(collection._id);\n                            setCollectionActive(id);\n                          }}\n                          className={`${\n                            id === collectionActive ? \"active-filter-btn\" : \"\"\n                          } filter-btn me-2 me-xl-3`}\n                        >\n                          {collection.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"d-flex align-items-end justify-content-end\">\n                  {collectionActive !== null && (\n                    <button\n                      className=\"filter-clear-btn\"\n                      onClick={() => {\n                        setCollectionActive(null);\n                        handleClearFilter(\"collections\");\n                      }}\n                    >\n                      Clear\n                    </button>\n                  )}\n                </div>\n              </div>\n            )}\n            <div className=\"d-flex align-items-center justify-content-center btn-clear-all\">\n              <button onClick={() => handleClearFilter()}>\n                Clear All Filters\n              </button>\n            </div>\n          </div>\n          <div className=\"col-lg-8 col-xl-9 order-3\">\n            {loader ? (\n              <FullPageLoader />\n            ) : (\n              <div className=\"row g-1\">\n                {filterationLoader ? (\n                  <div className=\"text-center\">\n                    <div\n                      className=\"spinner-border text-secondary\"\n                      role=\"status\"\n                    >\n                      <span className=\"sr-only\">Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((nft, index) => {\n                    return (\n                      <div\n                        key={index}\n                        className=\"col-12 col-sm-6 col-md-4 col-lg-6 col-xl-4\"\n                      >\n                        {\n                          <NftCard\n                            data={nft}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            likedNfts={likedNfts}\n                            owner={nft.owner}\n                            path={path}\n                          />\n                        }\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center mt-5 no-nft-title\">No NFTs Found</p>\n                )}\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      nftPagination?.total > nfts.length &&\n                      !filterationLoader && (\n                        <button\n                          className=\"btn btn-rounded-bordered px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more...\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default FilterHoc;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.action.js",["624"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["625","626","627","628","629"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  CREATE_ACITIVITY,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n} from \"./../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       console.log(data)\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n        \n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n      \n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const update =\n  (body, qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .put(url, body)\n      .then(function (response) {\n        if (response.data.success) {\n        } else {\n        }\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n  };\n\nexport const createActivity = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}activity/create`;\n\n  axios\n    .post(url, body)\n    .then(function (response) {\n    \n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const getActivities =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}activity/get`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {\n       \n\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n  export const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {    \n        dispatch({\n          type:  GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n \n      })\n      .catch(function (error) {\n        console.log(error)\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n   \n      });\n  };\n\nexport const getNFTsByCollection = (id) => (dispatch) => {\n  let data = {\n    collectionId: id,\n  };\n\n  dispatch(emptyError());\n\n  const url = `${ENV.url}nfts/getNFTsByCollection`;\n  axios\n    .post(url, data)\n    .then(function (response) {\n      if (response.data.success) {\n        dispatch({\n          type: GET_NFTS_BY_COLLECTION,\n          payload: response.data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: response.data,\n        });\n      }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .get(url)\n      .then(function (response) {\n        console.log();\n        if (response.data.success) {\n          dispatch({\n            type: GET_MYLIKED_NFTS,\n            payload: response.data.data,\n          });\n        } else {\n        }\n      })\n      .catch(function (error) {\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const createNFT = async (formData) => async (dispatch)=>{\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n    \n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  try{\n\n    const res = await axiosPostFormData(\"nfts/storeNFTData\", formData, true);\n  }catch(error){\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       \n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n        } else {\n        }\n      })\n      .catch((errors) => {});\n  };\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["630"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-card/nft-card.js",["631","632","633","634","635","636","637","638","639","640","641"],"import React from \"react\";\nimport { Card, Image } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\n\nimport { ENV } from \"../../config/config\";\nimport useVideoPlayer from \"../test-video-card/components/useVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { connect } from \"react-redux\";\nimport \"./nft-card.css\";\nimport { Images } from \"../../assets/assets\";\nimport { LazyLoadImage } from 'react-lazy-load-image-component';\nconst NFTCard = (props) => {\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n  const {\n    image,\n    name,\n    _id,\n    fileType,\n    owner,\n    cardBg,\n    userId,\n    ownerId,\n    likeCount,\n    sellingMethod,\n    auctionStartDate,\n    auctionEndDate,\n    currentPrice,\n    copies,\n    remainingCopies\n    \n  } = props.data;\n\n  const { username, profileImage,profilePhoto } = props.owner;\n  const user=ENV.getUserKeys(\"_id\")._id\n  const { likedNfts } = props;\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n  return (\n    <Card className={`auction-card nft-card ${cardBg} m-1`}>\n      <div className=\"auction-img-wrapper\">\n        {fileType === \"image\" ? (\n          <Card.Img variant=\"top\" src={image} alt=\"AuctionTopImg\" />\n          // <LazyLoadImage\n          // alt={Image}\n          // // height={40}\n          // src={image} // use normal <img> attributes as props\n          // // width={40} \n          // />\n        ) : (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <video\n                src={image}\n                ref={videoElement}\n                onTimeUpdate={handleOnTimeUpdate}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n      <Card.Body>\n        <Card.Title>\n          <div>\n            {name && name.length > 10 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <span className=\"me-2\">{likeCount ? likeCount : 0}</span>\n            {!validateIfLiked(likedNfts, _id) ? (\n              <img\n                src={Images.whiteEmptyHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"like\", likeCount);\n                }}\n              />\n            ) : (\n              <img\n                src={Images.whiteFillHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"dislike\", likeCount);\n                }}\n              />\n            )}\n          </div>\n        </Card.Title>\n        <div className=\"nft-status \">\n          <div className=\"status-info status-sold\">\n            <span className=\"status\">\n              Sold: <span className=\"status-count\">{copies - remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n          <div className=\"status-info status-remaining\">\n            <span className=\"status\">\n              Remaining: <span className=\"status-count\">{remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-3\">\n          <span className=\"nft-price mt-2\">\n            <img className=\"me-2\" src={Images.nftPriceTag} />\n            Price:<a className=\"price\">{currentPrice} ETH</a>\n          </span>\n        </div>\n        <div className=\"auction-card-owner-container d-flex align-items-center mb-2 mt-3\">\n          <div className=\"auction-owner-avatar\">\n            <img\n              src={(profilePhoto===null&&profileImage===null)?Images.placeholderImg:profilePhoto ? profilePhoto : profileImage}\n              alt=\"avatar\"\n            />\n          </div>\n          <div className=\"ms-2 auction-owner-name\">\n            <p>\n              {\"Owned by \"}\n              <span>\n                {ownerId===user?\"You\":username && username?.length > 8\n                  ? username.substring(0, 6) + \"...\"\n                  : username?.length <= 8\n                  ? username\n                  : \"unnamed\"}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn\"\n          onClick={() => history.push(`${props.path}${_id}`)}\n        >\n          {\"View Detail\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state in nfts\"),\n  ({});\n\nexport default connect(mapStateToProps, {})(NFTCard);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/videoCard.js",["642"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/levelsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/statsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BidModal.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BuyModal.js",["643","644","645","646"],"import React, { useState } from \"react\";\nimport { Modal, Button, Spinner } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport { ReactComponent as FbIcon } from \"../../assets/images/fb-blue.svg\";\nimport { ReactComponent as TwitterIcon } from \"../../assets/images/twitter-blue.svg\";\nimport { ReactComponent as LinkedinIcon } from \"../../assets/images/linkedin-blue.svg\";\nimport { ReactComponent as InstaIcon } from \"../../assets/images/insta-blue.svg\";\nimport ModalSmiley from \"../../assets/images/model-smiley.svg\";\n\nconst BuyModal = (props) => {\n  const [purchase, setPurchase] = useState(true);\n  const [checkBox, setCheckBox] = useState(false);\n  const {\n    name,\n    image,\n    price,\n    exchangeRate,\n    tokenId,\n    modal,\n    setModal,\n    buyNow,\n    confirmed,\n    transactionHash,\n    transactionSuccess,\n    onHide,\n    disabled,\n    balance\n  } = props;\n\n  return confirmed === \"\" || confirmed === false||confirmed===\"pending\" ? (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Complete Checkout\n        </Modal.Title>\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to buy this NFT\"}\n        </p>\n        <div className=\"modal-close-container\">\n          <Button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                <img src={image} alt=\"nft-img\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container\">\n            {checkBox ? (\n              <div\n                className=\"custom-checked-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <img src={TickIcon} alt=\"checked\" />\n              </div>\n            ) : (\n              <div\n                className=\"custom-uncheck-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></div>\n            )}\n            <p>\n              By checking this box,I agree to MintsClub{\" \"}\n              <Link>Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => {\n            buyNow();\n          }}\n          disabled={!checkBox ||disabled||+price > +balance }\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n        >\n          {\n            confirmed===\"pending\"?\n            <div\n                      class=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>:\" Confirm Checkout\"\n          }\n         \n        </button>\n      </Modal.Footer>\n    </Modal>\n  ) : (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal purchase-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          {!transactionSuccess\n            ? \"Your Purchase is Processing\"\n            : \"Your Purchase has processed!\"}\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"modal-nft-purchased  mt-3\">\n          {!transactionSuccess ? (\n            <p>\n              <span className=\"me-4\">\n                <img src={ModalSmiley} alt=\"smiley\" />\n              </span>\n              {`  Woo! You just Purchased ${\n                name && name.length > 10 ? name.slice(0, 10) + \"...\" : name\n              }. It should be confirmed on the\n              blockchain shortly`}\n            </p>\n          ) : (\n            <p>\n              {\" \"}\n              {`  Woo! You just Purchased ${\n                name && name.length > 10 ? name.slice(0, 10) + \"...\" : name\n              }. It's been confirmed on the\n              blockchain shortly`}\n            </p>\n          )}\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                <img src={image} alt=\"nft-img\" />\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n        <div className=\"buy-modal-subheadings-container buy-modal-status w-100 d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Status</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Transaction Hash</p>\n          </div>\n        </div>\n        <div className=\"modal-status-content d-flex align-items-center justify-content-between mt-2 pb-5\">\n          <div className=\"status-process d-flex align-items-center\">\n            {!transactionSuccess ? (\n              <>\n                <Spinner\n                  animation=\"border\"\n                  role=\"status\"\n                  size=\"sm\"\n                  variant=\"primary\"\n                  className=\"me-1\"\n                ></Spinner>\n                <p>Processing</p>\n              </>\n            ) : (\n              <>\n                <CheckCircleIcon />\n              </>\n            )}\n          </div>\n          <div\n            className=\"status-address\"\n            onClick={() =>\n              window.open(\n                `https://rinkeby.etherscan.io/tx/${transactionHash}`,\n                \"_blank\"\n              )\n            }\n          >\n            <p>\n              {transactionHash.slice(0, 6) +\n                \".....\" +\n                transactionHash.slice(-6)}\n            </p>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <p>Share</p>\n        </div>\n        <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n          <FbIcon />\n          <TwitterIcon />\n          <LinkedinIcon />\n          <InstaIcon />\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\nexport default BuyModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.action.js",["647","648"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/ApprovalModal.js",["649","650","651"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n  return (\n    <>\n      {\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title className=\"acc-title mt-lg-3 mt-5\">\n              {approvalStatus === \"approved\"\n                ? \"Congratulations\"\n                : approvalStatus === \"in-progress\"\n                ? \"We’re on it\"\n                : \"Your account if not approved yet.\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\" onClick={onHide}>\n              <button>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </Modal.Header>\n          <Modal.Body>\n            {approvalStatus === \"approved\" ? (\n              <>\n                <img src={Images.sellerTickIcon} className=\"success-icon\" />\n                <div className=\"w-100 px-4 mb-2\">\n                  <div className=\"acc-approved-container mt-5 mb-5\">\n                    <p className=\"acc-approved ms-4 mb-0\">\n                      Your Account has been approved.\n                    </p>\n                    <img src={Images.smile} className=\"smile-img\" />\n                  </div>\n                </div>\n              </>\n            ) : approvalStatus === \"in-progress\" ? (\n              <>\n                <div className=\"approval-spinner mb-4\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n                <p className=\"processing-title text-center w-100\">\n                  Processing...\n                </p>\n                <div className=\"w-100 px-3\">\n                  <p className=\"approve-msg text-start ms-3 mt-3 \">\n                    Wallet Address\n                  </p>\n                  <input\n                    className=\"input-common mb-5\"\n                    value={address}\n                    readOnly\n                  />\n                </div>\n              </>\n            ) : (\n              <>\n                <img\n                  src={Images.metamaskImg}\n                  className=\"approve-metamask-img\"\n                />\n                <div className=\" w-100 px-3\">\n                  <p className=\"approve-msg w-100 text-start ms-3 mt-3 \">\n                    Please approve your wallet address to reach us\n                  </p>\n                  <input className=\"input-common\" value={address} readOnly />\n                </div>\n                <button\n                  className=\"btn btn-linear-gradient mt-4 my-4 get-approved-btn\"\n                  disabled={approvalStatus === \"pending\"}\n                  onClick={() => approveAccount()}\n                >\n                  {approvalStatus === \"pending\" ? (\n                    <div\n                      class=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>\n                  ) : (\n                    \"Get Approved\"\n                  )}\n                </button>\n              </>\n            )}\n          </Modal.Body>\n        </Modal>\n       \n      }\n    </>\n  );\n};\nexport default ApprovalModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["652"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        \n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/StatsModal.js",["653","654"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nconst StatsModal = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <form>\n          <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n            {stats &&\n              stats.length > 0 &&\n              stats.map((item, i) => {\n                return (\n                  <div\n                    className=\"row g-2 align-items-center justify-content-between mt-3\"\n                    key={i}\n                  >\n                    <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                      <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                        <div className=\"ps-2\">\n                          <h6>Name:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"text\"\n                            name=\"name\"\n                            maxLength=\"40\"\n                            value={item.name}\n                            onKeyDown={(e) =>\n                              firstInputCharacterSpace(e, item.name.length)\n                            }\n                            onChange={(e) => handleChange(i, e, \"stats\")}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                      <div className=\"d-flex align-items-center justify-content-between\">\n                        <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                          <div className=\"ps-2\">\n                            <h6>Value:</h6>\n                          </div>\n                          <div className=\"inp-container\">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              min=\"1\"\n                              maxLength=\"1\"\n                              onKeyDown={(e) => {\n                             \n\n                                decimalNumberValidator(e);\n                              }}\n                              value={item.value}\n                              onChange={(e) => {\n                                console.log(typeof e.target.value);\n                                if (\n                                  +e.target.value > 5 ||\n                                  (+e.target.value <= 0 && item.value == \"\")\n                                ) {\n                                  return \"\";\n                                }\n                                handleChange(i, e, \"stats\");\n                              }}\n                              autoComplete=\"off\"\n                            />\n                          </div>\n                        </div>\n                        <div className=\"value-inp-of mx-3\">\n                          <h6>of</h6>\n                        </div>\n                        <div className=\"bid-inp-container modal-value-inp\">\n                          <div className=\"inp-container \">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              value={5}\n                              autoComplete=\"off\"\n                              className=\"text-center\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                      <div className=\"inp-close text-end\">\n                        <button type=\"submit\">\n                          <img\n                            src={InputClose}\n                            alt=\"closemodal\"\n                            onClick={() => removeFormFields(i, \"stats\")}\n                          />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n          </div>\n        </form>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/PropertiesModal.js",["655"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/LevelsModal.js",["656"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace\n} from \"./../../utils/functions\";\nconst LevelsModal = (props) => {\n  const {\n    show,\n    onHide,\n    levels,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    onSave,\n  } = props;\n\n  const handleSubmit = () => {\n    if (levels && levels.length > 0) {\n      let isEmpty = levels.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"levels\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Levels</Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {levels &&\n            levels.length > 0 &&\n            levels.map((item, i) => {\n              return (\n                <div\n                  className=\"row g-2 align-items-center justify-content-between  mt-3\"\n                  key={i}\n                >\n                  <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                    <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                      <div className=\"ps-2\">\n                        <h6>Name:</h6>\n                      </div>\n                      <div className=\"inp-container\">\n                        <input\n                          type=\"text\"\n                          name=\"name\"\n                          maxLength=\"40\"\n                          value={item.name}\n                          onKeyDown={(e) =>\n                            firstInputCharacterSpace(e, item.name.length)\n                          }\n                          onChange={(e) => handleChange(i, e, \"levels\")}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                    <div className=\"d-flex align-items-center justify-content-between\">\n                      <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                        <div className=\"ps-2\">\n                          <h6>Value:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={item.value}\n                            min=\"1\"\n                            maxLength=\"1\"\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            onChange={(e) => {\n                              console.log(e.target.value, \"e.target.value\");\n                              if (\n                                +e.target.value > 5 ||\n                                (+e.target.value <= 0 && item.value == \"\")\n                              ) {\n                                return \"\";\n                              }\n                              handleChange(i, e, \"levels\");\n                            }}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"value-inp-of mx-3\">\n                        <h6>of</h6>\n                      </div>\n                      <div className=\"bid-inp-container modal-value-inp\">\n                        <div className=\"inp-container \">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={5}\n                            autoComplete=\"off\"\n                            className=\"text-center\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                    <div className=\"inp-close text-end\">\n                      <button>\n                        <img\n                          src={InputClose}\n                          alt=\"closemodal\"\n                          onClick={() => removeFormFields(i, \"levels\")}\n                        />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"levels\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3 \"\n            disabled={levels && levels.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default LevelsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["657","658"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <div className=\"upload-image-border p-4 position-relative\">\n      <div className=\"nft-uploaded-img-container\">\n        {imageURL || videoURL || audioSrc ? (\n          <MdClose\n            color=\"#e33d0bc2\"\n            className=\"uploaded-cross-icon\"\n            onClick={() => clearData()}\n          />\n        ) : (\n          \"\"\n        )}\n        <label\n          className=\"w-100\"\n          onDrop={(e) => onDrop(e)}\n          onDragOver={(e) => dragOver(e)}\n          onDragEnter={(e) => dragEnter(e)}\n          onDragLeave={(e) => dragLeave(e)}\n        >\n          <div className=\"\">\n            {imageURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <img\n                  className=\"upload-image\"\n                  src={imageURL}\n                  alt=\"upload-image\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : videoURL ? (\n              <div className=\"nft-uploaded-img-container\">\n                <VideoComponent\n                  videoUrl={videoURL}\n                  videoStyles={videoStyles}\n                  videoWidth=\"300\"\n                />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : audioSrc ? (\n              <div className=\"nft-uploaded-img-container\">\n                <AudioPlayer audioSrc={audioSrc} />\n                <img\n                  src={UploadIcon}\n                  alt=\"upload-icon\"\n                  className=\"nft-upload-icon\"\n                />\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </div>\n            ) : (\n              <>\n                {\" \"}\n                <img\n                  className=\"upload-image-place-holder\"\n                  src={Images.uploadImage}\n                  alt=\"upload-image\"\n                />\n                <div className=\"upload-details text-center mt-2\">\n                  <p>Drag and drop your file</p>\n                  <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n                </div>\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={(e) => onFileChange(e, \"onChange\")}\n                  accept=\".mp4, .png,.jpeg\"\n                  name=\"image\"\n                />\n              </>\n            )}\n          </div>\n        </label>\n      </div>\n    </div>\n  );\n};\n\nexport default Upload;\n",["659","660"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/aboutus/aboutus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contactus/contactus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/faqs/faqs.js",["661","662"],"import React, { useEffect } from \"react\";\nimport \"./faqs.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport { Accordion, Card } from \"react-bootstrap\";\n\nconst bannerData = {\n  subHeading: \"Ask\",\n  heading: \"FAQ\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nconst faqsData = [\n  {\n    question: \"What is MintsClub?\",\n    ans: \"MintsClub is a revolutionary 21st Century blockchain product that brings users one step closer to experiencing Metaverse. The users can mint their digital assets such as images, GIFs, games, sports accessories and more into the cryptomarket and establish a stable revenue stream.\",\n  },\n  {\n    question: \"What is a MintsClub token?\",\n    ans: \"MintsClub token, famously known as Non-fungible Token (NFT) is a distinct cryptographic token that exists on the blockchain platform and cannot be replicated. Tokenization of digital assets has made it easier to buy and sell while reducing the threat of fraudulent acts.\",\n  },\n  {\n    question: \"What is the total supply of MINT?\",\n    ans: \"The total supply of 1-inch Mint tokens is 1.5 billion.\",\n  },\n  {\n    question: \"Where can I buy/sell MINT?\",\n    ans: \"You can sell your NFTs on blockchain marketplaces such as Binance, Cardano, Solana and Algoran and now, MintsClub.\",\n  },\n];\n\nconst Faqs = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper faqs\">\n        <div className=\"container\">\n          <div className=\"row align-items-center justify-content-center\">\n            <div className=\"col-12\">\n              <div\n                className=\"faqs-accordion accordion accordion-flush mx-auto\"\n                id=\"accordionFlushExample\"\n              >\n                {faqsData.map((faq, id) => {\n                  return (\n                    <div className=\"accordion-item mb-4\">\n                      <h2 className=\"accordion-header\" id={`${id}`}>\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target={`#c${id}`}\n                          aria-expanded=\"false\"\n                          aria-controls={`c${id}`}\n                        >\n                          <span>Q{`${id + 1}.`}</span>\n                          {faq.question}\n                        </button>\n                      </h2>\n                      <div\n                        id={`c${id}`}\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby={`${id}`}\n                      >\n                        <div className=\"accordion-body\">\n                          <p>{faq.ans}</p>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Faqs;\n",{"ruleId":"663","replacedBy":"664"},{"ruleId":"665","replacedBy":"666"},{"ruleId":"667","severity":1,"message":"668","line":18,"column":13,"nodeType":"669","endLine":20,"endColumn":4},{"ruleId":"667","severity":1,"message":"670","line":20,"column":6,"nodeType":"671","endLine":20,"endColumn":11,"suggestions":"672"},{"ruleId":"667","severity":1,"message":"673","line":29,"column":6,"nodeTyp