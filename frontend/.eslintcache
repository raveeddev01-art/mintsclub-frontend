:0,"source":null},{"filePath":"300","messages":"301","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"302","messages":"303","errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"304","messages":"305","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"306","messages":"307","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"308","messages":"309","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"310","messages":"311","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"312","messages":"313","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"314","usedDeprecatedRules":"190"},{"filePath":"315","messages":"316","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"317","usedDeprecatedRules":"190"},{"filePath":"318","messages":"319","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"320","messages":"321","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"322","messages":"323","errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":4,"source":null},{"filePath":"324","messages":"325","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"326","messages":"327","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"328","messages":"329","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"330","messages":"331","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"332","messages":"333","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"334","messages":"335","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"336","usedDeprecatedRules":"190"},{"filePath":"337","messages":"338","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"339","usedDeprecatedRules":"190"},{"filePath":"340","messages":"341","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"342","usedDeprecatedRules":"190"},{"filePath":"343","messages":"344","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"345","messages":"346","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"347","messages":"348","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"349","messages":"350","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"351","messages":"352","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"353","usedDeprecatedRules":"190"},{"filePath":"354","messages":"355","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"356","usedDeprecatedRules":"190"},{"filePath":"357","messages":"358","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"359","usedDeprecatedRules":"190"},{"filePath":"360","messages":"361","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"362","messages":"363","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"364","messages":"365","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"366","messages":"367","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"368","messages":"369","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"370","messages":"371","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"372","messages":"373","errorCount":0,"fatalErrorCount":0,"warningCount":10,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"374","messages":"375","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"376","messages":"377","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"378","messages":"379","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"380","messages":"381","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"382","usedDeprecatedRules":"190"},{"filePath":"383","messages":"384","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"385","messages":"386","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"387","usedDeprecatedRules":"388"},{"filePath":"389","messages":"390","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"391","usedDeprecatedRules":"190"},{"filePath":"392","messages":"393","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"394","messages":"395","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"396","messages":"397","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"398","messages":"399","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"400","messages":"401","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"402","messages":"403","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"404","usedDeprecatedRules":"190"},{"filePath":"405","messages":"406","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"407","usedDeprecatedRules":"190"},{"filePath":"408","messages":"409","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/index.js",[],["410","411"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/store.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/App.js",["412","413","414"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\n\nconst App = React.memo((props) => {\n  let walletAddress = false;\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const history = useHistory();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  // ///set Interval\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address || !address) {\n        toast.info(\"Please sign in  with new connected address\");\n        walletAddress = address;\n        // setWalletAddress(address)\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n      // setWalletAddress(address);\n    }\n    // }\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={\n                    ENV.getUserKeys(\"_id\")._id || route.path === \"/login\"||route.path==='Signup' \n                      ? true\n                      : false\n                  }\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nexport default App;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/serviceWorker.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/routes.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/privateRoute.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/index.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/config/config.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/web3.js",["415"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\n\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\n\nexport const validateNetwork = async () => {\n  let prevNetwork = await getNetworkNameByChainId();\n\n  if (prevNetwork === \"Ethereum Rinkby\") {\n    return true;\n  } else {\n    return false;\n  }\n};\nexport const getBalance = async () => {\n  let web3 = await getWeb3();\n  let address = await getWalletAddress();\n  let balance = await web3.eth.getBalance(address);\n  let ethBalance = web3.utils.fromWei(balance, \"ether\");\n\n  return ethBalance;\n};\n\nexport const mintNFt = async (metaData, id, amount, recipientValue) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, metaData)\n      .send({ from: connectedAddress, gassPrice: 5000000 });\n\n    return result;\n  } catch (err) {\n    console.log(err, \"error while minting\");\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const openNFTForBidding = async (\n  biddingTime,\n  startTime,\n  tokenId,\n  copies\n) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id = Number(tokenId);\n    console.log(biddingTime, startTime);\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id, copies)\n      .send({ from: connectedAddress });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"open for bid error\");\n    throw new Error(err);\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const bidAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n    // let bidAmount = Number(amount) * 1000000000000000000;\n\n    let id = Number(tokenId);\n\n    const result = await contractM.methods\n      .bid(id)\n      .send({ from: connectedAddress, value: bidAmount, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\n\nexport const putonsale = async (tokenId, amount, price) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let weiAmount = BigInt(Web3.utils.toWei(price, \"ether\"));\n\n    let id = Number(tokenId);\n    console.log(id, amount, weiAmount);\n    const result = await contractM.methods\n      .putonsale(id, amount, weiAmount)\n      .send({ from: connectedAddress, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const BuyFixedPriceNFT = async (\n  amount,\n  tokenId,\n  setConfirmed,\n  setTransactionHash\n) => {\n  setConfirmed(\"pending\");\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n\n    const weiAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n\n    const result = await contractM.methods\n      .BuyFixedPriceNFT(tokenId)\n      .send({ from: connectedAddress, value: weiAmount, gas: 5000000 })\n      .on(\"transactionHash\", function (hash) {\n        setTransactionHash(hash);\n        setConfirmed(true);\n      })\n      .on(\"confirmation\", function (confirmationNumber, receipt) {});\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    setConfirmed(false);\n    console.log(err);\n\n    throw new Error(err);\n  }\n};\nexport const setApprovalForAll = async (setApprovalStatus) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const result = await contractM.methods\n      .setApprovalForAll(ENV.mintsClubContractAddress, true)\n      .send({\n        from: connectedAddress,\n      })\n      .on(\"transactionHash\", function (hash) {\n        // setTransactionHash(hash);\n        setApprovalStatus(\"in-progress\");\n      });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const endAuction = async (tokenId) => {\n  try {\n    let connectedAddress = await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.auctionEnd(tokenId).send({\n      from: connectedAddress,\n      gassPrice: 5000000,\n    });\n    if (result) {\n      console.log(result, \"result\");\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const getMetamaskConnectedAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        // toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      // toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\nexport const connectWithMetamask = async () => {\n  try {\n    let web3 = await getWeb3();\n    await window.ethereum.request({\n      method: \"wallet_requestPermissions\",\n      params: [\n        {\n          eth_accounts: {},\n        },\n      ],\n    });\n    let accounts = await web3.eth.getAccounts();\n    return accounts[0];\n  } catch (err) {\n    toast.error(err.message)\n  }\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const mint = async () => {\n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n  } catch (e) {}\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = () => {};\n\nexport const createNft = async () => {};\n\nexport const setNftToken = (body) => {\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n  alert(\"calling\");\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        window.location.href = \"/explore-all\";\n      } else {\n      }\n    })\n    .catch((error) => {\n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {};\n\nexport const placeBidNft = async () => {};\n\nexport const SellOnFixedPrice = async () => {};\n\nexport const BuyFixedPriceNFTs = async () => {};\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async () => {};\nexport const signTransaction = async () => {};\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/full-page-loader/full-page-loader.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.reducer.js",["416"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/signup/signup.js",["417","418","419","420","421","422","423","424"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/sell-nft/SellNFT.js",["425","426","427","428","429","430","431","432","433","434","435","436","437","438","439","440","441"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.js",["442","443","444","445","446","447","448","449","450"],"import React, { useState, useEffect } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport {\n  connectMetamaskCopy,\n  signRequest,\n  connectWithMetamask,\n} from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"../wallet/wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  getCollections,\n  beforeCategory,\n  beforeCollection,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport { login, signup } from \"../user/user.action\";\nimport { Images } from \"../../assets/assets\";\nimport \"./wallet.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport { getWalletAddress, validateNetwork } from \"../../utils/web3\";\n\nconst Wallet = (props) => {\n  const history = useHistory();\n  let walletAddress = false;\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [disabled, setDisabled] = useState(false);\n  const [loader, setLoader] = useState(false);\n\n  const connectMetamaskCall = async () => {\n    if (await validateNetwork()) {\n      setDisabled(true);\n      let connectedAddress = await connectWithMetamask();\n      if (connectedAddress) {\n        setDisabled(false);\n      }\n      setConnectedAddress(connectedAddress);\n      setWalletAddress(connectedAddress);\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      console.log(\"errors\", props.error);\n\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setDisabled(false);\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.collection.getAuth === true) {\n      props.beforeCollection();\n\n      toast.success(\"User Logged In Successfully\");\n      history.push(\"/\");\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    e.preventDefault();\n    if (await validateNetwork()) {\n      setDisabled(true);\n      try {\n        if (validator.isEmail(email)) {\n          let sign = await signRequest();\n          let payload = {\n            address: connectedAddress,\n            email: email,\n            username: username,\n            isApproved: false,\n          };\n          props.signup(payload);\n        } else {\n          setErrorMessage(\"please enter valid email\");\n        }\n      } catch (err) {\n        toast.error(err.message);\n        setDisabled(false);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const login = async () => {\n    if (await validateNetwork()) {\n      try {\n        setDisabled(true);\n        setLoader(true);\n        let sign = await signRequest();\n        let payload = {\n          address: connectedAddress,\n        };\n        console.log(payload,\"payload==>\")\n        props.login(payload);\n      } catch (err) {\n        setDisabled(false);\n        setLoader(false);\n        toast.error(err.message);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const switchSignup = () => {\n    setShowSignUpComponent(true);\n  };\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address) {\n        // toast.info(\"Please login with new address11\");\n        walletAddress = address;\n        setShowSignUpComponent(false);\n        setShowSignUp(false);\n        setErrorMessage(false);\n        setConnectedAddress(address);\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n    }\n  };\n\n  const signInbannerData = {\n    subHeading: \"Login\",\n    heading: \"Login Information\",\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div>\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n            <div className=\"padding-wrapper\">\n              <div className=\"container\">\n                <div className=\"row justify-content-center\">\n                  <div className=\"col-12 col-md-8 col-lg-7\">\n                    {/* Intro */}\n                    <div className=\"intro wallet-intro  text-center\">\n                      <span>Sign In</span>\n                      <h3 className=\"mt-3 mb-0\">SignIn to your account</h3>\n                      <p className=\"mt-3\">\n                        Please Click to Sign In your Account.\n                      </p>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"row justify-content-center items mb-5\">\n                  <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                    <div className=\"sign-in-card\">\n                      <span\n                        className=\"sign-content-wrapper text-center\"\n                        href=\"/login\"\n                      >\n                        <h4 className=\"mb-0\">Address</h4>\n                        <p className=\"mt-4\">{connectedAddress}</p>\n                        {errorMessage && (\n                          <p className=\"text-danger\">{errorMessage}</p>\n                        )}\n                        {!showSignUp && (\n                          <>\n                            <button\n                              className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4\"\n                              type=\"button\"\n                              disabled={disabled || loader}\n                              onClick={() => login()}\n                            >\n                              {loader ? (\n                                <div className=\"text-center\">\n                                  <div\n                                    className=\"spinner-border sign-in-spinner text-white\"\n                                    role=\"status\"\n                                  >\n                                    <span className=\"sr-only\">Loading...</span>\n                                  </div>\n                                </div>\n                              ) : (\n                                \"Sign In\"\n                              )}\n                            </button>\n                          </>\n                        )}\n\n                        {showSignUp && (\n                          <button\n                            className=\"btn btn-linear-gradient btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                            type=\"button\"\n                            onClick={() => history.push(\"/signup\")}\n                          >\n                            Would you like to Signup?\n                          </button>\n                        )}\n                      </span>\n                    </div>\n                    <button\n                      className=\"change-wallet-btn mt-5 d-flex mx-auto\"\n                      onClick={() => setConnectedAddress(null)}\n                    >\n                      Change Wallet Address\n                    </button>\n\n                    <span className=\"new-member mt-5 d-flex justify-content-center\">\n                      New Member?\n                      <a className=\"register-member mx-1\" href=\"/signup\">\n                        {\" \"}\n                        Register\n                      </a>\n                      here.\n                    </span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n\n            <div className=\"container\">\n              <div className=\"row justify-content-center\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  {/* Intro */}\n                  <div className=\"intro text-center\">\n                    <span>SIGNUP</span>\n                    <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                    <p className=\"text-gray\">\n                      Create the account with the address\n                    </p>\n                  </div>\n                  {/* Item Form */}\n                  <form\n                    className=\"item-form card no-hover signup-card\"\n                    onSubmit={(e) => signup(e)}\n                  >\n                    <div className=\"row\">\n                      {errorMessage && (\n                        <p className=\"text-center text-gray\">{errorMessage}</p>\n                      )}\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control sign-up-input\"\n                            name=\"address\"\n                            placeholder=\"Address\"\n                            required=\"required\"\n                            disabled={true}\n                            value={connectedAddress}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"email\"\n                            className=\"form-control sign-up-input\"\n                            name=\"email\"\n                            placeholder=\"Enter your Email\"\n                            required=\"required\"\n                            defaultValue={email}\n                            onChange={(e) => setEmail(e.target.value)}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control sign-up-input\"\n                            name=\"username\"\n                            placeholder=\"Enter your Username\"\n                            required=\"required\"\n                            defaultValue={username}\n                            onChange={(e) => setUsername(e.target.value)}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3 text-center\">\n                          <div className=\"form-check form-check-inline\">\n                            <input\n                              className=\"form-check-input\"\n                              type=\"radio\"\n                              name=\"inlineRadioOptions\"\n                              id=\"inlineRadio1\"\n                              defaultValue=\"option1\"\n                              autoComplete=\"off\"\n                            />\n                            <label\n                              className=\"form-check-label text-center text-gray\"\n                              htmlFor=\"inlineRadio1\"\n                            >\n                              I agree to{\" \"}\n                              <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"text-center\">\n                          <button\n                            className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4  text-white \"\n                            type=\"submit\"\n                            disabled={disabled}\n                          >\n                            Sign Up\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </form>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n            <div className=\"padding-wrapper\">\n              <div className=\"container mb-5\">\n                <div className=\"row justify-content-center\">\n                  <div className=\"col-12 col-md-8 col-lg-7\">\n                    <div className=\"intro wallet-intro text-center\">\n                      <span>Wallet Connect</span>\n                      <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                      <p className=\" mt-3\">\n                        Please select the wallet you want to connect to.\n                      </p>\n                    </div>\n                  </div>\n                </div>\n                <div\n                  className=\"connect-metamask-container text-center mx-auto\"\n                  onClick={() => connectMetamaskCall()}\n                >\n                  <img\n                    className=\"avatar-lg mt-4\"\n                    src={Images.metamaskImg}\n                    alt=\"\"\n                  />\n                  <p className=\"metamask-title mt-2\">Metamask</p>\n                  <p className=\"metamask-desc px-sm-0 px-3\">\n                    A browser extension with great flexibility.\n                    <br className=\"d-none d-sm-block\" /> The web's most popular\n                    wallet\n                  </p>\n                </div>\n                <span className=\"new-member mt-5 d-flex justify-content-center\">\n                  New Member?\n                  <a className=\"register-member mx-1\" href=\"/signup\">\n                    {\" \"}\n                    Register\n                  </a>\n                  here.\n                </span>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n  beforeCollection,\n})(Wallet);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/explore-collections.js",["451","452","453","454"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport \"./explore-collections.css\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"./collections.actions\";\nimport { Images } from \"../../assets/assets\";\n\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { beforeCategory, getCategories } from \"./collections.actions\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index&&result.length!==0) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  const bannerData = {\n    subHeading: \"Collections\",\n    heading: \"Explore all\",\n    content:\n      \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <>\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper pt-0\">\n          <Banner\n            subHeading={bannerData.subHeading}\n            heading={bannerData.heading}\n            content={bannerData.content}\n            bgImg={BannerBg}\n            bannerImg={BannerImage}\n          />\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, index) => {\n                      return (\n                        <button\n                          key={index}\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, index) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\" key={index}>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-1 align-items-center justify-content-center\">\n              {loader ? (\n                <div className=\"spinner-border\" role=\"status\">\n                  <span className=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection, index) => {\n                  return (\n                    <div className=\"col-sm-6 col-md-4 col-xl-3\" key={index}>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : \"\"\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 d-flex justify-content-center align-items-center\">\n                  {!empty &&\n                    collections?.length === 10 &&!loader&&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-rounded-bordered px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more...\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n          <OwnCollectionToday />\n        </section>\n      )}\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/collections.reducer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/not-found/not-found.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collection-details/collectiondetails.js",["455","456","457","458","459","460"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport \"./collectiondetails.css\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport FilterComponent from \"../filterComponent/filterComponent\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport { Images } from \"../../assets/assets\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nconst CollectionDetailsPage = (props) => {\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const location = useLocation();\n\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      if (props?.nfts?.length > 0) {\n        setDisabled(false);\n      } else {\n        if (initial) {\n          setDisabled(true);\n        }\n      }\n      setNfts(props.nfts);\n      setNFTPagination(props.pagination);\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        limit,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      nftQS.collectionId = location.state._id;\n\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n      if (page) {\n        nftQS.page = page;\n      } else {\n        nftQS.page = 1;\n      }\n      if (limit) {\n        nftQS.limit = limit;\n      } else {\n        nftQS.limit = 10;\n      }\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n  ///////////Likes\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const fetchData = (filterObj) => {\n    getNFTs(filterObj);\n  };\n  const { name, logo, description, username } = location.state;\n  const bannerData = {\n    subHeading: \"Nfts\",\n    heading: \"Collections Info\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"d-flex flex-column flex-md-row align-items-center align-items-sm-start\">\n                  <div className=\"ms-lg-5 collection-owner-avatar user-avatar-container me-3 flex-fill\">\n                    <img\n                      src={logo ? logo : Images.profilePlaceholder}\n                      alt=\"owner-avatar\"\n                    />\n                  </div>\n                  <div className=\"collection-owner-detail text-center text-sm-start mt-2 mt-sm-4\">\n                    <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n                      <div className=\"collection-owner-name\">\n                        <h3>\n                          {name}{\" \"}\n                          <span>\n                            <img\n                              src={TickIcon}\n                              alt=\"tick-icon\"\n                              className=\"ms-2\"\n                            />\n                          </span>\n                        </h3>\n                      </div>\n                      <div>\n                        <p>\n                          Created By: <span>{username?.[0]}</span>\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-description mt-3\">\n                      <p>{description && description} </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-7 col-md-6 col-lg-5\"></div>\n            </div>\n          </div>\n        </div>\n        {loader && <FullPageLoader />}\n        <FilterComponent\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={loader}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          path=\"/explore/nftdetail/\"\n          collectionDetail\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftsData.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n})(CollectionDetailsPage);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user-profile/user-edit-profile.js",["461","462","463","464","465","466","467","468","469","470","471","472","473","474","475","476","477","478","479","480","481"],"import React, { useEffect, useState } from \"react\";\n\nimport \"./user-edit-profile.css\";\n\n/////////\n\nimport { connect } from \"react-redux\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { ENV } from \"./../../config/config\";\nimport { Images } from \"../../assets/assets\";\nimport { useHistory } from \"react-router-dom\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport Compressor from \"compressorjs\";\nconst EditProfile = (props) => {\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [copy, setCopy] = useState(false);\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const [bioError, setBioError] = useState(false);\n  const [userProfile, setUserProfile] = useState({});\n  const [user, setUser] = useState(null);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n  \n  useEffect(() => {\n    if (props.error !== null) {\n      setLoader(false);\n      toast.error(props.error.messasge);\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      setUser(props.user.individualUser);\n      props.beforeUser();\n      setLoader(false);\n\n      setConnectedAddress(address ? address : \"\");\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      setBannerUrl(bannerImage ? bannerImage : \"\");\n      setImage(profileImage ? profileImage : \"\");\n      setBannerImage(bannerImage ? bannerImage : \"\");\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      setLoader(false);\n      props.beforeUser();\n      toast.success(\"Profile Updated SuccessFully\");\n      history.push(\"/userprofile\");\n    }\n  }, [props.user.userAuth]);\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    let sizeBeforeCompress = formatBytes(file.size);\n    console.log(sizeBeforeCompress, \"seizeBeforecompress\");\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n        return toast.error(\"Invalid File\");\n      }\n      setImageUrl(fileURL);\n      // setImage(file);\n\n      new Compressor(file, {\n        quality: 0.2,\n        success(result) {\n          console.log(result, \"result==>\");\n          setImage(result);\n\n          let sizeAfterCompress = formatBytes(result.size);\n          console.log(sizeAfterCompress, \"sizeAfterCompress\");\n        },\n        error(err) {\n          console.log(err.message);\n        },\n      });\n    }\n  };\n  const formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n\n    if (description && description.length < 3) {\n      setBioError(true);\n      return \"\";\n    } else {\n      setBioError(false);\n    }\n    setErrors(\"\");\n    setLoader(true);\n    // let signature = await signRequest();\n    setLoader(true);\n\n    var formData = new FormData();\n    formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n    console.log(image,\"image while submiting\")\n    if (image) {\n      formData.append(\"profileImage\", image);\n    }\n    if (banner) {\n      formData.append(\"bannerImage\", banner);\n    }\n    formData.append(\"bio\", description);\n    formData.append(\"twitterLink\", twitterLink);\n    formData.append(\"username\", username);\n    formData.append(\"email\", email);\n    formData.append(\"webLink\", webLink);\n    formData.append(\"instaLink\", instaLink);\n\n    // return ''\n    props.updateProfile(formData);\n  };\n  const bannerData = {\n    subHeading: \"Information\",\n    heading: \"User Profile\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile padding-wrapper pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n          className=\"mb-0\"\n        />\n        {loader && <FullPageLoader />}\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <form onSubmit={submit}>\n              <div className=\"row\">\n                <div className=\"col-12 mt-5\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {image && image ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={imageUrl ? imageUrl : Images.logoImage}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={imageUrl ? imageUrl : Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">\n                      Profile Image*\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Username:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    required\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && username === \"\") {\n                        return false;\n                      } else {\n                        setUsername(e.target.value);\n                      }\n                    }}\n                    value={username}\n                    placeholder=\"Username\"\n                    maxLength=\"55\"\n                    minLength=\"3\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">\n                    Email Address:*\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Email Address\"\n                    required\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && email === \"\") {\n                        return \"\";\n                      } else {\n                        setEmail(e.target.value);\n                      }\n                    }}\n                    value={email}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Wallet Address:\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"URL\"\n                    required\n                    readOnly={true}\n                    autoComplete=\"off\"\n                    value={address}\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">BioData:</label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Enter BioData\"\n                    maxLength=\"500\"\n                    minLength=\"3\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && description === \"\") {\n                        return false;\n                      } else {\n                        setDescription(e.target.value);\n                      }\n                    }}\n                    value={description}\n                  ></textarea>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Twitter Link:\n                  </label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && twitterLink === \"\") {\n                        return false;\n                      } else {\n                        setTwitterLink(e.target.value);\n                      }\n                    }}\n                    value={twitterLink}\n                    placeholder=\"Twitter Link\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0  mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Instagram Link:\n                  </label>\n\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Instagram Link\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && instaLink === \"\") {\n                        return false;\n                      } else {\n                        setInstaLink(e.target.value);\n                      }\n                    }}\n                    value={instaLink}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0  mt-3 mt-lg-5 \">\n                  <label className=\"create-collection-label\">\n                    Website Link:\n                  </label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"Website Link\"\n                    onChange={(e) => {\n                      if (e.target.value.trim() === \"\" && webLink === \"\") {\n                        return false;\n                      } else {\n                        setWebLink(e.target.value);\n                      }\n                    }}\n                    value={webLink}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    type=\"submit\"\n                  >\n                    Save Changes\n                  </button>\n                </div>\n              </div>\n            </form>\n          </div>\n        </div>\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n  emptyError,\n})(EditProfile);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user-profile/UserProfile.js",["482","483","484","485","486","487","488","489","490"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/top-seller/topsellerlist.js",["491","492","493"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/auctions.reducer.js",["494"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nft-detail/nftdetail.js",["495","496","497","498","499","500","501","502","503","504","505","506","507","508","509","510","511","512","513","514","515","516","517","518","519","520","521","522","523","524","525","526","527","528","529","530"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/home-auction-list.js",["531","532","533","534","535","536","537"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/popular-collections-list/popular-collections-list.js",["538","539","540","541","542","543","544","545"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/aboutus/aboutus.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/home/home.reducer.js",["546","547"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/create-nft.js",["548","549","550","551","552"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/creat-collections/CreateCollections.js",["553","554","555","556","557","558","559","560","561","562"],"import React, { Component } from \"react\";\nimport Footer from \"../footer/footer\";\nimport \"./CreateCollections.css\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Images } from \"../../assets/assets\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport Select from \"react-select\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\n\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        logoUrl: \"\",\n        bannerUrl: \"\",\n        featuredImgUrl: \"\",\n        description: \"\",\n      },\n      categories: null,\n      selectedCategory: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate(prevProps) {\n    if (this.props.error !== null && prevProps.error === null) {\n      toast.error(this.props.error.message);\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      let updatedCategories = [];\n      for (var item of categories) {\n        let obj = {\n          value: item._id,\n          label: item.name,\n        };\n        updatedCategories.push(obj);\n      }\n      this.setState({ categories: updatedCategories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let fileSize = this.formatBytes(file.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n         return  toast.error(\"File Max Limit Reached.\")\n        }\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n        \n      }\n  }\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  handleSelectChange = (selectedOption) => {\n    console.log(selectedOption, \"selected \");\n    let { collection } = this.state;\n    collection = { ...collection, categoryId: selectedOption.value };\n    this.setState({\n      selectedOption,\n      collection,\n    });\n  };\n  handleValidation = () => {\n    console.log(\"func\");\n    const { categoryId, logo, name, description, featuredImg } =\n      this.state.collection;\n    console.log(this.state.collection, \"collection\");\n    if (\n      description === \"\" ||\n      logo === \"\" ||\n      categoryId === \"\" ||\n      name === \"\" ||\n      featuredImg === \"\"\n    ) {\n      return true;\n    } else {\n      return false;\n    }\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: \"\", featuredImgUrl: \"\" };\n    this.setState({ collection });\n  };\n\n  render() {\n    const {\n      collection,\n      errors,\n      loader,\n      isSubmitted,\n      categories,\n      selectedOption,\n    } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      const bannerData = {\n        subHeading: \"Create New\",\n        heading: \"Create New Collection\",\n        content:\n          \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n      };\n      //create collection max size validation\n      return (\n        <>\n          {loader && <FullPageLoader />}\n          <section className=\"create-collection\">\n            <Banner\n              subHeading={bannerData.subHeading}\n              heading={bannerData.heading}\n              content={bannerData.content}\n              bgImg={BannerBg}\n              bannerImg={BannerImage}\n            />\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"upload-container flex-md-row flex-column align-items-center align-items-md-end ps-md-5 ps-0\">\n                  <div className=\"logo-wrapper\">\n                    <div className=\"logo-image\">\n                      {collection && collection.logo ? (\n                        <img\n                          className=\"uploaded-logo-img\"\n                          src={collection.logoUrl}\n                        />\n                      ) : (\n                        <label>\n                          <input\n                            id=\"logo\"\n                            type=\"file\"\n                            accept=\".png,.jpeg,.jpg\"\n                            onChange={(e) => this.onFileChange(e)}\n                            style={{ display: \"none\" }}\n                            name=\"logo\"\n                          />\n                          <span className=\"logo-img-round\">\n                            <img\n                              className=\"upload-icon\"\n                              src={Images.logoImage}\n                            />\n                          </span>\n                        </label>\n                      )}\n                    </div>\n\n                    <div className=\"upload-feature-icon-logo\">\n                      <label>\n                        <input\n                          id=\"logo\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => this.onFileChange(e)}\n                          style={{ display: \"none\" }}\n                          name=\"logo\"\n                        />\n                        <img src={Images.editIconSmall} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2\">Logo Image*</p>\n                  </div>\n                  <div className=\"feature-wrapper pt-md-0 pt-5\">\n                    <div className=\"feature-image\">\n                      <span className=\"feature-img-round\">\n                        {collection && collection.featuredImg ? (\n                          <img\n                            className=\"uploaded-feature-img\"\n                            src={collection.featuredImgUrl}\n                          />\n                        ) : (\n                          <label className=\"upload-icon\">\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                            <img src={Images.featureImageInputBG} />\n                            <div className=\"feature-img-round-info\">\n                              <p className=\"text-center mb-2 browse-file\">\n                                Browse Files\n                              </p>\n                              {/* <p className=\"mb-0\">PNG, GIF, WEBP, MP4, MP3 </p> */}\n                              <p className=\"text-center mb-0\">Max 100mb</p>\n                            </div>\n                          </label>\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-feature-icon\">\n                      <label>\n                        <input\n                          id=\"featuredImg\"\n                          type=\"file\"\n                          accept=\".png,.jpeg,.jpg\"\n                          style={{ display: \"none\" }}\n                          name=\"featuredImg\"\n                          onChange={(e) => this.onFileChange(e)}\n                        />\n                        <img src={Images.editIconLarge} />\n                      </label>\n                    </div>\n                    <p className=\"feature-img-title mt-3 mx-2 text-center text-md-start\">\n                      Feature Image*\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 col-sm-12\">\n                  <label className=\"create-collection-label\">Name:*</label>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"name\"\n                    type=\"text\"\n                    name=\"name\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.name}\n                    placeholder=\"Name\"\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6 mt-3 mt-md-0\">\n                  <label className=\"create-collection-label\">URL:</label>\n                  <span className=\"text-danger position-absolute top-0\">\n                    {this.validator.message(\"url\", collection.url, \"url\")}\n                  </span>\n                  <input\n                    className=\"create-collection-input mt-2\"\n                    id=\"url\"\n                    type=\"text\"\n                    name=\"url\"\n                    placeholder=\"URL\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.url}\n                    maxLength=\"55\"\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"col-lg-4 col-md-6  mt-3 mt-lg-0\">\n                  <label className=\"create-collection-label\">\n                    Select Category:*\n                  </label>\n\n                  <Select\n                    className=\"react-select-cls\"\n                    classNamePrefix=\"react-select\"\n                    value={selectedOption}\n                    isSearchable={false}\n                    onChange={this.handleSelectChange}\n                    options={categories}\n                  />\n                </div>\n\n                <div className=\"col-12 mt-3 mt-lg-5\">\n                  <label className=\"create-collection-label\">\n                    Description:*\n                  </label>\n\n                  <textarea\n                    className=\"create-collection-area mt-2\"\n                    name=\"description\"\n                    placeholder=\"Description\"\n                    maxLength=\"500\"\n                    rows=\"3\"\n                    onChange={(e) => this.onChange(e)}\n                    value={collection.description}\n                  ></textarea>\n                </div>\n\n                <div className=\"create-collection-btn-container\">\n                  <button\n                    className=\"btn create-collection-btn btn-linear-gradient mt-5\"\n                    disabled={this.handleValidation()}\n                    onClick={(e) => this.submit(e)}\n                  >\n                    Create Collection\n                  </button>\n                </div>\n              </div>\n            </div>\n          </section>\n          <OwnCollectionToday />\n\n          {/* <section className=\"edit-profile padding-wrapper create-collection-container\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Create Now</span>\n                      <h3 className=\"mb-0\">Create New Collection</h3>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Logo Image*</h6>\n                    <span className=\"text-danger\">\n                      {this.validator.message(\n                        \"logo\",\n                        collection.logo,\n                        \"required\"\n                      )}\n                    </span>\n                  </div>\n                  <div className=\"collection-logo-container pt-2\">\n                    {collection && collection.logo ? (\n                      <img\n                        src={collection.logoUrl}\n                        className=\"colection-avatar-img\"\n                      />\n                    ) : (\n                      <div className=\"colection-avatar\"></div>\n                    )}\n                    <label>\n                      <div className=\"avatar-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        id=\"logo\"\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => this.onFileChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"logo\"\n                      />\n                    </label>\n                  </div>\n                  <div className=\"\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Featured Image*</h6>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"logo\",\n                          collection.featuredImg,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-featured-container\">\n                      {collection && collection.featuredImg ? (\n                        <div className=\"uploaded-featured-container\">\n                          <img\n                            src={collection.featuredImgUrl}\n                            className=\"uploaded-featured-img\"\n                          />\n                          <div className=\"uploaded-featured-hover w-100\">\n                            <div className=\"uploaded-featured-cross\">\n                              <MdClose\n                                color=\"#e33d0bc2\"\n                                className=\"uploaded-cross-icon\"\n                                onClick={() => this.clearData()}\n                              />\n                            </div>\n                            <label>\n                              <div className=\"text-center\">\n                                <img src={UploadIcon} alt=\"upload-icon\" />\n                              </div>\n                              <input\n                                id=\"featuredImg\"\n                                type=\"file\"\n                                accept=\".png,.jpeg,.jpg\"\n                                style={{ display: \"none\" }}\n                                name=\"featuredImg\"\n                                onChange={(e) => this.onFileChange(e)}\n                              />\n                            </label>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className=\"upload-featured-img\">\n                          <label>\n                            <div className=\"text-center\">\n                              <img\n                                src={CollectionUploadIcon}\n                                alt=\"upload-icon\"\n                              />\n                            </div>\n                            <div className=\"upload-featured-img-content pt-2\">\n                              <h6 className=\"pb-1\">Browse Files</h6>\n                              <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                            </div>\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                          </label>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Name*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"name\",\n                            collection.name,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"name\"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.name}\n                          placeholder=\"Name\"\n                          maxLength=\"55\"\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>URL</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\"url\", collection.url, \"url\")}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"url\"\n                          type=\"text\"\n                          name=\"url\"\n                          placeholder=\"URL\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.url}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Select Category*</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"category\",\n                            collection.categoryId,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <select\n                          id=\"category\"\n                          name=\"categoryId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Select Collection\n                          </option>\n                          {categories &&\n                            categories.map((category, index) => {\n                              return (\n                                <option key={index} value={category._id}>\n                                  {category.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                      </div>\n                    </div>\n                    <div className=\"col-md-8\">\n                      <div className=\"edit-inp-subheading pt-4\">\n                        <h6>Discription</h6>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <textarea\n                          name=\"description\"\n                          placeholder=\"Discription\"\n                          maxLength=\"500\"\n                          rows=\"3\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.description}\n                          \n                        ></textarea>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                  <div className=\"\">\n                    <button\n                      type=\"button\"\n                      className=\"btn btn-linear-gradient\"\n                      onClick={(e) => this.submit(e)}\n                    >\n                      Create Collection\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section> */}\n          {/* <Footer /> */}\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/faqs/faqs.js",["563","564"],"import React, { useEffect } from \"react\";\nimport \"./faqs.css\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport { Accordion, Card } from \"react-bootstrap\";\n\nconst bannerData = {\n  subHeading: \"Ask\",\n  heading: \"FAQ\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nconst faqsData = [\n  {\n    question: \"What is MintsClub?\",\n    ans: \"MintsClub is a revolutionary 21st Century blockchain product that brings users one step closer to experiencing Metaverse. The users can mint their digital assets such as images, GIFs, games, sports accessories and more into the cryptomarket and establish a stable revenue stream.\",\n  },\n  {\n    question: \"What is a MintsClub token?\",\n    ans: \"MintsClub token, famously known as Non-fungible Token (NFT) is a distinct cryptographic token that exists on the blockchain platform and cannot be replicated. Tokenization of digital assets has made it easier to buy and sell while reducing the threat of fraudulent acts.\",\n  },\n  {\n    question: \"What is the total supply of MINT?\",\n    ans: \"The total supply of 1-inch Mint tokens is 1.5 billion.\",\n  },\n  {\n    question: \"Where can I buy/sell MINT?\",\n    ans: \"You can sell your NFTs on blockchain marketplaces such as Binance, Cardano, Solana and Algoran and now, MintsClub.\",\n  },\n];\n\nconst Faqs = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper faqs\">\n        <div className=\"container\">\n          <div className=\"row align-items-center justify-content-center\">\n            <div className=\"col-12\">\n              <div\n                className=\"faqs-accordion accordion accordion-flush mx-auto\"\n                id=\"accordionFlushExample\"\n              >\n                {faqsData.map((faq, id) => {\n                  return (\n                    <div className=\"accordion-item mb-4\">\n                      <h2 className=\"accordion-header\" id={`${id}`}>\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target={`#c${id}`}\n                          aria-expanded=\"false\"\n                          aria-controls={`c${id}`}\n                        >\n                          <span>Q{`${id + 1}.`}</span>\n                          {faq.question}\n                        </button>\n                      </h2>\n                      <div\n                        id={`c${id}`}\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby={`${id}`}\n                      >\n                        <div className=\"accordion-body\">\n                          <p>{faq.ans}</p>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Faqs;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/explore.reducer.js",["565"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/all-nft/allnft.js",["566","567","568","569","570","571","572","573","574"],"import React, { useState, useEffect } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./allnft.css\";\nimport { beforeNFT, getNFTs, getMyLikedNfts } from \"../../nfts/nfts.action\";\nimport { ENV } from \"../../../config/config\";\nimport { getCreators, beforeUser } from \"./../../user/user.action\";\nimport { toggleLikeDislike, beforeTogleLikeDislike } from \"../explore.action\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../../collections/collections.actions\";\nimport { validateNetwork } from \"../../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport FilterComponent from \"../../filterComponent/filterComponent\";\nimport Banner from \"../../banner/banner\";\nimport BannerBg from \"../../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../../own-collection-today/own-collection-today\";\n\nconst bannerData = {\n  subHeading: \"Explore\",\n  heading: \"All NFTs\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n\nconst AllNFT = (props) => {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [collections, setCollections] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getCreators();\n    props.getCollections();\n    if (props?.location?.state) {\n      props.beforeNFT();\n      let searchQs = { keyword: props.location.state, page: 1, limit: 10 };\n      window.history.replaceState(null, \"\");\n      searchQs = ENV.objectToQueryString(searchQs);\n      console.log(searchQs, \"searchQs\");\n      setFilterationLoader(true);\n      props.getNFTs(searchQs);\n    } else {\n      getNFTs();\n    }\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // props.beforeUser()\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  //Get NFt's\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nfts, pagination } = props.nft.nftsData;\n      if (nfts) {\n        if (nfts.length > 0) {\n          setDisabled(false);\n        } else {\n          if (initial) {\n            setDisabled(true);\n          }\n        }\n        setNFTs(nfts);\n        setNFTPagination(pagination);\n        setFilterationLoader(false);\n        props.beforeNFT();\n\n        setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  //pagination\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setCollections(props.collections);\n      props.beforeCollection();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (filter) => {\n    props.beforeNFT();\n    let nftQS = {};\n    if (filter) {\n      const {\n        page,\n        limit,\n        categoryId,\n        collectionId,\n        oldest,\n        lowToHigh,\n        highToLow,\n        newest,\n        buy,\n        auction,\n        latest,\n        gtePrice,\n        ltePrice,\n        keyword,\n      } = filter;\n      if (collectionId) nftQS.collectionId = collectionId;\n      if (gtePrice) nftQS.gtePrice = gtePrice;\n      if (ltePrice) nftQS.ltePrice = ltePrice;\n      if (categoryId) nftQS.categoryId = categoryId;\n      if (oldest) nftQS.oldest = oldest;\n      if (lowToHigh) nftQS.lowToHigh = lowToHigh;\n      if (highToLow) nftQS.highToLow = highToLow;\n      if (newest) nftQS.newest = newest;\n      if (keyword) nftQS.keyword = keyword;\n      if (buy) nftQS.buy = buy;\n      if (auction) nftQS.auction = auction;\n      if (latest) nftQS.latest = latest;\n      if(page){\n        nftQS.page=page;\n      } else {\n        nftQS.page=1;\n      }\n      if(limit){\n        nftQS.limit=limit;\n      } else {\n        nftQS.limit=10;\n      }\n    }\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable || likeButtonDisable === null) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n  const fetchData = (filterObj) => {\n  \n      getNFTs(filterObj);\n  };\n  return (\n    <>\n      <section className=\"explore-collection-section padding-wrapper pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          content={bannerData.content}\n          bgImg={BannerBg}\n          bannerImg={BannerImage}\n        />\n\n        <FilterComponent\n          collections={collections}\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={loader}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          initialKeyword={props?.location?.state}\n          path=\"/explore/nftdetail/\"\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFTs,\n  getCreators,\n  toggleLikeDislike,\n  getCollections,\n  getMyLikedNfts,\n  beforeCollection,\n  beforeUser,\n  beforeTogleLikeDislike,\n})(AllNFT);\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/categories/categories.reducer.js",["575"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user/user.reducer.js",["576"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nfts/nfts.reducer.js",["577"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/bids/bids.reducer.js",["578"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/reducer/reducer.js",["579"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/offers/offers.reducer.js",["580"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout4/layout4.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/shared/error/error.reducer.js",["581"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout3/layout3.jsx",["582","583"],"import React, { Component } from \"react\";\nimport Footer from \"../../components/footer/footer\";\n\nimport Scrollup from \"../../components/scroll-up/sroll-up\";\n\nclass Layout3 extends Component {\n  render() {\n    return <div className=\"main\">{this.props.children}</div>;\n  }\n}\n\nexport default Layout3;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/layouts/layout/layout.jsx",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/top-seller/topseller.js",["584","585"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/home-auctions.js",["586","587","588","589","590","591","592","593"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/types.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/popular-collections.js",["594","595","596","597","598","599"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/shared/error/error.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/categories/categories.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections/collections.actions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/hero/hero.js",["600","601","602","603"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/buy-sell/Buysell.js",["604","605"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\nimport BuyIcon from \"../../assets/images/buy-icon.svg\";\nimport SellIcon from \"../../assets/images/sell-icon.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./Buysell.css\";\n\nconst Buysell = () => {\n  return (\n    <section className=\"buy-sell-section padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row \">\n          <div className=\"col-sm-6\">\n            <div className=\"buy-card d-md-flex align-items-center\">\n              <div className=\"buy-card-img d-flex\">\n                <img src={Images.buyNft} alt=\"buy-logo\" className=\"mx-auto\" />\n              </div>\n              <div className=\"buy-card-content\">\n                <h5>Buy NFT Products</h5>\n                <p>Purchase digital NFT products from the biggest directory.</p>\n                <div className=\"d-flex justify-content-lg-end justify-content-center\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-start-selling text-right\"\n                    to=\"/explore/allNFT\"\n                  >\n                    Start buying\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-sm-6\">\n            <div className=\"sell-card d-md-flex align-items-center\">\n              <div className=\"buy-card-img d-flex\">\n                <img src={Images.sellNft} alt=\"buy-logo\" className=\"mx-auto\" />\n              </div>\n              <div className=\"buy-card-content \">\n                <h5>Sell Your NFT Products</h5>\n                <p>Sell one of your NFT products to make a huge profit.</p>\n                <div className=\"d-flex justify-content-lg-end justify-content-center\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-start-selling\"\n                    to=\"/userprofile\"\n                  >\n                    Start selling\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nexport default Buysell;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/banner/banner.js",["606"],"import React from \"react\";\nimport \"./banner.css\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\n\nconst Banner = ({ subHeading, heading, content, bgImg, bannerImg }) => {\n  return (\n    <>\n      <div\n        className=\"banner-wrapper padding-wrapper\"\n        style={{ backgroundImage: `url(${bgImg})` }}\n      >\n        <div className=\"container\">\n          <div className=\"row align-items-end\">\n            <div className=\"col-md-9 col-lg-7\">\n              <div className=\"intro\">\n                <div className=\"intro-content clr-blue\">\n                  {subHeading && <span>{subHeading}</span>}\n                  {heading && <h3 className=\"mb-0\">{heading}</h3>}\n                  {content && <p className=\"pt-4\">{content}</p>}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-lg-5 d-none d-lg-block\">\n              <div className=\"banner-img\">\n                {bannerImg && <img src={bannerImg} alt=\"banner-img\" />}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Banner;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/own-collection-today/own-collection-today.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/assets/assets.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/footer/footer.js",["607","608","609","610","611","612"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/filterComponent/filterComponent.js",["613","614","615","616","617"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/redux/types/types.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/scroll-up/sroll-up.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/navbar-main/NavbarMain.js",["618","619"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/explore/explore.action.js",["620"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/user/user.action.js",["621","622"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n    console.log(data,\"data\")\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nfts/nfts.action.js",["623","624","625","626","627"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  CREATE_ACITIVITY,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n} from \"./../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       console.log(data)\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n        \n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n      \n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const update =\n  (body, qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .put(url, body)\n      .then(function (response) {\n        if (response.data.success) {\n        } else {\n        }\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n  };\n\nexport const createActivity = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}activity/create`;\n\n  axios\n    .post(url, body)\n    .then(function (response) {\n    \n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const getActivities =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}activity/get`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {\n       \n\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n  export const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {    \n        dispatch({\n          type:  GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n \n      })\n      .catch(function (error) {\n        console.log(error)\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n   \n      });\n  };\n\nexport const getNFTsByCollection = (id) => (dispatch) => {\n  let data = {\n    collectionId: id,\n  };\n\n  dispatch(emptyError());\n\n  const url = `${ENV.url}nfts/getNFTsByCollection`;\n  axios\n    .post(url, data)\n    .then(function (response) {\n      if (response.data.success) {\n        dispatch({\n          type: GET_NFTS_BY_COLLECTION,\n          payload: response.data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: response.data,\n        });\n      }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .get(url)\n      .then(function (response) {\n        console.log();\n        if (response.data.success) {\n          dispatch({\n            type: GET_MYLIKED_NFTS,\n            payload: response.data.data,\n          });\n        } else {\n        }\n      })\n      .catch(function (error) {\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const createNFT = async (formData) => async (dispatch)=>{\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n    \n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  try{\n\n    const res = await axiosPostFormData(\"nfts/storeNFTData\", formData, true);\n  }catch(error){\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       \n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n        } else {\n        }\n      })\n      .catch((errors) => {});\n  };\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/utils/functions.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/levelsinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/create-nft/components/statsinfo.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/PropertiesModal.js",["628"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  firstInputCharacterSpace\n} from \"./../../utils/functions\";\nconst PropertiesModal = (props) => {\n  const {\n    show,\n    onHide,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    properties,\n    onSave,\n  } = props;\n  const handleSubmit = () => {\n    if (properties && properties.length > 0) {\n      let isEmpty = properties.filter(\n        (item) => item.name === \"\" || item.type === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"properties\");\n      }\n    }\n  };\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Add Properties\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {properties.map((item, i) => {\n            return (\n              <div className=\"row g-2 align-items-center justify-content-between mt-3\" key={i}>\n                <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Type:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"type\"\n                        maxLength=\"40\"\n                        value={item.type}\n                        onKeyDown={(e) =>\n                          firstInputCharacterSpace(e, item.type.length)\n                        }\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                  <div className=\"bid-inp-container d-flex align-items-center\">\n                    <div className=\"ps-2\">\n                      <h6>Name:</h6>\n                    </div>\n                    <div className=\"inp-container\">\n                      <input\n                        type=\"text\"\n                        name=\"name\"\n                        maxLength=\"40\"\n                        value={item.name}\n                        onKeyDown={(e) =>\n                          firstInputCharacterSpace(e, item.name.length)\n                        }\n                        onChange={(e) => handleChange(i, e, \"properties\")}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                  <div className=\"inp-close text-end\">\n                    <button onClick={() => removeFormFields(i, \"properties\")}>\n                      <img src={InputClose} alt=\"closemodal\" />\n                    </button>\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"properties\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={properties && properties.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default PropertiesModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/StatsModal.js",["629","630"],"import React, { useState } from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"./../../utils/functions\";\nconst StatsModal = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <form>\n          <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n            {stats &&\n              stats.length > 0 &&\n              stats.map((item, i) => {\n                return (\n                  <div\n                    className=\"row g-2 align-items-center justify-content-between mt-3\"\n                    key={i}\n                  >\n                    <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                      <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                        <div className=\"ps-2\">\n                          <h6>Name:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"text\"\n                            name=\"name\"\n                            maxLength=\"40\"\n                            value={item.name}\n                            onKeyDown={(e) =>\n                              firstInputCharacterSpace(e, item.name.length)\n                            }\n                            onChange={(e) => handleChange(i, e, \"stats\")}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                      <div className=\"d-flex align-items-center justify-content-between\">\n                        <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                          <div className=\"ps-2\">\n                            <h6>Value:</h6>\n                          </div>\n                          <div className=\"inp-container\">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              min=\"1\"\n                              maxLength=\"1\"\n                              onKeyDown={(e) => {\n                             \n\n                                decimalNumberValidator(e);\n                              }}\n                              value={item.value}\n                              onChange={(e) => {\n                                console.log(typeof e.target.value);\n                                if (\n                                  +e.target.value > 5 ||\n                                  (+e.target.value <= 0 && item.value == \"\")\n                                ) {\n                                  return \"\";\n                                }\n                                handleChange(i, e, \"stats\");\n                              }}\n                              autoComplete=\"off\"\n                            />\n                          </div>\n                        </div>\n                        <div className=\"value-inp-of mx-3\">\n                          <h6>of</h6>\n                        </div>\n                        <div className=\"bid-inp-container modal-value-inp\">\n                          <div className=\"inp-container \">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              value={5}\n                              autoComplete=\"off\"\n                              className=\"text-center\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                      <div className=\"inp-close text-end\">\n                        <button type=\"submit\">\n                          <img\n                            src={InputClose}\n                            alt=\"closemodal\"\n                            onClick={() => removeFormFields(i, \"stats\")}\n                          />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n          </div>\n        </form>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/LevelsModal.js",["631"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport InputClose from \"../../assets/images/inp-close.svg\";\nimport \"./PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace\n} from \"./../../utils/functions\";\nconst LevelsModal = (props) => {\n  const {\n    show,\n    onHide,\n    levels,\n    addMoreValues,\n    handleChange,\n    removeFormFields,\n    onSave,\n  } = props;\n\n  const handleSubmit = () => {\n    if (levels && levels.length > 0) {\n      let isEmpty = levels.filter(\n        (item) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"levels\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Levels</Modal.Title>\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n          {levels &&\n            levels.length > 0 &&\n            levels.map((item, i) => {\n              return (\n                <div\n                  className=\"row g-2 align-items-center justify-content-between  mt-3\"\n                  key={i}\n                >\n                  <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                    <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                      <div className=\"ps-2\">\n                        <h6>Name:</h6>\n                      </div>\n                      <div className=\"inp-container\">\n                        <input\n                          type=\"text\"\n                          name=\"name\"\n                          maxLength=\"40\"\n                          value={item.name}\n                          onKeyDown={(e) =>\n                            firstInputCharacterSpace(e, item.name.length)\n                          }\n                          onChange={(e) => handleChange(i, e, \"levels\")}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                    <div className=\"d-flex align-items-center justify-content-between\">\n                      <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                        <div className=\"ps-2\">\n                          <h6>Value:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={item.value}\n                            min=\"1\"\n                            maxLength=\"1\"\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            onChange={(e) => {\n                              console.log(e.target.value, \"e.target.value\");\n                              if (\n                                +e.target.value > 5 ||\n                                (+e.target.value <= 0 && item.value == \"\")\n                              ) {\n                                return \"\";\n                              }\n                              handleChange(i, e, \"levels\");\n                            }}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"value-inp-of mx-3\">\n                        <h6>of</h6>\n                      </div>\n                      <div className=\"bid-inp-container modal-value-inp\">\n                        <div className=\"inp-container \">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={5}\n                            autoComplete=\"off\"\n                            className=\"text-center\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                    <div className=\"inp-close text-end\">\n                      <button>\n                        <img\n                          src={InputClose}\n                          alt=\"closemodal\"\n                          onClick={() => removeFormFields(i, \"levels\")}\n                        />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"levels\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3 \"\n            disabled={levels && levels.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default LevelsModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/collections-cards/CollectionsCard.js",["632","633"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions-cards/AuctionsCards.js",["634","635"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/card-slider/CardSlider.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/auctions/auctions.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/footer/footer.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/hero-cards/HeroCards.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/nft-card/nft-card.js",["636","637","638","639","640","641","642","643","644","645"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/BuyModal.js",["646","647","648","649","650"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/BidModal.js",["651"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/offers/offers.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/bids/bids.action.js",["652","653"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/breadcrumb/breadcrumb.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/listing-cards/ListingCards.js",["654"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n",["655","656"],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/modals/ApprovalModal.js",["657","658","659"],"import React from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport { Images } from \"../../assets/assets\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n  return (\n    <>\n      {\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title className=\"acc-title mt-lg-3 mt-5\">\n              {approvalStatus === \"approved\"\n                ? \"Congratulations\"\n                : approvalStatus === \"in-progress\"\n                ? \"We’re on it\"\n                : \"Your account if not approved yet.\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\" onClick={onHide}>\n              <button>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </Modal.Header>\n          <Modal.Body>\n            {approvalStatus === \"approved\" ? (\n              <>\n                <img src={Images.sellerTickIcon} className=\"success-icon\" />\n                <div className=\"w-100 px-4 mb-2\">\n                  <div className=\"acc-approved-container mt-5 mb-5\">\n                    <p className=\"acc-approved ms-4 mb-0\">\n                      Your Account has been approved.\n                    </p>\n                    <img src={Images.smile} className=\"smile-img\" />\n                  </div>\n                </div>\n              </>\n            ) : approvalStatus === \"in-progress\" ? (\n              <>\n                <div className=\"approval-spinner mb-4\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n                <p className=\"processing-title text-center w-100\">\n                  Processing...\n                </p>\n                <div className=\"w-100 px-3\">\n                  <p className=\"approve-msg text-start ms-3 mt-3 \">\n                    Wallet Address\n                  </p>\n                  <input\n                    className=\"input-common mb-5\"\n                    value={address}\n                    readOnly\n                  />\n                </div>\n              </>\n            ) : (\n              <>\n                <img\n                  src={Images.metamaskImg}\n                  className=\"approve-metamask-img\"\n                />\n                <div className=\" w-100 px-3\">\n                  <p className=\"approve-msg w-100 text-start ms-3 mt-3 \">\n                    Please approve your wallet address to reach us\n                  </p>\n                  <input className=\"input-common\" value={address} readOnly />\n                </div>\n                <button\n                  className=\"btn btn-linear-gradient mt-4 my-4 get-approved-btn\"\n                  disabled={approvalStatus === \"pending\"}\n                  onClick={() => approveAccount()}\n                >\n                  {approvalStatus === \"pending\" ? (\n                    <div\n                      class=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>\n                  ) : (\n                    \"Get Approved\"\n                  )}\n                </button>\n              </>\n            )}\n          </Modal.Body>\n        </Modal>\n       \n      }\n    </>\n  );\n};\nexport default ApprovalModal;\n","/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/wallet/wallet.action.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/Users/adnanrafique-butt/Desktop/Projects/mintsclub/frontend/src/components/audioPlayer/waveform/WaveForm.js",["660"],"/Users/adnanrafique-butt/Desktop/