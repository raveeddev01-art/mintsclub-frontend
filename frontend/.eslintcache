eclaration","no-dupe-keys","Duplicate key 'featuredItems'.","ObjectExpression","unexpected","'useEffect' is defined but never used.","'nft1' is defined but never used.","'nft2' is defined but never used.","'nft3' is defined but never used.","'nft4' is defined but never used.","'nft5' is defined but never used.","'Container' is defined but never used.","'mintsLogoSmily' is defined but never used.","'fullNavIcon' is defined but never used.","'tawkToPropertyId' is assigned a value but never used.","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"417","text":"418"},{"range":"419","text":"418"},{"range":"420","text":"418"},{"range":"421","text":"418"},"'WordsFamousNfts' is defined but never used.","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","'network' is assigned a value but never used.","'accounts' is assigned a value but never used.","'dotenv' is defined but never used.","'config' is assigned a value but never used.","React Hook useEffect has a missing dependency: 'props'. Either include it or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["422"],"React Hook useEffect has a missing dependency: 'props.settings.settings'. Either include it or remove the dependency array. If 'setData' needs the current value of 'props.settings.settings', you can also switch to useReducer instead of useState and read 'props.settings.settings' in the reducer.",["423"],{"range":"424","text":"418"},{"range":"425","text":"418"},{"range":"426","text":"418"},{"range":"427","text":"418"},{"range":"428","text":"418"},"'linkError' is assigned a value but never used.","'httpValidation' is assigned a value but never used.","no-useless-escape","Unnecessary escape character: \\/.","Literal","unnecessaryEscape",["429","430"],["431","432"],"'setCaptchaMessage' is assigned a value but never used.","'setDeployNetwork' is assigned a value but never used.","'deploy' is assigned a value but never used.","'setMaxLimit' is assigned a value but never used.","react/jsx-no-duplicate-props","No duplicate props allowed","JSXAttribute","noDuplicateProps",{"range":"433","text":"418"},"'loader' is assigned a value but never used.","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression",["434"],"'formatAddress' is assigned a value but never used.","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","'IconButton' is defined but never used.","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'Typography' is defined but never used.","'ListItemText' is defined but never used.","'InfoComp' is defined but never used.","'genStyle' is assigned a value but never used.","'userId' is assigned a value but never used.","'errorMessage' is assigned a value but never used.","array-callback-return","Array.prototype.map() expects a value to be returned at the end of arrow function.","expectedAtEnd","'ALL_COLLECTIONS' is defined but never used.",{"desc":"435","fix":"436"},[1819,1819]," rel=\"noreferrer\"",[2073,2073],[2336,2336],[2587,2587],{"desc":"437","fix":"438"},{"desc":"439","fix":"440"},[1644,1644],[2086,2086],[2526,2526],[2966,2966],[3396,3396],{"messageId":"441","fix":"442","desc":"443"},{"messageId":"444","fix":"445","desc":"446"},{"messageId":"441","fix":"447","desc":"443"},{"messageId":"444","fix":"448","desc":"446"},[13778,13778],{"desc":"437","fix":"449"},"Update the dependencies array to be: [tawkToKey, tawkToPropertyId]",{"range":"450","text":"451"},"Update the dependencies array to be: [props]",{"range":"452","text":"453"},"Update the dependencies array to be: [props.settings.settings, props.settings.settingsAuth]",{"range":"454","text":"455"},"removeEscape",{"range":"456","text":"457"},"Remove the `\\`. This maintains the current functionality.","escapeBackslash",{"range":"458","text":"459"},"Replace the `\\` with `\\\\` to include the actual backslash character.",{"range":"460","text":"457"},{"range":"461","text":"459"},{"range":"462","text":"453"},[617,622],"[tawkToKey, tawkToPropertyId]",[513,515],"[props]",[645,674],"[props.settings.settings, props.settings.settingsAuth]",[3249,3250],"",[3249,3249],"\\",[3276,3277],[3276,3276],[1276,1278]]