d.","'useState' is defined but never used.","'useEffect' is defined but never used.","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'react' is defined but never used.",["955"],"React Hook useEffect has a missing dependency: 'props.user.sellers.topSellers'. Either include it or remove the dependency array. If 'setSellers' needs the current value of 'props.user.sellers.topSellers', you can also switch to useReducer instead of useState and read 'props.user.sellers.topSellers' in the reducer.",["956"],"no-global-assign","no-unsafe-negation",{"desc":"957","fix":"958"},{"desc":"959","fix":"960"},{"desc":"961","fix":"962"},{"desc":"963","fix":"964"},{"desc":"963","fix":"965"},{"desc":"966","fix":"967"},{"desc":"968","fix":"969"},{"desc":"970","fix":"971"},{"desc":"972","fix":"973"},{"desc":"974","fix":"975"},{"desc":"976","fix":"977"},{"desc":"978","fix":"979"},{"desc":"980","fix":"981"},{"desc":"982","fix":"983"},{"desc":"984","fix":"985"},{"desc":"986","fix":"987"},{"desc":"968","fix":"988"},{"desc":"989","fix":"990"},{"desc":"991","fix":"992"},{"desc":"993","fix":"994"},{"desc":"995","fix":"996"},{"desc":"997","fix":"998"},{"desc":"999","fix":"1000"},{"desc":"1001","fix":"1002"},{"desc":"972","fix":"1003"},{"desc":"1004","fix":"1005"},{"desc":"982","fix":"1006"},{"desc":"966","fix":"1007"},{"desc":"997","fix":"1008"},{"desc":"966","fix":"1009"},{"desc":"1010","fix":"1011"},{"desc":"966","fix":"1012"},{"desc":"1013","fix":"1014"},{"desc":"966","fix":"1015"},{"desc":"1016","fix":"1017"},{"desc":"1018","fix":"1019"},{"desc":"966","fix":"1020"},{"desc":"1021","fix":"1022"},{"desc":"984","fix":"1023"},{"desc":"1024","fix":"1025"},{"desc":"982","fix":"1026"},{"desc":"1027","fix":"1028"},{"desc":"1029","fix":"1030"},{"desc":"993","fix":"1031"},{"desc":"984","fix":"1032"},{"desc":"1033","fix":"1034"},{"