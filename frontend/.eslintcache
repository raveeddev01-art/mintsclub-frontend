e=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={OfferIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Offers\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"table-container\">\n                                  <table class=\"table table-borderless\">\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Floor Difference</th>\n                                        <th scope=\"col\">Expiration</th>\n                                        <th scope=\"col\">From</th>\n                                      </tr>\n                                    </thead>\n                                    <tbody>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={ListingIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Item listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"table-container listing-table\">\n                                  <table class=\"table table-borderless\">\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Expiration</th>\n                                        <th scope=\"col\">From</th>\n                                        <th scope=\"col\">{\"\"}</th>\n                                      </tr>\n                                    </thead>\n                                    <tbody>\n                                      <tr>\n                                        <th scope=\"row\">0.025</th>\n                                        <td>$77.50</td>\n                                        <td>in a day</td>\n                                        <td>BBC1B3</td>\n                                        <td>\n                                          <button>Buy</button>\n                                        </td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-11 col-md-12 col-lg-7 col-xl-5 order-1 order-md-2 mx-auto mb-5 mb-md-0  mx-md-0\">\n                      <div className=\"collection-filter-accordion nft-stats-accordion\">\n                        <div\n                          className=\"accordion accordion-flush \"\n                          id=\"accordionFlushExample\"\n                        >\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingFour\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseFour\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseFour\"\n                              >\n                                Properties\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseFour\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingFour\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"row g-2 justify-content-center align-items-center\">\n                                  {propertiesData &&\n                                    propertiesData.map((data) => {\n                                      return (\n                                        <div className=\"col-6 col-sm-4 col-md-6\">\n                                          <div className=\"properties-content-container d-flex flex-column justify-content-center align-items-center text-center\">\n                                            <div className=\"properties-content\">\n                                              <span>{data.subTitle}</span>\n                                              <h3>{data.title}</h3>\n                                              <p>{data.content}</p>\n                                            </div>\n                                          </div>\n                                        </div>\n                                      );\n                                    })}\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSix\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSix\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSix\"\n                              >\n                                Stats\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSix\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSix\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSeven\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSeven\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSeven\"\n                              >\n                                Levels\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSeven\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSeven\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingEight\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseEight\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseEight\"\n                              >\n                                Boosts\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseEight\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingEight\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingNine\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseNine\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseNine\"\n                              >\n                                Details\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseNine\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingNine\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"contact-address d-flex justify-content-between\">\n                                  <p>Contract Address</p>\n                                  <span>0x7227...3335</span>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Token ID</p>\n                                  <p>1584563428....</p>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Token Standard </p>\n                                  <p>ERC-721</p>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Blockchain </p>\n                                  <p>Polygon</p>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n                  <Card className=\"auction-card detail-card\">\n                    <div className=\"auction-img-wrapper\">\n                      <Card.Img\n                        variant=\"top\"\n                        src={nftDetail.image}\n                        alt=\"AuctionTopImg\"\n                      />\n                    </div>\n                    <Card.Body>\n                      <div>\n                        <span>Current price</span>\n                        <h3>\n                          {nftDetail.currentPrice}\n                          <span>\n                            (${\" \"}\n                            {(nftDetail.currentPrice * exchangeRate).toFixed(2)}\n                            )\n                          </span>\n                        </h3>\n                      </div>\n                      <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                        <div className=\"d-flex align-items-center\">\n                          <img\n                            src={ClockIcon}\n                            alt=\"clock-icon\"\n                            className=\"me-1\"\n                          />\n                          <span>Sale ends March 8, 2022 at 7:40am PKT </span>\n                        </div>\n                        <div className=\"likes-container d-flex align-items-center\">\n                          <span>\n                            {nftDetail.likeCount ? nftDetail.likeCount : 0}\n                          </span>\n                          <img\n                            src={HeartIcon}\n                            alt=\"heart-icon\"\n                            className=\"ms-1\"\n                          />\n                        </div>\n                      </div>\n                      <button\n                        className=\"btn btn-linear-gradient d-flex align-items-center justify-content-center w-75 mx-auto\"\n                        onClick={() => handleRouting()}\n                      >\n                        <p>\n                          {ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId\n                            ? \"Sell\"\n                            : \"Buy Now\"}\n                        </p>\n                      </button>\n                    </Card.Body>\n                  </Card>\n                  <div className=\"detail-description-content mt-5\">\n                    <div className=\"d-flex align-items-center mb-3\">\n                      <img\n                        src={DescriptionIcon}\n                        alt=\"descriptionIcon\"\n                        className=\"me-1\"\n                      />\n                      <h6>Discription</h6>\n                    </div>\n                    <p>{nftDetail.description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-0 mt-md-4 order-3\">\n                  <div className=\"nftDetail-accordion\">\n                    <div\n                      className=\"accordion accordion-flush \"\n                      id=\"accordionFlushExample\"\n                    >\n                      <div className=\"accordion-item\">\n                        <h2 className=\"accordion-header\" id=\"flush-headingTen\">\n                          <button\n                            className=\"accordion-button collapsed\"\n                            type=\"button\"\n                            data-toggle=\"collapse\"\n                            data-target=\"#flush-collapseTen\"\n                            aria-expanded=\"false\"\n                            aria-controls=\"flush-collapseTen\"\n                          >\n                            <img\n                              src={ActivityIcon}\n                              alt=\"price-history\"\n                              className=\"me-2\"\n                            />\n                            Activity\n                          </button>\n                        </h2>\n                        <div\n                          id=\"flush-collapseTen\"\n                          className=\"accordion-collapse collapse\"\n                          aria-labelledby=\"flush-headingTen\"\n                        >\n                          <div className=\"accordion-body\">\n                            <div className=\"table-container\">\n                              <table class=\"table table-borderless\">\n                                <thead>\n                                  <tr>\n                                    <th scope=\"col\">Event</th>\n                                    <th scope=\"col\">Price</th>\n                                    <th scope=\"col\">From</th>\n                                    <th scope=\"col\">To</th>\n                                    <th scope=\"col\">Date</th>\n                                  </tr>\n                                </thead>\n                                <tbody>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                </tbody>\n                              </table>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n\n                      <div className=\"accordion-item\">\n                        <h2\n                          className=\"accordion-header\"\n                          id=\"flush-headingEleven\"\n                        >\n                          <button\n                            className=\"accordion-button collapsed\"\n                            type=\"button\"\n                            data-toggle=\"collapse\"\n                            data-target=\"#flush-collapseEleven\"\n                            aria-expanded=\"false\"\n                            aria-controls=\"flush-collapseEleven\"\n                          >\n                            <img\n                              src={MoreCollectionIcon}\n                              alt=\"price-history\"\n                              className=\"me-2\"\n                            />\n                            More from this collection\n                          </button>\n                        </h2>\n                        <div\n                          id=\"flush-collapseEleven\"\n                          className=\"accordion-collapse collapse\"\n                          aria-labelledby=\"flush-headingEleven\"\n                        >\n                          <div className=\"accordion-body\">\n                            <div className=\"row justify-content-center align-items-center g-3\">\n                              {nftsList && nftsList.length > 0 ? (\n                                nftsList.map((listing) => {\n                                  return (\n                                    <div className=\"col-6 col-sm-6 col-md-4 col-lg-2 px-1\">\n                                      <ListingCards\n                                        CardImg={listing.image}\n                                        name={listing.name}\n                                        price={listing.currentPrice}\n                                        // usd={\n                                        //   listing.currentPrice * exchangeRate\n                                        // }\n                                        id={listing._id}\n                                      />\n                                    </div>\n                                  );\n                                })\n                              ) : (\n                                <p className=\"text-center mt-4\">\n                                  No NFTs Found\n                                </p>\n                              )}\n                            </div>\n                            <div className=\"mt-4 detail-btn-collection text-center\">\n                              {nftsList.length > 0 && (\n                                <button className=\"btn btn-rounded-bordered\">\n                                  View collection\n                                </button>\n                              )}\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            {/* ///////////////////////////////////// Modal */}\n            <div className=\"modal-wrapper\">\n              {false && (\n                <Modal\n                  centered\n                  size=\"lg\"\n                  // className=\"place-bid-modal\"\n                  show={true}\n                  // onHide={this.closeModal}\n                >\n                  <Modal.Header className=\"text-center modal-title-wrapper text-white\">\n                    <Modal.Title>\n                      {2 === 2 ? \"Place A Bid\" : \"Make An Offer\"}\n                    </Modal.Title>\n                  </Modal.Header>\n                  {/* {\n                                isSubmitted && errors &&\n                                <Modal.Body className=\"row pt-2 pb-0\">\n                                    <div className=\"col-12\">\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\n                                    </div>\n                                </Modal.Body>\n                            } */}\n                  <Modal.Body>\n                    <div className=\"price-wrapper d-flex\">\n                      <div className=\"price-text position-relative\">\n                        <div className=\"text-white mb-2 absolute-wrapper\">\n                          <b>Price</b>\n                        </div>\n                        <div className=\"text-right mb-2\">\n                          <i className=\"fas fa-exclamation-circle ml-2 text-white\" />\n                        </div>\n                        <div className=\"d-flex\">\n                          <select\n                            className=\"form-control currency-options\"\n                            id=\"currency\"\n                            name=\"nftConfig.price.currency\"\n                            onChange={(e) => this.onChange(e)}\n                          >\n                            {currencies &&\n                              currencies.map((currency, index) => {\n                                return (\n                                  <option key={index} value={currency.symbol}>\n                                    {currency.symbol}\n                                  </option>\n                                );\n                              })}\n                          </select>\n                          <input\n                            type=\"text\"\n                            placeholder=\"Amount\"\n                            className=\"amount-btn ml-3\"\n                            name=\"nftConfig.price.amount\"\n                            placeholder=\"Amount\"\n                            className=\"amount-btn ml-3\"\n                            style={{ borderRadius: \"4px\" }}\n                            onChange={(e) => this.onChange(e)}\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            defaultValue={nftConfig.price.amount}\n                            required\n                          />\n                          <div className=\"text-right mb-2 dollar-wrapper\">\n                            $ 0.00\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </Modal.Body>\n                  <Modal.Body className=\"text-danger\">\n                    {validator.message(\n                      \"amount\",\n                      nftConfig.price.amount,\n                      \"required\"\n                    )}\n                  </Modal.Body>\n                  {/* <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\n                                <div className=\"offer-expiration-wrapper text-white\">\n                                    <b>Offer Expiration</b>\n                                </div>\n                                <div>\n                                    <div className=\"d-flex\">\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\n                                            style={{\n                                                padding: \"7px 55px 7px 55px\",\n                                                border: \"none\",\n                                                outline: \"none\",\n                                                borderRadius: \"4px\",\n                                                background: \"#808080\",\n                                                display: \"flex\",\n                                                alignItems: \"center\",\n                                                cursor: \"pointer\",\n                                                height: \"51px\",\n                                                color: \"#000\"\n                                            }}\n                                        >\n                                            {\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\n                                                    return (\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\n                                                    )\n                                                })\n                                            }\n                                        </select>\n                                        <div>\n                                            <div className=\"mr-auto budle-wrapper\">\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\n                                            </div>\n                                            <span className=\"text-danger message\">{validator.message('amount', nftConfig.price.amount, 'required')}</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </Modal.Body> */}\n                  <Modal.Body className=\"justify-content-center align-items-center\">\n                    <div className=\"d-flex justify-content-around place-bid-btn\">\n                      <button\n                        className=\"ethereum-btn mr-3 place-bid-ethereum-btn\"\n                        disabled={loader}\n                        // onClick={() => this.submit()}\n                      >\n                        {2 === 2 ? initData.bidBtn : initData.bidBtn}\n                      </button>\n                      {/* <button className=\"ethereum-btn\">Add funds</button> */}\n                    </div>\n                  </Modal.Body>\n                  <Modal.Footer>\n                    <button\n                      className=\"btn banner-btn btn-primary\"\n                      // onClick={this.closeModal}\n                    >\n                      Close\n                    </button>\n                  </Modal.Footer>\n                </Modal>\n              )}\n            </div>\n          </section>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state, \"state in nft detail=>\"),\n  {\n    nftDetail: state.nft.nftsData,\n    nftsAuth: state.nft.nftsAuth,\n    nftsByCollection: state.nft.nftsByCollection,\n    nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  getNFT,\n  getNFTsByCollection,\n})(NFTDetail);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],["1280","1281"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/Slider/slider.js",["1282","1283","1284"],"import React, { useState, useEffect } from \"react\";\nimport \"./slider.css\";\nimport Slider from \"react-slick\";\nimport \"slick-carousel/slick/slick.css\";\nimport \"slick-carousel/slick/slick-theme.css\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\n// import image from \"../../assets/images/test.jpg\";\nimport nftBack from \"../../assets/images/nftBack.png\";\n// import nftImage from \"../../assets/images/nftImage.png\";\n\nconst SimpleSlider = (props) => {\n  const [showSlider, setShowSlider] = useState(false);\n  useEffect(() => {\n    if (showSlider == false) {\n      setTimeout(() => {\n        setShowSlider(true);\n      }, 300);\n    }\n  });\n  const settings = {\n    dots: true,\n    infinite: true,\n    speed: 500,\n    slidesToShow: 1,\n    slidesToScroll: 1,\n  };\n\n  return (\n    <div\n      className=\"position-relative slider-container\"\n      style={{ backgroundColor: \"\" }}\n    >\n      {/* <h2> Single Item</h2> */}\n\n      <img\n        src={nftBack}\n        style={{ width: \"26rem\", minWidth: \"26rem\" }}\n        className=\"slider-bg\"\n      />\n\n      <div\n        className=\"position-absolute nfts-title-container\"\n        style={{ top: \"-3rem\", right: \"9rem\" }}\n      >\n        <p\n          className=\"text-white mb-0 worlds-famous\"\n          style={{\n            fontSize: \"34px\",\n            fontWeight: \"bold\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          World's Famous\n        </p>\n        <p\n          className=\"mb-0 text-white nfts-title\"\n          style={{\n            // fontSize: \"165px\",\n            fontSize: \"8.2vw\",\n            fontWeight: \"bold\",\n            marginTop: \"-3rem\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          NFT's\n        </p>\n      </div>\n      <div\n        className=\"position-relative slider-wrapper\"\n        style={{\n          bottom: \"22rem\",\n          right: \"-2rem\",\n          cursor: \"pointer\",\n          display: showSlider ? \"block\" : \"none\",\n        }}\n      >\n        <Slider {...settings}>\n          {props.assetList.map((nft, index) => {\n            return (\n              <div key={index} onClick={() => window.open(nft.link)}>\n                <img\n                  src={nft.img}\n                  className=\"slider-img\"\n                  alt={nft}\n                  style={{ objectFit: \"cover\" }}\n                />\n              </div>\n            );\n          })}\n        </Slider>\n      </div>\n    </div>\n  );\n};\nexport default SimpleSlider;\n",["1285","1286"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/Navbar/navbar.js",["1287","1288","1289","1290","1291","1292","1293","1294","1295"],"// import react from 'react'\nimport \"./navbar.css\";\nimport { useHistory } from \"react-router-dom\";\nimport { BsTwitter } from \"react-icons/bs\";\nimport { SiDiscord } from \"react-icons/si\";\nimport { FaTelegramPlane } from \"react-icons/fa\";\nimport { GrReddit } from \"react-icons/gr\";\nimport { AiFillHome } from \"react-icons/ai\";\nimport mintsLogoSmily from \"../../assets/images/mintsClubSmilyLogo1.png\";\nimport MintsClub from \"../../assets/images/MintsClub-White.png\";\nimport { ENV } from \"../../config/config\";\nimport fullNavIcon from \"../../assets/images/mintsClubLogo1.png\";\n\nconst Navbar = () => {\n  const history = useHistory();\n  const twitter = ENV.twitterLink;\n  const discordLink = ENV.discordLink;\n  const telegramLink = ENV.telegramLink;\n  const redditLink = ENV.redditLink;\n\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n\n  return (\n    <div className=\"nav align-items-center\">\n      <input type=\"checkbox\" id=\"nav-check\" />\n      {/* <div className=\"nav-icon\" ><img src={fullNavIcon} width=\"20%\" /></div> */}\n      <div className=\"nav-header\" style={{ width: \"25%\" }}>\n        <div className=\"nav-title\" onClick={() => history.push(\"/\")}>\n          <img src={MintsClub} width=\"100%\" />\n        </div>\n      </div>\n      <div className=\"nav-btn\">\n        <label htmlFor=\"nav-check\">\n          <span></span>\n          <span></span>\n          <span></span>\n        </label>\n      </div>\n\n      <div className=\"nav-links\">\n        <a\n          className=\"navbar-item\"\n          href=\"#\"\n          target=\"_blank\"\n          style={{ color: \"#ffd33e\" }}\n        >\n          <AiFillHome className=\"home-icon \" />\n          Home\n        </a>\n\n        {twitter && twitter.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={twitter} target=\"_blank\">\n              <BsTwitter className=\"home-icon \" />\n              Twitter\n            </a>\n          </>\n        )}\n\n        {discordLink && discordLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={discordLink} target=\"_blank\">\n              <SiDiscord className=\"home-icon \" />\n              Discord\n            </a>\n          </>\n        )}\n\n        {telegramLink && telegramLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={telegramLink} target=\"_blank\">\n              <FaTelegramPlane className=\"home-icon \" />\n              Telegram\n            </a>\n          </>\n        )}\n\n        {redditLink && redditLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={redditLink} target=\"_blank\">\n              <GrReddit className=\"home-icon \" />\n              Reddit\n            </a>\n          </>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Navbar;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/utils/exportData.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/types.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/types/types.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/nfts/nfts.action.js",["1296","1297","1298","1299"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n    axiosPostFormData,\n    decimalNumberValidator,\n  } from \"./../../utils/functions\";\n  import axios from 'axios'\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    \n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    \nconsole.log(url,\"getNFTs\")\n\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n     \n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n\n      // alert(\"called\")\n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n   \n    });\n};\n\nexport const getNFTsByCollection=(id)=>(dispatch)=>{\n  \n\n  let data ={\n    collectionId:id\n  }\n\n\n  dispatch(emptyError());\n\n    const url = `${ENV.url}nfts/getNFTsByCollection`;\n    axios.post(url,data)\n    .then(function (response) {\n  \n      if (response.data.success) {\n              dispatch({\n                type:GET_NFTS_BY_COLLECTION,\n                payload:response.data.data\n              })\n         \n            } else {\n              dispatch({\n                type: GET_ERRORS,\n                payload: response.data,\n              });\n            }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n              type: GET_ERRORS,\n              payload: error,\n            });\n    });\n  \n  \n}\n\nexport const getMyLikedNfts=(qs='')=>(dispatch)=>{\n\n\n  dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url=url+qs\n    axios.get(url)\n    .then(function (response) {\nconsole.log()\n      if (response.data.success) {\n        dispatch({\n          type: GET_MYLIKED_NFTS,\n          payload: response.data.data,\n        });\n         \n            } else {\n             \n            }\n    })\n    .catch(function (error) {\n      console.log(error);\n    \n    });\n  \n  \n}\n\nexport const createNFT= async (formData)=>{\n    try {\n\n        const res = await axiosPostFormData(\n            \"nfts/create\",\n            formData,\n            true\n          );\n    }\n    catch(err){\n\n    }\n}\nexport const setNftToken = (formData) => async (dispatch) => {\n\n  const res = await axiosPostFormData(\n            \"nfts/storeNFTData\",\n            formData,\n            true\n          );\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        console.log(data,\"profile nfts\")\n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n          \n        } else {\n     \n        }\n      })\n      .catch((errors) => {\n     \n      });\n  };\n\n\n\n\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/auctions/home-auctions.js",["1300","1301","1302","1303","1304","1305","1306","1307","1308","1309","1310","1311","1312","1313","1314","1315","1316","1317"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/footer/footer.js",["1318","1319","1320","1321","1322","1323","1324","1325"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  useEffect(() => {\n    if (props.settings.settingsAuth) {\n      setData(props.settings.settings);\n    }\n  }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div class=\"input-group notify-form\">\n                  <div class=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      class=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2021 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/user/user.action.js",["1326"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport { GET_ERRORS, SET_USER, GET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, BEFORE_USER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { getCollections, setAuthState } from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n    return {\n        type: BEFORE_USER\n    }\n}\n\n// method to set user data\nexport const setUser = (user) => dispatch => {\n    dispatch(emptyError())\n    dispatch({\n        type: SET_USER,\n        payload: user\n    })\n}\n\n// method to get user data\nexport const getUser = () => dispatch => {\n    dispatch({\n        type: GET_USER\n    })\n}\n\n// method to login using wallet address and sign\nexport const login = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/login/`;\n    // const url = `http://localhost:5000/v1/front/auth/login/`;\n    console.log(payload,\"payload\")\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            const userId = data.data._id;\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => dispatch => {\n    \n    dispatch(emptyError());\n    const url = `${ENV.url}auth/register/`;\n \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        console.log(errors,\"register resonse\")\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n            toast.success(data.message)\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getTopSellers = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/top-sellers`;\n   \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n     \n        if (data.status) {\n            dispatch({\n                type: TOP_SELLERS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n     \n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getCreators = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/creators`;\n    // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n    \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n      \n        if (data.status) {\n            dispatch({\n                type: SET_CREATORS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/${userId}`;\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"user response\")\n        if (data.status) {\n            dispatch({\n                type: SET_INDIVIDUAL_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => dispatch => {\n    dispatch(emptyError());\n    dispatch({\n        type: SET_INDIVIDUAL_USER,\n        payload: user\n    })\n};\n\nexport const logoutUser = () => (dispatch) => {\n    dispatch({\n        type: SET_USER,\n        userAuth: false,\n        userData: null\n    })\n    dispatch(setAuthState())\n    localStorage.removeItem('encuse');\n}","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/collections.js",["1327","1328","1329"],"import React, {\r\n  useState,\r\n  useEffect,\r\n  forwardRef,\r\n  useImperativeHandle,\r\n} from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeCollection, getCollections } from \"./collections.actions\";\r\nconst { collectionFeaturedImg, userDefaultImg } = ENV;\r\n\r\nconst Collections = forwardRef((props, ref) => {\r\n  const [collections, setCollections] = useState(null);\r\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    if (props.source) setSource(props.source);\r\n\r\n    if (props.setLoader) props.setLoader(false); //to be changed\r\n\r\n    getCollections();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.collection.getAuth) {\r\n      const { collections } = props.collection;\r\n      const userId = ENV.getUserKeys(\"_id\")._id;\r\n      if (props.mycollections) {\r\n        let myCollections = collections.filter(\r\n          (item) => item.userId === userId\r\n        );\r\n        setCollections(myCollections);\r\n      } else {\r\n        setCollections(collections);\r\n      }\r\n      props.beforeCollection();\r\n      if (props.setLoader) props.setLoader(false);\r\n    }\r\n  }, [props.collection.getAuth]);\r\n\r\n  const getCollections = (categoryId = null) => {\r\n    const filter = {\r\n      page: 1,\r\n    };\r\n    if (categoryId) filter.categoryId = categoryId;\r\n\r\n    if (props.userId) filter.userId = props.userId;\r\n\r\n    if (props.popular) filter.popular = true;\r\n\r\n    // if not all then apply limit\r\n    if (!props.all) filter.limit = props.limit ? props.limit : 8;\r\n    else filter.all = true;\r\n\r\n    const qs = ENV.objectToQueryString(filter);\r\n    props.getCollections(qs);\r\n  };\r\n\r\n  useImperativeHandle(ref, () => ({\r\n    getCatCollections: (catId) => {\r\n      if (props.setLoader) props.setLoader(true);\r\n\r\n      getCollections(catId);\r\n    },\r\n    colCount: collections?.length || 0,\r\n  }));\r\n\r\n  const dummyCollections = [\r\n    {\r\n      id: 1,\r\n      name: \"Modern Art collection\",\r\n      itemNos: \"5\",\r\n      owner: \"Abcd\",\r\n    },\r\n    {\r\n      id: 2,\r\n      name: \"Modern Art collection\",\r\n      itemNos: \"5\",\r\n      owner: \"Abcd\",\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <div className=\"popular-collections-area\">\r\n      <div className=\"container\">\r\n        <div\r\n          className={`row items ${!collections && \"justify-content-center\"}`}\r\n        >\r\n          <>\r\n            {/* {collections && collections.length ? (\r\n              collections.map((item, idx) => { */}\r\n            {dummyCollections && dummyCollections.length ? (\r\n              dummyCollections.map((item, idx) => {\r\n                return (\r\n                  <div\r\n                    key={`cd_${idx}`}\r\n                    className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                  >\r\n                    <div className=\"card no-hover text-center\">\r\n                      <div className=\"image-over\">\r\n                        <Link\r\n                          to={`/collection-details/${window.btoa(item._id)}`}\r\n                        >\r\n                          <img\r\n                            className=\"card-img-top\"\r\n                            src={\r\n                              item.featuredImg\r\n                                ? item.featuredImg\r\n                                : collectionFeaturedImg\r\n                            }\r\n                            alt=\"Collection Featured Image\"\r\n                          />\r\n                        </Link>\r\n                        <Link\r\n                          className=\"seller\"\r\n                          to={\r\n                            source === 1\r\n                              ? `/collection-details/${window.btoa(item._id)}`\r\n                              : `/author/${item.user._id}`\r\n                          }\r\n                        >\r\n                          <div className=\"seller-thumb avatar-lg\">\r\n                            <img\r\n                              className=\"rounded-circle\"\r\n                              src={\r\n                                source === 1\r\n                                  ? item.logo\r\n                                  : item.user.profilePhoto\r\n                                  ? item.user.profilePhoto\r\n                                  : userDefaultImg\r\n                              }\r\n                              alt={\r\n                                source === 1 ? \"Collection Logo\" : \"User Avatar\"\r\n                              }\r\n                            />\r\n                          </div>\r\n                        </Link>\r\n                      </div>\r\n                      <div className=\"card-caption col-12 p-0\">\r\n                        <div className=\"card-body mt-4\">\r\n                          <Link\r\n                            to={`/collection-details/${window.btoa(item._id)}`}\r\n                          >\r\n                            <h5 className=\"mb-2\">{item.name}</h5>\r\n                          </Link>\r\n                          <span>\r\n                            {item.category\r\n                              ? item.category.name\r\n                              : \"Category: N/A\"}\r\n                          </span>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                );\r\n              })\r\n            ) : (\r\n              <div className=\"col-12\">\r\n                <p className=\"text-center mt-4\">No Collection Found</p>\r\n              </div>\r\n            )}\r\n          </>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n});\r\n\r\nconst mapStateToProps = (state) => ({\r\n  collection: state.collection,\r\n  error: state.error,\r\n});\r\n\r\nexport default connect(\r\n  mapStateToProps,\r\n  { beforeCollection, getCollections },\r\n  null,\r\n  { forwardRef: true }\r\n)(Collections);\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/utils/web3.js",["1330","1331","1332","1333","1334","1335","1336","1337","1338","1339"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\nimport { placeBid } from \"../components/bids/bids.action\";\nimport { setFixedPriceNftTOken, acceptBit, placeBidApi } from \"./functions\";\nimport { changeOwnerShip } from \"./functions\";\nimport { Redirect } from \"react-router-dom\";\n\nlet Contract = require(\"web3-eth-contract\");\n\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet tokenContract = new Contract(abi, mintsClubContractAddress);\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n//get web3\nvar web3Provider = null;\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\n    const getWeb3 = async () => {\n        let instance;\n        //         web3Provider = new Web3.providers.HttpProvider('http://localhost:7545');\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"https://rpc-mumbai.maticvigil.com\");\n  }\n\n  return instance;\n};\n\nexport const mintNFt = async (metaData) => {\n  let web3 = await getWeb3();\n  console.log(web3, \"web3==>\");\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n    let connectedAddress = await connectMetamask();\n    \n    const contractM = new web3.eth.Contract(abi, ENV.mintsClubContractAddress);\n    let result = await contractM.methods\n      .mint(connectedAddress, 1, 23, \"0x\", metaData)\n      .send({ from: connectedAddress });\n   \n    console.log(result, \"result\");\n    return result;\n  } catch (err) {\n    console.log(err, \"error while minting\");\n    return err;\n  }\n};\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\n// TEMP. ADDING THIS METHOD - COPY OF CONNECTMETAMASK\n// export const connectMetamaskCopy = async ()=> {\n//     if(window.ethereum) {\n//         const web3 = new Web3(Web3.givenProvider);\n//         const network = await web3.eth.net.getNetworkType();\n//         await window.ethereum.enable();\n//         let accounts = await web3.eth.getAccounts();\n//         let chainId = await web3.eth.getChainId();\n//         if(chainId !== requiredChainId) {\n//             // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n//         }\n//         return accounts[0];\n//     }\n//     else {\n//         // alert(\"Please install metamask to connect to the Marketplace\");\n//         toast.error(\"Please install metamask to connect to the Marketplace\");\n//     }\n// }\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    const web3 = new Web3(Web3.givenProvider);\n    // const network = await web3.eth.net.getNetworkType();\n    await window.ethereum.enable();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    // console.log(chainId, \"chainId\");\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n      // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n    }\n    // console.log(accounts[0],\"account==>\")\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        toast.success(\"wallet connected\");\n      }\n      //    console.log('hello');\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    // alert(\"Please install metamask to connect to the Marketplace\");\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  const web3 = new Web3(Web3.givenProvider);\n  // const network = await web3.eth.net.getNetworkType();\n  if (window.ethereum) {\n    await window.ethereum.enable();\n    let accounts = await web3.eth.getAccounts();\n    return accounts[0];\n  }\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    const web3 = new Web3(Web3.givenProvider);\n    window.web3 = new Web3(window.ethereum);\n    const network = await web3.eth.net.getNetworkType();\n    await window.ethereum.enable();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n      // toast.error(`Please switch to ${ENV.requiredChainName} testnet`);\n    }\n    return accounts[0];\n  } else {\n    // alert(\"Please install metamask to connect to the Marketplace\");\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    const web3 = new Web3(Web3.givenProvider);\n    // const network = await web3.eth.net.getNetworkType();\n    await window.ethereum.enable();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    // console.log(chainId,\"chainId\")\n    // console.log(chainId, \"chainId\");\n    let currentNetwork = getNetworkName(chainId);\n    // console.log(currentNetwork,\"currentNetwork==>\")\n    return currentNetwork;\n  }\n};\n\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    // const web3 = await getWeb3();\n    // if (!web3) {\n    //     toast.error(\"No web3 instance found\");\n    //     return false;\n    // }\n\n    const web3 = new Web3(Web3.givenProvider);\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    // placeBid()\n    // console.log(signature,\"signature===>\")\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\n// export const testing=()=>{\n//     const test=web3.eth.\n// }\n\nexport const mint = async (metaData) => {\n  // alert(\"dfdfdf\")\n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n  // let tokenContract1 = new Contract(liveAuctionsAbi., nftContractAddress);\n  try {\n   \n  } catch (e) {\n  \n  }\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = (token) => {\n  };\n\nexport const createNft = async (metaData, nftId) => {\n\n};\n\n// openNFTForBidding\nexport const openNFTForBidding = async (token, timeduration) => {\n \n};\n\nexport const setNftToken = (body) => {\n  // console.log(body,\"body===>\")\n  // let dummy={\n  //     nftToken:\"123\",\n  //     nftId:\"123\"\n\n  // }\n\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      // alert(\"in setting nft then\")\n      // console.log(data,\"data==>\")\n      if (data.success) {\n        window.location.href = \"/explore-all\";\n        //    console.log(data,\"data in success\")\n      } else {\n      }\n    })\n    .catch((error) => {\n      // alert(\"in setting nft then\")\n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {\n  \n};\n\nexport const placeBidNft = async (\n  body,\n  tokenId,\n  price,\n  toAddress,\n  fromAddress\n) => {\n \n};\n\nexport const SellOnFixedPrice = async (tokenId, price) => {\n \n};\n\nexport const BuyFixedPriceNFTs = async (price, tokenId, nftOwnerId) => {\n\n};\n\nexport const getCurrentAddress = async () => {\n  const web3 = new Web3(Web3.givenProvider);\n\n  let accounts = await web3.eth.getAccounts();\n  // console.log(accounts,\"accounts\")\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async (tokenId, body) => {\n\n};\nexport const signTransaction = async () => {\n\n};\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/hero/hero.js",["1340","1341"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport ExploreIcon from \"../../assets/images/explore-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-rounded-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                {/* <i className=\"icon-rocket mr-2\" /> */}\r\n                <img src={ExploreIcon} alt=\"exploreIcon\" className=\"me-2\" />\r\n                <p>Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"d-lg-none d-flex watch-video align-items-center mt-5 mb-4\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6 col-xl-7 \">\r\n            <Slider\r\n              setHandler={setHandler}\r\n              sliderRadioButtons={sliderRadioButtons}\r\n              handleRadioInputs={handleRadioInputs}\r\n              sliderChecked={sliderChecked}\r\n            />\r\n          </div>\r\n          <div className=\"d-none d-lg-block col-12 col-lg-7\">\r\n            <div className=\"watch-video d-flex align-items-center\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-5\">\r\n            <div className=\"btn-container mx-auto mx-lg-0\">\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn me-3\"\r\n                onClick={prevBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-left\"></i>\r\n              </button>\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn\"\r\n                onClick={nextBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-right\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default Hero;\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/top-seller/topseller2.js",["1342","1343","1344","1345"],"import React, { useEffect, useState } from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\r\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\r\nimport \"./topseller.css\";\r\n\r\nconst exmpData = [\r\n  {\r\n    id: 1,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 2,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 3,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 4,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 5,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 6,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 7,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 8,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 9,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 10,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 11,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 12,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n];\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n  useEffect(() => {\r\n    setSellers(props.user.sellers);\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content\">\r\n                <span>CREATIVE ARTIST</span>\r\n                <h3 className=\"mb-0\">Top Sellers</h3>\r\n              </div>\r\n              {props.viewAll ? (\r\n                <div className=\"intro-btn\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/top-sellers-list\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              ) : (\r\n                \"\"\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row items\">\r\n          {sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              return (\r\n                <div\r\n                  key={`ts_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                >\r\n                  {/* Single Seller */}\r\n                  <div className=\"card\">\r\n                    <div className=\"single-seller d-flex align-items-center\">\r\n                      <Link to={`/author/${author._id}`}>\r\n                        <div className=\"seller-avatar-container\">\r\n                          <img\r\n                            className=\"avatar-md rounded-circle\"\r\n                            //   src={\r\n                            //     author.profileImage\r\n                            //       ? author.profileImage\r\n                            //       : ENV.globalPlaceholderImage\r\n                            //   }\r\n                            src={AvatarImg}\r\n                            alt=\"\"\r\n                          />\r\n                          <span className=\"seller-avatar-active\">\r\n                            <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                          </span>\r\n                        </div>\r\n                      </Link>\r\n                      {/* Seller Info */}\r\n                      <div className=\"seller-info ml-3 w-100\">\r\n                        <Link\r\n                          className=\"seller mb-2\"\r\n                          to={`/author/${author._id}`}\r\n                        >\r\n                          {author.username}\r\n                        </Link>\r\n                        <span className=\"text-end\">{\"256.6ETH\"}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          ) : (\r\n            <p>Top Sellers not available</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/assets/assets.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/filter-component/FilterComponent.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/actions/actions.js",["1346","1347","1348","1349"],"import { toast } from 'react-toastify';\nimport Web3 from 'web3';\nimport {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  // DEPLOY_CONTRACT,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS,\n  SET_OTP_EMAIL\n} from '../types/types';\n\nimport { ENV } from '../../config/config';\nimport { connectMetamaskCopy } from '../../utils/web3';\nimport axios from 'axios';\nimport dotenv from 'dotenv';\nexport const currentStepAction = () => (dispatch) => {\n  // alert(\"called\")\n\n  dispatch({\n    type: CURRENT_STEP,\n  });\n};\nexport const currentStepDecrement = () => (dispatch) => {\n  dispatch({\n    type: CURRENT_STEP_DECREMENT,\n  });\n};\nexport const clearCurrentStep = () => (dispatch) => {\n  dispatch({\n    type: CLEAR_CURRENT_STEP,\n  });\n};\n\nexport const contractResponse = () => (dispatch) => {\n  dispatch({\n    type: CONTRACT_REPONSE,\n  });\n};\nexport const setProperties = (data) => (dispatch) => {\n  // alert(\"callled\")\n  dispatch({\n    type: SET_PROPERTIES,\n    payload: data,\n  });\n};\nexport const setLevels = (data) => (dispatch) => {\n  dispatch({\n    type: SET_LEVELS,\n    payload: data,\n  });\n};\nexport const setOtpEmail=(data)=>(dispatch)=>{\n  dispatch({\n    type: SET_OTP_EMAIL,\n    payload: data,\n  });\n}\n\nexport const sendOtp = (data) => (dispatch) => {\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/sendVerficationEmail`;\n\n  axios.post(url, data, config).then(\n    (res) => {\n      //  alert(\"email sent\")\n      // console.log(res);\n      if (res.status === 200) {\n        //  toast.success(\"Otp Verification Code sent to \")\n      }\n    },\n    (err) => {\n      console.log(err, 'error');\n      alert('error while sending email');\n    }\n  );\n};\nfunction msToTime(ms) {\n  let seconds = (ms / 1000).toFixed(1);\n  let minutes = (ms / (1000 * 60)).toFixed(1);\n  let hours = (ms / (1000 * 60 * 60)).toFixed(1);\n  let days = (ms / (1000 * 60 * 60 * 24)).toFixed(1);\n  if (seconds < 60) return seconds + ' Sec';\n  else if (minutes < 60) return minutes + ' Min';\n  else if (hours < 24) return hours + ' Hrs';\n  else return days + ' Days';\n}\n\nexport const verifyOtp = (email, otp) => (dispatch) => {\n  let data = {\n    email,\n    otp,\n  };\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/verify`;\n  console.log(url);\n\n  axios.post(url, data, config).then(\n    (res) => {\n      console.log(res,\"res\")\n      if(res.data.email){\n\n        if(res.data.email!==email){\n          toast.error('Invalid Email or OTP');\n          return \" \"\n        }\n      }\n\n    if(res.data.status==false){\n      toast.error(res.data.message);\n      return \" \"\n    }\n\n      if (res.data.status === true) {\n        \n        setOtpEmail(res.data.data[0].email)\n        if (res.data.diffMins < -10) {\n          toast.error('Token is  Expired ,Please resend token & try again');\n          return ' ';\n        } else {\n          toast.success(res.data.message);\n      \n          dispatch({\n            type: SET_OTP_STATUS,\n            payload: true,\n          });\n        }\n      }\n      else {\n        // console.log(\"error\")\n        toast.error(res.data.message);\n      }\n    },\n    (err) => {\n     toast.error(\"Invalid OTP or Email\")\n    }\n  );\n};\n\nexport const deployContract = (data, address, supply) => (dispatch) => {\n\n\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/createUser`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then(\n      (res) => {\n        // console.log(res, \"response from backendfdkfd\");\n        const abi = res.data.data.abi;\n        if (res.data.status === true) {\n          let metaDataList = [];\n\n          for (let i = 1; i <= supply; i++) {\n            metaDataList.push(res.data.data.metaData);\n            dispatch({\n              type: SET_CONTRACT_INFO,\n              payload: res.data,\n            });\n          }\n\n          try {\n            const web3 = new Web3(Web3.givenProvider);\n            // const gasPrice = \"5000000\";\n            let contract = new web3.eth.Contract(abi, null, {\n              data: res.data.data.bytecode,\n\n              from: address,\n              // gas: 4600000,\n            });\n            contract\n              .deploy({\n                data: res.data.data.bytecode,\n                arguments: [res.data.data.name, res.data.data.symbol],\n              })\n              .send({\n                from: address,\n                // gas: gasPrice,\n              })\n              .then((contractInstance) => {\n                toast.success('Contract Deployed Successfully!');\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n\n                let info = {\n                  ...res.data,\n                  contractAddress: contractInstance.options.address,\n                };\n                dispatch({\n                  type: SET_CONTRACT_INFO,\n                  payload: {\n                    data: { ...info },\n                  },\n                });\n                dispatch({\n                  type: CONTRACT_ADDRESS,\n                  payload: contractInstance.options.address,\n                });\n                const contractData = {\n                  contractadd: contractInstance.options.address,\n                  Network: 'Etherium',\n                  Deployed: true,\n                };\n\n                dispatch({\n                  type: CONTRACT_REPONSE,\n                  payload: contractData,\n                });\n              })\n              .catch((err) => {\n                // console.log(\"error\", err);\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n                toast.error('Transaction Failed please check wallet history!');\n              });\n          } catch (err) {\n            dispatch({\n              type: LOADER,\n              payload: false,\n            });\n            toast.error('Transaction Failed please check wallet history!');\n          }\n        } else {\n          dispatch({\n            type: LOADER,\n            payload: false,\n          });\n          // console.log(res, \"dkfjdkfjkdjfkd\");\n          toast.error(res.data.data);\n\n          // dispatch({\n          //   type: CONTRACT_REPONSE,\n          //   payload: res.data,\n          // });\n        }\n        // console.log(res);\n      },\n      (error) => {\n        // console.log(error, 'error handle');\n        toast.error(error.response.data.data);\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        // console.log(error, \"error==dfjdkf\");\n        dispatch({\n          type: CONTRACT_ERROR_MESSAGE,\n          payload: error,\n        });\n        // alert(\"contract response\")\n        // dispatch({\n        //   type: CONTRACT_REPONSE,\n        //   payload: error,\n        // });\n        // resolve(error)\n      }\n    )\n    .catch((err) => {\n      console.log(err, 'error later==>');\n    });\n};\n\nexport const mintToken = (data, address, supply, email) => (dispatch) => {\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n  // console.log('here is data', data)\n  dispatch({\n    type: CONNECT_WELLET,\n    payload: address,\n  });\n  let metaDataList = [];\n  // console.log(data, \"data=====>\");\n  let metaData = '';\n  if (!data.data) {\n    metaData = data;\n  } else {\n    metaData = data.data.metaData;\n  }\n\n  for (let i = 1; i <= supply; i++) {\n    metaDataList.push(metaData);\n  }\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n  // console.log(\"metaDataList\", metaDataList);\n\n  try {\n    const web3 = new Web3(Web3.givenProvider);\n    // console.log('web3', web3);\n    const contractM = new web3.eth.Contract(\n      data.data.abi,\n      data.contractAddress\n    );\n    // console.log(\"metaDataList\", metaDataList);\n    contractM.methods\n      .batchMint(address, metaDataList, supply)\n      .send({\n        from: address,\n        // gas: 5000000,\n      })\n      .then((response) => {\n        // console.log(response, \"res of createNFT===>\");\n        handleEmailRequest(email);\n        let count = localStorage.getItem(address);\n        if (count) {\n          console.log(typeof (+count * 1), 'issueee');\n          localStorage.setItem(address, +count * 1 + 1);\n        } else {\n          localStorage.setItem(address, 1);\n        }\n        toast.success('Minting Successful');\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        dispatch({\n          type: TOKEN_ID,\n          payload: response,\n        });\n        dispatch({\n          type: MINTING_RESPONSE,\n          payload: response,\n        });\n      })\n      .catch((err) => {\n        console.log(err, 'error==>');\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        toast.error('Transaction Failed please check wallet history!');\n      });\n  } catch (err) {\n    dispatch({\n      type: LOADER,\n      payload: false,\n    });\n    toast.error('Transaction Failed please check wallet history!');\n  }\n};\nconst handleEmailRequest = (email) => {\n  let data = {\n    email,\n  };\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/addEmail`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then((res) => {\n      // console.log(res, \"email response==>\");\n    })\n    .catch((err) => console.log(err));\n};\nexport const setContractInfo = () => (dispatch) => {\n  dispatch({\n    type: SET_CONTRACT_INFO,\n  });\n};\n\nexport const connectWallet = () => (dispatch) => {\n  connectMetamaskCopy()\n    .then((address) =>\n      // console.log(address,\"address\"),\n      dispatch({\n        type: CONNECT_WELLET,\n        payload: address,\n      })\n    )\n    .catch((err) => console.log(err, 'error'));\n};\n\nexport const hometest = () => (dispatch) => {\n  // dispatch({\n  // type:HOME_TEST,\n  // payload: data\n  // })\n  // dispatch(emptyError());\n  // const url = `${ENV.url}/nfts/${type}`;\n  // fetch(url, {\n  // method,\n  // headers: {\n  // 'Authorization': ENV.Authorization,\n  // 'x-auth-token': ENV.x_auth_token,\n  // 'Access-Control-Allow-Origin': '*',\n  // 'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  // },\n  // body\n  // }).then(res => res.json()).then(data => {\n  // if (data.success) {\n  // toast.success(data.message)\n  // dispatch({\n  // type: UPSERT_NFT,\n  // payload: data\n  // })\n  // } else {\n  // toast.error(data.message)\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: data\n  // })\n  // }\n  // }).catch(error => {\n  // if (error.response && error.response.data) {\n  // const { data } = error.response\n  // if (data.message)\n  // toast.error(data.message)\n  // }\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: error\n  // })\n  // })\n};\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/utils/functions.js",["1350","1351","1352","1353","1354","1355","1356","1357","1358"],"import axios from \"axios\";\nimport { ENV } from '../config/config';\nimport { Redirect } from 'react-router-dom';\nimport { toast } from 'react-toastify'\nimport { useDispatch } from \"react-redux\";\nimport { emptyError } from '../redux/shared/error/error.action';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID } from '../redux/types';\nlet baseUrl = process.env.REACT_APP_BASE_URL;\n\nexport const axiosSyncPost = (url, data, isMultipart = false) => {\n  return new Promise((resolve, reject) => {\n    const params = new URLSearchParams();\n    let keys = Object.keys(data);\n    for (let x = 0; x < keys.length; x++) {\n      params.append(keys[x], data[keys[x]]);\n    }\n\n    const config = {\n      headers: {\n        'Content-Type': isMultipart ? 'multipart/form-data' : 'application/x-www-form-urlencoded',\n        \"Authorization\": ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n    };\n\n    url = baseUrl + url;\n\n    axios.post(url, params, config).then(\n      (res) => {\n        resolve(res.data);\n      },\n      (error) => {\n        resolve(error)\n      },\n    );\n  });\n};\n\nexport const axiosPostFormData = (url, body, isMultipart = false) => {\n\n  return new Promise((resolve, reject) => {\n    const config = {\n      headers: {\n        // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n        \"Authorization\": ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n    };\n    \n\n    // url = testingURl + url;\n\n\n    axios.post(ENV.url + url, body, config).then(\n      (res) => {\n        // console.log(res,\"res success\");\n        resolve(res.data)\n      },\n      (error) => {\n        console.log(error,\"res error\");\n        resolve(error)\n      },\n    );\n  });\n};\n\nexport const decimalNumberValidator = (evt) => {\n  let e = evt || window.event;\n\n  // Allow: backspace, delete, tab, escape, enter and .\n  const specialKeys = [46, 8, 9, 27, 13, 110]\n\n  // Allow: Ctrl+A,Ctrl+C,Ctrl+V, Command+A\n  if (specialKeys.includes(e.keyCode) ||\n    // Allow: Ctrl+A,Ctrl+C,Ctrl+Z,Ctrl+X Command+A\n    ((e.keyCode === 65 || e.keyCode === 67 || e.keyCode === 90 || e.keyCode === 88) && (e.ctrlKey === true || e.metaKey === true)) ||\n    // Allow: home, end, left, right, down, up\n    (e.keyCode >= 35 && e.keyCode <= 40)) {\n    // let it happen, don't do anything\n    return;\n  }\n\n  let key = e.keyCode || e.which;\n  if ((!e.shiftKey && !e.altKey && !e.ctrlKey) &&\n    (((key === 190 || key === 110) ||\n      (key >= 48 && key <= 57)) ||\n      (key >= 96 && key <= 105) ||\n      key === 8 || key === 9 || key === 13 ||\n      key === 35 || key === 36 ||\n      key === 37 || key === 39 ||\n      key === 46 || key === 45)) {\n  }\n  else {\n    e.returnValue = false;\n    if (e.preventDefault) e.preventDefault();\n  }\n}\nexport const setFixedPriceNftTOken=(body)=>{\n  let url = `${ENV.url}nftFixedTokens/getFixedtokens`;\n  // let url = `http://3.142.91.8/v1/front/auctions/live`;\n \n  // console.log(url,\"url==>123\")\n    \n\n  fetch(url, {\n      method: 'POST',\n      headers: {\n          'content-type': 'application/json',\n          'Authorization': ENV.Authorization,\n          'x-auth-token': ENV.x_auth_token,\n          'Access-Control-Allow-Origin': '*',\n          'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n      body:body\n  }).then(res => res.json()).then(data => {\n      // console.log(data,\"created nft token\")\n      if (data.success) {\n        \n      } else {\n         \n      }\n  }).catch(errors => {\n      console.log(errors,\"error\")\n  })\n}\n\nexport const changeOwnerShip=(nftOwnerId,currentUserId)=>{\n  // alert(\"changing ownership\")\n  let url = `${ENV.url}nfts/editNft`;\n  // console.log('fetch url', url)\nlet body={\n  nftOwnerId,\n  currentUserId\n}\n  fetch(url, {\n    method: 'PATCH',\n    headers: {\n      'content-type': 'application/json',\n      'Authorization': ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  },\n    body:JSON.stringify(body)\n     }).then(res => res.json()).then(data => {\n       if(data.status === 'success'){\n        toast.success(\"Successfully bought nft\")\n        window.location.href= '/explore-all'\n       }\n      // console.log(data,\"response from the change ownershiop\")\n     }).catch(errors => {\n       console.log('error',errors)\n    })\n}\nexport const acceptBit = (tokenId,body)  => {\n \n   \n    const url = `${ENV.url}bid/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n            window.location.href= '/explore-all'\n            // dispatch({\n            //     type: ACCEPT_BID,\n            //     payload: data\n            // })\n        } else {\n            toast.error(data.message)\n          \n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n      \n    })\n\n}\n\nexport const placeBidApi = (body) =>  {\n\n  console.log('im here')\n\n\n  const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n    //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n           \n            toast.success(data.message)\n            window.location.href= '/explore-all'\n            // dispatch({\n            //     type: CREATE_BID,\n            //     payload: data\n            // })\n        } else {\n            toast.error(data.message)\n            // dispatch({\n            //     type: GET_ERRORS,\n            //     payload: data\n            // })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        // dispatch({\n        //     type: GET_ERRORS,\n        //     payload: error\n        // })\n    })\n \n \n}","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/utils/abiSetup.js",["1359"],"import Web3 from 'web3';\nimport liveAuctionsAbi from './abis/ARISwapToken.json'\nimport {ENV} from '../config/config';\n// const web3 = new Web3(\n//   new Web3.providers.HttpProvider('https://data-seed-prebsc-1-s1.binance.org:8545')\n// );\n\nlet web3Provider = window.ethereum;\nvar web3 = new Web3(web3Provider);\n web3 = new Web3(Web3.givenProvider);\n//it's the abi\n\nlet liveAuction=null;\ntry{\n\n     liveAuction = new web3.eth.Contract(liveAuctionsAbi,'0xE400E3fb41B83a2f8161A8d6F34b7B3023441AF5');\n}\ncatch(err){\n// console.log(err,\"error in abiSetup\")\n}\n\nexport { liveAuction };\n",["1360","1361"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/footer/footer.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/collections.actions.js",["1362","1363"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_COLLECTION, SET_AUTH_STATE, GET_COLLECTION, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS,BEFORE_CATEGORY, GET_CATEGORIES,COLLECTION_CATEGORES ,MY_COLLECTIONS} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\n\nexport const beforeCollection = () => {\n    return {\n        type: BEFORE_COLLECTION\n    }\n}\n\nexport const getCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}collection/get/${collectionId}`;\n \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getCollections = (qs = null) => dispatch => {\n\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs)\n    url += `?${qs}`\n   console.log(url,\"url sending\")\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n   console.log(data,\"collections api response\")\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n       \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const myCollections = (userId) => dispatch => {\n\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/myCollectionList`;\n\n    if (userId)\n    url += `?userId=${userId}`\n    \n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            \n            dispatch({\n                type: MY_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data.message\n            })\n        }\n    }).catch(error => {\n      \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\nexport const upsertCollection = (apiURL, body, method = 'POST') => dispatch => {\n\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n\n    fetch(url, {\n        method,\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: UPSERT_COLLECTION,\n                payload: data\n            })\n            \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}collection/delete/${collectionId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const setAuthState = () => (dispatch) => {\n    dispatch({\n        type: SET_AUTH_STATE,\n    })\n}\nexport const beforeCategory = () => {\n    return {\n        type: BEFORE_CATEGORY\n    }\n}\nexport const getCategories = () => dispatch => {\n  \n    dispatch(emptyError());\n    const url = `${ENV.url}category/list`;\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n \n        if (data.status) {\n         \n            dispatch({\n                type: COLLECTION_CATEGORES,\n                payload: data.categories\n            })\n\n         \n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"error==>\")\n     \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const toggleLikeDislike = (body) => dispatch => {\n let data=JSON.stringify(body)\n    const url = `${ENV.url}collectionLikes/likeDislike`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        data\n    }).then(res => res.json()).then(data => {\n  \n       \n    }).catch(error => {\n     console.log(error,\"error likes\")\n    })\n};","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/bids/bids.action.js",["1364","1365"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body,tokenId,price,toAddress,fromAddress) => dispatch => {\n    alert(\"in herer\")\n    // dispatch(emptyError());\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n    //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n           \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    // if (qs)\n    //     url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/card-slider/CardSlider.js",["1366","1367","1368","1369","1370","1371"],"import React, { Component } from \"react\";\nimport Slider from \"react-slick\";\n// import CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport SliderNextIcon from \"../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport \"./CardSlider.css\";\nimport TwitchPlayer from \"react-player/twitch\";\nimport { data } from \"jquery\";\n\nexport default class CardSlider extends Component {\n  // const CardSlider = () => {\n  constructor(props) {\n    super(props);\n    this.next = this.next.bind(this);\n    this.previous = this.previous.bind(this);\n  }\n  next() {\n    this.slider.slickNext();\n  }\n  previous() {\n    this.slider.slickPrev();\n  }\n\n  handleArrows = () => {\n    const { data, homeAuctions } = this.props;\n    if (data && data.length > 0) {\n      if (homeAuctions && data.length > 4) {\n        return true;\n      } else if (!homeAuctions && data.length > 3) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n  render() {\n    const { settings, data, homeAuction } = this.props;\n    console.log(homeAuction, \"homeAuction\");\n\n    return (\n      <div className=\"container\">\n        {this.handleArrows() && (\n          <div className=\"text-end\">\n            <button\n              className=\"card-slider-btn mb-4 me-3\"\n              onClick={this.previous}\n            >\n              {/* <img src={SliderPrevIcon} alt=\"SliderPrevButton\" /> */}\n              <i class=\"fas fa-arrow-left\"></i>\n            </button>\n            <button className=\"card-slider-btn mb-4\" onClick={this.next}>\n              {/* <img src={SliderNextIcon} alt=\"SliderNextButton\" /> */}\n              <i class=\"fas fa-arrow-right\"></i>\n            </button>\n          </div>\n        )}\n        <Slider ref={(c) => (this.slider = c)} {...settings}>\n          {this.props.children}\n        </Slider>\n      </div>\n    );\n  }\n}\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/hero/component/slider.js",["1372","1373","1374","1375","1376"],"import \"./slider.css\";\nimport { useState } from \"react\";\nimport HeroCards from \"../../hero-cards/HeroCards\";\nimport SliderNextIcon from \"../../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../../auctions-cards/AuctionsCards\";\nimport { map } from \"jquery\";\n\nconst Slider = ({\n  setHandler,\n  sliderRadioButtons,\n  handleRadioInputs,\n  sliderChecked,\n}) => {\n  return (\n    <section id=\"slider\">\n      {sliderRadioButtons.map((item) => {\n        return (\n          <input\n            type=\"radio\"\n            name=\"slider\"\n            value={item.value}\n            checked={sliderChecked === item.value}\n            onChange={(e) => handleRadioInputs(e)}\n            id={item.id}\n          />\n        );\n      })}\n      <label for=\"s1\" id=\"slide1\" onClick={() => setHandler(1)}>\n        <HeroCards className=\"slide\" />\n        {/* <img\n          src=\"https://i.pinimg.com/originals/2b/de/de/2bdede0647e3cdf75b44ea33723201d9.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s2\" id=\"slide2\" onClick={() => setHandler(2)}>\n        <HeroCards className=\"slide\" />\n        {/* <AuctionsCards className=\"slide\" /> */}\n        {/* <img\n          src=\"https://images6.alphacoders.com/462/thumb-1920-462371.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s3\" id=\"slide3\" onClick={() => setHandler(3)}>\n        <HeroCards className=\"slide\" />\n        {/* <img src=\"https://wallpaperaccess.com/full/1154341.jpg\" alt=\"\" /> */}\n      </label>\n      <label for=\"s4\" id=\"slide4\" onClick={() => setHandler(4)}>\n        {/* <AuctionsCards className=\"slide\" /> */}\n        {/* <img src=\"https://wallpapercave.com/wp/wp2634222.jpg\" alt=\"\" /> */}\n        <HeroCards className=\"slide\" />\n      </label>\n      <label for=\"s5\" id=\"slide5\" onClick={() => setHandler(5)}>\n        <HeroCards className=\"slide\" />\n        {/* <img\n          src=\"https://images5.alphacoders.com/343/thumb-1920-343645.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s6\" id=\"slide6\" onClick={() => setHandler(6)}>\n        <HeroCards className=\"slide\" />\n      </label>\n      <label for=\"s7\" id=\"slide7\" onClick={() => setHandler(7)}>\n        {/* <AuctionsCards className=\"slide\" /> */}\n        <HeroCards className=\"slide\" />\n      </label>\n    </section>\n  );\n};\n\nexport default Slider;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/videoComponent/videoComponent.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["1377","1378","1379"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(props.levelsInputs);\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage, setErrorMessage] = React.useState(\"\");\n  const [validate, setValidate] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues.splice(i, 1);\n    setlevelsInputs(newFormValues);\n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total === \"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\");\n        return \"\";\n      }\n      if (+item.value > +item.total) {\n        alert(\"inside\");\n        setError(true);\n        setValidate(true);\n        setErrorMessage(\"Value should be less then total!\");\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n  //  const handleValue=(item)=>{\n  //    if(item.value > item.total){\n\n  //      setError(true)\n  //      return true\n  //    }\n  //    return false\n  //  }\n  //  const handleTotal=(item)=>{\n\n  //  }\n  // console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"550px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 mx-auto justify-content-center\">\n              <div className=\"d-flex\">\n                <img\n                  src={LevelsImage}\n                  alt={\"levels\"}\n                  style={{ height: \"2rem\" }}\n                />\n                <p\n                  className=\"text-white\"\n                  style={{\n                    fontSize: \"1.3rem\",\n                    fontWeight: \"bold\",\n                    marginLeft: \"1rem\",\n                  }}\n                >\n                  Add Levels\n                </p>\n              </div>\n            </div>\n            {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Levels show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n            <form onSubmit={handleSubmit}>\n              <div\n                className=\"row levels-scroll p-3 \"\n                style={{\n                  height: `${\n                    levelsInputs && levelsInputs.length > 0\n                      ? \"8.3rem\"\n                      : \"7.3rem\"\n                  }`,\n                }}\n              >\n                {levelsInputs &&\n                  levelsInputs.length > 0 &&\n                  levelsInputs.map((item, i) => {\n                    return (\n                      <div\n                        className=\"row\"\n                        key={i}\n                        style={{\n                          marginBottom: `${\n                            levelsInputs && levelsInputs.length > 1\n                              ? \"12px\"\n                              : \"0\"\n                          }`,\n                        }}\n                      >\n                        <div className=\"col-10 col-sm-6 mt-2 \" key={i}>\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            <input\n                              className=\"step3-input mt-3 name-inp\"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              value={item.name || \"\"}\n                              placeholder=\"Name\"\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 mt-2\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                            <div className=\"values-total-inp w-100\">\n                              <input\n                                className={`step3-input first-value mt-3 values-inp ${\n                                  validate && item.value > item.total\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min=\"1\"\n                                max={\n                                  item.total == \"0\"\n                                    ? \"1\"\n                                    : item.total\n                                    ? item.total\n                                    : \"1\"\n                                }\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.value || \"\"}\n                                placeholder=\"Value\"\n                                autoComplete=\"off\"\n                                name=\"value\"\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n\n                              <p className=\"text-white mb-0 value-label mt-3\">\n                                Of\n                              </p>\n                              <input\n                                className={`step3-input first-value values-inp mt-3 ${\n                                  validate && item.total < item.value\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min={item.value ? item.value : \"1\"}\n                                max=\"9999\"\n                                name=\"total\"\n                                placeholder=\"Total\"\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.total || \"\"}\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                            </div>\n                            <BsFillXCircleFill\n                              className=\"position-absolute levels-cross-icon\"\n                              style={{\n                                color: \"#00d3f3\",\n                                top: \"3rem\",\n                                right: \"-1rem\",\n                                cursor: \"pointer\",\n                              }}\n                              onClick={() => removeFormFields(i)}\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                <div className=\"W-100 text-center\"></div>\n              </div>\n              <p\n                className=\" col-8 mt-4\"\n                style={{\n                  color: \"#00d3f3\",\n                  cursor: \"pointer\",\n                  marginLeft: \"0.8rem\",\n                }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n\n              <div className=\"w-100 text-center\">\n                <button\n                  type=\"submit\"\n                  className=\"btn btn-secondary start-btn mt-5 text-center\"\n                  style={{ width: \"9rem\" }}\n                  // disabled={\n                  //   levelsInputs && levelsInputs?.length > 0\n                  //     ? false\n                  //     : true\n                  // }\n                  // onClick={() => {\n                  //   handleSubmit()\n                  // }}\n                >\n                  Save\n                </button>\n              </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["1380","1381"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.properties\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"500px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white mt-0\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 7.95rem\"\n                    : \"7.95rem\"\n                }`,\n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" style={{ width: \"558px\" }} key={i}>\n                      <div className=\"row\">\n                        <div\n                          className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1\"\n                          key={i}\n                        >\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <input\n                              className=\"step3-input mt-2 \"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              placeholder=\"Name\"\n                              value={item.name || \"\"}\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29 !important\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n\n                        <div className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1 ml-0 ml-md-4\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{\n                                fontSize: \"1.2rem\",\n                                fontWeight: \"bold\",\n                              }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <div className=\"d-flex align-items-center w-100\">\n                              <input\n                                className=\"step3-input  mt-2\"\n                                type=\"text\"\n                                name=\"value\"\n                                onChange={(e) => handleChange(i, e)}\n                                placeholder=\"Value\"\n                                value={item.value || \"\"}\n                                maxLength=\"30\"\n                                autoComplete=\"off\"\n                                style={{\n                                  backgroundColor: \"#000e29 \",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                              <BsFillXCircleFill\n                                className=\"ml-1 ml-sm-2\"\n                                style={{\n                                  color: \"#00d3f3\",\n                                  top: \"3rem\",\n                                  left: \"13.8rem\",\n                                  cursor: \"pointer\",\n                                }}\n                                onClick={() => removeFormFields(i)}\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <p\n              className=\" mt-4 ml-4\"\n              style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n              onClick={() => addMoreValues()}\n            >\n              {\" \"}\n              Add Property\n            </p>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-2 mt-md-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   propertiesValues && propertiesValues?.length > 0\n                //     ? false\n                //     : true\n                // }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["1382","1383"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\nimport Modal from \"@mui/material/Modal\";\nimport { AiOutlineClose } from \"react-icons/ai\";\nimport { BiArrowBack } from \"react-icons/bi\";\n\nimport \"./PreviewModal.css\";\nimport { maxWidth } from \"@mui/system\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 830,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n};\n\nconst genStyle = {\n  row: {\n    display: \"grid\",\n  },\n};\n// let array = [1];\n\nconst PreviewModal = (props) => {\n  // console.log(props,\"props\")\n  const {\n    previewModal,\n    handlePreviewModal,\n    previewModalStep,\n    handlePreviewModalSteps,\n    onDeploy,\n    info,\n  } = props;\n  const handleNextStep = () => {\n    if (previewModalStep === 1) {\n      handlePreviewModalSteps(\"next\");\n    } else {\n      onDeploy();\n    }\n  };\n  // console.log(props,\"props\")\n  return (\n    <div>\n      <Modal\n        open={previewModal}\n        onClose={handlePreviewModal}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"preview-modal-container pt-4 px-1 px-md-5\">\n            <div className=\"w-100 d-flex justify-content-between \">\n              {previewModalStep > 1 ? (\n                <BiArrowBack\n                  className=\"text-white \"\n                  style={{\n                    fontSize: \"1.8rem\",\n                    cursor: \"pointer\",\n                  }}\n                  onClick={() => handlePreviewModalSteps(\"back\")}\n                />\n              ) : (\n                <span></span>\n              )}\n              <AiOutlineClose\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.8rem\",\n                  cursor: \"pointer\",\n                }}\n                onClick={() => handlePreviewModal()}\n              />\n            </div>\n\n            {previewModalStep === 1 ? (\n              <div className=\"row  preview-modal-info\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text \">Preview</p>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div className=\"previewModal-img\">\n                    {info.img && (\n                      <img\n                        src={info.img ? info.img : \"\"}\n                        className=\"mt-3\"\n                        style={{\n                          width: \"100%\",\n                          height: \"100%\",\n                          borderRadius: \"10px\",\n                          objectFit: \"contain\",\n                        }}\n                        alt=\"preview\"\n                      />\n                    )}\n                    {info.videoUrl && (\n                      <video className=\"preview-video-view mt-3\" controls>\n                        <source src={info.videoUrl} />\n                      </video>\n                    )}\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white external-label ml-0 my-2 ml-0\">\n                      External Link\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"url\"\n                      value={\n                        (info.externalLink && info.externalLink.trim()) ||\n                        \"- externalLink -\"\n                      }\n                      placeholder=\"- externalLink -\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label mb-2 ml-0\">\n                      Name\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={info.name || \"\"}\n                      placeholder=\"name\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Email\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"email\"\n                      value={info.email || \"\"}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Symbol\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={\n                        (info.symbol && info.symbol.trim()) || \"- symbol -\"\n                      }\n                      placeholder=\"- symbol -\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Description\n                    </label>\n                    <textarea\n                      className=\"p-3 mt-1 w-100 externalLink-input\"\n                      placeholder=\"- Description -\"\n                      value={\n                        (info.description && info.description.trim()) ||\n                        \"- Description -\"\n                      }\n                      style={{\n                        color: \"#aaabab\",\n                        marginLeft: \"2rem\",\n                        margin: \"0\",\n                        width: \"100%\",\n                      }}\n                      maxLength=\"600\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Supply\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"number\"\n                      value={info.supply || \"- supply -\"}\n                      disabled={true}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      placeholder=\"- supply -\"\n                      maxLength=\"50\"\n                    />\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\" preview-modal-info rowCust\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text mb-3\">Preview</p>\n                </div>\n\n                <p className=\"text-white font-weight-bold preview-properties-title \">\n                  Properties{\" \"}\n                </p>\n\n                <div\n                  className=\"rowCust px-3 mb-3\"\n                  style={{\n                    overflowY: \"auto\",\n                    height: \"5.1rem\",\n                    overflowX: \"hidden\",\n                  }}\n                >\n                  {props.properties && props.properties.length > 0 ? (\n                    props.properties.map((item, index) => {\n                      return (\n                        <div\n                          className=\"row justify-content-between\"\n                          key={index}\n                        >\n                          <div className=\"col-12  col-md-6\" key={index}>\n                            <label\n                              className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                              for=\"preview-name\"\n                            >\n                              Name\n                            </label>\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.name || \"\"}\n                              maxLength=\"50\"\n                              placeholder=\"item name\"\n                              disabled={true}\n                              id=\"preview-name\"\n                            />\n                          </div>\n\n                          <div className=\"col-12 col-md-6 pr-lg-0\">\n                            <label\n                              className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                              for=\"preview-value\"\n                            >\n                              Value\n                            </label>\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.value || \"\"}\n                              placeholder=\"Value\"\n                              maxLength=\"50\"\n                              disabled={true}\n                              id=\"preview-value\"\n                            />\n                          </div>\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center\" style={{ color: \"#A9A9A9\" }}>\n                      {\"No Properties Found\"}\n                    </p>\n                  )}\n                </div>\n                <div className=\"previewdivider ml-3\"></div>\n                {/* ////////////////////////////////////////////// */}\n                <div className=\"mt-3\">\n                  <p className=\"text-white font-weight-bold preview-levels-title\">\n                    Levels{\" \"}\n                  </p>\n                  <div\n                    className=\"rowCust px-3\"\n                    style={{\n                      overflowY: \"auto\",\n                      overflowX: \"hidden\",\n                      height: \"5.1rem\",\n                    }}\n                  >\n                    {props.levels && props.levels.length > 0 ? (\n                      props.levels.map((item, index) => {\n                        return (\n                          <div className=\"row\" key={index}>\n                            <div className=\"col-12 col-md-6 \" key={index}>\n                              <label\n                                className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                                for=\"preview-name\"\n                              >\n                                Name\n                              </label>\n                              <input\n                                className=\"preview-input-step-2 value-input-preview w-100\"\n                                type=\"url\"\n                                value={item.name || \"\"}\n                                placeholder=\"Levels\"\n                                style={{\n                                  marginTop: `${\n                                    index === 0 ? \"0rem\" : \"1.2rem\"\n                                  }`,\n                                  maxWidth: \"90%\",\n                                }}\n                                // maxLength=\"50\"\n                                disabled={true}\n                              />\n                            </div>\n\n                            <div className=\"col-12 col-md-6 \">\n                              <label\n                                className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                                for=\"preview-name\"\n                              >\n                                Value\n                              </label>\n                              <div\n                                className=\"d-flex align-items-center justify-content-between ml-3 preview-modal-value-2\"\n                                style={{\n                                  marginTop: `${\n                                    index === 0 ? \"0rem\" : \"1.2rem\"\n                                  }`,\n                                  width: \"93%\",\n                                }}\n                              >\n                                <input\n                                  className=\"preview-modal-step\"\n                                  type=\"number\"\n                                  pattern=\"[0-9]+\"\n                                  // maxlength=\"4\"\n                                  value={item.value || \"\"}\n                                  placeholder=\"Value\"\n                                  name=\"value\"\n                                  disabled={true}\n                                  style={{\n                                    padding: \"0.6rem 1rem\",\n                                    width: \"45%\",\n                                  }}\n                                />\n\n                                <p className=\"text-white mb-0 mx-2\">Of</p>\n                                <input\n                                  className=\"preview-modal-step\"\n                                  type=\"number\"\n                                  min=\"1\"\n                                  max=\"5\"\n                                  name=\"total\"\n                                  placeholder=\"total\"\n                                  disabled={true}\n                                  // onInput=\"javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);\"\n                                  value={item.total || \"\"}\n                                  style={{\n                                    padding: \"0.6rem 1rem\",\n                                    width: \"45%\",\n                                  }}\n                                />\n                              </div>\n                            </div>\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\" text-center\" style={{ color: \"#A9A9A9\" }}>\n                        {\"No levels Found\"}\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            )}\n            <div className=\"w-100 text-center\">\n              <p className=\"text-white my-3\">{previewModalStep}/2</p>\n              {previewModalStep > 1 && props.maxLimit && (\n                <p className=\"text-danger\">\n                  {\"Maximum deployment limit reached,Please contact support\"}\n                </p>\n              )}\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary preview-btn mb-3\"\n                disabled={props.maxLimit && previewModalStep > 1 ? true : false}\n                onClick={() => handleNextStep()}\n              >\n                {previewModalStep === 1 ? \"Next\" : \"Deploy\"}\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nexport default PreviewModal;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/auctions/auctions.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/header/header.js",["1384","1385","1386","1387","1388","1389","1390"],"import React, { useState, useEffect } from \"react\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { setWalletAddress, getWalletAddress } from \"../wallet/wallet.action\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport { logoutUser } from \"../user/user.action\";\nimport { ENV } from \"./../../config/config\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport MintsClubLogo from \"../../assets/images/main-logo.svg\";\n\nconst Header = (props) => {\n  const history = useHistory();\n  // console.log(\"history\", history);\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [loader, setLoader] = useState(true);\n  const { _id } = ENV.getUserKeys(\"_id\");\n\n  useEffect(async () => {\n    // COMMENTED TEMPORARILY\n    // METHOD 1\n    // props.getWalletAddress()\n\n    // METHOD 2 - a\n    // let connectedAddress = await connectMetamask();\n    // setConnectedAddress(connectedAddress)\n\n    // METHOD 3\n    // if (localStorage.getItem('wa')) {\n    //     let connectedAddress = window.atob(localStorage.getItem('wa'))\n    //     setConnectedAddress(connectedAddress)\n    // }\n\n    // METHOD 4\n    let connectedAddress = await connectMetamaskCopy();\n    setConnectedAddress(connectedAddress);\n    props.setWalletAddress(connectedAddress);\n  }, []);\n\n  // set loader to false when address is received\n  useEffect(() => {\n    if (connectedAddress) setLoader(false);\n  }, [connectedAddress]);\n\n  // COMMENTED TEMPORARILY\n  // METHOD 2 - b\n  // useEffect(() => {\n  //     if (props.wallet.walletAuth) {\n  //         const { connectedAddress } = props.wallet\n  //         setConnectedAddress(connectedAddress)\n  //     }\n  // }, [props.wallet.walletAuth])\n  const formatAddress = (address) => {\n    return address ? address.substr(0, 6) + \"...\" + address.substr(-4) : null;\n  };\n  const logoutUser = () => {\n    props.logoutUser();\n    history.push(\"/login\");\n  };\n\n  return (\n    <header id=\"header\">\n      <div className=\"container header\">\n        {/* Navbar */}\n        <nav\n          data-aos=\"zoom-out\"\n          data-aos-delay={800}\n          className=\"navbar navbar-expand\"\n        >\n          {/* Navbar Brand*/}\n          <Link className=\"navbar-brand\" to=\"/\">\n            <img\n              className=\"navbar-brand-sticky\"\n              src={MintsClubLogo}\n              alt=\"sticky brand-logo\"\n            />\n          </Link>\n          <div className=\"ml-auto\" />\n          {/* Navbar */}\n          <ul className=\"navbar-nav items mx-auto\">\n            <li className=\"nav-item dropdown\">\n              <Link className=\"nav-link\" to=\"/\">\n                Home\n              </Link>\n            </li>\n            <li className=\"nav-item dropdown\">\n              <a className=\"nav-link\">\n                Explore <i className=\"fas fa-angle-down ml-1\" />\n              </a>\n              <ul className=\"dropdown-menu\">\n                <li className=\"nav-item\">\n                  <Link to=\"/explore-all\" className=\"nav-link\">\n                    Explore\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/auctions\" className=\"nav-link\">\n                    Live Auctions\n                  </Link>\n                </li>\n                {/* <li className=\"nav-item\"><Link to=\"/item-details\" className=\"nav-link\">Item Details</Link></li> */}\n              </ul>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/activity\" className=\"nav-link\">\n                Activity\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/collections\" className=\"nav-link\">\n                Collections\n              </Link>\n            </li>\n            {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Community <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/blog\" className=\"nav-link\">Blog</a></li>\n                                <li className=\"nav-item\"><a href=\"/blog-single\" className=\"nav-link\">Blog Single</a></li>\n                                <li className=\"nav-item\"><a href=\"/help-center\" className=\"nav-link\">Help Center</a></li>\n                            </ul>\n                        </li> */}\n            {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Pages <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/authors\" className=\"nav-link\">Authors</a></li>\n                                <li className=\"nav-item\"><a href=\"/author\" className=\"nav-link\">Author</a></li>\n                                <li className=\"nav-item\"><a href=\"/wallet-connect\" className=\"nav-link\">Wallet Connect</a></li>\n                                <li className=\"nav-item\"><a href=\"/create\" className=\"nav-link\">Create</a></li>\n                                <li className=\"nav-item\"><a href=\"/login\" className=\"nav-link\">Login</a></li>\n                                <li className=\"nav-item\"><a href=\"/signup\" className=\"nav-link\">Signup</a></li>\n                            </ul>\n                        </li> */}\n            <li className=\"nav-item\">\n              <Link to=\"/contact\" className=\"nav-link\">\n                Contact\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/history\" className=\"nav-link\">\n                History\n              </Link>\n            </li>\n          </ul>\n          {/* Navbar Icons */}\n          <ul className=\"navbar-nav icons\">\n            <li className=\"nav-item\">\n              <a\n                href=\"#\"\n                className=\"nav-link \"\n                data-toggle=\"modal\"\n                data-target=\"#search\"\n              >\n                <i className=\"fas fa-search\" />\n              </a>\n            </li>\n          </ul>\n          {/* Navbar Toggler */}\n          <ul className=\"navbar-nav toggle\">\n            <li className=\"nav-item\">\n              <a\n                href=\"#\"\n                className=\"nav-link\"\n                data-toggle=\"modal\"\n                data-target=\"#menu\"\n              >\n                <i className=\"fas fa-bars toggle-icon m-0\" />\n              </a>\n            </li>\n          </ul>\n          {/* Navbar Action Button */}\n          <ul className=\"navbar-nav action\">\n            <li className=\"nav-item ml-3\">\n              {connectedAddress && _id ? (\n                <button\n                  className=\"btn ml-lg-auto btn-linear-gradient\"\n                  onClick={logoutUser}\n                >\n                  <i className=\"icon-logout mr-md-2\" /> Logout\n                </button>\n              ) : (\n                // <span id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />{formatAddress(connectedAddress)}</span>\n                <Link\n                  to=\"/login\"\n                  id=\"wallet-address\"\n                  className=\"btn ml-lg-auto btn-linear-gradient\"\n                >\n                  {/* <i className=\"icon-wallet mr-md-2\" /> */}\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  Login\n                </Link>\n              )}\n            </li>\n          </ul>\n        </nav>\n      </div>\n    </header>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n});\nexport default connect(mapStateToProps, {\n  setWalletAddress,\n  getWalletAddress,\n  logoutUser,\n})(Header);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/explore/explore.action.js",["1391"],"\nimport { ENV } from './../../config/config';\nimport axios from 'axios'\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n        console.log(response);\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/categories/categories.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/author-profile/author-profile.js",["1392","1393","1394","1395","1396"],"import React, { useEffect } from 'react';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst AuthorProfile = (props) => {    \r\n    useEffect(()=> {\r\n\r\n    },[])\r\n    return (\r\n        <div className=\"card-wrapper\">\r\n       <div className=\"card no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.profileImage ? props.profileImage: ENV.globalPlaceholderImage} alt=\"User Profile\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body mt-4\">\r\n                    <h5 className=\"mb-3\">{props.username}</h5>\r\n                    <p className=\"my-3\">{props.description}</p>\r\n                    <div className=\"input-group\">\r\n                        <input type=\"text\" className=\"form-control\" placeholder=\"0x000000000000000000\" readOnly value={props.address}/>\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"social-icons d-flex justify-content-center my-3\">\r\n                        {\r\n                            props.facebookLink && <a className=\"facebook\" href={props.facebookLink} target=\"_blank\">\r\n                                <i className=\"fab fa-facebook-f\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.twitterLink && <a className=\"twitter\" href={props.twitterLink} target=\"_blank\">\r\n                                <i className=\"fab fa-twitter\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.gPlusLink && <a className=\"google-plus\" href={props.gPlusLink} target=\"_blank\">\r\n                                <i className=\"fab fa-google-plus-g\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.vineLink && <a className=\"vine\" href={props.vineLink} target=\"_blank\">\r\n                                <i className=\"fab fa-vine\" />\r\n                            </a>\r\n                        }\r\n                    </div>\r\n                    {\r\n                        props.followText &&\r\n                        <a className=\"btn btn-bordered-white btn-smaller\" href=\"#\">{props.followText}</a>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </div>\r\n        </div>\r\n \r\n    );\r\n}\r\nexport default AuthorProfile;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/faq/faq.js",["1397","1398"],"import { useState, useEffect } from 'react';\r\nimport { connect } from \"react-redux\";\r\nimport { beforeFaq, getFaqs } from \"./faq.action\"\r\n\r\nconst Faq = (props) => {\r\n\r\n    const [data, setData] = useState(null)\r\n\r\n    useEffect(() => {\r\n        props.getFaqs()\r\n     \r\n    }, [])\r\n\r\n    useEffect(() =>{\r\n        if(props.faqs.faqsAuth){\r\n            const {faqs} = props.faqs.faqs\r\n            setData(faqs)\r\n        }\r\n    }, [props.faqs.faqsAuth])\r\n\r\n    return (\r\n        <section className=\"faq-area\">\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>{\"FAQ\"}</span>\r\n                            <h3 className=\"mt-3 mb-0\">{\"Frequently Asked Questions\"}</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12\">\r\n                        {/* FAQ Content */}\r\n                        <div className=\"faq-content\">\r\n                            {/* Netstorm Accordion */}\r\n                            <div className=\"accordion\" id=\"netstorm-accordion\">\r\n                                <div className=\"row justify-content-center\">\r\n                                    <div className=\"col-12 col-md-10\">\r\n                                        {/* Single Accordion Item */}\r\n                                        {data ? data.map((item, idx) => {\r\n                                            return (\r\n                                                <div key={`fd_${idx}`} className=\"single-accordion-item p-3\">\r\n                                                    {/* Card Header */}\r\n                                                    <div className=\"card-header bg-inherit border-0 p-0\">\r\n                                                        <h2 className=\"m-0\">\r\n                                                            <button className={\"btn d-block text-left w-100 collapsed py-4\"} type=\"button\" data-toggle=\"collapse\" data-target={`#helpOption-${idx}`}>\r\n                                                                {item.title}\r\n                                                            </button>\r\n                                                        </h2>\r\n                                                    </div>\r\n                                                    <div id={`helpOption-${idx}`} className={\"collapse\"} data-parent=\"#netstorm-accordion\">\r\n                                                        {/* Card Body */}\r\n                                                        <div className=\"card-body py-3\" dangerouslySetInnerHTML={{__html: item.desc}}>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            );\r\n                                        }) : ''}\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = (state) => ({\r\n    faqs: state.faqs,\r\n    error: state.error,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeFaq, \r\n    getFaqs\r\n})(Faq);","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/contact/contact.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/authors/authors.js",["1399","1400"],"import React, { useEffect, useState } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport {Link} from 'react-router-dom';\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst Authors = (props) => {\r\n    const [creators, setCreators] = useState([]);\r\n    useEffect(()=> {\r\n        props.getCreators();\r\n        window.scrollTo(0, 0)\r\n    }, []);\r\n    useEffect(()=> {\r\n        setCreators(props.user.sellers)\r\n      \r\n    }, [props.user.topSellersAuth]);\r\n\r\n    return (\r\n        <section className=\"popular-collections-area mt-5\">\r\n            <br />\r\n            <br />\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>Creators</span>\r\n                            <h3 className=\"mt-3 mb-0\">Our Creators</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    {\r\n                        creators && creators.length ? \r\n                        creators.map((author, key)=> {\r\n                            return (\r\n                                <div key={`author_${key}`} className=\"col-12 col-sm-6 col-lg-3 item\">\r\n                                    <div className=\"card no-hover text-center\">\r\n                                        <div className=\"image-over\">\r\n                                            <Link to={`/author/${author._id}`}>\r\n                                                <img className=\"card-img-top\" src={author.profileImage ? author.profileImage: ENV.globalPlaceholderImage} alt=\"Author profile\" />\r\n                                            </Link>\r\n                                        </div>\r\n                                        <div className=\"card-caption col-12 p-0\">\r\n                                            <div className=\"card-body mt-1\">\r\n                                                <Link to={`/author/${author._id}`}>\r\n                                                    <h5>{author.username ? author.username : author.address} </h5>\r\n                                                </Link>\r\n                                                <button type=\"button\" className=\"btn btn-bordered-white btn-smaller\">Follow</button>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                  \r\n                                </div>\r\n                            )\r\n                        })\r\n                        : \r\n                        <p>No Creators Found</p>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n   \r\n    {\r\n    user: state.user\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getCreators })(Authors);","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/sidebar/sidebar.js",["1401","1402","1403"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/sidebar\";\r\n\r\nclass Sidebar extends Component {\r\n    state = {\r\n        data: {},\r\n        widgetData_1: [],\r\n        widgetData_2: [],\r\n        widgetData_3: []\r\n    }\r\n    componentDidMount() {\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data,\r\n                    widgetData_1: res.data.widgetData_1,\r\n                    widgetData_2: res.data.widgetData_2,\r\n                    widgetData_3: res.data.widgetData_3\r\n                })\r\n            })\r\n            .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <aside className=\"col-12 col-lg-4 pl-lg-5 p-0 float-right sidebar\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12 align-self-center text-left\">\r\n                        {/* Widget [categories] */}\r\n                        <div className=\"item widget-categories\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_1}</h4>\r\n                            <ul className=\"list-group list-group-flush\">\r\n                                {this.state.widgetData_1.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdo_${idx}`} className=\"list-group-item d-flex justify-content-between align-items-center\">\r\n                                            <a href=\"#\">{item.title}</a>\r\n                                            <span className=\"badge circle\">{item.content}</span>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                        {/* Widget [tags] */}\r\n                        <div className=\"item widget-tags\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_2}</h4>\r\n                            {this.state.widgetData_2.map((item, idx) => {\r\n                                return (\r\n                                    <a key={`wdt_${idx}`} href=\"\" className=\"badge tag\">{item.title}</a>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                        {/* Widget [share-this] */}\r\n                        <div className=\"item widget-share-this\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_3}</h4>\r\n                            <ul className=\"navbar-nav social share-list\">\r\n                                {this.state.widgetData_3.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdth_${idx}`} className=\"nav-item\">\r\n                                            <a href=\"#\" className=\"nav-link\"><i className={item.icon} /></a>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </aside>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Sidebar;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/filter-search2/filtersearch2.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/item-details/item-details.js",["1404","1405","1406","1407","1408","1409","1410","1411","1412","1413","1414","1415","1416","1417","1418","1419","1420","1421"],"import React, { Component } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport { Link } from 'react-router-dom';\r\nimport { beforeNFT, getNFT } from '../nfts/nfts.action';\r\nimport FullPageLoader from '../full-page-loader/full-page-loader'\r\nimport { ENV } from '../../config/config';\r\nimport moment from 'moment';\r\nimport Countdown from 'react-countdown';\r\nimport SimpleReactValidator from 'simple-react-validator'\r\nimport { decimalNumberValidator } from \"../../utils/functions\";\r\nimport { Container, Row, Col, Button, Modal } from \"react-bootstrap\";\r\nimport { beforeOffer, makeOffer, getOffers, deleteOffer, acceptOffer } from '../offers/offers.action'\r\nimport { beforeBid, placeBid, getBids, deleteBid, acceptBid } from '../bids/bids.action'\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {getCurrentAddress,BuyFixedPriceNFTs,placeBidNft,acceptNftOffer} from '../../utils/web3';\r\nimport { toast } from 'react-toastify'\r\nconst { globalPlaceholderImage, countDownRenderer, currencies, objectToQueryString } = ENV\r\n\r\nconst initData = {\r\n    itemImg: \"/img/auction_2.jpg\",\r\n    date: \"2022-03-30\",\r\n    price_2: \"$500.89\",\r\n    bidBtn: \"Place a Bid\",\r\n    offerBtn: \"Buy Now\",\r\n    sellBtn: \"Sell\"\r\n}\r\n\r\n// expiry options\r\n\r\nconst expiryOptions = [\r\n    { label: '5 Days', value: moment().add(5, \"days\").format('DD/MM/YYYY') },\r\n    { label: '7 Days', value: moment().add(7, \"days\").format('DD/MM/YYYY') },\r\n    { label: 'A Month', value: moment().add(1, \"months\").format('DD/MM/YYYY') },\r\n    { label: 'Custom Date', value: -1 },\r\n]\r\n\r\n// make an offer / bid config.\r\n\r\nconst config1 = {\r\n    price: {\r\n        currency: ENV.currency,\r\n        amount: \"\",\r\n    },\r\n    expiry: {\r\n        date: expiryOptions[0].value,\r\n        time: moment(new Date()).format(\"HH:mm\"),\r\n        type: 1, // 1 for time & 2 for datetime-local\r\n        datetime: '' // for payload \r\n    }\r\n};\r\nlet nft1=[]\r\nclass ItemDetails extends Component {\r\n    isTimeoutAction = false;\r\n    constructor(props) {\r\n        super(props)\r\n        this.state = {\r\n            userId: ENV.getUserKeys()?._id,\r\n            offers: null,\r\n            offersPagination: null,\r\n\r\n            bids: null,\r\n            bidsPagination: null,\r\n            highestBidAmtt:null,\r\n            errors: '',\r\n            isSubmitted: false,\r\n            formValid: true,\r\n            loader: true,\r\n            nft: null,\r\n            nftAll:null,\r\n            isOpen: false,\r\n            creator:[],\r\n            nftConfig: config1 ,// make an offer / bid config.\r\n            nftsData:[],\r\n            bidsData:[],\r\n            creators:[],\r\n            myAddress:''\r\n        }\r\n        this.validator = new SimpleReactValidator({\r\n            autoForceUpdate: this,\r\n            messages: {\r\n                required: 'This field is required.'  // will override all messages\r\n            },\r\n        });\r\n\r\n    }\r\n\r\n    componentDidMount= async()=> {\r\n        window.scroll(0, 0)\r\n        let myAddress=await getCurrentAddress()\r\n     \r\n        this.setState({\r\n            myAddress\r\n        })\r\n        const query = new URLSearchParams(window.location.search)\r\n        this.getTokens()\r\n       \r\n        if (query.get('item')) {\r\n        \r\n            const nftId = window.atob(query.get('item'))\r\n            // console.log(nftId,\"nftId====>\");\r\n            if (nftId) {\r\n                this.props.getNFT(nftId);\r\n                this.getBids(nftId)\r\n\r\n                const bidQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getBids(bidQS);\r\n\r\n                const offerQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getOffers(offerQS);\r\n                this.props.getCreators();\r\n            }\r\n        } else\r\n            this.props.history.push('/explore-all')\r\n    }\r\n\r\n    filterCreator=(nft)=>{\r\n     \r\n        // let nftId=this.state.nft.collection.userId\r\n    }\r\n    filterCreatorsInfo=(id,item)=>{\r\n      \r\n      let user= this.props.user?.creators?.find((item)=>item._id===id )\r\n      if(user){\r\n          if(item==\"username\"){\r\n             return user.username\r\n          }\r\n          if(item==\"profilePhoto\"){\r\n              return user?.profileImage\r\n          }\r\n          if(item==\"id\"){\r\n            return user._id\r\n          }\r\n      }\r\n    }\r\n\r\n    componentDidUpdate() {\r\n        // if (this.props.error)\r\n        //     this.setState({ loader: false })\r\n\r\n        if (this.props.nft.nftsAuth) {\r\n           \r\n            const nft = this.props.nft.nftsData\r\n            const allData=this.props.nft.nftAll\r\n           \r\n            //nft\r\n            nft1=nft\r\n            this.getBids(nft?._id)\r\n            this.setState({\r\n                \r\n                nft,\r\n            nftAll:allData\r\n                \r\n            }, () => {\r\n                this.props.beforeNFT()\r\n            })\r\n            this.filterCreator(nft)\r\n            const date1 = moment();\r\n            const date2 = moment(this.props?.nft?.nftAll?.sellingConfig?.duration?.endDate);\r\n           \r\n            // this.isTimeoutAction =  date2.diff(date1) > 0 ? false : true;\r\n            let result =  date2.diff(date1) > 0 ? false : true;\r\n            this.setState({\r\n                isTimeoutAction:result\r\n            })\r\n            // console.log(result,\"checking result\")\r\n        }\r\n\r\n        if (this.props.offer.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeOffer()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getOffers(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.getAuth) {\r\n            const { offers, pagination } = this.props.offer\r\n            this.setState({ loader: false, offers, offersPagination: pagination }, () => {\r\n                this.props.beforeOffer()\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.deleteAuth) {\r\n            this.props.beforeOffer()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getOffers(qs)\r\n        }\r\n\r\n        if (this.props.bid.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeBid()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getBids(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.getAuth) {\r\n         \r\n            const { bids, pagination, highestBidAmt } = this.props.bid\r\n        \r\n            let nft = { ...this.state.nft }\r\n\r\n            nft.highestBidAmt = highestBidAmt\r\n           \r\n            this.setState({ loader: false, bids, bidsPagination: pagination, nft }, () => {\r\n                this.props.beforeBid()\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.deleteAuth) {\r\n            this.props.beforeBid()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getBids(qs)\r\n        }\r\n\r\n        if (this.props.offer.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeOffer()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeBid()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n        //    console.log(this.props.user.topSellersAuth,\"kjkjkjlkjlkjkljlkjk\");\r\n\r\n        if(this.props.user.topSellersAuth && !this.state.creator?.length>0 ){\r\n            this.filterCreator(this.props.user.sellers)\r\n            this.setState({\r\n                creator:this.props.user.sellers,\r\n                creators:this.props.user.creators\r\n            })\r\n            // console.log(this.props.user.sellers,\"creators===}}}}}}}}}}}}}}}}}}}}}\");\r\n            // console.log(this.state.nft,\"nft below the creator===>\")\r\n        }\r\n        \r\n\r\n    }\r\n   \r\n    getBids=(nftId)=>{\r\n        const BASE_URL= process.env.REACT_APP_BASE_URL \r\n        fetch(BASE_URL + \"/bid/list\", {\r\n            method: 'GET',\r\n            headers: {\r\n                'content-type': 'application/json',\r\n                'Authorization': ENV.Authorization,\r\n                'x-auth-token': ENV.x_auth_token,\r\n                'Access-Control-Allow-Origin': '*',\r\n                'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n            }\r\n        }).then(res => res.json()).then(data => {\r\n       \r\n            let bids=data.data.allBids?.filter((item)=>item.nftId===nftId)          \r\n           \r\n            // const highestBidAmt = bids.length\r\n            var last_element = bids[bids?.length - 1];\r\n       \r\n            this.setState({\r\n                bidsData:bids,\r\n                highestBidAmtt: last_element?.price.amount\r\n\r\n            })\r\n            setTimeout(()=>{\r\n               this.setState({\r\n                   loader:false,\r\n               })\r\n            },2000)\r\n         \r\n        }).catch(error => {\r\n        console.log(error,\"error while getting bids\")\r\n           \r\n        })\r\n    }\r\n    openModal = () => {\r\n  \r\n        if(this.props?.nft?.nftAll.sellingMethod==1)\r\n        {\r\n            // console.log(\"inside if\")\r\n            var res= this.state.nftsData.data.find((item)=>item.nftId===this.state.nft._id)\r\n            // console.log(res,\"response\")               \r\n             // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n             this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n               this.setState({\r\n                   loader:false\r\n               })\r\n\r\n            }, 8000);\r\n          \r\n             BuyFixedPriceNFTs(this.props?.nft?.nftAll.currentPrice,res.nftToken,this.props.nft.nftAll._id)\r\n            \r\n        }\r\n        else {\r\n            // console.log(\"inside else\")\r\n            this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n        }\r\n      \r\n        // this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n    }\r\n\r\n    closeModal = () => this.setState({ isOpen: false });\r\n\r\n    onChange = (e) => {\r\n        const { nftConfig } = this.state;\r\n        const { name, value } = e.target;\r\n        let data = nftConfig;\r\n\r\n        const keys = name.split(\".\"); // nftConfig, price, currency\r\n        if (keys && keys[2])\r\n            data[keys[1]][keys[2]] = value;\r\n        else if (keys && keys[1])\r\n            data[keys[1]] = value;\r\n\r\n        if (keys && keys[1] === 'price' && keys[2] === 'amount')\r\n            data[keys[1]]['amount'] = Number(value)\r\n\r\n        if (keys && keys[1] === 'expiry' && keys[2] === 'date')\r\n            data[keys[1]]['type'] = Number(value) === -1 ? 2 : 1\r\n\r\n        // set datetime for days / months \r\n        if (data.expiry.type === 1)\r\n            data.expiry.datetime = moment(data.expiry.date + ' ' + data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n        // set datetime for custom date\r\n        else if (data.expiry.type === 2) {\r\n            data.expiry.datetime = moment(data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n            data.expiry.date = moment(data.expiry.time, 'DD/MM/YYYY')\r\n        }\r\n\r\n        this.setState({\r\n            nftConfig: {\r\n                ...data\r\n            }\r\n        })\r\n    };\r\n\r\n    // submit when a bid is placed or when an offer is made\r\n    submit = () => {\r\n    //   console.log(this.state.myAddress,\"myaddress\")\r\n\r\n        this.setState({ isSubmitted: true, formValid: this.validator.allValid() }, () => {\r\n            const { formValid } = this.state\r\n            if (formValid) {\r\n                this.setState({\r\n                    loader: false               //need to convert true\r\n                }, () => {\r\n                    const { nft, nftConfig,nftAll } = this.state\r\n           \r\n                    // console.log(nftAll,\"checking nft==>\")\r\n                    const payload = {\r\n                        // ownerId: nft.owner._id,\r\n                        expiryDate: nftConfig.expiry.datetime,\r\n                        price: nftConfig.price,\r\n                        nftId: nft._id,\r\n                        bidBy:ENV.getUserKeys('_id'),\r\n                        user:ENV.getUserKeys('_id'),\r\n                        offerById:ENV.getUserKeys('_id'),\r\n                        toAddress:nftAll.ownerAddress,\r\n                        fromAddress:this.state.myAddress,\r\n\r\n                    }\r\n                    // console.log(payload,\"toaddress8888888\")\r\n           \r\n                    let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                    // console.log('check here selling method',nft.sellingMethod )\r\n                    // if selling method is 2 then go for bid\r\n                    if (nft.sellingMethod === 2) { // place a bid \r\n                        placeBidNft(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        // this.props.placeBid(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        this.setState({\r\n                            loader:true\r\n                        })\r\n\r\n                        setTimeout(() => {\r\n                            this.setState({\r\n                                loader:false\r\n                            })\r\n                          \r\n                        }, 5000);\r\n                    } else if (nft.sellingMethod === 1) { // make an offer \r\n                       let res= this.state.nftsData.find((item)=>item.nftId===nft._id)\r\n                    //    console.log(res,\"response\")\r\n                             \r\n                        // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                        // BuyFixedPriceNFTs(payload.price,res.nftToken)\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                        // this.props.makeOffer(payload,foundResult,payload.price)\r\n                    }\r\n                    else{\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        // console.log('single nft before fix price function', nft)\r\n                        let res= this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                        // console.log(res,\"response\")\r\n                              \r\n                         // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                         BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                    }\r\n                })\r\n\r\n            }\r\n\r\n            else {\r\n                alert(\"in else\")\r\n                this.validator.showMessages()\r\n                this.validator.purgeFields()\r\n                this.setState({\r\n                    errors: 'Please fill all required fields in valid format.',\r\n                    formValid: false\r\n                }, () => {\r\n                    window.scroll(0, 0)\r\n                })\r\n            }\r\n            \r\n        })\r\n    }\r\n\r\n    deleteOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteOffer(offerId)\r\n        })\r\n    }\r\n\r\n    deleteBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteBid(bidId)\r\n        })\r\n    }\r\n\r\n    acceptOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.acceptBid({ offerId })\r\n        })\r\n\r\n    }\r\n\r\n    acceptBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            const { nft, nftConfig,nftAll } = this.state\r\n        \r\n            let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n  \r\n            const payload = {\r\n                bidId:bidId,\r\n                nftId: nft._id,\r\n                bidBy:ENV.getUserKeys('_id'),\r\n                user:ENV.getUserKeys('_id'),\r\n                toAddress:nftAll.ownerAddress,\r\n                fromAddress:this.state.myAddress,\r\n            }\r\n            this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n                this.setState({\r\n                    loader:false\r\n                })\r\n              \r\n            }, 7000);\r\n            acceptNftOffer(foundResult.nftToken,payload)\r\n            // this.props.acceptBid(payload,foundResult.nftToken)\r\n             \r\n        })\r\n       \r\n    }\r\n    creatorUserName=()=>{\r\n        // console.log(this.state.creator,\"creator listing\");/\r\n        // console.log(this.props.nftAll,\"this.props.nftAll?\");\r\n\r\n       let result= this.state.creator.find((item)=>item._id===this.state?.nftAll?.userId)\r\n    //    console.log(result,\"result in the userName function===>\");\r\n       if(result?.username)\r\n       {\r\n\r\n           return result.username\r\n       }\r\n       else {\r\n           return \"no username\"\r\n       }\r\n    }\r\n     getTokens=()=>{\r\n\r\n        let url = process.env.REACT_APP_BASE_URL + `nftTokens/tokens`;\r\n      \r\n        fetch(url, {\r\n         method: 'GET',\r\n         headers: {\r\n            'content-type': 'application/json',\r\n            'Authorization': ENV.Authorization,\r\n            'x-auth-token': ENV.x_auth_token,\r\n            'Access-Control-Allow-Origin': '*',\r\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n        },\r\n      \r\n      }).then(res => res.json()).then(data => {\r\n \r\n        //   console.log(data,\"data==>22222222222222222222222222222222222222\")\r\n      \r\n     this.setState({\r\n        nftsData:data\r\n     })\r\n      \r\n      }).catch(error => {\r\n        \r\n        console.log(error,\"error in catch blcok\")\r\n        \r\n      })\r\n    }\r\n    // filterCreatorsInfo=(id,item)=>{\r\n    //     // console.log(this.state.creators,\"creator in the filterCreatorsFunction\")\r\n    //   let user= this.state?.creators?.data?.find((item)=>item._id===id )\r\n    //   if(user){\r\n\r\n    //       if(item==\"username\"){\r\n    //          return user.username\r\n    //       }\r\n    //       if(item==\"profilePhoto\"){\r\n    //           return user?.profileImage\r\n    //       }\r\n    //       if(item==\"id\"){\r\n    //         return user._id\r\n    //       }\r\n    //   }\r\n      \r\n    // }\r\n\r\n    render() {\r\n        const { loader, nft, nftConfig, isSubmitted, errors, userId, bids, offers } = this.state\r\n        if(!ENV.getUserKeys('_id')._id){\r\n            toast.error(\"Pleas login to continue\")\r\n            this.props.history.push('/')\r\n               return \" \"\r\n           }\r\n           else {\r\n        return (\r\n            <>\r\n                <section className=\"item-details-area padding-wrapper pb-0\">\r\n                    {\r\n                        loader ?\r\n                            <FullPageLoader /> :\r\n                            <>\r\n                                {\r\n                                    nft && \r\n                                    <div className=\"container\">\r\n                                        <div className=\"row justify-content-between\">\r\n                                            <div className=\"col-12 col-lg-5\">\r\n                                                <div className=\"item-info\">\r\n                                                    <div className=\"item-thumb text-center\">\r\n                                                        <img src={nft.image} alt=\"NFT Image\" />\r\n                                                    </div>\r\n                                                    {\r\n                                                        nft.auctionEndDate &&\r\n                                                        <div className=\"card no-hover countdown-times mt-4\">\r\n                                                            <Countdown\r\n                                                                date={new Date(nft.auctionEndDate) + 10000}\r\n                                                                renderer={countDownRenderer}\r\n                                                            />\r\n                                                        </div>\r\n                                                    }\r\n                                                    {/* Tabs */}\r\n                                                    <ul className=\"netstorm-tab nav nav-tabs mt-4\" id=\"nav-tab\">\r\n                                                        <li>\r\n                                                            <a className=\"active\" id=\"bids-tab\" data-toggle=\"pill\" href=\"#bids\">\r\n                                                                <h5 className=\"m-0\">Bids</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                        {/* <li>\r\n                                                            <a id=\"offers-tab\" data-toggle=\"pill\" href=\"#offers\">\r\n                                                                <h5 className=\"m-0\">Offers</h5>\r\n                                                            </a>\r\n                                                        </li> */}\r\n                                                        <li>\r\n                                                            <a id=\"details-tab\" data-toggle=\"pill\" href=\"#details\">\r\n                                                                <h5 className=\"m-0\">Details</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                    </ul>\r\n                                                    \r\n                                                    {/* Tab Content */}\r\n                                                    <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                                                        <div className=\"tab-pane fade show active\" id=\"bids\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {this.state.bidsData &&  this.props.user?.creators?.length > 0  ? \r\n                                                                \r\n                                                                    this.state.bidsData.map((item, idx) => {\r\n                                                                \r\n                                                                        return (\r\n                                                                            <li key={`bid_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                             \r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Bid listed for <strong>{item.price.amount} {item.price.currency} </strong>\r\n                                                                                     <span>{moment(item.createdAt).fromNow()} </span>\r\n                                                                                     <br />by <Link to={`/author/${item.bidById}`}>@{ this.filterCreatorsInfo(item.bidBy,'username')}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                     nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                      nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                     \r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No bids found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div>\r\n\r\n                                                        {/* <div className=\"tab-pane fade\" id=\"offers\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {offers && offers.length > 0 ?\r\n                                                                    offers.filter((item)=>item.nftId===nft._id).map((item, idx) => {\r\n                                                                        return (\r\n                                                                            <li key={`offer_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.offerBy?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Offer listed for <strong>{item.price.amount} {item.price.currency}</strong> {moment(item.createdAt).fromNow()} <br />by <Link to={`/author/${item.nftId}`}>@{this.filterCreatorsInfo(item.offerById,\"username\")}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No offers found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div> */}\r\n                                                        \r\n                                                        <div className=\"tab-pane fade\" id=\"details\">\r\n                                                            <div className=\"owner-meta d-flex align-items-center mt-3\">\r\n                                                                <span>Owner</span>\r\n                                                                <Link className=\"owner d-flex align-items-center ml-2\" to={`/author/${nft.owner?._id}`}>\r\n                                                                    <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto ? nft.owner.profilePhoto : globalPlaceholderImage} alt=\"Owner Image\" />\r\n                                                                    <h6 className=\"ml-2\">{nft.owner?.username}</h6>\r\n                                                                </Link>\r\n                                                            </div>\r\n                                                            <p className=\"mt-2\">Created : {moment(nft.createdAt).format('DD MMM YYYY')\r\n                                                            }</p>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 col-lg-6\">\r\n                                                <div className=\"content mt-5 mt-lg-0\">\r\n                                                    <h3 className=\"m-0\">{nft.name}</h3>\r\n                                                    <p>{nft.description}</p>\r\n\r\n                                                    {/* Owner */}\r\n                                                    <div className=\"owner d-flex align-items-center\">\r\n                                                        <span>Owned By</span>\r\n                                                        <Link className=\"owner-meta d-flex align-items-center ml-3\" to={`/author/${nft.owner?._id}`}>\r\n                                                            <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto || globalPlaceholderImage} alt=\"Owner Avatar\" />\r\n                                                            <h6 className=\"ml-2\">\r\n                                                                {/* {nft.owner?.username}\r\n                                                                 */}\r\n                                                                 {this.creatorUserName()}\r\n                                                                </h6>\r\n                                                        </Link>\r\n                                                    </div>\r\n                                                    {/* Item Info List */}\r\n                                                    <div className=\"item-info-list mt-4\">\r\n                                                        <ul className=\"list-unstyled\">\r\n                                                            <li className=\"price d-flex justify-content-between\">\r\n                                                                <span>Current Price {nft.currentPrice || 0} {ENV.currency}</span>\r\n                                                                {/* <span>{initData.price_2}</span> */}\r\n                                                                <span>{nft.sold} of {nft.copies}</span>\r\n                                                            </li>\r\n                                                            <li>\r\n                                                                <span>Size </span>\r\n                                                                <span>{nft.size}</span>\r\n                                                            </li>\r\n                                                        </ul>\r\n                                                    </div>\r\n                                                    <div className=\"row items\">\r\n                                                        {/* Creator */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <a href=\"/author\">\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.creator?.profilePhoto || globalPlaceholderImage} alt=\"Creator Avatar\" />\r\n                                                                    </a>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`/author/${nft.creator?._id}`}>{\r\n                                                                          this.creatorUserName()\r\n                                                                        // nft.creator?.username\r\n                                                                        }</Link>\r\n                                                                        <span>Creator</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        {/* Collection */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <Link to={`collection-details/${window.btoa(nft.collection?._id)}`}>\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.collection?.image} alt=\"Collection Image\" />\r\n                                                                    </Link>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`collection-details/${window.btoa(nft.collection?._id)}`}>{nft.collection?.name}</Link>\r\n                                                                        <span>Collection</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        <div className=\"col-12 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <h4 className=\"mt-0 mb-2\">Highest Bid</h4>\r\n                                                                <div className=\"price d-flex justify-content-betxween align-items-center\">\r\n                                                                    <span>{this.state.highestBidAmtt ? this.state.highestBidAmtt + ` ${ENV.currency}` : 'N/A'}</span>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                    {\r\n\r\n                                                        nft.nftOwnerId=== userId ?\r\n                                                        <Link className=\"d-block btn btn-bordered-white mt-4 mb-4 w-100\" to={`/sell-item/${window.btoa(nft._id)}`}>{initData.sellBtn}</Link>\r\n                                                        :\r\n                                                        // <button className=\"d-block btn btn-bordered-white mt-4 w-100\" onClick={this.openModal(nft)}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn}</button>\r\n                                                        <>\r\n                                                             {/* this.isTimeoutAction ? 'Auction Timeout' : */}\r\n                                                             {/*  */}\r\n                                                            { \r\n                                                           this.props?.nft?.nftAll.sellingMethod &&\r\n                                                            <button  className=\"d-block btn btn-bordered-white mt-4 w-100\" disabled={this.isTimeoutAction || nft.copies===nft.sold}  onClick={()=>this.openModal()}>{this.isTimeoutAction?\"Auction Timeout\":( nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn)}</button>}\r\n                                                             \r\n                                                            </>\r\n                                                    }\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                }\r\n                            </>\r\n\r\n                    }\r\n                </section>\r\n                <div className=\"modal-wrapper\">\r\n                    {\r\n                        nft &&\r\n                        <Modal\r\n                            centered\r\n                            size=\"lg\"\r\n                            className=\"\"\r\n                            show={this.state.isOpen}\r\n                            onHide={this.closeModal}\r\n                        >\r\n                            <Modal.Header className=\"text-center modal-title-wrapper\">\r\n                                <Modal.Title>\r\n                                    { nft.sellingMethod === 2 ? 'Place A Bid' : 'Make An Offer'}\r\n                                </Modal.Title>\r\n                            </Modal.Header>\r\n                            {\r\n                                isSubmitted && errors &&\r\n                                <Modal.Body className=\"row pt-2 pb-0\">\r\n                                    <div className=\"col-12\">\r\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\r\n                                    </div>\r\n                                </Modal.Body>\r\n                            }\r\n                            <Modal.Body>\r\n                                <div className=\"price-wrapper d-flex\">\r\n                                    <div className=\"price-text position-relative\">\r\n                                        <div className=\"text-white mb-2 absolute-wrapper\">\r\n                                            <b>Price</b>\r\n                                        </div>\r\n                                        <div className=\"text-right mb-2\">\r\n                                            <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                                        </div>\r\n                                        <div className=\"d-flex\">\r\n                                            <select className=\"form-control\" id=\"currency\" name=\"nftConfig.price.currency\" onChange={(e) => this.onChange(e)}>\r\n                                                {\r\n                                                    currencies && currencies.map((currency, index) => {\r\n                                                        return (\r\n                                                            <option key={index} value={currency.symbol}>{currency.symbol}</option>\r\n                                                        )\r\n                                                    })\r\n                                                }\r\n                                            </select>\r\n                                            <input type=\"text\" placeholder=\"Amount\" className=\"amount-btn ml-3\" name=\"nftConfig.price.amount\" placeholder=\"Amount\" className=\"amount-btn ml-3\" style={{ borderRadius: \"4px\" }} onChange={(e) => this.onChange(e)} onKeyDown={(e) => decimalNumberValidator(e)} defaultValue={nftConfig.price.amount} required />\r\n                                            <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                                $ 0.00\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"text-danger\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</Modal.Body>\r\n                            <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\r\n                                <div className=\"offer-expiration-wrapper text-white\">\r\n                                    <b>Offer Expiration</b>\r\n                                </div>\r\n                                <div>\r\n                                    <div className=\"d-flex\">\r\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\r\n                                            style={{\r\n                                                padding: \"7px 55px 7px 55px\",\r\n                                                border: \"none\",\r\n                                                outline: \"none\",\r\n                                                borderRadius: \"4px\",\r\n                                                background: \"#808080\",\r\n                                                display: \"flex\",\r\n                                                alignItems: \"center\",\r\n                                                cursor: \"pointer\",\r\n                                                height: \"51px\",\r\n                                                color: \"#000\"\r\n                                            }}\r\n                                        >\r\n                                            {\r\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\r\n                                                    return (\r\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\r\n                                                    )\r\n                                                })\r\n                                            }\r\n                                        </select>\r\n                                        <div>\r\n                                            <div className=\"mr-auto budle-wrapper\">\r\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\r\n                                            </div>\r\n                                            <span className=\"text-danger message\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"justify-content-center align-items-center\">\r\n                                <div className=\"d-flex justify-content-around\">\r\n                                    <button className=\"ethereum-btn mr-3\" disabled={loader} onClick={() => this.submit()}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.bidBtn}</button>\r\n                                    {/* <button className=\"ethereum-btn\">Add funds</button> */}\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Footer>\r\n                                <button\r\n                                    className=\"btn banner-btn btn-primary\"\r\n                                    onClick={this.closeModal}\r\n                                >\r\n                                    Close\r\n                                </button>\r\n                            </Modal.Footer>\r\n                        </Modal>\r\n                    }\r\n                </div>\r\n            </>\r\n        );\r\n                }\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n    // console.log('state', state),\r\n \r\n    {\r\n    nft: state.nft,\r\n    error: state.error,\r\n    offer: state.offer,\r\n    bid: state.bid,\r\n    user: state.user,\r\n    nftAll:state.nftAll,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeNFT, getNFT,\r\n    beforeOffer, makeOffer, getOffers, deleteOffer, beforeBid, placeBid, getBids, deleteBid, acceptOffer, acceptBid, beforeUser, getCreators ,\r\n})(ItemDetails);\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/help/help.js",["1422"],"import React, { Component } from 'react';\r\n\r\nconst initData = {\r\n    pre_heading: \"Help Center\",\r\n    heading: \"How can we help you?\",\r\n    content: \"\"\r\n}\r\n\r\nconst data = [\r\n    {\r\n        id: \"1\",\r\n        icon: \"icon icon-plane text-effect\",\r\n        title: \"Getting Started\",\r\n        content: \"Learn how to create an account, set up your wallet, and what you can do on NetStorm\"\r\n    },\r\n    {\r\n        id: \"2\",\r\n        icon: \"icon icon-note text-effect\",\r\n        title: \"Creating\",\r\n        content: \"Learn how to create your very first NFT and how to create your NFT collections so you can begin selling and sharing\"\r\n    },\r\n    {\r\n        id: \"3\",\r\n        icon: \"icon icon-handbag text-effect\",\r\n        title: \"Buying\",\r\n        content: \"Learn how to purchase your first NFT and understand gas fees and what's gas free on NetStorm\"\r\n    },\r\n    {\r\n        id: \"4\",\r\n        icon: \"icon icon-chart text-effect\",\r\n        title: \"Selling\",\r\n        content: \"Learn how list your NFTs for sale and understand the different ways to list your NFTs\"\r\n    },\r\n    {\r\n        id: \"5\",\r\n        icon: \"icon icon-link text-effect\",\r\n        title: \"Partners\",\r\n        content: \"Learn how you can partner with us to showcase your NFT drops\"\r\n    },\r\n    {\r\n        id: \"6\",\r\n        icon: \"icon icon-flag text-effect\",\r\n        title: \"Developers\",\r\n        content: \"Learn how you can develop with NetStorm &amp; sell them on Marketplace\"\r\n    }\r\n]\r\n\r\nclass HelpCenter extends Component {\r\n    state = {\r\n        initData: {},\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        this.setState({\r\n            initData: initData,\r\n            data: data\r\n        })\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"help-center-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row justify-content-center\">\r\n                        <div className=\"col-12 col-md-8 col-lg-7\">\r\n                            {/* Intro */}\r\n                            <div className=\"intro text-center\">\r\n                                <span>{this.state.initData.pre_heading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                                <p>{this.state.initData.content}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"row justify-content-center items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`hd_${idx}`} className=\"col-12 col-md-6 col-lg-4 item\">\r\n                                    {/* Help Card */}\r\n                                    <div className=\"card help-card\">\r\n                                        <a className=\"d-block text-center\" href=\"#\">\r\n                                            <i className={item.icon} />\r\n                                            <h4>{item.title}</h4>\r\n                                            <p>{item.content}</p>\r\n                                        </a>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default HelpCenter;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/nft-preview/nft-preview.js",["1423"],"import React from 'react';\r\nimport { ENV } from '../../config/config'\r\nimport './nft-preview.css'\r\nconst itemPlaceholderImg = ENV.globalPlaceholderImage\r\n\r\nconst NFTPreview = (props) => {\r\n    return (\r\n       \r\n        <div className=\"card preview-nft-card no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.image ? props.image : itemPlaceholderImg} alt=\"NFT image\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body p-0 m-0\">\r\n                    {/* <h5 className=\"mb-3\">{props.name}</h5> */}\r\n                    {/* <p>{props.sold ? props.sold : 0} of {props.copies ? props.copies : 0} Copies</p> */}\r\n                    <p className=\"text-left nft-name-text mt-4\">{\"name\"}</p>\r\n                    <div className=\"d-flex justify-content-between\">\r\n\r\n                    <p className=\"text-white celo-text\">{props.currentPrice ? props.currentPrice : 0}{ENV.currency}</p>\r\n                    <p className=\"text-white\">{\"10/10\"}</p>\r\n                    </div>\r\n                    <div className=\"input-group\">\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n       \r\n    );\r\n}\r\n\r\nexport default NFTPreview;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/components/NftCard/NftCard.js",["1424","1425"],"import react from \"react\";\nimport { Link } from \"react-router-dom\";\nimport \"./NftCard.css\";\n\nconst NftCard = (props) => {\n  const filterCreator = (nft) => {\n    const result = props.creators.find((item) => item._id === nft.nftOwnerId);\n    if (result?.username) {\n      return result?.username;\n    } else {\n      return \"no username found\";\n    }\n  };\n  const { userId, nft } = props;\n  return (\n    <div className=\"NftCard-Container \">\n      <Link to={`/item-details?item=${window.btoa(props.nft._id)}`}>\n        <img\n          src={\n            props?.nft?.image ? props.nft.image : \"https://picsum.photos/200\"\n          }\n          alt=\"testinImage\"\n          className=\"nft-car-img\"\n        />\n      </Link>\n\n      <div className=\"NftCard-description p-3\">\n        <p className=\"mb-0 text-white\">\n          {props?.nft?.name ? props.nft.name : \"someTHing\"}\n        </p>\n        <p className=\"text-white\">Owned By: {filterCreator(props.nft)}</p>\n        <div className=\"d-flex w-100 justify-content-between\">\n          <p className=\"mb-0 text-white\">\n            {props?.nft?.currentPrice ? props.nft.currentPrice : \"0.04\"}\n          </p>\n          <p className=\"mt-0 text-white\">\n            {props?.nft?.sold ? props.nft.sold : \"0\"} out of {props.nft.copies}\n          </p>\n        </div>\n        <div className=\"py-3\">\n          <Link\n            to={`/item-details?item=${window.btoa(props.nft._id)}`}\n            id=\"wallet-address\"\n            className=\"btn ml-lg-auto btn-bordered-white\"\n          >\n            <i className=\"icon-wallet mr-md-2\" />\n            {nft.nftOwnerId === userId\n              ? \"Sell NFT\"\n              : nft.sellingMethod === undefined\n              ? \"NFT Details\"\n              : nft.nftOwnerId !== userId && nft.sellingMethod == 1\n              ? \"Buy Now\"\n              : \"Place a Bid\"}\n          </Link>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default NftCard;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/collection-preview.js",["1426","1427"],"import React from 'react';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV\n\nconst CollectionPreview = ({ collection }) => {\n    return (\n        <>\n            <div className=\"card no-hover text-center \">\n                <div className=\"image-over\">\n                    <div>\n                        <img className=\"card-img-top\" src={collection.featuredImg ? collection.featuredImg : collectionFeaturedImg} alt=\"Collection Featured Image\" />\n                    </div>\n                    <div className=\"seller\">\n                        <div className=\"seller-thumb avatar-lg\">\n                            <img className=\"rounded-circle\" src={collection.logo} alt='Collection Logo' />\n                        </div>\n                    </div>\n                </div>\n                <div className=\"card-caption col-12 p-0\">\n                    <div className=\"card-body mt-4\">\n                        <div>\n                            <h5 className=\"mb-2\">{collection.name}</h5>\n                            <p className=\"mb-2\">\n                                {\n                                    collection.url ?\n                                        <div className=\"input-group\">\n                                            <input type=\"text\" className=\"form-control\" placeholder=\"Collection URL\" readOnly value={collection.url} />\n                                            <div className=\"input-group-append\" style={{ zIndex: 888 }}>\n                                                <button className=\"btn mr-0\"><i className=\"icon-docs\" /></button>\n                                            </div>\n                                        </div>\n                                        : ('URL: N/A')\n                                }\n                            </p>\n                            <p className=\"mb-2\">{collection.description ? collection.description : 'Description: N/A'}</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div className=\"row items\">\n                <div className=\"col-12 px-0 mt-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <img className=\"avatar-md rounded-circle\" src={collection.category?.image || categoryDefaultImg} alt=\"Category Image\" />\n                            <div className=\"seller-info ml-3\">\n                                <div className=\"seller\">{collection.category?.name || 'N/A'}</div>\n                                <span>Category</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"col-12 px-0 my-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <Link to=\"/author\">\n                                <img className=\"avatar-md rounded-circle\" src={collection.user?.profilePhoto || userDefaultImg} alt=\"User Avatar\" />\n                            </Link>\n                            <div className=\"seller-info ml-3\">\n                                <Link className=\"seller mb-2\" to=\"/author\">{collection.user?.username}</Link>\n                                <span>Creator</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default CollectionPreview;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/explore/explore-items.js",["1428","1429","1430","1431","1432","1433","1434"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nimport NftCard from '../collections/components/NftCard/NftCard'\nconst initData = {\n    btn_1: \"Load More\",\n}\n\nfunction ExploreItems(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n\n    useEffect(() => {\n        // get NFTs for explore section\n        const nftQS = { page: 1, limit: 4, explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }, [])\n\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            if (nftsData) {\n                setNFTs(nftsData.nfts)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n                setLoader(false)\n                if (props.setView)\n                    props.setViewAll(nftsData.nfts && nftsData.nfts.length > 0)\n            }\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n\n        // get more NFTs for explore section\n        const nftQS = { page: 1, limit: limit * (page + 1), explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n    return (\n        <>\n            {/* <div className={`row items ${props.class1 ? props.class1 : ''} ${!nfts.length ? 'justify-content-center' : ''}`}> */}\n            <div className=\"row\">\n            <div className=\"row justify-content-center mt-5 w-100\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                {/* <span>{initData.pre_heading}</span> */}\n                                <span>Explore</span>\n                                {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                                    <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                            </div>\n                        </div>\n                    </div>\n\n                {\n                    props.nfts && props.nfts.length > 0 ?\n                        props.nfts.map((item, idx) => {\n                            return (\n                                \n                                // <div key={`${props.key}_${idx}`} className={`col-12 col-sm-6 col-lg-3 item d-block ${props.class2 ? props.class2 : ''}`}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <Link to=\"/author\">\n                                //                         <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6>\n                                //                     </Link>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     {/* <span>{item.sold} of {item.copies}</span> */}\n                                //                 </div>\n                                //                 {/* <Link className=\"btn btn-bordered-white btn-smaller mt-3\" to=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</Link> */}\n                                //             </div>http://3.142.91.8/authorshttp://3.142.91.8/authors\n                                //         </div>\n                                //     </div>\n                                // </div>\n                                     \n                      <>\n                     \n                                     <div className=\"col-4 mt-5\">\n                                     <NftCard/>\n                                     </div>\n\n                                     </>\n                              \n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Explore</p>\n                }  </div>\n            {/* </div> */}\n            {\n                props.loadMoreBtn &&\n                <div className=\"row\">\n                    <div className=\"col-12 text-center\">\n                        <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                    </div>\n                </div>\n            }\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs })(ExploreItems);","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/explore/explore-home.js",["1435","1436","1437","1438","1439","1440"],"import React, { useState } from 'react';\nimport ExploreItems from './explore-items';\nimport { Link } from 'react-router-dom';\n\nconst initData = {\n    pre_heading: \"Exclusive Assets\",\n    heading: \"Explore\",\n    btn_1: \"View All\",\n}\n\nfunction ExploreHome() {\n    const [viewAll, setViewAll] = useState(false);\n\n    const getViewAll = (view) => {\n        setViewAll(view)\n    }\nconst nfts=[\n  1,2,3,4,5,6\n]\n    return (\n        <section className=\"explore-area load-more p-0\">\n            <div className=\"container\">\n                <div className=\"row\">\n                    {/* <div className=\"col-12\">\n                        <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                            <div className=\"intro-content\">\n                                <span>{initData.pre_heading}</span>\n                                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                            </div>\n                            {\n                                viewAll &&\n                                <div className=\"intro-btn\">\n                                    <Link className=\"btn content-btn\" to=\"/explore-all\">{initData.btn_1}</Link>\n                                </div>\n                            }\n                        </div>\n                    </div> */}\n                </div>\n                {/* <ExploreItems key=\"exo\" setView={true} setViewAll={getViewAll} loadMoreBtn nfts={nfts}/> */}\n            </div>\n        </section>\n    );\n}\n\nexport default ExploreHome;","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/popular-collections.js",["1441","1442","1443","1444","1445"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/filter-search/filtersearch.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/create-nft/components/upload.js",["1446","1447","1448"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/owncollection/OwnCollection.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/buy-sell/Buysell.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/work/work.js",["1449","1450","1451"],"import React, { Component } from \"react\";\r\nimport WalletIcon from \"../../assets/images/setup-wallet-icon-white.svg\";\r\nimport CollectionIcon from \"../../assets/images/collection-icon-white.svg\";\r\nimport AddNftIcon from \"../../assets/images/add-nft-icon-white.svg\";\r\nimport SaleIcon from \"../../assets/images/sale-icon-white.svg\";\r\nimport axios from \"axios\";\r\nimport { init } from \"aos\";\r\n\r\n// const BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json/work\";\r\nconst BASE_URL = \"../../json-server/db.json/work\";\r\nconst initData = {\r\n  preHeading: \"How It Works\",\r\n  heading: \"Create and sell your NFTs\",\r\n  workData: [\r\n    {\r\n      id: 1,\r\n      icon: \"icons icon-wallet text-effect\",\r\n      img: WalletIcon,\r\n      title: \"Set up your wallet\",\r\n      text: \"Once you've set up your Celo or BSC Metamask wallet, connect to ARI NFT Marketplace by Signing In and clicking Login.\",\r\n    },\r\n    {\r\n      id: 2,\r\n      icon: \"icons icon-grid text-effect\",\r\n      img: CollectionIcon,\r\n      title: \"Create your collection\",\r\n      text: \"Click Create and set up your collection. Add social links, a description, profile & banner images, and set a secondary sales fee.\",\r\n    },\r\n    {\r\n      id: 3,\r\n      icon: \"icons icon-drawer text-effect\",\r\n      img: AddNftIcon,\r\n      title: \"Add your NFTs\",\r\n      text: \"Upload your work (image, video, audio, or 3D art), add a title and description, and customize your NFTs with properties, stats, and unlockable content.\",\r\n    },\r\n    {\r\n      id: 4,\r\n      icon: \"icons icon-bag text-effect\",\r\n      img: SaleIcon,\r\n      title: \"List them for sale\",\r\n      text: \"Choose between auctions, fixed-price listings, and declining-price listings. You choose how you want to sell your NFTs!\",\r\n    },\r\n  ],\r\n};\r\n// console.log('base url',BASE_URL)\r\nclass Work extends Component {\r\n  state = {\r\n    data: {},\r\n    workData: [],\r\n  };\r\n  componentDidMount() {\r\n    this.setState({\r\n      data: initData,\r\n      workData: initData.workData,\r\n    });\r\n    // axios.get(`${BASE_URL}`)\r\n    //     .then(res => {\r\n    //         this.setState({\r\n    //             data: res.data,\r\n    //             workData: res.data.workData\r\n    //         })\r\n    //         console.log(this.state.data)\r\n    //     })\r\n    // .catch(err => console.log(err))\r\n  }\r\n  render() {\r\n    return (\r\n      <section className=\"work-area padding-wrapper\">\r\n        <div className=\"container\">\r\n          <div className=\"row\">\r\n            <div className=\"col-12\">\r\n              {/* Intro */}\r\n              <div className=\"intro mb-4\">\r\n                <div className=\"intro-content\">\r\n                  <span>{this.state.data.preHeading}</span>\r\n                  <h3 className=\"mb-0\">{this.state.data.heading}</h3>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row items mt-3 mt-lg-5\">\r\n            {this.state.workData.map((item, idx) => {\r\n              return (\r\n                <div\r\n                  key={`wd_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                >\r\n                  {/* Single Work */}\r\n                  <div className=\"single-work\">\r\n                    {/* <i className={`${item.icon} mb-5`} /> */}\r\n                    <img src={item.img} alt=\"icon\" className=\"mb-3\" />\r\n                    <h4 className=\"mb-3\">{item.title}</h4>\r\n                    <p>{item.text}</p>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })}\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n}\r\n\r\nexport default Work;\r\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/faq/faq.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/offers/offers.action.js",["1452"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice, acceptNftOffer} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body,tokenId,price) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            acceptNftOffer(body);\n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/sell-nft/SellNFT.js",["1453","1454","1455","1456","1457","1458","1459","1460","1461","1462","1463","1464","1465","1466","1467","1468"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./SellNFT.css\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport PriceIcon from \"../../assets/images/priceIcon.svg\";\nimport DollarIcon from \"../../assets/images/dollarIcon.svg\";\nimport FeeIcon from \"../../assets/images/feeIcon.svg\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFT, upsertNFT } from \"../nfts/nfts.action\";\n\nconst { currencies, dateRangeInitialSettings, serviceFee } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  listingSchedule: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  // if user includes reserve price\n  reservePrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n};\n\nconst SellNFT = (props) => {\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [activeBidBtn, setActiveBidBtn] = useState(false);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nft, setNft] = useState(null);\n  const [loader, setLoader] = useState(true); // NFT loader\n  const [reserveBuyer, setReserveBuyer] = useState(false);\n  const [reservePrice, setReservePrice] = useState(false);\n  const [tokensData, setTokensData] = useState([]);\n  const location = useLocation();\n  console.log(location, \"location\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    const { itemId } = props.match.params;\n    // if (itemId) props.getNFT(window.atob(itemId));\n    // else props.history.push(\"/explore-all\");\n    getTokens();\n  }, []);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNft(nft);\n      setLoader(false);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const { nft } = props.nft.nftsData;\n      // const pathname = nft.sellingMethod === 1 ? '/explore-all' : '/auctions'\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n\n  // when an error is received\n  useEffect(() => {\n    setLoader(false);\n  }, [props.error]);\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) data = fixedPriceConfig;\n    else data = timedAuctionConfig;\n\n    const keys = name.split(\".\"); // fixedPriceConfig, price, currency\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) setFixedPriceConfig({ ...data });\n    else setTimedAuctionConfig({ ...data });\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n  const submit = () => {\n    let payload='';\n    console.log(sellingMethod,\"sellingMethod\")\n    if(sellingMethod===2){\n\n      payload = {\n       _id: location.state._id,\n       sellingMethod,\n       sellingConfig:JSON.stringify(timedAuctionConfig),\n     };\n   \n    }\n    else {\n      payload = {\n        _id: location.state._id,\n        sellingMethod, \n        sellingConfig:JSON.stringify(fixedPriceConfig),\n      };\n      // console.log(payload,\"payload\")\n      \n\n    }\n\n    //  return  \" \"\n\n    let test = new Date(timedAuctionConfig.duration.endDate).getTime();\n    let time = timedAuctionConfig.duration.endTime;\n\n    var r = Number(time.split(\":\")[0]) * 60 + Number(time.split(\":\")[1]) * 1000;\n    //\n    const timeInMiliSeconds = r + test;\n\n    // console.log('yoken data', tokensData)\n    // const nftToken=tokensData.data.find((item)=>item?.nftId===nft?._id)\n\n    //  if(nftToken){\n    //   sellingMethod==1?SellOnFixedPrice(nftToken?.nftToken,fixedPriceConfig.price.amount):openNFTForBidding(nftToken.nftToken,timeInMiliSeconds)\n\n    setLoader(true);\n\n    var formData = new FormData();\n    console.log(payload, \"payload\");\n    for (const key in payload) formData.append(key, payload[key]);\n\n    props.upsertNFT(\"edit\", formData, \"PUT\");\n    //  }\n    //  else {\n    //   toast.error(\"there was an issue while creating nft, please try later\")\n    //  }\n  };\n\n  const getTokens = () => {\n    const url = process.env.REACT_APP_BASE_URL + \"nftTokens/tokens\";\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        setTokensData(data);\n      })\n      .catch((error) => {\n        console.log(error, \"error in catch blcok\");\n      });\n  };\n  return (\n    <>\n      <NavbarMain />\n      <section className=\"padding-wrapper nft-detail\">\n        <div className=\"container\">\n          <div className=\"row g-3\">\n            <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n              <div className=\"row\">\n                <div className=\"col-12 order-2 order-md-1\">\n                  <div className=\"intro mb-5\">\n                    <div className=\"intro-content\">\n                      <span>SellNFTs</span>\n                      <h3 className=\"mb-0\">List of bundles for sale</h3>\n                    </div>\n                  </div>\n                  <div className=\"sale-btn-container mt-5 mb-4\">\n                    <button\n                      className={` ${\n                        activeBtn === 0\n                          ? \"sell-btn-active\"\n                          : \"sell-btn-not-active\"\n                      } me-3 `}\n                      onClick={() => {\n                        setActiveBtn(0);\n                        setSellingMethod(1);\n                      }}\n                    >\n                      <img\n                        src={DollarIcon}\n                        alt=\"fixedPrize\"\n                        className=\"me-1 me-sm-2\"\n                      />\n                      Fixed Prize\n                    </button>\n                    <button\n                      className={` ${\n                        activeBtn === 1\n                          ? \"sell-btn-active\"\n                          : \"sell-btn-not-active\"\n                      } `}\n                      onClick={() => {\n                        setActiveBtn(1);\n                        setSellingMethod(2);\n                      }}\n                    >\n                      <img src={ClockIcon} alt=\"timeAuction\" className=\"me-2\" />\n                      Timed Auction\n                    </button>\n                  </div>\n                  <div className=\"nftDetail-accordion\">\n                    <div\n                      className=\"accordion accordion-flush \"\n                      id=\"accordionFlushExample\"\n                    >\n                      {activeBtn === 0 ? (\n                        <>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseOne\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingOne\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-price-container mx-auto\">\n                                  <div className=\"sell-price-inp d-flex align-items-center\">\n                                    <div className=\"sell-price-currency text-center\">\n                                      <span> ETH </span>\n                                    </div>\n                                    <input\n                                      type=\"text\"\n                                      name=\"fixedPriceConfig.price.amount\"\n                                      placeholder=\"Amount\"\n                                      style={{\n                                        borderRadius: \"4px\",\n                                      }}\n                                      onChange={(e) => onChange(e)}\n                                      onKeyDown={(e) =>\n                                        decimalNumberValidator(e)\n                                      }\n                                      defaultValue={\n                                        fixedPriceConfig.price.amount\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingTwo\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Schedule Listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"fixedPriceConfig.listingSchedule\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </>\n                      ) : (\n                        <>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Bid option\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-bid-opt-container mx-auto\">\n                                  <button\n                                    className={`${\n                                      activeBidBtn ? \"sell-bid-active\" : \"\"\n                                    } sell-bid-opt-btn`}\n                                    onClick={() =>\n                                      setActiveBidBtn(!activeBidBtn)\n                                    }\n                                  >\n                                    Sell To The Highest Bidder\n                                  </button>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingFour\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseFour\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseFour\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseFour\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingFour\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-price-container mx-auto\">\n                                  <div className=\"sell-price-inp d-flex align-items-center\">\n                                    <div className=\"sell-price-currency text-center\">\n                                      <span> ETH </span>\n                                    </div>\n                                    <input\n                                      type=\"text\"\n                                      name=\"timedAuctionConfig.startPrice.amount\"\n                                      placeholder=\"Amount\"\n                                      style={{\n                                        borderRadius: \"4px\",\n                                      }}\n                                      onChange={(e) => onChange(e)}\n                                      onKeyDown={(e) =>\n                                        decimalNumberValidator(e)\n                                      }\n                                      defaultValue={\n                                        fixedPriceConfig.price.amount\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSix\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSix\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSix\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Duration\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSix\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSix\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"timedAuctionConfig.duration\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"timedAuctionConfig.duration.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"timedAuctionConfig.duration.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"row\">\n                    <div className=\"col-10 col-sm-6 col-md-8 col-lg-6  col-xl-4\">\n                      <div className=\"sell-fee-container\">\n                        <div className=\"sell-fee-title d-flex align-items-center mb-2\">\n                          <img src={FeeIcon} alt=\"feeIcon\" className=\"me-2\" />\n                          <h6>Fees</h6>\n                        </div>\n                        <div className=\"sell-fee-content d-flex align-items-center justify-content-between mb-1\">\n                          <p>Service Fee</p>\n                          <p>2.5 %</p>\n                        </div>\n                        <div className=\"sell-fee-content d-flex align-items-center justify-content-between\">\n                          <p>Creator Royalty</p>\n                          <p>3 %</p>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-12 text-center mt-5\">\n                      <button\n                        className=\"sell-btn-active px-5\"\n                        onClick={() => submit()}\n                      >\n                        {\" \"}\n                        Complete Listing{\" \"}\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n              <Card className=\"auction-card detail-card\">\n                <div className=\"auction-img-wrapper\">\n                  <Card.Img\n                    variant=\"top\"\n                    src={location.state.image}\n                    alt=\"AuctionTopImg\"\n                  />\n                </div>\n                <Card.Body>\n                  <div>\n                    <span>Current price</span>\n                    <h3>\n                      {location.state.currentPrice}\n                      <span>($2.28)</span>\n                    </h3>\n                  </div>\n                  <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                    <div className=\"d-flex align-items-center\">\n                      <img src={ClockIcon} alt=\"clock-icon\" className=\"me-1\" />\n                      <span>Sale ends March 8, 2022 at 7:40am PKT </span>\n                    </div>\n                    <div className=\"likes-container d-flex align-items-center\">\n                      <span>{}</span>\n                      <img src={HeartIcon} alt=\"heart-icon\" className=\"ms-1\" />\n                    </div>\n                  </div>\n                </Card.Body>\n              </Card>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n})(SellNFT);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/test-video-card/videoCard.js",["1469"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/auctions-cards/AuctionsCards.js",["1470","1471","1472","1473","1474"],"import React, { useEffect, useState } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.svg\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../config/config\";\n\nimport { connect } from \"react-redux\";\n\nimport \"./AuctionsCard.css\";\nimport { propTypes } from \"react-recaptcha\";\n\nconst AuctionsCards = (props) => {\n  const { countDownRenderer } = ENV;\n  const history = useHistory();\n  // console.log(auctions,\"auctions123\")\n  return (\n    <Card\n      className=\"auction-card mx-2\"\n      onClick={() => history.push(`nftdetail/${props.id}`)}\n    >\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={props.image} alt=\"AuctionTopImg\" />\n        <div className=\"auction-countdown mb-3\">\n          <Countdown date={props.endDate} renderer={countDownRenderer} />\n        </div>\n      </div>\n      <Card.Body>\n        <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n          <div className=\"auction-card-avatar d-flex align-items-center\">\n            <img src={AvatarImg} alt=\"AvatarImg\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <span className=\"ms-4\">9+ Place Bit</span>\n          </div>\n\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <Card.Title>{props.name}</Card.Title>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>\n              {\"Owned by \"}\n              {props.ownerName}\n            </p>\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state in nfts\"),\n  ({});\n\nexport default connect(mapStateToProps, {})(AuctionsCards);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/hero-cards/HeroCards.js",["1475"],"import React from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.png\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport \"./HeroCards.css\";\n\nconst HeroCards = () => {\n  return (\n    <Card className=\"auction-card hero-card mx-2\">\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n        {/* <div className=\"auction-countdown mb-3\">\n          <Countdown date=\"2022/1/26 13:10:12\" renderer={countDownRenderer} />\n        </div> */}\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title>Music</Card.Title>\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <div className=\"auction-card-avatar d-flex align-items-center mb-4\">\n          <img src={AvatarImg} alt=\"AvatarImg\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <span className=\"ms-4\">9+ People Place Bit</span>\n        </div>\n\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owend by Jecica</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default HeroCards;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/listing-cards/ListingCards.js",["1476","1477"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile &&\n          <div className=\"options-icon like-icon text-white\">\n          \n            { validateIfLiked(likedNfts, id) ? (\n              <div className=\"heart-filled-container d-flex align-items-end\">\n                <AiFillHeart\n                  className=\"heart-fill-icon \"\n                  onClick={() => {\n                    handleLikesTogleApi(id, \"dislike\");\n                    setToggle(!toggle);\n                  }}\n                />{\" \"}\n                <p> {likesCount ? likesCount : 0} </p>\n              </div>\n            ) : (\n              <img\n                src={HeartIcon}\n                alt=\"OptionsIcon\"\n                onClick={() => {\n                  handleLikesTogleApi(id, \"like\");\n                  setToggle(!toggle);\n                }}\n              />\n            )}\n          </div>\n          }\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\">\n          <p>{ownerId===ENV.getUserKeys(\"_id\")._id?\"View\":\"Buy Now\"}</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/navbar-main/NavbarMain.js",["1478","1479","1480","1481"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections-cards/CollectionsCard.js",["1482","1483","1484","1485","1486","1487","1488"],"import React, { useEffect } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport Subimg1 from \"../../assets/images/cl-cr-subimg1.png\";\nimport Subimg2 from \"../../assets/images/cl-cr-subimg2.png\";\nimport Subimg3 from \"../../assets/images/cl-cr-subimg3.png\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport \"./CollectionsCard.css\";\n\nconst CollectionsCard = ({\n  CardImg,\n  Subimg1,\n  Subimg2,\n  Subimg3,\n  name,\n  id,\n  collection,\n  userName,\n  NFTCount,\n  profileImage,\n}) => {\n  // const { name, image } = category;\n  const history = useHistory();\n\n  return (\n    <Card\n      className=\"collection-cards-container\"\n      onClick={() => {\n        history.push({\n          pathname: `/collection/detailPage/${id}`,\n          state: collection,\n        });\n      }}\n    >\n      <div className=\"row\">\n        <div className=\"col-12\">\n          <div className=\"row g-3\">\n            <div className=\"col-4 collection-subImg1\">\n              <img src={Subimg1} alt=\"subImg\" />\n            </div>\n            <div className=\"col-4 collection-subImg2\">\n              <img src={Subimg2} alt=\"subImg\" />\n            </div>\n            <div className=\"col-4 collection-subImg3\">\n              <img src={Subimg3} alt=\"subImg\" />\n            </div>\n            <div className=\"col-12 collection-mainImg\">\n              <img src={CardImg} alt=\"card-img\" />\n            </div>\n          </div>\n          <Card.Body>\n            <Card.Title>{name}</Card.Title>\n            <Card.Text>\n              {NFTCount}\n              {\" items\"}\n            </Card.Text>\n            <div className=\"d-flex align-items-center justify-content-between collection-card-footer\">\n              <div className=\"collection-footer-left d-flex align-items-center\">\n                {profileImage && (\n                  <img src={profileImage} alt=\"avatar-img\" className=\"me-2\" />\n                )}\n                <span>{userName}</span>\n              </div>\n              {/* <div className=\"collection-footer-right d-flex align-items-center\">\n                <img src={HeartIcon} alt=\"like-icon\" className=\"me-1\" onClick={()=>handleLikesTogle(id)} />\n                <span>212k</span>\n              </div> */}\n            </div>\n          </Card.Body>\n        </div>\n      </div>\n    </Card>\n  );\n};\n\nexport default CollectionsCard;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/popular-collections-list/popular-collections-list.js",["1489","1490","1491","1492"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/top-seller/topsellerlist.js",["1493","1494","1495"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/auctions/home-auction-list.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/index.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/App.js",["1496","1497"],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/sr