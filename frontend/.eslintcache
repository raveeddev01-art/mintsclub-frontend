":"186"},{"filePath":"391","messages":"392","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"393","messages":"394","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"397","messages":"398","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"399","usedDeprecatedRules":"400"},{"filePath":"401","messages":"402","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"403","messages":"404","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"186"},{"filePath":"405","messages":"406","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"407","usedDeprecatedRules":"186"},{"filePath":"408","messages":"409","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/index.js",[],["410","411"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/store.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/App.js",["412","413","414"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\n// import 'swiper/swiper-bundle.css';\n\nconst App = React.memo((props) => {\n  // const [walletAddress, setWalletAddress] = useState(\"\");\n  let walletAddress = false;\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const history = useHistory();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  // ///set Interval\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address) {\n        toast.info(\"Please login with new address\");\n        walletAddress = address;\n        // setWalletAddress(address)\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n      // setWalletAddress(address);\n    }\n    // }\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={\n                    ENV.getUserKeys(\"_id\")._id || route.path === \"/login\"\n                      ? true\n                      : false\n                  }\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nexport default App;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/privateRoute.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/routes.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/index.js",["415","416"],"import { combineReducers } from \"redux\";\nimport homeReducer from \"./../components/home/home.reducer\";\nimport mintsReducer from \"../redux/reducer/reducer\";\nimport auctionReducer from \"./../components/auctions/auctions.reducer\";\nimport nftReducer from \"./../components/nfts/nfts.reducer\";\nimport userReducer from \"./../components/user/user.reducer\";\nimport walletReducer from \"./../components/wallet/wallet.reducer\";\nimport categoryReducer from \"./../components/categories/categories.reducer\";\nimport collectionReducer from \"./../components/collections/collections.reducer\";\nimport errorReducer from \"./shared/error/error.reducer\";\nimport settingsReducer from \"../components/footer/footer.reducer\";\n\nimport offersReducer from \"../components/offers/offers.reducer\";\nimport bidsReducer from \"../components/bids/bids.reducer\";\n\nimport exploreAllReducer from \"../components/explore/explore.reducer\";\nimport createNftReducer from \"../components/create-nft/create-nft-reducer\";\n\nexport default combineReducers({\n  home: homeReducer,\n  dashboard: mintsReducer,\n  auction: auctionReducer,\n  nft: nftReducer,\n  user: userReducer,\n  wallet: walletReducer,\n  category: categoryReducer,\n  collection: collectionReducer,\n  error: errorReducer,\n\n  offer: offersReducer,\n  bid: bidsReducer,\n\n  explore: exploreAllReducer,\n});\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/utils/web3.js",["417","418","419"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/config/config.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/home/home.reducer.js",["420","421"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["422"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/home/home.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/create-nft-reducer.js",["423"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["424"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/signup/signup.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.js",["425","426","427","428","429","430","431","432"],"import React, { useState, useEffect } from \"react\";\nimport { Redirect, useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"../wallet/wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  getCollections,\n  beforeCategory,\n  beforeCollection,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport { login, signup } from \"../user/user.action\";\nimport \"./wallet.css\";\n\nconst Wallet = (props) => {\n  const history = useHistory();\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [disabled,setDisabled]=useState(false)\n\n  const connectMetamaskCall = async () => {\n    setDisabled(true)\n    let connectedAddress = await connectMetamaskCopy();\n    if (connectedAddress){\n      setDisabled(false)\n    }\n    setConnectedAddress(connectedAddress);\n    setWalletAddress(connectedAddress);\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      console.log(\"errors\", props.error);\n\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setDisabled(false)\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    console.log(props.collection.getAuth, \"props.collection.getAuth\");\n    if (props.collection.getAuth === true) {\n      let collections = props.collection.collections;\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n\n      // let myCollections = collections.filter((el) => el.userId === userId);\n\n      // if (myCollections && myCollections.length > 0) {\n      props.beforeCollection();\n      //   history.push(\"/\");\n      // } else {\n      // }\n      history.push(\"/\");\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    \n    e.preventDefault();\n    setDisabled(true)\n    try {\n      if (validator.isEmail(email)) {\n        let sign = await signRequest();\n        let payload = {\n          address: connectedAddress,\n          // password: sign,\n          email: email,\n          username: username,\n          isApproved: false,\n        };\n        // console.log(payload, \"payload\");\n        props.signup(payload);\n      } else {\n        setErrorMessage(\"please enter valid email\");\n      }\n    } catch (err) {\n      toast.error(err.message);\n      setDisabled(false)\n    }\n  };\n\n  const login = async () => {\n    try {\n      setDisabled(true)\n      let sign = await signRequest();\n      let payload = {\n        address: connectedAddress,\n      };\n      \n      props.login(payload);\n    } catch (err) {\n      setDisabled(false)\n      toast.error(err.message);\n    }\n  };\n\n  const switchSignup = () => {\n    setShowSignUpComponent(true);\n  };\n\n  // if (props.user.userAuth) {\n  //     console.log(\"@@@@Collection-----@\", collections);\n  //     if(collections && collections.length>){\n  //         console.log(\"In Upper\")\n  //         return <Redirect to=\"/create\" />\n  //     }\n  //     else {\n  //         console.log(\"In Down\");\n  //         return <Redirect to=\"/collection/create\" />\n  //     }\n  // }\n\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div className=\"container\">\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Sign In</span>\n                  <h3 className=\"mt-3 mb-0\">SignIn to your account</h3>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                <div className=\"card single-wallet sign-in-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <h4 className=\"mb-0\">Address</h4>\n                    <p id=\"connected-address mt-3\">{connectedAddress}</p>\n                    {errorMessage && (\n                      <p className=\"text-gray\">{errorMessage}</p>\n                    )}\n                    {!showSignUp && (\n                      <>\n                        <button\n                          className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4\"\n                          type=\"button\"\n                          disabled={disabled}\n                          onClick={() => login()}\n                        >\n                          Sign In\n                        </button>\n                      </>\n                    )}\n                  \n                    {showSignUp && (\n                      <button\n                        className=\"btn btn-linear-gradient btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                        type=\"button\"\n                        onClick={() => switchSignup()}\n                      >\n                        Would you like to Signup?\n                      </button>\n                    )}\n                      {/* <div className=\"mt-3\">\n                      <a\n                        className=\"text-white back-link \"\n                        onClick={() => {\n                          setConnectedAddress(\"\");\n                          setWalletAddress(\"\");\n                        }}\n                      >\n                        Back\n                      </a>\n                    </div> */}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              {/* Intro */}\n              <div className=\"intro text-center\">\n                <span>SIGNUP</span>\n                <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                <p className=\"text-gray\">Create the account with the address</p>\n              </div>\n              {/* Item Form */}\n              <form\n                className=\"item-form card no-hover signup-card\"\n                onSubmit={(e) => signup(e)}\n              >\n                <div className=\"row\">\n                  {errorMessage && (\n                    <p className=\"text-center text-gray\">{errorMessage}</p>\n                  )}\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"address\"\n                        placeholder=\"Address\"\n                        required=\"required\"\n                        disabled={true}\n                        value={connectedAddress}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"email\"\n                        className=\"form-control sign-up-input\"\n                        name=\"email\"\n                        placeholder=\"Enter your Email\"\n                        required=\"required\"\n                        defaultValue={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"username\"\n                        placeholder=\"Enter your Username\"\n                        required=\"required\"\n                        defaultValue={username}\n                        onChange={(e) => setUsername(e.target.value)}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3 text-center\">\n                      <div className=\"form-check form-check-inline\">\n                        <input\n                          className=\"form-check-input\"\n                          type=\"radio\"\n                          name=\"inlineRadioOptions\"\n                          id=\"inlineRadio1\"\n                          defaultValue=\"option1\"\n                          autoComplete=\"off\"\n                        />\n                        <label\n                          className=\"form-check-label text-center text-gray\"\n                          htmlFor=\"inlineRadio1\"\n                        >\n                          I agree to{\" \"}\n                          <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"text-center\">\n                      <button\n                        className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4  text-white \"\n                        type=\"submit\"\n                        disabled={disabled}\n                      >\n                        Sign Up\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        ) : (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Wallet Connect</span>\n                  <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                  <p className=\"text-white mt-3\">\n                    Please select the wallet you want to connect to.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              {errorMessage && <p className=\"text-white\">{errorMessage}</p>}\n              <div\n                className=\"col-12 col-md-6 col-lg-4 item\"\n                onClick={() => connectMetamaskCall()}\n              >\n                {/* Single Wallet */}\n                <div className=\"card single-wallet whole-hover wallet-metamask-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <img\n                      className=\"avatar-lg\"\n                      src=\"/img/metamask2.png\"\n                      alt=\"\"\n                    />\n                    <h4 className=\"mb-0 my-3\">MetaMask</h4>\n                    <p>\n                      A browser extension with great flexibility. The web's most\n                      popular wallet\n                    </p>\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n  beforeCollection,\n})(Wallet);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["433","434","435","436","437","438","439","440","441","442","443"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["444","445","446","447","448","449","450","451","452","453","454","455","456","457","458","459","460","461","462"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["463","464","465","466","467","468","469","470","471","472","473","474","475","476","477"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["478"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["479","480","481","482","483","484","485"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["486","487","488","489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["505","506","507","508","509","510","511","512","513","514","515","516","517","518","519","520","521","522"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["523","524","525","526","527","528"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/reducer/reducer.js",["529"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user/user.reducer.js",["530"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.reducer.js",["531"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["532"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["533"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["534"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["535"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["536","537","538","539","540","541"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\n\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [popular, setpopular] = useState([]);\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"all\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getPopularCollections(null, 1);\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      const pagination = props.popularCollections.pagination;\n\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.finalCollectionListing) {\n        let finalCollectionListing = finalCollectionListing.filter(\n          (item) => item.userId === userId\n        );\n        setpopular(finalCollectionListing);\n      } else {\n        if (finalCollectionListing === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setpopular(finalCollectionListing);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.getPopularAuth]);\n\n  const getPopularCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getPopularCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getPopularCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getPopularCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getPopularCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Collections\"} title2={\"PopularCollections\"} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Most Popular</span>\n                    <h3 className=\"mb-0\">Popular Collections</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-lg-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : popular && popular.length > 0 ? (\n                popular.map((item) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={item.featuredImg}\n                        Subimg1={handleImage(item, 0)}\n                        Subimg2={handleImage(item, 1)}\n                        Subimg3={handleImage(item, 2)}\n                        name={item.name}\n                        id={item._id}\n                        collection={item}\n                        userName={item.username[0]}\n                        NFTCount={item.totalNfts}\n                        profileImage={item.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No popular collections Found\n                </p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    popular?.length === 10 &&\n                    pagination.totalRecords > popular.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforePopularCollection,\n    getPopularCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/explore-collections.js",["542","543","544","545"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\n\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport \"./explore-collections.css\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"./collections.actions\";\nimport { Images } from \"../../assets/assets\";\n\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { beforeCategory, getCategories } from \"./collections.actions\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      // console.log('collections', collections.nftDetail);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Explore\"} title2={\"Explore All\"} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Collections</span>\n                    <h3 className=\"mb-0\">Explore all</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : \"\"\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    collections?.length === 10 &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/create-nft.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["546","547","548","549","550","551","552","553","554","555","556","557","558","559","560","561","562","563","564","565","566"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["567","568","569"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["570"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout2/layout2.jsx",["571","572"],"import React, { Component } from \"react\";\nimport Particles from \"react-tsparticles\";\nimport NavbarMain from \"../../components/navbar-main/NavbarMain\";\nimport Footer from \"../../components/footer/footer\";\n// import Scrollup from '../../components/scroll-up/sroll-up';\n\nclass Layout2 extends Component {\n  render() {\n    const particlesData = {\n      fullScreen: {\n        zIndex: -5,\n      },\n      color: {\n        value: \"#5666fe\",\n      },\n      twinkle: {\n        lines: {\n          enable: true,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n        particles: {\n          enable: false,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n      },\n      wobble: {\n        distance: 5,\n        enable: false,\n        speed: 2,\n      },\n      particles: {\n        number: {\n          value: 25,\n          density: {\n            enable: true,\n            value_area: 800,\n          },\n        },\n        shape: {\n          type: \"circle\",\n          stroke: {\n            width: 0,\n            color: \"#5666fe\",\n          },\n          polygon: {\n            nb_sides: 5,\n          },\n          image: {\n            src: \"img/github.svg\",\n            width: 100,\n            height: 100,\n          },\n        },\n        opacity: {\n          value: 0.5,\n          random: false,\n          anim: {\n            enable: false,\n            speed: 1,\n            opacity_min: 0.1,\n            sync: false,\n          },\n        },\n        size: {\n          value: 3,\n          random: true,\n          anim: {\n            enable: false,\n            speed: 50,\n            size_min: 0.1,\n            sync: false,\n          },\n        },\n        line_linked: {\n          enable: true,\n          distance: 150,\n          color: \"#5666fe\",\n          opacity: 0.4,\n          width: 1,\n        },\n        move: {\n          enable: true,\n          speed: 1,\n          direction: \"none\",\n          random: false,\n          straight: false,\n          out_mode: \"out\",\n          bounce: false,\n          attract: {\n            enable: false,\n            rotateX: 600,\n            rotateY: 1200,\n          },\n        },\n      },\n      interactivity: {\n        detect_on: \"canvas\",\n        events: {\n          onhover: {\n            enable: true,\n            mode: \"grab\",\n          },\n          onclick: {\n            enable: true,\n            mode: \"push\",\n          },\n          resize: true,\n        },\n        modes: {\n          grab: {\n            distance: 140,\n            line_linked: {\n              opacity: 1,\n            },\n          },\n          bubble: {\n            distance: 400,\n            size: 40,\n            duration: 2,\n            opacity: 8,\n            speed: 2,\n          },\n          repulse: {\n            distance: 200,\n            duration: 0.4,\n          },\n          push: {\n            particles_nb: 4,\n          },\n          remove: {\n            particles_nb: 2,\n          },\n        },\n      },\n      retina_detect: true,\n      zLayers: 1,\n    };\n    return (\n      <>\n        {/* <NavbarMain /> */}\n        <div className=\"main\">\n          <Particles id=\"tsparticles\" options={{ ...particlesData }} />\n          {this.props.children}\n        </div>\n        {/* <Footer /> */}\n      </>\n    );\n  }\n}\n\nexport default Layout2;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/types.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.js",["573","574","575","576","577","578"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div className=\"input-group notify-form\">\n                  <div className=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collections.actions.js",["579","580","581"],"import { toast } from 'react-toastify';\nimport {\n  GET_ERRORS,\n  BEFORE_COLLECTION,\n  SET_AUTH_STATE,\n  GET_COLLECTION,\n  GET_COLLECTIONS,\n  UPSERT_COLLECTION,\n  DELETE_COLLECTION,\n  ALL_COLLECTIONS,\n  BEFORE_CATEGORY,\n  GET_CATEGORIES,\n  COLLECTION_CATEGORES,\n  MY_COLLECTIONS,\n  GET_POPULAR_COLLECTIONS,\n  BEFORE_POPULAR_COLLECTION,\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport { CgData } from 'react-icons/cg';\n\nexport const beforeCollection = () => {\n  return {\n    type: BEFORE_COLLECTION,\n  };\n};\n\nexport const getCollection = (collectionId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}collection/get/${collectionId}`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        dispatch({\n          type: GET_COLLECTION,\n          payload: data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getCollections =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs) url += `?${qs}`;\n    //console.log(url, 'url sending');\n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        'content-type': 'application/json',\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        //console.log(data, 'collections api response');\n        if (data.success) {\n          dispatch({\n            type: GET_COLLECTIONS,\n            payload: data.data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\nexport const myCollections = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  let url = `${ENV.url}collection/myCollectionList`;\n\n  if (userId) url += `?userId=${userId}`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      console.log(data,\"res of collection getting\")\n      if (data.success) {\n        dispatch({\n          type: MY_COLLECTIONS,\n          payload: data.data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data.message,\n        });\n      }\n    })\n    .catch((error) => {\n      console.lof(error,\"erro while getting collections\")\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const upsertCollection =\n  (apiURL, body, method = 'POST') =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_COLLECTION,\n            payload: data,\n          });\n        } else {         \n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        console.log(error.response.data)\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const deleteCollection = (collectionId) => (dispatch) => {\n  dispatch(emptyError());\n  let url = `${ENV.url}collection/delete/${collectionId}`;\n\n  fetch(url, {\n    method: 'DELETE',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        toast.success(data.message);\n        dispatch({\n          type: DELETE_COLLECTION,\n          payload: data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const setAuthState = () => (dispatch) => {\n  dispatch({\n    type: SET_AUTH_STATE,\n  });\n};\nexport const beforeCategory = () => {\n  return {\n    type: BEFORE_CATEGORY,\n  };\n};\nexport const getCategories = () => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}category/list`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: COLLECTION_CATEGORES,\n          payload: data.categories,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      //console.log(error, 'error==>');\n\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const toggleLikeDislike = (body) => (dispatch) => {\n  let data = JSON.stringify(body);\n  const url = `${ENV.url}collectionLikes/likeDislike`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    data,\n  })\n    .then((res) => res.json())\n    .then((data) => {})\n    .catch((error) => {\n      //console.log(error, 'error likes');\n    });\n};\n\nexport const beforePopularCollection = () => {\n  return {\n    type: BEFORE_POPULAR_COLLECTION,\n  };\n};\n\nexport const getPopularCollections =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}collection/popular`;\n\n    if (qs) url += `?${qs}`;\n    //console.log(url, 'url sending');\n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        'content-type': 'application/json',\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        //console.log(data, 'popular collections api response');\n        if (data.success) {\n          dispatch({\n            type: GET_POPULAR_COLLECTIONS,\n            payload: data.data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user/user.action.js",["582","583"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n    console.log(data,\"data\")\n      if (data.status) {\n        // ENV.encryptUserData(data.data);\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n   \n       \n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["584","585","586","587","588","589","590","591"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["592","593"],"import React, { useState } from \"react\";\nimport { Link, useHistory, useLocation } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [activeTab, setActiveTab] = React.useState(null);\n  const [searchactive, setSearchActive] = useState(false);\n  const [searchValue,setSearchValue]=useState('')\n  const history = useHistory();\n  const location = useLocation();\n\n  const handleChange = (e) => {\n    setSearchValue(e.target.value)\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword=()=>{\n    if(searchValue!=='' && searchValue.length>=3){\n\n      history.push({\n        pathname:\"/explore/allNFT\",\n        state:searchValue\n      })\n    }\n\n  }\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n   \n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"dark\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <Navbar.Brand to=\"/\" href=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </Navbar.Brand>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav\n              className=\"mx-xl-auto\"\n              defaultActiveKey={`${location.pathname}`}\n            >\n              <Nav.Link to=\"/\" href=\"/\" className=\"nav-main-link\">\n                Home\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                active={activeTab === 1}\n                defaultactivekey={activeTab}\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item\n                  to=\"/explore/exploreAll\"\n                  href=\"/explore/exploreAll\"\n                  active={activeTab === 1}\n                  eventKey={1}\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/explore/exploreAll\"\n                      ? \"active-item\"\n                      : \"\"\n                  }`}\n                  onClick={() => {\n                    setActiveTab(1);\n                  }}\n                >\n                  Explore All\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/explore/allNFT\"\n                  href=\"/explore/allNFT\"\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/explore/allNFT\" ? \"active-item\" : \"\"\n                  }`}\n                  eventKey={2}\n                  active={activeTab === 2}\n                  onClick={() => {\n                    setActiveTab(2);\n                  }}\n                >\n                  All NFT\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                active={activeTab === 1}\n                defaultactivekey={activeTab}\n                className={`nav-main-link dropdown-bg ${\n                  location.pathname === \"/create\" ? \"active-item\" : \"\"\n                }`}\n              >\n                <NavDropdown.Item\n                  to=\"/create\"\n                  href=\"/create\"\n                  active={activeTab === 1}\n                  eventKey={1}\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/create\" ? \"active-item\" : \"\"\n                  }`}\n                  onClick={() => {\n                    setActiveTab(1);\n                  }}\n                >\n                  Create NFT\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/createcollection\"\n                  href=\"/createcollection\"\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/createcollection\"\n                      ? \"active-item\"\n                      : \"\"\n                  }`}\n                  eventKey={2}\n                  active={activeTab === 2}\n                  onClick={() => {\n                    setActiveTab(2);\n                  }}\n                >\n                  Create Collection\n                </NavDropdown.Item>\n              </NavDropdown>\n\n              {/* <Nav.Link to=\"/create\" href=\"/create\" className=\"nav-main-link\">\n                Create\n              </Nav.Link> */}\n              <Nav.Link\n                to=\"/userprofile\"\n                href=\"/userprofile\"\n                className=\"nav-main-link\"\n              >\n                Profile\n              </Nav.Link>\n           \n             \n             \n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) =>\n                    e.key === \"Enter\" && handleSearchKeyword()\n                  }\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={()=>handleSearchKeyword()}\n                >\n                  <img src={SearchIcon}  alt=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) =>\n                  e.key === \"Enter\" && handleSearchKeyword()\n                }\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={()=>handleSearchKeyword()}\n              >\n                <img src={SearchIcon} alt=\"search-icon\" />\n              </button>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/popular-collections.js",["594","595","596","597","598","599","600","601","602","603"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\n\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n} from \"../collections/collections.actions\";\nimport { connect } from \"react-redux\";\nimport { CollectionImages } from \"../../assets/assets.js\";\nimport { Images } from \"../../assets/assets\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst PopularCollections = (props) => {\n  const [popular, setpopular] = useState([]);\n  const [categories, setCategories] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [popularSettings, settPopularSettings] = useState();\n  const [isActive, setIsActive] = useState(0);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.category.getAuth) {\n      setCategories(props.category.categories);\n    }\n  }, [props.category.getAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n      let popularCollectionsSettings = ENV.popularCollectionsSettings;\n      if (finalCollectionListing.length > 3) {\n        popularCollectionsSettings.infinite = true;\n      } else {\n        popularCollectionsSettings.infinite = false;\n      }\n      settPopularSettings(popularCollectionsSettings);\n      setpopular(finalCollectionListing);\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  const handleCategoryFilter = (desc) => {\n    props.beforePopularCollection();\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getPopularCollections(qs);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-0\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products. We want to be a part of your\n                    smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\n              {categoryId === \"all\" && popular && popular?.length == 0 ? (\n                \"\"\n              ) : (\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      if (id <= 3) {\n                        return (\n                          <button\n                            key={id}\n                            className={`${\n                              id === isActive ? \"home-active-category\" : \"\"\n                            } me-1 me-sm-2`}\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      }\n                    })}\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\n                      to=\"/popular-collections\"\n                    >\n                      View All\n                      <img\n                        src={ViewAllIcon}\n                        alt=\"arrow-left\"\n                        className=\"ms-2 d-none d-sm-none\"\n                      />\n                    </Link>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n          {popular && popular.length && popular.length > 0 ? (\n            <CardSlider\n              settings={ENV.popularCollectionsSettings}\n              data={popular}\n              homeAuction\n            >\n              {popular.map((item, i) => {\n                if (i < 8) {\n                  return (\n                    <CollectionsCard\n                      key={i}\n                      Subimg1={handleImage(item, 0)}\n                      Subimg2={handleImage(item, 1)}\n                      Subimg3={handleImage(item, 2)}\n                      collection={item}\n                      CardImg={item.featuredImg}\n                      name={item.name}\n                      id={item._id}\n                      userName={item.username[0]}\n                      NFTCount={item.totalNfts}\n                      profileImage={item.profileImage[0]}\n                    />\n                  );\n                }\n              })}\n            </CardSlider>\n          ) : (\n            <p className=\"text-center text-white not-found-title mt-5\">\n              No popular collections Found\n            </p>\n          )}\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(mapStateToProps, {\n  beforePopularCollection,\n  beforeCategory,\n  getCategories,\n  getPopularCollections,\n})(PopularCollections);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/hero/hero.js",["604"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                <svg width=\"22px\" height=\"16px\">\r\n                  <path\r\n                    fill-rule=\"evenodd\"\r\n                    fill=\"rgb(255, 255, 255)\"\r\n                    d=\"M10.788,0.151 C10.596,0.153 10.412,0.232 10.279,0.370 C10.145,0.508 10.72,0.694 10.76,0.886 L10.76,3.525 C10.73,3.717 10.148,3.903 10.283,4.40 C10.418,4.177 10.603,4.255 10.795,4.255 C10.988,4.255 11.173,4.177 11.308,4.40 C11.443,3.903 11.518,3.717 11.515,3.525 L11.515,0.886 C11.519,0.691 11.444,0.503 11.307,0.365 C11.170,0.226 10.983,0.149 10.788,0.151 ZM5.53,1.591 C4.878,1.586 4.707,1.646 4.573,1.759 C4.438,1.872 4.350,2.29 4.324,2.203 C4.298,2.376 4.336,2.553 4.430,2.700 L5.630,4.619 C5.725,4.792 5.887,4.919 6.78,4.969 C6.269,5.19 6.472,4.989 6.640,4.884 C6.808,4.780 6.926,4.612 6.966,4.419 C7.6,4.226 6.964,4.24 6.852,3.862 L5.652,1.943 C5.526,1.730 5.300,1.597 5.53,1.591 L5.53,1.591 ZM16.515,1.598 C16.278,1.611 16.61,1.740 15.938,1.943 L14.738,3.862 C14.626,4.24 14.585,4.226 14.625,4.419 C14.665,4.612 14.782,4.780 14.950,4.884 C15.118,4.989 15.321,5.19 15.512,4.969 C15.703,4.919 15.865,4.792 15.960,4.619 L17.160,2.700 C17.254,2.550 17.290,2.372 17.260,2.198 C17.231,2.24 17.139,1.867 17.2,1.756 C16.865,1.646 16.691,1.589 16.515,1.598 L16.515,1.598 ZM8.569,4.964 C8.438,4.978 8.313,5.27 8.209,5.107 L7.377,5.729 L4.670,6.411 L4.655,6.411 C2.79,6.487 0.0,8.608 0.0,11.201 C0.0,13.843 2.156,15.999 4.797,15.999 C5.911,15.999 6.935,15.606 7.751,14.965 C7.757,14.960 7.768,14.962 7.774,14.957 C7.844,14.918 7.908,14.868 7.961,14.808 C8.267,14.532 9.608,14.80 10.795,14.80 C11.982,14.80 13.323,14.532 13.629,14.808 C13.694,14.880 13.773,14.939 13.861,14.980 C14.674,15.611 15.688,15.999 16.792,15.999 C19.433,15.999 21.590,13.843 21.590,11.201 C21.590,8.603 19.503