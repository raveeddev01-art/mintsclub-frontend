\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 11,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 12,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n];\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n  useEffect(() => {\r\n    setSellers(props.user.sellers);\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content\">\r\n                <span>CREATIVE ARTIST</span>\r\n                <h3 className=\"mb-0\">Top Sellers</h3>\r\n              </div>\r\n              {props.viewAll ? (\r\n                <div className=\"intro-btn\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/top-sellers-list\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              ) : (\r\n                \"\"\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row items\">\r\n          {sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              return (\r\n                <div\r\n                  key={`ts_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                >\r\n                  {/* Single Seller */}\r\n                  <div className=\"card\">\r\n                    <div className=\"single-seller d-flex align-items-center\">\r\n                      <Link to={`/author/${author._id}`}>\r\n                        <div className=\"seller-avatar-container\">\r\n                          <img\r\n                            className=\"avatar-md rounded-circle\"\r\n                            //   src={\r\n                            //     author.profileImage\r\n                            //       ? author.profileImage\r\n                            //       : ENV.globalPlaceholderImage\r\n                            //   }\r\n                            src={AvatarImg}\r\n                            alt=\"\"\r\n                          />\r\n                          <span className=\"seller-avatar-active\">\r\n                            <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                          </span>\r\n                        </div>\r\n                      </Link>\r\n                      {/* Seller Info */}\r\n                      <div className=\"seller-info ml-3 w-100\">\r\n                        <Link\r\n                          className=\"seller mb-2\"\r\n                          to={`/author/${author._id}`}\r\n                        >\r\n                          {author.username}\r\n                        </Link>\r\n                        <span className=\"text-end\">{\"256.6ETH\"}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          ) : (\r\n            <p>Top Sellers not available</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/authors/authors.js",["1246","1247"],"import React, { useEffect, useState } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport {Link} from 'react-router-dom';\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst Authors = (props) => {\r\n    const [creators, setCreators] = useState([]);\r\n    useEffect(()=> {\r\n        props.getCreators();\r\n        window.scrollTo(0, 0)\r\n    }, []);\r\n    useEffect(()=> {\r\n        setCreators(props.user.sellers)\r\n      \r\n    }, [props.user.topSellersAuth]);\r\n\r\n    return (\r\n        <section className=\"popular-collections-area mt-5\">\r\n            <br />\r\n            <br />\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>Creators</span>\r\n                            <h3 className=\"mt-3 mb-0\">Our Creators</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    {\r\n                        creators && creators.length ? \r\n                        creators.map((author, key)=> {\r\n                            return (\r\n                                <div key={`author_${key}`} className=\"col-12 col-sm-6 col-lg-3 item\">\r\n                                    <div className=\"card no-hover text-center\">\r\n                                        <div className=\"image-over\">\r\n                                            <Link to={`/author/${author._id}`}>\r\n                                                <img className=\"card-img-top\" src={author.profileImage ? author.profileImage: ENV.globalPlaceholderImage} alt=\"Author profile\" />\r\n                                            </Link>\r\n                                        </div>\r\n                                        <div className=\"card-caption col-12 p-0\">\r\n                                            <div className=\"card-body mt-1\">\r\n                                                <Link to={`/author/${author._id}`}>\r\n                                                    <h5>{author.username ? author.username : author.address} </h5>\r\n                                                </Link>\r\n                                                <button type=\"button\" className=\"btn btn-bordered-white btn-smaller\">Follow</button>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                  \r\n                                </div>\r\n                            )\r\n                        })\r\n                        : \r\n                        <p>No Creators Found</p>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n   \r\n    {\r\n    user: state.user\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getCreators })(Authors);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/help/help.js",["1248"],"import React, { Component } from 'react';\r\n\r\nconst initData = {\r\n    pre_heading: \"Help Center\",\r\n    heading: \"How can we help you?\",\r\n    content: \"\"\r\n}\r\n\r\nconst data = [\r\n    {\r\n        id: \"1\",\r\n        icon: \"icon icon-plane text-effect\",\r\n        title: \"Getting Started\",\r\n        content: \"Learn how to create an account, set up your wallet, and what you can do on NetStorm\"\r\n    },\r\n    {\r\n        id: \"2\",\r\n        icon: \"icon icon-note text-effect\",\r\n        title: \"Creating\",\r\n        content: \"Learn how to create your very first NFT and how to create your NFT collections so you can begin selling and sharing\"\r\n    },\r\n    {\r\n        id: \"3\",\r\n        icon: \"icon icon-handbag text-effect\",\r\n        title: \"Buying\",\r\n        content: \"Learn how to purchase your first NFT and understand gas fees and what's gas free on NetStorm\"\r\n    },\r\n    {\r\n        id: \"4\",\r\n        icon: \"icon icon-chart text-effect\",\r\n        title: \"Selling\",\r\n        content: \"Learn how list your NFTs for sale and understand the different ways to list your NFTs\"\r\n    },\r\n    {\r\n        id: \"5\",\r\n        icon: \"icon icon-link text-effect\",\r\n        title: \"Partners\",\r\n        content: \"Learn how you can partner with us to showcase your NFT drops\"\r\n    },\r\n    {\r\n        id: \"6\",\r\n        icon: \"icon icon-flag text-effect\",\r\n        title: \"Developers\",\r\n        content: \"Learn how you can develop with NetStorm &amp; sell them on Marketplace\"\r\n    }\r\n]\r\n\r\nclass HelpCenter extends Component {\r\n    state = {\r\n        initData: {},\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        this.setState({\r\n            initData: initData,\r\n            data: data\r\n        })\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"help-center-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row justify-content-center\">\r\n                        <div className=\"col-12 col-md-8 col-lg-7\">\r\n                            {/* Intro */}\r\n                            <div className=\"intro text-center\">\r\n                                <span>{this.state.initData.pre_heading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                                <p>{this.state.initData.content}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"row justify-content-center items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`hd_${idx}`} className=\"col-12 col-md-6 col-lg-4 item\">\r\n                                    {/* Help Card */}\r\n                                    <div className=\"card help-card\">\r\n                                        <a className=\"d-block text-center\" href=\"#\">\r\n                                            <i className={item.icon} />\r\n                                            <h4>{item.title}</h4>\r\n                                            <p>{item.content}</p>\r\n                                        </a>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default HelpCenter;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/sidebar/sidebar.js",["1249","1250","1251"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/sidebar\";\r\n\r\nclass Sidebar extends Component {\r\n    state = {\r\n        data: {},\r\n        widgetData_1: [],\r\n        widgetData_2: [],\r\n        widgetData_3: []\r\n    }\r\n    componentDidMount() {\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data,\r\n                    widgetData_1: res.data.widgetData_1,\r\n                    widgetData_2: res.data.widgetData_2,\r\n                    widgetData_3: res.data.widgetData_3\r\n                })\r\n            })\r\n            .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <aside className=\"col-12 col-lg-4 pl-lg-5 p-0 float-right sidebar\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12 align-self-center text-left\">\r\n                        {/* Widget [categories] */}\r\n                        <div className=\"item widget-categories\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_1}</h4>\r\n                            <ul className=\"list-group list-group-flush\">\r\n                                {this.state.widgetData_1.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdo_${idx}`} className=\"list-group-item d-flex justify-content-between align-items-center\">\r\n                                            <a href=\"#\">{item.title}</a>\r\n                                            <span className=\"badge circle\">{item.content}</span>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                        {/* Widget [tags] */}\r\n                        <div className=\"item widget-tags\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_2}</h4>\r\n                            {this.state.widgetData_2.map((item, idx) => {\r\n                                return (\r\n                                    <a key={`wdt_${idx}`} href=\"\" className=\"badge tag\">{item.title}</a>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                        {/* Widget [share-this] */}\r\n                        <div className=\"item widget-share-this\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_3}</h4>\r\n                            <ul className=\"navbar-nav social share-list\">\r\n                                {this.state.widgetData_3.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdth_${idx}`} className=\"nav-item\">\r\n                                            <a href=\"#\" className=\"nav-link\"><i className={item.icon} /></a>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </aside>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Sidebar;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collection-preview.js",["1252","1253"],"import React from 'react';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV\n\nconst CollectionPreview = ({ collection }) => {\n    return (\n        <>\n            <div className=\"card no-hover text-center \">\n                <div className=\"image-over\">\n                    <div>\n                        <img className=\"card-img-top\" src={collection.featuredImg ? collection.featuredImg : collectionFeaturedImg} alt=\"Collection Featured Image\" />\n                    </div>\n                    <div className=\"seller\">\n                        <div className=\"seller-thumb avatar-lg\">\n                            <img className=\"rounded-circle\" src={collection.logo} alt='Collection Logo' />\n                        </div>\n                    </div>\n                </div>\n                <div className=\"card-caption col-12 p-0\">\n                    <div className=\"card-body mt-4\">\n                        <div>\n                            <h5 className=\"mb-2\">{collection.name}</h5>\n                            <p className=\"mb-2\">\n                                {\n                                    collection.url ?\n                                        <div className=\"input-group\">\n                                            <input type=\"text\" className=\"form-control\" placeholder=\"Collection URL\" readOnly value={collection.url} />\n                                            <div className=\"input-group-append\" style={{ zIndex: 888 }}>\n                                                <button className=\"btn mr-0\"><i className=\"icon-docs\" /></button>\n                                            </div>\n                                        </div>\n                                        : ('URL: N/A')\n                                }\n                            </p>\n                            <p className=\"mb-2\">{collection.description ? collection.description : 'Description: N/A'}</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div className=\"row items\">\n                <div className=\"col-12 px-0 mt-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <img className=\"avatar-md rounded-circle\" src={collection.category?.image || categoryDefaultImg} alt=\"Category Image\" />\n                            <div className=\"seller-info ml-3\">\n                                <div className=\"seller\">{collection.category?.name || 'N/A'}</div>\n                                <span>Category</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"col-12 px-0 my-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <Link to=\"/author\">\n                                <img className=\"avatar-md rounded-circle\" src={collection.user?.profilePhoto || userDefaultImg} alt=\"User Avatar\" />\n                            </Link>\n                            <div className=\"seller-info ml-3\">\n                                <Link className=\"seller mb-2\" to=\"/author\">{collection.user?.username}</Link>\n                                <span>Creator</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default CollectionPreview;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/item-details/item-details.js",["1254","1255","1256","1257","1258","1259","1260","1261","1262","1263","1264","1265","1266","1267","1268","1269","1270","1271"],"import React, { Component } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport { Link } from 'react-router-dom';\r\nimport { beforeNFT, getNFT } from '../nfts/nfts.action';\r\nimport FullPageLoader from '../full-page-loader/full-page-loader'\r\nimport { ENV } from '../../config/config';\r\nimport moment from 'moment';\r\nimport Countdown from 'react-countdown';\r\nimport SimpleReactValidator from 'simple-react-validator'\r\nimport { decimalNumberValidator } from \"../../utils/functions\";\r\nimport { Container, Row, Col, Button, Modal } from \"react-bootstrap\";\r\nimport { beforeOffer, makeOffer, getOffers, deleteOffer, acceptOffer } from '../offers/offers.action'\r\nimport { beforeBid, placeBid, getBids, deleteBid, acceptBid } from '../bids/bids.action'\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {getCurrentAddress,BuyFixedPriceNFTs,placeBidNft,acceptNftOffer} from '../../utils/web3';\r\nimport { toast } from 'react-toastify'\r\nconst { globalPlaceholderImage, countDownRenderer, currencies, objectToQueryString } = ENV\r\n\r\nconst initData = {\r\n    itemImg: \"/img/auction_2.jpg\",\r\n    date: \"2022-03-30\",\r\n    price_2: \"$500.89\",\r\n    bidBtn: \"Place a Bid\",\r\n    offerBtn: \"Buy Now\",\r\n    sellBtn: \"Sell\"\r\n}\r\n\r\n// expiry options\r\n\r\nconst expiryOptions = [\r\n    { label: '5 Days', value: moment().add(5, \"days\").format('DD/MM/YYYY') },\r\n    { label: '7 Days', value: moment().add(7, \"days\").format('DD/MM/YYYY') },\r\n    { label: 'A Month', value: moment().add(1, \"months\").format('DD/MM/YYYY') },\r\n    { label: 'Custom Date', value: -1 },\r\n]\r\n\r\n// make an offer / bid config.\r\n\r\nconst config1 = {\r\n    price: {\r\n        currency: ENV.currency,\r\n        amount: \"\",\r\n    },\r\n    expiry: {\r\n        date: expiryOptions[0].value,\r\n        time: moment(new Date()).format(\"HH:mm\"),\r\n        type: 1, // 1 for time & 2 for datetime-local\r\n        datetime: '' // for payload \r\n    }\r\n};\r\nlet nft1=[]\r\nclass ItemDetails extends Component {\r\n    isTimeoutAction = false;\r\n    constructor(props) {\r\n        super(props)\r\n        this.state = {\r\n            userId: ENV.getUserKeys()?._id,\r\n            offers: null,\r\n            offersPagination: null,\r\n\r\n            bids: null,\r\n            bidsPagination: null,\r\n            highestBidAmtt:null,\r\n            errors: '',\r\n            isSubmitted: false,\r\n            formValid: true,\r\n            loader: true,\r\n            nft: null,\r\n            nftAll:null,\r\n            isOpen: false,\r\n            creator:[],\r\n            nftConfig: config1 ,// make an offer / bid config.\r\n            nftsData:[],\r\n            bidsData:[],\r\n            creators:[],\r\n            myAddress:''\r\n        }\r\n        this.validator = new SimpleReactValidator({\r\n            autoForceUpdate: this,\r\n            messages: {\r\n                required: 'This field is required.'  // will override all messages\r\n            },\r\n        });\r\n\r\n    }\r\n\r\n    componentDidMount= async()=> {\r\n        window.scroll(0, 0)\r\n        let myAddress=await getCurrentAddress()\r\n     \r\n        this.setState({\r\n            myAddress\r\n        })\r\n        const query = new URLSearchParams(window.location.search)\r\n        this.getTokens()\r\n       \r\n        if (query.get('item')) {\r\n        \r\n            const nftId = window.atob(query.get('item'))\r\n            // console.log(nftId,\"nftId====>\");\r\n            if (nftId) {\r\n                this.props.getNFT(nftId);\r\n                this.getBids(nftId)\r\n\r\n                const bidQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getBids(bidQS);\r\n\r\n                const offerQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getOffers(offerQS);\r\n                this.props.getCreators();\r\n            }\r\n        } else\r\n            this.props.history.push('/explore-all')\r\n    }\r\n\r\n    filterCreator=(nft)=>{\r\n     \r\n        // let nftId=this.state.nft.collection.userId\r\n    }\r\n    filterCreatorsInfo=(id,item)=>{\r\n      \r\n      let user= this.props.user?.creators?.find((item)=>item._id===id )\r\n      if(user){\r\n          if(item==\"username\"){\r\n             return user.username\r\n          }\r\n          if(item==\"profilePhoto\"){\r\n              return user?.profileImage\r\n          }\r\n          if(item==\"id\"){\r\n            return user._id\r\n          }\r\n      }\r\n    }\r\n\r\n    componentDidUpdate() {\r\n        // if (this.props.error)\r\n        //     this.setState({ loader: false })\r\n\r\n        if (this.props.nft.nftsAuth) {\r\n           \r\n            const nft = this.props.nft.nftsData\r\n            const allData=this.props.nft.nftAll\r\n           \r\n            //nft\r\n            nft1=nft\r\n            this.getBids(nft?._id)\r\n            this.setState({\r\n                \r\n                nft,\r\n            nftAll:allData\r\n                \r\n            }, () => {\r\n                this.props.beforeNFT()\r\n            })\r\n            this.filterCreator(nft)\r\n            const date1 = moment();\r\n            const date2 = moment(this.props?.nft?.nftAll?.sellingConfig?.duration?.endDate);\r\n           \r\n            // this.isTimeoutAction =  date2.diff(date1) > 0 ? false : true;\r\n            let result =  date2.diff(date1) > 0 ? false : true;\r\n            this.setState({\r\n                isTimeoutAction:result\r\n            })\r\n            // console.log(result,\"checking result\")\r\n        }\r\n\r\n        if (this.props.offer.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeOffer()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getOffers(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.getAuth) {\r\n            const { offers, pagination } = this.props.offer\r\n            this.setState({ loader: false, offers, offersPagination: pagination }, () => {\r\n                this.props.beforeOffer()\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.deleteAuth) {\r\n            this.props.beforeOffer()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getOffers(qs)\r\n        }\r\n\r\n        if (this.props.bid.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeBid()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getBids(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.getAuth) {\r\n         \r\n            const { bids, pagination, highestBidAmt } = this.props.bid\r\n        \r\n            let nft = { ...this.state.nft }\r\n\r\n            nft.highestBidAmt = highestBidAmt\r\n           \r\n            this.setState({ loader: false, bids, bidsPagination: pagination, nft }, () => {\r\n                this.props.beforeBid()\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.deleteAuth) {\r\n            this.props.beforeBid()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getBids(qs)\r\n        }\r\n\r\n        if (this.props.offer.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeOffer()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeBid()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n        //    console.log(this.props.user.topSellersAuth,\"kjkjkjlkjlkjkljlkjk\");\r\n\r\n        if(this.props.user.topSellersAuth && !this.state.creator?.length>0 ){\r\n            this.filterCreator(this.props.user.sellers)\r\n            this.setState({\r\n                creator:this.props.user.sellers,\r\n                creators:this.props.user.creators\r\n            })\r\n            // console.log(this.props.user.sellers,\"creators===}}}}}}}}}}}}}}}}}}}}}\");\r\n            // console.log(this.state.nft,\"nft below the creator===>\")\r\n        }\r\n        \r\n\r\n    }\r\n   \r\n    getBids=(nftId)=>{\r\n        const BASE_URL= process.env.REACT_APP_BASE_URL \r\n        fetch(BASE_URL + \"/bid/list\", {\r\n            method: 'GET',\r\n            headers: {\r\n                'content-type': 'application/json',\r\n                'Authorization': ENV.Authorization,\r\n                'x-auth-token': ENV.x_auth_token,\r\n                'Access-Control-Allow-Origin': '*',\r\n                'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n            }\r\n        }).then(res => res.json()).then(data => {\r\n       \r\n            let bids=data.data.allBids?.filter((item)=>item.nftId===nftId)          \r\n           \r\n            // const highestBidAmt = bids.length\r\n            var last_element = bids[bids?.length - 1];\r\n       \r\n            this.setState({\r\n                bidsData:bids,\r\n                highestBidAmtt: last_element?.price.amount\r\n\r\n            })\r\n            setTimeout(()=>{\r\n               this.setState({\r\n                   loader:false,\r\n               })\r\n            },2000)\r\n         \r\n        }).catch(error => {\r\n        console.log(error,\"error while getting bids\")\r\n           \r\n        })\r\n    }\r\n    openModal = () => {\r\n  \r\n        if(this.props?.nft?.nftAll.sellingMethod==1)\r\n        {\r\n            // console.log(\"inside if\")\r\n            var res= this.state.nftsData.data.find((item)=>item.nftId===this.state.nft._id)\r\n            // console.log(res,\"response\")               \r\n             // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n             this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n               this.setState({\r\n                   loader:false\r\n               })\r\n\r\n            }, 8000);\r\n          \r\n             BuyFixedPriceNFTs(this.props?.nft?.nftAll.currentPrice,res.nftToken,this.props.nft.nftAll._id)\r\n            \r\n        }\r\n        else {\r\n            // console.log(\"inside else\")\r\n            this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n        }\r\n      \r\n        // this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n    }\r\n\r\n    closeModal = () => this.setState({ isOpen: false });\r\n\r\n    onChange = (e) => {\r\n        const { nftConfig } = this.state;\r\n        const { name, value } = e.target;\r\n        let data = nftConfig;\r\n\r\n        const keys = name.split(\".\"); // nftConfig, price, currency\r\n        if (keys && keys[2])\r\n            data[keys[1]][keys[2]] = value;\r\n        else if (keys && keys[1])\r\n            data[keys[1]] = value;\r\n\r\n        if (keys && keys[1] === 'price' && keys[2] === 'amount')\r\n            data[keys[1]]['amount'] = Number(value)\r\n\r\n        if (keys && keys[1] === 'expiry' && keys[2] === 'date')\r\n            data[keys[1]]['type'] = Number(value) === -1 ? 2 : 1\r\n\r\n        // set datetime for days / months \r\n        if (data.expiry.type === 1)\r\n            data.expiry.datetime = moment(data.expiry.date + ' ' + data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n        // set datetime for custom date\r\n        else if (data.expiry.type === 2) {\r\n            data.expiry.datetime = moment(data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n            data.expiry.date = moment(data.expiry.time, 'DD/MM/YYYY')\r\n        }\r\n\r\n        this.setState({\r\n            nftConfig: {\r\n                ...data\r\n            }\r\n        })\r\n    };\r\n\r\n    // submit when a bid is placed or when an offer is made\r\n    submit = () => {\r\n    //   console.log(this.state.myAddress,\"myaddress\")\r\n\r\n        this.setState({ isSubmitted: true, formValid: this.validator.allValid() }, () => {\r\n            const { formValid } = this.state\r\n            if (formValid) {\r\n                this.setState({\r\n                    loader: false               //need to convert true\r\n                }, () => {\r\n                    const { nft, nftConfig,nftAll } = this.state\r\n           \r\n                    // console.log(nftAll,\"checking nft==>\")\r\n                    const payload = {\r\n                        // ownerId: nft.owner._id,\r\n                        expiryDate: nftConfig.expiry.datetime,\r\n                        price: nftConfig.price,\r\n                        nftId: nft._id,\r\n                        bidBy:ENV.getUserKeys('_id'),\r\n                        user:ENV.getUserKeys('_id'),\r\n                        offerById:ENV.getUserKeys('_id'),\r\n                        toAddress:nftAll.ownerAddress,\r\n                        fromAddress:this.state.myAddress,\r\n\r\n                    }\r\n                    // console.log(payload,\"toaddress8888888\")\r\n           \r\n                    let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                    // console.log('check here selling method',nft.sellingMethod )\r\n                    // if selling method is 2 then go for bid\r\n                    if (nft.sellingMethod === 2) { // place a bid \r\n                        placeBidNft(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        // this.props.placeBid(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        this.setState({\r\n                            loader:true\r\n                        })\r\n\r\n                        setTimeout(() => {\r\n                            this.setState({\r\n                                loader:false\r\n                            })\r\n                          \r\n                        }, 5000);\r\n                    } else if (nft.sellingMethod === 1) { // make an offer \r\n                       let res= this.state.nftsData.find((item)=>item.nftId===nft._id)\r\n                    //    console.log(res,\"response\")\r\n                             \r\n                        // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                        // BuyFixedPriceNFTs(payload.price,res.nftToken)\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                        // this.props.makeOffer(payload,foundResult,payload.price)\r\n                    }\r\n                    else{\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        // console.log('single nft before fix price function', nft)\r\n                        let res= this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                        // console.log(res,\"response\")\r\n                              \r\n                         // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                         BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                    }\r\n                })\r\n\r\n            }\r\n\r\n            else {\r\n                alert(\"in else\")\r\n                this.validator.showMessages()\r\n                this.validator.purgeFields()\r\n                this.setState({\r\n                    errors: 'Please fill all required fields in valid format.',\r\n                    formValid: false\r\n                }, () => {\r\n                    window.scroll(0, 0)\r\n                })\r\n            }\r\n            \r\n        })\r\n    }\r\n\r\n    deleteOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteOffer(offerId)\r\n        })\r\n    }\r\n\r\n    deleteBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteBid(bidId)\r\n        })\r\n    }\r\n\r\n    acceptOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.acceptBid({ offerId })\r\n        })\r\n\r\n    }\r\n\r\n    acceptBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            const { nft, nftConfig,nftAll } = this.state\r\n        \r\n            let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n  \r\n            const payload = {\r\n                bidId:bidId,\r\n                nftId: nft._id,\r\n                bidBy:ENV.getUserKeys('_id'),\r\n                user:ENV.getUserKeys('_id'),\r\n                toAddress:nftAll.ownerAddress,\r\n                fromAddress:this.state.myAddress,\r\n            }\r\n            this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n                this.setState({\r\n                    loader:false\r\n                })\r\n              \r\n            }, 7000);\r\n            acceptNftOffer(foundResult.nftToken,payload)\r\n            // this.props.acceptBid(payload,foundResult.nftToken)\r\n             \r\n        })\r\n       \r\n    }\r\n    creatorUserName=()=>{\r\n        // console.log(this.state.creator,\"creator listing\");/\r\n        // console.log(this.props.nftAll,\"this.props.nftAll?\");\r\n\r\n       let result= this.state.creator.find((item)=>item._id===this.state?.nftAll?.userId)\r\n    //    console.log(result,\"result in the userName function===>\");\r\n       if(result?.username)\r\n       {\r\n\r\n           return result.username\r\n       }\r\n       else {\r\n           return \"no username\"\r\n       }\r\n    }\r\n     getTokens=()=>{\r\n\r\n        let url = process.env.REACT_APP_BASE_URL + `nftTokens/tokens`;\r\n      \r\n        fetch(url, {\r\n         method: 'GET',\r\n         headers: {\r\n            'content-type': 'application/json',\r\n            'Authorization': ENV.Authorization,\r\n            'x-auth-token': ENV.x_auth_token,\r\n            'Access-Control-Allow-Origin': '*',\r\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n        },\r\n      \r\n      }).then(res => res.json()).then(data => {\r\n \r\n        //   console.log(data,\"data==>22222222222222222222222222222222222222\")\r\n      \r\n     this.setState({\r\n        nftsData:data\r\n     })\r\n      \r\n      }).catch(error => {\r\n        \r\n        console.log(error,\"error in catch blcok\")\r\n        \r\n      })\r\n    }\r\n    // filterCreatorsInfo=(id,item)=>{\r\n    //     // console.log(this.state.creators,\"creator in the filterCreatorsFunction\")\r\n    //   let user= this.state?.creators?.data?.find((item)=>item._id===id )\r\n    //   if(user){\r\n\r\n    //       if(item==\"username\"){\r\n    //          return user.username\r\n    //       }\r\n    //       if(item==\"profilePhoto\"){\r\n    //           return user?.profileImage\r\n    //       }\r\n    //       if(item==\"id\"){\r\n    //         return user._id\r\n    //       }\r\n    //   }\r\n      \r\n    // }\r\n\r\n    render() {\r\n        const { loader, nft, nftConfig, isSubmitted, errors, userId, bids, offers } = this.state\r\n        if(!ENV.getUserKeys('_id')._id){\r\n            toast.error(\"Pleas login to continue\")\r\n            this.props.history.push('/')\r\n               return \" \"\r\n           }\r\n           else {\r\n        return (\r\n            <>\r\n                <section className=\"item-details-area padding-wrapper pb-0\">\r\n                    {\r\n                        loader ?\r\n                            <FullPageLoader /> :\r\n                            <>\r\n                                {\r\n                                    nft && \r\n                                    <div className=\"container\">\r\n                                        <div className=\"row justify-content-between\">\r\n                                            <div className=\"col-12 col-lg-5\">\r\n                                                <div className=\"item-info\">\r\n                                                    <div className=\"item-thumb text-center\">\r\n                                                        <img src={nft.image} alt=\"NFT Image\" />\r\n                                                    </div>\r\n                                                    {\r\n                                                        nft.auctionEndDate &&\r\n                                                        <div className=\"card no-hover countdown-times mt-4\">\r\n                                                            <Countdown\r\n                                                                date={new Date(nft.auctionEndDate) + 10000}\r\n                                                                renderer={countDownRenderer}\r\n                                                            />\r\n                                                        </div>\r\n                                                    }\r\n                                                    {/* Tabs */}\r\n                                                    <ul className=\"netstorm-tab nav nav-tabs mt-4\" id=\"nav-tab\">\r\n                                                        <li>\r\n                                                            <a className=\"active\" id=\"bids-tab\" data-toggle=\"pill\" href=\"#bids\">\r\n                                                                <h5 className=\"m-0\">Bids</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                        {/* <li>\r\n                                                            <a id=\"offers-tab\" data-toggle=\"pill\" href=\"#offers\">\r\n                                                                <h5 className=\"m-0\">Offers</h5>\r\n                                                            </a>\r\n                                                        </li> */}\r\n                                                        <li>\r\n                                                            <a id=\"details-tab\" data-toggle=\"pill\" href=\"#details\">\r\n                                                                <h5 className=\"m-0\">Details</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                    </ul>\r\n                                                    \r\n                                                    {/* Tab Content */}\r\n                                                    <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                                                        <div className=\"tab-pane fade show active\" id=\"bids\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {this.state.bidsData &&  this.props.user?.creators?.length > 0  ? \r\n                                                                \r\n                                                                    this.state.bidsData.map((item, idx) => {\r\n                                                                \r\n                                                                        return (\r\n                                                                            <li key={`bid_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                             \r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Bid listed for <strong>{item.price.amount} {item.price.currency} </strong>\r\n                                                                                     <span>{moment(item.createdAt).fromNow()} </span>\r\n                                                                                     <br />by <Link to={`/author/${item.bidById}`}>@{ this.filterCreatorsInfo(item.bidBy,'username')}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                     nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                      nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                     \r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No bids found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div>\r\n\r\n                                                        {/* <div className=\"tab-pane fade\" id=\"offers\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {offers && offers.length > 0 ?\r\n                                                                    offers.filter((item)=>item.nftId===nft._id).map((item, idx) => {\r\n                                                                        return (\r\n                                                                            <li key={`offer_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.offerBy?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Offer listed for <strong>{item.price.amount} {item.price.currency}</strong> {moment(item.createdAt).fromNow()} <br />by <Link to={`/author/${item.nftId}`}>@{this.filterCreatorsInfo(item.offerById,\"username\")}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No offers found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div> */}\r\n                                                        \r\n                                                        <div className=\"tab-pane fade\" id=\"details\">\r\n                                                            <div className=\"owner-meta d-flex align-items-center mt-3\">\r\n                                                                <span>Owner</span>\r\n                                                                <Link className=\"owner d-flex align-items-center ml-2\" to={`/author/${nft.owner?._id}`}>\r\n                                                                    <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto ? nft.owner.profilePhoto : globalPlaceholderImage} alt=\"Owner Image\" />\r\n                                                                    <h6 className=\"ml-2\">{nft.owner?.username}</h6>\r\n                                                                </Link>\r\n                                                            </div>\r\n                                                            <p className=\"mt-2\">Created : {moment(nft.createdAt).format('DD MMM YYYY')\r\n                                                            }</p>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 col-lg-6\">\r\n                                                <div className=\"content mt-5 mt-lg-0\">\r\n                                                    <h3 className=\"m-0\">{nft.name}</h3>\r\n                                                    <p>{nft.description}</p>\r\n\r\n                                                    {/* Owner */}\r\n                                                    <div className=\"owner d-flex align-items-center\">\r\n                                                        <span>Owned By</span>\r\n                                                        <Link className=\"owner-meta d-flex align-items-center ml-3\" to={`/author/${nft.owner?._id}`}>\r\n                                                            <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto || globalPlaceholderImage} alt=\"Owner Avatar\" />\r\n                                                            <h6 className=\"ml-2\">\r\n                                                                {/* {nft.owner?.username}\r\n                                                                 */}\r\n                                                                 {this.creatorUserName()}\r\n                                                                </h6>\r\n                                                        </Link>\r\n                                                    </div>\r\n                                                    {/* Item Info List */}\r\n                                                    <div className=\"item-info-list mt-4\">\r\n                                                        <ul className=\"list-unstyled\">\r\n                                                            <li className=\"price d-flex justify-content-between\">\r\n                                                                <span>Current Price {nft.currentPrice || 0} {ENV.currency}</span>\r\n                                                                {/* <span>{initData.price_2}</span> */}\r\n                                                                <span>{nft.sold} of {nft.copies}</span>\r\n                                                            </li>\r\n                                                            <li>\r\n                                                                <span>Size </span>\r\n                                                                <span>{nft.size}</span>\r\n                                                            </li>\r\n                                                        </ul>\r\n                                                    </div>\r\n                                                    <div className=\"row items\">\r\n                                                        {/* Creator */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <a href=\"/author\">\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.creator?.profilePhoto || globalPlaceholderImage} alt=\"Creator Avatar\" />\r\n                                                                    </a>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`/author/${nft.creator?._id}`}>{\r\n                                                                          this.creatorUserName()\r\n                                                                        // nft.creator?.username\r\n                                                                        }</Link>\r\n                                                                        <span>Creator</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        {/* Collection */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <Link to={`collection-details/${window.btoa(nft.collection?._id)}`}>\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.collection?.image} alt=\"Collection Image\" />\r\n                                                                    </Link>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`collection-details/${window.btoa(nft.collection?._id)}`}>{nft.collection?.name}</Link>\r\n                                                                        <span>Collection</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        <div className=\"col-12 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <h4 className=\"mt-0 mb-2\">Highest Bid</h4>\r\n                                                                <div className=\"price d-flex justify-content-betxween align-items-center\">\r\n                                                                    <span>{this.state.highestBidAmtt ? this.state.highestBidAmtt + ` ${ENV.currency}` : 'N/A'}</span>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                    {\r\n\r\n                                                        nft.nftOwnerId=== userId ?\r\n                                                        <Link className=\"d-block btn btn-bordered-white mt-4 mb-4 w-100\" to={`/sell-item/${window.btoa(nft._id)}`}>{initData.sellBtn}</Link>\r\n                                                        :\r\n                                                        // <button className=\"d-block btn btn-bordered-white mt-4 w-100\" onClick={this.openModal(nft)}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn}</button>\r\n                                                        <>\r\n                                                             {/* this.isTimeoutAction ? 'Auction Timeout' : */}\r\n                                                             {/*  */}\r\n                                                            { \r\n                                                           this.props?.nft?.nftAll.sellingMethod &&\r\n                                                            <button  className=\"d-block btn btn-bordered-white mt-4 w-100\" disabled={this.isTimeoutAction || nft.copies===nft.sold}  onClick={()=>this.openModal()}>{this.isTimeoutAction?\"Auction Timeout\":( nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn)}</button>}\r\n                                                             \r\n                                                            </>\r\n                                                    }\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                }\r\n                            </>\r\n\r\n                    }\r\n                </section>\r\n                <div className=\"modal-wrapper\">\r\n                    {\r\n                        nft &&\r\n                        <Modal\r\n                            centered\r\n                            size=\"lg\"\r\n                            className=\"\"\r\n                            show={this.state.isOpen}\r\n                            onHide={this.closeModal}\r\n                        >\r\n                            <Modal.Header className=\"text-center modal-title-wrapper\">\r\n                                <Modal.Title>\r\n                                    { nft.sellingMethod === 2 ? 'Place A Bid' : 'Make An Offer'}\r\n                                </Modal.Title>\r\n                            </Modal.Header>\r\n                            {\r\n                                isSubmitted && errors &&\r\n                                <Modal.Body className=\"row pt-2 pb-0\">\r\n                                    <div className=\"col-12\">\r\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\r\n                                    </div>\r\n                                </Modal.Body>\r\n                            }\r\n                            <Modal.Body>\r\n                                <div className=\"price-wrapper d-flex\">\r\n                                    <div className=\"price-text position-relative\">\r\n                                        <div className=\"text-white mb-2 absolute-wrapper\">\r\n                                            <b>Price</b>\r\n                                        </div>\r\n                                        <div className=\"text-right mb-2\">\r\n                                            <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                                        </div>\r\n                                        <div className=\"d-flex\">\r\n                                            <select className=\"form-control\" id=\"currency\" name=\"nftConfig.price.currency\" onChange={(e) => this.onChange(e)}>\r\n                                                {\r\n                                                    currencies && currencies.map((currency, index) => {\r\n                                                        return (\r\n                                                            <option key={index} value={currency.symbol}>{currency.symbol}</option>\r\n                                                        )\r\n                                                    })\r\n                                                }\r\n                                            </select>\r\n                                            <input type=\"text\" placeholder=\"Amount\" className=\"amount-btn ml-3\" name=\"nftConfig.price.amount\" placeholder=\"Amount\" className=\"amount-btn ml-3\" style={{ borderRadius: \"4px\" }} onChange={(e) => this.onChange(e)} onKeyDown={(e) => decimalNumberValidator(e)} defaultValue={nftConfig.price.amount} required />\r\n                                            <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                                $ 0.00\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"text-danger\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</Modal.Body>\r\n                            <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\r\n                                <div className=\"offer-expiration-wrapper text-white\">\r\n                                    <b>Offer Expiration</b>\r\n                                </div>\r\n                                <div>\r\n                                    <div className=\"d-flex\">\r\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\r\n                                            style={{\r\n                                                padding: \"7px 55px 7px 55px\",\r\n                                                border: \"none\",\r\n                                                outline: \"none\",\r\n                                                borderRadius: \"4px\",\r\n                                                background: \"#808080\",\r\n                                                display: \"flex\",\r\n                                                alignItems: \"center\",\r\n                                                cursor: \"pointer\",\r\n                                                height: \"51px\",\r\n                                                color: \"#000\"\r\n                                            }}\r\n                                        >\r\n                                            {\r\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\r\n                                                    return (\r\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\r\n                                                    )\r\n                                                })\r\n                                            }\r\n                                        </select>\r\n                                        <div>\r\n                                            <div className=\"mr-auto budle-wrapper\">\r\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\r\n                                            </div>\r\n                                            <span className=\"text-danger message\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"justify-content-center align-items-center\">\r\n                                <div className=\"d-flex justify-content-around\">\r\n                                    <button className=\"ethereum-btn mr-3\" disabled={loader} onClick={() => this.submit()}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.bidBtn}</button>\r\n                                    {/* <button className=\"ethereum-btn\">Add funds</button> */}\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Footer>\r\n                                <button\r\n                                    className=\"btn banner-btn btn-primary\"\r\n                                    onClick={this.closeModal}\r\n                                >\r\n                                    Close\r\n                                </button>\r\n                            </Modal.Footer>\r\n                        </Modal>\r\n                    }\r\n                </div>\r\n            </>\r\n        );\r\n                }\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n    // console.log('state', state),\r\n \r\n    {\r\n    nft: state.nft,\r\n    error: state.error,\r\n    offer: state.offer,\r\n    bid: state.bid,\r\n    user: state.user,\r\n    nftAll:state.nftAll,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeNFT, getNFT,\r\n    beforeOffer, makeOffer, getOffers, deleteOffer, beforeBid, placeBid, getBids, deleteBid, acceptOffer, acceptBid, beforeUser, getCreators ,\r\n})(ItemDetails);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/filter-search/filtersearch.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore-items.js",["1272","1273","1274","1275","1276","1277","1278"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nimport NftCard from '../collections/components/NftCard/NftCard'\nconst initData = {\n    btn_1: \"Load More\",\n}\n\nfunction ExploreItems(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n\n    useEffect(() => {\n        // get NFTs for explore section\n        const nftQS = { page: 1, limit: 4, explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }, [])\n\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            if (nftsData) {\n                setNFTs(nftsData.nfts)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n                setLoader(false)\n                if (props.setView)\n                    props.setViewAll(nftsData.nfts && nftsData.nfts.length > 0)\n            }\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n\n        // get more NFTs for explore section\n        const nftQS = { page: 1, limit: limit * (page + 1), explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n    return (\n        <>\n            {/* <div className={`row items ${props.class1 ? props.class1 : ''} ${!nfts.length ? 'justify-content-center' : ''}`}> */}\n            <div className=\"row\">\n            <div className=\"row justify-content-center mt-5 w-100\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                {/* <span>{initData.pre_heading}</span> */}\n                                <span>Explore</span>\n                                {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                                    <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                            </div>\n                        </div>\n                    </div>\n\n                {\n                    props.nfts && props.nfts.length > 0 ?\n                        props.nfts.map((item, idx) => {\n                            return (\n                                \n                                // <div key={`${props.key}_${idx}`} className={`col-12 col-sm-6 col-lg-3 item d-block ${props.class2 ? props.class2 : ''}`}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <Link to=\"/author\">\n                                //                         <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6>\n                                //                     </Link>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     {/* <span>{item.sold} of {item.copies}</span> */}\n                                //                 </div>\n                                //                 {/* <Link className=\"btn btn-bordered-white btn-smaller mt-3\" to=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</Link> */}\n                                //             </div>http://3.142.91.8/authorshttp://3.142.91.8/authors\n                                //         </div>\n                                //     </div>\n                                // </div>\n                                     \n                      <>\n                     \n                                     <div className=\"col-4 mt-5\">\n                                     <NftCard/>\n                                     </div>\n\n                                     </>\n                              \n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Explore</p>\n                }  </div>\n            {/* </div> */}\n            {\n                props.loadMoreBtn &&\n                <div className=\"row\">\n                    <div className=\"col-12 text-center\">\n                        <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                    </div>\n                </div>\n            }\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs })(ExploreItems);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/popular-collections.js",["1279","1280","1281","1282","1283"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\nimport Collections from \"./collections\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { connect } from \"react-redux\";\nimport { CollectionImages } from \"../../assets/assets.js\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst collectionData = [\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n];\n\nconst PopularCollections = (props) => {\n  // const [categories, setCategories] = useState(null);\n  // const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  // const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  // const collectionsRef = useRef(null);\n\n  // useEffect(() => {\n  //   window.scroll(0, 0);\n  //   props.getCategories();\n  // }, []);\n\n  // // when categories data is received\n  // useEffect(() => {\n  //   if (props.category.getAuth) {\n  //     const { categories } = props.category;\n  //     // const allCat = { active: true, name: 'all' }\n  //     // setCategories([allCat, ...categories])\n  //     setCategories(categories);\n  //     props.beforeCategory();\n  //     setCatLoader(false);\n  //     setColLoader(false);\n  //   }\n  // }, [props.category.getAuth]);\n\n  // const getCatCollections = (catId) => {\n  //   collectionsRef.current?.getCatCollections(catId);\n  // };\n  // const getColLoader = (loader) => {\n  //   setColLoader(loader);\n  // };\n\n  // console.log(categories, \"categories123\");\n\n  return (\n    <>\n      {/* {!collectionsLoader ? (\n        <FullPageLoader />\n      ) : ( */}\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-0\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products. We want to be a part of your\n                    smile, success and future growth.\n                  </p>\n                </div>\n                {/* {collectionsRef.current?.colCount > 0 && (\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn content-btn text-left\"\n                      to=\"/collections\"\n                    >\n                      {initData.btnText}\n                    </Link>\n                  </div>\n                )} */}\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-center justify-content-sm-end align-content-xxl-start text-end\">\n                <button className=\"me-1 me-sm-2 active\">Arts</button>\n                <button className=\"me-1 me-sm-2\">Music</button>\n                <button className=\"me-1 me-sm-2\">Game</button>\n                <button className=\"me-1 me-sm-5\">Sport</button>\n                <div className=\"intro-btn\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\n                    to=\"/popular-collections\"\n                  >\n                    View All\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <CardSlider\n            settings={ENV.popularCollectionsSettings}\n            homeAuction={false}\n            data={[1, 2, 3, 4]}\n          >\n            {collectionData.map((collectionData) => {\n              return (\n                <CollectionsCard\n                  CardImg={collectionData.mainImg}\n                  Subimg1={collectionData.subImg1}\n                  Subimg2={collectionData.subImg2}\n                  Subimg3={collectionData.subImg3}\n                />\n              );\n            })}\n            {/* {categories.map((category) => { \n                return (\n                  <>\n                    <CollectionsCard category={category} />\n                  </>\n                );\n              })} */}\n          </CardSlider>\n          {/* <CollectionsCard /> */}\n          {/* <Collections\n            popular={true}\n            userId=\"61408000cef27850fdea272b\"\n            setLoader={getColLoader}\n            ref={collectionsRef}\n          /> */}\n        </div>\n      </section>\n      {/* )} */}\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, { beforeCategory, getCategories })(\n  PopularCollections\n);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore-home.js",["1284","1285","1286","1287","1288","1289"],"import React, { useState } from 'react';\nimport ExploreItems from './explore-items';\nimport { Link } from 'react-router-dom';\n\nconst initData = {\n    pre_heading: \"Exclusive Assets\",\n    heading: \"Explore\",\n    btn_1: \"View All\",\n}\n\nfunction ExploreHome() {\n    const [viewAll, setViewAll] = useState(false);\n\n    const getViewAll = (view) => {\n        setViewAll(view)\n    }\nconst nfts=[\n  1,2,3,4,5,6\n]\n    return (\n        <section className=\"explore-area load-more p-0\">\n            <div className=\"container\">\n                <div className=\"row\">\n                    {/* <div className=\"col-12\">\n                        <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                            <div className=\"intro-content\">\n                                <span>{initData.pre_heading}</span>\n                                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                            </div>\n                            {\n                                viewAll &&\n                                <div className=\"intro-btn\">\n                                    <Link className=\"btn content-btn\" to=\"/explore-all\">{initData.btn_1}</Link>\n                                </div>\n                            }\n                        </div>\n                    </div> */}\n                </div>\n                {/* <ExploreItems key=\"exo\" setView={true} setViewAll={getViewAll} loadMoreBtn nfts={nfts}/> */}\n            </div>\n        </section>\n    );\n}\n\nexport default ExploreHome;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/components/NftCard/NftCard.js",["1290","1291"],"import react from \"react\";\nimport { Link } from \"react-router-dom\";\nimport \"./NftCard.css\";\n\nconst NftCard = (props) => {\n  const filterCreator = (nft) => {\n    const result = props.creators.find((item) => item._id === nft.nftOwnerId);\n    if (result?.username) {\n      return result?.username;\n    } else {\n      return \"no username found\";\n    }\n  };\n  const { userId, nft } = props;\n  return (\n    <div className=\"NftCard-Container \">\n      <Link to={`/item-details?item=${window.btoa(props.nft._id)}`}>\n        <img\n          src={\n            props?.nft?.image ? props.nft.image : \"https://picsum.photos/200\"\n          }\n          alt=\"testinImage\"\n          className=\"nft-car-img\"\n        />\n      </Link>\n\n      <div className=\"NftCard-description p-3\">\n        <p className=\"mb-0 text-white\">\n          {props?.nft?.name ? props.nft.name : \"someTHing\"}\n        </p>\n        <p className=\"text-white\">Owned By: {filterCreator(props.nft)}</p>\n        <div className=\"d-flex w-100 justify-content-between\">\n          <p className=\"mb-0 text-white\">\n            {props?.nft?.currentPrice ? props.nft.currentPrice : \"0.04\"}\n          </p>\n          <p className=\"mt-0 text-white\">\n            {props?.nft?.sold ? props.nft.sold : \"0\"} out of {props.nft.copies}\n          </p>\n        </div>\n        <div className=\"py-3\">\n          <Link\n            to={`/item-details?item=${window.btoa(props.nft._id)}`}\n            id=\"wallet-address\"\n            className=\"btn ml-lg-auto btn-bordered-white\"\n          >\n            <i className=\"icon-wallet mr-md-2\" />\n            {nft.nftOwnerId === userId\n              ? \"Sell NFT\"\n              : nft.sellingMethod === undefined\n              ? \"NFT Details\"\n              : nft.nftOwnerId !== userId && nft.sellingMethod == 1\n              ? \"Buy Now\"\n              : \"Place a Bid\"}\n          </Link>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default NftCard;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/work/work.js",["1292","1293","1294"],"import React, { Component } from \"react\";\r\nimport WalletIcon from \"../../assets/images/setup-wallet-icon-white.svg\";\r\nimport CollectionIcon from \"../../assets/images/collection-icon-white.svg\";\r\nimport AddNftIcon from \"../../assets/images/add-nft-icon-white.svg\";\r\nimport SaleIcon from \"../../assets/images/sale-icon-white.svg\";\r\nimport axios from \"axios\";\r\nimport { init } from \"aos\";\r\n\r\n// const BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json/work\";\r\nconst BASE_URL = \"../../json-server/db.json/work\";\r\nconst initData = {\r\n  preHeading: \"How It Works\",\r\n  heading: \"Create and sell your NFTs\",\r\n  workData: [\r\n    {\r\n      id: 1,\r\n      icon: \"icons icon-wallet text-effect\",\r\n      img: WalletIcon,\r\n      title: \"Set up your wallet\",\r\n      text: \"Once you've set up your Celo or BSC Metamask wallet, connect to ARI NFT Marketplace by Signing In and clicking Login.\",\r\n    },\r\n    {\r\n      id: 2,\r\n      icon: \"icons icon-grid text-effect\",\r\n      img: CollectionIcon,\r\n      title: \"Create your collection\",\r\n      text: \"Click Create and set up your collection. Add social links, a description, profile & banner images, and set a secondary sales fee.\",\r\n    },\r\n    {\r\n      id: 3,\r\n      icon: \"icons icon-drawer text-effect\",\r\n      img: AddNftIcon,\r\n      title: \"Add your NFTs\",\r\n      text: \"Upload your work (image, video, audio, or 3D art), add a title and description, and customize your NFTs with properties, stats, and unlockable content.\",\r\n    },\r\n    {\r\n      id: 4,\r\n      icon: \"icons icon-bag text-effect\",\r\n      img: SaleIcon,\r\n      title: \"List them for sale\",\r\n      text: \"Choose between auctions, fixed-price listings, and declining-price listings. You choose how you want to sell your NFTs!\",\r\n    },\r\n  ],\r\n};\r\n// console.log('base url',BASE_URL)\r\nclass Work extends Component {\r\n  state = {\r\n    data: {},\r\n    workData: [],\r\n  };\r\n  componentDidMount() {\r\n    this.setState({\r\n      data: initData,\r\n      workData: initData.workData,\r\n    });\r\n    // axios.get(`${BASE_URL}`)\r\n    //     .then(res => {\r\n    //         this.setState({\r\n    //             data: res.data,\r\n    //             workData: res.data.workData\r\n    //         })\r\n    //         console.log(this.state.data)\r\n    //     })\r\n    // .catch(err => console.log(err))\r\n  }\r\n  render() {\r\n    return (\r\n      <section className=\"work-area padding-wrapper\">\r\n        <div className=\"container\">\r\n          <div className=\"row\">\r\n            <div className=\"col-12\">\r\n              {/* Intro */}\r\n              <div className=\"intro mb-4\">\r\n                <div className=\"intro-content\">\r\n                  <span>{this.state.data.preHeading}</span>\r\n                  <h3 className=\"mb-0\">{this.state.data.heading}</h3>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row items mt-3 mt-lg-5\">\r\n            {this.state.workData.map((item, idx) => {\r\n              return (\r\n                <div\r\n                  key={`wd_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                >\r\n                  {/* Single Work */}\r\n                  <div className=\"single-work\">\r\n                    {/* <i className={`${item.icon} mb-5`} /> */}\r\n                    <img src={item.img} alt=\"icon\" className=\"mb-3\" />\r\n                    <h4 className=\"mb-3\">{item.title}</h4>\r\n                    <p>{item.text}</p>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })}\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n}\r\n\r\nexport default Work;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero/hero.js",["1295","1296"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport ExploreIcon from \"../../assets/images/explore-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-rounded-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                {/* <i className=\"icon-rocket mr-2\" /> */}\r\n                <img src={ExploreIcon} alt=\"exploreIcon\" className=\"me-2\" />\r\n                <p>Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"d-lg-none d-flex watch-video align-items-center mt-5 mb-4\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6 col-xl-7 \">\r\n            <Slider\r\n              setHandler={setHandler}\r\n              sliderRadioButtons={sliderRadioButtons}\r\n              handleRadioInputs={handleRadioInputs}\r\n              sliderChecked={sliderChecked}\r\n            />\r\n          </div>\r\n          <div className=\"d-none d-lg-block col-12 col-lg-7\">\r\n            <div className=\"watch-video d-flex align-items-center\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-5\">\r\n            <div className=\"btn-container mx-auto mx-lg-0\">\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn me-3\"\r\n                onClick={prevBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-left\"></i>\r\n              </button>\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn\"\r\n                onClick={nextBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-right\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default Hero;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["1297","1298"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.properties\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"500px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white mt-0\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 7.95rem\"\n                    : \"7.95rem\"\n                }`,\n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" style={{ width: \"558px\" }} key={i}>\n                      <div className=\"row\">\n                        <div\n                          className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1\"\n                          key={i}\n                        >\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <input\n                              className=\"step3-input mt-2 \"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              placeholder=\"Name\"\n                              value={item.name || \"\"}\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29 !important\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n\n                        <div className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1 ml-0 ml-md-4\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{\n                                fontSize: \"1.2rem\",\n                                fontWeight: \"bold\",\n                              }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <div className=\"d-flex align-items-center w-100\">\n                              <input\n                                className=\"step3-input  mt-2\"\n                                type=\"text\"\n                                name=\"value\"\n                                onChange={(e) => handleChange(i, e)}\n                                placeholder=\"Value\"\n                                value={item.value || \"\"}\n                                maxLength=\"30\"\n                                autoComplete=\"off\"\n                                style={{\n                                  backgroundColor: \"#000e29 \",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                              <BsFillXCircleFill\n                                className=\"ml-1 ml-sm-2\"\n                                style={{\n                                  color: \"#00d3f3\",\n                                  top: \"3rem\",\n                                  left: \"13.8rem\",\n                                  cursor: \"pointer\",\n                                }}\n                                onClick={() => removeFormFields(i)}\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <p\n              className=\" mt-4 ml-4\"\n              style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n              onClick={() => addMoreValues()}\n            >\n              {\" \"}\n              Add Property\n            </p>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-2 mt-md-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   propertiesValues && propertiesValues?.length > 0\n                //     ? false\n                //     : true\n                // }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["1299","1300","1301"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(props.levelsInputs);\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage, setErrorMessage] = React.useState(\"\");\n  const [validate, setValidate] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues.splice(i, 1);\n    setlevelsInputs(newFormValues);\n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total === \"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\");\n        return \"\";\n      }\n      if (+item.value > +item.total) {\n        alert(\"inside\");\n        setError(true);\n        setValidate(true);\n        setErrorMessage(\"Value should be less then total!\");\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n  //  const handleValue=(item)=>{\n  //    if(item.value > item.total){\n\n  //      setError(true)\n  //      return true\n  //    }\n  //    return false\n  //  }\n  //  const handleTotal=(item)=>{\n\n  //  }\n  // console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"550px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 mx-auto justify-content-center\">\n              <div className=\"d-flex\">\n                <img\n                  src={LevelsImage}\n                  alt={\"levels\"}\n                  style={{ height: \"2rem\" }}\n                />\n                <p\n                  className=\"text-white\"\n                  style={{\n                    fontSize: \"1.3rem\",\n                    fontWeight: \"bold\",\n                    marginLeft: \"1rem\",\n                  }}\n                >\n                  Add Levels\n                </p>\n              </div>\n            </div>\n            {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Levels show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n            <form onSubmit={handleSubmit}>\n              <div\n                className=\"row levels-scroll p-3 \"\n                style={{\n                  height: `${\n                    levelsInputs && levelsInputs.length > 0\n                      ? \"8.3rem\"\n                      : \"7.3rem\"\n                  }`,\n                }}\n              >\n                {levelsInputs &&\n                  levelsInputs.length > 0 &&\n                  levelsInputs.map((item, i) => {\n                    return (\n                      <div\n                        className=\"row\"\n                        key={i}\n                        style={{\n                          marginBottom: `${\n                            levelsInputs && levelsInputs.length > 1\n                              ? \"12px\"\n                              : \"0\"\n                          }`,\n                        }}\n                      >\n                        <div className=\"col-10 col-sm-6 mt-2 \" key={i}>\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            <input\n                              className=\"step3-input mt-3 name-inp\"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              value={item.name || \"\"}\n                              placeholder=\"Name\"\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 mt-2\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                            <div className=\"values-total-inp w-100\">\n                              <input\n                                className={`step3-input first-value mt-3 values-inp ${\n                                  validate && item.value > item.total\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min=\"1\"\n                                max={\n                                  item.total == \"0\"\n                                    ? \"1\"\n                                    : item.total\n                                    ? item.total\n                                    : \"1\"\n                                }\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.value || \"\"}\n                                placeholder=\"Value\"\n                                autoComplete=\"off\"\n                                name=\"value\"\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n\n                              <p className=\"text-white mb-0 value-label mt-3\">\n                                Of\n                              </p>\n                              <input\n                                className={`step3-input first-value values-inp mt-3 ${\n                                  validate && item.total < item.value\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min={item.value ? item.value : \"1\"}\n                                max=\"9999\"\n                                name=\"total\"\n                                placeholder=\"Total\"\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.total || \"\"}\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                            </div>\n                            <BsFillXCircleFill\n                              className=\"position-absolute levels-cross-icon\"\n                              style={{\n                                color: \"#00d3f3\",\n                                top: \"3rem\",\n                                right: \"-1rem\",\n                                cursor: \"pointer\",\n                              }}\n                              onClick={() => removeFormFields(i)}\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                <div className=\"W-100 text-center\"></div>\n              </div>\n              <p\n                className=\" col-8 mt-4\"\n                style={{\n                  color: \"#00d3f3\",\n                  cursor: \"pointer\",\n                  marginLeft: \"0.8rem\",\n                }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n\n              <div className=\"w-100 text-center\">\n                <button\n                  type=\"submit\"\n                  className=\"btn btn-secondary start-btn mt-5 text-center\"\n                  style={{ width: \"9rem\" }}\n                  // disabled={\n                  //   levelsInputs && levelsInputs?.length > 0\n                  //     ? false\n                  //     : true\n                  // }\n                  // onClick={() => {\n                  //   handleSubmit()\n                  // }}\n                >\n                  Save\n                </button>\n              </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.action.js",["1302"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice, acceptNftOffer} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body,tokenId,price) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            acceptNftOffer(body);\n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore.reducer.js",["1303"],"import { GET_COLLECTION } from '../../redux/types';\n\nconst initialState = {\n    collection:[],\n    getAuth: true\n    \n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n        \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/create-nft-reducer.js",["1304"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/explore-collections.js",["1305","1306","1307","1308"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/top-seller/topsellerlist.js",["1309","1310","1311"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  useEffect(() => {\n    props.getTopSellers();\n  }, []);\n  useEffect(() => {\n    setSellers(props.user.sellers);\n  }, [props.user.topSellersAuth]);\n\n  return (\n    <>\n      <NavbarMain />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <Link to={`/author/${author._id}`}>\n                          <div className=\"seller-avatar-container\">\n                            <img\n                              className=\"avatar-md rounded-circle\"\n                              src={AvatarImg}\n                              alt=\"\"\n                            />\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          </div>\n                        </Link>\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">{\"256.6ETH\"}</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>Top Sellers not available</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {/* {!empty &&\n                  collections?.length > 10 &&\n                  pagination.totalRecords <= collections.length && ( */}\n                <button className=\"btn btn-linear-gradient px-5\">\n                  Load more\n                </button>\n                {/* )} */}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList\n);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/popular-collections-list/popular-collections-list.js",["1312","1313","1314","1315"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"music\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n      // if (props.setLoader) props.setLoader(false);\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Most Popular</span>\n                    <h3 className=\"mb-0\">Popular Collections</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-lg-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={collection.banner}\n                        Subimg1={collection.logo}\n                        Subimg2={collection.featuredImg}\n                        Subimg3={collection.banner}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.user[0]?.username\n                            ? collection?.user[0]?.username\n                            : \"\"\n                        }\n                        NFTCount={collection.NFTCount}\n                        // handleLikesTogle={handleLikesTogleApi}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    collections?.length > 10 &&\n                    pagination.totalRecords <= collections.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/all-nft/allnft.js",["1316","1317","1318","1319","1320","1321","1322","1323","1324","1325","1326","1327","1328","1329","1330","1331","1332"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collection-details/collectiondetails.js",["1333","1334","1335","1336","1337","1338","1339","1340","1341","1342","1343","1344","1345","1346","1347","1348","1349","1350","1351"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./collectiondetails.css\";\nimport Avatar from \"../../assets/images/detail-avatar.png\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { ListingImg } from \"../../assets/assets\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\n\nconst CollectionDetailsPage = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n  });\n  const location = useLocation();\n\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    chains: {\n      label: \"Chains\",\n      option: [\"Ethereum\"],\n    },\n  };\n\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNfts(props.nfts);\n      props.beforeNFT();\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 40,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    setFilterationLoader(true);\n\n    const nftQS = { page, limit };\n\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      newest,\n      highToLow,\n    } = filter;\n\n    // if (!collectionIdFilter) collectionIdFilter = collectionId;\n    // if (!gtePriceFilter) gtePriceFilter = gtePrice;\n    // if (!ltePriceFilter) ltePriceFilter = ltePrice;\n    // if (!categoryIdFilter) categoryIdFilter = categoryId;\n    // if (!oldestFilter) oldestFilter = oldest;\n    // if (!lowToHighFilter) lowToHighFilter = lowToHigh;\n    // if (!highToLowFilter) highToLowFilter = highToLow;\n    // if (!newestFilter) newestFilter = newest;\n\n    nftQS.collectionId = location.state._id;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getNFTs(qs);\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n  ///////////Likes\n  const handleLikesTogleApi = (nftId, status) => {\n    // const {\n    //   collectionId,\n    //   gtePrice,\n    //   ltePrice,\n    //   categoryId,\n    //   oldest,\n    //   lowToHigh,\n    //   highToLow,\n    //   newest,\n    //   page,\n    //   limit,\n    // } = filter;\n    // getNFTs(\n    //   page,\n    //   limit,\n    //   false,\n    //   minValue,\n    //   maxValue,\n    //   categoryId,\n    //   oldest,\n    //   lowToHigh,\n    //   highToLow,\n    //   newest\n    // );\n    // let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    // qs = ENV.objectToQueryString(qs);\n    // props.getMyLikedNfts(qs);\n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n    // setNFTs(nfts);\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const { name, banner, logo, description } = location.state;\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <div className=\"collection-detail-hero w-100\">\n            <img className=\"w-100\" src={banner} alt=\"BannerImg\" />\n          </div>\n          <div className=\"collection-detail-content\">\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"collection-owner-avatar\">\n                    <img src={banner} alt=\"owner-avatar\" />\n                  </div>\n                  <div className=\"d-md-flex align-items-center justify-content-between mt-5\">\n                    <div className=\"collection-owner-detail\">\n                      <div className=\"collection-owner-name d-flex align-items-center\">\n                        <h3>{name}</h3>\n                        <img src={TickIcon} alt=\"tick-icon\" className=\"ms-2\" />\n                      </div>\n                      <p>\n                        Created by <span>brendannorth</span>\n                      </p>\n                    </div>\n                    <div className=\" d-block d-md-none\">\n                      <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                        <p>{description}</p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-btns mt-3 mt-md-0 ms-auto\">\n                      <button className=\"me-1 me-sm-2 me-lg-3\">\n                        <img src={FlagIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button className=\"me-1 me-sm-1 me-lg-3\">\n                        <img src={ShareIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button>+ Add to wishlist</button>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-sm-7 col-md-6 col-lg-5 d-none d-md-block\">\n                  <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                    <p>{description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 col-lg-7 mt-3 mt-sm-5\">\n                  <div className=\"d-flex align-items-center justify-content-center justify-content-lg-end\">\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>items</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Owner</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Prize floor</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Volume trade</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"collections-listing padding-wrapper\">\n                <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <img\n                        src={SearchIcon}\n                        alt=\"search-icon\"\n                        className=\"ms-3\"\n                      />\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        placeholder=\"Search\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Item:</p>\n                      </div>\n\n                      <select name=\"collection-select\">\n                        {itemoptions &&\n                          itemoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Sort:</p>\n                      </div>\n\n                      <select\n                        name=\"collection-select\"\n                        onChange={handleSortOptions}\n                      >\n                        {sortoptions &&\n                          sortoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 d-sm-none\">\n                    <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                      <button\n                        className={`${\n                          activeFilter\n                            ? \"filter-btn-active\"\n                            : \"filter-btn-inactive\"\n                        } ps-2`}\n                        onClick={() => setActiveFilter(!activeFilter)}\n                      >\n                        Filters\n                      </button>\n                    </div>\n                    <div\n                      className={`${\n                        activeFilter ? \"d-block\" : \"d-none\"\n                      } sm-filter-options`}\n                    >\n                      <div className=\"col-10 mx-auto mt-2\">\n                        <FilterComponent\n                          Status={filterData.status}\n                          Chains={filterData.chains}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row mt-5\">\n                <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                  <FilterComponent\n                    Status={filterData.status}\n                    Chains={filterData.chains}\n                    onChangeMinPrice={onChangeMinPrice}\n                    onChangeMaxPrice={onChangeMaxPrice}\n                    minValue={minValue}\n                    maxValue={maxValue}\n                    applyMinMaxFilter={applyMinMaxFilter}\n                  />\n                </div>\n                <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                  <div className=\"row g-3\">\n                    {filterationLoader ? (\n                      <div className=\"text-center\">\n                        <div\n                          class=\"spinner-border text-secondary text-white \"\n                          role=\"status\"\n                        >\n                          <span class=\"sr-only\">Loading...</span>\n                        </div>\n                      </div>\n                    ) : nfts && nfts.length > 0 ? (\n                      nfts.map((listing) => {\n                        return (\n                          <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                            <ListingCards\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                            />\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-white mt-5 text-center no-nfts-title\">\n                        No NFT's Found\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftAll.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n})(CollectionDetailsPage);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nft-detail/nftdetail.js",["1352","1353","1354","1355","1356","1357","1358","1359","1360","1361","1362","1363"],"import React, { useEffect, useState } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./nftdetail.css\";\nimport PriceHistoy from \"../../assets/images/pricehistoryicon.svg\";\nimport OfferIcon from \"../../assets/images/offer-icon.svg\";\nimport ListingIcon from \"../../assets/images/listing-icon.svg\";\nimport ActivityIcon from \"../../assets/images/activity.svg\";\nimport MoreCollectionIcon from \"../../assets/images/morecollectionicon.svg\";\nimport { ListingImg } from \"../../assets/assets\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport DescriptionIcon from \"../../assets/images/detail-description-icon.svg\";\nimport { getNFT, getNFTsByCollection } from \"../nfts/nfts.action.js\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader.js\";\nimport { connect } from \"react-redux\";\nimport { Modal } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport moment from \"moment\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport axios from \"axios\";\n\nconst NFTDetail = (props) => {\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const history = useHistory();\n  let nftId = props.match.params.id;\n  const initData = {\n    itemImg: \"/img/auction_2.jpg\",\n    date: \"2022-03-30\",\n    price_2: \"$500.89\",\n    bidBtn: \"Place a Bid\",\n    offerBtn: \"Buy Now\",\n    sellBtn: \"Sell\",\n  };\n  const { currencies } = ENV;\n  const expiryOptions = [\n    { label: \"5 Days\", value: moment().add(5, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"7 Days\", value: moment().add(7, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"A Month\", value: moment().add(1, \"months\").format(\"DD/MM/YYYY\") },\n    { label: \"Custom Date\", value: -1 },\n  ];\n\n  const config1 = {\n    price: {\n      currency: ENV.currency,\n      amount: \"\",\n    },\n    expiry: {\n      date: expiryOptions[0].value,\n      time: moment(new Date()).format(\"HH:mm\"),\n      type: 1, // 1 for time & 2 for datetime-local\n      datetime: \"\", // for payload\n    },\n  };\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [nftsList, setNftList] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [nftConfig, setNftConfig] = useState(config1);\n  const validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n\n  const propertiesData = [\n    {\n      id: 1,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 2,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 3,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 4,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 5,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 6,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 7,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 8,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n  ];\n  useEffect(() => {\n    props.getNFT(nftId);\n  }, []);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n\n      props.getNFTsByCollection(props.nftDetail.collectionId);\n    }\n  }, [props.nftsAuth]);\n\n  useEffect(() => {\n    if (props.nftsByCollectionStatus) {\n      let moreCollection = [];\n      if (props.nftsByCollection && props.nftsByCollection?.length) {\n        moreCollection = props.nftsByCollection.filter(\n          (item) => item._id !== nftDetail._id\n        );\n      }\n      setNftList(moreCollection);\n    }\n  }, [props.nftsByCollectionStatus]);\n\n  const handleRouting = () => {\n    if (ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId) {\n      history.push({\n        pathname: `/sell-item/${nftDetail._id}`,\n        state: nftDetail,\n      });\n    }\n  };\n\n  console.log(ENV.getUserKeys(\"_id\")._id, \"user id\");\n  console.log(nftDetail, \"nftDetail\");\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        console.log(res, \"exchangeapires\");\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <section className=\"padding-wrapper nft-detail\">\n            <div className=\"container\">\n              <div className=\"row g-3\">\n                <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n                  <div className=\"row\">\n                    <div className=\"col-12 order-2 order-md-1\">\n                      <div className=\"nftDetail-accordion\">\n                        <div\n                          className=\"accordion accordion-flush \"\n                          id=\"accordionFlushExample\"\n                        >\n                          {/* <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                              >\n                                <img\n                                  src={PriceHistoy}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price history\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseOne\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingOne\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div> */}\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingTwo\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={OfferIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Offers\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"table-container\">\n                                  <table class=\"table table-borderless\">\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Floor Difference</th>\n                                        <th scope=\"col\">Expiration</th>\n                                        <th scope=\"col\">From</th>\n                                      </tr>\n                                    </thead>\n                                    <tbody>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={ListingIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Item listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"table-container listing-table\">\n                                  <table class=\"table table-borderless\">\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Expiration</th>\n                                        <th scope=\"col\">From</th>\n                                        <th scope=\"col\">{\"\"}</th>\n                                      </tr>\n                                    </thead>\n                                    <tbody>\n                                      <tr>\n                                        <th scope=\"row\">0.025</th>\n                                        <td>$77.50</td>\n                                        <td>in a day</td>\n                                        <td>BBC1B3</td>\n                                        <td>\n                                          <button>Buy</button>\n                                        </td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-11 col-md-12 col-lg-7 col-xl-5 order-1 order-md-2 mx-auto mb-5 mb-md-0  mx-md-0\">\n                      <div className=\"collection-filter-accordion nft-stats-accordion\">\n                        <div\n                          className=\"accordion accordion-flush \"\n                          id=\"accordionFlushExample\"\n                        >\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingFour\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseFour\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseFour\"\n                              >\n                                Properties\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseFour\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingFour\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"row g-2 justify-content-center align-items-center\">\n                                  {propertiesData &&\n                                    propertiesData.map((data) => {\n                                      return (\n                                        <div className=\"col-6 col-sm-4 col-md-6\">\n                                          <div className=\"properties-content-container d-flex flex-column justify-content-center align-items-center text-center\">\n                                            <div className=\"properties-content\">\n                                              <span>{data.subTitle}</span>\n                                              <h3>{data.title}</h3>\n                                              <p>{data.content}</p>\n                                            </div>\n                                          </div>\n                                        </div>\n                                      );\n                                    })}\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSix\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSix\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSix\"\n                              >\n                                Stats\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSix\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSix\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSeven\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSeven\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSeven\"\n                              >\n                                Levels\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSeven\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSeven\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingEight\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseEight\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseEight\"\n                              >\n                                Boosts\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseEight\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingEight\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingNine\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseNine\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseNine\"\n                              >\n                                Details\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseNine\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingNine\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"contact-address d-flex justify-content-between\">\n                                  <p>Contract Address</p>\n                                  <span>0x7227...3335</span>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Token ID</p>\n                                  <p>1584563428....</p>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Token Standard </p>\n                                  <p>ERC-721</p>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Blockchain </p>\n                                  <p>Polygon</p>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n                  <Card className=\"auction-card detail-card\">\n                    <div className=\"auction-img-wrapper\">\n                      <Card.Img\n                        variant=\"top\"\n                        src={nftDetail.image}\n                        alt=\"AuctionTopImg\"\n                      />\n                    </div>\n                    <Card.Body>\n                      <div>\n                        <span>Current price</span>\n                        <h3>\n                          {nftDetail.currentPrice}\n                          <span>\n                            (${\" \"}\n                            {(nftDetail.currentPrice * exchangeRate).toFixed(2)}\n                            )\n                          </span>\n                        </h3>\n                      </div>\n                      <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                        <div className=\"d-flex align-items-center\">\n                          <img\n                            src={ClockIcon}\n                            alt=\"clock-icon\"\n                            className=\"me-1\"\n                          />\n                          <span>Sale ends March 8, 2022 at 7:40am PKT </span>\n                        </div>\n                        <div className=\"likes-container d-flex align-items-center\">\n                          <span>\n                            {nftDetail.likeCount ? nftDetail.likeCount : 0}\n                          </span>\n                          <img\n                            src={HeartIcon}\n                            alt=\"heart-icon\"\n                            className=\"ms-1\"\n                          />\n                        </div>\n                      </div>\n                      <button\n                        className=\"btn btn-linear-gradient d-flex align-items-center justify-content-center w-75 mx-auto\"\n                        onClick={() => handleRouting()}\n                      >\n                        <p>\n                          {ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId\n                            ? \"Sell\"\n                            : \"Buy Now\"}\n                        </p>\n                      </button>\n                    </Card.Body>\n                  </Card>\n                  <div className=\"detail-description-content mt-5\">\n                    <div className=\"d-flex align-items-center mb-3\">\n                      <img\n                        src={DescriptionIcon}\n                        alt=\"descriptionIcon\"\n                        className=\"me-1\"\n                      />\n                      <h6>Discription</h6>\n                    </div>\n                    <p>{nftDetail.description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-0 mt-md-4 order-3\">\n                  <div className=\"nftDetail-accordion\">\n                    <div\n                      className=\"accordion accordion-flush \"\n                      id=\"accordionFlushExample\"\n                    >\n                      <div className=\"accordion-item\">\n                        <h2 className=\"accordion-header\" id=\"flush-headingTen\">\n                          <button\n                            className=\"accordion-button collapsed\"\n                            type=\"button\"\n                            data-toggle=\"collapse\"\n                            data-target=\"#flush-collapseTen\"\n                            aria-expanded=\"false\"\n                            aria-controls=\"flush-collapseTen\"\n                          >\n                            <img\n                              src={ActivityIcon}\n                              alt=\"price-history\"\n                              className=\"me-2\"\n                            />\n                            Activity\n                          </button>\n                        </h2>\n                        <div\n                          id=\"flush-collapseTen\"\n                          className=\"accordion-collapse collapse\"\n                          aria-labelledby=\"flush-headingTen\"\n                        >\n                          <div className=\"accordion-body\">\n                            <div className=\"table-container\">\n                              <table class=\"table table-borderless\">\n                                <thead>\n                                  <tr>\n                                    <th scope=\"col\">Event</th>\n                                    <th scope=\"col\">Price</th>\n                                    <th scope=\"col\">From</th>\n                                    <th scope=\"col\">To</th>\n                                    <th scope=\"col\">Date</th>\n                                  </tr>\n                                </thead>\n                                <tbody>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                </tbody>\n                              </table>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n\n                      <div className=\"accordion-item\">\n                        <h2\n                          className=\"accordion-header\"\n                          id=\"flush-headingEleven\"\n                        >\n                          <button\n                            className=\"accordion-button collapsed\"\n                            type=\"button\"\n                            data-toggle=\"collapse\"\n                            data-target=\"#flush-collapseEleven\"\n                            aria-expanded=\"false\"\n                            aria-controls=\"flush-collapseEleven\"\n                          >\n                            <img\n                              src={MoreCollectionIcon}\n                              alt=\"price-history\"\n                              className=\"me-2\"\n                            />\n                            More from this collection\n                          </button>\n                        </h2>\n                        <div\n                          id=\"flush-collapseEleven\"\n                          className=\"accordion-collapse collapse\"\n                          aria-labelledby=\"flush-headingEleven\"\n                        >\n                          <div className=\"accordion-body\">\n                            <div className=\"row justify-content-center align-items-center g-3\">\n                              {nftsList && nftsList.length > 0 ? (\n                                nftsList.map((listing) => {\n                                  return (\n                                    <div className=\"col-6 col-sm-6 col-md-4 col-lg-2 px-1\">\n                                      <ListingCards\n                                        CardImg={listing.image}\n                                        name={listing.name}\n                                        price={listing.currentPrice}\n                                        // usd={\n                                        //   listing.currentPrice * exchangeRate\n                                        // }\n                                        id={listing._id}\n                                      />\n                                    </div>\n                                  );\n                                })\n                              ) : (\n                                <p className=\"text-center mt-4\">\n                                  No NFTs Found\n                                </p>\n                              )}\n                            </div>\n                            <div className=\"mt-4 detail-btn-collection text-center\">\n                              {nftsList.length > 0 && (\n                                <button className=\"btn btn-rounded-bordered\">\n                                  View collection\n                                </button>\n                              )}\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            {/* ///////////////////////////////////// Modal */}\n            <div className=\"modal-wrapper\">\n              {false && (\n                <Modal\n                  centered\n                  size=\"lg\"\n                  // className=\"place-bid-modal\"\n                  show={true}\n                  // onHide={this.closeModal}\n                >\n                  <Modal.Header className=\"text-center modal-title-wrapper text-white\">\n                    <Modal.Title>\n                      {2 === 2 ? \"Place A Bid\" : \"Make An Offer\"}\n                    </Modal.Title>\n                  </Modal.Header>\n                  {/* {\n                                isSubmitted && errors &&\n                                <Modal.Body className=\"row pt-2 pb-0\">\n                                    <div className=\"col-12\">\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\n                                    </div>\n                                </Modal.Body>\n                            } */}\n                  <Modal.Body>\n                    <div className=\"price-wrapper d-flex\">\n                      <div className=\"price-text position-relative\">\n                        <div className=\"text-white mb-2 absolute-wrapper\">\n                          <b>Price</b>\n                        </div>\n                        <div className=\"text-right mb-2\">\n                          <i className=\"fas fa-exclamation-circle ml-2 text-white\" />\n                        </div>\n                        <div className=\"d-flex\">\n                          <select\n                            className=\"form-control currency-options\"\n                            id=\"currency\"\n                            name=\"nftConfig.price.currency\"\n                            onChange={(e) => this.onChange(e)}\n                          >\n                            {currencies &&\n                              currencies.map((currency, index) => {\n                                return (\n                                  <option key={index} value={currency.symbol}>\n                                    {currency.symbol}\n                                  </option>\n                                );\n                              })}\n                          </select>\n                          <input\n                            type=\"text\"\n                            placeholder=\"Amount\"\n                            className=\"amount-btn ml-3\"\n                            name=\"nftConfig.price.amount\"\n                            placeholder=\"Amount\"\n                            className=\"amount-btn ml-3\"\n                            style={{ borderRadius: \"4px\" }}\n                            onChange={(e) => this.onChange(e)}\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            defaultValue={nftConfig.price.amount}\n                            required\n                          />\n                          <div className=\"text-right mb-2 dollar-wrapper\">\n                            $ 0.00\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </Modal.Body>\n                  <Modal.Body className=\"text-danger\">\n                    {validator.message(\n                      \"amount\",\n                      nftConfig.price.amount,\n                      \"required\"\n                    )}\n                  </Modal.Body>\n                  {/* <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\n                                <div className=\"offer-expiration-wrapper text-white\">\n                                    <b>Offer Expiration</b>\n                                </div>\n                                <div>\n                                    <div className=\"d-flex\">\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\n                                            style={{\n                                                padding: \"7px 55px 7px 55px\",\n                                                border: \"none\",\n                                                outline: \"none\",\n                                                borderRadius: \"4px\",\n                                                background: \"#808080\",\n                                                display: \"flex\",\n                                                alignItems: \"center\",\n                                                cursor: \"pointer\",\n                                                height: \"51px\",\n                                                color: \"#000\"\n                                            }}\n                                        >\n                                            {\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\n                                                    return (\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\n                                                    )\n                                                })\n                                            }\n                                        </select>\n                                        <div>\n                                            <div className=\"mr-auto budle-wrapper\">\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\n                                            </div>\n                                            <span className=\"text-danger message\">{validator.message('amount', nftConfig.price.amount, 'required')}</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </Modal.Body> */}\n                  <Modal.Body className=\"justify-content-center align-items-center\">\n                    <div className=\"d-flex justify-content-around place-bid-btn\">\n                      <button\n                        className=\"ethereum-btn mr-3 place-bid-ethereum-btn\"\n                        disabled={loader}\n                        // onClick={() => this.submit()}\n                      >\n                        {2 === 2 ? initData.bidBtn : initData.bidBtn}\n                      </button>\n                      {/* <button className=\"ethereum-btn\">Add funds</button> */}\n                    </div>\n                  </Modal.Body>\n                  <Modal.Footer>\n                    <button\n                      className=\"btn banner-btn btn-primary\"\n                      // onClick={this.closeModal}\n                    >\n                      Close\n                    </button>\n                  </Modal.Footer>\n                </Modal>\n              )}\n            </div>\n          </section>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state, \"state in nft detail=>\"),\n  {\n    nftDetail: state.nft.nftsData,\n    nftsAuth: state.nft.nftsAuth,\n    nftsByCollection: state.nft.nftsByCollection,\n    nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  getNFT,\n  getNFTsByCollection,\n})(NFTDetail);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user-profile/UserProfile.js",["1364","1365","1366","1367","1368","1369","1370","1371","1372","1373","1374","1375","1376","1377","1378","1379","1380","1381","1382","1383","1384","1385","1386","1387","1388","1389","1390","1391","1392","1393","1394","1395","1396"],"import React, { useState,useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport \"./UserProfile.css\";\nimport { ENV } from \"../../config/config\";\nimport Avatar from \"../../assets/images/detail-avatar.png\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { ListingImg } from \"../../assets/assets\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\nimport { getProfileNfts, beforeNFT, getMyLikedNfts } from \"../nfts/nfts.action\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport {getUserById,beforeUser} from '../user/user.action';\n\n\nconst UserProfile = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [nftsCopy, setNFTsCopy] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [user,setUser]=useState('')\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n  });\n  const [menuFilter, setMenuFilter] = useState(\"\");\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const priceoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  useEffect(() => {\n    let qs = { ownerId: ENV.getUserKeys(\"_id\")._id };\n    console.log(qs, \"qs for user profile\");\n    qs = ENV.objectToQueryString(qs);\n    props.getProfileNfts(qs);\n    let likedNftsQs = { userId: ENV.getUserKeys(\"_id\")._id };\n    likedNftsQs = ENV.objectToQueryString(likedNftsQs);\n    props.getMyLikedNfts(likedNftsQs);\n    props.getUserById(ENV.getUserKeys(\"_id\")._id)\n  }, []);\n\n  useEffect(() => {\n    if (props.profileNFTsStatus) {\n      if (!menuFilter) {\n        const Nfts = props.profileNFTs.nfts.filter(\n          (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n        );\n        setNFTs(Nfts);\n        setNFTsCopy(props.profileNFTs.nfts);\n        setLoader(false);\n        setFilterationLoader(false);\n      } else {\n        setNFTsCopy(props.profileNFTs.nfts);\n        handleNftFilter(menuFilter);\n        setLoader(false);\n        setFilterationLoader(false);\n      }\n    }\n  }, [props.profileNFTsStatus]);\n\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(()=>{\n    const {individualUserAuth,individualUser}=props;\n    if(individualUserAuth){\n      setUser(individualUser)\n    }\n  },[props.individualUserAuth])\n\n  const ChangeTooltip = () =>\n    setTimeout(() => {\n      setAddressCopied(false);\n    }, 1000);\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      newest,\n      highToLow,\n    } = filter;\n\n    // if (!collectionIdFilter) collectionIdFilter = collectionId;\n    // if (!gtePriceFilter) gtePriceFilter = gtePrice;\n    // if (!ltePriceFilter) ltePriceFilter = ltePrice;\n    // if (!categoryIdFilter) categoryIdFilter = categoryId;\n    // if (!oldestFilter) oldestFilter = oldest;\n    // if (!lowToHighFilter) lowToHighFilter = lowToHigh;\n    // if (!highToLowFilter) highToLowFilter = highToLow;\n    // if (!newestFilter) newestFilter = newest;\n\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    nftQS.ownerId = ENV.getUserKeys(\"_id\")._id;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"qs indknf\");\n    props.getProfileNfts(qs);\n  };\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n    console.log(value, \"value\");\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      page,\n      limit,\n      id,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n  const handleLikesTogleApi = (nftId, status) => {\n   \n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n    // setNFTs(nfts);\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  const handleNftFilter = (id) => {\n    if (id === \"Collected\") {\n      const Nfts = nftsCopy.filter(\n        (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else if (id === \"Created\") {\n      const Nfts = nftsCopy.filter(\n        (item) =>\n          item.ownerId === ENV.getUserKeys(\"_id\")._id &&\n          item.creatorId === ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else {\n      handleFavFilter();\n    }\n  };\n\n  const handleFavFilter = () => {\n    let favNfts = [];\n    nftsCopy.map((item) => {\n      let foundNft = likedNfts.find((liked) => liked.nftId === item._id);\n      if (foundNft) {\n        favNfts.push(item);\n      }\n    });\n\n    setNFTs(favNfts);\n  };\n\n  const accountAddress = \"0xe0106f010067b130e4c96f119c214c30c94cead1\";\n  const menuData = [\"Collected\", \"Created\", \"Favourited\"];\n  console.log(user,\"user\")\n\n  return (\n    <>\n      <NavbarMain />\n      <div className=\"collection-detail-hero\">\n        <img src={BannerImg} alt=\"BannerImg\" />\n      </div>\n      <div className=\"collection-detail-content\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12\">\n              <div className=\"collection-owner-avatar text-center\">\n                <img src={Avatar} alt=\"owner-avatar\" />\n              </div>\n              <div className=\"collection-owner-detail text-center mt-3\">\n                {\n                  user &&\n                <div className=\"collection-owner-name\">\n                  <h3>{user.username?user.username:'unnamed'}</h3>\n                </div>\n                }\n                <div\n                  className=\"user-address mt-4 d-flex align-items-center \"\n                  onClick={() => {\n                    navigator.clipboard.writeText(accountAddress);\n                    setAddressCopied(true);\n                    ChangeTooltip();\n                  }}\n                >\n                  <i className=\"fab fa-ethereum\"></i>\n                  <span>{isAddressCopied ? \"Copied\" : \"Copy\"}</span>\n                  {\n                 user &&\n                  <p className=\"acc-adress\">\n                    {user.address.slice(0, 10) +\n                      \"...\" +\n                      user.address.slice(-10)}\n                  </p>\n                  }\n                </div>\n                <p>\n                  Joined <span>February 2022</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div className=\"collections-listing padding-wrapper\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12\">\n                <div className=\"explore-collection-section\">\n                  <div className=\"explore-collection-nav\">\n                    <div className=\"d-flex justify-content-center justify-content-md-end align-items-center\">\n                      {menuData.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleNftFilter(item);\n                              setMenuFilter(item);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img src={SearchIcon} alt=\"search-icon\" className=\"ms-3\" />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {priceoptions &&\n                      priceoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Chains={filterData.chains}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                <div className=\"row g-3\">\n                  {filterationLoader ? (\n                    <div className=\"text-center\">\n                      <div\n                        class=\"spinner-border text-secondary text-white \"\n                        role=\"status\"\n                      >\n                        <span class=\"sr-only\">Loading...</span>\n                      </div>\n                    </div>\n                  ) : nfts && nfts.length > 0 ? (\n                    nfts.map((listing) => {\n                      return (\n                        <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                          <ListingCards\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            // userProfile\n                          />\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-white text-center mt-5\">No NFTs Found</p>\n                  )}\n                </div>\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      props.profileNFTs.pagination > nfts.length &&\n                      nfts.length > 10 && (\n                        <button\n                          className=\"btn btn-linear-gradient px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state,\"state in userProfile\"),\n  {\n  profileNFTs: state.nft.profileNFTs,\n  profileNFTsStatus: state.nft.profileNFTsStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  individualUser:state.user.individualUser,\n  individualUserAuth:state.user.individualUserAuth,\n});\n\nexport default connect(mapStateToProps, {\n  getProfileNfts,\n  beforeNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  getUserById,\n  beforeUser\n})(UserProfile);\n\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/sell-nft/SellNFT.js",["1397","1398","1399","1400","1401","1402","1403","1404","1405","1406","1407","1408","1409","1410","1411","1412"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./SellNFT.css\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport PriceIcon from \"../../assets/images/priceIcon.svg\";\nimport DollarIcon from \"../../assets/images/dollarIcon.svg\";\nimport FeeIcon from \"../../assets/images/feeIcon.svg\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFT, upsertNFT } from \"../nfts/nfts.action\";\n\nconst { currencies, dateRangeInitialSettings, serviceFee } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  listingSchedule: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  // if user includes reserve price\n  reservePrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n};\n\nconst SellNFT = (props) => {\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [activeBidBtn, setActiveBidBtn] = useState(false);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nft, setNft] = useState(null);\n  const [loader, setLoader] = useState(true); // NFT loader\n  const [reserveBuyer, setReserveBuyer] = useState(false);\n  const [reservePrice, setReservePrice] = useState(false);\n  const [tokensData, setTokensData] = useState([]);\n  const location = useLocation();\n  console.log(location, \"location\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    const { itemId } = props.match.params;\n    // if (itemId) props.getNFT(window.atob(itemId));\n    // else props.history.push(\"/explore-all\");\n    getTokens();\n  }, []);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNft(nft);\n      setLoader(false);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const { nft } = props.nft.nftsData;\n      // const pathname = nft.sellingMethod === 1 ? '/explore-all' : '/auctions'\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n\n  // when an error is received\n  useEffect(() => {\n    setLoader(false);\n  }, [props.error]);\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) data = fixedPriceConfig;\n    else data = timedAuctionConfig;\n\n    const keys = name.split(\".\"); // fixedPriceConfig, price, currency\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) setFixedPriceConfig({ ...data });\n    else setTimedAuctionConfig({ ...data });\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n  const submit = () => {\n    let payload='';\n    console.log(sellingMethod,\"sellingMethod\")\n    if(sellingMethod===2){\n\n      payload = {\n       _id: location.state._id,\n       sellingMethod,\n       sellingConfig:JSON.stringify(timedAuctionConfig),\n     };\n   \n    }\n    else {\n      payload = {\n        _id: location.state._id,\n        sellingMethod, \n        sellingConfig:JSON.stringify(fixedPriceConfig),\n      };\n      // console.log(payload,\"payload\")\n      \n\n    }\n\n    //  return  \" \"\n\n    let test = new Date(timedAuctionConfig.duration.endDate).getTime();\n    let time = timedAuctionConfig.duration.endTime;\n\n    var r = Number(time.split(\":\")[0]) * 60 + Number(time.split(\":\")[1]) * 1000;\n    //\n    const timeInMiliSeconds = r + test;\n\n    // console.log('yoken data', tokensData)\n    // const nftToken=tokensData.data.find((item)=>item?.nftId===nft?._id)\n\n    //  if(nftToken){\n    //   sellingMethod==1?SellOnFixedPrice(nftToken?.nftToken,fixedPriceConfig.price.amount):openNFTForBidding(nftToken.nftToken,timeInMiliSeconds)\n\n    setLoader(true);\n\n    var formData = new FormData();\n    console.log(payload, \"payload\");\n    for (const key in payload) formData.append(key, payload[key]);\n\n    props.upsertNFT(\"edit\", formData, \"PUT\");\n    //  }\n    //  else {\n    //   toast.error(\"there was an issue while creating nft, please try later\")\n    //  }\n  };\n\n  const getTokens = () => {\n    const url = process.env.REACT_APP_BASE_URL + \"nftTokens/tokens\";\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        setTokensData(data);\n      })\n      .catch((error) => {\n        console.log(error, \"error in catch blcok\");\n      });\n  };\n  return (\n    <>\n      <NavbarMain />\n      <section className=\"padding-wrapper nft-detail\">\n        <div className=\"container\">\n          <div className=\"row g-3\">\n            <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n              <div className=\"row\">\n                <div className=\"col-12 order-2 order-md-1\">\n                  <div className=\"intro mb-5\">\n                    <div className=\"intro-content\">\n                      <span>SellNFTs</span>\n                      <h3 className=\"mb-0\">List of bundles for sale</h3>\n                    </div>\n                  </div>\n                  <div className=\"sale-btn-container mt-5 mb-4\">\n                    <button\n                      className={` ${\n                        activeBtn === 0\n                          ? \"sell-btn-active\"\n                          : \"sell-btn-not-active\"\n                      } me-3 `}\n                      onClick={() => {\n                        setActiveBtn(0);\n                        setSellingMethod(1);\n                      }}\n                    >\n                      <img\n                        src={DollarIcon}\n                        alt=\"fixedPrize\"\n                        className=\"me-1 me-sm-2\"\n                      />\n                      Fixed Prize\n                    </button>\n                    <button\n                      className={` ${\n                        activeBtn === 1\n                          ? \"sell-btn-active\"\n                          : \"sell-btn-not-active\"\n                      } `}\n                      onClick={() => {\n                        setActiveBtn(1);\n                        setSellingMethod(2);\n                      }}\n                    >\n                      <img src={ClockIcon} alt=\"timeAuction\" className=\"me-2\" />\n                      Timed Auction\n                    </button>\n                  </div>\n                  <div className=\"nftDetail-accordion\">\n                    <div\n                      className=\"accordion accordion-flush \"\n                      id=\"accordionFlushExample\"\n                    >\n                      {activeBtn === 0 ? (\n                        <>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseOne\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingOne\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-price-container mx-auto\">\n                                  <div className=\"sell-price-inp d-flex align-items-center\">\n                                    <div className=\"sell-price-currency text-center\">\n                                      <span> ETH </span>\n                                    </div>\n                                    <input\n                                      type=\"text\"\n                                      name=\"fixedPriceConfig.price.amount\"\n                                      placeholder=\"Amount\"\n                                      style={{\n                                        borderRadius: \"4px\",\n                                      }}\n                                      onChange={(e) => onChange(e)}\n                                      onKeyDown={(e) =>\n                                        decimalNumberValidator(e)\n                                      }\n                                      defaultValue={\n                                        fixedPriceConfig.price.amount\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingTwo\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Schedule Listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"fixedPriceConfig.listingSchedule\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </>\n                      ) : (\n                        <>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Bid option\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-bid-opt-container mx-auto\">\n                                  <button\n                                    className={`${\n                                      activeBidBtn ? \"sell-bid-active\" : \"\"\n                                    } sell-bid-opt-btn`}\n                                    onClick={() =>\n                                      setActiveBidBtn(!activeBidBtn)\n                                    }\n                                  >\n                                    Sell To The Highest Bidder\n                                  </button>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingFour\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseFour\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseFour\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseFour\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingFour\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-price-container mx-auto\">\n                                  <div className=\"sell-price-inp d-flex align-items-center\">\n                                    <div className=\"sell-price-currency text-center\">\n                                      <span> ETH </span>\n                                    </div>\n                                    <input\n                                      type=\"text\"\n                                      name=\"timedAuctionConfig.startPrice.amount\"\n                                      placeholder=\"Amount\"\n                                      style={{\n                                        borderRadius: \"4px\",\n                                      }}\n                                      onChange={(e) => onChange(e)}\n                                      onKeyDown={(e) =>\n                                        decimalNumberValidator(e)\n                                      }\n                                      defaultValue={\n                                        fixedPriceConfig.price.amount\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSix\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSix\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSix\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Duration\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSix\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSix\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"timedAuctionConfig.duration\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"timedAuctionConfig.duration.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"timedAuctionConfig.duration.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"row\">\n                    <div className=\"col-10 col-sm-6 col-md-8 col-lg-6  col-xl-4\">\n                      <div className=\"sell-fee-container\">\n                        <div className=\"sell-fee-title d-flex align-items-center mb-2\">\n                          <img src={FeeIcon} alt=\"feeIcon\" className=\"me-2\" />\n                          <h6>Fees</h6>\n                        </div>\n                        <div className=\"sell-fee-content d-flex align-items-center justify-content-between mb-1\">\n                          <p>Service Fee</p>\n                          <p>2.5 %</p>\n                        </div>\n                        <div className=\"sell-fee-content d-flex align-items-center justify-content-between\">\n                          <p>Creator Royalty</p>\n                          <p>3 %</p>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-12 text-center mt-5\">\n                      <button\n                        className=\"sell-btn-active px-5\"\n                        onClick={() => submit()}\n                      >\n                        {\" \"}\n                        Complete Listing{\" \"}\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n              <Card className=\"auction-card detail-card\">\n                <div className=\"auction-img-wrapper\">\n                  <Card.Img\n                    variant=\"top\"\n                    src={location.state.image}\n                    alt=\"AuctionTopImg\"\n                  />\n                </div>\n                <Card.Body>\n                  <div>\n                    <span>Current price</span>\n                    <h3>\n                      {location.state.currentPrice}\n                      <span>($2.28)</span>\n                    </h3>\n                  </div>\n                  <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                    <div className=\"d-flex align-items-center\">\n                      <img src={ClockIcon} alt=\"clock-icon\" className=\"me-1\" />\n                      <span>Sale ends March 8, 2022 at 7:40am PKT </span>\n                    </div>\n                    <div className=\"likes-container d-flex align-items-center\">\n                      <span>{}</span>\n                      <img src={HeartIcon} alt=\"heart-icon\" className=\"ms-1\" />\n                    </div>\n                  </div>\n                </Card.Body>\n              </Card>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n})(SellNFT);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/owncollection/OwnCollection.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/navbar-main/NavbarMain.js",["1413","1414","1415","1416"],"import React from \"react\";\nimport { Link, useHistory, useLocation } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const history = useHistory();\n  const location = useLocation();\n\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n    console.log(\"clicked\");\n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"dark\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <Navbar.Brand to=\"/\" href=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </Navbar.Brand>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className=\"mx-xl-auto\" defaultActiveKey={`${location.pathname}`}>\n              <Nav.Link to=\"/\" href=\"/\" className=\"nav-main-link\" >\n                Home\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                activeKey={1}\n                className={`nav-main-link dropdown-bg `}\n               \n              >\n                <NavDropdown.Item\n                  to=\"/explore/exploreAll\"\n                  href=\"/explore/exploreAll\"\n                  eventKey={1}\n                  className=\"nav-main-link main-nav-dd-items \"\n                >\n                  Explore All\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/explore/allNFT\"\n                  href=\"/explore/allNFT\"\n                  className=\"nav-main-link main-nav-dd-items\"\n                  eventKey={2}\n                >\n                  All NFT\n                </NavDropdown.Item>\n           \n              </NavDropdown>\n\n            \n              <Nav.Link to=\"/create\" href=\"/create\" className=\"nav-main-link\">\n                Create\n              </Nav.Link>\n              <Nav.Link\n                to=\"/userprofile\"\n                href=\"/userprofile\"\n                className=\"nav-main-link\"\n              >\n                Profile\n              </Nav.Link>\n           \n\n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div class=\"search-box mt-1 mt-sm-0 d-sm-none\">\n                <input\n                  class=\"search-txt \"\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                />\n                <a class=\"search-btn\" href=\"#\">\n                  <img src={SearchIcon} alt=\"search-icon\" />\n                </a>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div class=\"search-box \">\n              <input\n                class=\"search-txt\"\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n              />\n              <a class=\"search-btn me-1 mt-1\" href=\"#\">\n                <img src={SearchIcon} alt=\"search-icon\" />\n              </a>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/buy-sell/Buysell.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions-cards/AuctionsCards.js",["1417","1418","1419","1420","1421"],"import React, { useEffect, useState } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.svg\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../config/config\";\n\nimport { connect } from \"react-redux\";\n\nimport \"./AuctionsCard.css\";\nimport { propTypes } from \"react-recaptcha\";\n\nconst AuctionsCards = (props) => {\n  const { countDownRenderer } = ENV;\n  const history = useHistory();\n  // console.log(auctions,\"auctions123\")\n  return (\n    <Card\n      className=\"auction-card mx-2\"\n      onClick={() => history.push(`nftdetail/${props.id}`)}\n    >\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={props.image} alt=\"AuctionTopImg\" />\n        <div className=\"auction-countdown mb-3\">\n          <Countdown date={props.endDate} renderer={countDownRenderer} />\n        </div>\n      </div>\n      <Card.Body>\n        <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n          <div className=\"auction-card-avatar d-flex align-items-center\">\n            <img src={AvatarImg} alt=\"AvatarImg\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <span className=\"ms-4\">9+ Place Bit</span>\n          </div>\n\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <Card.Title>{props.name}</Card.Title>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>\n              {\"Owned by \"}\n              {props.ownerName}\n            </p>\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state in nfts\"),\n  ({});\n\nexport default connect(mapStateToProps, {})(AuctionsCards);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections-cards/CollectionsCard.js",["1422","1423","1424","1425","1426","1427","1428"],"import React, { useEffect } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport Subimg1 from \"../../assets/images/cl-cr-subimg1.png\";\nimport Subimg2 from \"../../assets/images/cl-cr-subimg2.png\";\nimport Subimg3 from \"../../assets/images/cl-cr-subimg3.png\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport \"./CollectionsCard.css\";\n\nconst CollectionsCard = ({\n  CardImg,\n  Subimg1,\n  Subimg2,\n  Subimg3,\n  name,\n  id,\n  collection,\n  userName,\n  NFTCount,\n  profileImage,\n}) => {\n  // const { name, image } = category;\n  const history = useHistory();\n\n  return (\n    <Card\n      className=\"collection-cards-container\"\n      onClick={() => {\n        history.push({\n          pathname: `/collection/detailPage/${id}`,\n          state: collection,\n        });\n      }}\n    >\n      <div className=\"row\">\n        <div className=\"col-12\">\n          <div className=\"row g-3\">\n            <div className=\"col-4 collection-subImg1\">\n              <img src={Subimg1} alt=\"subImg\" />\n            </div>\n            <div className=\"col-4 collection-subImg2\">\n              <img src={Subimg2} alt=\"subImg\" />\n            </div>\n            <div className=\"col-4 collection-subImg3\">\n              <img src={Subimg3} alt=\"subImg\" />\n            </div>\n            <div className=\"col-12 collection-mainImg\">\n              <img src={CardImg} alt=\"card-img\" />\n            </div>\n          </div>\n          <Card.Body>\n            <Card.Title>{name}</Card.Title>\n            <Card.Text>\n              {NFTCount}\n              {\" items\"}\n            </Card.Text>\n            <div className=\"d-flex align-items-center justify-content-between collection-card-footer\">\n              <div className=\"collection-footer-left d-flex align-items-center\">\n                {profileImage && (\n                  <img src={profileImage} alt=\"avatar-img\" className=\"me-2\" />\n                )}\n                <span>{userName}</span>\n              </div>\n              {/* <div className=\"collection-footer-right d-flex align-items-center\">\n                <img src={HeartIcon} alt=\"like-icon\" className=\"me-1\" onClick={()=>handleLikesTogle(id)} />\n                <span>212k</span>\n              </div> */}\n            </div>\n          </Card.Body>\n        </div>\n      </div>\n    </Card>\n  );\n};\n\nexport default CollectionsCard;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/card-slider/CardSlider.js",["1429","1430","1431","1432","1433","1434"],"import React, { Component } from \"react\";\nimport Slider from \"react-slick\";\n// import CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport SliderNextIcon from \"../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport \"./CardSlider.css\";\nimport TwitchPlayer from \"react-player/twitch\";\nimport { data } from \"jquery\";\n\nexport default class CardSlider extends Component {\n  // const CardSlider = () => {\n  constructor(props) {\n    super(props);\n    this.next = this.next.bind(this);\n    this.previous = this.previous.bind(this);\n  }\n  next() {\n    this.slider.slickNext();\n  }\n  previous() {\n    this.slider.slickPrev();\n  }\n\n  handleArrows = () => {\n    const { data, homeAuctions } = this.props;\n    if (data && data.length > 0) {\n      if (homeAuctions && data.length > 4) {\n        return true;\n      } else if (!homeAuctions && data.length > 3) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n  render() {\n    const { settings, data, homeAuction } = this.props;\n    console.log(homeAuction, \"homeAuction\");\n\n    return (\n      <div className=\"container\">\n        {this.handleArrows() && (\n          <div className=\"text-end\">\n            <button\n              className=\"card-slider-btn mb-4 me-3\"\n              onClick={this.previous}\n            >\n              {/* <img src={SliderPrevIcon} alt=\"SliderPrevButton\" /> */}\n              <i class=\"fas fa-arrow-left\"></i>\n            </button>\n            <button className=\"card-slider-btn mb-4\" onClick={this.next}>\n              {/* <img src={SliderNextIcon} alt=\"SliderNextButton\" /> */}\n              <i class=\"fas fa-arrow-right\"></i>\n            </button>\n          </div>\n        )}\n        <Slider ref={(c) => (this.slider = c)} {...settings}>\n          {this.props.children}\n        </Slider>\n      </div>\n    );\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero/component/slider.js",["1435","1436","1437","1438","1439"],"import \"./slider.css\";\nimport { useState } from \"react\";\nimport HeroCards from \"../../hero-cards/HeroCards\";\nimport SliderNextIcon from \"../../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../../auctions-cards/AuctionsCards\";\nimport { map } from \"jquery\";\n\nconst Slider = ({\n  setHandler,\n  sliderRadioButtons,\n  handleRadioInputs,\n  sliderChecked,\n}) => {\n  return (\n    <section id=\"slider\">\n      {sliderRadioButtons.map((item) => {\n        return (\n          <input\n            type=\"radio\"\n            name=\"slider\"\n            value={item.value}\n            checked={sliderChecked === item.value}\n            onChange={(e) => handleRadioInputs(e)}\n            id={item.id}\n          />\n        );\n      })}\n      <label for=\"s1\" id=\"slide1\" onClick={() => setHandler(1)}>\n        <HeroCards className=\"slide\" />\n        {/* <img\n          src=\"https://i.pinimg.com/originals/2b/de/de/2bdede0647e3cdf75b44ea33723201d9.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s2\" id=\"slide2\" onClick={() => setHandler(2)}>\n        <HeroCards className=\"slide\" />\n        {/* <AuctionsCards className=\"slide\" /> */}\n        {/* <img\n          src=\"https://images6.alphacoders.com/462/thumb-1920-462371.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s3\" id=\"slide3\" onClick={() => setHandler(3)}>\n        <HeroCards className=\"slide\" />\n        {/* <img src=\"https://wallpaperaccess.com/full/1154341.jpg\" alt=\"\" /> */}\n      </label>\n      <label for=\"s4\" id=\"slide4\" onClick={() => setHandler(4)}>\n        {/* <AuctionsCards className=\"slide\" /> */}\n        {/* <img src=\"https://wallpapercave.com/wp/wp2634222.jpg\" alt=\"\" /> */}\n        <HeroCards className=\"slide\" />\n      </label>\n      <label for=\"s5\" id=\"slide5\" onClick={() => setHandler(5)}>\n        <HeroCards className=\"slide\" />\n        {/* <img\n          src=\"https://images5.alphacoders.com/343/thumb-1920-343645.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s6\" id=\"slide6\" onClick={() => setHandler(6)}>\n        <HeroCards className=\"slide\" />\n      </label>\n      <label for=\"s7\" id=\"slide7\" onClick={() => setHandler(7)}>\n        {/* <AuctionsCards className=\"slide\" /> */}\n        <HeroCards className=\"slide\" />\n      </label>\n    </section>\n  );\n};\n\nexport default Slider;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/components/upload.js",["1440","1441","1442"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport { IoMdCloudUpload } from \"react-icons/io\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData\n}) => {\n  return (\n    <label\n      className=\"w-100\"\n      onDrop={(e) => onDrop(e)}\n      onDragOver={(e) => dragOver(e)}\n      onDragEnter={(e) => dragEnter(e)}\n      onDragLeave={(e) => dragLeave(e)}\n    >\n      <div className=\"upload-image-border p-4 position-relative\">\n        {imageURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" onClick={()=>clearData()} />\n            <img className=\"upload-image\" src={imageURL} alt=\"upload-image\" />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            {/* <IoMdCloudUpload className=\"img-upload-icon\"/> */}\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : videoURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <VideoComponent\n              videoUrl={videoURL}\n              videoStyles={videoStyles}\n              videoWidth=\"300\"\n            />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n          </div>\n        ) : audioSrc ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <AudioPlayer audioSrc={audioSrc} />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : (\n          <>\n            {\" \"}\n            <img\n              className=\"upload-image\"\n              src={Images.uploadImage}\n              alt=\"upload-image\"\n            />\n            <div className=\"upload-details text-center mt-2\">\n              <p>Drag and drop your file</p>\n              <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n            </div>\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={(e) => onFileChange(e, \"onChange\")}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </>\n        )}\n      </div>\n    </label>\n  );\n};\n\nexport default Upload;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore.action.js",["1443"],"\nimport { ENV } from './../../config/config';\nimport axios from 'axios'\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n        console.log(response);\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero-cards/HeroCards.js",["1444"],"import React from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.png\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport \"./HeroCards.css\";\n\nconst HeroCards = () => {\n  return (\n    <Card className=\"auction-card hero-card mx-2\">\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n        {/* <div className=\"auction-countdown mb-3\">\n          <Countdown date=\"2022/1/26 13:10:12\" renderer={countDownRenderer} />\n        </div> */}\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title>Music</Card.Title>\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <div className=\"auction-card-avatar d-flex align-items-center mb-4\">\n          <img src={AvatarImg} alt=\"AvatarImg\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <span className=\"ms-4\">9+ People Place Bit</span>\n        </div>\n\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owend by Jecica</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default HeroCards;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/filter-component/FilterComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/listing-cards/ListingCards.js",["1445","1446"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile &&\n          <div className=\"options-icon like-icon text-white\">\n          \n            { validateIfLiked(likedNfts, id) ? (\n              <div className=\"heart-filled-container d-flex align-items-end\">\n                <AiFillHeart\n                  className=\"heart-fill-icon \"\n                  onClick={() => {\n                    handleLikesTogleApi(id, \"dislike\");\n                    setToggle(!toggle);\n                  }}\n                />{\" \"}\n                <p> {likesCount ? likesCount : 0} </p>\n              </div>\n            ) : (\n              <img\n                src={HeartIcon}\n                alt=\"OptionsIcon\"\n                onClick={() => {\n                  handleLikesTogleApi(id, \"like\");\n                  setToggle(!toggle);\n                }}\n              />\n            )}\n          </div>\n          }\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"   onClick={() => history.push(`/nftdetail/${id}`)}>\n          <p>{ownerId===ENV.getUserKeys(\"_id\")._id?\"View\":\"Buy Now\"}</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/index.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/App.js",["1447"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/routes.js",["1448"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/index.js",["1449"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",["1450"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.reducer.js",["1451","1452"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.js",["1453","1454","1455","1456","1457","1458","1459","1460"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["1461"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore-all.js",["1462","1463","1464","1465","1466","1467","1468","1469","1470"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["1471"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/item-detail/