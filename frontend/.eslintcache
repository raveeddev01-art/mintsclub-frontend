9","usedDeprecatedRules":"822"},{"filePath":"1080","messages":"1081","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"822"},{"filePath":"1082","messages":"1083","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"1084","usedDeprecatedRules":"822"},{"filePath":"1085","messages":"1086","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"822"},{"filePath":"1087","messages":"1088","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"1089","usedDeprecatedRules":"822"},{"filePath":"1090","messages":"1091","errorCount":0,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"1092","usedDeprecatedRules":"822"},"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/index.js",[],["1093","1094"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/App.js",["1095"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/index.js",["1096"],"import { combineReducers } from 'redux'\nimport homeReducer from './../components/home/home.reducer'\nimport mintsReducer from '../redux/reducer/reducer'\nimport auctionReducer from './../components/auctions/auctions.reducer'\nimport nftReducer from './../components/nfts/nfts.reducer'\nimport userReducer from './../components/user/user.reducer'\nimport walletReducer from './../components/wallet/wallet.reducer'\nimport categoryReducer from './../components/categories/categories.reducer'\nimport collectionReducer from './../components/collections/collections.reducer'\nimport errorReducer from './shared/error/error.reducer'\nimport settingsReducer from '../components/footer/footer.reducer'\nimport faqReducer from '../components/faq/faq.reducer'\nimport offersReducer from '../components/offers/offers.reducer'\nimport bidsReducer from '../components/bids/bids.reducer'\nimport contactReducer from '../components/contact/contact.reducer'\nimport exploreAllReducer from '../components/explore/explore.reducer'\nimport createNftReducer from '../components/create-nft/create-nft-reducer'\n\nexport default combineReducers({\n    home: homeReducer,\n    dashboard:mintsReducer,\n    auction: auctionReducer,\n    nft: nftReducer,\n    user: userReducer,\n    wallet: walletReducer,\n    category: categoryReducer,\n    collection: collectionReducer,\n    error: errorReducer,\n    settings: settingsReducer,\n    faqs: faqReducer,\n    offer: offersReducer,\n    bid: bidsReducer,\n    contact: contactReducer,\n    explore:exploreAllReducer,\n    \n    \n})","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/gaTracker/gaTracket.js",["1097"],"import { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport ReactGA from \"react-ga\";\nimport { connect } from \"react-redux\";\nimport { useSelector } from \"react-redux\";\n\n\n\nconst useGaTracker = () => {\n    const step=useSelector((state)=>state.dashboard.currentStep)\n    const location = useLocation();\n    const [initialized, setInitialized] = useState(false);\n\n    useEffect(() => {\n        if (!window.location.href.includes(\"localhost\")) {\n        // ReactGA.initialize(\"UA-215431628-1\");r\n        ReactGA.initialize(\"UA-217435968-1\");\n\n        }\n        setInitialized(true);\n    }, []);\n\n    useEffect(() => {\n        if (initialized) {\n        \n            if(location.pathname === '/')\n            {\n\n                ReactGA.pageview(location.pathname + location.search );\n            }\n            else {\n                ReactGA.pageview(location.pathname + location.search + `/step${step}`);\n            }\n        }\n    }, [initialized, location, step]);\n};\n\nexport default useGaTracker;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/full-page-loader/full-page-loader.js",["1098"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/routes.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/auctions.reducer.js",["1099"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/reducer/reducer.js",["1100"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/home/home.reducer.js",["1101","1102"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.reducer.js",["1103"],"import { BEFORE_USER, SET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, GET_USER } from '../../redux/types';\n\nconst initialState = {\n    userData: null,\n    userAuth: false,\n    creatorsAuth: false,\n    topSellersAuth: false,\n    individualUserAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_USER:\n            return {\n                ...state,\n                userData: action.payload,\n                userAuth: true\n            }\n        case GET_USER:\n            return {\n                ...state\n            }\n        case SET_CREATORS:\n            return {\n                ...state,\n                creators: action.payload,\n                creatorsAuth: true\n            }\n        case TOP_SELLERS:\n            return {\n                ...state,\n                sellers: action.payload,\n                topSellersAuth: true\n            }\n        case SET_INDIVIDUAL_USER:\n            return {\n                ...state,\n                individualUser: action.payload,\n                individualUserAuth: true\n            }\n        case BEFORE_USER:\n            return {\n                ...state,\n                userData: null,\n                userAuth: false,\n                creatorsAuth: false,\n                topSellersAuth: false,\n                individualUserAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/categories/categories.reducer.js",["1104"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.reducer.js",["1105"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.reducer.js",["1106"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.reducer.js",["1107"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.reducer.js",["1108"],"import { BEFORE_COLLECTION, GET_COLLECTION, SET_AUTH_STATE, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION,MY_COLLECTIONS, ALL_COLLECTIONS,COLLECTION_CATEGORES } from '../../redux/types';\n\nconst initialState = {\n    collection: null,\n    collections: null,\n    allCollections:null,\n    pagination: null,\n    deleteAuth: false,\n    upsertAuth: false,\n    getAuth: false,\n    categories:null,\n    collectionFlag:false,\n    myCollections:null,\n    myCollectionsResult:false,\n  \n    \n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n            case ALL_COLLECTIONS:\n                return {\n                    ...state,\n                    collection: action.payload.allCollections,\n                    getAuth: true\n                }\n        case SET_AUTH_STATE:\n            return {\n                ...state,\n                getAuth: false\n            }\n\n        case UPSERT_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                upsertAuth: true\n            }\n        case DELETE_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                deleteAuth: true\n            }\n        case GET_COLLECTIONS:\n    \n            return {\n                ...state,\n                collections: action.payload.collections,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n            case MY_COLLECTIONS:\n        \n                return {\n                    ...state,\n                    myCollections:action.payload,\n                    myCollectionsResult:true,\n                }\n            case COLLECTION_CATEGORES:\n\n                return {\n                    ...state,\n                    categories: action.payload,\n                    collectionFlag:true\n\n                 \n                }\n        case BEFORE_COLLECTION:\n         \n            return {\n                ...state,\n                collection: null,\n                collections: null,\n                pagination: null,\n                deleteAuth: false,\n                upsertAuth: false,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/bids/bids.reducer.js",["1109"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            return {\n                ...state,\n                bids: action.payload.bids,\n                pagination: action.payload.pagination,\n                highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/nfts.reducer.js",["1110"],"import { BEFORE_NFT, GET_NFTS, GET_NFT, UPSERT_NFT,NFTALL,GET_NFTS_BY_COLLECTION, GET_MYLIKED_NFTS,GET_PROFILE_NFTS } from '../../redux/types';\n\nconst initialState = {\n    nftsData: {},\n    nftAll:{},\n    nftsAuth: false,\n    upsertAuth: false,\n    createNFTResult:[],\n    createNFTerror:false,\n    nftsByCollection:[],\n    nftsByCollectionStatus:false,\n    myLikedNfts:[],\n    myLikedNftsStatus:false,\n    profileNFTs:[],\n    profileNFTsStatus:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case UPSERT_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                upsertAuth: true\n            }\n        case GET_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n            case NFTALL:\n        \n                return {\n                    ...state,\n                    nftAll: action.payload,\n                }\n            \n        case GET_NFTS:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n        case BEFORE_NFT:\n            return {\n                ...state,\n                nftsData: {},\n                nftsAuth: false,\n                upsertAuth: false,\n                profileNFTsStatus:false,\n            }\n            \n            case GET_NFTS_BY_COLLECTION:\n                return {\n                    ...state,\n                    nftsByCollection:action.payload,\n                    nftsByCollectionStatus:true,\n\n                }\n                case  GET_MYLIKED_NFTS:\n                  \n                    return {\n                        ...state,\n                        myLikedNfts:action.payload,\n                        myLikedNftsStatus:true,\n                    }\n                    case GET_PROFILE_NFTS:\n                        return {\n                            ...state,\n                            profileNFTs:action.payload,\n                            profileNFTsStatus:true,\n                        }\n                    \n        default:\n            return {\n                ...state,\n               \n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.reducer.js",["1111"],"import { BEFORE_FAQ, GET_FAQS } from '../../redux/types';\n\nconst initialState = {\n    faqs: null,\n    faqsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FAQS:\n            return {\n                ...state,\n                faqs: action.payload,\n                faqsAuth: true\n            }\n        case BEFORE_FAQ:\n            return {\n                ...state,\n                faqs: null,\n                faqsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.reducer.js",["1112"],"import { BEFORE_CONTACT, CREATE_CONTACT } from '../../redux/types';\n\nconst initialState = {\n    contactAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case CREATE_CONTACT:\n            return {\n                ...state,\n                contactAuth: true\n            }\n        case BEFORE_CONTACT:\n            return {\n                ...state,\n                contactAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/home/home.js",["1113","1114","1115","1116","1117","1118","1119","1120"],"import React, { useEffect } from \"react\";\nimport { Table, Pagination } from \"react-bootstrap\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller2\";\nimport Collections from \"../collections/popular-collections\";\nimport MyCollections from \"../collections/my-collections\";\nimport Explore from \"../explore/explore-home\";\nimport Work from \"../work/work\";\nimport Authors from \"../authors/authors\";\nimport Header from \"../header/header\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n      {/* <Header /> */}\n      <NavbarMain />\n      <Hero />\n      {/* <button onClick={()=>Redirection('/explore-all')}>test cases</button>  */}\n      <Auctions />\n      {/* <AuctionsCards /> */}\n      <Work />\n      <TopSeller viewAll={\"View All\"} />\n      {/* <Collections /> */}\n      <PopularCollections />\n      {/* <CardSlider /> */}\n      {/* <Authors /> */}\n      {/* <MyCollections /> */}\n      {/* <Explore /> */}\n      <OwnCollection />\n      <Buysell />\n      <Footer />\n    </>\n  );\n}\n\nexport default Home;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore-all.js",["1121","1122","1123","1124","1125","1126","1127","1128","1129"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFTs } from \"../nfts/nfts.action\";\nimport { ENV } from \"../../config/config\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport ExploreItems from \"./explore-items\";\nimport NftCard from \"../collections/components/NftCard/NftCard\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { getCreators, beforeUser } from \"./../user/user.action\";\n\nconst initData = {\n  pre_heading: \"Explore\",\n  heading: \"Exclusive Digital Assets\",\n  content: \"\",\n  btn_1: \"Load More\",\n};\n\nfunction ExploreAll(props) {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const pathname = useHistory().location.pathname;\n\n  useEffect(() => {\n    window.scroll(0, 0);\n\n    // set intro section\n    if (pathname === \"/explore-all\") setIntro(true);\n\n    // get NFTs for explore section\n    getNFTs();\n    props.getCreators();\n  }, []);\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      //    console.log(props.user.sellers,\"sellers blah blah blah\");\n      setCreator(props.user.sellers);\n    }\n  }, [props.user.topSellersAuth]);\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      //    console.log(props.user.creators,\"sellers blah blah blah\");\n      setCreator(props.user.creators);\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n  // set NFTs for explore section\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nftsData } = props.nft;\n      // console.log(nftsData,\"nftsData==>\")\n      if (nftsData) {\n        // console.log(nftsData,\"checking nfts\" )\n        setNFTs(nftsData);\n        setNFTPagination(nftsData.pagination);\n        props.beforeNFT();\n\n        // setLoader(false)\n        if (props.setLoader) props.setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  // handle show load more button state when pagination is set\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  const loadMore = () => {\n    const { page, limit } = nftPagination;\n    setLoader(true);\n    // get more NFTs for explore section\n    getNFTs(1, limit * (page + 1));\n  };\n\n  const getNFTs = (page = 1, limit = 4) => {\n    const nftQS = { page, limit, explore: true };\n\n    if (props.collectionId) nftQS.collectionId = props.collectionId;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    props.getNFTs(qs);\n  };\n\n  //     <div className=\"row gx-5 p-4\">\n  //     {\n  //       nfts && nfts.map((nft)=>{\n  //     return (\n\n  // <div className=\"col-6 mt-5\" style={{}}>\n\n  //   <NftCard nft={nft}/>\n  // </div>\n  //     )\n  //       })\n  //     }\n  // console.log(nfts,\"checking nfts==>\")\n\n  return (\n    <section\n      className=\"explore-area\"\n      style={{ paddingTop: `${intro ? \"150\" : \"30\"}px` }}\n    >\n      {loader && <FullPageLoader />}\n      <div className=\"container\">\n        {intro && (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              <div className=\"intro text-center mb-4\">\n                <span>{initData.pre_heading}</span>\n                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                {/* <p>{initData.content}</p> */}\n              </div>\n            </div>\n          </div>\n        )}\n        <div className=\"row items gx-4 explore-items\">\n          {nfts && nfts.length > 0 && creators.length > 0 ? (\n            nfts.map((item, idx) => {\n              return (\n                <div className=\"col-3 mt-5\" style={{}}>\n                  <NftCard\n                    nft={item}\n                    creators={creators}\n                    userId={ENV.getUserKeys(\"_id\")._id}\n                  />\n                </div>\n                // <div key={`edth_${idx}`} className={`col-12 col-sm-6 col-lg-${props.lgCols ? props.lgCols : '3'} item explore-item`} data-groups={item.group ? item.group : '[\"art\",\"sports\"]'}>\n                //     <div className=\"card\">\n                //         <div className=\"image-over\">\n                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                //             </Link>\n                //         </div>\n                //         <div className=\"card-caption col-12 p-0\">\n                //             <div className=\"card-body\">\n                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                //                 </Link>\n                //                 <div className=\"seller d-flex align-items-center my-3\">\n                //                     <span>Owned By</span>\n                //                     <a href=\"/author\">\n                //                         <h6 className=\"ml-4 mb-0\">{\"usama asghar\"}</h6>\n                //                         {/* <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6> */}\n                //                     </a>\n                //                 </div>\n                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                //                     <span>{item.currentPrice}</span>\n                //                     <span>{\"0\"} of {\"5\"}</span>\n                //                 </div>\n                //                 {/* <a className=\"btn btn-bordered-white btn-smaller mt-3\" href=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</a> */}\n                //             </div>\n                //         </div>\n                //     </div>\n                // </div>\n              );\n            })\n          ) : (\n            <p className=\"text-center\">No Items Found to Exploree</p>\n          )}\n        </div>\n        {loadMoreBtn && (\n          <div className=\"row\">\n            <div className=\"col-12 text-center\">\n              <a\n                id=\"load-btn\"\n                className=\"btn btn-bordered-white mt-5\"\n                onClick={() => loadMore()}\n              >\n                {initData.btn_1}\n              </a>\n            </div>\n          </div>\n        )}\n        {/* <ExploreItems class1=\"explore-items\" class2=\"explore-item\" key=\"edth\" /> */}\n      </div>\n    </section>\n  );\n}\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs, getCreators })(\n  ExploreAll\n);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/live-auctions-list.js",["1130","1131","1132","1133","1134","1135","1136","1137","1138"],"import React, { useState, useEffect } from 'react';\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { beforeAuction, getLiveAuctions } from './auctions.action';\nimport { ENV } from '../../config/config';\nimport Countdown from 'react-countdown';\nimport {getCreators, beforeUser} from './../user/user.action';\nimport image from '../../assets/images/placeholder.png'\nconst { globalPlaceholderImage, countDownRenderer } = ENV\n\nconst initData = {\n    pre_heading: \"Auctions\",\n    heading: \"Live Auctions\",\n    content: \"\",\n    btn_1: \"Load More\"\n}\n\nconst LiveAuctions = (props) => {\n    const [pagination, setPagination] = useState(null);\n    const [auctions, setAuctions] = useState(null)\n    const [loader, setLoader] = useState(true) // auctions loader\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n    const [creators,setCreator]=useState([])\n\n    useEffect(() => {\n        window.scroll(0, 0)\n        // get live auctions\n        getLiveAuctions()\n        props.getCreators()\n    }, [])\n\n    useEffect(()=>{\n      \n        if(props.user.topSellersAuth ){\n        //    console.log(props.user.sellers,\"sellers blah blah blah\");\n           setCreator(props.user.sellers)\n           setLoader(false)\n           \n        }\n      },[props.user.topSellersAuth])\n    // set live auctions\n    useEffect(() => {\n        if (props.auction.getAuth) {\n            const { auctions, pagination } = props.auction\n            if (auctions) {\n                setAuctions(auctions)\n                setPagination(pagination)\n                props.beforeAuction()\n             \n            }\n        }\n    }, [props.auction.getAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (pagination)\n            setLoadMoreBtn((pagination.total > 0 && pagination.total > auctions.length && auctions.length > 0))\n    }, [pagination])\n\n    const loadMore = () => {\n        const { page, limit } = pagination\n        setLoader(true)\n\n        // get more live auctions\n        getLiveAuctions(1, limit * (page + 1))\n    }\n\n    const getLiveAuctions = (page = 1, limit = 8) => {\n        const qs = ENV.objectToQueryString({ page, limit })\n        props.getLiveAuctions(qs)\n    }\n    const filterCreator=(nft,field)=>{\n        const result= creators.find((item)=>item._id===nft.nftOwnerId)\n     \n        if(field===\"userName\"){\n\n         if(result?.username){\n       \n             return result?.username\n         }\n         else {\n             return \"no username found\"\n         }\n        }\n        else if(field==\"profileImage\"){\n            if(result?.profileImage)\n            {\n\n                return result?.profileImage\n            }\n            else {\n                return image\n            }\n        }\n\n\n       }\n\n\n\n    return (\n        <section className=\"live-auctions-area load-more padding-wrapper\">\n            {\n                loader ?\n                    <FullPageLoader /> :\n                    <div className=\"container\">\n                        <div className=\"row justify-content-center\">\n                            <div className=\"col-12 col-md-8 col-lg-7\">\n                                {/* Intro */}\n                                <div className=\"intro text-center\">\n                                    <span>{initData.pre_heading}</span>\n                                    <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                                    <p>{initData.content}</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"row items\">\n                            {auctions && auctions.length > 0 ?\n                                auctions.map((item, idx) => {\n                                    return (\n                                        <div className=\"col-4\" key={`auc_${idx}`} id={`#auc-${idx}`}>\n                                            <div className=\"card m-3\">\n                                                <div className=\"image-over\">\n                                                    <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                                        <img className=\"card-img-top\" src={item.image} alt=\"NFT image\" width=\"600\" height=\"600\" />\n                                                    </Link>\n                                                </div>\n                                                <div className=\"card-caption col-12 p-0\">\n                                                    <div className=\"card-body\">\n                                                        <div className=\"mb-3\">\n                                                            <Countdown\n                                                                // date={new Date(item.auctionEndDate) + 10000}\n                                                                date={1651851923270}\n                                                                renderer={countDownRenderer}\n                                                            />\n                                                        </div>\n                                                        <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                                            <h5 className=\"mb-0\">{item.name}</h5>\n                                                        </Link>\n                                                        <Link className=\"seller d-flex align-items-center my-3\" to={`/author`}>\n                                                            \n                                                           <img className=\"avatar-sm rounded-circle\" src={filterCreator(item,\"profileImage\")} alt=\"User Avatar\" />\n                                                             <span className=\"ml-2\">{filterCreator(item,\"userName\")}</span> \n                                                        </Link>\n                                                        <div className=\"card-bottom d-flex justify-content-between\">\n                                                            <span>{item.currentPrice} {ENV.currency}</span>\n                                                            <span>{item.sold} of {item.copies}</span>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    );\n                                })\n                                : <p className=\"text-center ml-3\">No Live Auctions Found</p>\n                            }\n                        </div>\n                        {\n                            loadMoreBtn &&\n                            <div className=\"row\">\n                                <div className=\"col-12 text-center\">\n                                    <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                                </div>\n                            </div>\n                        }\n                    </div>\n            }\n        </section>\n    );\n}\n\nconst mapStateToProps = state => ({\n    auction: state.auction,\n    error: state.error,\n    user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeAuction,getCreators, getLiveAuctions })(LiveAuctions);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/create-nft.js",["1139","1140","1141","1142","1143"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/my-collections.js",["1144","1145"],"import React, { useState, useEffect, useRef } from 'react';\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { beforeCategory, getCategories } from '../categories/categories.action';\nimport Collections from './collections';\n\nconst initData = {\n    pre_heading: \"Collections\",\n    heading: \"My Collections\",\n    content: \"\",\n    btnText: \"Create New\"\n}\n\nconst MyCollections = (props) => {\n    const [categories, setCategories] = useState(null)\n    const [categoriesLoader, setCatLoader] = useState(true) // categories loader\n    const [collectionsLoader, setColLoader] = useState(true) // collections loader\n    const collectionsRef = useRef(null)\n\n    useEffect(() => {\n        window.scroll(0, 0)\n        props.getCategories()\n    }, [])\n\n    // when categories data is received\n    useEffect(() => {\n        if (props.category.getAuth) {\n            const { categories } = props.category\n            const allCat = { active: true, name: 'all' }\n            setCategories([allCat, ...categories])\n            props.beforeCategory()\n            setCatLoader(false)\n        }\n    }, [props.category.getAuth])\n\n    const getColLoader = (loader) => {\n        setColLoader(loader)\n    }\n\n    const getCatCollections = (catId) => {\n        collectionsRef.current?.getCatCollections(catId)\n    }\n    // alert(\"cdskjfdkjf\")\n  console.log(categories,\"categories==>\")\n    return (\n        <>\n            {(categoriesLoader || collectionsLoader) && <FullPageLoader />}\n            <section className=\"explore-area padding-wrapper\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12\">\n                            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                                <div className=\"intro-content\">\n                                    <span>{initData.pre_heading}</span>\n                                    <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                                </div>\n                                <div className=\"intro-btn\">\n                                    <Link className=\"btn content-btn text-left\" to=\"/collection/create\">{initData.btnText}</Link>\n                                </div>\n                            </div>\n                            <div className=\"intro my-3\">\n                                <p>{initData.content}</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div className=\"row justify-content-center text-center\">\n                        <div className=\"col-12\">\n                            {/* Explore Menu */}\n                            <div className=\"explore-menu btn-group btn-group-toggle flex-wrap justify-content-center text-center mb-4\" data-toggle=\"buttons\">\n                                {\n                                    categories && categories.length > 0 &&\n                                    categories.map((item, index) => {\n                                        return (\n                                            <label onClick={() => getCatCollections(item._id)} key={`cat_${index}`} className={`btn ${item.active ? 'active' : ''} d-table text-uppercase p-2`}>\n                                                <input type=\"radio\" defaultValue={item.name} defaultChecked className=\"explore-btn\" />\n                                                <span>{item.name}</span>\n                                            </label>\n                                        )\n                                    })\n                                }\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <Collections all={true} userId='61408000cef27850fdea272b' setLoader={getColLoader} ref={collectionsRef} mycollections />\n            </section>\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    error: state.error,\n    category: state.category\n});\n\nexport default connect(mapStateToProps, { beforeCategory, getCategories })(MyCollections);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collection-details.js",["1146","1147","1148","1149","1150","1151","1152","1153","1154","1155","1156","1157","1158","1159","1160","1161","1162","1163","1164"],"import React, { useState, useEffect, useRef } from \"react\";\nimport CollectionPreview from \"./collection-preview\";\nimport Explore from \"../explore/explore-all\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection, getCollection } from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"../../config/config\";\nimport { Accordion, Dropdown } from \"react-bootstrap\";\nimport Select from 'react-select'\nimport FilterSearch from \"../filter-search/filtersearch\";\nimport NftCard from './components/NftCard/NftCard';\nimport {getNFTs} from '../nfts/nfts.action'\nimport {getCreators, beforeUser} from './../user/user.action';\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV;\n\nconst CollectionDetails = (props) => {\n  const [collection, setCollection] = useState(null);\n  const [nfts, setNfts] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [limit, setLimit] = useState(2);\n  const [collectionLoader, setColLoader] = useState(true); // collections loader\n  const [nftsLoader, setNftsLoader] = useState(true); // NFTs loader\n  const [creators,setCreator]=useState([])\n  const nftsRef = useRef(null);\n\n  useEffect(() => {\n   \n    props.getNFTs()\n    window.scroll(0, 0);\n    const { collectionId } = props.match.params;\n    if (collectionId) props.getCollection(window.atob(collectionId));\n    else props.history.push(\"/collections\");\n  }, []);\n\n  // when collection data is received\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collection } = props.collection;\n  \n      setCollection(collection);\n      props.beforeCollection();\n      setColLoader(false);\n    }\n  }, [props.collection.getAuth]);\n   \n  useEffect(()=>{\n      \n    if(props.user.topSellersAuth ){\n    \n       setCreator(props.user.sellers)\n\n    }\n  },[props.user.topSellersAuth])\n\n  // handle show load more button state when pagination is set\n  useEffect(() => {\n   \n    if (nftPagination)\n        setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length && nfts.length > 0))\n  }, [nftPagination])\n\n  const loadMore = () => {\n    \n    // const { page, limit } = nftPagination\n    setLoader(true)\n    setLimit(limit + 2)\n    // get more NFTs for explore section\n    // getNFTs(1, limit * (page + 1));\n  }\n\n  const filterNfts=(nfts)=>{\n\n    if(collection)\n    {\n      const result_nft = nfts.filter((nft)=>nft?.collectionId===collection._id);\n      nfts.pagination = { page: 1, limit: 10, total: result_nft.length, pages: 1 }\n      setNfts(result_nft.slice(0, limit));\n      setNFTPagination(nfts.pagination)\n      getNftsLoader(false);\n    }\n  }\n\n\n\n\n  const getNFTs = (page = 1, limit = 2) => {\n      const nftQS = { page, limit }\n      if (props.collectionId)\n          nftQS.collectionId = props.collectionId\n      const qs = ENV.objectToQueryString(nftQS)\n      props.getNFTs(qs)\n  }\n\n  useEffect(()=>{\n    if(props.nft.nftsAuth)\n    {\n      const {nftsData}=props.nft;\n      filterNfts(nftsData)  \n    }\n\n  },[props?.nft?.nftsAuth,collection, limit])\n\n\n\n  const getNftsLoader = (loader) => {\n    setNftsLoader(loader);\n  };\n\n  return (\n    <section\n      className=\"author-area explore-area  popular-collections-area\"\n      style={{ padding: \"0px\" }}\n    >\n      {(collectionLoader || nftsLoader) && <FullPageLoader />}\n      <div className=\"\">\n        {collection  && (\n          <div className=\"row p-5\" style={{width:\"80%\",margin:\"auto\"}}>\n            <div className=\"col-4 p-4\">\n              <CollectionPreview collection={collection} creators={creators} />\n            </div>\n            <div className=\"col-8 \">\n              <div className=\"row justify-content-center mt-5\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  <div className=\"intro text-center mb-4\">\n                      {/* <span>{initData.pre_heading}</span> */}\n                      <span>Explore</span>\n                      {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                          <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row gx-5 p-4\">\n              \n                {\n                  nfts && creators && nfts.map((nft)=>{\n                  return (\n                    <div className=\"col-6 mt-5\" style={{}}>\n                      <NftCard nft={nft} creators={creators}/>\n                    </div>\n                    )\n                  })\n                }\n                {\n                  loadMoreBtn &&\n                  <div className=\"row w-100\">\n                      <div className=\"col-12 w-100 text-center\">\n                          <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>Load More</a>\n                      </div>\n                  </div>\n                }\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  {\n\n  error: state.error,\n  collection: state.collection,\n  nft:state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollection,\n  getNFTs,\n  getCreators\n})(CollectionDetails);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.js",["1165","1166","1167","1168","1169","1170"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.js",["1171"],"import { useEffect, useState } from 'react';\r\n\r\nimport validator from 'validator';\r\nimport { connect } from \"react-redux\";\r\nimport { beforeContact, submitContact } from \"./contact.action\";\r\n\r\nimport Alert from 'react-bootstrap/Alert'\r\n\r\nconst Contact = (props) => {\r\n\r\n    const [data, setData] = useState({\r\n        name: '',\r\n        email: '',\r\n        subject: '',\r\n        message: ''\r\n    })\r\n\r\n    const [msg, setMsg] = useState({\r\n        name: '',\r\n        email: '',\r\n        subject: '',\r\n        message: ''\r\n    })\r\n\r\n    const [submitCheck, setSubmitCheck] = useState(false)\r\n    const [alertCheck, setAlertCheck] = useState(false)\r\n\r\n    useEffect(() => {\r\n        window.scroll(0, 0)\r\n    }, [])\r\n\r\n    useEffect(() => {\r\n        if (props.contact.contactAuth) {\r\n            setAlertCheck(true)\r\n            setTimeout(()=>{\r\n                setAlertCheck(false)\r\n            }, 3000)\r\n            props.beforeContact()\r\n        }\r\n    }, [props.contact.contactAuth])\r\n\r\n    const showAlert = () => {\r\n        if (alertCheck) {\r\n            return (\r\n                <Alert variant=\"success\" onClose={() => setAlertCheck(false)} dismissible>\r\n                    <span>\r\n                        Contact message sent successfully.\r\n                    </span>\r\n                </Alert>\r\n            );\r\n        }\r\n    }\r\n\r\n    const formSubmission = (e) => {\r\n        e.preventDefault()\r\n        setSubmitCheck(true)\r\n        if (!validator.isEmpty(data.name) && validator.isEmail(data.email)\r\n            && !validator.isEmpty(data.subject) && !validator.isEmpty(data.message)) {\r\n            let formData = new FormData()\r\n            for (const key in data)\r\n                formData.append(key, data[key])\r\n            props.submitContact(formData)\r\n            setData({ name: '', email: '', subject: '', message: '' })\r\n            setMsg({ name: '', email: '', subject: '', message: '' })\r\n            e.target[0].value = ''\r\n            e.target[1].value = ''\r\n            e.target[2].value = ''\r\n            e.target[3].value = ''\r\n        }\r\n        else {\r\n            let name = ''\r\n            let email = ''\r\n            let subject = ''\r\n            let message = ''\r\n            if (validator.isEmpty(data.name)) {\r\n                name = 'Name Is Required.'\r\n            }\r\n            if (!validator.isEmail(data.email)) {\r\n                email = 'Email Is Required.'\r\n            }\r\n            if (validator.isEmpty(data.subject)) {\r\n                subject = 'Subject Is Required.'\r\n            }\r\n            if (validator.isEmpty(data.message)) {\r\n                message = 'Message Is Required.'\r\n            }\r\n            setMsg({ name, email, subject, message })\r\n        }\r\n    }\r\n\r\n    return (\r\n        <section className=\"author-area\">\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>{\"Contact\"}</span>\r\n                            <h3 className=\"mt-3 mb-0\">{\"Get In Touch\"}</h3>\r\n                        </div>\r\n                        {/* Item Form */}\r\n                        <form id=\"contact-form\" className=\"item-form card no-hover\" onSubmit={(e) => formSubmission(e)}>\r\n                            <div className=\"row\">\r\n                                <div className=\"col-12\">\r\n                                    {showAlert()}\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"name\" placeholder=\"Name\" value={data.name}\r\n                                            id=\"contact-name\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, name: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, name: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, name: 'Name Is Required.' })\r\n                                                    }\r\n\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.name ? `` : `d-none`}`}>{msg.name}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"email\" placeholder=\"Email\" value={data.email}\r\n                                            id=\"contact-email\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, email: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (validator.isEmail(e.target.value)) {\r\n                                                        setMsg({ ...msg, email: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, email: 'Email Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.email ? `` : `d-none`}`}>{msg.email}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <input type=\"text\" className=\"form-control\" name=\"subject\" placeholder=\"Subject\" value={data.subject}\r\n                                            id=\"contact-subject\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, subject: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, subject: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, subject: 'Subject Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            }\r\n                                        />\r\n                                        <label className={`text-danger pl-1 ${msg.subject ? `` : `d-none`}`}>{msg.subject}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <div className=\"form-group mt-3\">\r\n                                        <textarea className=\"form-control\" name=\"message\" placeholder=\"Message\" cols={30} rows={3} defaultValue={\"\"} value={data.message}\r\n                                            id=\"contact-message\"\r\n                                            onChange={(e) => {\r\n                                                setData({ ...data, message: e.target.value });\r\n                                                if (submitCheck) {\r\n                                                    if (e.target.value) {\r\n                                                        setMsg({ ...msg, message: '' })\r\n                                                    }\r\n                                                    else {\r\n                                                        setMsg({ ...msg, message: 'Message Is Required.' })\r\n                                                    }\r\n                                                }\r\n                                            }\r\n                                            } />\r\n                                        <label className={`text-danger pl-1 ${msg.message ? `` : `d-none`}`}>{msg.message}</label>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"col-12\">\r\n                                    <button className=\"btn w-100 mt-3 mt-sm-4\" type=\"submit\"><i className=\"icon-paper-plane mr-2\" />Send Message</button>\r\n                                </div>\r\n                            </div>\r\n                        </form>\r\n                        <p className=\"form-message\" />\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n    error: state.error,\r\n    contact: state.contact,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeContact, submitContact })(Contact);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.reducer.js",["1172"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/item-detail/item-detail.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/activity/activity.js",["1173"],"import React, { useState, useEffect } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-1/activity\";\r\n\r\nconst Activity = ()  => {\r\n    const [data, setData] = useState({});\r\n    const [tabData_1, setTabData_1] = useState([]);\r\n    const [tabData_2, setTabData_2] = useState([]);\r\n    const [tabData_3, setTabData_3] = useState([]);\r\n    const [filterData, setFilterData] = useState([]);\r\n    \r\n    useEffect(()=>{\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                setData(res.data)\r\n                setTabData_1(res.data.tabData_1)\r\n                setTabData_2(res.data.tabData_2)\r\n                setTabData_3(res.data.tabData_3)\r\n                setFilterData(res.data.filterData)\r\n            })\r\n            \r\n    }, [])\r\n\r\n    return (\r\n        <section className=\"activity-area load-more padding-wrapper\">\r\n            <div className=\"container\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro mb-4\">\r\n                            <div className=\"intro-content\">\r\n                                <span>{data.preHeading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{data.heading}</h3>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    <div className=\"col-12 col-md-6 col-lg-8\">\r\n                        {/* Netstorm Tab */}\r\n                        <ul className=\"netstorm-tab nav nav-tabs\" id=\"nav-tab\">\r\n                            <li>\r\n                                <a className=\"active\" id=\"nav-home-tab\" data-toggle=\"pill\" href=\"#nav-home\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_1}</h5>\r\n                                </a>\r\n                            </li>\r\n                            <li>\r\n                                <a id=\"nav-profile-tab\" data-toggle=\"pill\" href=\"#nav-profile\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_2}</h5>\r\n                                </a>\r\n                            </li>\r\n                            <li>\r\n                                <a id=\"nav-contact-tab\" data-toggle=\"pill\" href=\"#nav-contact\">\r\n                                    <h5 className=\"m-0\">{data.tabTitle_3}</h5>\r\n                                </a>\r\n                            </li>\r\n                        </ul>\r\n                        {/* Tab Content */}\r\n                        <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                            <div className=\"tab-pane fade show active\" id=\"nav-home\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_1.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`ato_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                            <div className=\"tab-pane fade\" id=\"nav-profile\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_2.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`att_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                            <div className=\"tab-pane fade\" id=\"nav-contact\">\r\n                                <ul className=\"list-unstyled\">\r\n                                    {/* Single Tab List */}\r\n                                    {tabData_3.map((item, idx) => {\r\n                                        return (\r\n                                            <li key={`atth_${idx}`} className=\"single-tab-list d-flex align-items-center\">\r\n                                                <a href=\"/item-details\">\r\n                                                    <img className=\"avatar-lg\" src={item.img} alt=\"\" />\r\n                                                </a>\r\n                                                {/* Activity Content */}\r\n                                                <div className=\"activity-content ml-4\">\r\n                                                    <a href=\"/item-details\">\r\n                                                        <h5 className=\"mt-0 mb-2\">{item.title}</h5>\r\n                                                    </a>\r\n                                                    <p className=\"m-0\">Bid listed for <strong>{item.price}</strong> {item.time} <br />by <a href=\"/author\">{item.seller}</a></p>\r\n                                                </div>\r\n                                            </li>\r\n                                        );\r\n                                    })}\r\n                                </ul>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"col-12 col-md-6 col-lg-4\">\r\n                        {/* Activity Content */}\r\n                        <div className=\"activity-content mt-5 mt-lg-0\">\r\n                            {/* Single Widget */}\r\n                            <div className=\"single-widget\">\r\n                                {/* Search Widget */}\r\n                                <div className=\"widget-content search-widget\">\r\n                                    <form action=\"#\">\r\n                                        <input type=\"text\" placeholder=\"Enter your keywords\" />\r\n                                    </form>\r\n                                </div>\r\n                            </div>\r\n                            {/* Single Widget */}\r\n                            <div className=\"single-widget\">\r\n                                {/* Filter Widget */}\r\n                                <div className=\"widget filter-widget\">\r\n                                    <h4 className=\"title\">{data.widgetTitle}</h4>\r\n                                    {/* Filter Widget Content */}\r\n                                    <div className=\"widget-content\">\r\n                                        {/* Tags Widget Items */}\r\n                                        <div className=\"widget-content filter-widget-items mt-3\">\r\n                                            {filterData.map((item, idx) => {\r\n                                                return (\r\n                                                    <a key={`fd_${idx}`} href=\"#\" className=\"badge tag\">{item.title}</a>\r\n                                                );\r\n                                            })}\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\nexport default Activity;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/blog/blog.js",["1174","1175"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/blog\";\r\n\r\nclass Blog extends Component {\r\n    state = {\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data.blogData\r\n                })\r\n              \r\n            })\r\n        .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"blog-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`bd_${idx}`} className=\"col-12 col-md-4 item\">\r\n                                    {/* Single Blog */}\r\n                                    <div className=\"card blog-card\">\r\n                                        {/* Blog Thumb */}\r\n                                        <div className=\"blog-thumb\">\r\n                                            <a href=\"/blog-single\"><img src={item.img} alt=\"\" /></a>\r\n                                        </div>\r\n                                        {/* Blog Content */}\r\n                                        <div className=\"blog-content\">\r\n                                            {/* Meta Info */}\r\n                                            <ul className=\"meta-info d-flex justify-content-between list-unstyled mt-4\">\r\n                                                <li>By <a href=\"#\">{item.author}</a></li>\r\n                                                <li><a href=\"#\">{item.date}</a></li>\r\n                                            </ul>\r\n                                            {/* Blog Title */}\r\n                                            <a href=\"/blog-single\">\r\n                                                <h4>{item.title}</h4>\r\n                                            </a>\r\n                                            <p>{item.content}</p>\r\n                                            {/* Blog Button */}\r\n                                            <a className=\"btn content-btn\" href=\"/blog-single\">{item.btnText}</a>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Blog;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/blog-single/blog-single.js",["1176","1177"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\nimport Sidebar from '../sidebar/sidebar';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/blogSingle\";\r\n\r\nclass BlogSingle extends Component {\r\n    state = {\r\n        data: {}\r\n    }\r\n    componentDidMount(){\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data\r\n                })\r\n            \r\n            })\r\n        .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"single featured post-details\">\r\n                <div className=\"container\">\r\n                    <div className=\"row\">\r\n                        {/* Main */}\r\n                        <div className=\"col-12 col-lg-8 p-0\">\r\n                            <div className=\"row\">\r\n                                <div className=\"col-12 align-self-center\">\r\n                                    {/* Image */}\r\n                                    <div className=\"blog-thumb\">\r\n                                        <img className=\"w-100\" src={this.state.data.image} alt=\"\" />\r\n                                    </div>\r\n                                    <h2 className=\"featured ml-0\">{this.state.data.title}</h2>\r\n                                    <p>{this.state.data.content_1}</p>\r\n                                    <p>\r\n                                    </p>\r\n                                    <blockquote>{this.state.data.quote}</blockquote>\r\n                                    <p>{this.state.data.content_2}</p>\r\n                                    <p>{this.state.data.content_3}</p>\r\n                                    {/* Post Holder */}\r\n                                    <ul className=\"mb-5 post-holder\">\r\n                                        <li className=\"post-meta-item\">\r\n                                            <div className=\"date\">\r\n                                                <span className=\"posted-on\">Posted On <a href=\"#\" rel=\"bookmark\"><time className=\"entry-date published updated\" dateTime=\"2018-11-01T06:18:46+00:00\">{this.state.data.date}</time></a></span>\r\n                                            </div>\r\n                                        </li>\r\n                                    </ul>\r\n                                    {/* Comments */}\r\n                                    <h3 className=\"comments-reply-text mb-3\">{this.state.data.commentTitle}</h3>\r\n                                    <p className=\"mt-3\">{this.state.data.commentContent}</p>\r\n                                    <form>\r\n                                        <fieldset>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-12 col-lg-6 input-group p-0 pr-lg-3 mb-3\">\r\n                                                    <input type=\"text\" name=\"name\" data-minlength={3} placeholder=\"Name\" required />\r\n                                                </div>\r\n                                                <div className=\"col-12 col-lg-6 input-group p-0 mb-3\">\r\n                                                    <input type=\"email\" name=\"email\" data-minlength={3} placeholder=\"Email\" required />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"row\">\r\n                                                <div className=\"col-12 input-group p-0 mb-3\">\r\n                                                    <textarea name=\"message\" data-minlength={3} rows={4} placeholder=\"Message\" required defaultValue={\"\"} />\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 input-group p-0\">\r\n                                                <a className=\"btn btn-bordered-white text-white\">{this.state.data.commentBtn}<i className=\"icon-login ml-2\" /></a>\r\n                                            </div>\r\n                                        </fieldset>\r\n                                    </form>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        {/* Sidebar */}\r\n                        <Sidebar />\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default BlogSingle;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/help-center/help-center.js",["1178"],"import React, { Component } from 'react';\nimport Help from '../help/help';\nimport Faq from '../faq/faq';\n\nclass HelpCenter extends Component {\n\n    componentDidMount() {\n        window.scroll(0, 0)\n    }\n\n    render() {\n        return (\n            <>\n                {/* <Help /> */}\n                <Faq />\n            </>\n        );\n    }\n}\n\nexport default HelpCenter;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/author/author.js",["1179","1180","1181","1182","1183","1184","1185","1186"],"import React, { useEffect, useState } from \"react\";\r\nimport { useParams } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport AuthorProfile from \"../author-profile/author-profile\";\r\nimport Explore from \"../explore/explore-all\";\r\nimport { getUserById, beforeUser } from \"./../user/user.action\";\r\nimport FilterSearch from \"../filter-search2/filtersearch2\";\r\nimport { ENV } from \"./../../config/config\";\r\n\r\nconst Author = (props) => {\r\n  const params = useParams();\r\n  const [authorProfile, setAuthorProfile] = useState({});\r\n  useEffect(() => {\r\n    props.getUserById(params.authorId);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.user.individualUserAuth) {\r\n      setAuthorProfile(props.user.individualUser);\r\n      props.beforeUser();\r\n    }\r\n  }, [props.user.individualUserAuth]);\r\n  return (\r\n    <section\r\n      className=\"author-area explore-area popular-collections-area\"\r\n      style={{ padding: \"0px\" }}\r\n    >\r\n      <div className=\"\">\r\n        <div className=\"d-flex author-detail-container\">\r\n          <div className=\"author-preview author-card\">\r\n            <div className=\"seller\">\r\n              <div className=\"seller-thumb avatar-lg\">\r\n                <img\r\n                  className=\"rounded-circle\"\r\n                  src={props.profileImage ? props.profileImage : ENV.globalPlaceholderImage}\r\n                  alt=\"User Profile\"\r\n                  style={{ height: \"110px\" }}\r\n                />\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"card-caption p-0 text-center\">\r\n            <div className=\"card-body\">\r\n              <h5 className=\"mb-3\">{authorProfile.username}</h5>\r\n              <p className=\"my-3\">{authorProfile.description}</p>\r\n              <div className=\"input-group\">\r\n                <input type=\"text\" className=\"form-control\" placeholder=\"0x000000000000000000\" readOnly value={authorProfile.address}\r\n                  style={{\r\n                    borderRadius: \"100px\",\r\n                    backgroundColor: \"transparent\",\r\n                    border: \"2px solid\",\r\n                    height: \"40px\",\r\n                    padding: \"1.5rem\",\r\n                    boxShadow: \"none\",\r\n                    outline: \"none\",\r\n\r\n                  }}\r\n                />\r\n                <div className=\"input-group-append\"\r\n                  style={{\r\n                    position: \"absolute\",\r\n                    height: \"100%\",\r\n                    top: \"0\",\r\n                    right: \"0\",\r\n                    borderRadius: \"100px\",\r\n                    overflow: \"hidden\",\r\n                  }}\r\n                >\r\n                  <button style={{\r\n                    marginRight: \"5px\",\r\n                    padding: \"12px 16px\",\r\n                    backgroundColor: \"transparent\",\r\n                    color: \"#fff\",\r\n                    border: \"0\",\r\n                    outline: \"none\",\r\n                  }}><i className=\"icon-docs\" /></button>\r\n                </div>\r\n              </div>\r\n              <div className=\"social-icons d-flex justify-content-center my-3\">\r\n                {\r\n                  authorProfile.facebookLink && <a className=\"facebook\" href={authorProfile.facebookLink} target=\"_blank\">\r\n                    <i className=\"fab fa-facebook-f\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.twitterLink && <a className=\"twitter\" href={authorProfile.twitterLink} target=\"_blank\">\r\n                    <i className=\"fab fa-twitter\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.gPlusLink && <a className=\"google-plus\" href={authorProfile.gPlusLink} target=\"_blank\">\r\n                    <i className=\"fab fa-google-plus-g\" />\r\n                  </a>\r\n                }\r\n                {\r\n                  authorProfile.vineLink && <a className=\"vine\" href={authorProfile.vineLink} target=\"_blank\">\r\n                    <i className=\"fab fa-vine\" />\r\n                  </a>\r\n                }\r\n              </div>\r\n              {\r\n                props.followText &&\r\n                <a className=\"btn btn-bordered-white btn-smaller\" href=\"#\">{props.followText}</a>\r\n              }\r\n            </div>\r\n          </div>\r\n          <div className=\"d-flex collection-wrapper\">\r\n            <FilterSearch />\r\n            <div className=\"nfts-collection-wrapper w-100\">\r\n              <Explore />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  error: state.error,\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { getUserById, beforeUser })(Author);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/profile/profile.js",["1187","1188","1189","1190","1191"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport AuthorProfile from \"../author-profile/author-profile\";\nimport { SET_INDIVIDUAL_USER } from \"../../redux/types\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { signRequest } from \"./../../utils/web3\";\nimport { ENV } from \"./../../config/config\";\nimport { toast } from \"react-toastify\";\nimport { useHistory } from \"react-router-dom\";\n\n\nconst Profile = (props) => {\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [facebookLink, setFbLink] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [gPlusLink, setgPlusLink] = useState(\"\");\n  const [vineLink, setVineLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n    props.setIndividualUserData(user);\n    setConnectedAddress(user.address ? user.address : \"\");\n    setAddress(user.address ? user.address : \"\");\n    setEmail(user.email ? user.email : \"\");\n    setUserId(user._id ? user._id : \"\");\n    setDescription(user.description ? user.description : \"\");\n    setFbLink(user.facebookLink ? user.facebookLink : \"\");\n    setgPlusLink(user.gPlusLink ? user.gPlusLink : \"\");\n    setTwitterLink(user.twitterLink ? user.twitterLink : \"\");\n    setVineLink(user.vineLink ? user.vineLink : \"\");\n    setUsername(user.username ? user.username : \"\");\n    setImageUrl(user.profileImage ? user.profileImage : \"\");\n  }, []);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      props.beforeUser();\n      setLoader(false);\n    }\n  }, [props.user.userAuth]);\n\n  useEffect(() => {\n    if (props.error) {\n      setErrors(props.error.message);\n      goToTop();\n    }\n  }, [props.error]);\n\n  const goToTop = () => {\n    $(\"html, body\").animate(\n      {\n        scrollTop: 0,\n      },\n      600\n    );\n  };\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setImageUrl(fileURL);\n      setImage(file);\n    }\n  };\n\n  const onBannerChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setBannerUrl(fileURL);\n      setBannerImage(file);\n    }\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    setErrors(\"\");\n    setIsSubmitted(true);\n    let isFormValid = validator.allValid() ? true : false;\n    if (isFormValid) {\n      try {\n        let signature = await signRequest();\n        setLoader(true);\n        var formData = new FormData();\n        formData.append(\"profileImage\", image);\n        formData.append(\"bannerImage\", banner);\n        formData.append(\"description\", description);\n        formData.append(\"facebookLink\", facebookLink);\n        formData.append(\"twitterLink\", twitterLink);\n        formData.append(\"gPlusLink\", gPlusLink);\n        formData.append(\"vineLink\", vineLink);\n        formData.append(\"username\", username);\n        formData.append(\"signature\", signature);\n        props.updateProfile(formData);\n      } catch (e) {}\n    } else {\n      validator.showMessages();\n      setErrors(\"Please fill all required fields in valid format.\");\n      goToTop();\n    }\n  };\n  if (!ENV.getUserKeys(\"_id\")._id) {\n    toast.error(\"Please login to view profile\");\n    history.push(\"/\");\n    return \" \";\n  } else {\n    return (\n      <section className=\"author-area\">\n        <div className=\"container\">\n          <div className=\"row justify-content-between\">\n            <div className=\"col-12 col-md-4\">\n              <AuthorProfile\n                profileImage={imageUrl}\n                username={username}\n                description={description}\n                address={connectedAddress}\n                facebookLink={facebookLink}\n                twitterLink={twitterLink}\n                gPlusLink={gPlusLink}\n                vineLink={vineLink}\n              />\n            </div>\n            <div className=\"col-12 col-md-7\">\n              <div className=\"mt-5 mt-lg-0 mb-4 mb-lg-5\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Your Profile</span>\n                    <h3 className=\"mt-3 mb-0\">Update your profile</h3>\n                  </div>\n                </div>\n              </div>\n              <form id=\"create-nft\" className=\"item-form card no-hover\">\n                {isSubmitted && errors && (\n                  <div className=\"row pb-2\">\n                    <div className=\"col-12\">\n                      <span id=\"create-nft-err\" className=\"text-danger\">\n                        {errors}\n                      </span>\n                    </div>\n                  </div>\n                )}\n                <div className=\"row\">\n                  <div className=\"col-12\">\n                    <div className=\"input-group form-group\">\n                      <div className=\"custom-file\">\n                        <input\n                          type=\"file\"\n                          className=\"custom-file-input\"\n                          id=\"banner\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onBannerChange(e)}\n                          name=\"banner\"\n                        />\n                        <label\n                          id=\"nft-imasge-label\"\n                          className=\"custom-file-label\"\n                          htmlFor=\"banner\"\n                        >\n                          {banner && banner.name\n                            ? banner.name\n                            : \"Choose Banner Image\"}\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"input-group form-group\">\n                      <div className=\"custom-file\">\n                        <input\n                          type=\"file\"\n                          className=\"custom-file-input\"\n                          id=\"image\"\n                          accept=\".png,.jpeg,.jpg\"\n                          onChange={(e) => onFileChange(e)}\n                          name=\"image\"\n                        />\n                        <label\n                          id=\"nft-imasge-label\"\n                          className=\"custom-file-label\"\n                          htmlFor=\"image\"\n                        >\n                          {image && image.name\n                            ? image.name\n                            : \"Choose Profile Picture\"}\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"address\"\n                        placeholder=\"Wallet Address *\"\n                        required=\"required\"\n                        value={address}\n                        readOnly\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"address\", address, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"email\"\n                        placeholder=\"Email *\"\n                        required=\"required\"\n                        value={email}\n                        readOnly\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"email\", email, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"username\"\n                        placeholder=\"Username *\"\n                        required=\"required\"\n                        onChange={(e) => setUsername(e.target.value)}\n                        defaultValue={username}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"username\", username, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <textarea\n                        className=\"form-control\"\n                        name=\"description\"\n                        placeholder=\"About\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setDescription(e.target.value)}\n                        defaultValue={description}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"facebookLink\"\n                        placeholder=\"Facebook Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setFbLink(e.target.value)}\n                        defaultValue={facebookLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"twitterLink\"\n                        placeholder=\"Twitter Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setTwitterLink(e.target.value)}\n                        defaultValue={twitterLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"gPlusLink\"\n                        placeholder=\"Google Plus Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setgPlusLink(e.target.value)}\n                        defaultValue={gPlusLink}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        name=\"vineLink\"\n                        placeholder=\"Vine Link\"\n                        cols={30}\n                        rows={3}\n                        onChange={(e) => setVineLink(e.target.value)}\n                        defaultValue={vineLink}\n                      />\n                    </div>\n                  </div>\n\n                  <div className=\"col-12\">\n                    <button\n                      disabled={loader}\n                      className=\"btn w-100 mt-3 mt-sm-4\"\n                      type=\"button\"\n                      onClick={(e) => submit(e)}\n                    >\n                      Update Profile\n                    </button>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        </div>\n      </section>\n    );\n  }\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n})(Profile);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-collection/create-collection.js",["1192","1193"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { getUser } from \"../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport $ from \"jquery\";\nimport { ENV } from \"../../config/config\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { toast } from \"react-toastify\";\nimport \"./create-collection.css\";\nimport { Images } from \"../../assets/assets.js\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nclass CreateCollection extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        description: \"\",\n      },\n      categories: null,\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate() {\n    if (this.props.error) {\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      this.setState({ categories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n    console.log(collection, \"collection input\");\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  render() {\n    const { collection, errors, loader, isSubmitted, categories } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      return (\n        <div>\n          <NavbarMain />\n\n          <section className=\"author-area padding-form-wrapper\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row justify-content-between\">\n                <div className=\"col-12 col-md-12\">\n                  <div className=\"mt-5 mt-lg-0 mb-4 mb-lg-5\">\n                    <div className=\"intro\">\n                      <div className=\"intro-content\">\n                        <span>Get Started</span>\n                        <h3 className=\"mb-0\">Create Collection</h3>\n                      </div>\n                    </div>\n                    {isSubmitted && errors && (\n                      <div className=\"row\">\n                        <div className=\"col-12\">\n                          <span\n                            id=\"create-collection-err\"\n                            className=\"text-danger\"\n                          >\n                            {errors}\n                          </span>\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                  <form\n                    id=\"create-collection\"\n                    className=\"item-form card no-hover\"\n                  >\n                    <div className=\"row\">\n                      <div className=\"col-12\">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"logo\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"logo\"\n                            />\n                            <label\n                              id=\"collection-logo-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"logo\"\n                            >\n                              Choose Logo *\n                            </label>\n                          </div>\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"logo\",\n                              collection.logo,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-3\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border \">\n                          <div className=\"image-over \">\n                            <img\n                              id=\"logo-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.logoUrl\n                                  ? collection.logoUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"featuredImg\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"featuredImg\"\n                            />\n                            <label\n                              id=\"collection-featuredImg-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"featuredImg\"\n                            >\n                              {\" \"}\n                              Choose Featured Image\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-4\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border\">\n                          <div className=\"image-over\">\n                            <img\n                              id=\"featuredImg-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.featuredImgUrl\n                                  ? collection.featuredImgUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 \">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"banner\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"banner\"\n                            />\n                            <label\n                              id=\"collection-banner-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"banner\"\n                            >\n                              Choose Banner\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-8\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border\">\n                          <div className=\"image-over\">\n                            <img\n                              id=\"banner-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.bannerUrl\n                                  ? collection.bannerUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-6\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control\"\n                            name=\"name\"\n                            placeholder=\"Name *\"\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.name}\n                            maxLength=\"55\"\n                            autoComplete=\"off\"\n                          />\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"name\",\n                              collection.name,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-6\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control\"\n                            name=\"url\"\n                            placeholder=\"URL\"\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.url}\n                            maxLength=\"70\"\n                            autoComplete=\"off\"\n                          />\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"url\",\n                              collection.url,\n                              \"url\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group\">\n                          {/* <label\n                            htmlFor=\"category\"\n                            className=\"create-nft-form-title mb-3\"\n                          >\n                            Select Category*\n                          </label> */}\n                          <select\n                            className=\"form-control p-0\"\n                            id=\"category\"\n                            name=\"categoryId\"\n                            onChange={(e) => this.onChange(e)}\n                          >\n                            <option value=\"\">Select Category</option>\n                            {categories &&\n                              categories.map((category, index) => {\n                                return (\n                                  <option key={index} value={category._id}>\n                                    {category.name}\n                                  </option>\n                                );\n                              })}\n                          </select>\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"category\",\n                              collection.categoryId,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group\">\n                          <textarea\n                            className=\"form-control\"\n                            name=\"description\"\n                            placeholder=\"Description\"\n                            cols={30}\n                            rows={3}\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.description}\n                            maxLength=\"230\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"text-center\">\n                          <button\n                            disabled={loader}\n                            className=\"create-collection-btn mx-auto mt-3 mt-sm-4\"\n                            type=\"button\"\n                            onClick={(e) => this.submit(e)}\n                          >\n                            Create Collection\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </form>\n                </div>\n              </div>\n            </div>\n          </section>\n          <Footer />\n        </div>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollection);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/signup/signup.js",["1194","1195"],"import React, { Component } from \"react\";\r\n\r\nconst initData = {\r\n  pre_heading: \"Signup\",\r\n  heading: \"Create an Account\",\r\n  content: \"\",\r\n};\r\n\r\nconst socialData = [\r\n  {\r\n    id: \"1\",\r\n    link: \"facebook\",\r\n    icon: \"fab fa-facebook-f\",\r\n  },\r\n  {\r\n    id: \"2\",\r\n    link: \"twitter\",\r\n    icon: \"fab fa-twitter\",\r\n  },\r\n  {\r\n    id: \"3\",\r\n    link: \"google-plus\",\r\n    icon: \"fab fa-google-plus-g\",\r\n  },\r\n];\r\n\r\nclass Signup extends Component {\r\n  state = {\r\n    initData: {},\r\n    data: [],\r\n  };\r\n  componentDidMount() {\r\n    this.setState({\r\n      initData: initData,\r\n      data: socialData,\r\n    });\r\n  }\r\n  render() {\r\n    return (\r\n      <section className=\"author-area\">\r\n        <div className=\"container\">\r\n          <div className=\"row justify-content-center\">\r\n            <div className=\"col-12 col-md-8 col-lg-7\">\r\n              {/* Intro */}\r\n              <div className=\"intro text-center\">\r\n                <span>{this.state.initData.pre_heading}</span>\r\n                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                <p>{this.state.initData.content}</p>\r\n              </div>\r\n              {/* Item Form */}\r\n              <form className=\"item-form card no-hover\">\r\n                <div className=\"row\">\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <input\r\n                        type=\"text\"\r\n                        className=\"form-control\"\r\n                        name=\"name\"\r\n                        placeholder=\"Enter your Name\"\r\n                        required=\"required\"\r\n                      />\r\n                    </div>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <input\r\n                        type=\"email\"\r\n                        className=\"form-control\"\r\n                        name=\"email\"\r\n                        placeholder=\"Enter your Email\"\r\n                        required=\"required\"\r\n                      />\r\n                    </div>\r\n                  </div>\r\n                  {/* <div className=\"col-12\">\r\n                                        <div className=\"form-group mt-3\">\r\n                                            <input type=\"password\" className=\"form-control\" name=\"password\" placeholder=\"Enter your Password\" required=\"required\" />\r\n                                        </div>\r\n                                    </div> */}\r\n                  <div className=\"col-12\">\r\n                    <div className=\"form-group mt-3\">\r\n                      <div className=\"form-check form-check-inline\">\r\n                        <input\r\n                          className=\"form-check-input\"\r\n                          type=\"radio\"\r\n                          name=\"inlineRadioOptions\"\r\n                          id=\"inlineRadio1\"\r\n                          defaultValue=\"option1\"\r\n                        />\r\n                        <label\r\n                          className=\"form-check-label\"\r\n                          htmlFor=\"inlineRadio1\"\r\n                        >\r\n                          I agree to <a href=\"#\">Privacy Policy</a>\r\n                        </label>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <button className=\"btn w-100 mt-3 mt-sm-4\" type=\"submit\">\r\n                      Sign Up\r\n                    </button>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <span className=\"d-block text-center mt-4\">\r\n                      Already have an account? <a href=\"/login\">Login</a>\r\n                    </span>\r\n                  </div>\r\n                  <div className=\"col-12\">\r\n                    <hr />\r\n                    <div className=\"other-option\">\r\n                      <span className=\"d-block text-center mb-4\">Or</span>\r\n                      {/* Social Icons */}\r\n                      <div className=\"social-icons d-flex justify-content-center\">\r\n                        {this.state.data.map((item, idx) => {\r\n                          return (\r\n                            <a\r\n                              key={`lsd_${idx}`}\r\n                              className={item.link}\r\n                              href=\"#\"\r\n                            >\r\n                              <i className={item.icon} />\r\n                              <i className={item.icon} />\r\n                            </a>\r\n                          );\r\n                        })}\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </form>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n}\r\n\r\nexport default Signup;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/not-found/not-found.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/sell-nft.js",["1196","1197","1198","1199","1200","1201","1202","1203","1204","1205","1206","1207","1208","1209"],"import React, { useState, useEffect } from \"react\";\r\nimport { Container, Row, Col, Nav } from \"react-bootstrap\";\r\nimport Tab from \"react-bootstrap/Tab\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeNFT, getNFT, upsertNFT } from \"./nfts.action\";\r\nimport { useLocation } from \"react-router-dom\";\r\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\r\nimport NFTPreview from \"../nft-preview/nft-preview\";\r\nimport { decimalNumberValidator } from \"../../utils/functions\";\r\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\r\nimport \"bootstrap-daterangepicker/daterangepicker.css\";\r\nimport moment from \"moment\";\r\nimport currencyIcon from \"../../assets/images/binance.svg\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { openNFTForBidding } from \"../../utils/web3\";\r\nimport { SellOnFixedPrice } from \"../../utils/web3\";\r\nimport { toast } from \"react-toastify\";\r\nconst { currencies, dateRangeInitialSettings, serviceFee } = ENV;\r\n\r\nconst config1 = {\r\n  price: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n  listingSchedule: {\r\n    startDate: moment(),\r\n    endDate: moment().add(6, \"months\"),\r\n    startTime: moment(new Date()).format(\"HH:mm\"),\r\n    endTime: \"23:59\",\r\n  },\r\n  reserveFor: \"\", // if user selects reserve buyer\r\n};\r\nconst config2 = {\r\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\r\n  startPrice: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n  duration: {\r\n    startDate: moment(),\r\n    endDate: moment().add(6, \"months\"),\r\n    startTime: moment(new Date()).format(\"HH:mm\"),\r\n    endTime: \"23:59\",\r\n  },\r\n  // if user includes reserve price\r\n  reservePrice: {\r\n    currency: ENV.currency,\r\n    amount: \"\",\r\n  },\r\n};\r\n\r\nconst Sell = (props) => {\r\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\r\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\r\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\r\n  const [nft, setNft] = useState(null);\r\n  const [loader, setLoader] = useState(true); // NFT loader\r\n  const [reserveBuyer, setReserveBuyer] = useState(false);\r\n  const [reservePrice, setReservePrice] = useState(false);\r\n  const [tokensData, setTokensData] = useState([]);\r\n  const location = useLocation();\r\n  console.log(location.state, \"location.state\");\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    const { itemId } = props.match.params;\r\n    // if (itemId) props.getNFT(window.atob(itemId));\r\n    // else props.history.push(\"/explore-all\");\r\n    getTokens();\r\n  }, []);\r\n\r\n  // when NFT data is received\r\n  useEffect(() => {\r\n    if (props.nft.nftsAuth) {\r\n      const nft = props.nft.nftsData;\r\n      setNft(nft);\r\n      setLoader(false);\r\n      props.beforeNFT();\r\n    }\r\n  }, [props.nft.nftsAuth]);\r\n\r\n  // when NFT data is updated\r\n  useEffect(() => {\r\n    if (props.nft.upsertAuth) {\r\n      const { nft } = props.nft.nftsData;\r\n      // const pathname = nft.sellingMethod === 1 ? '/explore-all' : '/auctions'\r\n      const pathname = \"/\";\r\n      setLoader(false);\r\n      props.beforeNFT();\r\n      props.history.push(pathname);\r\n    }\r\n  }, [props.nft.upsertAuth]);\r\n\r\n  // when an error is received\r\n  useEffect(() => {\r\n    setLoader(false);\r\n  }, [props.error]);\r\n\r\n  const onChange = (e) => {\r\n    const { name, value } = e.target;\r\n    let data = null;\r\n    if (sellingMethod === 1) data = fixedPriceConfig;\r\n    else data = timedAuctionConfig;\r\n\r\n    console.log(data,\"data\")\r\n    const keys = name.split(\".\"); // fixedPriceConfig, price, currency\r\n    if (keys && keys[2]) data[keys[1]][keys[2]] = value;\r\n    else if (keys && keys[1]) data[keys[1]] = value;\r\n    console.log(keys,\"keys\")\r\n\r\n    if (sellingMethod === 1) setFixedPriceConfig({ ...data });\r\n    else setTimedAuctionConfig({ ...data });\r\n  };\r\n\r\n  const handleDateChange = (e, picker) => {\r\n    const { name } = e.target;\r\n    const { startDate, endDate } = picker;\r\n\r\n    // set start date\r\n    onChange({\r\n      target: {\r\n        name: `${name}.startDate`,\r\n        value: startDate,\r\n      },\r\n    });\r\n\r\n    // set end date\r\n    onChange({\r\n      target: {\r\n        name: `${name}.endDate`,\r\n        value: endDate,\r\n      },\r\n    });\r\n  };\r\n\r\n  const submit = () => {\r\n    const payload = {\r\n      _id: location.state._id,\r\n      sellingMethod,\r\n      sellingConfig: JSON.stringify(\r\n        sellingMethod === 1 ? fixedPriceConfig : timedAuctionConfig\r\n      ),\r\n    };\r\n    console.log(\r\n      \"🚀 ~ file: sell-nft.js ~ line 172 ~ submit ~ timedAuctionConfig\",\r\n      payload\r\n    );\r\n    console.log(payload, \"paylaod=>\");\r\n    //  return  \" \"\r\n\r\n    let test = new Date(timedAuctionConfig.duration.endDate).getTime();\r\n    let time = timedAuctionConfig.duration.endTime;\r\n\r\n    var r = Number(time.split(\":\")[0]) * 60 + Number(time.split(\":\")[1]) * 1000;\r\n    //\r\n    const timeInMiliSeconds = r + test;\r\n\r\n    // console.log('yoken data', tokensData)\r\n    // const nftToken=tokensData.data.find((item)=>item?.nftId===nft?._id)\r\n\r\n    //  if(nftToken){\r\n    //   sellingMethod==1?SellOnFixedPrice(nftToken?.nftToken,fixedPriceConfig.price.amount):openNFTForBidding(nftToken.nftToken,timeInMiliSeconds)\r\n\r\n    setLoader(true);\r\n\r\n    var formData = new FormData();\r\n    console.log(payload, \"payload\");\r\n    for (const key in payload) formData.append(key, payload[key]);\r\n\r\n    props.upsertNFT(\"edit\", formData, \"PUT\");\r\n    //  }\r\n    //  else {\r\n    //   toast.error(\"there was an issue while creating nft, please try later\")\r\n    //  }\r\n  };\r\n\r\n  const getTokens = () => {\r\n    const url = process.env.REACT_APP_BASE_URL + \"nftTokens/tokens\";\r\n\r\n    fetch(url, {\r\n      method: \"GET\",\r\n      headers: {\r\n        \"content-type\": \"application/json\",\r\n        Authorization: ENV.Authorization,\r\n        \"x-auth-token\": ENV.x_auth_token,\r\n        \"Access-Control-Allow-Origin\": \"*\",\r\n        \"x-access-token\":\r\n          ENV.getUserKeys(\"accessToken\") &&\r\n          ENV.getUserKeys(\"accessToken\").accessToken\r\n            ? ENV.getUserKeys(\"accessToken\").accessToken\r\n            : \"\",\r\n      },\r\n    })\r\n      .then((res) => res.json())\r\n      .then((data) => {\r\n        setTokensData(data);\r\n      })\r\n      .catch((error) => {\r\n        console.log(error, \"error in catch blcok\");\r\n      });\r\n  };\r\n\r\n  console.log(nft, \"nft\");\r\n\r\n  return (\r\n    <div className=\"padding-wrapper\">\r\n      {loader && <FullPageLoader />}\r\n      <div\r\n        className=\"\"\r\n        style={{\r\n          maxWidth: \"85%\",\r\n          margin: \"auto\",\r\n        }}\r\n      >\r\n        <div className=\"d-flex\">\r\n          <div className=\"tabs-container\">\r\n            <span className=\"head-wrapper\">List of Bundle for Sale</span>\r\n            <div className=\"market-tabs-wrapper\">\r\n              <Tab.Container\r\n                id=\"marketplace-tabs\"\r\n                defaultActiveKey=\"fixedPrice\"\r\n              >\r\n                <Row>\r\n                  <Col lg=\"12\" md=\"12\" sm=\"12\" xs=\"12\">\r\n                    <Nav variant=\"pills\" className=\"flex-row\">\r\n                      <Nav.Item className=\"nav-item-wrapper\">\r\n                        <div className=\"mb-2\">Type</div>\r\n                        <Nav.Link\r\n                          eventKey=\"fixedPrice\"\r\n                          onClick={() => setSellingMethod(1)}\r\n                        >\r\n                          <i className=\"fas fa-dollar-sign\" />\r\n                          <div>Fixed Price</div>\r\n                        </Nav.Link>\r\n                      </Nav.Item>\r\n                      <Nav.Item className=\"nav-item-wrapper\">\r\n                        <div className=\"text-right mr-4 mb-2\">\r\n                          <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                        </div>\r\n                        <Nav.Link\r\n                          eventKey=\"timedAuction\"\r\n                          onClick={() => setSellingMethod(2)}\r\n                        >\r\n                          <i className=\"fas fa-clock\" />\r\n                          <div>Timed Auction</div>\r\n                        </Nav.Link>\r\n                      </Nav.Item>\r\n                    </Nav>\r\n                  </Col>\r\n                </Row>\r\n                <div className=\"market-tab-content\">\r\n                  <Container fluid>\r\n                    <Tab.Content>\r\n                      <Tab.Pane eventKey=\"fixedPrice\">\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text position-relative\">\r\n                            <div className=\"text-white mb-2 absolute-wrapper\">\r\n                              <b>Price</b>\r\n                            </div>\r\n                            <div className=\"text-right mb-2\">\r\n                              <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                            </div>\r\n                            <div className=\"d-flex\">\r\n                              <button type=\"button\" className=\"ethereum-btn\">\r\n                                <svg\r\n                                  viewBox=\"0 0 126.61 126.61\"\r\n                                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                                  fill=\"currentColor\"\r\n                                  height=\"18\"\r\n                                  width=\"18\"\r\n                                >\r\n                                  <g>\r\n                                    <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                    <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                    <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                    <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                    <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                  </g>\r\n                                </svg>\r\n                                <span className=\"ml-2\">{ENV.currency}</span>\r\n                              </button>\r\n                              <input\r\n                                type=\"text\"\r\n                                name=\"fixedPriceConfig.price.amount\"\r\n                                placeholder=\"Amount\"\r\n                                className=\"amount-btn ml-3\"\r\n                                style={{\r\n                                  borderRadius: \"4px\",\r\n                                }}\r\n                                onChange={(e) => onChange(e)}\r\n                                onKeyDown={(e) => decimalNumberValidator(e)}\r\n                                defaultValue={fixedPriceConfig.price.amount}\r\n                                required\r\n                              />\r\n                              {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                $ 0.00\r\n                              </div> */}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>Schedule Listing</b>\r\n                            </div>\r\n                            <div className=\"date-picker\">\r\n                              <DateRangePicker\r\n                                initialSettings={dateRangeInitialSettings}\r\n                                onApply={handleDateChange}\r\n                              >\r\n                                <button\r\n                                  name=\"fixedPriceConfig.listingSchedule\"\r\n                                  className=\"calender-btn\"\r\n                                >\r\n                                  {fixedPriceConfig.listingSchedule.startDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}{\" \"}\r\n                                  -{\" \"}\r\n                                  {fixedPriceConfig.listingSchedule.endDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}\r\n                                  &nbsp;&nbsp;&nbsp;\r\n                                  <i className=\"fas fa-calendar-week\" />\r\n                                </button>\r\n                              </DateRangePicker>\r\n                            </div>\r\n\r\n                            <div className=\"row\">\r\n                              <div className=\"mr-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"fixedPriceConfig.listingSchedule.startTime\"\r\n                                  placeholder=\"Start Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    fixedPriceConfig.listingSchedule.startTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n\r\n                              <div className=\"ml-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"fixedPriceConfig.listingSchedule.endTime\"\r\n                                  placeholder=\"End Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    fixedPriceConfig.listingSchedule.endTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        {/* <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>\r\n                                Reserve for\r\n                                specific buyer\r\n                              </b>\r\n                            </div>\r\n                          </div>\r\n                          <div>\r\n                            <label className=\"switch\">\r\n                              <input\r\n                                type=\"checkbox\"\r\n                                checked={\r\n                                  reserveBuyer\r\n                                }\r\n                                onChange={() =>\r\n                                  setReserveBuyer(\r\n                                    !reserveBuyer\r\n                                  )\r\n                                }\r\n                              />\r\n                              <span className=\"slider round\"></span>\r\n                            </label>\r\n                          </div>\r\n                        </div> */}\r\n                        {reserveBuyer && (\r\n                          <div\r\n                            className=\"mb-3 budle-wrapper\"\r\n                            style={{\r\n                              borderBottom: \"1px solid\",\r\n                              paddingBottom: \"2rem\",\r\n                            }}\r\n                          >\r\n                            <span>\r\n                              <input\r\n                                type=\"text\"\r\n                                placeholder=\"0xf45a189...\"\r\n                                required\r\n                                defaultValue={fixedPriceConfig.reserveFor}\r\n                                onChange={(e) => onChange(e)}\r\n                                name=\"fixedPriceConfig.reserveFor\"\r\n                              />\r\n                            </span>\r\n                          </div>\r\n                        )}\r\n                      </Tab.Pane>\r\n                      <Tab.Pane eventKey=\"timedAuction\">\r\n                        <div className=\"form-group\">\r\n                          <label htmlFor=\"method\" className=\"text-white mb-2\">\r\n                            <b>Method</b>\r\n                          </label>\r\n                          <select\r\n                            className=\"form-control\"\r\n                            id=\"timed-auction-method\"\r\n                            name=\"timedAuctionConfig.method\"\r\n                            onChange={(e) => onChange(e)}\r\n                          >\r\n                            <option value={1}>\r\n                              Sell to the highest bidder\r\n                            </option>\r\n                            {/* <option value={2}>\r\n                              Sell with the\r\n                              declining price\r\n                            </option> */}\r\n                          </select>\r\n                        </div>\r\n\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text position-relative\">\r\n                            <div className=\"text-white mb-2 absolute-wrapper\">\r\n                              <b>Starting Price</b>\r\n                            </div>\r\n                            <div className=\"text-right mb-2\">\r\n                              <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                            </div>\r\n                            <div className=\"d-flex\">\r\n                              <button type=\"button\" className=\"ethereum-btn\">\r\n                                <svg\r\n                                  viewBox=\"0 0 126.61 126.61\"\r\n                                  xmlns=\"http://www.w3.org/2000/svg\"\r\n                                  fill=\"currentColor\"\r\n                                  height=\"18\"\r\n                                  width=\"18\"\r\n                                >\r\n                                  <g>\r\n                                    <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                    <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                    <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                    <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                    <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                  </g>\r\n                                </svg>\r\n                                <span className=\"ml-2\">{ENV.currency}</span>\r\n                              </button>\r\n                              <input\r\n                                type=\"text\"\r\n                                name=\"timedAuctionConfig.startPrice.amount\"\r\n                                placeholder=\"Amount\"\r\n                                className=\"amount-btn ml-3\"\r\n                                style={{\r\n                                  borderRadius: \"4px\",\r\n                                }}\r\n                                onChange={(e) => onChange(e)}\r\n                                onKeyDown={(e) => decimalNumberValidator(e)}\r\n                                defaultValue={\r\n                                  timedAuctionConfig.startPrice.amount\r\n                                }\r\n                                required\r\n                              />\r\n                              {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                $ 0.00\r\n                              </div> */}\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        <div className=\"price-wrapper d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>Duration</b>\r\n                            </div>\r\n                            <div className=\"date-picker\">\r\n                              <DateRangePicker\r\n                                initialSettings={dateRangeInitialSettings}\r\n                                onApply={handleDateChange}\r\n                              >\r\n                                <button\r\n                                  name=\"timedAuctionConfig.duration\"\r\n                                  className=\"calender-btn\"\r\n                                >\r\n                                  <i className=\"fas fa-calendar-week\" />\r\n                                  &nbsp;&nbsp;&nbsp;\r\n                                  {timedAuctionConfig.duration.startDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}{\" \"}\r\n                                  -{\" \"}\r\n                                  {timedAuctionConfig.duration.endDate.format(\r\n                                    \"MMMM D, YYYY\"\r\n                                  )}\r\n                                </button>\r\n                              </DateRangePicker>\r\n                            </div>\r\n\r\n                            <div className=\"row\">\r\n                              <div className=\"mr-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"timedAuctionConfig.duration.startTime\"\r\n                                  placeholder=\"Start Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    timedAuctionConfig.duration.startTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n\r\n                              <div className=\"ml-auto my-3 budle-wrapper\">\r\n                                <input\r\n                                  type=\"time\"\r\n                                  name=\"timedAuctionConfig.duration.endTime\"\r\n                                  placeholder=\"End Time\"\r\n                                  onChange={(e) => onChange(e)}\r\n                                  defaultValue={\r\n                                    timedAuctionConfig.duration.endTime\r\n                                  }\r\n                                  required\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </div>\r\n                        {/* <div className=\"reverse-price d-flex\">\r\n                          <div className=\"price-text\">\r\n                            <div className=\"text-white\">\r\n                              <b>\r\n                                Include reserve\r\n                                price\r\n                              </b>\r\n                            </div>\r\n                          </div>\r\n                          <div>\r\n                            <label className=\"switch\">\r\n                              <input\r\n                                type=\"checkbox\"\r\n                                checked={\r\n                                  reservePrice\r\n                                }\r\n                                onChange={() =>\r\n                                  setReservePrice(\r\n                                    !reservePrice\r\n                                  )\r\n                                }\r\n                              />\r\n                              <span className=\"slider round\"></span>\r\n                            </label>\r\n                          </div>\r\n                        </div> */}\r\n                        {reservePrice && (\r\n                          <div className=\"d-flex\">\r\n                            <button type=\"button\" className=\"ethereum-btn\">\r\n                              <svg\r\n                                viewBox=\"0 0 126.61 126.61\"\r\n                                xmlns=\"http://www.w3.org/2000/svg\"\r\n                                fill=\"currentColor\"\r\n                                height=\"18\"\r\n                                width=\"18\"\r\n                              >\r\n                                <g>\r\n                                  <path d=\"m38.73 53.2 24.59-24.58 24.6 24.6 14.3-14.31-38.9-38.91-38.9 38.9z\" />\r\n                                  <path d=\"m0 63.31 14.3-14.31 14.31 14.31-14.31 14.3z\" />\r\n                                  <path d=\"m38.73 73.41 24.59 24.59 24.6-24.6 14.31 14.29-38.9 38.91-38.91-38.88z\" />\r\n                                  <path d=\"m98 63.31 14.3-14.31 14.31 14.3-14.31 14.32z\" />\r\n                                  <path d=\"m77.83 63.3-14.51-14.52-10.73 10.73-1.24 1.23-2.54 2.54 14.51 14.5 14.51-14.47z\" />\r\n                                </g>\r\n                              </svg>\r\n                              <span className=\"ml-2\">{ENV.currency}</span>\r\n                            </button>\r\n                            <input\r\n                              type=\"text\"\r\n                              name=\"timedAuctionConfig.reservePrice.amount\"\r\n                              placeholder=\"Amount\"\r\n                              className=\"amount-btn ml-3\"\r\n                              style={{\r\n                                borderRadius: \"4px\",\r\n                              }}\r\n                              onChange={(e) => onChange(e)}\r\n                              onKeyDown={(e) => decimalNumberValidator(e)}\r\n                              defaultValue={\r\n                                timedAuctionConfig.reservePrice.amount\r\n                              }\r\n                              required\r\n                            />\r\n                            {/* <div className=\"text-right mb-2 dollar-wrapper\">\r\n                              $ 0.00\r\n                            </div> */}\r\n                          </div>\r\n                        )}\r\n                      </Tab.Pane>\r\n                    </Tab.Content>\r\n\r\n                    <div className=\"d-flex justify-content-between my-3 text-white\">\r\n                      <div>\r\n                        <b>Fees</b>\r\n                      </div>\r\n                      <div>\r\n                        <i className=\"fas fa-exclamation-circle\" />\r\n                      </div>\r\n                    </div>\r\n                    <div className=\"d-flex justify-content-between text-white mb-4\">\r\n                      <div>Service Fee</div>\r\n                      <div>{serviceFee}%</div>\r\n                    </div>\r\n                    <div className=\"d-flex justify-content-between text-white mb-4\">\r\n                      <div>Creator Royalty</div>\r\n                      <div>{nft?.royalty || 0}%</div>\r\n                    </div>\r\n\r\n                    <button\r\n                      className=\"complete-listing-btn p-3\"\r\n                      onClick={() => submit()}\r\n                    >\r\n                      Complete Listing\r\n                    </button>\r\n                  </Container>\r\n                </div>\r\n              </Tab.Container>\r\n            </div>\r\n          </div>\r\n          <div className=\"summary-container\">\r\n            {nft && <NFTPreview {...nft} />}\r\n            {/* IMPORTED NFT PREVIEW SO THIS CODE IS NOT NEEDED ANYMORE */}\r\n            {/* <div className=\"d-flex justify-content-center align-items-center\">\r\n              <img src=\"img/auction_1.jpg\" className=\"img-fluid\" style={{ height: \"250px\", width: \"300px\" }} />\r\n            </div>\r\n            <div className=\"pt-3 pb-3\">\r\n              <div className=\"d-flex justify-content-between text-white pb-2\">\r\n                <div>WannaPanda - PnPIbqI9ZF</div>\r\n                <div>Price</div>\r\n              </div>\r\n              <div className=\"d-flex justify-content-between text-white pb-2\">\r\n                <div>1</div>\r\n                <div><i className=\"fab fa-ethereum\" />0</div>\r\n              </div>\r\n            </div> */}\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  nft: state.nft,\r\n  error: state.error,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n  beforeNFT,\r\n  getNFT,\r\n  upsertNFT,\r\n})(Sell);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/how-it-works/how-it-works.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/privacy-&-terms/privacy-&-terms.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],["1210","1211"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nfts/nfts.action.js",["1212","1213","1214","1215"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n    axiosPostFormData,\n    decimalNumberValidator,\n  } from \"./../../utils/functions\";\n  import axios from 'axios'\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    \n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    \nconsole.log(url,\"getNFTs\")\n\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n     \n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n\n      // alert(\"called\")\n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n   \n    });\n};\n\nexport const getNFTsByCollection=(id)=>(dispatch)=>{\n  \n\n  let data ={\n    collectionId:id\n  }\n\n\n  dispatch(emptyError());\n\n    const url = `${ENV.url}nfts/getNFTsByCollection`;\n    axios.post(url,data)\n    .then(function (response) {\n  \n      if (response.data.success) {\n              dispatch({\n                type:GET_NFTS_BY_COLLECTION,\n                payload:response.data.data\n              })\n         \n            } else {\n              dispatch({\n                type: GET_ERRORS,\n                payload: response.data,\n              });\n            }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n              type: GET_ERRORS,\n              payload: error,\n            });\n    });\n  \n  \n}\n\nexport const getMyLikedNfts=(qs='')=>(dispatch)=>{\n\n\n  dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url=url+qs\n    axios.get(url)\n    .then(function (response) {\nconsole.log()\n      if (response.data.success) {\n        dispatch({\n          type: GET_MYLIKED_NFTS,\n          payload: response.data.data,\n        });\n         \n            } else {\n             \n            }\n    })\n    .catch(function (error) {\n      console.log(error);\n    \n    });\n  \n  \n}\n\nexport const createNFT= async (formData)=>{\n    try {\n\n        const res = await axiosPostFormData(\n            \"nfts/create\",\n            formData,\n            true\n          );\n    }\n    catch(err){\n\n    }\n}\nexport const setNftToken = (formData) => async (dispatch) => {\n\n  const res = await axiosPostFormData(\n            \"nfts/storeNFTData\",\n            formData,\n            true\n          );\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        console.log(data,\"profile nfts\")\n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n          \n        } else {\n     \n        }\n      })\n      .catch((errors) => {\n     \n      });\n  };\n\n\n\n\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Navbar/navbar.js",["1216","1217","1218","1219","1220","1221","1222","1223","1224"],"// import react from 'react'\nimport \"./navbar.css\";\nimport { useHistory } from \"react-router-dom\";\nimport { BsTwitter } from \"react-icons/bs\";\nimport { SiDiscord } from \"react-icons/si\";\nimport { FaTelegramPlane } from \"react-icons/fa\";\nimport { GrReddit } from \"react-icons/gr\";\nimport { AiFillHome } from \"react-icons/ai\";\nimport mintsLogoSmily from \"../../assets/images/mintsClubSmilyLogo1.png\";\nimport MintsClub from \"../../assets/images/MintsClub-White.png\";\nimport { ENV } from \"../../config/config\";\nimport fullNavIcon from \"../../assets/images/mintsClubLogo1.png\";\n\nconst Navbar = () => {\n  const history = useHistory();\n  const twitter = ENV.twitterLink;\n  const discordLink = ENV.discordLink;\n  const telegramLink = ENV.telegramLink;\n  const redditLink = ENV.redditLink;\n\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n\n  return (\n    <div className=\"nav align-items-center\">\n      <input type=\"checkbox\" id=\"nav-check\" />\n      {/* <div className=\"nav-icon\" ><img src={fullNavIcon} width=\"20%\" /></div> */}\n      <div className=\"nav-header\" style={{ width: \"25%\" }}>\n        <div className=\"nav-title\" onClick={() => history.push(\"/\")}>\n          <img src={MintsClub} width=\"100%\" />\n        </div>\n      </div>\n      <div className=\"nav-btn\">\n        <label htmlFor=\"nav-check\">\n          <span></span>\n          <span></span>\n          <span></span>\n        </label>\n      </div>\n\n      <div className=\"nav-links\">\n        <a\n          className=\"navbar-item\"\n          href=\"#\"\n          target=\"_blank\"\n          style={{ color: \"#ffd33e\" }}\n        >\n          <AiFillHome className=\"home-icon \" />\n          Home\n        </a>\n\n        {twitter && twitter.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={twitter} target=\"_blank\">\n              <BsTwitter className=\"home-icon \" />\n              Twitter\n            </a>\n          </>\n        )}\n\n        {discordLink && discordLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={discordLink} target=\"_blank\">\n              <SiDiscord className=\"home-icon \" />\n              Discord\n            </a>\n          </>\n        )}\n\n        {telegramLink && telegramLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={telegramLink} target=\"_blank\">\n              <FaTelegramPlane className=\"home-icon \" />\n              Telegram\n            </a>\n          </>\n        )}\n\n        {redditLink && redditLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={redditLink} target=\"_blank\">\n              <GrReddit className=\"home-icon \" />\n              Reddit\n            </a>\n          </>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Navbar;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Slider/slider.js",["1225","1226","1227"],"import React, { useState, useEffect } from \"react\";\nimport \"./slider.css\";\nimport Slider from \"react-slick\";\nimport \"slick-carousel/slick/slick.css\";\nimport \"slick-carousel/slick/slick-theme.css\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\n// import image from \"../../assets/images/test.jpg\";\nimport nftBack from \"../../assets/images/nftBack.png\";\n// import nftImage from \"../../assets/images/nftImage.png\";\n\nconst SimpleSlider = (props) => {\n  const [showSlider, setShowSlider] = useState(false);\n  useEffect(() => {\n    if (showSlider == false) {\n      setTimeout(() => {\n        setShowSlider(true);\n      }, 300);\n    }\n  });\n  const settings = {\n    dots: true,\n    infinite: true,\n    speed: 500,\n    slidesToShow: 1,\n    slidesToScroll: 1,\n  };\n\n  return (\n    <div\n      className=\"position-relative slider-container\"\n      style={{ backgroundColor: \"\" }}\n    >\n      {/* <h2> Single Item</h2> */}\n\n      <img\n        src={nftBack}\n        style={{ width: \"26rem\", minWidth: \"26rem\" }}\n        className=\"slider-bg\"\n      />\n\n      <div\n        className=\"position-absolute nfts-title-container\"\n        style={{ top: \"-3rem\", right: \"9rem\" }}\n      >\n        <p\n          className=\"text-white mb-0 worlds-famous\"\n          style={{\n            fontSize: \"34px\",\n            fontWeight: \"bold\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          World's Famous\n        </p>\n        <p\n          className=\"mb-0 text-white nfts-title\"\n          style={{\n            // fontSize: \"165px\",\n            fontSize: \"8.2vw\",\n            fontWeight: \"bold\",\n            marginTop: \"-3rem\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          NFT's\n        </p>\n      </div>\n      <div\n        className=\"position-relative slider-wrapper\"\n        style={{\n          bottom: \"22rem\",\n          right: \"-2rem\",\n          cursor: \"pointer\",\n          display: showSlider ? \"block\" : \"none\",\n        }}\n      >\n        <Slider {...settings}>\n          {props.assetList.map((nft, index) => {\n            return (\n              <div key={index} onClick={() => window.open(nft.link)}>\n                <img\n                  src={nft.img}\n                  className=\"slider-img\"\n                  alt={nft}\n                  style={{ objectFit: \"cover\" }}\n                />\n              </div>\n            );\n          })}\n        </Slider>\n      </div>\n    </div>\n  );\n};\nexport default SimpleSlider;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/exportData.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.action.js",["1228"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport { GET_ERRORS, SET_USER, GET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, BEFORE_USER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { getCollections, setAuthState } from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n    return {\n        type: BEFORE_USER\n    }\n}\n\n// method to set user data\nexport const setUser = (user) => dispatch => {\n    dispatch(emptyError())\n    dispatch({\n        type: SET_USER,\n        payload: user\n    })\n}\n\n// method to get user data\nexport const getUser = () => dispatch => {\n    dispatch({\n        type: GET_USER\n    })\n}\n\n// method to login using wallet address and sign\nexport const login = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/login/`;\n    // const url = `http://localhost:5000/v1/front/auth/login/`;\n    console.log(payload,\"payload\")\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            const userId = data.data._id;\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => dispatch => {\n    \n    dispatch(emptyError());\n    const url = `${ENV.url}auth/register/`;\n \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        console.log(errors,\"register resonse\")\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n            toast.success(data.message)\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getTopSellers = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/top-sellers`;\n   \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n     \n        if (data.status) {\n            dispatch({\n                type: TOP_SELLERS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n     \n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getCreators = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/creators`;\n    // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n    \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n      \n        if (data.status) {\n            dispatch({\n                type: SET_CREATORS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/${userId}`;\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"user response\")\n        if (data.status) {\n            dispatch({\n                type: SET_INDIVIDUAL_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => dispatch => {\n    dispatch(emptyError());\n    dispatch({\n        type: SET_INDIVIDUAL_USER,\n        payload: user\n    })\n};\n\nexport const logoutUser = () => (dispatch) => {\n    dispatch({\n        type: SET_USER,\n        userAuth: false,\n        userData: null\n    })\n    dispatch(setAuthState())\n    localStorage.removeItem('encuse');\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.js",["1229","1230","1231"],"import React, {\r\n  useState,\r\n  useEffect,\r\n  forwardRef,\r\n  useImperativeHandle,\r\n} from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeCollection, getCollections } from \"./collections.actions\";\r\nconst { collectionFeaturedImg, userDefaultImg } = ENV;\r\n\r\nconst Collections = forwardRef((props, ref) => {\r\n  const [collections, setCollections] = useState(null);\r\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    if (props.source) setSource(props.source);\r\n\r\n    if (props.setLoader) props.setLoader(false); //to be changed\r\n\r\n    getCollections();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.collection.getAuth) {\r\n      const { collections } = props.collection;\r\n      const userId = ENV.getUserKeys(\"_id\")._id;\r\n      if (props.mycollections) {\r\n        let myCollections = collections.filter(\r\n          (item) => item.userId === userId\r\n        );\r\n        setCollections(myCollections);\r\n      } else {\r\n        setCollections(collections);\r\n      }\r\n      props.beforeCollection();\r\n      if (props.setLoader) props.setLoader(false);\r\n    }\r\n  }, [props.collection.getAuth]);\r\n\r\n  const getCollections = (categoryId = null) => {\r\n    const filter = {\r\n      page: 1,\r\n    };\r\n    if (categoryId) filter.categoryId = categoryId;\r\n\r\n    if (props.userId) filter.userId = props.userId;\r\n\r\n    if (props.popular) filter.popular = true;\r\n\r\n    // if not all then apply limit\r\n    if (!props.all) filter.limit = props.limit ? props.limit : 8;\r\n    else filter.all = true;\r\n\r\n    const qs = ENV.objectToQueryString(filter);\r\n    props.getCollections(qs);\r\n  };\r\n\r\n  useImperativeHandle(ref, () => ({\r\n    getCatCollections: (catId) => {\r\n      if (props.setLoader) props.setLoader(true);\r\n\r\n      getCollections(catId);\r\n    },\r\n    colCount: collections?.length || 0,\r\n  }));\r\n\r\n  const dummyCollections = [\r\n    {\r\n      id: 1,\r\n      name: \"Modern Art collection\",\r\n      itemNos: \"5\",\r\n      owner: \"Abcd\",\r\n    },\r\n    {\r\n      id: 2,\r\n      name: \"Modern Art collection\",\r\n      itemNos: \"5\",\r\n      owner: \"Abcd\",\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <div className=\"popular-collections-area\">\r\n      <div className=\"container\">\r\n        <div\r\n          className={`row items ${!collections && \"justify-content-center\"}`}\r\n        >\r\n          <>\r\n            {/* {collections && collections.length ? (\r\n              collections.map((item, idx) => { */}\r\n            {dummyCollections && dummyCollections.length ? (\r\n              dummyCollections.map((item, idx) => {\r\n                return (\r\n                  <div\r\n                    key={`cd_${idx}`}\r\n                    className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                  >\r\n                    <div className=\"card no-hover text-center\">\r\n                      <div className=\"image-over\">\r\n                        <Link\r\n                          to={`/collection-details/${window.btoa(item._id)}`}\r\n                        >\r\n                          <img\r\n                            className=\"card-img-top\"\r\n                            src={\r\n                              item.featuredImg\r\n                                ? item.featuredImg\r\n                                : collectionFeaturedImg\r\n                            }\r\n                            alt=\"Collection Featured Image\"\r\n                          />\r\n                        </Link>\r\n                        <Link\r\n                          className=\"seller\"\r\n                          to={\r\n                            source === 1\r\n                              ? `/collection-details/${window.btoa(item._id)}`\r\n                              : `/author/${item.user._id}`\r\n                          }\r\n                        >\r\n                          <div className=\"seller-thumb avatar-lg\">\r\n                            <img\r\n                              className=\"rounded-circle\"\r\n                              src={\r\n                                source === 1\r\n                                  ? item.logo\r\n                                  : item.user.profilePhoto\r\n                                  ? item.user.profilePhoto\r\n                                  : userDefaultImg\r\n                              }\r\n                              alt={\r\n                                source === 1 ? \"Collection Logo\" : \"User Avatar\"\r\n                              }\r\n                            />\r\n                          </div>\r\n                        </Link>\r\n                      </div>\r\n                      <div className=\"card-caption col-12 p-0\">\r\n                        <div className=\"card-body mt-4\">\r\n                          <Link\r\n                            to={`/collection-details/${window.btoa(item._id)}`}\r\n                          >\r\n                            <h5 className=\"mb-2\">{item.name}</h5>\r\n                          </Link>\r\n                          <span>\r\n                            {item.category\r\n                              ? item.category.name\r\n                              : \"Category: N/A\"}\r\n                          </span>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                );\r\n              })\r\n            ) : (\r\n              <div className=\"col-12\">\r\n                <p className=\"text-center mt-4\">No Collection Found</p>\r\n              </div>\r\n            )}\r\n          </>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n});\r\n\r\nconst mapStateToProps = (state) => ({\r\n  collection: state.collection,\r\n  error: state.error,\r\n});\r\n\r\nexport default connect(\r\n  mapStateToProps,\r\n  { beforeCollection, getCollections },\r\n  null,\r\n  { forwardRef: true }\r\n)(Collections);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.js",["1232","1233","1234","1235","1236","1237","1238","1239"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  useEffect(() => {\n    if (props.settings.settingsAuth) {\n      setData(props.settings.settings);\n    }\n  }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div class=\"input-group notify-form\">\n                  <div class=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      class=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2021 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.actions.js",["1240","1241"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_COLLECTION, SET_AUTH_STATE, GET_COLLECTION, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS,BEFORE_CATEGORY, GET_CATEGORIES,COLLECTION_CATEGORES ,MY_COLLECTIONS} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\n\nexport const beforeCollection = () => {\n    return {\n        type: BEFORE_COLLECTION\n    }\n}\n\nexport const getCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}collection/get/${collectionId}`;\n \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getCollections = (qs = null) => dispatch => {\n\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs)\n    url += `?${qs}`\n   console.log(url,\"url sending\")\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n   console.log(data,\"collections api response\")\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n       \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const myCollections = (userId) => dispatch => {\n\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/myCollectionList`;\n\n    if (userId)\n    url += `?userId=${userId}`\n    \n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            \n            dispatch({\n                type: MY_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data.message\n            })\n        }\n    }).catch(error => {\n      \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\nexport const upsertCollection = (apiURL, body, method = 'POST') => dispatch => {\n\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n\n    fetch(url, {\n        method,\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: UPSERT_COLLECTION,\n                payload: data\n            })\n            \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}collection/delete/${collectionId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const setAuthState = () => (dispatch) => {\n    dispatch({\n        type: SET_AUTH_STATE,\n    })\n}\nexport const beforeCategory = () => {\n    return {\n        type: BEFORE_CATEGORY\n    }\n}\nexport const getCategories = () => dispatch => {\n  \n    dispatch(emptyError());\n    const url = `${ENV.url}category/list`;\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n \n        if (data.status) {\n         \n            dispatch({\n                type: COLLECTION_CATEGORES,\n                payload: data.categories\n            })\n\n         \n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"error==>\")\n     \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const toggleLikeDislike = (body) => dispatch => {\n let data=JSON.stringify(body)\n    const url = `${ENV.url}collectionLikes/likeDislike`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        data\n    }).then(res => res.json()).then(data => {\n  \n       \n    }).catch(error => {\n     console.log(error,\"error likes\")\n    })\n};","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/web3.js",["1242"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/functions.js",["1243","1244","1245","1246","1247","1248","1249","1250","1251"],"import axios from \"axios\";\nimport { ENV } from '../config/config';\nimport { Redirect } from 'react-router-dom';\nimport { toast } from 'react-toastify'\nimport { useDispatch } from \"react-redux\";\nimport { emptyError } from '../redux/shared/error/error.action';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID } from '../redux/types';\nlet baseUrl = process.env.REACT_APP_BASE_URL;\n\nexport const axiosSyncPost = (url, data, isMultipart = false) => {\n  return new Promise((resolve, reject) => {\n    const params = new URLSearchParams();\n    let keys = Object.keys(data);\n    for (let x = 0; x < keys.length; x++) {\n      params.append(keys[x], data[keys[x]]);\n    }\n\n    const config = {\n      headers: {\n        'Content-Type': isMultipart ? 'multipart/form-data' : 'application/x-www-form-urlencoded',\n        \"Authorization\": ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n    };\n\n    url = baseUrl + url;\n\n    axios.post(url, params, config).then(\n      (res) => {\n        resolve(res.data);\n      },\n      (error) => {\n        resolve(error)\n      },\n    );\n  });\n};\n\nexport const axiosPostFormData = (url, body, isMultipart = false) => {\n\n  return new Promise((resolve, reject) => {\n    const config = {\n      headers: {\n        // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n        \"Authorization\": ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n    };\n    \n\n    // url = testingURl + url;\n\n\n    axios.post(ENV.url + url, body, config).then(\n      (res) => {\n        // console.log(res,\"res success\");\n        resolve(res.data)\n      },\n      (error) => {\n        console.log(error,\"res error\");\n        resolve(error)\n      },\n    );\n  });\n};\n\nexport const decimalNumberValidator = (evt) => {\n  let e = evt || window.event;\n\n  // Allow: backspace, delete, tab, escape, enter and .\n  const specialKeys = [46, 8, 9, 27, 13, 110]\n\n  // Allow: Ctrl+A,Ctrl+C,Ctrl+V, Command+A\n  if (specialKeys.includes(e.keyCode) ||\n    // Allow: Ctrl+A,Ctrl+C,Ctrl+Z,Ctrl+X Command+A\n    ((e.keyCode === 65 || e.keyCode === 67 || e.keyCode === 90 || e.keyCode === 88) && (e.ctrlKey === true || e.metaKey === true)) ||\n    // Allow: home, end, left, right, down, up\n    (e.keyCode >= 35 && e.keyCode <= 40)) {\n    // let it happen, don't do anything\n    return;\n  }\n\n  let key = e.keyCode || e.which;\n  if ((!e.shiftKey && !e.altKey && !e.ctrlKey) &&\n    (((key === 190 || key === 110) ||\n      (key >= 48 && key <= 57)) ||\n      (key >= 96 && key <= 105) ||\n      key === 8 || key === 9 || key === 13 ||\n      key === 35 || key === 36 ||\n      key === 37 || key === 39 ||\n      key === 46 || key === 45)) {\n  }\n  else {\n    e.returnValue = false;\n    if (e.preventDefault) e.preventDefault();\n  }\n}\nexport const setFixedPriceNftTOken=(body)=>{\n  let url = `${ENV.url}nftFixedTokens/getFixedtokens`;\n  // let url = `http://3.142.91.8/v1/front/auctions/live`;\n \n  // console.log(url,\"url==>123\")\n    \n\n  fetch(url, {\n      method: 'POST',\n      headers: {\n          'content-type': 'application/json',\n          'Authorization': ENV.Authorization,\n          'x-auth-token': ENV.x_auth_token,\n          'Access-Control-Allow-Origin': '*',\n          'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n      body:body\n  }).then(res => res.json()).then(data => {\n      // console.log(data,\"created nft token\")\n      if (data.success) {\n        \n      } else {\n         \n      }\n  }).catch(errors => {\n      console.log(errors,\"error\")\n  })\n}\n\nexport const changeOwnerShip=(nftOwnerId,currentUserId)=>{\n  // alert(\"changing ownership\")\n  let url = `${ENV.url}nfts/editNft`;\n  // console.log('fetch url', url)\nlet body={\n  nftOwnerId,\n  currentUserId\n}\n  fetch(url, {\n    method: 'PATCH',\n    headers: {\n      'content-type': 'application/json',\n      'Authorization': ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  },\n    body:JSON.stringify(body)\n     }).then(res => res.json()).then(data => {\n       if(data.status === 'success'){\n        toast.success(\"Successfully bought nft\")\n        window.location.href= '/explore-all'\n       }\n      // console.log(data,\"response from the change ownershiop\")\n     }).catch(errors => {\n       console.log('error',errors)\n    })\n}\nexport const acceptBit = (tokenId,body)  => {\n \n   \n    const url = `${ENV.url}bid/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n            window.location.href= '/explore-all'\n            // dispatch({\n            //     type: ACCEPT_BID,\n            //     payload: data\n            // })\n        } else {\n            toast.error(data.message)\n          \n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n      \n    })\n\n}\n\nexport const placeBidApi = (body) =>  {\n\n  console.log('im here')\n\n\n  const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n    //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n           \n            toast.success(data.message)\n            window.location.href= '/explore-all'\n            // dispatch({\n            //     type: CREATE_BID,\n            //     payload: data\n            // })\n        } else {\n            toast.error(data.message)\n            // dispatch({\n            //     type: GET_ERRORS,\n            //     payload: data\n            // })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        // dispatch({\n        //     type: GET_ERRORS,\n        //     payload: error\n        // })\n    })\n \n \n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/header/header.js",["1252","1253","1254","1255","1256","1257","1258"],"import React, { useState, useEffect } from \"react\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { setWalletAddress, getWalletAddress } from \"../wallet/wallet.action\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport { logoutUser } from \"../user/user.action\";\nimport { ENV } from \"./../../config/config\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport MintsClubLogo from \"../../assets/images/main-logo.svg\";\n\nconst Header = (props) => {\n  const history = useHistory();\n  // console.log(\"history\", history);\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [loader, setLoader] = useState(true);\n  const { _id } = ENV.getUserKeys(\"_id\");\n\n  useEffect(async () => {\n    // COMMENTED TEMPORARILY\n    // METHOD 1\n    // props.getWalletAddress()\n\n    // METHOD 2 - a\n    // let connectedAddress = await connectMetamask();\n    // setConnectedAddress(connectedAddress)\n\n    // METHOD 3\n    // if (localStorage.getItem('wa')) {\n    //     let connectedAddress = window.atob(localStorage.getItem('wa'))\n    //     setConnectedAddress(connectedAddress)\n    // }\n\n    // METHOD 4\n    let connectedAddress = await connectMetamaskCopy();\n    setConnectedAddress(connectedAddress);\n    props.setWalletAddress(connectedAddress);\n  }, []);\n\n  // set loader to false when address is received\n  useEffect(() => {\n    if (connectedAddress) setLoader(false);\n  }, [connectedAddress]);\n\n  // COMMENTED TEMPORARILY\n  // METHOD 2 - b\n  // useEffect(() => {\n  //     if (props.wallet.walletAuth) {\n  //         const { connectedAddress } = props.wallet\n  //         setConnectedAddress(connectedAddress)\n  //     }\n  // }, [props.wallet.walletAuth])\n  const formatAddress = (address) => {\n    return address ? address.substr(0, 6) + \"...\" + address.substr(-4) : null;\n  };\n  const logoutUser = () => {\n    props.logoutUser();\n    history.push(\"/login\");\n  };\n\n  return (\n    <header id=\"header\">\n      <div className=\"container header\">\n        {/* Navbar */}\n        <nav\n          data-aos=\"zoom-out\"\n          data-aos-delay={800}\n          className=\"navbar navbar-expand\"\n        >\n          {/* Navbar Brand*/}\n          <Link className=\"navbar-brand\" to=\"/\">\n            <img\n              className=\"navbar-brand-sticky\"\n              src={MintsClubLogo}\n              alt=\"sticky brand-logo\"\n            />\n          </Link>\n          <div className=\"ml-auto\" />\n          {/* Navbar */}\n          <ul className=\"navbar-nav items mx-auto\">\n            <li className=\"nav-item dropdown\">\n              <Link className=\"nav-link\" to=\"/\">\n                Home\n              </Link>\n            </li>\n            <li className=\"nav-item dropdown\">\n              <a className=\"nav-link\">\n                Explore <i className=\"fas fa-angle-down ml-1\" />\n              </a>\n              <ul className=\"dropdown-menu\">\n                <li className=\"nav-item\">\n                  <Link to=\"/explore-all\" className=\"nav-link\">\n                    Explore\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/auctions\" className=\"nav-link\">\n                    Live Auctions\n                  </Link>\n                </li>\n                {/* <li className=\"nav-item\"><Link to=\"/item-details\" className=\"nav-link\">Item Details</Link></li> */}\n              </ul>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/activity\" className=\"nav-link\">\n                Activity\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/collections\" className=\"nav-link\">\n                Collections\n              </Link>\n            </li>\n            {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Community <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/blog\" className=\"nav-link\">Blog</a></li>\n                                <li className=\"nav-item\"><a href=\"/blog-single\" className=\"nav-link\">Blog Single</a></li>\n                                <li className=\"nav-item\"><a href=\"/help-center\" className=\"nav-link\">Help Center</a></li>\n                            </ul>\n                        </li> */}\n            {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Pages <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/authors\" className=\"nav-link\">Authors</a></li>\n                                <li className=\"nav-item\"><a href=\"/author\" className=\"nav-link\">Author</a></li>\n                                <li className=\"nav-item\"><a href=\"/wallet-connect\" className=\"nav-link\">Wallet Connect</a></li>\n                                <li className=\"nav-item\"><a href=\"/create\" className=\"nav-link\">Create</a></li>\n                                <li className=\"nav-item\"><a href=\"/login\" className=\"nav-link\">Login</a></li>\n                                <li className=\"nav-item\"><a href=\"/signup\" className=\"nav-link\">Signup</a></li>\n                            </ul>\n                        </li> */}\n            <li className=\"nav-item\">\n              <Link to=\"/contact\" className=\"nav-link\">\n                Contact\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/history\" className=\"nav-link\">\n                History\n              </Link>\n            </li>\n          </ul>\n          {/* Navbar Icons */}\n          <ul className=\"navbar-nav icons\">\n            <li className=\"nav-item\">\n              <a\n                href=\"#\"\n                className=\"nav-link \"\n                data-toggle=\"modal\"\n                data-target=\"#search\"\n              >\n                <i className=\"fas fa-search\" />\n              </a>\n            </li>\n          </ul>\n          {/* Navbar Toggler */}\n          <ul className=\"navbar-nav toggle\">\n            <li className=\"nav-item\">\n              <a\n                href=\"#\"\n                className=\"nav-link\"\n                data-toggle=\"modal\"\n                data-target=\"#menu\"\n              >\n                <i className=\"fas fa-bars toggle-icon m-0\" />\n              </a>\n            </li>\n          </ul>\n          {/* Navbar Action Button */}\n          <ul className=\"navbar-nav action\">\n            <li className=\"nav-item ml-3\">\n              {connectedAddress && _id ? (\n                <button\n                  className=\"btn ml-lg-auto btn-linear-gradient\"\n                  onClick={logoutUser}\n                >\n                  <i className=\"icon-logout mr-md-2\" /> Logout\n                </button>\n              ) : (\n                // <span id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />{formatAddress(connectedAddress)}</span>\n                <Link\n                  to=\"/login\"\n                  id=\"wallet-address\"\n                  className=\"btn ml-lg-auto btn-linear-gradient\"\n                >\n                  {/* <i className=\"icon-wallet mr-md-2\" /> */}\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  Login\n                </Link>\n              )}\n            </li>\n          </ul>\n        </nav>\n      </div>\n    </header>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n});\nexport default connect(mapStateToProps, {\n  setWalletAddress,\n  getWalletAddress,\n  logoutUser,\n})(Header);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/abiSetup.js",["1259"],"import Web3 from 'web3';\nimport liveAuctionsAbi from './abis/ARISwapToken.json'\nimport {ENV} from '../config/config';\n// const web3 = new Web3(\n//   new Web3.providers.HttpProvider('https://data-seed-prebsc-1-s1.binance.org:8545')\n// );\n\nlet web3Provider = window.ethereum;\nvar web3 = new Web3(web3Provider);\n web3 = new Web3(Web3.givenProvider);\n//it's the abi\n\nlet liveAuction=null;\ntry{\n\n     liveAuction = new web3.eth.Contract(liveAuctionsAbi,'0xE400E3fb41B83a2f8161A8d6F34b7B3023441AF5');\n}\ncatch(err){\n// console.log(err,\"error in abiSetup\")\n}\n\nexport { liveAuction };\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/bids/bids.action.js",["1260","1261"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body,tokenId,price,toAddress,fromAddress) => dispatch => {\n    alert(\"in herer\")\n    // dispatch(emptyError());\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n    //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n           \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    // if (qs)\n    //     url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["1262","1263"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\nimport Modal from \"@mui/material/Modal\";\nimport { AiOutlineClose } from \"react-icons/ai\";\nimport { BiArrowBack } from \"react-icons/bi\";\n\nimport \"./PreviewModal.css\";\nimport { maxWidth } from \"@mui/system\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 830,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n};\n\nconst genStyle = {\n  row: {\n    display: \"grid\",\n  },\n};\n// let array = [1];\n\nconst PreviewModal = (props) => {\n  // console.log(props,\"props\")\n  const {\n    previewModal,\n    handlePreviewModal,\n    previewModalStep,\n    handlePreviewModalSteps,\n    onDeploy,\n    info,\n  } = props;\n  const handleNextStep = () => {\n    if (previewModalStep === 1) {\n      handlePreviewModalSteps(\"next\");\n    } else {\n      onDeploy();\n    }\n  };\n  // console.log(props,\"props\")\n  return (\n    <div>\n      <Modal\n        open={previewModal}\n        onClose={handlePreviewModal}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"preview-modal-container pt-4 px-1 px-md-5\">\n            <div className=\"w-100 d-flex justify-content-between \">\n              {previewModalStep > 1 ? (\n                <BiArrowBack\n                  className=\"text-white \"\n                  style={{\n                    fontSize: \"1.8rem\",\n                    cursor: \"pointer\",\n                  }}\n                  onClick={() => handlePreviewModalSteps(\"back\")}\n                />\n              ) : (\n                <span></span>\n              )}\n              <AiOutlineClose\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.8rem\",\n                  cursor: \"pointer\",\n                }}\n                onClick={() => handlePreviewModal()}\n              />\n            </div>\n\n            {previewModalStep === 1 ? (\n              <div className=\"row  preview-modal-info\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text \">Preview</p>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div className=\"previewModal-img\">\n                    {info.img && (\n                      <img\n                        src={info.img ? info.img : \"\"}\n                        className=\"mt-3\"\n                        style={{\n                          width: \"100%\",\n                          height: \"100%\",\n                          borderRadius: \"10px\",\n                          objectFit: \"contain\",\n                        }}\n                        alt=\"preview\"\n                      />\n                    )}\n                    {info.videoUrl && (\n                      <video className=\"preview-video-view mt-3\" controls>\n                        <source src={info.videoUrl} />\n                      </video>\n                    )}\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white external-label ml-0 my-2 ml-0\">\n                      External Link\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"url\"\n                      value={info.externalLink && info.externalLink.trim()}\n                      placeholder=\"External Link\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label mb-2 ml-0\">\n                      Name\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={info.name}\n                      placeholder=\"Name\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Email\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"email\"\n                      value={info.email}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Symbol\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={info.symbol && info.symbol.trim()}\n                      placeholder=\"Symbol\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Description\n                    </label>\n                    <textarea\n                      className=\"p-3 mt-1 w-100 externalLink-input\"\n                      placeholder=\"Description\"\n                      value={info.description && info.description.trim()}\n                      style={{\n                        color: \"#aaabab\",\n                        marginLeft: \"2rem\",\n                        margin: \"0\",\n                        width: \"100%\",\n                      }}\n                      maxLength=\"600\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Supply\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"number\"\n                      value={info.supply}\n                      disabled={true}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      placeholder=\"Supply\"\n                      maxLength=\"50\"\n                    />\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\" preview-modal-info rowCust\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text mb-3\">Preview</p>\n                </div>\n\n                <p className=\"text-white font-weight-bold preview-properties-title \">\n                  Properties{\" \"}\n                </p>\n\n                <div\n                  className=\"rowCust px-3 mb-3\"\n                  style={{\n                    overflowY: \"auto\",\n                    height: \"5.1rem\",\n                    overflowX: \"hidden\",\n                  }}\n                >\n                  {props.properties && props.properties.length > 0 ? (\n                    props.properties.map((item, index) => {\n                      return (\n                        <div\n                          className=\"row justify-content-between\"\n                          key={index}\n                        >\n                          <div className=\"col-12  col-md-6\" key={index}>\n                            <label\n                              className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                              for=\"preview-name\"\n                            >\n                              Name\n                            </label>\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.name}\n                              maxLength=\"50\"\n                              placeholder=\"Item Name\"\n                              disabled={true}\n                              id=\"preview-name\"\n                            />\n                          </div>\n\n                          <div className=\"col-12 col-md-6 pr-lg-0\">\n                            <label\n                              className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                              for=\"preview-value\"\n                            >\n                              Value\n                            </label>\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.value}\n                              placeholder=\"Value\"\n                              maxLength=\"50\"\n                              disabled={true}\n                              id=\"preview-value\"\n                            />\n                          </div>\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center\" style={{ color: \"#A9A9A9\" }}>\n                      {\"No Properties Found\"}\n                    </p>\n                  )}\n                </div>\n                <div className=\"previewdivider ml-3\"></div>\n                {/* ////////////////////////////////////////////// */}\n                <div className=\"mt-3\">\n                  <p className=\"text-white font-weight-bold preview-levels-title\">\n                    Levels{\" \"}\n                  </p>\n                  <div\n                    className=\"rowCust px-3\"\n                    style={{\n                      overflowY: \"auto\",\n                      overflowX: \"hidden\",\n                      height: \"5.1rem\",\n                    }}\n                  >\n                    {props.levels && props.levels.length > 0 ? (\n                      props.levels.map((item, index) => {\n                        return (\n                          <div className=\"row\" key={index}>\n                            <div className=\"col-12 col-md-6 \" key={index}>\n                              <label\n                                className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                                for=\"preview-name\"\n                              >\n                                Name\n                              </label>\n                              <input\n                                className=\"preview-input-step-2 value-input-preview w-100\"\n                                type=\"url\"\n                                value={item.name}\n                                placeholder=\"Levels\"\n                                style={{\n                                  marginTop: `${\n                                    index === 0 ? \"0rem\" : \"1.2rem\"\n                                  }`,\n                                  maxWidth: \"90%\",\n                                }}\n                                // maxLength=\"50\"\n                                disabled={true}\n                              />\n                            </div>\n\n                            <div className=\"col-12 col-md-6 \">\n                              <label\n                                className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                                for=\"preview-name\"\n                              >\n                                Value\n                              </label>\n                              <div\n                                className=\"d-flex align-items-center justify-content-between ml-3 preview-modal-value-2\"\n                                style={{\n                                  marginTop: `${\n                                    index === 0 ? \"0rem\" : \"1.2rem\"\n                                  }`,\n                                  width: \"93%\",\n                                }}\n                              >\n                                <input\n                                  className=\"preview-modal-step\"\n                                  type=\"number\"\n                                  pattern=\"[0-9]+\"\n                                  // maxlength=\"4\"\n                                  value={item.value}\n                                  placeholder=\"Value\"\n                                  name=\"value\"\n                                  disabled={true}\n                                  style={{\n                                    padding: \"0.6rem 1rem\",\n                                    width: \"45%\",\n                                  }}\n                                />\n\n                                <p className=\"text-white mb-0 mx-2\">Of</p>\n                                <input\n                                  className=\"preview-modal-step\"\n                                  type=\"number\"\n                                  min=\"1\"\n                                  max=\"5\"\n                                  name=\"total\"\n                                  placeholder=\"Total\"\n                                  disabled={true}\n                                  // onInput=\"javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);\"\n                                  value={item.total}\n                                  style={{\n                                    padding: \"0.6rem 1rem\",\n                                    width: \"45%\",\n                                  }}\n                                />\n                              </div>\n                            </div>\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\" text-center\" style={{ color: \"#A9A9A9\" }}>\n                        {\"No levels Found\"}\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            )}\n            <div className=\"w-100 text-center\">\n              <p className=\"text-white my-3\">{previewModalStep}/2</p>\n              {previewModalStep > 1 && props.maxLimit && (\n                <p className=\"text-danger\">\n                  {\"Maximum deployment limit reached,Please contact support\"}\n                </p>\n              )}\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary preview-btn mb-3\"\n                disabled={props.maxLimit && previewModalStep > 1 ? true : false}\n                onClick={() => handleNextStep()}\n              >\n                {previewModalStep === 1 ? \"Next\" : \"Deploy\"}\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nexport default PreviewModal;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/actions/actions.js",["1264","1265","1266"],"import { toast } from \"react-toastify\";\nimport Web3 from \"web3\";\nimport {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  // DEPLOY_CONTRACT,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS,\n  SET_OTP_EMAIL,\n} from \"../types/types\";\n\nimport { ENV } from \"../../config/config\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport axios from \"axios\";\nimport dotenv from \"dotenv\";\n\nexport const currentStepAction = () => (dispatch) => {\n  // alert(\"called\")\n\n  dispatch({\n    type: CURRENT_STEP,\n  });\n};\nexport const currentStepDecrement = () => (dispatch) => {\n  dispatch({\n    type: CURRENT_STEP_DECREMENT,\n  });\n};\nexport const clearCurrentStep = () => (dispatch) => {\n  dispatch({\n    type: CLEAR_CURRENT_STEP,\n  });\n};\n\nexport const contractResponse = () => (dispatch) => {\n  dispatch({\n    type: CONTRACT_REPONSE,\n  });\n};\nexport const setProperties = (data) => (dispatch) => {\n  // alert(\"callled\")\n  dispatch({\n    type: SET_PROPERTIES,\n    payload: data,\n  });\n};\nexport const setLevels = (data) => (dispatch) => {\n  dispatch({\n    type: SET_LEVELS,\n    payload: data,\n  });\n};\nexport const setOtpEmail = (data) => (dispatch) => {\n  dispatch({\n    type: SET_OTP_EMAIL,\n    payload: data,\n  });\n};\n\nexport const sendOtp = (data) => (dispatch) => {\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/sendVerficationEmail`;\n\n  axios.post(url, data, config).then(\n    (res) => {\n      console.log(res, \"send otp\");\n      if (res.status === 200) {\n        //  toast.success(\"Otp Verification Code sent to \")\n      }\n    },\n    (err) => {\n      console.log(err, \"error\");\n      alert(\"error while sending email\");\n    }\n  );\n};\n\nexport const verifyOtp = (email, otp) => (dispatch) => {\n  let data = {\n    email,\n    otp,\n  };\n  \n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/verify`;\n  // console.log(url);\n\n  axios.post(url, data, config).then(\n    (res) => {\n      // console.log(res, \"res\");\n      if (res.data.email) {\n        if (res.data.email !== email) {\n          toast.error(\"Invalid Email or OTP\");\n          return \" \";\n        }\n      }\n\n      if (res.data.status == false) {\n        toast.error(res.data.message);\n        return \" \";\n      }\n\n      if (res.data.status === true) {\n        setOtpEmail(res.data.data[0].email);\n        if (res.data.diffMins < -10) {\n          toast.error(\"Token is  Expired ,Please resend token & try again\");\n          return \" \";\n        } else {\n          toast.success(res.data.message);\n\n          dispatch({\n            type: SET_OTP_STATUS,\n            payload: true,\n          });\n        }\n      } else {\n        // console.log(\"error\")\n        toast.error(res.data.message);\n      }\n    },\n    (err) => {\n      toast.error(\"Invalid OTP or Email\");\n    }\n  );\n};\n\nexport const deployContract = (data, address, supply) => (dispatch) => {\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}users/createUser`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then(\n      async (res) => {\n        // console.log(res, \"response from backendfdkfd\");\n        const abi = res.data.data.abi;\n        if (res.data.status === true) {\n          let metaDataList = [];\n\n          for (let i = 1; i <= supply; i++) {\n            metaDataList.push(res.data.data.metaData);\n            dispatch({\n              type: SET_CONTRACT_INFO,\n              payload: res.data,\n            });\n          }\n\n          try {\n            const web3 = new Web3(Web3.givenProvider);\n            //contract deployment instance\n            let contract = new web3.eth.Contract(abi, null, {\n              data: res.data.data.bytecode,\n\n              from: address,\n              // gas: 4600000,\n              // gas: web3.utils.toHex(210000)\n            });\n\n            const txgas = await contract\n              .deploy({\n                data: res.data.data.bytecode,\n                arguments: [res.data.data.metaData],\n              })\n              .estimateGas();\n\n            //////////////////\n\n            //estimated gas fee\n            // const [gasPrice, gasCost] = await Promise.all([\n            //   web3.eth.getGasPrice(),\n            //   tx.estimateGas({from: address}),\n            // ]);\n            // console.log(txgas, \"gasPrice====>\");\n\n            /////////////////\n\n            contract\n              .deploy({\n                data: res.data.data.bytecode,\n                arguments: [res.data.data.name],\n              })\n              .send({\n                from: address,\n                gas: txgas,\n                // gas:4100000\n              })\n              .then((contractInstance) => {\n                toast.success(\"Contract Deployed Successfully!\");\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n\n                let info = {\n                  ...res.data,\n                  contractAddress: contractInstance.options.address,\n                };\n                dispatch({\n                  type: SET_CONTRACT_INFO,\n                  payload: {\n                    data: { ...info },\n                  },\n                });\n                dispatch({\n                  type: CONTRACT_ADDRESS,\n                  payload: contractInstance.options.address,\n                });\n                const contractData = {\n                  contractadd: contractInstance.options.address,\n                  Network: \"Etherium\",\n                  Deployed: true,\n                };\n\n                dispatch({\n                  type: CONTRACT_REPONSE,\n                  payload: contractData,\n                });\n              })\n              .catch((err) => {\n                // console.log(\"error dfdfd\", err);\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n\n                toast.error(\"Transaction Failed please check wallet history1!\");\n              });\n          } catch (err) {\n            // console.log(err,\"testing\")\n            dispatch({\n              type: LOADER,\n              payload: false,\n            });\n\n            toast.error(\"Transaction Failed please check wallet history!\");\n          }\n        } else {\n          // console.log(res,\"njhj\")\n          dispatch({\n            type: LOADER,\n            payload: false,\n          });\n\n          toast.error(res.data.data);\n        }\n        // console.log(res);\n      },\n      (error) => {\n        // console.log(error,\"dkjfkdjf\")\n        toast.error(error.response.data.data);\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n\n        dispatch({\n          type: CONTRACT_ERROR_MESSAGE,\n          payload: error,\n        });\n      }\n    )\n    .catch((err) => {\n      // console.log(err, \"error later==>\");\n    });\n};\n\nexport const mintToken = (data, address, supply, email) => async (dispatch) => {\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n  // console.log('here is data', data)\n  dispatch({\n    type: CONNECT_WELLET,\n    payload: address,\n  });\n  let metaDataList = [];\n  // console.log(data, \"data=====>\");\n  let metaData = \"\";\n  if (!data.data) {\n    metaData = data;\n  } else {\n    metaData = data.data.metaData;\n  }\n\n  for (let i = 1; i <= supply; i++) {\n    metaDataList.push(metaData);\n  }\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  try {\n    const web3 = new Web3(Web3.givenProvider);\n    \n    const contractM = new web3.eth.Contract(\n      data.data.abi,\n      data.contractAddress\n    );\n\n    //calculate gasfee\n\n    // var tx = await contractM.methods.batchMint(address, metaDataList, supply);\n    // const [gasPrice, gasCost] = await Promise.all([\n    //   web3.eth.getGasPrice(),\n    //   tx.estimateGas({ from: address }),\n    // ]);\n    // console.log(gasCost,\"gasCost\")\n    // console.log(gasPrice,\"gasPrice\")\n    ////////////\n    console.log(metaData,\"metaData\")\n     contractM.methods\n      .mint(address,1,supply, \"0x\",metaData)\n      .send({\n        from: address,\n   \n      })\n      .then((response) => {\n        handleEmailRequest(email);\n        let count = localStorage.getItem(address);\n        if (count) {\n          localStorage.setItem(address, +count * 1 + 1);\n        } else {\n          localStorage.setItem(address, 1);\n        }\n        toast.success(\"Minting Successful\");\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        dispatch({\n          type: TOKEN_ID,\n          payload: response,\n        });\n        dispatch({\n          type: MINTING_RESPONSE,\n          payload: response,\n        });\n      })\n      .catch((err) => {\n        // console.log(err, \"error==>\");\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        if (err.message) {\n          toast.error(err.message);\n        } else {\n          toast.error(\"Transaction Failed please check wallet history!\");\n        }\n      });\n  } catch (err) {\n    // console.log(err, \"err\");\n    dispatch({\n      type: LOADER,\n      payload: false,\n    });\n    if(err.message){\n    toast.error(err.message);\n\n    }\n    else {\n\n      toast.error(\"Transaction Failed please check wallet history!\");\n    }\n    // toast.error(err);\n  }\n};\nconst handleEmailRequest = (email) => {\n  let data = {\n    email,\n  };\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/addEmail`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then((res) => {\n    \n    })\n    .catch((err) => console.log(err));\n};\nexport const setContractInfo = () => (dispatch) => {\n  dispatch({\n    type: SET_CONTRACT_INFO,\n  });\n};\n\nexport const connectWallet = () => (dispatch) => {\n  connectMetamaskCopy()\n    .then((address) =>\n   \n      dispatch({\n        type: CONNECT_WELLET,\n        payload: address,\n      })\n    )\n    .catch((err) => console.log(err, \"error\"));\n};\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.js",["1267","1268"],"import { useState, useEffect } from 'react';\r\nimport { connect } from \"react-redux\";\r\nimport { beforeFaq, getFaqs } from \"./faq.action\"\r\n\r\nconst Faq = (props) => {\r\n\r\n    const [data, setData] = useState(null)\r\n\r\n    useEffect(() => {\r\n        props.getFaqs()\r\n     \r\n    }, [])\r\n\r\n    useEffect(() =>{\r\n        if(props.faqs.faqsAuth){\r\n            const {faqs} = props.faqs.faqs\r\n            setData(faqs)\r\n        }\r\n    }, [props.faqs.faqsAuth])\r\n\r\n    return (\r\n        <section className=\"faq-area\">\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>{\"FAQ\"}</span>\r\n                            <h3 className=\"mt-3 mb-0\">{\"Frequently Asked Questions\"}</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12\">\r\n                        {/* FAQ Content */}\r\n                        <div className=\"faq-content\">\r\n                            {/* Netstorm Accordion */}\r\n                            <div className=\"accordion\" id=\"netstorm-accordion\">\r\n                                <div className=\"row justify-content-center\">\r\n                                    <div className=\"col-12 col-md-10\">\r\n                                        {/* Single Accordion Item */}\r\n                                        {data ? data.map((item, idx) => {\r\n                                            return (\r\n                                                <div key={`fd_${idx}`} className=\"single-accordion-item p-3\">\r\n                                                    {/* Card Header */}\r\n                                                    <div className=\"card-header bg-inherit border-0 p-0\">\r\n                                                        <h2 className=\"m-0\">\r\n                                                            <button className={\"btn d-block text-left w-100 collapsed py-4\"} type=\"button\" data-toggle=\"collapse\" data-target={`#helpOption-${idx}`}>\r\n                                                                {item.title}\r\n                                                            </button>\r\n                                                        </h2>\r\n                                                    </div>\r\n                                                    <div id={`helpOption-${idx}`} className={\"collapse\"} data-parent=\"#netstorm-accordion\">\r\n                                                        {/* Card Body */}\r\n                                                        <div className=\"card-body py-3\" dangerouslySetInnerHTML={{__html: item.desc}}>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            );\r\n                                        }) : ''}\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = (state) => ({\r\n    faqs: state.faqs,\r\n    error: state.error,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeFaq, \r\n    getFaqs\r\n})(Faq);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nft-preview/nft-preview.js",["1269"],"import React from 'react';\r\nimport { ENV } from '../../config/config'\r\nimport './nft-preview.css'\r\nconst itemPlaceholderImg = ENV.globalPlaceholderImage\r\n\r\nconst NFTPreview = (props) => {\r\n    return (\r\n       \r\n        <div className=\"card preview-nft-card no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.image ? props.image : itemPlaceholderImg} alt=\"NFT image\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body p-0 m-0\">\r\n                    {/* <h5 className=\"mb-3\">{props.name}</h5> */}\r\n                    {/* <p>{props.sold ? props.sold : 0} of {props.copies ? props.copies : 0} Copies</p> */}\r\n                    <p className=\"text-left nft-name-text mt-4\">{\"name\"}</p>\r\n                    <div className=\"d-flex justify-content-between\">\r\n\r\n                    <p className=\"text-white celo-text\">{props.currentPrice ? props.currentPrice : 0}{ENV.currency}</p>\r\n                    <p className=\"text-white\">{\"10/10\"}</p>\r\n                    </div>\r\n                    <div className=\"input-group\">\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n       \r\n    );\r\n}\r\n\r\nexport default NFTPreview;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/home-auctions.js",["1270","1271","1272","1273","1274","1275","1276","1277","1278","1279","1280","1281","1282","1283","1284","1285","1286","1287"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\nimport moment from \"moment\";\r\nimport Countdown from \"react-countdown\";\r\nimport { Swiper, SwiperSlide } from \"swiper/react\";\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\nimport { useTimer } from \"react-timer-hook\";\r\nimport { getCreators, beforeUser } from \"./../user/user.action\";\r\nimport image from \"../../assets/images/placeholder.png\";\r\nimport DemoImg from \"../../assets/images/cl-cr-mainimg.png\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n// Swiper.use([Navigation, Pagination]);\r\nconst { globalPlaceholderImage, countDownRenderer } = ENV;\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [creators, setCreator] = useState([]);\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n  useEffect(() => {\r\n    // console.log('auth', props.user.topSellersAuth)\r\n    if (props.user.topSellersAuth) {\r\n      setCreator(props.user.sellers);\r\n      setLoader(false);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n\r\n      setAuctions(auctions);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n  const filterCreator = (nft, field) => {\r\n    // console.log('creators', creators)\r\n    // console.log('nft owner', nft)\r\n    const result = creators.find((item) => item._id === nft.nftOwnerId);\r\n    // console.log('reuslt',result\r\n    if (result) {\r\n      if (field === \"userName\") {\r\n        if (result?.username) {\r\n          return result?.username;\r\n        } else {\r\n          return \"no username found\";\r\n        }\r\n      } else if (field == \"profileImage\") {\r\n        if (result.profileImage) {\r\n          return result?.profileImage;\r\n        } else {\r\n          return image;\r\n        }\r\n      }\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  const auctionDemoData = [\r\n    {\r\n      _id: 1,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 2,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 3,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 4,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 5,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 6,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 7,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 8,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n  ];\r\n  const handleCategoryFilter = (desc) => {\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n\r\n\r\n\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products. We want to be a part of your\r\n                    smile, success and future growth.\r\n                  </p>\r\n                </div>\r\n                {/* {auctions && auctions.length > 0 && (\r\n                  <div className=\"intro-btn\">\r\n                    <Link className=\"btn content-btn\" to=\"/auctions\">\r\n                      {initData.btnText}\r\n                    </Link>\r\n                  </div>\r\n                )} */}\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\r\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-center justify-content-sm-end align-content-xxl-start text-end\">\r\n                {categories &&\r\n                  categories.length > 0 &&\r\n                  categories.map((item,index) => {\r\n                    if(index<=3){\r\n                      return (\r\n                        <button\r\n                          className=\"me-1 me-sm-2\"\r\n                          onClick={() => handleCategoryFilter(item.description)}\r\n                        >\r\n                          {item.name}\r\n                        </button>\r\n                      );\r\n                    }\r\n                      \r\n                  })}\r\n                {/* <button className=\"me-1 me-sm-2\">Music</button>\r\n                <button className=\"me-1 me-sm-2\">Game</button>\r\n                <button className=\"me-1 me-sm-5\">Sport</button> */}\r\n                <div className=\"intro-btn\">\r\n                  {auctions && auctions?.length > 4 && (\r\n                    <Link\r\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                      to=\"/authors\"\r\n                    >\r\n                      View All\r\n                      <img\r\n                        src={ViewAllIcon}\r\n                        alt=\"arrow-left\"\r\n                        className=\"ms-2\"\r\n                      />\r\n                    </Link>\r\n                  )}\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          {/* //replace arraySample to auctions */}\r\n          {auctionDemoData && auctionDemoData.length > 0 ? (\r\n            <div className=\"auctions-slides\">\r\n              <div className=\"\">\r\n                {/* <div className=\"swiper-wrapper row\"> */}\r\n                {/* <Swiper\r\n                  id=\"swiper\"\r\n                  modules={[Navigation, Pagination, Autoplay, Virtual]}\r\n                  virtual\r\n                  spaceBetween={50}\r\n                  slidesPerView={3}\r\n                  onSlideChange={() => console.log(\"\")}\r\n                  onSwiper={(swiper) => console.log(swiper)}\r\n                  pagination={{ clickable: true }}\r\n                  scrollbar={{ draggable: true }}\r\n                >\r\n                  {auctionDemoData.map((item, idx) => {\r\n                    return (\r\n                      <>\r\n                        <SwiperSlide>\r\n                          <div\r\n                            key={`auc_${idx}`}\r\n                            className=\"swiper-slide item\"\r\n                            id={`#auc-${idx}`}\r\n                          >\r\n                            <div className=\"card m-3 \">\r\n                              <div className=\"image-over\">\r\n                                <Link\r\n                                  to={`/item-details?item=${window.btoa(\r\n                                    item._id\r\n                                  )}`}\r\n                                >\r\n                                  <img\r\n                                    className=\"card-img-top\"\r\n                                    src={item.image}\r\n                                    alt=\"NFT image\"\r\n                                    width=\"600\"\r\n                                    height=\"600\"\r\n                                    style={{ borderRadius: \"none\" }}\r\n                                  />\r\n                                </Link>\r\n                              </div>\r\n                              <div className=\"card-caption col-12 p-0\">\r\n                                <div className=\"card-body\">\r\n                                  <div className=\"mb-3\">\r\n                                    <Countdown\r\n                                      date={\r\n                                        new Date(item.auctionEndDate) + 10000\r\n                                      }\r\n                                      renderer={countDownRenderer}\r\n                                    />\r\n                                  </div>\r\n                                  <Link\r\n                                    to={`/item-details?item=${window.btoa(\r\n                                      item._id\r\n                                    )}`}\r\n                                  >\r\n                                    <h5 className=\"mb-0\">{item.name}</h5>\r\n                                  </Link>\r\n                                  <Link\r\n                                    className=\"seller d-flex align-items-center my-3\"\r\n                                    to={`/author`}\r\n                                  >\r\n                                    <img\r\n                                      className=\"avatar-sm rounded-circle\"\r\n                                      // src={\"https://gateway.ipfs.io/ipfs/QmR8ye93PSLCQXppDUwtBChXNXavCj1HbFCs2DDac5KRnQ\"}\r\n                                      src={filterCreator(item, \"profileImage\")}\r\n                                      alt=\"User Avatar\"\r\n                                    />\r\n                                    <span className=\"ml-2\">\r\n                                      {filterCreator(item, \"userName\")}\r\n                                    </span>\r\n                                  </Link>\r\n                                  <div className=\"card-bottom d-flex justify-content-between\">\r\n                                    <span>\r\n                                      {item.currentPrice} {ENV.currency}\r\n                                    </span>\r\n                                    <span>\r\n                                      {item.sold} of {item.copies}\r\n                                    </span>\r\n                                  </div>\r\n                                </div>\r\n                              </div>\r\n                            </div>\r\n                          </div>\r\n                        </SwiperSlide>\r\n\r\n                      </>\r\n                    );\r\n                  })}\r\n                </Swiper> */}\r\n                <CardSlider\r\n                  settings={ENV.auctionCollectionsSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions && auctions.length > 0 ? (\r\n                    auctions.map((item) => {\r\n                      return (\r\n                        <AuctionsCards\r\n                          endDate={item.auctionEndDate}\r\n                          image={item.image}\r\n                          ownerName={item.owner.username}\r\n                          name={item.name}\r\n                          id={item._id}\r\n                        />\r\n                      );\r\n                    })\r\n                  ) : (\r\n                    <p className=\"text-white text-center\">\r\n                      No Live Auctions Found\r\n                    </p>\r\n                  )}\r\n                </CardSlider>\r\n              </div>\r\n            </div>\r\n          ) : (\r\n            <p className=\"text-center ml-3\">No Live Auctions Found</p>\r\n          )}\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/author-profile/author-profile.js",["1288","1289","1290","1291","1292"],"import React, { useEffect } from 'react';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst AuthorProfile = (props) => {    \r\n    useEffect(()=> {\r\n\r\n    },[])\r\n    return (\r\n        <div className=\"card-wrapper\">\r\n       <div className=\"card no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.profileImage ? props.profileImage: ENV.globalPlaceholderImage} alt=\"User Profile\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body mt-4\">\r\n                    <h5 className=\"mb-3\">{props.username}</h5>\r\n                    <p className=\"my-3\">{props.description}</p>\r\n                    <div className=\"input-group\">\r\n                        <input type=\"text\" className=\"form-control\" placeholder=\"0x000000000000000000\" readOnly value={props.address}/>\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"social-icons d-flex justify-content-center my-3\">\r\n                        {\r\n                            props.facebookLink && <a className=\"facebook\" href={props.facebookLink} target=\"_blank\">\r\n                                <i className=\"fab fa-facebook-f\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.twitterLink && <a className=\"twitter\" href={props.twitterLink} target=\"_blank\">\r\n                                <i className=\"fab fa-twitter\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.gPlusLink && <a className=\"google-plus\" href={props.gPlusLink} target=\"_blank\">\r\n                                <i className=\"fab fa-google-plus-g\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.vineLink && <a className=\"vine\" href={props.vineLink} target=\"_blank\">\r\n                                <i className=\"fab fa-vine\" />\r\n                            </a>\r\n                        }\r\n                    </div>\r\n                    {\r\n                        props.followText &&\r\n                        <a className=\"btn btn-bordered-white btn-smaller\" href=\"#\">{props.followText}</a>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </div>\r\n        </div>\r\n \r\n    );\r\n}\r\nexport default AuthorProfile;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/filter-search2/filtersearch2.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/top-seller/topseller2.js",["1293","1294","1295","1296"],"import React, { useEffect, useState } from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\r\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\r\nimport \"./topseller.css\";\r\n\r\nconst exmpData = [\r\n  {\r\n    id: 1,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 2,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 3,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 4,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 5,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 6,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 7,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 8,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 9,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 10,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 11,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 12,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n];\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n  useEffect(() => {\r\n    setSellers(props.user.sellers);\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content\">\r\n                <span>CREATIVE ARTIST</span>\r\n                <h3 className=\"mb-0\">Top Sellers</h3>\r\n              </div>\r\n              {props.viewAll ? (\r\n                <div className=\"intro-btn\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/top-sellers-list\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              ) : (\r\n                \"\"\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row items\">\r\n          {sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              return (\r\n                <div\r\n                  key={`ts_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                >\r\n                  {/* Single Seller */}\r\n                  <div className=\"card\">\r\n                    <div className=\"single-seller d-flex align-items-center\">\r\n                      <Link to={`/author/${author._id}`}>\r\n                        <div className=\"seller-avatar-container\">\r\n                          <img\r\n                            className=\"avatar-md rounded-circle\"\r\n                            //   src={\r\n                            //     author.profileImage\r\n                            //       ? author.profileImage\r\n                            //       : ENV.globalPlaceholderImage\r\n                            //   }\r\n                            src={AvatarImg}\r\n                            alt=\"\"\r\n                          />\r\n                          <span className=\"seller-avatar-active\">\r\n                            <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                          </span>\r\n                        </div>\r\n                      </Link>\r\n                      {/* Seller Info */}\r\n                      <div className=\"seller-info ml-3 w-100\">\r\n                        <Link\r\n                          className=\"seller mb-2\"\r\n                          to={`/author/${author._id}`}\r\n                        >\r\n                          {author.username}\r\n                        </Link>\r\n                        <span className=\"text-end\">{\"256.6ETH\"}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          ) : (\r\n            <p>Top Sellers not available</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/authors/authors.js",["1297","1298"],"import React, { useEffect, useState } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport {Link} from 'react-router-dom';\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst Authors = (props) => {\r\n    const [creators, setCreators] = useState([]);\r\n    useEffect(()=> {\r\n        props.getCreators();\r\n        window.scrollTo(0, 0)\r\n    }, []);\r\n    useEffect(()=> {\r\n        setCreators(props.user.sellers)\r\n      \r\n    }, [props.user.topSellersAuth]);\r\n\r\n    return (\r\n        <section className=\"popular-collections-area mt-5\">\r\n            <br />\r\n            <br />\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>Creators</span>\r\n                            <h3 className=\"mt-3 mb-0\">Our Creators</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    {\r\n                        creators && creators.length ? \r\n                        creators.map((author, key)=> {\r\n                            return (\r\n                                <div key={`author_${key}`} className=\"col-12 col-sm-6 col-lg-3 item\">\r\n                                    <div className=\"card no-hover text-center\">\r\n                                        <div className=\"image-over\">\r\n                                            <Link to={`/author/${author._id}`}>\r\n                                                <img className=\"card-img-top\" src={author.profileImage ? author.profileImage: ENV.globalPlaceholderImage} alt=\"Author profile\" />\r\n                                            </Link>\r\n                                        </div>\r\n                                        <div className=\"card-caption col-12 p-0\">\r\n                                            <div className=\"card-body mt-1\">\r\n                                                <Link to={`/author/${author._id}`}>\r\n                                                    <h5>{author.username ? author.username : author.address} </h5>\r\n                                                </Link>\r\n                                                <button type=\"button\" className=\"btn btn-bordered-white btn-smaller\">Follow</button>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                  \r\n                                </div>\r\n                            )\r\n                        })\r\n                        : \r\n                        <p>No Creators Found</p>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n   \r\n    {\r\n    user: state.user\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getCreators })(Authors);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/help/help.js",["1299"],"import React, { Component } from 'react';\r\n\r\nconst initData = {\r\n    pre_heading: \"Help Center\",\r\n    heading: \"How can we help you?\",\r\n    content: \"\"\r\n}\r\n\r\nconst data = [\r\n    {\r\n        id: \"1\",\r\n        icon: \"icon icon-plane text-effect\",\r\n        title: \"Getting Started\",\r\n        content: \"Learn how to create an account, set up your wallet, and what you can do on NetStorm\"\r\n    },\r\n    {\r\n        id: \"2\",\r\n        icon: \"icon icon-note text-effect\",\r\n        title: \"Creating\",\r\n        content: \"Learn how to create your very first NFT and how to create your NFT collections so you can begin selling and sharing\"\r\n    },\r\n    {\r\n        id: \"3\",\r\n        icon: \"icon icon-handbag text-effect\",\r\n        title: \"Buying\",\r\n        content: \"Learn how to purchase your first NFT and understand gas fees and what's gas free on NetStorm\"\r\n    },\r\n    {\r\n        id: \"4\",\r\n        icon: \"icon icon-chart text-effect\",\r\n        title: \"Selling\",\r\n        content: \"Learn how list your NFTs for sale and understand the different ways to list your NFTs\"\r\n    },\r\n    {\r\n        id: \"5\",\r\n        icon: \"icon icon-link text-effect\",\r\n        title: \"Partners\",\r\n        content: \"Learn how you can partner with us to showcase your NFT drops\"\r\n    },\r\n    {\r\n        id: \"6\",\r\n        icon: \"icon icon-flag text-effect\",\r\n        title: \"Developers\",\r\n        content: \"Learn how you can develop with NetStorm &amp; sell them on Marketplace\"\r\n    }\r\n]\r\n\r\nclass HelpCenter extends Component {\r\n    state = {\r\n        initData: {},\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        this.setState({\r\n            initData: initData,\r\n            data: data\r\n        })\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"help-center-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row justify-content-center\">\r\n                        <div className=\"col-12 col-md-8 col-lg-7\">\r\n                            {/* Intro */}\r\n                            <div className=\"intro text-center\">\r\n                                <span>{this.state.initData.pre_heading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                                <p>{this.state.initData.content}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"row justify-content-center items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`hd_${idx}`} className=\"col-12 col-md-6 col-lg-4 item\">\r\n                                    {/* Help Card */}\r\n                                    <div className=\"card help-card\">\r\n                                        <a className=\"d-block text-center\" href=\"#\">\r\n                                            <i className={item.icon} />\r\n                                            <h4>{item.title}</h4>\r\n                                            <p>{item.content}</p>\r\n                                        </a>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default HelpCenter;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/sidebar/sidebar.js",["1300","1301","1302"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/sidebar\";\r\n\r\nclass Sidebar extends Component {\r\n    state = {\r\n        data: {},\r\n        widgetData_1: [],\r\n        widgetData_2: [],\r\n        widgetData_3: []\r\n    }\r\n    componentDidMount() {\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data,\r\n                    widgetData_1: res.data.widgetData_1,\r\n                    widgetData_2: res.data.widgetData_2,\r\n                    widgetData_3: res.data.widgetData_3\r\n                })\r\n            })\r\n            .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <aside className=\"col-12 col-lg-4 pl-lg-5 p-0 float-right sidebar\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12 align-self-center text-left\">\r\n                        {/* Widget [categories] */}\r\n                        <div className=\"item widget-categories\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_1}</h4>\r\n                            <ul className=\"list-group list-group-flush\">\r\n                                {this.state.widgetData_1.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdo_${idx}`} className=\"list-group-item d-flex justify-content-between align-items-center\">\r\n                                            <a href=\"#\">{item.title}</a>\r\n                                            <span className=\"badge circle\">{item.content}</span>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                        {/* Widget [tags] */}\r\n                        <div className=\"item widget-tags\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_2}</h4>\r\n                            {this.state.widgetData_2.map((item, idx) => {\r\n                                return (\r\n                                    <a key={`wdt_${idx}`} href=\"\" className=\"badge tag\">{item.title}</a>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                        {/* Widget [share-this] */}\r\n                        <div className=\"item widget-share-this\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_3}</h4>\r\n                            <ul className=\"navbar-nav social share-list\">\r\n                                {this.state.widgetData_3.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdth_${idx}`} className=\"nav-item\">\r\n                                            <a href=\"#\" className=\"nav-link\"><i className={item.icon} /></a>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </aside>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Sidebar;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collection-preview.js",["1303","1304"],"import React from 'react';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV\n\nconst CollectionPreview = ({ collection }) => {\n    return (\n        <>\n            <div className=\"card no-hover text-center \">\n                <div className=\"image-over\">\n                    <div>\n                        <img className=\"card-img-top\" src={collection.featuredImg ? collection.featuredImg : collectionFeaturedImg} alt=\"Collection Featured Image\" />\n                    </div>\n                    <div className=\"seller\">\n                        <div className=\"seller-thumb avatar-lg\">\n                            <img className=\"rounded-circle\" src={collection.logo} alt='Collection Logo' />\n                        </div>\n                    </div>\n                </div>\n                <div className=\"card-caption col-12 p-0\">\n                    <div className=\"card-body mt-4\">\n                        <div>\n                            <h5 className=\"mb-2\">{collection.name}</h5>\n                            <p className=\"mb-2\">\n                                {\n                                    collection.url ?\n                                        <div className=\"input-group\">\n                                            <input type=\"text\" className=\"form-control\" placeholder=\"Collection URL\" readOnly value={collection.url} />\n                                            <div className=\"input-group-append\" style={{ zIndex: 888 }}>\n                                                <button className=\"btn mr-0\"><i className=\"icon-docs\" /></button>\n                                            </div>\n                                        </div>\n                                        : ('URL: N/A')\n                                }\n                            </p>\n                            <p className=\"mb-2\">{collection.description ? collection.description : 'Description: N/A'}</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div className=\"row items\">\n                <div className=\"col-12 px-0 mt-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <img className=\"avatar-md rounded-circle\" src={collection.category?.image || categoryDefaultImg} alt=\"Category Image\" />\n                            <div className=\"seller-info ml-3\">\n                                <div className=\"seller\">{collection.category?.name || 'N/A'}</div>\n                                <span>Category</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"col-12 px-0 my-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <Link to=\"/author\">\n                                <img className=\"avatar-md rounded-circle\" src={collection.user?.profilePhoto || userDefaultImg} alt=\"User Avatar\" />\n                            </Link>\n                            <div className=\"seller-info ml-3\">\n                                <Link className=\"seller mb-2\" to=\"/author\">{collection.user?.username}</Link>\n                                <span>Creator</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default CollectionPreview;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/item-details/item-details.js",["1305","1306","1307","1308","1309","1310","1311","1312","1313","1314","1315","1316","1317","1318","1319","1320","1321","1322"],"import React, { Component } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport { Link } from 'react-router-dom';\r\nimport { beforeNFT, getNFT } from '../nfts/nfts.action';\r\nimport FullPageLoader from '../full-page-loader/full-page-loader'\r\nimport { ENV } from '../../config/config';\r\nimport moment from 'moment';\r\nimport Countdown from 'react-countdown';\r\nimport SimpleReactValidator from 'simple-react-validator'\r\nimport { decimalNumberValidator } from \"../../utils/functions\";\r\nimport { Container, Row, Col, Button, Modal } from \"react-bootstrap\";\r\nimport { beforeOffer, makeOffer, getOffers, deleteOffer, acceptOffer } from '../offers/offers.action'\r\nimport { beforeBid, placeBid, getBids, deleteBid, acceptBid } from '../bids/bids.action'\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {getCurrentAddress,BuyFixedPriceNFTs,placeBidNft,acceptNftOffer} from '../../utils/web3';\r\nimport { toast } from 'react-toastify'\r\nconst { globalPlaceholderImage, countDownRenderer, currencies, objectToQueryString } = ENV\r\n\r\nconst initData = {\r\n    itemImg: \"/img/auction_2.jpg\",\r\n    date: \"2022-03-30\",\r\n    price_2: \"$500.89\",\r\n    bidBtn: \"Place a Bid\",\r\n    offerBtn: \"Buy Now\",\r\n    sellBtn: \"Sell\"\r\n}\r\n\r\n// expiry options\r\n\r\nconst expiryOptions = [\r\n    { label: '5 Days', value: moment().add(5, \"days\").format('DD/MM/YYYY') },\r\n    { label: '7 Days', value: moment().add(7, \"days\").format('DD/MM/YYYY') },\r\n    { label: 'A Month', value: moment().add(1, \"months\").format('DD/MM/YYYY') },\r\n    { label: 'Custom Date', value: -1 },\r\n]\r\n\r\n// make an offer / bid config.\r\n\r\nconst config1 = {\r\n    price: {\r\n        currency: ENV.currency,\r\n        amount: \"\",\r\n    },\r\n    expiry: {\r\n        date: expiryOptions[0].value,\r\n        time: moment(new Date()).format(\"HH:mm\"),\r\n        type: 1, // 1 for time & 2 for datetime-local\r\n        datetime: '' // for payload \r\n    }\r\n};\r\nlet nft1=[]\r\nclass ItemDetails extends Component {\r\n    isTimeoutAction = false;\r\n    constructor(props) {\r\n        super(props)\r\n        this.state = {\r\n            userId: ENV.getUserKeys()?._id,\r\n            offers: null,\r\n            offersPagination: null,\r\n\r\n            bids: null,\r\n            bidsPagination: null,\r\n            highestBidAmtt:null,\r\n            errors: '',\r\n            isSubmitted: false,\r\n            formValid: true,\r\n            loader: true,\r\n            nft: null,\r\n            nftAll:null,\r\n            isOpen: false,\r\n            creator:[],\r\n            nftConfig: config1 ,// make an offer / bid config.\r\n            nftsData:[],\r\n            bidsData:[],\r\n            creators:[],\r\n            myAddress:''\r\n        }\r\n        this.validator = new SimpleReactValidator({\r\n            autoForceUpdate: this,\r\n            messages: {\r\n                required: 'This field is required.'  // will override all messages\r\n            },\r\n        });\r\n\r\n    }\r\n\r\n    componentDidMount= async()=> {\r\n        window.scroll(0, 0)\r\n        let myAddress=await getCurrentAddress()\r\n     \r\n        this.setState({\r\n            myAddress\r\n        })\r\n        const query = new URLSearchParams(window.location.search)\r\n        this.getTokens()\r\n       \r\n        if (query.get('item')) {\r\n        \r\n            const nftId = window.atob(query.get('item'))\r\n            // console.log(nftId,\"nftId====>\");\r\n            if (nftId) {\r\n                this.props.getNFT(nftId);\r\n                this.getBids(nftId)\r\n\r\n                const bidQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getBids(bidQS);\r\n\r\n                const offerQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getOffers(offerQS);\r\n                this.props.getCreators();\r\n            }\r\n        } else\r\n            this.props.history.push('/explore-all')\r\n    }\r\n\r\n    filterCreator=(nft)=>{\r\n     \r\n        // let nftId=this.state.nft.collection.userId\r\n    }\r\n    filterCreatorsInfo=(id,item)=>{\r\n      \r\n      let user= this.props.user?.creators?.find((item)=>item._id===id )\r\n      if(user){\r\n          if(item==\"username\"){\r\n             return user.username\r\n          }\r\n          if(item==\"profilePhoto\"){\r\n              return user?.profileImage\r\n          }\r\n          if(item==\"id\"){\r\n            return user._id\r\n          }\r\n      }\r\n    }\r\n\r\n    componentDidUpdate() {\r\n        // if (this.props.error)\r\n        //     this.setState({ loader: false })\r\n\r\n        if (this.props.nft.nftsAuth) {\r\n           \r\n            const nft = this.props.nft.nftsData\r\n            const allData=this.props.nft.nftAll\r\n           \r\n            //nft\r\n            nft1=nft\r\n            this.getBids(nft?._id)\r\n            this.setState({\r\n                \r\n                nft,\r\n            nftAll:allData\r\n                \r\n            }, () => {\r\n                this.props.beforeNFT()\r\n            })\r\n            this.filterCreator(nft)\r\n            const date1 = moment();\r\n            const date2 = moment(this.props?.nft?.nftAll?.sellingConfig?.duration?.endDate);\r\n           \r\n            // this.isTimeoutAction =  date2.diff(date1) > 0 ? false : true;\r\n            let result =  date2.diff(date1) > 0 ? false : true;\r\n            this.setState({\r\n                isTimeoutAction:result\r\n            })\r\n            // console.log(result,\"checking result\")\r\n        }\r\n\r\n        if (this.props.offer.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeOffer()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getOffers(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.getAuth) {\r\n            const { offers, pagination } = this.props.offer\r\n            this.setState({ loader: false, offers, offersPagination: pagination }, () => {\r\n                this.props.beforeOffer()\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.deleteAuth) {\r\n            this.props.beforeOffer()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getOffers(qs)\r\n        }\r\n\r\n        if (this.props.bid.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeBid()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getBids(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.getAuth) {\r\n         \r\n            const { bids, pagination, highestBidAmt } = this.props.bid\r\n        \r\n            let nft = { ...this.state.nft }\r\n\r\n            nft.highestBidAmt = highestBidAmt\r\n           \r\n            this.setState({ loader: false, bids, bidsPagination: pagination, nft }, () => {\r\n                this.props.beforeBid()\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.deleteAuth) {\r\n            this.props.beforeBid()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getBids(qs)\r\n        }\r\n\r\n        if (this.props.offer.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeOffer()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeBid()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n        //    console.log(this.props.user.topSellersAuth,\"kjkjkjlkjlkjkljlkjk\");\r\n\r\n        if(this.props.user.topSellersAuth && !this.state.creator?.length>0 ){\r\n            this.filterCreator(this.props.user.sellers)\r\n            this.setState({\r\n                creator:this.props.user.sellers,\r\n                creators:this.props.user.creators\r\n            })\r\n            // console.log(this.props.user.sellers,\"creators===}}}}}}}}}}}}}}}}}}}}}\");\r\n            // console.log(this.state.nft,\"nft below the creator===>\")\r\n        }\r\n        \r\n\r\n    }\r\n   \r\n    getBids=(nftId)=>{\r\n        const BASE_URL= process.env.REACT_APP_BASE_URL \r\n        fetch(BASE_URL + \"/bid/list\", {\r\n            method: 'GET',\r\n            headers: {\r\n                'content-type': 'application/json',\r\n                'Authorization': ENV.Authorization,\r\n                'x-auth-token': ENV.x_auth_token,\r\n                'Access-Control-Allow-Origin': '*',\r\n                'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n            }\r\n        }).then(res => res.json()).then(data => {\r\n       \r\n            let bids=data.data.allBids?.filter((item)=>item.nftId===nftId)          \r\n           \r\n            // const highestBidAmt = bids.length\r\n            var last_element = bids[bids?.length - 1];\r\n       \r\n            this.setState({\r\n                bidsData:bids,\r\n                highestBidAmtt: last_element?.price.amount\r\n\r\n            })\r\n            setTimeout(()=>{\r\n               this.setState({\r\n                   loader:false,\r\n               })\r\n            },2000)\r\n         \r\n        }).catch(error => {\r\n        console.log(error,\"error while getting bids\")\r\n           \r\n        })\r\n    }\r\n    openModal = () => {\r\n  \r\n        if(this.props?.nft?.nftAll.sellingMethod==1)\r\n        {\r\n            // console.log(\"inside if\")\r\n            var res= this.state.nftsData.data.find((item)=>item.nftId===this.state.nft._id)\r\n            // console.log(res,\"response\")               \r\n             // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n             this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n               this.setState({\r\n                   loader:false\r\n               })\r\n\r\n            }, 8000);\r\n          \r\n             BuyFixedPriceNFTs(this.props?.nft?.nftAll.currentPrice,res.nftToken,this.props.nft.nftAll._id)\r\n            \r\n        }\r\n        else {\r\n            // console.log(\"inside else\")\r\n            this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n        }\r\n      \r\n        // this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n    }\r\n\r\n    closeModal = () => this.setState({ isOpen: false });\r\n\r\n    onChange = (e) => {\r\n        const { nftConfig } = this.state;\r\n        const { name, value } = e.target;\r\n        let data = nftConfig;\r\n\r\n        const keys = name.split(\".\"); // nftConfig, price, currency\r\n        if (keys && keys[2])\r\n            data[keys[1]][keys[2]] = value;\r\n        else if (keys && keys[1])\r\n            data[keys[1]] = value;\r\n\r\n        if (keys && keys[1] === 'price' && keys[2] === 'amount')\r\n            data[keys[1]]['amount'] = Number(value)\r\n\r\n        if (keys && keys[1] === 'expiry' && keys[2] === 'date')\r\n            data[keys[1]]['type'] = Number(value) === -1 ? 2 : 1\r\n\r\n        // set datetime for days / months \r\n        if (data.expiry.type === 1)\r\n            data.expiry.datetime = moment(data.expiry.date + ' ' + data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n        // set datetime for custom date\r\n        else if (data.expiry.type === 2) {\r\n            data.expiry.datetime = moment(data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n            data.expiry.date = moment(data.expiry.time, 'DD/MM/YYYY')\r\n        }\r\n\r\n        this.setState({\r\n            nftConfig: {\r\n                ...data\r\n            }\r\n        })\r\n    };\r\n\r\n    // submit when a bid is placed or when an offer is made\r\n    submit = () => {\r\n    //   console.log(this.state.myAddress,\"myaddress\")\r\n\r\n        this.setState({ isSubmitted: true, formValid: this.validator.allValid() }, () => {\r\n            const { formValid } = this.state\r\n            if (formValid) {\r\n                this.setState({\r\n                    loader: false               //need to convert true\r\n                }, () => {\r\n                    const { nft, nftConfig,nftAll } = this.state\r\n           \r\n                    // console.log(nftAll,\"checking nft==>\")\r\n                    const payload = {\r\n                        // ownerId: nft.owner._id,\r\n                        expiryDate: nftConfig.expiry.datetime,\r\n                        price: nftConfig.price,\r\n                        nftId: nft._id,\r\n                        bidBy:ENV.getUserKeys('_id'),\r\n                        user:ENV.getUserKeys('_id'),\r\n                        offerById:ENV.getUserKeys('_id'),\r\n                        toAddress:nftAll.ownerAddress,\r\n                        fromAddress:this.state.myAddress,\r\n\r\n                    }\r\n                    // console.log(payload,\"toaddress8888888\")\r\n           \r\n                    let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                    // console.log('check here selling method',nft.sellingMethod )\r\n                    // if selling method is 2 then go for bid\r\n                    if (nft.sellingMethod === 2) { // place a bid \r\n                        placeBidNft(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        // this.props.placeBid(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        this.setState({\r\n                            loader:true\r\n                        })\r\n\r\n                        setTimeout(() => {\r\n                            this.setState({\r\n                                loader:false\r\n                            })\r\n                          \r\n                        }, 5000);\r\n                    } else if (nft.sellingMethod === 1) { // make an offer \r\n                       let res= this.state.nftsData.find((item)=>item.nftId===nft._id)\r\n                    //    console.log(res,\"response\")\r\n                             \r\n                        // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                        // BuyFixedPriceNFTs(payload.price,res.nftToken)\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                        // this.props.makeOffer(payload,foundResult,payload.price)\r\n                    }\r\n                    else{\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        // console.log('single nft before fix price function', nft)\r\n                        let res= this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                        // console.log(res,\"response\")\r\n                              \r\n                         // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                         BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                    }\r\n                })\r\n\r\n            }\r\n\r\n            else {\r\n                alert(\"in else\")\r\n                this.validator.showMessages()\r\n                this.validator.purgeFields()\r\n                this.setState({\r\n                    errors: 'Please fill all required fields in valid format.',\r\n                    formValid: false\r\n                }, () => {\r\n                    window.scroll(0, 0)\r\n                })\r\n            }\r\n            \r\n        })\r\n    }\r\n\r\n    deleteOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteOffer(offerId)\r\n        })\r\n    }\r\n\r\n    deleteBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteBid(bidId)\r\n        })\r\n    }\r\n\r\n    acceptOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.acceptBid({ offerId })\r\n        })\r\n\r\n    }\r\n\r\n    acceptBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            const { nft, nftConfig,nftAll } = this.state\r\n        \r\n            let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n  \r\n            const payload = {\r\n                bidId:bidId,\r\n                nftId: nft._id,\r\n                bidBy:ENV.getUserKeys('_id'),\r\n                user:ENV.getUserKeys('_id'),\r\n                toAddress:nftAll.ownerAddress,\r\n                fromAddress:this.state.myAddress,\r\n            }\r\n            this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n                this.setState({\r\n                    loader:false\r\n                })\r\n              \r\n            }, 7000);\r\n            acceptNftOffer(foundResult.nftToken,payload)\r\n            // this.props.acceptBid(payload,foundResult.nftToken)\r\n             \r\n        })\r\n       \r\n    }\r\n    creatorUserName=()=>{\r\n        // console.log(this.state.creator,\"creator listing\");/\r\n        // console.log(this.props.nftAll,\"this.props.nftAll?\");\r\n\r\n       let result= this.state.creator.find((item)=>item._id===this.state?.nftAll?.userId)\r\n    //    console.log(result,\"result in the userName function===>\");\r\n       if(result?.username)\r\n       {\r\n\r\n           return result.username\r\n       }\r\n       else {\r\n           return \"no username\"\r\n       }\r\n    }\r\n     getTokens=()=>{\r\n\r\n        let url = process.env.REACT_APP_BASE_URL + `nftTokens/tokens`;\r\n      \r\n        fetch(url, {\r\n         method: 'GET',\r\n         headers: {\r\n            'content-type': 'application/json',\r\n            'Authorization': ENV.Authorization,\r\n            'x-auth-token': ENV.x_auth_token,\r\n            'Access-Control-Allow-Origin': '*',\r\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n        },\r\n      \r\n      }).then(res => res.json()).then(data => {\r\n \r\n        //   console.log(data,\"data==>22222222222222222222222222222222222222\")\r\n      \r\n     this.setState({\r\n        nftsData:data\r\n     })\r\n      \r\n      }).catch(error => {\r\n        \r\n        console.log(error,\"error in catch blcok\")\r\n        \r\n      })\r\n    }\r\n    // filterCreatorsInfo=(id,item)=>{\r\n    //     // console.log(this.state.creators,\"creator in the filterCreatorsFunction\")\r\n    //   let user= this.state?.creators?.data?.find((item)=>item._id===id )\r\n    //   if(user){\r\n\r\n    //       if(item==\"username\"){\r\n    //          return user.username\r\n    //       }\r\n    //       if(item==\"profilePhoto\"){\r\n    //           return user?.profileImage\r\n    //       }\r\n    //       if(item==\"id\"){\r\n    //         return user._id\r\n    //       }\r\n    //   }\r\n      \r\n    // }\r\n\r\n    render() {\r\n        const { loader, nft, nftConfig, isSubmitted, errors, userId, bids, offers } = this.state\r\n        if(!ENV.getUserKeys('_id')._id){\r\n            toast.error(\"Pleas login to continue\")\r\n            this.props.history.push('/')\r\n               return \" \"\r\n           }\r\n           else {\r\n        return (\r\n            <>\r\n                <section className=\"item-details-area padding-wrapper pb-0\">\r\n                    {\r\n                        loader ?\r\n                            <FullPageLoader /> :\r\n                            <>\r\n                                {\r\n                                    nft && \r\n                                    <div className=\"container\">\r\n                                        <div className=\"row justify-content-between\">\r\n                                            <div className=\"col-12 col-lg-5\">\r\n                                                <div className=\"item-info\">\r\n                                                    <div className=\"item-thumb text-center\">\r\n                                                        <img src={nft.image} alt=\"NFT Image\" />\r\n                                                    </div>\r\n                                                    {\r\n                                                        nft.auctionEndDate &&\r\n                                                        <div className=\"card no-hover countdown-times mt-4\">\r\n                                                            <Countdown\r\n                                                                date={new Date(nft.auctionEndDate) + 10000}\r\n                                                                renderer={countDownRenderer}\r\n                                                            />\r\n                                                        </div>\r\n                                                    }\r\n                                                    {/* Tabs */}\r\n                                                    <ul className=\"netstorm-tab nav nav-tabs mt-4\" id=\"nav-tab\">\r\n                                                        <li>\r\n                                                            <a className=\"active\" id=\"bids-tab\" data-toggle=\"pill\" href=\"#bids\">\r\n                                                                <h5 className=\"m-0\">Bids</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                        {/* <li>\r\n                                                            <a id=\"offers-tab\" data-toggle=\"pill\" href=\"#offers\">\r\n                                                                <h5 className=\"m-0\">Offers</h5>\r\n                                                            </a>\r\n                                                        </li> */}\r\n                                                        <li>\r\n                                                            <a id=\"details-tab\" data-toggle=\"pill\" href=\"#details\">\r\n                                                                <h5 className=\"m-0\">Details</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                    </ul>\r\n                                                    \r\n                                                    {/* Tab Content */}\r\n                                                    <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                                                        <div className=\"tab-pane fade show active\" id=\"bids\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {this.state.bidsData &&  this.props.user?.creators?.length > 0  ? \r\n                                                                \r\n                                                                    this.state.bidsData.map((item, idx) => {\r\n                                                                \r\n                                                                        return (\r\n                                                                            <li key={`bid_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                             \r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Bid listed for <strong>{item.price.amount} {item.price.currency} </strong>\r\n                                                                                     <span>{moment(item.createdAt).fromNow()} </span>\r\n                                                                                     <br />by <Link to={`/author/${item.bidById}`}>@{ this.filterCreatorsInfo(item.bidBy,'username')}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                     nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                      nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                     \r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No bids found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div>\r\n\r\n                                                        {/* <div className=\"tab-pane fade\" id=\"offers\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {offers && offers.length > 0 ?\r\n                                                                    offers.filter((item)=>item.nftId===nft._id).map((item, idx) => {\r\n                                                                        return (\r\n                                                                            <li key={`offer_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.offerBy?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Offer listed for <strong>{item.price.amount} {item.price.currency}</strong> {moment(item.createdAt).fromNow()} <br />by <Link to={`/author/${item.nftId}`}>@{this.filterCreatorsInfo(item.offerById,\"username\")}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No offers found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div> */}\r\n                                                        \r\n                                                        <div className=\"tab-pane fade\" id=\"details\">\r\n                                                            <div className=\"owner-meta d-flex align-items-center mt-3\">\r\n                                                                <span>Owner</span>\r\n                                                                <Link className=\"owner d-flex align-items-center ml-2\" to={`/author/${nft.owner?._id}`}>\r\n                                                                    <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto ? nft.owner.profilePhoto : globalPlaceholderImage} alt=\"Owner Image\" />\r\n                                                                    <h6 className=\"ml-2\">{nft.owner?.username}</h6>\r\n                                                                </Link>\r\n                                                            </div>\r\n                                                            <p className=\"mt-2\">Created : {moment(nft.createdAt).format('DD MMM YYYY')\r\n                                                            }</p>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 col-lg-6\">\r\n                                                <div className=\"content mt-5 mt-lg-0\">\r\n                                                    <h3 className=\"m-0\">{nft.name}</h3>\r\n                                                    <p>{nft.description}</p>\r\n\r\n                                                    {/* Owner */}\r\n                                                    <div className=\"owner d-flex align-items-center\">\r\n                                                        <span>Owned By</span>\r\n                                                        <Link className=\"owner-meta d-flex align-items-center ml-3\" to={`/author/${nft.owner?._id}`}>\r\n                                                            <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto || globalPlaceholderImage} alt=\"Owner Avatar\" />\r\n                                                            <h6 className=\"ml-2\">\r\n                                                                {/* {nft.owner?.username}\r\n                                                                 */}\r\n                                                                 {this.creatorUserName()}\r\n                                                                </h6>\r\n                                                        </Link>\r\n                                                    </div>\r\n                                                    {/* Item Info List */}\r\n                                                    <div className=\"item-info-list mt-4\">\r\n                                                        <ul className=\"list-unstyled\">\r\n                                                            <li className=\"price d-flex justify-content-between\">\r\n                                                                <span>Current Price {nft.currentPrice || 0} {ENV.currency}</span>\r\n                                                                {/* <span>{initData.price_2}</span> */}\r\n                                                                <span>{nft.sold} of {nft.copies}</span>\r\n                                                            </li>\r\n                                                            <li>\r\n                                                                <span>Size </span>\r\n                                                                <span>{nft.size}</span>\r\n                                                            </li>\r\n                                                        </ul>\r\n                                                    </div>\r\n                                                    <div className=\"row items\">\r\n                                                        {/* Creator */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <a href=\"/author\">\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.creator?.profilePhoto || globalPlaceholderImage} alt=\"Creator Avatar\" />\r\n                                                                    </a>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`/author/${nft.creator?._id}`}>{\r\n                                                                          this.creatorUserName()\r\n                                                                        // nft.creator?.username\r\n                                                                        }</Link>\r\n                                                                        <span>Creator</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        {/* Collection */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <Link to={`collection-details/${window.btoa(nft.collection?._id)}`}>\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.collection?.image} alt=\"Collection Image\" />\r\n                                                                    </Link>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`collection-details/${window.btoa(nft.collection?._id)}`}>{nft.collection?.name}</Link>\r\n                                                                        <span>Collection</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        <div className=\"col-12 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <h4 className=\"mt-0 mb-2\">Highest Bid</h4>\r\n                                                                <div className=\"price d-flex justify-content-betxween align-items-center\">\r\n                                                                    <span>{this.state.highestBidAmtt ? this.state.highestBidAmtt + ` ${ENV.currency}` : 'N/A'}</span>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                    {\r\n\r\n                                                        nft.nftOwnerId=== userId ?\r\n                                                        <Link className=\"d-block btn btn-bordered-white mt-4 mb-4 w-100\" to={`/sell-item/${window.btoa(nft._id)}`}>{initData.sellBtn}</Link>\r\n                                                        :\r\n                                                        // <button className=\"d-block btn btn-bordered-white mt-4 w-100\" onClick={this.openModal(nft)}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn}</button>\r\n                                                        <>\r\n                                                             {/* this.isTimeoutAction ? 'Auction Timeout' : */}\r\n                                                             {/*  */}\r\n                                                            { \r\n                                                           this.props?.nft?.nftAll.sellingMethod &&\r\n                                                            <button  className=\"d-block btn btn-bordered-white mt-4 w-100\" disabled={this.isTimeoutAction || nft.copies===nft.sold}  onClick={()=>this.openModal()}>{this.isTimeoutAction?\"Auction Timeout\":( nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn)}</button>}\r\n                                                             \r\n                                                            </>\r\n                                                    }\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                }\r\n                            </>\r\n\r\n                    }\r\n                </section>\r\n                <div className=\"modal-wrapper\">\r\n                    {\r\n                        nft &&\r\n                        <Modal\r\n                            centered\r\n                            size=\"lg\"\r\n                            className=\"\"\r\n                            show={this.state.isOpen}\r\n                            onHide={this.closeModal}\r\n                        >\r\n                            <Modal.Header className=\"text-center modal-title-wrapper\">\r\n                                <Modal.Title>\r\n                                    { nft.sellingMethod === 2 ? 'Place A Bid' : 'Make An Offer'}\r\n                                </Modal.Title>\r\n                            </Modal.Header>\r\n                            {\r\n                                isSubmitted && errors &&\r\n                                <Modal.Body className=\"row pt-2 pb-0\">\r\n                                    <div className=\"col-12\">\r\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\r\n                                    </div>\r\n                                </Modal.Body>\r\n                            }\r\n                            <Modal.Body>\r\n                                <div className=\"price-wrapper d-flex\">\r\n                                    <div className=\"price-text position-relative\">\r\n                                        <div className=\"text-white mb-2 absolute-wrapper\">\r\n                                            <b>Price</b>\r\n                                        </div>\r\n                                        <div className=\"text-right mb-2\">\r\n                                            <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                                        </div>\r\n                                        <div className=\"d-flex\">\r\n                                            <select className=\"form-control\" id=\"currency\" name=\"nftConfig.price.currency\" onChange={(e) => this.onChange(e)}>\r\n                                                {\r\n                                                    currencies && currencies.map((currency, index) => {\r\n                                                        return (\r\n                                                            <option key={index} value={currency.symbol}>{currency.symbol}</option>\r\n                                                        )\r\n                                                    })\r\n                                                }\r\n                                            </select>\r\n                                            <input type=\"text\" placeholder=\"Amount\" className=\"amount-btn ml-3\" name=\"nftConfig.price.amount\" placeholder=\"Amount\" className=\"amount-btn ml-3\" style={{ borderRadius: \"4px\" }} onChange={(e) => this.onChange(e)} onKeyDown={(e) => decimalNumberValidator(e)} defaultValue={nftConfig.price.amount} required />\r\n                                            <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                                $ 0.00\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"text-danger\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</Modal.Body>\r\n                            <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\r\n                                <div className=\"offer-expiration-wrapper text-white\">\r\n                                    <b>Offer Expiration</b>\r\n                                </div>\r\n                                <div>\r\n                                    <div className=\"d-flex\">\r\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\r\n                                            style={{\r\n                                                padding: \"7px 55px 7px 55px\",\r\n                                                border: \"none\",\r\n                                                outline: \"none\",\r\n                                                borderRadius: \"4px\",\r\n                                                background: \"#808080\",\r\n                                                display: \"flex\",\r\n                                                alignItems: \"center\",\r\n                                                cursor: \"pointer\",\r\n                                                height: \"51px\",\r\n                                                color: \"#000\"\r\n                                            }}\r\n                                        >\r\n                                            {\r\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\r\n                                                    return (\r\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\r\n                                                    )\r\n                                                })\r\n                                            }\r\n                                        </select>\r\n                                        <div>\r\n                                            <div className=\"mr-auto budle-wrapper\">\r\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\r\n                                            </div>\r\n                                            <span className=\"text-danger message\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"justify-content-center align-items-center\">\r\n                                <div className=\"d-flex justify-content-around\">\r\n                                    <button className=\"ethereum-btn mr-3\" disabled={loader} onClick={() => this.submit()}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.bidBtn}</button>\r\n                                    {/* <button className=\"ethereum-btn\">Add funds</button> */}\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Footer>\r\n                                <button\r\n                                    className=\"btn banner-btn btn-primary\"\r\n                                    onClick={this.closeModal}\r\n                                >\r\n                                    Close\r\n                                </button>\r\n                            </Modal.Footer>\r\n                        </Modal>\r\n                    }\r\n                </div>\r\n            </>\r\n        );\r\n                }\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n    // console.log('state', state),\r\n \r\n    {\r\n    nft: state.nft,\r\n    error: state.error,\r\n    offer: state.offer,\r\n    bid: state.bid,\r\n    user: state.user,\r\n    nftAll:state.nftAll,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeNFT, getNFT,\r\n    beforeOffer, makeOffer, getOffers, deleteOffer, beforeBid, placeBid, getBids, deleteBid, acceptOffer, acceptBid, beforeUser, getCreators ,\r\n})(ItemDetails);\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/filter-search/filtersearch.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore-items.js",["1323","1324","1325","1326","1327","1328","1329"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nimport NftCard from '../collections/components/NftCard/NftCard'\nconst initData = {\n    btn_1: \"Load More\",\n}\n\nfunction ExploreItems(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n\n    useEffect(() => {\n        // get NFTs for explore section\n        const nftQS = { page: 1, limit: 4, explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }, [])\n\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            if (nftsData) {\n                setNFTs(nftsData.nfts)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n                setLoader(false)\n                if (props.setView)\n                    props.setViewAll(nftsData.nfts && nftsData.nfts.length > 0)\n            }\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n\n        // get more NFTs for explore section\n        const nftQS = { page: 1, limit: limit * (page + 1), explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n    return (\n        <>\n            {/* <div className={`row items ${props.class1 ? props.class1 : ''} ${!nfts.length ? 'justify-content-center' : ''}`}> */}\n            <div className=\"row\">\n            <div className=\"row justify-content-center mt-5 w-100\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                {/* <span>{initData.pre_heading}</span> */}\n                                <span>Explore</span>\n                                {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                                    <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                            </div>\n                        </div>\n                    </div>\n\n                {\n                    props.nfts && props.nfts.length > 0 ?\n                        props.nfts.map((item, idx) => {\n                            return (\n                                \n                                // <div key={`${props.key}_${idx}`} className={`col-12 col-sm-6 col-lg-3 item d-block ${props.class2 ? props.class2 : ''}`}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <Link to=\"/author\">\n                                //                         <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6>\n                                //                     </Link>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     {/* <span>{item.sold} of {item.copies}</span> */}\n                                //                 </div>\n                                //                 {/* <Link className=\"btn btn-bordered-white btn-smaller mt-3\" to=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</Link> */}\n                                //             </div>http://3.142.91.8/authorshttp://3.142.91.8/authors\n                                //         </div>\n                                //     </div>\n                                // </div>\n                                     \n                      <>\n                     \n                                     <div className=\"col-4 mt-5\">\n                                     <NftCard/>\n                                     </div>\n\n                                     </>\n                              \n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Explore</p>\n                }  </div>\n            {/* </div> */}\n            {\n                props.loadMoreBtn &&\n                <div className=\"row\">\n                    <div className=\"col-12 text-center\">\n                        <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                    </div>\n                </div>\n            }\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs })(ExploreItems);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/popular-collections.js",["1330","1331","1332","1333","1334"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\nimport Collections from \"./collections\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { connect } from \"react-redux\";\nimport { CollectionImages } from \"../../assets/assets.js\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst collectionData = [\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n];\n\nconst PopularCollections = (props) => {\n  // const [categories, setCategories] = useState(null);\n  // const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  // const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  // const collectionsRef = useRef(null);\n\n  // useEffect(() => {\n  //   window.scroll(0, 0);\n  //   props.getCategories();\n  // }, []);\n\n  // // when categories data is received\n  // useEffect(() => {\n  //   if (props.category.getAuth) {\n  //     const { categories } = props.category;\n  //     // const allCat = { active: true, name: 'all' }\n  //     // setCategories([allCat, ...categories])\n  //     setCategories(categories);\n  //     props.beforeCategory();\n  //     setCatLoader(false);\n  //     setColLoader(false);\n  //   }\n  // }, [props.category.getAuth]);\n\n  // const getCatCollections = (catId) => {\n  //   collectionsRef.current?.getCatCollections(catId);\n  // };\n  // const getColLoader = (loader) => {\n  //   setColLoader(loader);\n  // };\n\n  // console.log(categories, \"categories123\");\n\n  return (\n    <>\n      {/* {!collectionsLoader ? (\n        <FullPageLoader />\n      ) : ( */}\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-0\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products. We want to be a part of your\n                    smile, success and future growth.\n                  </p>\n                </div>\n                {/* {collectionsRef.current?.colCount > 0 && (\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn content-btn text-left\"\n                      to=\"/collections\"\n                    >\n                      {initData.btnText}\n                    </Link>\n                  </div>\n                )} */}\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-center justify-content-sm-end align-content-xxl-start text-end\">\n                <button className=\"me-1 me-sm-2 active\">Arts</button>\n                <button className=\"me-1 me-sm-2\">Music</button>\n                <button className=\"me-1 me-sm-2\">Game</button>\n                <button className=\"me-1 me-sm-5\">Sport</button>\n                <div className=\"intro-btn\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\n                    to=\"/popular-collections\"\n                  >\n                    View All\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <CardSlider\n            settings={ENV.popularCollectionsSettings}\n            homeAuction={false}\n            data={[1, 2, 3, 4]}\n          >\n            {collectionData.map((collectionData) => {\n              return (\n                <CollectionsCard\n                  CardImg={collectionData.mainImg}\n                  Subimg1={collectionData.subImg1}\n                  Subimg2={collectionData.subImg2}\n                  Subimg3={collectionData.subImg3}\n                />\n              );\n            })}\n            {/* {categories.map((category) => { \n                return (\n                  <>\n                    <CollectionsCard category={category} />\n                  </>\n                );\n              })} */}\n          </CardSlider>\n          {/* <CollectionsCard /> */}\n          {/* <Collections\n            popular={true}\n            userId=\"61408000cef27850fdea272b\"\n            setLoader={getColLoader}\n            ref={collectionsRef}\n          /> */}\n        </div>\n      </section>\n      {/* )} */}\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, { beforeCategory, getCategories })(\n  PopularCollections\n);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore-home.js",["1335","1336","1337","1338","1339","1340"],"import React, { useState } from 'react';\nimport ExploreItems from './explore-items';\nimport { Link } from 'react-router-dom';\n\nconst initData = {\n    pre_heading: \"Exclusive Assets\",\n    heading: \"Explore\",\n    btn_1: \"View All\",\n}\n\nfunction ExploreHome() {\n    const [viewAll, setViewAll] = useState(false);\n\n    const getViewAll = (view) => {\n        setViewAll(view)\n    }\nconst nfts=[\n  1,2,3,4,5,6\n]\n    return (\n        <section className=\"explore-area load-more p-0\">\n            <div className=\"container\">\n                <div className=\"row\">\n                    {/* <div className=\"col-12\">\n                        <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                            <div className=\"intro-content\">\n                                <span>{initData.pre_heading}</span>\n                                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                            </div>\n                            {\n                                viewAll &&\n                                <div className=\"intro-btn\">\n                                    <Link className=\"btn content-btn\" to=\"/explore-all\">{initData.btn_1}</Link>\n                                </div>\n                            }\n                        </div>\n                    </div> */}\n                </div>\n                {/* <ExploreItems key=\"exo\" setView={true} setViewAll={getViewAll} loadMoreBtn nfts={nfts}/> */}\n            </div>\n        </section>\n    );\n}\n\nexport default ExploreHome;","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/components/NftCard/NftCard.js",["1341","1342"],"import react from \"react\";\nimport { Link } from \"react-router-dom\";\nimport \"./NftCard.css\";\n\nconst NftCard = (props) => {\n  const filterCreator = (nft) => {\n    const result = props.creators.find((item) => item._id === nft.nftOwnerId);\n    if (result?.username) {\n      return result?.username;\n    } else {\n      return \"no username found\";\n    }\n  };\n  const { userId, nft } = props;\n  return (\n    <div className=\"NftCard-Container \">\n      <Link to={`/item-details?item=${window.btoa(props.nft._id)}`}>\n        <img\n          src={\n            props?.nft?.image ? props.nft.image : \"https://picsum.photos/200\"\n          }\n          alt=\"testinImage\"\n          className=\"nft-car-img\"\n        />\n      </Link>\n\n      <div className=\"NftCard-description p-3\">\n        <p className=\"mb-0 text-white\">\n          {props?.nft?.name ? props.nft.name : \"someTHing\"}\n        </p>\n        <p className=\"text-white\">Owned By: {filterCreator(props.nft)}</p>\n        <div className=\"d-flex w-100 justify-content-between\">\n          <p className=\"mb-0 text-white\">\n            {props?.nft?.currentPrice ? props.nft.currentPrice : \"0.04\"}\n          </p>\n          <p className=\"mt-0 text-white\">\n            {props?.nft?.sold ? props.nft.sold : \"0\"} out of {props.nft.copies}\n          </p>\n        </div>\n        <div className=\"py-3\">\n          <Link\n            to={`/item-details?item=${window.btoa(props.nft._id)}`}\n            id=\"wallet-address\"\n            className=\"btn ml-lg-auto btn-bordered-white\"\n          >\n            <i className=\"icon-wallet mr-md-2\" />\n            {nft.nftOwnerId === userId\n              ? \"Sell NFT\"\n              : nft.sellingMethod === undefined\n              ? \"NFT Details\"\n              : nft.nftOwnerId !== userId && nft.sellingMethod == 1\n              ? \"Buy Now\"\n              : \"Place a Bid\"}\n          </Link>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default NftCard;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/work/work.js",["1343","1344","1345"],"import React, { Component } from \"react\";\r\nimport WalletIcon from \"../../assets/images/setup-wallet-icon-white.svg\";\r\nimport CollectionIcon from \"../../assets/images/collection-icon-white.svg\";\r\nimport AddNftIcon from \"../../assets/images/add-nft-icon-white.svg\";\r\nimport SaleIcon from \"../../assets/images/sale-icon-white.svg\";\r\nimport axios from \"axios\";\r\nimport { init } from \"aos\";\r\n\r\n// const BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json/work\";\r\nconst BASE_URL = \"../../json-server/db.json/work\";\r\nconst initData = {\r\n  preHeading: \"How It Works\",\r\n  heading: \"Create and sell your NFTs\",\r\n  workData: [\r\n    {\r\n      id: 1,\r\n      icon: \"icons icon-wallet text-effect\",\r\n      img: WalletIcon,\r\n      title: \"Set up your wallet\",\r\n      text: \"Once you've set up your Celo or BSC Metamask wallet, connect to ARI NFT Marketplace by Signing In and clicking Login.\",\r\n    },\r\n    {\r\n      id: 2,\r\n      icon: \"icons icon-grid text-effect\",\r\n      img: CollectionIcon,\r\n      title: \"Create your collection\",\r\n      text: \"Click Create and set up your collection. Add social links, a description, profile & banner images, and set a secondary sales fee.\",\r\n    },\r\n    {\r\n      id: 3,\r\n      icon: \"icons icon-drawer text-effect\",\r\n      img: AddNftIcon,\r\n      title: \"Add your NFTs\",\r\n      text: \"Upload your work (image, video, audio, or 3D art), add a title and description, and customize your NFTs with properties, stats, and unlockable content.\",\r\n    },\r\n    {\r\n      id: 4,\r\n      icon: \"icons icon-bag text-effect\",\r\n      img: SaleIcon,\r\n      title: \"List them for sale\",\r\n      text: \"Choose between auctions, fixed-price listings, and declining-price listings. You choose how you want to sell your NFTs!\",\r\n    },\r\n  ],\r\n};\r\n// console.log('base url',BASE_URL)\r\nclass Work extends Component {\r\n  state = {\r\n    data: {},\r\n    workData: [],\r\n  };\r\n  componentDidMount() {\r\n    this.setState({\r\n      data: initData,\r\n      workData: initData.workData,\r\n    });\r\n    // axios.get(`${BASE_URL}`)\r\n    //     .then(res => {\r\n    //         this.setState({\r\n    //             data: res.data,\r\n    //             workData: res.data.workData\r\n    //         })\r\n    //         console.log(this.state.data)\r\n    //     })\r\n    // .catch(err => console.log(err))\r\n  }\r\n  render() {\r\n    return (\r\n      <section className=\"work-area padding-wrapper\">\r\n        <div className=\"container\">\r\n          <div className=\"row\">\r\n            <div className=\"col-12\">\r\n              {/* Intro */}\r\n              <div className=\"intro mb-4\">\r\n                <div className=\"intro-content\">\r\n                  <span>{this.state.data.preHeading}</span>\r\n                  <h3 className=\"mb-0\">{this.state.data.heading}</h3>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row items mt-3 mt-lg-5\">\r\n            {this.state.workData.map((item, idx) => {\r\n              return (\r\n                <div\r\n                  key={`wd_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                >\r\n                  {/* Single Work */}\r\n                  <div className=\"single-work\">\r\n                    {/* <i className={`${item.icon} mb-5`} /> */}\r\n                    <img src={item.img} alt=\"icon\" className=\"mb-3\" />\r\n                    <h4 className=\"mb-3\">{item.title}</h4>\r\n                    <p>{item.text}</p>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })}\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n}\r\n\r\nexport default Work;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero/hero.js",["1346","1347"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport ExploreIcon from \"../../assets/images/explore-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-rounded-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                {/* <i className=\"icon-rocket mr-2\" /> */}\r\n                <img src={ExploreIcon} alt=\"exploreIcon\" className=\"me-2\" />\r\n                <p>Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"d-lg-none d-flex watch-video align-items-center mt-5 mb-4\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6 col-xl-7 \">\r\n            <Slider\r\n              setHandler={setHandler}\r\n              sliderRadioButtons={sliderRadioButtons}\r\n              handleRadioInputs={handleRadioInputs}\r\n              sliderChecked={sliderChecked}\r\n            />\r\n          </div>\r\n          <div className=\"d-none d-lg-block col-12 col-lg-7\">\r\n            <div className=\"watch-video d-flex align-items-center\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-5\">\r\n            <div className=\"btn-container mx-auto mx-lg-0\">\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn me-3\"\r\n                onClick={prevBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-left\"></i>\r\n              </button>\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn\"\r\n                onClick={nextBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-right\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default Hero;\r\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/faq/faq.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["1348","1349"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.properties\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"500px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white mt-0\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 7.95rem\"\n                    : \"7.95rem\"\n                }`,\n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" style={{ width: \"558px\" }} key={i}>\n                      <div className=\"row\">\n                        <div\n                          className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1\"\n                          key={i}\n                        >\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <input\n                              className=\"step3-input mt-2 \"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              placeholder=\"Name\"\n                              value={item.name || \"\"}\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29 !important\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n\n                        <div className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1 ml-0 ml-md-4\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{\n                                fontSize: \"1.2rem\",\n                                fontWeight: \"bold\",\n                              }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <div className=\"d-flex align-items-center w-100\">\n                              <input\n                                className=\"step3-input  mt-2\"\n                                type=\"text\"\n                                name=\"value\"\n                                onChange={(e) => handleChange(i, e)}\n                                placeholder=\"Value\"\n                                value={item.value || \"\"}\n                                maxLength=\"30\"\n                                autoComplete=\"off\"\n                                style={{\n                                  backgroundColor: \"#000e29 \",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                              <BsFillXCircleFill\n                                className=\"ml-1 ml-sm-2\"\n                                style={{\n                                  color: \"#00d3f3\",\n                                  top: \"3rem\",\n                                  left: \"13.8rem\",\n                                  cursor: \"pointer\",\n                                }}\n                                onClick={() => removeFormFields(i)}\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <p\n              className=\" mt-4 ml-4\"\n              style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n              onClick={() => addMoreValues()}\n            >\n              {\" \"}\n              Add Property\n            </p>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-2 mt-md-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   propertiesValues && propertiesValues?.length > 0\n                //     ? false\n                //     : true\n                // }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["1350","1351","1352"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(props.levelsInputs);\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage, setErrorMessage] = React.useState(\"\");\n  const [validate, setValidate] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues.splice(i, 1);\n    setlevelsInputs(newFormValues);\n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total === \"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\");\n        return \"\";\n      }\n      if (+item.value > +item.total) {\n        alert(\"inside\");\n        setError(true);\n        setValidate(true);\n        setErrorMessage(\"Value should be less then total!\");\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n  //  const handleValue=(item)=>{\n  //    if(item.value > item.total){\n\n  //      setError(true)\n  //      return true\n  //    }\n  //    return false\n  //  }\n  //  const handleTotal=(item)=>{\n\n  //  }\n  // console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"550px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 mx-auto justify-content-center\">\n              <div className=\"d-flex\">\n                <img\n                  src={LevelsImage}\n                  alt={\"levels\"}\n                  style={{ height: \"2rem\" }}\n                />\n                <p\n                  className=\"text-white\"\n                  style={{\n                    fontSize: \"1.3rem\",\n                    fontWeight: \"bold\",\n                    marginLeft: \"1rem\",\n                  }}\n                >\n                  Add Levels\n                </p>\n              </div>\n            </div>\n            {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Levels show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n            <form onSubmit={handleSubmit}>\n              <div\n                className=\"row levels-scroll p-3 \"\n                style={{\n                  height: `${\n                    levelsInputs && levelsInputs.length > 0\n                      ? \"8.3rem\"\n                      : \"7.3rem\"\n                  }`,\n                }}\n              >\n                {levelsInputs &&\n                  levelsInputs.length > 0 &&\n                  levelsInputs.map((item, i) => {\n                    return (\n                      <div\n                        className=\"row\"\n                        key={i}\n                        style={{\n                          marginBottom: `${\n                            levelsInputs && levelsInputs.length > 1\n                              ? \"12px\"\n                              : \"0\"\n                          }`,\n                        }}\n                      >\n                        <div className=\"col-10 col-sm-6 mt-2 \" key={i}>\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            <input\n                              className=\"step3-input mt-3 name-inp\"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              value={item.name || \"\"}\n                              placeholder=\"Name\"\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 mt-2\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                            <div className=\"values-total-inp w-100\">\n                              <input\n                                className={`step3-input first-value mt-3 values-inp ${\n                                  validate && item.value > item.total\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min=\"1\"\n                                max={\n                                  item.total == \"0\"\n                                    ? \"1\"\n                                    : item.total\n                                    ? item.total\n                                    : \"1\"\n                                }\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.value || \"\"}\n                                placeholder=\"Value\"\n                                autoComplete=\"off\"\n                                name=\"value\"\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n\n                              <p className=\"text-white mb-0 value-label mt-3\">\n                                Of\n                              </p>\n                              <input\n                                className={`step3-input first-value values-inp mt-3 ${\n                                  validate && item.total < item.value\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min={item.value ? item.value : \"1\"}\n                                max=\"9999\"\n                                name=\"total\"\n                                placeholder=\"Total\"\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.total || \"\"}\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                            </div>\n                            <BsFillXCircleFill\n                              className=\"position-absolute levels-cross-icon\"\n                              style={{\n                                color: \"#00d3f3\",\n                                top: \"3rem\",\n                                right: \"-1rem\",\n                                cursor: \"pointer\",\n                              }}\n                              onClick={() => removeFormFields(i)}\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                <div className=\"W-100 text-center\"></div>\n              </div>\n              <p\n                className=\" col-8 mt-4\"\n                style={{\n                  color: \"#00d3f3\",\n                  cursor: \"pointer\",\n                  marginLeft: \"0.8rem\",\n                }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n\n              <div className=\"w-100 text-center\">\n                <button\n                  type=\"submit\"\n                  className=\"btn btn-secondary start-btn mt-5 text-center\"\n                  style={{ width: \"9rem\" }}\n                  // disabled={\n                  //   levelsInputs && levelsInputs?.length > 0\n                  //     ? false\n                  //     : true\n                  // }\n                  // onClick={() => {\n                  //   handleSubmit()\n                  // }}\n                >\n                  Save\n                </button>\n              </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.action.js",["1353"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice, acceptNftOffer} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body,tokenId,price) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            acceptNftOffer(body);\n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore.reducer.js",["1354"],"import { GET_COLLECTION } from '../../redux/types';\n\nconst initialState = {\n    collection:[],\n    getAuth: true\n    \n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n        \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/create-nft-reducer.js",["1355"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/explore-collections.js",["1356","1357","1358","1359"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/top-seller/topsellerlist.js",["1360","1361","1362"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  useEffect(() => {\n    props.getTopSellers();\n  }, []);\n  useEffect(() => {\n    setSellers(props.user.sellers);\n  }, [props.user.topSellersAuth]);\n\n  return (\n    <>\n      <NavbarMain />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <Link to={`/author/${author._id}`}>\n                          <div className=\"seller-avatar-container\">\n                            <img\n                              className=\"avatar-md rounded-circle\"\n                              src={AvatarImg}\n                              alt=\"\"\n                            />\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          </div>\n                        </Link>\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">{\"256.6ETH\"}</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>Top Sellers not available</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {/* {!empty &&\n                  collections?.length > 10 &&\n                  pagination.totalRecords <= collections.length && ( */}\n                <button className=\"btn btn-linear-gradient px-5\">\n                  Load more\n                </button>\n                {/* )} */}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList\n);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/popular-collections-list/popular-collections-list.js",["1363","1364","1365","1366"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"music\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n      // if (props.setLoader) props.setLoader(false);\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Most Popular</span>\n                    <h3 className=\"mb-0\">Popular Collections</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-lg-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={collection.banner}\n                        Subimg1={collection.logo}\n                        Subimg2={collection.featuredImg}\n                        Subimg3={collection.banner}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.user[0]?.username\n                            ? collection?.user[0]?.username\n                            : \"\"\n                        }\n                        NFTCount={collection.NFTCount}\n                        // handleLikesTogle={handleLikesTogleApi}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    collections?.length > 10 &&\n                    pagination.totalRecords <= collections.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/all-nft/allnft.js",["1367","1368","1369","1370","1371","1372","1373","1374","1375","1376","1377","1378","1379","1380","1381","1382","1383"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collection-details/collectiondetails.js",["1384","1385","1386","1387","1388","1389","1390","1391","1392","1393","1394","1395","1396","1397","1398","1399","1400","1401","1402"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./collectiondetails.css\";\nimport Avatar from \"../../assets/images/detail-avatar.png\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { ListingImg } from \"../../assets/assets\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\n\nconst CollectionDetailsPage = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n  });\n  const location = useLocation();\n\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    chains: {\n      label: \"Chains\",\n      option: [\"Ethereum\"],\n    },\n  };\n\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNfts(props.nfts);\n      props.beforeNFT();\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 40,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    setFilterationLoader(true);\n\n    const nftQS = { page, limit };\n\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      newest,\n      highToLow,\n    } = filter;\n\n    // if (!collectionIdFilter) collectionIdFilter = collectionId;\n    // if (!gtePriceFilter) gtePriceFilter = gtePrice;\n    // if (!ltePriceFilter) ltePriceFilter = ltePrice;\n    // if (!categoryIdFilter) categoryIdFilter = categoryId;\n    // if (!oldestFilter) oldestFilter = oldest;\n    // if (!lowToHighFilter) lowToHighFilter = lowToHigh;\n    // if (!highToLowFilter) highToLowFilter = highToLow;\n    // if (!newestFilter) newestFilter = newest;\n\n    nftQS.collectionId = location.state._id;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getNFTs(qs);\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n  ///////////Likes\n  const handleLikesTogleApi = (nftId, status) => {\n    // const {\n    //   collectionId,\n    //   gtePrice,\n    //   ltePrice,\n    //   categoryId,\n    //   oldest,\n    //   lowToHigh,\n    //   highToLow,\n    //   newest,\n    //   page,\n    //   limit,\n    // } = filter;\n    // getNFTs(\n    //   page,\n    //   limit,\n    //   false,\n    //   minValue,\n    //   maxValue,\n    //   categoryId,\n    //   oldest,\n    //   lowToHigh,\n    //   highToLow,\n    //   newest\n    // );\n    // let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    // qs = ENV.objectToQueryString(qs);\n    // props.getMyLikedNfts(qs);\n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n    // setNFTs(nfts);\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const { name, banner, logo, description } = location.state;\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <div className=\"collection-detail-hero w-100\">\n            <img className=\"w-100\" src={banner} alt=\"BannerImg\" />\n          </div>\n          <div className=\"collection-detail-content\">\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"collection-owner-avatar\">\n                    <img src={banner} alt=\"owner-avatar\" />\n                  </div>\n                  <div className=\"d-md-flex align-items-center justify-content-between mt-5\">\n                    <div className=\"collection-owner-detail\">\n                      <div className=\"collection-owner-name d-flex align-items-center\">\n                        <h3>{name}</h3>\n                        <img src={TickIcon} alt=\"tick-icon\" className=\"ms-2\" />\n                      </div>\n                      <p>\n                        Created by <span>brendannorth</span>\n                      </p>\n                    </div>\n                    <div className=\" d-block d-md-none\">\n                      <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                        <p>{description}</p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-btns mt-3 mt-md-0 ms-auto\">\n                      <button className=\"me-1 me-sm-2 me-lg-3\">\n                        <img src={FlagIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button className=\"me-1 me-sm-1 me-lg-3\">\n                        <img src={ShareIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button>+ Add to wishlist</button>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-sm-7 col-md-6 col-lg-5 d-none d-md-block\">\n                  <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                    <p>{description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 col-lg-7 mt-3 mt-sm-5\">\n                  <div className=\"d-flex align-items-center justify-content-center justify-content-lg-end\">\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>items</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Owner</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Prize floor</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Volume trade</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"collections-listing padding-wrapper\">\n                <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <img\n                        src={SearchIcon}\n                        alt=\"search-icon\"\n                        className=\"ms-3\"\n                      />\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        placeholder=\"Search\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Item:</p>\n                      </div>\n\n                      <select name=\"collection-select\">\n                        {itemoptions &&\n                          itemoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Sort:</p>\n                      </div>\n\n                      <select\n                        name=\"collection-select\"\n                        onChange={handleSortOptions}\n                      >\n                        {sortoptions &&\n                          sortoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 d-sm-none\">\n                    <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                      <button\n                        className={`${\n                          activeFilter\n                            ? \"filter-btn-active\"\n                            : \"filter-btn-inactive\"\n                        } ps-2`}\n                        onClick={() => setActiveFilter(!activeFilter)}\n                      >\n                        Filters\n                      </button>\n                    </div>\n                    <div\n                      className={`${\n                        activeFilter ? \"d-block\" : \"d-none\"\n                      } sm-filter-options`}\n                    >\n                      <div className=\"col-10 mx-auto mt-2\">\n                        <FilterComponent\n                          Status={filterData.status}\n                          Chains={filterData.chains}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row mt-5\">\n                <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                  <FilterComponent\n                    Status={filterData.status}\n                    Chains={filterData.chains}\n                    onChangeMinPrice={onChangeMinPrice}\n                    onChangeMaxPrice={onChangeMaxPrice}\n                    minValue={minValue}\n                    maxValue={maxValue}\n                    applyMinMaxFilter={applyMinMaxFilter}\n                  />\n                </div>\n                <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                  <div className=\"row g-3\">\n                    {filterationLoader ? (\n                      <div className=\"text-center\">\n                        <div\n                          class=\"spinner-border text-secondary text-white \"\n                          role=\"status\"\n                        >\n                          <span class=\"sr-only\">Loading...</span>\n                        </div>\n                      </div>\n                    ) : nfts && nfts.length > 0 ? (\n                      nfts.map((listing) => {\n                        return (\n                          <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                            <ListingCards\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                            />\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-white mt-5 text-center no-nfts-title\">\n                        No NFT's Found\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftAll.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n})(CollectionDetailsPage);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nft-detail/nftdetail.js",["1403","1404","1405","1406","1407","1408","1409","1410","1411","1412","1413","1414"],"import React, { useEffect, useState } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./nftdetail.css\";\nimport PriceHistoy from \"../../assets/images/pricehistoryicon.svg\";\nimport OfferIcon from \"../../assets/images/offer-icon.svg\";\nimport ListingIcon from \"../../assets/images/listing-icon.svg\";\nimport ActivityIcon from \"../../assets/images/activity.svg\";\nimport MoreCollectionIcon from \"../../assets/images/morecollectionicon.svg\";\nimport { ListingImg } from \"../../assets/assets\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport DescriptionIcon from \"../../assets/images/detail-description-icon.svg\";\nimport { getNFT, getNFTsByCollection } from \"../nfts/nfts.action.js\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader.js\";\nimport { connect } from \"react-redux\";\nimport { Modal } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport moment from \"moment\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport axios from \"axios\";\n\nconst NFTDetail = (props) => {\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const history = useHistory();\n  let nftId = props.match.params.id;\n  const initData = {\n    itemImg: \"/img/auction_2.jpg\",\n    date: \"2022-03-30\",\n    price_2: \"$500.89\",\n    bidBtn: \"Place a Bid\",\n    offerBtn: \"Buy Now\",\n    sellBtn: \"Sell\",\n  };\n  const { currencies } = ENV;\n  const expiryOptions = [\n    { label: \"5 Days\", value: moment().add(5, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"7 Days\", value: moment().add(7, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"A Month\", value: moment().add(1, \"months\").format(\"DD/MM/YYYY\") },\n    { label: \"Custom Date\", value: -1 },\n  ];\n\n  const config1 = {\n    price: {\n      currency: ENV.currency,\n      amount: \"\",\n    },\n    expiry: {\n      date: expiryOptions[0].value,\n      time: moment(new Date()).format(\"HH:mm\"),\n      type: 1, // 1 for time & 2 for datetime-local\n      datetime: \"\", // for payload\n    },\n  };\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [nftsList, setNftList] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [nftConfig, setNftConfig] = useState(config1);\n  const validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n\n  const propertiesData = [\n    {\n      id: 1,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 2,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 3,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 4,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 5,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 6,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 7,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 8,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n  ];\n  useEffect(() => {\n    props.getNFT(nftId);\n  }, []);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n\n      props.getNFTsByCollection(props.nftDetail.collectionId);\n    }\n  }, [props.nftsAuth]);\n\n  useEffect(() => {\n    if (props.nftsByCollectionStatus) {\n      let moreCollection = [];\n      if (props.nftsByCollection && props.nftsByCollection?.length) {\n        moreCollection = props.nftsByCollection.filter(\n          (item) => item._id !== nftDetail._id\n        );\n      }\n      setNftList(moreCollection);\n    }\n  }, [props.nftsByCollectionStatus]);\n\n  const handleRouting = () => {\n    if (ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId) {\n      history.push({\n        pathname: `/sell-item/${nftDetail._id}`,\n        state: nftDetail,\n      });\n    }\n  };\n\n  console.log(ENV.getUserKeys(\"_id\")._id, \"user id\");\n  console.log(nftDetail, \"nftDetail\");\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        console.log(res, \"exchangeapires\");\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <section className=\"padding-wrapper nft-detail\">\n            <div className=\"container\">\n              <div className=\"row g-3\">\n                <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n                  <div className=\"row\">\n                    <div className=\"col-12 order-2 order-md-1\">\n                      <div className=\"nftDetail-accordion\">\n                        <div\n                          className=\"accordion accordion-flush \"\n                          id=\"accordionFlushExample\"\n                        >\n                          {/* <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                              >\n                                <img\n                                  src={PriceHistoy}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price history\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseOne\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingOne\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div> */}\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingTwo\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={OfferIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Offers\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"table-container\">\n                                  <table class=\"table table-borderless\">\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Floor Difference</th>\n                                        <th scope=\"col\">Expiration</th>\n                                        <th scope=\"col\">From</th>\n                                      </tr>\n                                    </thead>\n                                    <tbody>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={ListingIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Item listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"table-container listing-table\">\n                                  <table class=\"table table-borderless\">\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Expiration</th>\n                                        <th scope=\"col\">From</th>\n                                        <th scope=\"col\">{\"\"}</th>\n                                      </tr>\n                                    </thead>\n                                    <tbody>\n                                      <tr>\n                                        <th scope=\"row\">0.025</th>\n                                        <td>$77.50</td>\n                                        <td>in a day</td>\n                                        <td>BBC1B3</td>\n                                        <td>\n                                          <button>Buy</button>\n                                        </td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-11 col-md-12 col-lg-7 col-xl-5 order-1 order-md-2 mx-auto mb-5 mb-md-0  mx-md-0\">\n                      <div className=\"collection-filter-accordion nft-stats-accordion\">\n                        <div\n                          className=\"accordion accordion-flush \"\n                          id=\"accordionFlushExample\"\n                        >\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingFour\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseFour\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseFour\"\n                              >\n                                Properties\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseFour\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingFour\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"row g-2 justify-content-center align-items-center\">\n                                  {propertiesData &&\n                                    propertiesData.map((data) => {\n                                      return (\n                                        <div className=\"col-6 col-sm-4 col-md-6\">\n                                          <div className=\"properties-content-container d-flex flex-column justify-content-center align-items-center text-center\">\n                                            <div className=\"properties-content\">\n                                              <span>{data.subTitle}</span>\n                                              <h3>{data.title}</h3>\n                                              <p>{data.content}</p>\n                                            </div>\n                                          </div>\n                                        </div>\n                                      );\n                                    })}\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSix\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSix\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSix\"\n                              >\n                                Stats\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSix\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSix\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSeven\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSeven\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSeven\"\n                              >\n                                Levels\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSeven\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSeven\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingEight\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseEight\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseEight\"\n                              >\n                                Boosts\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseEight\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingEight\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingNine\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseNine\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseNine\"\n                              >\n                                Details\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseNine\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingNine\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"contact-address d-flex justify-content-between\">\n                                  <p>Contract Address</p>\n                                  <span>0x7227...3335</span>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Token ID</p>\n                                  <p>1584563428....</p>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Token Standard </p>\n                                  <p>ERC-721</p>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Blockchain </p>\n                                  <p>Polygon</p>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n                  <Card className=\"auction-card detail-card\">\n                    <div className=\"auction-img-wrapper\">\n                      <Card.Img\n                        variant=\"top\"\n                        src={nftDetail.image}\n                        alt=\"AuctionTopImg\"\n                      />\n                    </div>\n                    <Card.Body>\n                      <div>\n                        <span>Current price</span>\n                        <h3>\n                          {nftDetail.currentPrice}\n                          <span>\n                            (${\" \"}\n                            {(nftDetail.currentPrice * exchangeRate).toFixed(2)}\n                            )\n                          </span>\n                        </h3>\n                      </div>\n                      <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                        <div className=\"d-flex align-items-center\">\n                          <img\n                            src={ClockIcon}\n                            alt=\"clock-icon\"\n                            className=\"me-1\"\n                          />\n                          <span>Sale ends March 8, 2022 at 7:40am PKT </span>\n                        </div>\n                        <div className=\"likes-container d-flex align-items-center\">\n                          <span>\n                            {nftDetail.likeCount ? nftDetail.likeCount : 0}\n                          </span>\n                          <img\n                            src={HeartIcon}\n                            alt=\"heart-icon\"\n                            className=\"ms-1\"\n                          />\n                        </div>\n                      </div>\n                      <button\n                        className=\"btn btn-linear-gradient d-flex align-items-center justify-content-center w-75 mx-auto\"\n                        onClick={() => handleRouting()}\n                      >\n                        <p>\n                          {ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId\n                            ? \"Sell\"\n                            : \"Buy Now\"}\n                        </p>\n                      </button>\n                    </Card.Body>\n                  </Card>\n                  <div className=\"detail-description-content mt-5\">\n                    <div className=\"d-flex align-items-center mb-3\">\n                      <img\n                        src={DescriptionIcon}\n                        alt=\"descriptionIcon\"\n                        className=\"me-1\"\n                      />\n                      <h6>Discription</h6>\n                    </div>\n                    <p>{nftDetail.description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-0 mt-md-4 order-3\">\n                  <div className=\"nftDetail-accordion\">\n                    <div\n                      className=\"accordion accordion-flush \"\n                      id=\"accordionFlushExample\"\n                    >\n                      <div className=\"accordion-item\">\n                        <h2 className=\"accordion-header\" id=\"flush-headingTen\">\n                          <button\n                            className=\"accordion-button collapsed\"\n                            type=\"button\"\n                            data-toggle=\"collapse\"\n                            data-target=\"#flush-collapseTen\"\n                            aria-expanded=\"false\"\n                            aria-controls=\"flush-collapseTen\"\n                          >\n                            <img\n                              src={ActivityIcon}\n                              alt=\"price-history\"\n                              className=\"me-2\"\n                            />\n                            Activity\n                          </button>\n                        </h2>\n                        <div\n                          id=\"flush-collapseTen\"\n                          className=\"accordion-collapse collapse\"\n                          aria-labelledby=\"flush-headingTen\"\n                        >\n                          <div className=\"accordion-body\">\n                            <div className=\"table-container\">\n                              <table class=\"table table-borderless\">\n                                <thead>\n                                  <tr>\n                                    <th scope=\"col\">Event</th>\n                                    <th scope=\"col\">Price</th>\n                                    <th scope=\"col\">From</th>\n                                    <th scope=\"col\">To</th>\n                                    <th scope=\"col\">Date</th>\n                                  </tr>\n                                </thead>\n                                <tbody>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                </tbody>\n                              </table>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n\n                      <div className=\"accordion-item\">\n                        <h2\n                          className=\"accordion-header\"\n                          id=\"flush-headingEleven\"\n                        >\n                          <button\n                            className=\"accordion-button collapsed\"\n                            type=\"button\"\n                            data-toggle=\"collapse\"\n                            data-target=\"#flush-collapseEleven\"\n                            aria-expanded=\"false\"\n                            aria-controls=\"flush-collapseEleven\"\n                          >\n                            <img\n                              src={MoreCollectionIcon}\n                              alt=\"price-history\"\n                              className=\"me-2\"\n                            />\n                            More from this collection\n                          </button>\n                        </h2>\n                        <div\n                          id=\"flush-collapseEleven\"\n                          className=\"accordion-collapse collapse\"\n                          aria-labelledby=\"flush-headingEleven\"\n                        >\n                          <div className=\"accordion-body\">\n                            <div className=\"row justify-content-center align-items-center g-3\">\n                              {nftsList && nftsList.length > 0 ? (\n                                nftsList.map((listing) => {\n                                  return (\n                                    <div className=\"col-6 col-sm-6 col-md-4 col-lg-2 px-1\">\n                                      <ListingCards\n                                        CardImg={listing.image}\n                                        name={listing.name}\n                                        price={listing.currentPrice}\n                                        // usd={\n                                        //   listing.currentPrice * exchangeRate\n                                        // }\n                                        id={listing._id}\n                                      />\n                                    </div>\n                                  );\n                                })\n                              ) : (\n                                <p className=\"text-center mt-4\">\n                                  No NFTs Found\n                                </p>\n                              )}\n                            </div>\n                            <div className=\"mt-4 detail-btn-collection text-center\">\n                              {nftsList.length > 0 && (\n                                <button className=\"btn btn-rounded-bordered\">\n                                  View collection\n                                </button>\n                              )}\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            {/* ///////////////////////////////////// Modal */}\n            <div className=\"modal-wrapper\">\n              {false && (\n                <Modal\n                  centered\n                  size=\"lg\"\n                  // className=\"place-bid-modal\"\n                  show={true}\n                  // onHide={this.closeModal}\n                >\n                  <Modal.Header className=\"text-center modal-title-wrapper text-white\">\n                    <Modal.Title>\n                      {2 === 2 ? \"Place A Bid\" : \"Make An Offer\"}\n                    </Modal.Title>\n                  </Modal.Header>\n                  {/* {\n                                isSubmitted && errors &&\n                                <Modal.Body className=\"row pt-2 pb-0\">\n                                    <div className=\"col-12\">\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\n                                    </div>\n                                </Modal.Body>\n                            } */}\n                  <Modal.Body>\n                    <div className=\"price-wrapper d-flex\">\n                      <div className=\"price-text position-relative\">\n                        <div className=\"text-white mb-2 absolute-wrapper\">\n                          <b>Price</b>\n                        </div>\n                        <div className=\"text-right mb-2\">\n                          <i className=\"fas fa-exclamation-circle ml-2 text-white\" />\n                        </div>\n                        <div className=\"d-flex\">\n                          <select\n                            className=\"form-control currency-options\"\n                            id=\"currency\"\n                            name=\"nftConfig.price.currency\"\n                            onChange={(e) => this.onChange(e)}\n                          >\n                            {currencies &&\n                              currencies.map((currency, index) => {\n                                return (\n                                  <option key={index} value={currency.symbol}>\n                                    {currency.symbol}\n                                  </option>\n                                );\n                              })}\n                          </select>\n                          <input\n                            type=\"text\"\n                            placeholder=\"Amount\"\n                            className=\"amount-btn ml-3\"\n                            name=\"nftConfig.price.amount\"\n                            placeholder=\"Amount\"\n                            className=\"amount-btn ml-3\"\n                            style={{ borderRadius: \"4px\" }}\n                            onChange={(e) => this.onChange(e)}\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            defaultValue={nftConfig.price.amount}\n                            required\n                          />\n                          <div className=\"text-right mb-2 dollar-wrapper\">\n                            $ 0.00\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </Modal.Body>\n                  <Modal.Body className=\"text-danger\">\n                    {validator.message(\n                      \"amount\",\n                      nftConfig.price.amount,\n                      \"required\"\n                    )}\n                  </Modal.Body>\n                  {/* <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\n                                <div className=\"offer-expiration-wrapper text-white\">\n                                    <b>Offer Expiration</b>\n                                </div>\n                                <div>\n                                    <div className=\"d-flex\">\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\n                                            style={{\n                                                padding: \"7px 55px 7px 55px\",\n                                                border: \"none\",\n                                                outline: \"none\",\n                                                borderRadius: \"4px\",\n                                                background: \"#808080\",\n                                                display: \"flex\",\n                                                alignItems: \"center\",\n                                                cursor: \"pointer\",\n                                                height: \"51px\",\n                                                color: \"#000\"\n                                            }}\n                                        >\n                                            {\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\n                                                    return (\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\n                                                    )\n                                                })\n                                            }\n                                        </select>\n                                        <div>\n                                            <div className=\"mr-auto budle-wrapper\">\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\n                                            </div>\n                                            <span className=\"text-danger message\">{validator.message('amount', nftConfig.price.amount, 'required')}</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </Modal.Body> */}\n                  <Modal.Body className=\"justify-content-center align-items-center\">\n                    <div className=\"d-flex justify-content-around place-bid-btn\">\n                      <button\n                        className=\"ethereum-btn mr-3 place-bid-ethereum-btn\"\n                        disabled={loader}\n                        // onClick={() => this.submit()}\n                      >\n                        {2 === 2 ? initData.bidBtn : initData.bidBtn}\n                      </button>\n                      {/* <button className=\"ethereum-btn\">Add funds</button> */}\n                    </div>\n                  </Modal.Body>\n                  <Modal.Footer>\n                    <button\n                      className=\"btn banner-btn btn-primary\"\n                      // onClick={this.closeModal}\n                    >\n                      Close\n                    </button>\n                  </Modal.Footer>\n                </Modal>\n              )}\n            </div>\n          </section>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state, \"state in nft detail=>\"),\n  {\n    nftDetail: state.nft.nftsData,\n    nftsAuth: state.nft.nftsAuth,\n    nftsByCollection: state.nft.nftsByCollection,\n    nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  getNFT,\n  getNFTsByCollection,\n})(NFTDetail);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user-profile/UserProfile.js",["1415","1416","1417","1418","1419","1420","1421","1422","1423","1424","1425","1426","1427","1428","1429","1430","1431","1432","1433","1434","1435","1436","1437","1438","1439","1440","1441","1442","1443","1444","1445","1446","1447"],"import React, { useState,useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport \"./UserProfile.css\";\nimport { ENV } from \"../../config/config\";\nimport Avatar from \"../../assets/images/detail-avatar.png\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { ListingImg } from \"../../assets/assets\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\nimport { getProfileNfts, beforeNFT, getMyLikedNfts } from \"../nfts/nfts.action\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport {getUserById,beforeUser} from '../user/user.action';\n\n\nconst UserProfile = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [nftsCopy, setNFTsCopy] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [user,setUser]=useState('')\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n  });\n  const [menuFilter, setMenuFilter] = useState(\"\");\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const priceoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  useEffect(() => {\n    let qs = { ownerId: ENV.getUserKeys(\"_id\")._id };\n    console.log(qs, \"qs for user profile\");\n    qs = ENV.objectToQueryString(qs);\n    props.getProfileNfts(qs);\n    let likedNftsQs = { userId: ENV.getUserKeys(\"_id\")._id };\n    likedNftsQs = ENV.objectToQueryString(likedNftsQs);\n    props.getMyLikedNfts(likedNftsQs);\n    props.getUserById(ENV.getUserKeys(\"_id\")._id)\n  }, []);\n\n  useEffect(() => {\n    if (props.profileNFTsStatus) {\n      if (!menuFilter) {\n        const Nfts = props.profileNFTs.nfts.filter(\n          (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n        );\n        setNFTs(Nfts);\n        setNFTsCopy(props.profileNFTs.nfts);\n        setLoader(false);\n        setFilterationLoader(false);\n      } else {\n        setNFTsCopy(props.profileNFTs.nfts);\n        handleNftFilter(menuFilter);\n        setLoader(false);\n        setFilterationLoader(false);\n      }\n    }\n  }, [props.profileNFTsStatus]);\n\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(()=>{\n    const {individualUserAuth,individualUser}=props;\n    if(individualUserAuth){\n      setUser(individualUser)\n    }\n  },[props.individualUserAuth])\n\n  const ChangeTooltip = () =>\n    setTimeout(() => {\n      setAddressCopied(false);\n    }, 1000);\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      newest,\n      highToLow,\n    } = filter;\n\n    // if (!collectionIdFilter) collectionIdFilter = collectionId;\n    // if (!gtePriceFilter) gtePriceFilter = gtePrice;\n    // if (!ltePriceFilter) ltePriceFilter = ltePrice;\n    // if (!categoryIdFilter) categoryIdFilter = categoryId;\n    // if (!oldestFilter) oldestFilter = oldest;\n    // if (!lowToHighFilter) lowToHighFilter = lowToHigh;\n    // if (!highToLowFilter) highToLowFilter = highToLow;\n    // if (!newestFilter) newestFilter = newest;\n\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    nftQS.ownerId = ENV.getUserKeys(\"_id\")._id;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"qs indknf\");\n    props.getProfileNfts(qs);\n  };\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n    console.log(value, \"value\");\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      page,\n      limit,\n      id,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n  const handleLikesTogleApi = (nftId, status) => {\n   \n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n    // setNFTs(nfts);\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  const handleNftFilter = (id) => {\n    if (id === \"Collected\") {\n      const Nfts = nftsCopy.filter(\n        (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else if (id === \"Created\") {\n      const Nfts = nftsCopy.filter(\n        (item) =>\n          item.ownerId === ENV.getUserKeys(\"_id\")._id &&\n          item.creatorId === ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else {\n      handleFavFilter();\n    }\n  };\n\n  const handleFavFilter = () => {\n    let favNfts = [];\n    nftsCopy.map((item) => {\n      let foundNft = likedNfts.find((liked) => liked.nftId === item._id);\n      if (foundNft) {\n        favNfts.push(item);\n      }\n    });\n\n    setNFTs(favNfts);\n  };\n\n  const accountAddress = \"0xe0106f010067b130e4c96f119c214c30c94cead1\";\n  const menuData = [\"Collected\", \"Created\", \"Favourited\"];\n  console.log(user,\"user\")\n\n  return (\n    <>\n      <NavbarMain />\n      <div className=\"collection-detail-hero\">\n        <img src={BannerImg} alt=\"BannerImg\" />\n      </div>\n      <div className=\"collection-detail-content\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12\">\n              <div className=\"collection-owner-avatar text-center\">\n                <img src={Avatar} alt=\"owner-avatar\" />\n              </div>\n              <div className=\"collection-owner-detail text-center mt-3\">\n                {\n                  user &&\n                <div className=\"collection-owner-name\">\n                  <h3>{user.username?user.username:'unnamed'}</h3>\n                </div>\n                }\n                <div\n                  className=\"user-address mt-4 d-flex align-items-center \"\n                  onClick={() => {\n                    navigator.clipboard.writeText(accountAddress);\n                    setAddressCopied(true);\n                    ChangeTooltip();\n                  }}\n                >\n                  <i className=\"fab fa-ethereum\"></i>\n                  <span>{isAddressCopied ? \"Copied\" : \"Copy\"}</span>\n                  {\n                 user &&\n                  <p className=\"acc-adress\">\n                    {user.address.slice(0, 10) +\n                      \"...\" +\n                      user.address.slice(-10)}\n                  </p>\n                  }\n                </div>\n                <p>\n                  Joined <span>February 2022</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div className=\"collections-listing padding-wrapper\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12\">\n                <div className=\"explore-collection-section\">\n                  <div className=\"explore-collection-nav\">\n                    <div className=\"d-flex justify-content-center justify-content-md-end align-items-center\">\n                      {menuData.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleNftFilter(item);\n                              setMenuFilter(item);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img src={SearchIcon} alt=\"search-icon\" className=\"ms-3\" />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {priceoptions &&\n                      priceoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Chains={filterData.chains}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                <div className=\"row g-3\">\n                  {filterationLoader ? (\n                    <div className=\"text-center\">\n                      <div\n                        class=\"spinner-border text-secondary text-white \"\n                        role=\"status\"\n                      >\n                        <span class=\"sr-only\">Loading...</span>\n                      </div>\n                    </div>\n                  ) : nfts && nfts.length > 0 ? (\n                    nfts.map((listing) => {\n                      return (\n                        <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                          <ListingCards\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            // userProfile\n                          />\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-white text-center mt-5\">No NFTs Found</p>\n                  )}\n                </div>\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      props.profileNFTs.pagination > nfts.length &&\n                      nfts.length > 10 && (\n                        <button\n                          className=\"btn btn-linear-gradient px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state,\"state in userProfile\"),\n  {\n  profileNFTs: state.nft.profileNFTs,\n  profileNFTsStatus: state.nft.profileNFTsStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  individualUser:state.user.individualUser,\n  individualUserAuth:state.user.individualUserAuth,\n});\n\nexport default connect(mapStateToProps, {\n  getProfileNfts,\n  beforeNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  getUserById,\n  beforeUser\n})(UserProfile);\n\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/sell-nft/SellNFT.js",["1448","1449","1450","1451","1452","1453","1454","1455","1456","1457","1458","1459","1460","1461","1462","1463"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./SellNFT.css\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport PriceIcon from \"../../assets/images/priceIcon.svg\";\nimport DollarIcon from \"../../assets/images/dollarIcon.svg\";\nimport FeeIcon from \"../../assets/images/feeIcon.svg\";\nimport { ENV } from \"../../config/config\";\nimport DateRangePicker from \"react-bootstrap-daterangepicker\";\nimport moment from \"moment\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { useLocation } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFT, upsertNFT } from \"../nfts/nfts.action\";\n\nconst { currencies, dateRangeInitialSettings, serviceFee } = ENV;\nconst config1 = {\n  price: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  listingSchedule: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  reserveFor: \"\", // if user selects reserve buyer\n};\nconst config2 = {\n  method: 1, // 1 = Sell to the highest bidder or 2 = Sell with the declining price\n  startPrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n  duration: {\n    startDate: moment(),\n    endDate: moment().add(6, \"months\"),\n    startTime: moment(new Date()).format(\"HH:mm\"),\n    endTime: \"23:59\",\n  },\n  // if user includes reserve price\n  reservePrice: {\n    currency: ENV.currency,\n    amount: \"\",\n  },\n};\n\nconst SellNFT = (props) => {\n  const [activeBtn, setActiveBtn] = useState(0);\n  const [activeBidBtn, setActiveBidBtn] = useState(false);\n  const [sellingMethod, setSellingMethod] = useState(1); // 1 = Fixed Price, 2 = Timed Auction\n  const [fixedPriceConfig, setFixedPriceConfig] = useState(config1);\n  const [timedAuctionConfig, setTimedAuctionConfig] = useState(config2);\n  const [nft, setNft] = useState(null);\n  const [loader, setLoader] = useState(true); // NFT loader\n  const [reserveBuyer, setReserveBuyer] = useState(false);\n  const [reservePrice, setReservePrice] = useState(false);\n  const [tokensData, setTokensData] = useState([]);\n  const location = useLocation();\n  console.log(location, \"location\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    const { itemId } = props.match.params;\n    // if (itemId) props.getNFT(window.atob(itemId));\n    // else props.history.push(\"/explore-all\");\n    getTokens();\n  }, []);\n\n  // when NFT data is received\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const nft = props.nft.nftsData;\n      setNft(nft);\n      setLoader(false);\n      props.beforeNFT();\n    }\n  }, [props.nft.nftsAuth]);\n\n  // when NFT data is updated\n  useEffect(() => {\n    if (props.nft.upsertAuth) {\n      const { nft } = props.nft.nftsData;\n      // const pathname = nft.sellingMethod === 1 ? '/explore-all' : '/auctions'\n      const pathname = \"/\";\n      setLoader(false);\n      props.beforeNFT();\n      props.history.push(pathname);\n    }\n  }, [props.nft.upsertAuth]);\n\n  // when an error is received\n  useEffect(() => {\n    setLoader(false);\n  }, [props.error]);\n\n  const onChange = (e) => {\n    const { name, value } = e.target;\n\n    let data = null;\n\n    if (sellingMethod === 1) data = fixedPriceConfig;\n    else data = timedAuctionConfig;\n\n    const keys = name.split(\".\"); // fixedPriceConfig, price, currency\n\n    if (keys && keys[2]) {\n      data[keys[1]][keys[2]] = value;\n    } else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (sellingMethod === 1) setFixedPriceConfig({ ...data });\n    else setTimedAuctionConfig({ ...data });\n  };\n\n  const handleDateChange = (e, picker) => {\n    const { name } = e.target;\n    const { startDate, endDate } = picker;\n\n    // set start date\n    onChange({\n      target: {\n        name: `${name}.startDate`,\n        value: startDate,\n      },\n    });\n\n    // set end date\n    onChange({\n      target: {\n        name: `${name}.endDate`,\n        value: endDate,\n      },\n    });\n  };\n  const submit = () => {\n    let payload='';\n    console.log(sellingMethod,\"sellingMethod\")\n    if(sellingMethod===2){\n\n      payload = {\n       _id: location.state._id,\n       sellingMethod,\n       sellingConfig:JSON.stringify(timedAuctionConfig),\n     };\n   \n    }\n    else {\n      payload = {\n        _id: location.state._id,\n        sellingMethod, \n        sellingConfig:JSON.stringify(fixedPriceConfig),\n      };\n      // console.log(payload,\"payload\")\n      \n\n    }\n\n    //  return  \" \"\n\n    let test = new Date(timedAuctionConfig.duration.endDate).getTime();\n    let time = timedAuctionConfig.duration.endTime;\n\n    var r = Number(time.split(\":\")[0]) * 60 + Number(time.split(\":\")[1]) * 1000;\n    //\n    const timeInMiliSeconds = r + test;\n\n    // console.log('yoken data', tokensData)\n    // const nftToken=tokensData.data.find((item)=>item?.nftId===nft?._id)\n\n    //  if(nftToken){\n    //   sellingMethod==1?SellOnFixedPrice(nftToken?.nftToken,fixedPriceConfig.price.amount):openNFTForBidding(nftToken.nftToken,timeInMiliSeconds)\n\n    setLoader(true);\n\n    var formData = new FormData();\n    console.log(payload, \"payload\");\n    for (const key in payload) formData.append(key, payload[key]);\n\n    props.upsertNFT(\"edit\", formData, \"PUT\");\n    //  }\n    //  else {\n    //   toast.error(\"there was an issue while creating nft, please try later\")\n    //  }\n  };\n\n  const getTokens = () => {\n    const url = process.env.REACT_APP_BASE_URL + \"nftTokens/tokens\";\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        setTokensData(data);\n      })\n      .catch((error) => {\n        console.log(error, \"error in catch blcok\");\n      });\n  };\n  return (\n    <>\n      <NavbarMain />\n      <section className=\"padding-wrapper nft-detail\">\n        <div className=\"container\">\n          <div className=\"row g-3\">\n            <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n              <div className=\"row\">\n                <div className=\"col-12 order-2 order-md-1\">\n                  <div className=\"intro mb-5\">\n                    <div className=\"intro-content\">\n                      <span>SellNFTs</span>\n                      <h3 className=\"mb-0\">List of bundles for sale</h3>\n                    </div>\n                  </div>\n                  <div className=\"sale-btn-container mt-5 mb-4\">\n                    <button\n                      className={` ${\n                        activeBtn === 0\n                          ? \"sell-btn-active\"\n                          : \"sell-btn-not-active\"\n                      } me-3 `}\n                      onClick={() => {\n                        setActiveBtn(0);\n                        setSellingMethod(1);\n                      }}\n                    >\n                      <img\n                        src={DollarIcon}\n                        alt=\"fixedPrize\"\n                        className=\"me-1 me-sm-2\"\n                      />\n                      Fixed Prize\n                    </button>\n                    <button\n                      className={` ${\n                        activeBtn === 1\n                          ? \"sell-btn-active\"\n                          : \"sell-btn-not-active\"\n                      } `}\n                      onClick={() => {\n                        setActiveBtn(1);\n                        setSellingMethod(2);\n                      }}\n                    >\n                      <img src={ClockIcon} alt=\"timeAuction\" className=\"me-2\" />\n                      Timed Auction\n                    </button>\n                  </div>\n                  <div className=\"nftDetail-accordion\">\n                    <div\n                      className=\"accordion accordion-flush \"\n                      id=\"accordionFlushExample\"\n                    >\n                      {activeBtn === 0 ? (\n                        <>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseOne\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingOne\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-price-container mx-auto\">\n                                  <div className=\"sell-price-inp d-flex align-items-center\">\n                                    <div className=\"sell-price-currency text-center\">\n                                      <span> ETH </span>\n                                    </div>\n                                    <input\n                                      type=\"text\"\n                                      name=\"fixedPriceConfig.price.amount\"\n                                      placeholder=\"Amount\"\n                                      style={{\n                                        borderRadius: \"4px\",\n                                      }}\n                                      onChange={(e) => onChange(e)}\n                                      onKeyDown={(e) =>\n                                        decimalNumberValidator(e)\n                                      }\n                                      defaultValue={\n                                        fixedPriceConfig.price.amount\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingTwo\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseTwo\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseTwo\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Schedule Listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseTwo\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingTwo\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"fixedPriceConfig.listingSchedule\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"fixedPriceConfig.listingSchedule.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </>\n                      ) : (\n                        <>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Bid option\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-bid-opt-container mx-auto\">\n                                  <button\n                                    className={`${\n                                      activeBidBtn ? \"sell-bid-active\" : \"\"\n                                    } sell-bid-opt-btn`}\n                                    onClick={() =>\n                                      setActiveBidBtn(!activeBidBtn)\n                                    }\n                                  >\n                                    Sell To The Highest Bidder\n                                  </button>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingFour\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseFour\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseFour\"\n                              >\n                                <img\n                                  src={PriceIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseFour\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingFour\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-price-container mx-auto\">\n                                  <div className=\"sell-price-inp d-flex align-items-center\">\n                                    <div className=\"sell-price-currency text-center\">\n                                      <span> ETH </span>\n                                    </div>\n                                    <input\n                                      type=\"text\"\n                                      name=\"timedAuctionConfig.startPrice.amount\"\n                                      placeholder=\"Amount\"\n                                      style={{\n                                        borderRadius: \"4px\",\n                                      }}\n                                      onChange={(e) => onChange(e)}\n                                      onKeyDown={(e) =>\n                                        decimalNumberValidator(e)\n                                      }\n                                      defaultValue={\n                                        fixedPriceConfig.price.amount\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSix\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSix\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSix\"\n                              >\n                                <img\n                                  src={ClockIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Duration\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSix\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSix\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"sell-date-picker mx-auto\">\n                                  <DateRangePicker\n                                    initialSettings={dateRangeInitialSettings}\n                                    onApply={handleDateChange}\n                                  >\n                                    <button\n                                      name=\"timedAuctionConfig.duration\"\n                                      className=\"calender-btn\"\n                                    >\n                                      {fixedPriceConfig.listingSchedule.startDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}{\" \"}\n                                      -{\" \"}\n                                      {fixedPriceConfig.listingSchedule.endDate.format(\n                                        \"MMMM D, YYYY\"\n                                      )}\n                                      &nbsp;&nbsp;&nbsp;\n                                      <i className=\"fas fa-calendar-week\" />\n                                    </button>\n                                  </DateRangePicker>\n                                </div>\n                                <div className=\"sell-time-container\">\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"timedAuctionConfig.duration.startTime\"\n                                      placeholder=\"Start Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule\n                                          .startTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n\n                                  <div className=\"sell-time-inp mx-auto my-3\">\n                                    <input\n                                      type=\"time\"\n                                      name=\"timedAuctionConfig.duration.endTime\"\n                                      placeholder=\"End Time\"\n                                      className=\"py-1\"\n                                      onChange={(e) => onChange(e)}\n                                      defaultValue={\n                                        fixedPriceConfig.listingSchedule.endTime\n                                      }\n                                      required\n                                    />\n                                  </div>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"row\">\n                    <div className=\"col-10 col-sm-6 col-md-8 col-lg-6  col-xl-4\">\n                      <div className=\"sell-fee-container\">\n                        <div className=\"sell-fee-title d-flex align-items-center mb-2\">\n                          <img src={FeeIcon} alt=\"feeIcon\" className=\"me-2\" />\n                          <h6>Fees</h6>\n                        </div>\n                        <div className=\"sell-fee-content d-flex align-items-center justify-content-between mb-1\">\n                          <p>Service Fee</p>\n                          <p>2.5 %</p>\n                        </div>\n                        <div className=\"sell-fee-content d-flex align-items-center justify-content-between\">\n                          <p>Creator Royalty</p>\n                          <p>3 %</p>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-12 text-center mt-5\">\n                      <button\n                        className=\"sell-btn-active px-5\"\n                        onClick={() => submit()}\n                      >\n                        {\" \"}\n                        Complete Listing{\" \"}\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n              <Card className=\"auction-card detail-card\">\n                <div className=\"auction-img-wrapper\">\n                  <Card.Img\n                    variant=\"top\"\n                    src={location.state.image}\n                    alt=\"AuctionTopImg\"\n                  />\n                </div>\n                <Card.Body>\n                  <div>\n                    <span>Current price</span>\n                    <h3>\n                      {location.state.currentPrice}\n                      <span>($2.28)</span>\n                    </h3>\n                  </div>\n                  <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                    <div className=\"d-flex align-items-center\">\n                      <img src={ClockIcon} alt=\"clock-icon\" className=\"me-1\" />\n                      <span>Sale ends March 8, 2022 at 7:40am PKT </span>\n                    </div>\n                    <div className=\"likes-container d-flex align-items-center\">\n                      <span>{}</span>\n                      <img src={HeartIcon} alt=\"heart-icon\" className=\"ms-1\" />\n                    </div>\n                  </div>\n                </Card.Body>\n              </Card>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFT,\n  upsertNFT,\n})(SellNFT);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/owncollection/OwnCollection.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/navbar-main/NavbarMain.js",["1464","1465","1466","1467"],"import React from \"react\";\nimport { Link, useHistory, useLocation } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const history = useHistory();\n  const location = useLocation();\n\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n    console.log(\"clicked\");\n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"dark\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <Navbar.Brand to=\"/\" href=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </Navbar.Brand>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className=\"mx-xl-auto\" defaultActiveKey={`${location.pathname}`}>\n              <Nav.Link to=\"/\" href=\"/\" className=\"nav-main-link\" >\n                Home\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                activeKey={1}\n                className={`nav-main-link dropdown-bg `}\n               \n              >\n                <NavDropdown.Item\n                  to=\"/explore/exploreAll\"\n                  href=\"/explore/exploreAll\"\n                  eventKey={1}\n                  className=\"nav-main-link main-nav-dd-items \"\n                >\n                  Explore All\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/explore/allNFT\"\n                  href=\"/explore/allNFT\"\n                  className=\"nav-main-link main-nav-dd-items\"\n                  eventKey={2}\n                >\n                  All NFT\n                </NavDropdown.Item>\n           \n              </NavDropdown>\n\n            \n              <Nav.Link to=\"/create\" href=\"/create\" className=\"nav-main-link\">\n                Create\n              </Nav.Link>\n              <Nav.Link\n                to=\"/userprofile\"\n                href=\"/userprofile\"\n                className=\"nav-main-link\"\n              >\n                Profile\n              </Nav.Link>\n           \n\n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div class=\"search-box mt-1 mt-sm-0 d-sm-none\">\n                <input\n                  class=\"search-txt \"\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                />\n                <a class=\"search-btn\" href=\"#\">\n                  <img src={SearchIcon} alt=\"search-icon\" />\n                </a>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div class=\"search-box \">\n              <input\n                class=\"search-txt\"\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n              />\n              <a class=\"search-btn me-1 mt-1\" href=\"#\">\n                <img src={SearchIcon} alt=\"search-icon\" />\n              </a>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/buy-sell/Buysell.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/auctions-cards/AuctionsCards.js",["1468","1469","1470","1471","1472"],"import React, { useEffect, useState } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.svg\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../config/config\";\n\nimport { connect } from \"react-redux\";\n\nimport \"./AuctionsCard.css\";\nimport { propTypes } from \"react-recaptcha\";\n\nconst AuctionsCards = (props) => {\n  const { countDownRenderer } = ENV;\n  const history = useHistory();\n  // console.log(auctions,\"auctions123\")\n  return (\n    <Card\n      className=\"auction-card mx-2\"\n      onClick={() => history.push(`nftdetail/${props.id}`)}\n    >\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={props.image} alt=\"AuctionTopImg\" />\n        <div className=\"auction-countdown mb-3\">\n          <Countdown date={props.endDate} renderer={countDownRenderer} />\n        </div>\n      </div>\n      <Card.Body>\n        <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n          <div className=\"auction-card-avatar d-flex align-items-center\">\n            <img src={AvatarImg} alt=\"AvatarImg\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <span className=\"ms-4\">9+ Place Bit</span>\n          </div>\n\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <Card.Title>{props.name}</Card.Title>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>\n              {\"Owned by \"}\n              {props.ownerName}\n            </p>\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state in nfts\"),\n  ({});\n\nexport default connect(mapStateToProps, {})(AuctionsCards);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections-cards/CollectionsCard.js",["1473","1474","1475","1476","1477","1478","1479"],"import React, { useEffect } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport Subimg1 from \"../../assets/images/cl-cr-subimg1.png\";\nimport Subimg2 from \"../../assets/images/cl-cr-subimg2.png\";\nimport Subimg3 from \"../../assets/images/cl-cr-subimg3.png\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport \"./CollectionsCard.css\";\n\nconst CollectionsCard = ({\n  CardImg,\n  Subimg1,\n  Subimg2,\n  Subimg3,\n  name,\n  id,\n  collection,\n  userName,\n  NFTCount,\n  profileImage,\n}) => {\n  // const { name, image } = category;\n  const history = useHistory();\n\n  return (\n    <Card\n      className=\"collection-cards-container\"\n      onClick={() => {\n        history.push({\n          pathname: `/collection/detailPage/${id}`,\n          state: collection,\n        });\n      }}\n    >\n      <div className=\"row\">\n        <div className=\"col-12\">\n          <div className=\"row g-3\">\n            <div className=\"col-4 collection-subImg1\">\n              <img src={Subimg1} alt=\"subImg\" />\n            </div>\n            <div className=\"col-4 collection-subImg2\">\n              <img src={Subimg2} alt=\"subImg\" />\n            </div>\n            <div className=\"col-4 collection-subImg3\">\n              <img src={Subimg3} alt=\"subImg\" />\n            </div>\n            <div className=\"col-12 collection-mainImg\">\n              <img src={CardImg} alt=\"card-img\" />\n            </div>\n          </div>\n          <Card.Body>\n            <Card.Title>{name}</Card.Title>\n            <Card.Text>\n              {NFTCount}\n              {\" items\"}\n            </Card.Text>\n            <div className=\"d-flex align-items-center justify-content-between collection-card-footer\">\n              <div className=\"collection-footer-left d-flex align-items-center\">\n                {profileImage && (\n                  <img src={profileImage} alt=\"avatar-img\" className=\"me-2\" />\n                )}\n                <span>{userName}</span>\n              </div>\n              {/* <div className=\"collection-footer-right d-flex align-items-center\">\n                <img src={HeartIcon} alt=\"like-icon\" className=\"me-1\" onClick={()=>handleLikesTogle(id)} />\n                <span>212k</span>\n              </div> */}\n            </div>\n          </Card.Body>\n        </div>\n      </div>\n    </Card>\n  );\n};\n\nexport default CollectionsCard;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/card-slider/CardSlider.js",["1480","1481","1482","1483","1484","1485"],"import React, { Component } from \"react\";\nimport Slider from \"react-slick\";\n// import CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport SliderNextIcon from \"../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport \"./CardSlider.css\";\nimport TwitchPlayer from \"react-player/twitch\";\nimport { data } from \"jquery\";\n\nexport default class CardSlider extends Component {\n  // const CardSlider = () => {\n  constructor(props) {\n    super(props);\n    this.next = this.next.bind(this);\n    this.previous = this.previous.bind(this);\n  }\n  next() {\n    this.slider.slickNext();\n  }\n  previous() {\n    this.slider.slickPrev();\n  }\n\n  handleArrows = () => {\n    const { data, homeAuctions } = this.props;\n    if (data && data.length > 0) {\n      if (homeAuctions && data.length > 4) {\n        return true;\n      } else if (!homeAuctions && data.length > 3) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n  render() {\n    const { settings, data, homeAuction } = this.props;\n    console.log(homeAuction, \"homeAuction\");\n\n    return (\n      <div className=\"container\">\n        {this.handleArrows() && (\n          <div className=\"text-end\">\n            <button\n              className=\"card-slider-btn mb-4 me-3\"\n              onClick={this.previous}\n            >\n              {/* <img src={SliderPrevIcon} alt=\"SliderPrevButton\" /> */}\n              <i class=\"fas fa-arrow-left\"></i>\n            </button>\n            <button className=\"card-slider-btn mb-4\" onClick={this.next}>\n              {/* <img src={SliderNextIcon} alt=\"SliderNextButton\" /> */}\n              <i class=\"fas fa-arrow-right\"></i>\n            </button>\n          </div>\n        )}\n        <Slider ref={(c) => (this.slider = c)} {...settings}>\n          {this.props.children}\n        </Slider>\n      </div>\n    );\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero/component/slider.js",["1486","1487","1488","1489","1490"],"import \"./slider.css\";\nimport { useState } from \"react\";\nimport HeroCards from \"../../hero-cards/HeroCards\";\nimport SliderNextIcon from \"../../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../../auctions-cards/AuctionsCards\";\nimport { map } from \"jquery\";\n\nconst Slider = ({\n  setHandler,\n  sliderRadioButtons,\n  handleRadioInputs,\n  sliderChecked,\n}) => {\n  return (\n    <section id=\"slider\">\n      {sliderRadioButtons.map((item) => {\n        return (\n          <input\n            type=\"radio\"\n            name=\"slider\"\n            value={item.value}\n            checked={sliderChecked === item.value}\n            onChange={(e) => handleRadioInputs(e)}\n            id={item.id}\n          />\n        );\n      })}\n      <label for=\"s1\" id=\"slide1\" onClick={() => setHandler(1)}>\n        <HeroCards className=\"slide\" />\n        {/* <img\n          src=\"https://i.pinimg.com/originals/2b/de/de/2bdede0647e3cdf75b44ea33723201d9.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s2\" id=\"slide2\" onClick={() => setHandler(2)}>\n        <HeroCards className=\"slide\" />\n        {/* <AuctionsCards className=\"slide\" /> */}\n        {/* <img\n          src=\"https://images6.alphacoders.com/462/thumb-1920-462371.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s3\" id=\"slide3\" onClick={() => setHandler(3)}>\n        <HeroCards className=\"slide\" />\n        {/* <img src=\"https://wallpaperaccess.com/full/1154341.jpg\" alt=\"\" /> */}\n      </label>\n      <label for=\"s4\" id=\"slide4\" onClick={() => setHandler(4)}>\n        {/* <AuctionsCards className=\"slide\" /> */}\n        {/* <img src=\"https://wallpapercave.com/wp/wp2634222.jpg\" alt=\"\" /> */}\n        <HeroCards className=\"slide\" />\n      </label>\n      <label for=\"s5\" id=\"slide5\" onClick={() => setHandler(5)}>\n        <HeroCards className=\"slide\" />\n        {/* <img\n          src=\"https://images5.alphacoders.com/343/thumb-1920-343645.jpg\"\n          alt=\"\"\n        /> */}\n      </label>\n      <label for=\"s6\" id=\"slide6\" onClick={() => setHandler(6)}>\n        <HeroCards className=\"slide\" />\n      </label>\n      <label for=\"s7\" id=\"slide7\" onClick={() => setHandler(7)}>\n        {/* <AuctionsCards className=\"slide\" /> */}\n        <HeroCards className=\"slide\" />\n      </label>\n    </section>\n  );\n};\n\nexport default Slider;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/components/upload.js",["1491","1492","1493"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport { IoMdCloudUpload } from \"react-icons/io\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData\n}) => {\n  return (\n    <label\n      className=\"w-100\"\n      onDrop={(e) => onDrop(e)}\n      onDragOver={(e) => dragOver(e)}\n      onDragEnter={(e) => dragEnter(e)}\n      onDragLeave={(e) => dragLeave(e)}\n    >\n      <div className=\"upload-image-border p-4 position-relative\">\n        {imageURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" onClick={()=>clearData()} />\n            <img className=\"upload-image\" src={imageURL} alt=\"upload-image\" />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            {/* <IoMdCloudUpload className=\"img-upload-icon\"/> */}\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : videoURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <VideoComponent\n              videoUrl={videoURL}\n              videoStyles={videoStyles}\n              videoWidth=\"300\"\n            />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n          </div>\n        ) : audioSrc ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <AudioPlayer audioSrc={audioSrc} />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : (\n          <>\n            {\" \"}\n            <img\n              className=\"upload-image\"\n              src={Images.uploadImage}\n              alt=\"upload-image\"\n            />\n            <div className=\"upload-details text-center mt-2\">\n              <p>Drag and drop your file</p>\n              <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n            </div>\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={(e) => onFileChange(e, \"onChange\")}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </>\n        )}\n      </div>\n    </label>\n  );\n};\n\nexport default Upload;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore.action.js",["1494"],"\nimport { ENV } from './../../config/config';\nimport axios from 'axios'\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n        console.log(response);\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero-cards/HeroCards.js",["1495"],"import React from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.png\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport \"./HeroCards.css\";\n\nconst HeroCards = () => {\n  return (\n    <Card className=\"auction-card hero-card mx-2\">\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n        {/* <div className=\"auction-countdown mb-3\">\n          <Countdown date=\"2022/1/26 13:10:12\" renderer={countDownRenderer} />\n        </div> */}\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title>Music</Card.Title>\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <div className=\"auction-card-avatar d-flex align-items-center mb-4\">\n          <img src={AvatarImg} alt=\"AvatarImg\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <span className=\"ms-4\">9+ People Place Bit</span>\n        </div>\n\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owend by Jecica</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default HeroCards;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/filter-component/FilterComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/listing-cards/ListingCards.js",["1496","1497"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile &&\n          <div className=\"options-icon like-icon text-white\">\n          \n            { validateIfLiked(likedNfts, id) ? (\n              <div className=\"heart-filled-container d-flex align-items-end\">\n                <AiFillHeart\n                  className=\"heart-fill-icon \"\n                  onClick={() => {\n                    handleLikesTogleApi(id, \"dislike\");\n                    setToggle(!toggle);\n                  }}\n                />{\" \"}\n                <p> {likesCount ? likesCount : 0} </p>\n              </div>\n            ) : (\n              <img\n                src={HeartIcon}\n                alt=\"OptionsIcon\"\n                onClick={() => {\n                  handleLikesTogleApi(id, \"like\");\n                  setToggle(!toggle);\n                }}\n              />\n            )}\n          </div>\n          }\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"   onClick={() => history.push(`/nftdetail/${id}`)}>\n          <p>{ownerId===ENV.getUserKeys(\"_id\")._id?\"View\":\"Buy Now\"}</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/index.js",[],["1498","1499"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/App.js",["1500"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\n\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\n// import 'swiper/swiper-bundle.css';\n\nconst App = () => {\n\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  useEffect(() => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={true}\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n};\n\nexport default App;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/routes.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/index.js",["1501"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",["1502"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.reducer.js",["1503","1504"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.js",["1505","1506","1507","1508","1509","1510","1511","1512"],"import React, { useEffect } from \"react\";\nimport { Table, Pagination } from \"react-bootstrap\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller2\";\nimport Collections from \"../collections/popular-collections\";\nimport MyCollections from \"../collections/my-collections\";\nimport Explore from \"../explore/explore-home\";\nimport Work from \"../work/work\";\nimport Authors from \"../authors/authors\";\nimport Header from \"../header/header\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n      {/* <Header /> */}\n      <NavbarMain />\n      <Hero />\n     \n      <Auctions />\n      {/* <AuctionsCards /> */}\n      <Work />\n      <TopSeller viewAll={\"View All\"} />\n      {/* <Collections /> */}\n      <PopularCollections />\n      {/* <CardSlider /> */}\n      {/* <Authors /> */}\n      {/* <MyCollections /> */}\n      {/* <Explore /> */}\n      <OwnCollection />\n      <Buysell />\n      <Footer />\n    </>\n  );\n}\n\nexport default Home;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["1513"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore-all.js",["1514","1515","1516","1517","1518","1519","1520","1521","1522"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFTs } from \"../nfts/nfts.action\";\nimport { ENV } from \"../../config/config\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport ExploreItems from \"./explore-items\";\nimport NftCard from \"../collections/components/NftCard/NftCard\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { getCreators, beforeUser } from \"./../user/user.action\";\n\nconst initData = {\n  pre_heading: \"Explore\",\n  heading: \"Exclusive Digital Assets\",\n  content: \"\",\n  btn_1: \"Load More\",\n};\n\nfunction ExploreAll(props) {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const pathname = useHistory().location.pathname;\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (pathname === \"/explore-all\") setIntro(true);\n    getNFTs();\n    props.getCreators();\n  }, []);\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      setCreator(props.user.sellers);\n    }\n  }, [props.user.topSellersAuth]);\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      setCreator(props.user.creators);\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nftsData } = props.nft;\n      if (nftsData) {\n        setNFTs(nftsData);\n        setNFTPagination(nftsData.pagination);\n        props.beforeNFT();\n        if (props.setLoader) props.setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  const loadMore = () => {\n    const { page, limit } = nftPagination;\n    setLoader(true);\n    getNFTs(1, limit * (page + 1));\n  };\n\n  const getNFTs = (page = 1, limit = 4) => {\n    const nftQS = { page, limit, explore: true };\n\n    if (props.collectionId) nftQS.collectionId = props.collectionId;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    props.getNFTs(qs);\n  };\n\n  return (\n    <section\n      className=\"explore-area\"\n      style={{ paddingTop: `${intro ? \"150\" : \"30\"}px` }}\n    >\n      {loader && <FullPageLoader />}\n      <div className=\"container\">\n        {intro && (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              <div className=\"intro text-center mb-4\">\n                <span>{initData.pre_heading}</span>\n                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n              </div>\n            </div>\n          </div>\n        )}\n        <div className=\"row items gx-4 explore-items\">\n          {nfts && nfts.length > 0 && creators.length > 0 ? (\n            nfts.map((item, idx) => {\n              return (\n                <div className=\"col-3 mt-5\" style={{}}>\n                  <NftCard\n                    nft={item}\n                    creators={creators}\n                    userId={ENV.getUserKeys(\"_id\")._id}\n                  />\n                </div>\n              );\n            })\n          ) : (\n            <p className=\"text-center\">No Items Found to Exploree</p>\n          )}\n        </div>\n        {loadMoreBtn && (\n          <div className=\"row\">\n            <div className=\"col-12 text-center\">\n              <a\n                id=\"load-btn\"\n                className=\"btn btn-bordered-white mt-5\"\n                onClick={() => loadMore()}\n              >\n                {initData.btn_1}\n              </a>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs, getCreators })(\n  ExploreAll\n);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["1523"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/item-detail/item-detail.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/live-auctions-list.js",["1524","1525","1526","1527","1528","1529","1530","1531","1532"],["1533","1534"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/blog/blog.js",["1535","1536"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/activity/activity.js",["1537"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/blog-single/blog-single.js",["1538","1539"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/help-center/help-center.js",["1540"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/author/author.js",["1541","1542","1543","1544","1545","1546","1547","1548"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["1549","1550","1551","1552"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"music\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Collections\"} title2={\"PopularCollections\"} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Most Popular</span>\n                    <h3 className=\"mb-0\">Popular Collections</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-lg-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={collection.banner}\n                        Subimg1={collection.logo}\n                        Subimg2={collection.featuredImg}\n                        Subimg3={collection.banner}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.user[0]?.username\n                            ? collection?.user[0]?.username\n                            : \"\"\n                        }\n                        NFTCount={collection.NFTCount}\n                        // handleLikesTogle={handleLikesTogleApi}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    collections?.length > 10 &&\n                    pagination.totalRecords <= collections.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/create-nft-reducer.js",["1553"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/my-collections.js",["1554","1555"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/profile/profile.js",["1556","1557","1558","1559","1560"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collection-details.js",["1561","1562","1563","1564","1565","1566","1567","1568","1569","1570","1571","1572","1573","1574","1575","1576","1577","1578","1579"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.reducer.js",["1580"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["1581"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/signup/signup.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-collection/create-collection.js",["1582","1583"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { getUser } from \"../user/user.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport $ from \"jquery\";\nimport { ENV } from \"../../config/config\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { toast } from \"react-toastify\";\nimport \"./create-collection.css\";\nimport { Images } from \"../../assets/assets.js\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nclass CreateCollection extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        description: \"\",\n      },\n      categories: null,\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate() {\n    if (this.props.error) {\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      this.setState({ categories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n    console.log(collection, \"collection input\");\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n  render() {\n    const { collection, errors, loader, isSubmitted, categories } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      return (\n        <div>\n          <NavbarMain />\n          <Breadcrumb title1={\"Collections\"} title2={\"CreateCollection\"} />\n          <section className=\"author-area padding-form-wrapper\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row justify-content-between\">\n                <div className=\"col-12 col-md-12\">\n                  <div className=\"mt-5 mt-lg-0 mb-4 mb-lg-5\">\n                    <div className=\"intro\">\n                      <div className=\"intro-content\">\n                        <span>Get Started</span>\n                        <h3 className=\"mb-0\">Create Collection</h3>\n                      </div>\n                    </div>\n                    {isSubmitted && errors && (\n                      <div className=\"row\">\n                        <div className=\"col-12\">\n                          <span\n                            id=\"create-collection-err\"\n                            className=\"text-danger\"\n                          >\n                            {errors}\n                          </span>\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                  <form\n                    id=\"create-collection\"\n                    className=\"item-form card no-hover\"\n                  >\n                    <div className=\"row\">\n                      <div className=\"col-12\">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"logo\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"logo\"\n                            />\n                            <label\n                              id=\"collection-logo-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"logo\"\n                            >\n                              Choose Logo*\n                            </label>\n                          </div>\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"logo\",\n                              collection.logo,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-3\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border \">\n                          <div className=\"image-over \">\n                            <img\n                              id=\"logo-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.logoUrl\n                                  ? collection.logoUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"featuredImg\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"featuredImg\"\n                            />\n                            <label\n                              id=\"collection-featuredImg-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"featuredImg\"\n                            >\n                              {\" \"}\n                              Choose Featured Image\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-4\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border\">\n                          <div className=\"image-over\">\n                            <img\n                              id=\"featuredImg-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.featuredImgUrl\n                                  ? collection.featuredImgUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 \">\n                        <div className=\"input-group form-group\">\n                          <div className=\"custom-file\">\n                            <input\n                              type=\"file\"\n                              className=\"custom-file-input\"\n                              id=\"banner\"\n                              accept=\".png,.jpeg,.jpg\"\n                              onChange={(e) => this.onFileChange(e)}\n                              name=\"banner\"\n                            />\n                            <label\n                              id=\"collection-banner-label\"\n                              className=\"custom-file-label\"\n                              htmlFor=\"banner\"\n                            >\n                              Choose Banner\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12 col-md-8\">\n                        <div className=\"card no-hover text-center my-2 bg-transparent upload-image-border\">\n                          <div className=\"image-over\">\n                            <img\n                              id=\"banner-placeholder\"\n                              className=\"card-img-top create-collection-placeholder\"\n                              src={\n                                collection.bannerUrl\n                                  ? collection.bannerUrl\n                                  : Images.uploadImage\n                              }\n                              alt=\"\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-6\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control\"\n                            name=\"name\"\n                            placeholder=\"Name *\"\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.name}\n                            maxLength=\"55\"\n                            autoComplete=\"off\"\n                          />\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"name\",\n                              collection.name,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-6\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control\"\n                            name=\"url\"\n                            placeholder=\"URL\"\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.url}\n                            maxLength=\"70\"\n                            autoComplete=\"off\"\n                          />\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"url\",\n                              collection.url,\n                              \"url\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group\">\n                          <select\n                            className=\"form-control p-0\"\n                            id=\"category\"\n                            name=\"categoryId\"\n                            onChange={(e) => this.onChange(e)}\n                          >\n                            <option value=\"\">Select Category</option>\n                            {categories &&\n                              categories.map((category, index) => {\n                                return (\n                                  <option key={index} value={category._id}>\n                                    {category.name}\n                                  </option>\n                                );\n                              })}\n                          </select>\n                          <span className=\"text-danger\">\n                            {this.validator.message(\n                              \"category\",\n                              collection.categoryId,\n                              \"required\"\n                            )}\n                          </span>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group\">\n                          <textarea\n                            className=\"form-control create-collection-textarea\"\n                            name=\"description\"\n                            placeholder=\"Description\"\n                            cols={30}\n                            rows={3}\n                            onChange={(e) => this.onChange(e)}\n                            defaultValue={collection.description}\n                            maxLength=\"230\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"text-center\">\n                          <button\n                            disabled={loader}\n                            className=\"create-collection-btn mx-auto mt-3 mt-sm-4\"\n                            type=\"button\"\n                            onClick={(e) => this.submit(e)}\n                          >\n                            Create Collection\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </form>\n                </div>\n              </div>\n            </div>\n          </section>\n          <Footer />\n        </div>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollection);\n",["1584","1585"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contact/contact.reducer.js",["1586"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contact/contact.js",["1587"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["1588","1589","1590","1591","1592","1593","1594","1595","1596","1597","1598","1599","1600","1601","1602"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/sell-nft.js",["1603","1604","1605","1606","1607","1608","1609","1610","1611","1612","1613","1614","1615","1616"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["1617"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/how-it-works/how-it-works.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/privacy-&-terms/privacy-&-terms.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/create-nft.js",["1618","1619","1620"],"import React, { Component } from \"react\";\nimport { connect } from \"react-redux\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n} from \"./../../utils/functions\";\nimport { toast } from \"react-toastify\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport {\n  beforeCollection,\n  getCollections,\n  myCollections,\n} from \"../collections/collections.actions\";\nimport { setNftToken, createNFT } from \"../nfts/nfts.action\";\nimport { getCurrentAddress, mintNFt } from \"../../utils/web3\";\nimport { RiArrowDropDownLine } from \"react\";\nimport \"./createNft.css\";\nimport { Images } from \"../../assets/assets.js\";\nimport Upload from \"./components/upload\";\nimport Footer from \"../footer/footer\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst placeholderImg = \"\";\nclass CreateNFT extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      nft: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        ownerId: ENV.getUserKeys(\"_id\")._id,\n        creatorId: ENV.getUserKeys(\"_id\")._id,\n        image: \"\",\n        name: \"\",\n        description: \"\",\n        currentPrice: \"\",\n        royalty: \"\",\n        size: \"\",\n        copies: \"\",\n        collectionId: \"\",\n        ownerAddress: \"\",\n        categoryId: \"\",\n        status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n      },\n      imageURL: \"\",\n      videoURL: \"\",\n      collections: [],\n      allcollections: null,\n      error: false,\n      errorMessage: \"\",\n      audioUrl: \"\",\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount = async () => {\n    window.scroll(0, 0);\n\n    this.props.myCollections(ENV.getUserKeys(\"_id\")._id);\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      this.props.history.push(\"/login\");\n    }\n\n    let ownerAddress = await getCurrentAddress();\n\n    let { nft } = this.state;\n    nft = { ...nft, ownerAddress: ownerAddress };\n    this.setState({\n      nft,\n    });\n  };\n\n  componentDidUpdate(prevProps) {\n    if (\n      this.props.collection.myCollectionsResult &&\n      prevProps.collection.myCollectionsResult !==\n        this.props.collection.myCollectionsResult\n    ) {\n      const collections =\n        this.props.collection.myCollections.collections.Collections;\n\n      this.props.beforeCollection();\n\n      if (!collections.length) {\n        toast.info(\"Please add a collection first\");\n        return this.props.history.push(\"/collection/create\");\n      } else {\n        this.setState({\n          collections: collections,\n          loader: false,\n        });\n      }\n    }\n  }\n\n  onChange(e, status = null) {\n    let { name, value } = e.target;\n\n    // if status is provided\n    if (status) value = status;\n    let category = this.state.collections.find(\n      (item) => item._id === value\n    )?.categoryId;\n\n    let { nft } = this.state;\n    nft = { ...nft, [name]: value, categoryId: category };\n    this.setState({ nft });\n  }\n\n  reset = () => {\n    const nft = {\n      userId: ENV.getUserKeys(\"_id\")._id,\n      ownerId: ENV.getUserKeys(\"_id\")._id,\n      image: \"\",\n      name: \"\",\n      description: \"\",\n      currentPrice: \"\",\n      royalty: \"\",\n      size: \"\",\n      copies: \"\",\n      collectionId: \"\",\n      ownerAddress: this.state.ownerAddress,\n      status: 1, // 1 = put on sale, 2 = instant sale price, 3 = unlock purchased\n    };\n    this.setState({ nft });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n\n    const { nft, videoURL, audioUrl } = this.state;\n    console.log(nft, \"nft=>\");\n    let nftInfo = nft;\n    if (videoURL) {\n      nftInfo.fileType = \"video\";\n    } else if (audioUrl !== \"\") {\n      nftInfo.fileType = \"audio\";\n    } else {\n      nftInfo.fileType = \"image\";\n    }\n\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() && nft.collectionId ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              var formData = new FormData();\n              for (const key in nftInfo)\n                if (nftInfo[key]) formData.append(key, nftInfo[key]);\n\n              const res = await axiosPostFormData(\n                \"nfts/create\",\n                formData,\n                true\n              );\n\n              console.log(res, \"nft crate\");\n\n              if (res.success) {\n                // this.reset();\n                // toast.success(`Success! ${res.message}`)\n\n                if (res.nft && res.nft.metaData) {\n                  try {\n                    let createNftResult = await mintNFt(\n                      res.nft.metaData,\n                      res.nft._id,\n                      this.state.nft.copies,\n                      \n                      2\n                    );\n\n                    console.log(createNftResult, \"createNftResult\");\n                    if (createNftResult.events.TransferSingle.returnValues.id) {\n                      let data = {\n                        nftToken:\n                          createNftResult.events.TransferSingle.returnValues.id,\n                        data: this.state.nft,\n                        image: res.nft.image,\n                      };\n                      console.log(data, \"data==>\");\n                      this.props.setNftToken(data);\n\n                      this.props.history.push(\"/explore/allNFT\");\n                    }\n                  } catch (err) {\n                    console.log(err, \"here\");\n                    toast.error(err);\n                    this.setState({ loader: false });\n                  }\n                }\n              } else this.setState({ errors: res.message, loader: false });\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-nft\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n\n  onFileChange = (e, status) => {\n    if (this.handleFilesValidation(e, status) === \"file matched\") {\n      let file = \"\";\n      let url = \"\";\n      let fileId = \"\";\n      if (status === \"onDrag\") {\n        file = e.dataTransfer.files[0];\n        url = URL.createObjectURL(e.dataTransfer.files[0]);\n        fileId = e.dataTransfer.id;\n      } else {\n        file = e.target.files[0];\n        url = URL.createObjectURL(e.target.files[0]);\n        fileId = e.target.id;\n      }\n      if (file)\n        if (file.type.includes(\"image\")) {\n          let { nft } = this.state;\n          nft = { ...nft, [e.target.name]: file };\n\n          this.setState(\n            {\n              nft,\n              imageURL: url,\n              videoURL: \"\",\n              error: false,\n              errorMessage: \"\",\n            },\n            () => {\n              if (file) {\n                var reader = new FileReader();\n\n                reader.onload = function (e) {\n                  $(`#nft-${fileId}`).attr(\"src\", e.target.result);\n                  $(\"#nft-image-label\").html(\"File selected\");\n                };\n                reader.readAsDataURL(file);\n              }\n            }\n          );\n        } else if (file.type.includes(\"video\")) {\n          let { nft } = this.state;\n          nft = { ...nft, image: file };\n          console.log(nft, \"nft setting to the state\");\n          this.setState({\n            nft,\n            videoURL: url,\n            // image:file,\n            imageURL: \"\",\n            error: false,\n            errorMessage: \"\",\n          });\n        } else if (file.type.includes(\"audio\")) {\n          let { nft } = this.state;\n          nft = { ...nft, audioUrl: file, image: file };\n\n          this.setState({\n            nft,\n            videoURL: \"\",\n            imageURL: \"\",\n            // image:file,\n            error: false,\n            errorMessage: \"\",\n            audioUrl: url,\n          });\n        } else {\n          $(`#nft-${fileId}`).attr(\"src\", placeholderImg);\n          file = {};\n        }\n    } else {\n      let message = this.handleFilesValidation(e, status);\n      this.setState({\n        error: true,\n        errorMessage: message,\n      });\n    }\n  };\n  dragOver = (e) => {\n    e.preventDefault();\n  };\n\n  dragEnter = (e) => {\n    e.preventDefault();\n  };\n\n  dragLeave = (e) => {\n    e.preventDefault();\n  };\n  onDrop = (e) => {\n    e.nativeEvent.preventDefault();\n    if (!e) return;\n\n    this.onFileChange(e, \"onDrag\");\n  };\n\n  handleFilesValidation = (e, status) => {\n    let files = \"\";\n    let type = \"\";\n    if (status === \"onDrag\") {\n      files = e.dataTransfer.files[0];\n      type = e.dataTransfer.files[0].type;\n    } else {\n      files = e.target.files[0];\n      type = e.target.files[0].type;\n    }\n    if (files) {\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\" ||\n        type === \"audio/mpeg\"\n      ) {\n        let fileSize = this.formatBytes(files.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          return \"File size limit is exceeded\";\n        } else {\n          return \"file matched\";\n        }\n      } else {\n        return \"File not supported!\";\n      }\n    }\n  };\n  formatBytes = (bytes, decimals = 2) => {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  };\n  clearData = () => {\n    this.setState({\n      imageURL: \"\",\n      audioUrl: \"\",\n      videoURL: \"\",\n    });\n  };\n\n  render() {\n    const {\n      nft,\n      errors,\n      loader,\n      isSubmitted,\n      collections,\n      imageURL,\n      videoURL,\n      error,\n      errorMessage,\n      audioUrl,\n    } = this.state;\n\n    const { onDrop, dragOver, dragEnter, dragLeave } = this;\n\n    return (\n      <div>\n        <NavbarMain />\n        <Breadcrumb title1={\"NFT\"} title2={\"CreateNft\"} />\n        <section className=\"author-area padding-wrapper\">\n          {loader && <FullPageLoader />}\n\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Get started</span>\n                    <h3 className=\"mb-0\">Create NFT</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-sm-6 col-md-6 col-lg-4 left-container\">\n                <p className=\"upload-title\">Upload</p>\n                <div className=\"nft-left-upload p-3\">\n                  <div\n                    className=\"upload-image-container\"\n                    onDrop={(e) => onDrop(e)}\n                    onDragOver={(e) => dragOver(e)}\n                    onDragEnter={(e) => dragEnter(e)}\n                    onDragLeave={(e) => dragLeave(e)}\n                  >\n                    <Upload\n                      onFileChange={(e, status) => this.onFileChange(e, status)}\n                      clearData={this.clearData}\n                      Images={Images}\n                      imageURL={imageURL}\n                      videoURL={videoURL}\n                      audioSrc={audioUrl}\n                      dragOver={dragOver}\n                      onDrop={onDrop}\n                      dragEnter={dragEnter}\n                      dragLeave={dragLeave}\n                    />\n                    <span className=\"text-danger text-center mt-3\">\n                      {this.validator.message(\"image\", nft.image, \"required\")}\n                    </span>\n\n                    {error && (\n                      <p className=\"text-danger text-center mt-3\">\n                        {errorMessage}\n                      </p>\n                    )}\n\n                    <div className=\"choose-file text-center my-5 \">\n                      <p className=\"mb-4\">or choose a file</p>\n\n                      <label>\n                        <span className=\"browse-files-btn mt-2\">\n                          Browse file\n                        </span>\n                        <input\n                          type=\"file\"\n                          style={{ display: \"none\" }}\n                          onChange={(e) => this.onFileChange(e, \"onChange\")}\n                          accept=\".mp4, .png,.jpeg\"\n                          name=\"image\"\n                        />\n                      </label>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"col-sm-6 col-md-6 col-lg-8 mt-5 mt-sm-0\">\n                <p className=\"upload-title\">Create</p>\n                <div className=\"nft-inputs-container p-4\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-12\">\n                      <input\n                        name=\"name\"\n                        placeholder=\"Title\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.name}\n                        defaultValue={nft.name}\n                        autoComplete=\"off\"\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.name, \"required\")}\n                      </span>\n                    </div>\n                    <div className=\"col-12\">\n                      <textarea\n                        className=\"create-collection-textarea\"\n                        name=\"description\"\n                        rows=\"3\"\n                        placeholder=\"Description*\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.description}\n                        defaultValue={nft.description}\n                      ></textarea>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.description,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n\n                    <div className=\"col-12\">\n                      <input\n                        name=\"currentPrice\"\n                        placeholder=\"Item Price*\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        onKeyDown={(e) => decimalNumberValidator(e)}\n                        value={nft.currentPrice}\n                        defaultValue={nft.currentPrice}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.currentPrice,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n\n                    <div className=\"col-12 col-lg-6\">\n                      <input\n                        name=\"size\"\n                        placeholder=\"Size\"\n                        required=\"required\"\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.size}\n                        defaultValue={nft.size}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.size, \"required\")}\n                      </span>\n                    </div>\n                    <div className=\"col-12 col-lg-6\">\n                      <input\n                        name=\"copies\"\n                        placeholder=\"No. of Copies*\"\n                        required=\"required\"\n                        onKeyDown={(e) => decimalNumberValidator(e)}\n                        onChange={(e) => this.onChange(e)}\n                        value={nft.copies}\n                        defaultValue={nft.copies}\n                      />\n                      <span className=\"text-danger\">\n                        {this.validator.message(\"name\", nft.copies, \"required\")}\n                      </span>\n                    </div>\n\n                    <div className=\"col-12\">\n                      <select\n                        id=\"collectionId\"\n                        name=\"collectionId\"\n                        onChange={(e) => this.onChange(e)}\n                      >\n                        <option value=\"\" className=\"d-none\">\n                          Select Collection\n                        </option>\n                        {collections &&\n                          collections.length > 0 &&\n                          collections.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection._id}>\n                                {collection.name}\n                              </option>\n                            );\n                          })}\n                      </select>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"name\",\n                          nft.collectionId,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"col-12\">\n                      <div className=\"nft-form-btns text-center \">\n                        <div className=\"d-flex  flex-column flex-md-row justify-content-center align-items-center\">\n                          <button\n                            disabled={loader}\n                            className=\"create-collection-btn mt-2 me-md-2\"\n                            typ=\"submit\"\n                            onClick={(e) => this.submit(e)}\n                          >\n                            Create Item\n                          </button>\n                          <button className=\"cancel-collection-btn mt-2\">\n                            Cancel\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n        <Footer />\n      </div>\n    );\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  collection: state.collection,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollections,\n  setNftToken,\n  createNFT,\n  myCollections,\n})(CreateNFT);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["1621","1622","1623","1624","1625","1626","1627","1628","1629"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./collectiondetails.css\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst CollectionDetailsPage = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [keyword, setKeyword] = useState(\"\");\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n  });\n  const location = useLocation();\n\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    chains: {\n      label: \"Chains\",\n      option: [\"Ethereum\"],\n    },\n  };\n\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNfts(props.nfts);\n      props.beforeNFT();\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 40,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter,\n    keyword,\n    buy,\n    auction,\n    latest\n  ) => {\n    setFilterationLoader(true);\n\n    const nftQS = { page, limit };\n\n    nftQS.collectionId = location.state._id;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    if (keyword) nftQS.keyword = keyword;\n    if (buy) nftQS.buy = buy;\n    if (auction) nftQS.auction = auction;\n    if (latest) nftQS.latest = latest;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string in \");\n    props.getNFTs(qs);\n  };\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      filter.gtePrice,\n      filter.ltePrice,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleStatusFilter = (id) => {\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      id == \"Buy Now\" ? true : false,\n      id == \"On Auction\" ? true : false,\n      id == \"New\" ? true : false\n    );\n  };\n\n  const handleSearchKeyword = () => {\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n  ///////////Likes\n  const handleLikesTogleApi = (nftId, status) => {\n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const { name, banner, logo, description } = location.state;\n  return (\n    <>\n      {loader ? (\n        <FullPageLoader />\n      ) : (\n        <>\n          <NavbarMain />\n          <Breadcrumb title1={\"Collections\"} title2={\"CollectionDetail\"} />\n          <div className=\"collection-detail-hero w-100\">\n            <img className=\"w-100\" src={banner} alt=\"BannerImg\" />\n          </div>\n          <div className=\"collection-detail-content\">\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"collection-owner-avatar\">\n                    <img src={banner} alt=\"owner-avatar\" />\n                  </div>\n                  <div className=\"d-md-flex align-items-center justify-content-between mt-5\">\n                    <div className=\"collection-owner-detail\">\n                      <div className=\"collection-owner-name d-flex align-items-center\">\n                        <h3>\n                          {name}{\" \"}\n                          <img\n                            src={TickIcon}\n                            alt=\"tick-icon\"\n                            className=\"ms-2\"\n                          />\n                        </h3>\n                      </div>\n                      <p>\n                        Created by <span>brendannorth</span>\n                      </p>\n                    </div>\n                    <div className=\" d-block d-md-none\">\n                      <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                        <p>{description}</p>\n                      </div>\n                    </div>\n                    <div className=\"collection-owner-btns mt-3 mt-md-0 ms-auto\">\n                      <button className=\"me-1 me-sm-2 me-lg-3\">\n                        <img src={FlagIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button className=\"me-1 me-sm-1 me-lg-3\">\n                        <img src={ShareIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button>+ Add to wishlist</button>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-sm-7 col-md-6 col-lg-5 d-none d-md-block\">\n                  <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                    <p>{description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 col-lg-7 mt-3 mt-sm-5\">\n                  <div className=\"d-flex align-items-center justify-content-center justify-content-lg-end\">\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>items</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Owner</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Prize floor</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Volume trade</p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"collections-listing padding-wrapper\">\n                <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <img\n                        src={SearchIcon}\n                        alt=\"search-icon\"\n                        className=\"ms-3\"\n                        onClick={handleSearchKeyword}\n                      />\n                      <input\n                        type=\"text\"\n                        className=\"form-control\"\n                        placeholder=\"Search\"\n                        onChange={(e) => setKeyword(e.target.value)}\n                        onKeyPress={(e) =>\n                          e.key === \"Enter\" && handleSearchKeyword()\n                        }\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Item:</p>\n                      </div>\n\n                      <select name=\"collection-select\">\n                        {itemoptions &&\n                          itemoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                    <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                      <div className=\"ms-2\">\n                        <p>Sort:</p>\n                      </div>\n\n                      <select\n                        name=\"collection-select\"\n                        onChange={handleSortOptions}\n                      >\n                        {sortoptions &&\n                          sortoptions.map((collection, index) => {\n                            return (\n                              <option key={index} value={collection.label}>\n                                {collection.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-12 d-sm-none\">\n                    <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                      <button\n                        className={`${\n                          activeFilter\n                            ? \"filter-btn-active\"\n                            : \"filter-btn-inactive\"\n                        } ps-2`}\n                        onClick={() => setActiveFilter(!activeFilter)}\n                      >\n                        Filters\n                      </button>\n                    </div>\n                    <div\n                      className={`${\n                        activeFilter ? \"d-block\" : \"d-none\"\n                      } sm-filter-options`}\n                    >\n                      <div className=\"col-10 mx-auto mt-2\">\n                        <FilterComponent\n                          Status={filterData.status}\n                          Chains={filterData.chains}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row mt-5\">\n                <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                  <FilterComponent\n                    Status={filterData.status}\n                    Chains={filterData.chains}\n                    onChangeMinPrice={onChangeMinPrice}\n                    onChangeMaxPrice={onChangeMaxPrice}\n                    minValue={minValue}\n                    maxValue={maxValue}\n                    applyMinMaxFilter={applyMinMaxFilter}\n                    handleStatusFilter={handleStatusFilter}\n                  />\n                </div>\n                <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                  <div className=\"row g-3\">\n                    {filterationLoader ? (\n                      <div className=\"text-center\">\n                        <div\n                          class=\"spinner-border text-secondary text-white \"\n                          role=\"status\"\n                        >\n                          <span class=\"sr-only\">Loading...</span>\n                        </div>\n                      </div>\n                    ) : nfts && nfts.length > 0 ? (\n                      nfts.map((listing) => {\n                        return (\n                          <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                            <ListingCards\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                              ownerId={listing.ownerId}\n                              sellingMethod={listing.sellingMethod}\n                            />\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-white mt-5 text-center no-nfts-title\">\n                        No NFT's Found\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftAll.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n})(CollectionDetailsPage);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["1630","1631","1632","1633","1634","1635","1636","1637","1638","1639","1640","1641","1642","1643","1644","1645","1646","1647","1648","1649"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["1650","1651","1652"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n\n  useEffect(() => {\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if(props.user.topSellersAuth){\n\n      setSellers(props.user.sellers);\n      props.beforeUser()\n    }\n  }, [props.user.topSellersAuth]);\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <Link to={`/author/${author._id}`}>\n                          <div className=\"seller-avatar-container\">\n                            <img\n                              className=\"avatar-md rounded-circle\"\n                              src={AvatarImg}\n                              alt=\"\"\n                            />\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          </div>\n                        </Link>\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">{\"256.6ETH\"}</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>Top Sellers not available</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {/* {!empty &&\n                  collections?.length > 10 &&\n                  pagination.totalRecords <= collections.length && ( */}\n                <button className=\"btn btn-linear-gradient px-5\">\n                  Load more\n                </button>\n                {/* )} */}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["1653","1654","1655","1656","1657","1658","1659","1660","1661","1662","1663","1664","1665","1666","1667","1668","1669","1670","1671"],"import React, { useEffect, useState } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./nftdetail.css\";\nimport PriceHistoy from \"../../assets/images/pricehistoryicon.svg\";\nimport OfferIcon from \"../../assets/images/offer-icon.svg\";\nimport ListingIcon from \"../../assets/images/listing-icon.svg\";\nimport ActivityIcon from \"../../assets/images/activity.svg\";\nimport MoreCollectionIcon from \"../../assets/images/morecollectionicon.svg\";\nimport { ListingImg } from \"../../assets/assets\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/detailnftimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport ClockIcon from \"../../assets/images/clock-icon.svg\";\nimport DescriptionIcon from \"../../assets/images/detail-description-icon.svg\";\nimport {\n  getNFT,\n  getNFTsByCollection,\n  getMyLikedNfts,\n  beforeNFT,\n} from \"../nfts/nfts.action.js\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader.js\";\nimport { connect } from \"react-redux\";\nimport { Modal } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport moment from \"moment\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport axios from \"axios\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport {\n  placeABid,\n  connectMetamask,\n  BuyFixedPriceNFT,\n  getWalletAddress,\n} from \"../../utils/web3\";\nimport {\n  placeBid,\n  getBids,\n  getBidSByNftId,\n  beforeBid,\n  deleteBid,\n} from \"../bids/bids.action\";\nimport {\n  makeOffer,\n  getOffers,\n  beforeOffer,\n  deleteOffer,\n  buyNow,\n} from \"../offers/offers.action\";\nimport { toast } from \"react-toastify\";\nimport BuyModal from \"../modals/BuyModal\";\n// import  {}\n\nconst NFTDetail = (props) => {\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [nftsList, setNftList] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [isOpen, setIsOpen] = useState(false);\n  const [price, setPrice] = useState(0);\n  const [liked, setLiked] = useState(false);\n  const [bids, setBids] = useState(null);\n  const [offers, setOffers] = useState(null);\n  const [modalShow, setModalShow] = useState(false);\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [modal, setModal] = useState(1);\n  const [confirmed, setConfirmed] = useState(\"\");\n  const [transactionHash, setTransactionHash] = useState(\"\");\n  const [transactionSuccess,setTransactionSuccess]=useState(false)\n  const history = useHistory();\n\n  let nftId = props.match.params.id;\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  console.log(userId, \"userId\");\n  const initData = {\n    itemImg: \"/img/auction_2.jpg\",\n    date: \"2022-03-30\",\n    price_2: \"$500.89\",\n    bidBtn: \"Place a Bid\",\n    offerBtn: \"Buy Now\",\n    sellBtn: \"Sell\",\n  };\n  const { currencies } = ENV;\n  const expiryOptions = [\n    { label: \"5 Days\", value: moment().add(5, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"7 Days\", value: moment().add(7, \"days\").format(\"DD/MM/YYYY\") },\n    { label: \"A Month\", value: moment().add(1, \"months\").format(\"DD/MM/YYYY\") },\n    { label: \"Custom Date\", value: -1 },\n  ];\n\n  const config1 = {\n    price: {\n      currency: ENV.currency,\n      amount: \"\",\n    },\n    expiry: {\n      date: expiryOptions[0].value,\n      time: moment(new Date()).format(\"HH:mm\"),\n      type: 1, // 1 for time & 2 for datetime-local\n      datetime: \"\", // for payload\n    },\n  };\n  const [nftConfig, setNftConfig] = useState(config1);\n  const validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n\n  const propertiesData = [\n    {\n      id: 1,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 2,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 3,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 4,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 5,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 6,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 7,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n    {\n      id: 8,\n      subTitle: \"ACCESSORIES1\",\n      title: \"Rings\",\n      content: \"30% have this trait\",\n    },\n  ];\n  useEffect(() => {\n    props.getNFT(nftId);\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n    props.getBids();\n  }, []);\n\n  useEffect(() => {\n    if (props.createAuth) {\n      setLoader(false);\n      history.push(\"/\");\n    }\n  }, [props.createAuth]);\n  useEffect(() => {\n    if (props.buyAuth) {\n      setLoader(false);\n      setTransactionSuccess(true)\n      props.getNFT(nftId);\n      let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n      qs = ENV.objectToQueryString(qs);\n      props.getMyLikedNfts(qs);\n      validateIfLiked();\n      props.getBids();\n    }\n  }, [props.buyAuth]);\n\n  useEffect(() => {\n    if (props.createAuthOffer) {\n      setLoader(false);\n      history.push(\"/\");\n    }\n  }, [props.createAuthOffer]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // validateIfLiked(props.myLikedNfts);\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.getAuthOffer) {\n      setOffers(props.offers);\n    }\n  }, [props.getAuthOffer]);\n\n  useEffect(() => {\n    if (props.bidsByNftAuth) {\n      props.beforeBid();\n      setBids(props.bidsByNft);\n    }\n  }, [props.bidsByNftAuth]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNftDetail(props.nftDetail);\n\n      if (props.nftDetail.sellingMethod === 1) {\n        let qs = { offerBy: ENV.getUserKeys(\"_id\")._id };\n        qs = ENV.objectToQueryString(qs);\n        props.getOffers(qs);\n      }\n\n      if (nftDetail.sellingMethod === 2) {\n        let nftBidsQs = { nftId };\n        nftBidsQs = ENV.objectToQueryString(nftBidsQs);\n        props.getBidSByNftId(nftBidsQs);\n      }\n\n      let fivePerc = \"\";\n      if (props.nftDetail.highestBid === 0) {\n        fivePerc = (5 / 100) * props.nftDetail.currentPrice;\n        fivePerc = fivePerc + props.nftDetail.currentPrice;\n      } else {\n        fivePerc = (5 / 100) * props.nftDetail.highestBid;\n        fivePerc = fivePerc + props.nftDetail.highestBid;\n      }\n\n      setPrice(fivePerc);\n      validateIfLiked(likedNfts, props.nftDetail);\n\n      props.getNFTsByCollection(props.nftDetail.collectionId);\n    }\n  }, [props.nftsAuth]);\n\n  useEffect(() => {\n    if (props.nftsByCollectionStatus) {\n      let moreCollection = [];\n      if (props.nftsByCollection && props.nftsByCollection?.length) {\n        moreCollection = props.nftsByCollection.filter(\n          (item) => item._id !== nftDetail._id\n        );\n      }\n      setNftList(moreCollection);\n    }\n  }, [props.nftsByCollectionStatus]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const handleRouting = () => {\n    if (ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId) {\n      history.push({\n        pathname: `/sell-item/${nftDetail._id}`,\n        state: nftDetail,\n      });\n    } else {\n      setIsOpen(true);\n      // setModalShow(true);\n    }\n  };\n  //toggleLikes\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const handleLikesTogleApi = (nftId, status) => {\n    if (!likeButtonDisable) {\n      setLikeBtnDisable(true);\n      setToggle(!toggle);\n\n      let userId = ENV.getUserKeys(\"_id\")._id;\n\n      let data = {\n        userId,\n        nftId,\n        count: 1,\n      };\n\n      if ((status === \"dislike\") & (nftDetail.likesCount > 0)) {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount - 1;\n        setLiked(false);\n        setNftDetail(nft);\n        props.toggleLikeDislike(data);\n      } else {\n        let nft = nftDetail;\n        nft.likesCount = nft.likesCount + 1;\n\n        setNftDetail(nft);\n        setLiked(true);\n        props.toggleLikeDislike(data);\n      }\n    }\n  };\n\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      setLoader(false);\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      setLoader(false);\n      return setToggle(false);\n    }\n  };\n  const onChangeModal = (e) => {\n    const { name, value } = e.target;\n    let data = nftConfig;\n\n    const keys = name.split(\".\"); // nftConfig, price, currency\n    if (keys && keys[2]) data[keys[1]][keys[2]] = value;\n    else if (keys && keys[1]) data[keys[1]] = value;\n\n    if (keys && keys[1] === \"price\" && keys[2] === \"amount\")\n      data[keys[1]][\"amount\"] = Number(value);\n\n    if (keys && keys[1] === \"expiry\" && keys[2] === \"date\")\n      data[keys[1]][\"type\"] = Number(value) === -1 ? 2 : 1;\n\n    // set datetime for days / months\n    if (data.expiry.type === 1)\n      data.expiry.datetime = moment(\n        data.expiry.date + \" \" + data.expiry.time,\n        \"DD/MM/YYYY HH:mm\"\n      );\n    // set datetime for custom date\n    else if (data.expiry.type === 2) {\n      data.expiry.datetime = moment(data.expiry.time, \"DD/MM/YYYY HH:mm\");\n      data.expiry.date = moment(data.expiry.time, \"DD/MM/YYYY\");\n    }\n\n    setNftConfig(data);\n    console.log(data, \"data\");\n  };\n\n  const calculatePricePercantage = () => {\n    let fivePerc = \"\";\n    if (nftDetail.highestBid === 0) {\n      fivePerc = (5 / 100) * nftDetail.currentPrice;\n      return fivePerc + nftDetail.currentPrice;\n    } else {\n      fivePerc = (5 / 100) * nftDetail.highestBid;\n      return fivePerc + nftDetail.highestBid;\n    }\n  };\n\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const closeModal = () => {\n    setIsOpen(false);\n  };\n  const onChange = (e) => {\n    setPrice(e.target.value);\n  };\n  const handleModalSubmit = async () => {\n    setLoader(true);\n    setIsOpen(false);\n    if (nftDetail.sellingMethod === 2) {\n      placeBid();\n    } else {\n      makeOffer();\n    }\n  };\n  const placeBid = async () => {\n    try {\n      let result = await placeABid(price, nftDetail.nftToken);\n      if (result) {\n        const payload = {\n          ownerId: nftDetail.ownerId,\n          bidAmount: price,\n          nftId: nftDetail._id,\n          bidBy: ENV.getUserKeys(\"_id\")._id,\n          isAccepted: false,\n          // expiryDate: nftConfig.expiry.datetime,\n          toAddress: nftDetail.ownerAddress,\n          fromAddress: await connectMetamask(),\n        };\n\n        props.placeBid(payload);\n      }\n    } catch (err) {\n      setLoader(false);\n      setIsOpen(false);\n      toast.error(err);\n    }\n  };\n  const makeOffer = async () => {\n    try {\n      // let result = await placeABid(price, nftDetail.nftToken);\n      let result = true;\n      if (result) {\n        const payload = {\n          toAddress: nftDetail.ownerAddress,\n          fromAddress: await connectMetamask(),\n          offerBy: ENV.getUserKeys(\"_id\")._id,\n          ownerId: nftDetail.ownerId,\n          nftId: nftDetail._id,\n          price: price,\n          expiryDate: nftConfig.expiry.datetime,\n          isAccepted: false,\n          isExpired: false,\n        };\n        console.log(payload, \"payload\");\n\n        props.makeOffer(payload);\n      }\n    } catch (err) {\n      setLoader(false);\n      setIsOpen(false);\n      toast.error(err);\n    }\n  };\n  const getPercentageChange = (oldNumber, newNumber) => {\n    var decreaseValue = oldNumber - newNumber;\n\n    return (decreaseValue / oldNumber) * 100;\n  };\n\n  const deleteBid = (id) => {\n    let result = bids.filter((bid) => bid._id !== id);\n    setBids(result);\n    props.deleteBid(id);\n  };\n\n  const deleteOffer = (id) => {\n    let result = offers.filter((offer) => offer._id !== id);\n    setOffers(result);\n    props.deleteOffer(id);\n  };\n  const auctionEndTimeConversion = (auctionEndDate) => {\n    var dateString = moment.utc(auctionEndDate).format(\"MMMM D, Y\");\n    var timeString = moment.utc(auctionEndDate).format(\"h:mma\");\n    var totalDateTime = dateString + \" at \" + timeString + \" PKT\";\n    return totalDateTime;\n  };\n\n  const BuyNow = async () => {\n    try {\n      const result = await BuyFixedPriceNFT(\n        nftDetail.currentPrice,\n        nftDetail.nftToken,\n        setConfirmed,\n        setTransactionHash\n      );\n      if (result) {\n        let payload = {\n          userId,\n          nftId,\n          ownerAddress: await getWalletAddress(),\n        };\n        props.buyNow(payload);\n      }\n    } catch (err) {}\n  };\n  console.log(nftDetail.currentPrice,\"nftDetail\")\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n      <>\n        <NavbarMain />\n        <section className=\"padding-wrapper nft-detail\">\n          <div className=\"container\">\n            <div className=\"row g-3\">\n              <div className=\"col-12 order-2 order-md-1 col-md-6 col-lg-7 col-xl-8 \">\n                <div className=\"row\">\n                  <div className=\"col-12 order-2 order-md-1\">\n                    <div className=\"nftDetail-accordion\">\n                      <div\n                        className=\"accordion accordion-flush \"\n                        id=\"accordionFlushExample\"\n                      >\n                        {/* <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingOne\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseOne\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseOne\"\n                              >\n                                <img\n                                  src={PriceHistoy}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Price history\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseOne\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingOne\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div> */}\n\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingTwo\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseTwo\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseTwo\"\n                            >\n                              <img\n                                src={OfferIcon}\n                                alt=\"price-history\"\n                                className=\"me-2\"\n                              />\n                              Offers\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseTwo\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingTwo\"\n                          >\n                            <div className=\"accordion-body\">\n                              <div className=\"table-container listing-table\">\n                                <table class=\"table table-borderless\">\n                                  {((bids && bids.length > 0) ||\n                                    (offers && offers.length > 0)) && (\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Floor Difference</th>\n                                        {/* <th scope=\"col\">Expiration</th> */}\n                                        <th scope=\"col\">From</th>\n                                        <th scope=\"col\">{\"\"}</th>\n                                      </tr>\n                                    </thead>\n                                  )}\n                                  <tbody>\n                                    {nftDetail.sellingMethod === 2 ? (\n                                      <>\n                                        {bids && bids.length > 0 ? (\n                                          bids\n                                            .filter(\n                                              (item) =>\n                                                item.nftId === nftDetail._id\n                                            )\n                                            .map((bid) => {\n                                              return (\n                                                <tr>\n                                                  <th scope=\"row\">\n                                                    {bid.bidAmount}\n                                                  </th>\n                                                  <td>\n                                                    $\n                                                    {(\n                                                      bid.bidAmount *\n                                                      exchangeRate\n                                                    ).toFixed(2)}\n                                                  </td>\n                                                  <td>\n                                                    {getPercentageChange(\n                                                      bid.bidAmount,\n                                                      nftDetail.lowestNftPrice\n                                                    ).toFixed(0)}\n                                                    %{\" \"}\n                                                    {bid.bidAmount >\n                                                    nftDetail.lowestNftPrice\n                                                      ? \"above\"\n                                                      : \"below\"}\n                                                  </td>\n                                                  {/* <td>an hour ago</td> */}\n                                                  <td>\n                                                    {bid.fromAddress.slice(\n                                                      3,\n                                                      8\n                                                    )}\n                                                  </td>\n                                                  {ENV.getUserKeys(\"_id\")\n                                                    ._id === bid.bidBy && (\n                                                    <td>\n                                                      <button\n                                                        className=\"cancel-Bid-btn\"\n                                                        onClick={() =>\n                                                          deleteBid(bid._id)\n                                                        }\n                                                      >\n                                                        Cancel\n                                                      </button>\n                                                    </td>\n                                                  )}\n                                                </tr>\n                                              );\n                                            })\n                                        ) : (\n                                          <p className=\"text-center d-flex justify-content-center align-items-center\">\n                                            No Offers Found\n                                          </p>\n                                        )}\n                                      </>\n                                    ) : (\n                                      <>\n                                        {offers && offers.length > 0 ? (\n                                          offers.map((offer) => {\n                                            return (\n                                              <tr>\n                                                <th scope=\"row\">\n                                                  {offer.price} ETH\n                                                </th>\n                                                <td>\n                                                  $\n                                                  {(\n                                                    offer.price * exchangeRate\n                                                  ).toFixed(2)}\n                                                </td>\n                                                <td>\n                                                  {getPercentageChange(\n                                                    offer.price,\n                                                    nftDetail.lowestNftPrice\n                                                  ).toFixed(0)}\n                                                  %{\" \"}\n                                                  {offer.price >\n                                                  nftDetail.lowestNftPrice\n                                                    ? \"above\"\n                                                    : \"below\"}\n                                                </td>\n                                                {/* <td>an hour ago</td> */}\n                                                <td>\n                                                  {offer.fromAddress.slice(\n                                                    3,\n                                                    8\n                                                  )}\n                                                </td>\n                                                {ENV.getUserKeys(\"_id\")._id ===\n                                                  offer.ownerId && (\n                                                  <td>\n                                                    <button\n                                                      className=\"cancel-Bid-btn\"\n                                                      onClick={() =>\n                                                        deleteOffer(offer._id)\n                                                      }\n                                                    >\n                                                      Cancel\n                                                    </button>\n                                                  </td>\n                                                )}\n                                              </tr>\n                                            );\n                                          })\n                                        ) : (\n                                          <p className=\"text-center d-flex justify-content-center align-items-center\">\n                                            No Offers Found\n                                          </p>\n                                        )}\n                                      </>\n                                    )}\n                                  </tbody>\n                                </table>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingThree\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseThree\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseThree\"\n                            >\n                              <img\n                                src={ListingIcon}\n                                alt=\"price-history\"\n                                className=\"me-2\"\n                              />\n                              Item listing\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseThree\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingThree\"\n                          >\n                            <div className=\"accordion-body\">\n                              <div className=\"table-container listing-table\">\n                                <table class=\"table table-borderless\">\n                                  <thead>\n                                    <tr>\n                                      <th scope=\"col\">Price</th>\n                                      <th scope=\"col\">USD Price</th>\n                                      <th scope=\"col\">Expiration</th>\n                                      <th scope=\"col\">From</th>\n                                      <th scope=\"col\">{\"\"}</th>\n                                    </tr>\n                                  </thead>\n                                  <tbody>\n                                    <tr>\n                                      <th scope=\"row\">0.025</th>\n                                      <td>$77.50</td>\n                                      <td>in a day</td>\n                                      <td>BBC1B3</td>\n                                      <td>\n                                        <button>Buy</button>\n                                      </td>\n                                    </tr>\n                                  </tbody>\n                                </table>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-11 col-md-12 col-lg-7 col-xl-5 order-1 order-md-2 mx-auto mb-5 mb-md-0  mx-md-0\">\n                    <div className=\"collection-filter-accordion nft-stats-accordion\">\n                      <div\n                        className=\"accordion accordion-flush \"\n                        id=\"accordionFlushExample\"\n                      >\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingFour\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseFour\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseFour\"\n                            >\n                              Properties\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseFour\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingFour\"\n                          >\n                            <div className=\"accordion-body\">\n                              <div className=\"row g-2 justify-content-center align-items-center\">\n                                {propertiesData &&\n                                  propertiesData.map((data) => {\n                                    return (\n                                      <div className=\"col-6 col-sm-4 col-md-6\">\n                                        <div className=\"properties-content-container d-flex flex-column justify-content-center align-items-center text-center\">\n                                          <div className=\"properties-content\">\n                                            <span>{data.subTitle}</span>\n                                            <h3>{data.title}</h3>\n                                            <p>{data.content}</p>\n                                          </div>\n                                        </div>\n                                      </div>\n                                    );\n                                  })}\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingSix\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseSix\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseSix\"\n                            >\n                              Stats\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseSix\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingSix\"\n                          >\n                            <div className=\"accordion-body\"></div>\n                          </div>\n                        </div>\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingSeven\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseSeven\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseSeven\"\n                            >\n                              Levels\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseSeven\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingSeven\"\n                          >\n                            <div className=\"accordion-body\"></div>\n                          </div>\n                        </div>\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingEight\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseEight\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseEight\"\n                            >\n                              Boosts\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseEight\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingEight\"\n                          >\n                            <div className=\"accordion-body\"></div>\n                          </div>\n                        </div>\n\n                        <div className=\"accordion-item\">\n                          <h2\n                            className=\"accordion-header\"\n                            id=\"flush-headingNine\"\n                          >\n                            <button\n                              className=\"accordion-button collapsed\"\n                              type=\"button\"\n                              data-toggle=\"collapse\"\n                              data-target=\"#flush-collapseNine\"\n                              aria-expanded=\"false\"\n                              aria-controls=\"flush-collapseNine\"\n                            >\n                              Details\n                            </button>\n                          </h2>\n                          <div\n                            id=\"flush-collapseNine\"\n                            className=\"accordion-collapse collapse\"\n                            aria-labelledby=\"flush-headingNine\"\n                          >\n                            <div className=\"accordion-body\">\n                              <div className=\"contact-address d-flex justify-content-between\">\n                                <p>Contract Address</p>\n                                <span>0x7227...3335</span>\n                              </div>\n                              <div className=\"d-flex justify-content-between\">\n                                <p>Token ID</p>\n                                <p>1584563428....</p>\n                              </div>\n                              <div className=\"d-flex justify-content-between\">\n                                <p>Token Standard </p>\n                                <p>ERC-721</p>\n                              </div>\n                              <div className=\"d-flex justify-content-between\">\n                                <p>Blockchain </p>\n                                <p>Polygon</p>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n                <Card className=\"auction-card detail-card\">\n                  <div className=\"auction-img-wrapper\">\n                    <Card.Img\n                      variant=\"top\"\n                      src={nftDetail.image}\n                      alt=\"AuctionTopImg\"\n                    />\n                  </div>\n                  <Card.Body>\n\n                    <div>\n                      {nftDetail.currentPrice !==null && (\n                        <>\n                          <span>Current price</span>\n                          <h3>\n                            {nftDetail.currentPrice}\n                            <span>\n                              (${\" \"}\n                              {(nftDetail.currentPrice * exchangeRate).toFixed(\n                                2\n                              )}\n                              )\n                            </span>\n                          </h3>\n                        </>\n                      )}\n                    </div>\n                    <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                      <div className=\"d-flex align-items-center\">\n                        {nftDetail.sellingMethod && (\n                          <>\n                            <img\n                              src={ClockIcon}\n                              alt=\"clock-icon\"\n                              className=\"me-1\"\n                            />\n                            <span>\n                              Sale ends{\" \"}\n                              {auctionEndTimeConversion(\n                                nftDetail.auctionEndDate\n                              )}{\" \"}\n                            </span>\n                          </>\n                        )}\n                      </div>\n                      <div className=\"likes-container d-flex align-items-center\">\n                        {toggle ? (\n                          <>\n                            <AiFillHeart\n                              className=\"heart-fill-icon \"\n                              onClick={() => {\n                                handleLikesTogleApi(nftDetail._id, \"dislike\");\n                              }}\n                            />\n                            <p className=\"text-white\">\n                              {nftDetail.likesCount ? nftDetail.likesCount : 0}{\" \"}\n                            </p>\n                          </>\n                        ) : (\n                          <>\n                            <img\n                              src={HeartIcon}\n                              alt=\"heart-icon\"\n                              className=\"ms-1\"\n                              onClick={() => {\n                                handleLikesTogleApi(nftDetail._id, \"like\");\n                              }}\n                            />\n\n                            <span className=\"ms-1\">\n                              {nftDetail.likesCount ? nftDetail.likesCount : 0}\n                            </span>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                    {(nftDetail?.sellingMethod ||\n                      ENV.getUserKeys(\"_id\")._id == nftDetail.ownerId) && (\n                      <>\n                        <button\n                          className=\"btn btn-linear-gradient d-flex align-items-center justify-content-center w-75 mx-auto\"\n                          onClick={() => handleRouting()}\n                        >\n                          <p>\n                            {ENV.getUserKeys(\"_id\")._id == nftDetail.ownerId\n                              ? \"Sell\"\n                              : nftDetail?.sellingMethod === 2\n                              ? \"Place Bid\"\n                              : nftDetail?.sellingMethod === 1\n                              ? \"Make Offer\"\n                              : \"\"}\n                          </p>\n                        </button>\n                        {nftDetail?.sellingMethod && (\n                          <button\n                            className=\"btn buy-now-btn d-flex align-items-center justify-content-center w-75 mx-auto mt-3\"\n                            onClick={() => setModalShow(true)}\n                          >\n                            <p>{\"Buy Now\"}</p>\n                          </button>\n                        )}\n                      </>\n                    )}\n                  </Card.Body>\n                </Card>\n                <div className=\"detail-description-content mt-5\">\n                  <div className=\"d-flex align-items-center mb-3\">\n                    <img\n                      src={DescriptionIcon}\n                      alt=\"descriptionIcon\"\n                      className=\"me-1\"\n                    />\n                    <h6>Discription</h6>\n                  </div>\n                  <p>{nftDetail.description}</p>\n                </div>\n              </div>\n              <div className=\"col-12 mt-0 mt-md-4 order-3\">\n                <div className=\"nftDetail-accordion\">\n                  <div\n                    className=\"accordion accordion-flush \"\n                    id=\"accordionFlushExample\"\n                  >\n                    <div className=\"accordion-item\">\n                      <h2 className=\"accordion-header\" id=\"flush-headingTen\">\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target=\"#flush-collapseTen\"\n                          aria-expanded=\"false\"\n                          aria-controls=\"flush-collapseTen\"\n                        >\n                          <img\n                            src={ActivityIcon}\n                            alt=\"price-history\"\n                            className=\"me-2\"\n                          />\n                          Activity\n                        </button>\n                      </h2>\n                      <div\n                        id=\"flush-collapseTen\"\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby=\"flush-headingTen\"\n                      >\n                        <div className=\"accordion-body\">\n                          <div className=\"table-container\">\n                            <table class=\"table table-borderless\">\n                              <thead>\n                                <tr>\n                                  <th scope=\"col\">Event</th>\n                                  <th scope=\"col\">Price</th>\n                                  <th scope=\"col\">From</th>\n                                  <th scope=\"col\">To</th>\n                                  <th scope=\"col\">Date</th>\n                                </tr>\n                              </thead>\n                              <tbody>\n                                <tr>\n                                  <th scope=\"row\">List</th>\n                                  <td>0.025</td>\n                                  <td>BBC1B3</td>\n                                  <td> </td>\n                                  <td>an hour ago</td>\n                                </tr>\n                                <tr>\n                                  <th scope=\"row\">List</th>\n                                  <td>0.025</td>\n                                  <td>BBC1B3</td>\n                                  <td> </td>\n                                  <td>an hour ago</td>\n                                </tr>\n                                <tr>\n                                  <th scope=\"row\">List</th>\n                                  <td>0.025</td>\n                                  <td>BBC1B3</td>\n                                  <td> </td>\n                                  <td>an hour ago</td>\n                                </tr>\n                                <tr>\n                                  <th scope=\"row\">List</th>\n                                  <td>0.025</td>\n                                  <td>BBC1B3</td>\n                                  <td> </td>\n                                  <td>an hour ago</td>\n                                </tr>\n                                <tr>\n                                  <th scope=\"row\">List</th>\n                                  <td>0.025</td>\n                                  <td>BBC1B3</td>\n                                  <td> </td>\n                                  <td>an hour ago</td>\n                                </tr>\n                                <tr>\n                                  <th scope=\"row\">List</th>\n                                  <td>0.025</td>\n                                  <td>BBC1B3</td>\n                                  <td> </td>\n                                  <td>an hour ago</td>\n                                </tr>\n                                <tr>\n                                  <th scope=\"row\">List</th>\n                                  <td>0.025</td>\n                                  <td>BBC1B3</td>\n                                  <td> </td>\n                                  <td>an hour ago</td>\n                                </tr>\n                                <tr>\n                                  <th scope=\"row\">List</th>\n                                  <td>0.025</td>\n                                  <td>BBC1B3</td>\n                                  <td> </td>\n                                  <td>an hour ago</td>\n                                </tr>\n                              </tbody>\n                            </table>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"accordion-item\">\n                      <h2 className=\"accordion-header\" id=\"flush-headingEleven\">\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target=\"#flush-collapseEleven\"\n                          aria-expanded=\"false\"\n                          aria-controls=\"flush-collapseEleven\"\n                        >\n                          <img\n                            src={MoreCollectionIcon}\n                            alt=\"price-history\"\n                            className=\"me-2\"\n                          />\n                          More from this collection\n                        </button>\n                      </h2>\n                      <div\n                        id=\"flush-collapseEleven\"\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby=\"flush-headingEleven\"\n                      >\n                        <div className=\"accordion-body\">\n                          <div className=\"row justify-content-center align-items-center g-3\">\n                            {nftsList && nftsList.length > 0 ? (\n                              nftsList.map((listing) => {\n                                return (\n                                  <div className=\"col-6 col-sm-6 col-md-4 col-lg-2 px-1\">\n                                    <ListingCards\n                                      CardImg={listing.image}\n                                      name={listing.name}\n                                      price={listing.currentPrice}\n                                      // usd={\n                                      //   listing.currentPrice * exchangeRate\n                                      // }\n                                      id={listing._id}\n                                    />\n                                  </div>\n                                );\n                              })\n                            ) : (\n                              <p className=\"text-center mt-4\">No NFTs Found</p>\n                            )}\n                          </div>\n                          <div className=\"mt-4 detail-btn-collection text-center\">\n                            {nftsList.length > 0 && (\n                              <button className=\"btn btn-rounded-bordered\">\n                                View collection\n                              </button>\n                            )}\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          {/* ///////////////////////////////////// Modal */}\n          <div className=\"modal-wrapper\">\n            <Modal\n              centered\n              size=\"lg\"\n              className=\"place-bid-modal\"\n              show={isOpen}\n              onHide={closeModal}\n              contentClassName=\"bid-modal-content\"\n            >\n              <Modal.Header className=\"bid-modal-header text-center text-white\">\n                <Modal.Title>\n                  {nftDetail.sellingMethod === 2\n                    ? \"Place A Bid\"\n                    : \"Make An Offer\"}\n                </Modal.Title>\n              </Modal.Header>\n              <Modal.Body>\n                <div className=\"price-wrapper d-flex\">\n                  <div className=\"price-text position-relative\">\n                    <div className=\"text-white mb-2 absolute-wrapper\">\n                      <b>Price</b>\n                    </div>\n                    <div className=\"text-right mb-2\">\n                      <i className=\"fas fa-exclamation-circle ml-2 text-white\" />\n                    </div>\n                    <div className=\"d-flex\">\n                      <select\n                        className=\"form-control currency-options\"\n                        id=\"currency\"\n                        name=\"nftConfig.price.currency\"\n                        onChange={(e) => onChange(e)}\n                        disabled={true}\n                      >\n                        {currencies &&\n                          currencies.map((currency, index) => {\n                            return (\n                              <option key={index} value={currency.symbol}>\n                                {currency.symbol}\n                              </option>\n                            );\n                          })}\n                      </select>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Amount\"\n                        className=\"amount-btn ml-3\"\n                        name=\"nftConfig.price.amount\"\n                        style={{ borderRadius: \"4px\" }}\n                        onChange={(e) => onChange(e)}\n                        onKeyDown={(e) => decimalNumberValidator(e)}\n                        defaultValue={calculatePricePercantage()}\n                        required\n                      />\n                      <div className=\"text-right mb-2 dollar-wrapper\">\n                        ${(price * exchangeRate).toFixed(2)}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </Modal.Body>\n              <Modal.Body className=\"text-danger\">\n                {validator.message(\n                  \"amount\",\n                  nftConfig.price.amount,\n                  \"required\"\n                )}\n              </Modal.Body>\n              {nftDetail.sellingMethod === 1 && (\n                <Modal.Body\n                  className=\"\"\n                  style={{\n                    flexDirection: \"column\",\n                    display: \"block\",\n                    height: \"200px\",\n                  }}\n                >\n                  <div className=\"offer-expiration-wrapper text-white\">\n                    <b>Offer Expiration</b>\n                  </div>\n                  <div>\n                    <div className=\"d-flex\">\n                      <select\n                        className=\"form-control\"\n                        id=\"expiryDate\"\n                        name=\"nftConfig.expiry.date\"\n                        onChange={(e) => onChangeModal(e)}\n                        style={{\n                          padding: \"7px 55px 7px 55px\",\n                          border: \"none\",\n                          outline: \"none\",\n                          borderRadius: \"4px\",\n                          background: \"#808080\",\n                          display: \"flex\",\n                          alignItems: \"center\",\n                          cursor: \"pointer\",\n                          height: \"51px\",\n                          color: \"#000\",\n                        }}\n                      >\n                        {expiryOptions &&\n                          expiryOptions.map((expiry, index) => {\n                            return (\n                              <option key={index} value={expiry.value}>\n                                {expiry.label}\n                              </option>\n                            );\n                          })}\n                      </select>\n                      <div>\n                        <div className=\"mr-auto budle-wrapper\">\n                          <input\n                            type={\n                              nftConfig.expiry.type === 1\n                                ? \"time\"\n                                : \"datetime-local\"\n                            }\n                            style={{ marginLeft: \"1rem\", width: \"552px\" }}\n                            name=\"nftConfig.expiry.time\"\n                            value={nftConfig.expiry.time}\n                            onChange={(e) => onChangeModal(e)}\n                            required\n                          />\n                        </div>\n                        <span className=\"text-danger message\">\n                          {validator.message(\n                            \"amount\",\n                            nftConfig.price.amount,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                </Modal.Body>\n              )}\n              <Modal.Body className=\"justify-content-center align-items-center\">\n                <div className=\"d-flex justify-content-around place-bid-btn\">\n                  <button\n                    className={`ethereum-btn  place-bid-ethereum-btn ${\n                      price <= nftDetail.highestBid\n                        ? \"place-btn-disable-btn\"\n                        : \"place-bid-gradient-btn\"\n                    }`}\n                    disabled={loader || price < calculatePricePercantage()}\n                    onClick={() => handleModalSubmit()}\n                  >\n                    {2 === 2 ? initData.bidBtn : initData.bidBtn}\n                  </button>\n                </div>\n              </Modal.Body>\n              <Modal.Footer>\n                <button\n                  className=\"btn banner-btn btn-primary\"\n                  onClick={closeModal}\n                >\n                  Close\n                </button>\n              </Modal.Footer>\n            </Modal>\n          </div>\n          <BuyModal\n            show={modalShow}\n            onHide={() => setModalShow(false)}\n            name={nftDetail.name}\n            price={nftDetail.currentPrice}\n            image={nftDetail.image}\n            exchangeRate={exchangeRate}\n            tokenId={nftDetail.nftToken}\n            modal={modal}\n            setModal={setModal}\n            BuyNow={BuyNow}\n            confirmed={confirmed}\n            transactionHash={transactionHash}\n            transactionSuccess={transactionSuccess}\n          />\n        </section>\n        <Footer />\n      </>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n\n  {\n    nftDetail: state.nft.nftsData,\n    nftsAuth: state.nft.nftsAuth,\n    nftsByCollection: state.nft.nftsByCollection,\n    nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n    myLikedNfts: state.nft.myLikedNfts,\n    myLikedNftsStatus: state.nft.myLikedNftsStatus,\n    createAuth: state.bid.createAuth,\n    createAuthOffer: state.offer.createAuth,\n    getAuth: state.bid.getAuth,\n    getAuthOffer: state.offer.getAuth,\n    offers: state.offer.offers,\n    buyAuth: state.offer.buyAuth,\n    bids: state.bid.bids,\n    bidsByNft: state.bid.bidsByNft,\n    bidsByNftAuth: state.bid.bidsBYNftAuth,\n    togleLikeRes: state.explore.togleLikeRes,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  getNFT,\n  beforeNFT,\n  getNFTsByCollection,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  placeBid,\n  getBids,\n  getBidSByNftId,\n  beforeBid,\n  deleteBid,\n  beforeTogleLikeDislike,\n  makeOffer,\n  beforeOffer,\n  getOffers,\n  deleteOffer,\n  buyNow,\n})(NFTDetail);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.js",["1672","1673","1674","1675","1676","1677"],"import React, { useState, useEffect } from \"react\";\nimport { Redirect, useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"../wallet/wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  getCollections,\n  beforeCategory,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport { login, signup } from \"../user/user.action\";\nimport \"./wallet.css\";\n\nconst Wallet = (props) => {\n  const history = useHistory();\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n\n  const connectMetamaskCall = async () => {\n    let connectedAddress = await connectMetamaskCopy();\n    setConnectedAddress(connectedAddress);\n    setWalletAddress(connectedAddress);\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      console.log(\"errors\", props.error);\n\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.collection.getAuth === true) {\n      let collections = props.collection.collections;\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n\n      let myCollections = collections.filter((el) => el.userId === userId);\n\n      if (myCollections && myCollections.length > 0) {\n        history.push(\"/\");\n      } else {\n        history.push(\"/\");\n      }\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    e.preventDefault();\n    try {\n      if (validator.isEmail(email)) {\n        let sign = await signRequest();\n        let payload = {\n          address: connectedAddress,\n          // password: sign,\n          email: email,\n          username: username,\n        };\n        props.signup(payload);\n      } else {\n        setErrorMessage(\"please enter valid email\");\n      }\n    } catch (err) {\n      toast.error(err.message);\n    }\n  };\n\n  const login = async () => {\n    try {\n      let sign = await signRequest();\n      let payload = {\n        address: connectedAddress,\n      };\n      props.login(payload);\n    } catch (err) {\n      toast.error(err.message);\n    }\n  };\n\n  const switchSignup = () => {\n    setShowSignUpComponent(true);\n  };\n\n  // if (props.user.userAuth) {\n  //     console.log(\"@@@@Collection-----@\", collections);\n  //     if(collections && collections.length>){\n  //         console.log(\"In Upper\")\n  //         return <Redirect to=\"/create\" />\n  //     }\n  //     else {\n  //         console.log(\"In Down\");\n  //         return <Redirect to=\"/collection/create\" />\n  //     }\n  // }\n\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div className=\"container\">\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Sign In</span>\n                  <h3 className=\"mt-3 mb-0\">SignIn to your account</h3>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                <div className=\"card single-wallet sign-in-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <h4 className=\"mb-0\">Address</h4>\n                    <p id=\"connected-address mt-2\">{connectedAddress}</p>\n                    {errorMessage && (\n                      <p className=\"text-gray\">{errorMessage}</p>\n                    )}\n                    <button\n                      className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4\"\n                      type=\"button\"\n                      onClick={() => login()}\n                    >\n                      Sign In\n                    </button>\n                    {showSignUp && (\n                      <button\n                        className=\"btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                        type=\"button\"\n                        onClick={() => switchSignup()}\n                      >\n                        Would you like to Signup?\n                      </button>\n                    )}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              {/* Intro */}\n              <div className=\"intro text-center\">\n                <span>SIGNUP</span>\n                <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                <p className=\"text-gray\">Create the account with the address</p>\n              </div>\n              {/* Item Form */}\n              <form\n                className=\"item-form card no-hover signup-card\"\n                onSubmit={(e) => signup(e)}\n              >\n                <div className=\"row\">\n                  {errorMessage && (\n                    <p className=\"text-center text-gray\">{errorMessage}</p>\n                  )}\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"address\"\n                        placeholder=\"Address\"\n                        required=\"required\"\n                        disabled={true}\n                        value={connectedAddress}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"email\"\n                        className=\"form-control sign-up-input\"\n                        name=\"email\"\n                        placeholder=\"Enter your Email\"\n                        required=\"required\"\n                        defaultValue={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"username\"\n                        placeholder=\"Enter your Username\"\n                        required=\"required\"\n                        defaultValue={username}\n                        onChange={(e) => setUsername(e.target.value)}\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3 text-center\">\n                      <div className=\"form-check form-check-inline\">\n                        <input\n                          className=\"form-check-input\"\n                          type=\"radio\"\n                          name=\"inlineRadioOptions\"\n                          id=\"inlineRadio1\"\n                          defaultValue=\"option1\"\n                        />\n                        <label\n                          className=\"form-check-label text-center text-gray\"\n                          htmlFor=\"inlineRadio1\"\n                        >\n                          I agree to{\" \"}\n                          <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <button\n                      className=\"btn-signin w-75 mx-auto mt-3 mt-sm-4  text-white \"\n                      type=\"submit\"\n                    >\n                      Sign Up\n                    </button>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        ) : (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Wallet Connect</span>\n                  <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                  <p className=\"text-white mt-3\">\n                    Please select the wallet you want to connect to.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              {errorMessage && <p className=\"text-white\">{errorMessage}</p>}\n              <div\n                className=\"col-12 col-md-6 col-lg-4 item\"\n                onClick={() => connectMetamaskCall()}\n              >\n                {/* Single Wallet */}\n                <div className=\"card single-wallet whole-hover wallet-metamask-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <img\n                      className=\"avatar-lg\"\n                      src=\"/img/metamask2.png\"\n                      alt=\"\"\n                    />\n                    <h4 className=\"mb-0 my-3\">MetaMask</h4>\n                    <p>\n                      A browser extension with great flexibility. The web's most\n                      popular wallet\n                    </p>\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n})(Wallet);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/explore-collections.js",["1678","1679","1680","1681"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\n\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport \"./explore-collections.css\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"./collections.actions\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { beforeCategory, getCategories } from \"./collections.actions\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Explore\"} title2={\"ExploreAll\"} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Collections</span>\n                    <h3 className=\"mb-0\">Explore all</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-lg-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={collection.banner}\n                        Subimg1={collection.logo}\n                        Subimg2={collection.featuredImg}\n                        Subimg3={collection.banner}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.user[0]?.username\n                            ? collection?.user[0]?.username\n                            : \"\"\n                        }\n                        NFTCount={collection.NFTCount}\n                        profileImage={collection?.user[0]?.profileImage}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    collections?.length === 10 &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["1682","1683","1684","1685","1686","1687","1688","1689","1690","1691","1692","1693","1694","1695"],"import React, { useState, useEffect } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./allnft.css\";\nimport { beforeNFT, getNFTs, getMyLikedNfts } from \"../../nfts/nfts.action\";\nimport { ENV } from \"../../../config/config\";\nimport NavbarMain from \"../../navbar-main/NavbarMain\";\nimport Footer from \"../../footer/footer\";\nimport SearchIcon from \"../../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../../listing-cards/ListingCards\";\nimport FilterComponent from \"../../filter-component/FilterComponent\";\nimport { getCreators, beforeUser } from \"./../../user/user.action\";\nimport FullPageLoader from \"../../full-page-loader/full-page-loader\";\nimport { toggleLikeDislike, beforeTogleLikeDislike } from \"../explore.action\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../../collections/collections.actions\";\nimport Breadcrumb from \"../../breadcrumb/breadcrumb\";\nimport VideoCard from \"../../test-video-card/videoCard\";\n\nconst AllNFT = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [collections, setCollections] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [keyword, setKeyword] = useState(\"\");\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n  });\n  useEffect(() => {\n    console.log(ENV.getUserKeys(\"_id\")._id, \"id in all nft\");\n    window.scroll(0, 0);\n    props.getCreators();\n    props.getCollections();\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // props.beforeUser()\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  //Get Top Sellers\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      setCreator(props.user.sellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      setCreator(props.user.creators);\n      props.beforeUser();\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n\n  //Get NFt's\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nfts, pagination } = props.nft.nftsData;\n      if (nfts) {\n        setNFTs(nfts);\n        setNFTPagination(pagination);\n        setFilterationLoader(false);\n        props.beforeNFT();\n\n        setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  //pagination\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setCollections(props.collections);\n      props.beforeCollection();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter,\n    keyword,\n    buy,\n    auction,\n    latest\n  ) => {\n    console.log(gtePriceFilter, \"gtePriceFilter\");\n    const nftQS = { page, limit };\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    if (keyword) nftQS.keyword = keyword;\n    if (buy) nftQS.buy = buy;\n    if (auction) nftQS.auction = auction;\n    if (latest) nftQS.latest = latest;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n    console.log(value, \"value\");\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      filter.gtePrice,\n      filter.ltePrice,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    console.log(filter, \"filter\");\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      id,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleSearchKeyword = () => {\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleStatusFilter = (id) => {\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      id == \"Buy Now\" ? true : false,\n      id == \"On Auction\" ? true : false,\n      id == \"New\" ? true : false\n    );\n  };\n  const handleLikesTogleApi = (nftId, status, likesCount) => {\n    if (!likeButtonDisable) {\n      setLikeBtnDisable(true);\n      let userId = ENV.getUserKeys(\"_id\")._id;\n      console.log(likesCount, \"likesCount\");\n      let body = {\n        userId,\n        nftId,\n        count: 1,\n      };\n\n      if (status === \"dislike\" && likesCount > 0) {\n        let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n        setLikedNfts(result);\n        increOrDecreLikes(nftId, \"dec\");\n      \n        props.toggleLikeDislike(body);\n      }\n\n      if (status === \"like\") {\n        let myLikedNfts = [];\n        if (likedNfts && likedNfts.length > 0) {\n          myLikedNfts = likedNfts;\n        }\n\n        let obj = {\n          _id: \"1234455\",\n          nftId,\n        };\n\n        myLikedNfts.push(obj);\n\n        setLikedNfts(myLikedNfts);\n        increOrDecreLikes(nftId, \"inc\");\n        props.toggleLikeDislike(body);\n      }\n      // setNFTs(nfts);\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Explore\"} title2={\"AllNFT\"} />\n      <div className=\"collection-detail-content all-nft-content\">\n        <div className=\"container padding-wrapper pb-1\">\n          <div className=\"collections-listing\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img\n                    src={SearchIcon}\n                    alt=\"search-icon\"\n                    className=\"ms-3\"\n                    onClick={handleSearchKeyword}\n                  />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                    onChange={(e) => setKeyword(e.target.value)}\n                    onKeyPress={(e) =>\n                      e.key === \"Enter\" && handleSearchKeyword()\n                    }\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {sortoptions &&\n                      sortoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Collections={collections}\n                      collectionsLabel={\"Collections\"}\n                      onChangeMinPrice={onChangeMinPrice}\n                      onChangeMaxPrice={onChangeMaxPrice}\n                      minValue={minValue}\n                      maxValue={maxValue}\n                      applyMinMaxFilter={applyMinMaxFilter}\n                      handleCollectionsFilter={handleCollectionsFilter}\n                      handleStatusFilter={handleStatusFilter}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-12\">\n                <div className=\"no-of-items text-end mb-3\">\n                  <p>\n                    {nfts?.length}\n                    {\"  items\"}\n                  </p>\n                </div>\n              </div>\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Collections={collections}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                  handleStatusFilter={handleStatusFilter}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9\">\n                {loader ? (\n                  <FullPageLoader />\n                ) : (\n                  <div className=\"row g-3\">\n                    {filterationLoader ? (\n                      <div className=\"text-center\">\n                        <div\n                          class=\"spinner-border text-secondary text-white \"\n                          role=\"status\"\n                        >\n                          <span class=\"sr-only\">Loading...</span>\n                        </div>\n                      </div>\n                    ) : nfts && nfts.length > 0 ? (\n                      nfts.map((listing) => {\n                        return (\n                          <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                            {listing.fileType === \"image\" ? (\n                              <ListingCards\n                                CardImg={listing.image}\n                                name={listing.name}\n                                price={listing.currentPrice}\n                                handleLikesTogleApi={handleLikesTogleApi}\n                                id={listing._id}\n                                likesCount={listing.likeCount}\n                                likedNfts={likedNfts}\n                                ownerId={listing.ownerId}\n                                fileType={listing.fileType}\n                                sellingMethod={listing.sellingMethod}\n                              />\n                            ) : (\n                              <VideoCard\n                                CardImg={listing.image}\n                                name={listing.name}\n                                price={listing.currentPrice}\n                                handleLikesTogleApi={handleLikesTogleApi}\n                                id={listing._id}\n                                likesCount={listing.likeCount}\n                                likedNfts={likedNfts}\n                                ownerId={listing.ownerId}\n                                fileType={listing.fileType}\n                                sellingMethod={listing.sellingMethod}\n                              />\n                            )}\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-white text-center mt-5 no-nft-title\">\n                        No NFTs Found\n                      </p>\n                    )}\n                    <div className=\"col-12\">\n                      <div className=\"mt-5 text-center\">\n                        {nftPagination?.total === nfts?.length\n                          ? \"\"\n                          : !filterationLoader && (\n                              <button\n                                className=\"btn btn-linear-gradient px-5\"\n                                onClick={() => handlePagination()}\n                              >\n                                Load more\n                              </button>\n                            )}\n                      </div>\n                    </div>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"all-nft-footer\">\n        <Footer />\n      </div>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFTs,\n  getCreators,\n  toggleLikeDislike,\n  getCollections,\n  getMyLikedNfts,\n  beforeCollection,\n  beforeUser,\n  beforeTogleLikeDislike,\n})(AllNFT);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["1696"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/reducer/reducer.js",["1697"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.reducer.js",["1698"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.reducer.js",["1699"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/faq/faq.reducer.js",["1700"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["1701"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            console.log(action.payload.offers,\"reducer\")\n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["1702"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            return {\n                ...state,\n                bids: action.payload.allBids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["1703"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout2/layout2.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["1704","1705","1706","1707"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n    axiosPostFormData,\n    decimalNumberValidator,\n  } from \"./../../utils/functions\";\n  import axios from 'axios'\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    \n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\nconsole.log(url,\"upsert nft ==}}}}}}}}}}}}}}}}}}}}}\")\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        console.log(data,\"response of upser nft \")\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    \nconsole.log(url,\"getNFTs\")\n\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n     \n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n\n      // alert(\"called\")\n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n   \n    });\n};\n\nexport const getNFTsByCollection=(id)=>(dispatch)=>{\n  \n\n  let data ={\n    collectionId:id\n  }\n\n\n  dispatch(emptyError());\n\n    const url = `${ENV.url}nfts/getNFTsByCollection`;\n    axios.post(url,data)\n    .then(function (response) {\n  \n      if (response.data.success) {\n              dispatch({\n                type:GET_NFTS_BY_COLLECTION,\n                payload:response.data.data\n              })\n         \n            } else {\n              dispatch({\n                type: GET_ERRORS,\n                payload: response.data,\n              });\n            }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n              type: GET_ERRORS,\n              payload: error,\n            });\n    });\n  \n  \n}\n\nexport const getMyLikedNfts=(qs='')=>(dispatch)=>{\n\n\n  dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url=url+qs\n    axios.get(url)\n    .then(function (response) {\nconsole.log()\n      if (response.data.success) {\n        dispatch({\n          type: GET_MYLIKED_NFTS,\n          payload: response.data.data,\n        });\n         \n            } else {\n             \n            }\n    })\n    .catch(function (error) {\n      console.log(error);\n    \n    });\n  \n  \n}\n\nexport const createNFT= async (formData)=>{\n    try {\n\n        const res = await axiosPostFormData(\n            \"nfts/create\",\n            formData,\n            true\n          );\n    }\n    catch(err){\n\n    }\n}\nexport const setNftToken = (formData) => async (dispatch) => {\n\n  const res = await axiosPostFormData(\n            \"nfts/storeNFTData\",\n            formData,\n            true\n          );\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        console.log(data,\"profile nfts\")\n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n          \n        } else {\n     \n        }\n      })\n      .catch((errors) => {\n     \n      });\n  };\n\n\n\n\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topseller2.js",["1708","1709","1710","1711"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["1712","1713","1714","1715","1716","1717","1718","1719","1720","1721","1722","1723","1724","1725","1726","1727","1728","1729","1730"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\nimport moment from \"moment\";\r\nimport Countdown from \"react-countdown\";\r\nimport { Swiper, SwiperSlide } from \"swiper/react\";\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\nimport { useTimer } from \"react-timer-hook\";\r\nimport { getCreators, beforeUser } from \"./../user/user.action\";\r\nimport image from \"../../assets/images/placeholder.png\";\r\nimport DemoImg from \"../../assets/images/cl-cr-mainimg.png\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n// Swiper.use([Navigation, Pagination]);\r\nconst { globalPlaceholderImage, countDownRenderer } = ENV;\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [creators, setCreator] = useState([]);\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"\");\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n  useEffect(() => {\r\n    // console.log('auth', props.user.topSellersAuth)\r\n    if (props.user.topSellersAuth) {\r\n      setCreator(props.user.sellers);\r\n      setLoader(false);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n      setAuctions(auctions);\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n  const filterCreator = (nft, field) => {\r\n    // console.log('creators', creators)\r\n    // console.log('nft owner', nft)\r\n    const result = creators.find((item) => item._id === nft.nftOwnerId);\r\n    // console.log('reuslt',result\r\n    if (result) {\r\n      if (field === \"userName\") {\r\n        if (result?.username) {\r\n          return result?.username;\r\n        } else {\r\n          return \"no username found\";\r\n        }\r\n      } else if (field == \"profileImage\") {\r\n        if (result.profileImage) {\r\n          return result?.profileImage;\r\n        } else {\r\n          return image;\r\n        }\r\n      }\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products. We want to be a part of your\r\n                    smile, success and future growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\r\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-center justify-content-sm-end align-content-xxl-start text-end\">\r\n                {categories &&\r\n                  categories.length > 0 &&\r\n                  categories.map((item, index) => {\r\n                    if (index <= 3) {\r\n                      return (\r\n                        <button\r\n                          className=\"me-1 me-sm-2\"\r\n                          onClick={() => handleCategoryFilter(item.description)}\r\n                        >\r\n                          {item.name}\r\n                        </button>\r\n                      );\r\n                    }\r\n                  })}\r\n                <div className=\"intro-btn\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/auctions\"\r\n                  >\r\n                    View All\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auctions-slides\">\r\n            <div className=\"\">\r\n              {auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        endDate={item.auctionEndDate}\r\n                        image={item.image}\r\n                        ownerName={item.owner.username}\r\n                        name={item.name}\r\n                        id={item._id}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className=\"text-white text-center\">No Live Auctions Found</p>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore-home.js",["1731","1732","1733","1734","1735","1736"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/popular-collections.js",["1737","1738","1739","1740","1741"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\nimport Collections from \"./collections\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { connect } from \"react-redux\";\nimport { CollectionImages } from \"../../assets/assets.js\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst collectionData = [\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n];\n\nconst PopularCollections = (props) => {\n  return (\n    <>\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-0\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products. We want to be a part of your\n                    smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-center justify-content-sm-end align-content-xxl-start text-end\">\n                <button className=\"me-1 me-sm-2 active\">Arts</button>\n                <button className=\"me-1 me-sm-2\">Music</button>\n                <button className=\"me-1 me-sm-2\">Game</button>\n                <button className=\"me-1 me-sm-5\">Sport</button>\n                <div className=\"intro-btn\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\n                    to=\"/popular-collections\"\n                  >\n                    View All\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <CardSlider\n            settings={ENV.popularCollectionsSettings}\n            homeAuction={false}\n            data={[1, 2, 3, 4]}\n          >\n            {collectionData.map((collectionData) => {\n              return (\n                <CollectionsCard\n                  CardImg={collectionData.mainImg}\n                  Subimg1={collectionData.subImg1}\n                  Subimg2={collectionData.subImg2}\n                  Subimg3={collectionData.subImg3}\n                />\n              );\n            })}\n          </CardSlider>\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, { beforeCategory, getCategories })(\n  PopularCollections\n);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.js",["1742","1743","1744","1745","1746","1747","1748","1749"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  useEffect(() => {\n    if (props.settings.settingsAuth) {\n      setData(props.settings.settings);\n    }\n  }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div class=\"input-group notify-form\">\n                  <div class=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      class=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.action.js",["1750"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n        console.log(response);\n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.actions.js",["1751","1752"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.action.js",["1753","1754"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport { GET_ERRORS, SET_USER, GET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, BEFORE_USER,UPDATE_API_STATEC } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { getCollections, setAuthState } from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n    return {\n        type: BEFORE_USER\n    }\n}\n\n// method to set user data\nexport const setUser = (user) => dispatch => {\n    dispatch(emptyError())\n    dispatch({\n        type: SET_USER,\n        payload: user\n    })\n}\n\n// method to get user data\nexport const getUser = () => dispatch => {\n    dispatch({\n        type: GET_USER\n    })\n}\n\n// method to login using wallet address and sign\nexport const login = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/login/`;\n    // const url = `http://localhost:5000/v1/front/auth/login/`;\n    console.log(payload,\"payload\")\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            const userId = data.data._id;\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => dispatch => {\n    \n    dispatch(emptyError());\n    const url = `${ENV.url}auth/register/`;\n \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        console.log(errors,\"register resonse\")\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/updateProfile`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"update profile response\")\n        if (data.status) {\n            // ENV.encryptUserData(data.data);\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n            toast.success(data.message)\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        console.log(errors,\"update profile response\")\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getTopSellers = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/top-sellers`;\n   \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n     \n        if (data.status) {\n            dispatch({\n                type: TOP_SELLERS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n     \n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getCreators = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/creators`;\n    // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n    \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n      \n        if (data.status) {\n            dispatch({\n                type: SET_CREATORS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/${userId}`;\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"user response by id\")\n        if (data.success) {\n            \n            dispatch({\n                type: SET_INDIVIDUAL_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => dispatch => {\n    dispatch(emptyError());\n    dispatch({\n        type: SET_INDIVIDUAL_USER,\n        payload: user\n    })\n};\n\nexport const logoutUser = () => (dispatch) => {\n    dispatch({\n        type: SET_USER,\n        userAuth: false,\n        userData: null\n    })\n    dispatch(setAuthState())\n    localStorage.removeItem('encuse');\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/work/work.js",["1755","1756","1757"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero/hero.js",["1758","1759","1760"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport ExploreIcon from \"../../assets/images/explore-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                <svg width=\"22px\" height=\"16px\">\r\n                  <path\r\n                    fill-rule=\"evenodd\"\r\n                    fill=\"rgb(255, 255, 255)\"\r\n                    d=\"M10.788,0.151 C10.596,0.153 10.412,0.232 10.279,0.370 C10.145,0.508 1