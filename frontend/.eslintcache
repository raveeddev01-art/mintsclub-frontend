ettings.settings', you can also switch to useReducer instead of useState and read 'props.settings.settings' in the reducer.",["420"],{"range":"421","text":"415"},{"range":"422","text":"415"},{"range":"423","text":"415"},{"range":"424","text":"415"},{"range":"425","text":"415"},"'linkError' is assigned a value but never used.","'httpValidation' is assigned a value but never used.","'setCaptchaMessage' is assigned a value but never used.","'setDeployNetwork' is assigned a value but never used.","'deploy' is assigned a value but never used.","'setMaxLimit' is assigned a value but never used.","react/jsx-no-duplicate-props","No duplicate props allowed","JSXAttribute","noDuplicateProps",{"range":"426","text":"415"},"'loader' is assigned a value but never used.","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression",["427"],"'formatAddress' is assigned a value but never used.","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","'IconButton' is defined but never used.","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'Typography' is defined but never used.","'ListItemText' is defined but never used.","'InfoComp' is defined but never used.","no-sequences","Unexpected use of comma operator.","SequenceExpression","unexpectedCommaExpression","'genStyle' is assigned a value but never used.","'userId' is assigned a value but never used.","'errorMessage' is assigned a value but never used.","array-callback-return","Array.prototype.map() expects a value to be returned at the end of arrow function.","expectedAtEnd","'ALL_COLLECTIONS' is defined but never used.",{"desc":"428","fix":"429"},[1819,1819]," rel=\"noreferrer\"",[2073,2073],[2336,2336],[2587,2587],{"desc":"430","fix":"431"},{"desc":"432","fix":"433"},[1644,1644],[2086,2086],[2526,2526],[2966,2966],[3396,3396],[15421,15421],{"desc":"430","fix":"434"},"Update the dependencies array to be: [tawkToKey, tawkToPropertyId]",{"range":"435","text":"436"},"Update the dependencies array to be: [props]",{"range":"437","text":"438"},"Update the dependencies array to be: [props.settings.settings, props.settings.settingsAuth]",{"range":"439","text":"440"},{"range":"441","text":"438"},[617,622],"[tawkToKey, tawkToPropertyId]",[513,515],"[props]",[645,674],"[props.settings.settings, props.settings.settingsAuth]",[1276,1278]]