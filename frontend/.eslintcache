ole.log(address,\"addresss==>\")\n    //    liveAuction.methods.openNFTForBiddingForSpecific(tokenId,timeduration).send({from:address}).then((res)=>{\n    //         //  console.log(res ,\"res of openNFTForBidding===>\")\n           \n    // })\n    // .catch((err)=>{\n    //     toast.error(\"Transaction Failed Please check wallet history\")\n    // })\n    // }\n    \n    // export const setNftToken=(body)=>{\n    //     // console.log(body,\"body===>\")\n    //     // let dummy={\n    //     //     nftToken:\"123\",\n    //     //     nftId:\"123\"\n\n    //     // }\n\n    //     let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n\n    //     fetch(url, {\n    //      method: 'POST',\n    //      headers: {\n    //         'content-type': 'application/json',\n    //         'Authorization': ENV.Authorization,\n    //         'x-auth-token': ENV.x_auth_token,\n    //         'Access-Control-Allow-Origin': '*',\n    //         'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n    //     },\n    //     body: JSON.stringify(body)\n    // }).then(res => res.json()).then(data => {\n    //     // alert(\"in setting nft then\")\n    //     // console.log(data,\"data==>\")\n    //     if (data.success) {\n    //         window.location.href= '/explore-all'\n    //     //    console.log(data,\"data in success\")\n    //     } else {\n         \n    //     }\n    // }).catch(error => {\n    //     // alert(\"in setting nft then\")\n    //     console.log(error,\"error in catch blcok\")\n    //     if (error.response && error.response.data) {\n        \n    //     }\n     \n    // })\n    // }\n\n    // export const NftOwner=async ()=>{\n    //     const web3 = new Web3(Web3.givenProvider);\n\n    //     let accounts = await web3.eth.getAccounts();\n    //     // console.log(accounts,\"accounts\")\n    //     let address = accounts[0];\n    // //     console.log(address,\"addresss==>\")\n    // // //OwnerNFT\n    //    liveAuction.methods.ownerOf(5).send({from:address}).then((res)=>{\n    //         //  console.log(res,\"res of createNFT===>\")\n    // })\n    // .catch((err)=>{\n    //     console.log(err,\"err in catch block error===>\")\n    // })\n    // }\n\n    // export const placeBidNft=async(body,tokenId,price,toAddress,fromAddress)=>{\n    //     const web3 = new Web3(Web3.givenProvider);\n\n    //     let accounts = await web3.eth.getAccounts();\n    //     // console.log(accounts,\"accounts\")\n    //     let address = accounts[0];\n    //     // console.log(address,\"addresss==>\")\n    //     // console.log(price,\"price888888888888888888888\")\n    //     // console.log(toAddress,\"toAdress\")\n   \n    //         liveAuction.methods.placeBid(tokenId).send({value:price.amount,from:address}).then((res)=>{\n    //             console.log('bid before', res)\n    //             console.log('body', body)\n    //             placeBidApi(body,tokenId,price,toAddress,fromAddress)\n    //             // window.location.href= '/explore-all'\n    //         //  console.log(res,\"res of place bid result===>\")\n    //     })\n    //     // alert(price)\n    //   .catch((err)=>{\n    //         toast.error(\"Transaction Failed Please check wallet history\")\n    //       })\n    // }\n\n//     export const SellOnFixedPrice=async (tokenId,price)=>{\n//         const web3 = new Web3(Web3.givenProvider);\n\n//         let accounts = await web3.eth.getAccounts();\n//         // console.log(accounts,\"accounts\")\n//         let address = accounts[0];     \n//             //   Put on sale\n//             // console.log('live auction', liveAuction)\n//             liveAuction.methods.PutOnSale(tokenId).send({from:address}).then((res)=>{\n                \n//                 // setFixedPriceNftTOken()\n\n//     })\n     \n// .catch((err)=>{\n//     toast.error(\"Transaction Failed Please check wallet history\")\n// })\n//     }\n\n//     export const BuyFixedPriceNFTs=async (price,tokenId,nftOwnerId)=>{\n//         // console.log(tokenId,\"token id in buy fixed price==>\")\n//         const web3 = new Web3(Web3.givenProvider);\n\n//         let accounts = await web3.eth.getAccounts();\n//         // console.log(accounts,\"accounts\")\n//         let address = accounts[0];\n//         // console.log(address,\"addresss==>\")\n//         // console.log(price,\"price888888888888888888888\")\n//         // alert(price)\n//         let finalPrice = price.toString()\n//         // console.log('final price', finalPrice)\n       \n//             liveAuction.methods.BuyFixedPriceNFTs(tokenId).send({value:finalPrice,from:address}).then((res)=>{\n//                 // console.log(res,\"res of place bid result===>\")\n//                 let currentUserId=ENV.getUserKeys('_id')._id;\n//                 changeOwnerShip(nftOwnerId,currentUserId)\n\n\n//         })\n//             //   Place Bid\n       \n// .catch((err)=>{\n//     toast.error(\"Transaction Failed Please check wallet history\")\n// })\n//     }\n\n//     export const getCurrentAddress= async ()=>{\n//         const web3 = new Web3(Web3.givenProvider);\n\n//         let accounts = await web3.eth.getAccounts();\n//         // console.log(accounts,\"accounts\")\n//         let address = accounts[0];\n//         return address\n//     }\n\n//     export const acceptNftOffer=async(tokenId,body)=>{\n\n\n//         const web3 = new Web3(Web3.givenProvider);\n\n//         let accounts = await web3.eth.getAccounts();\n//         // console.log(accounts,\"accounts\")\n//         let address = accounts[0];\n//         // console.log(address,\"addresss==>\")\n//         // console.log('token before sending', tokenId)\n//             //  Accept offer \n//        liveAuction.methods.acceptOffer(tokenId).send({from:address}).then((res)=>{\n           \n//         // console.log(res,\"res of accept bid result===>\")\n//         // toast.success(\"Bid accepted successfully\")\n//         acceptBit(tokenId,body)\n    \n// })\n// .catch((err)=>{\n//    console.log(err,\"err in catch block error===>\")\n// })\n//     }\n// export const signTransaction=async ()=>{\n\n//     const web3 = new Web3(Web3.givenProvider);\n//     // const nonce = await web3.eth.getTransactionCount(\"myAddress\", 'latest');\n//     const rawTransaction = {\n//         \"from\": \"Keystore account id\",\n//         \"to\": \"Account you want to transfer to\",\n//         \"value\": 100,\n//         \"gas\": 0.21000,\n    \n//       };\n\n//       const signedTx = await web3.eth.accounts.signTransaction(rawTransaction, \"PRIVATE_KEY\");\n\n//       web3.eth.sendSignedTransaction(signedTx.rawTransaction, function(error, hash) {\n//         if (!error) {\n//         //   console.log(\"🎉 The hash of your transaction is: \", hash, \"\\n Check Alchemy's Mempool to view the status of your transaction!\");\n//         } else {\n//         //   console.log(\"❗Something went wrong while submitting your transaction:\", error)\n//         }\n//        });\n   \n// }\n\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step2/Step2.js",["284","285","286","287"],"import { useState } from \"react\";\nimport \"./Step2.css\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\n\nconst Step2 = (props) => {\n  // console.log(props,\"props in step 2\")\n  const [name, setName] = useState(props.name);\n  const [symbol, setSymbol] = useState(props.symbol);\n  const [externalLink, setExternalLink] = useState(props.externalLink);\n  const [description, setDescription] = useState(props.description);\n  const [supply, setSupply] = useState(props.supply);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [error, setError] = useState(false);\n  const [linkError,setLinkError]=useState(false)\n  const patternValidation = val => {\n    return /\\s/g.test(val);\n  };\n\n  const httpValidation = (val) => {\n    return /https|http:\\/\\/.*.com/g.test(val);\n  };\n\n  const onChangeName = (e) => {\n    if(!name) {\n      if (patternValidation(e.target.value.trimStart())) {\n      e.preventDefault();\n      } else {\n      setName(e.target.value.trimStart());\n      }\n    } else {\n      setName(e.target.value.trimStart());\n    }\n  };\n\n  const onChangeSymbol = (e) => {\n    if(!symbol)\n    {\n      if (patternValidation(e.target.value.trimStart())) {\n        e.preventDefault();\n      } else {\n        setSymbol(e.target.value.trimStart());\n      }\n    }\n    else {\n      setSymbol(e.target.value.trimStart());\n    }\n  };\n\n  const onChangeExternalLink = (e) => {\n    const { value } = e.target;\n    if(value && value.length>0) {\n      setLinkError(false);\n      setExternalLink(value.trimStart());\n    }\n    else {\n      setExternalLink(value)\n    }\n  };\n\n  const onChangeDescription = (e) => {\n    if(!description) {\n      if (patternValidation(e.target.value.trimStart())) {\n        e.preventDefault();\n      }else {\n        setDescription(e.target.value.trimStart());\n      }\n    } else {\n      setDescription(e.target.value.trimStart());\n    }\n  };\n\n  const onChangeSupply = (e) => {\n    setSupply(e.target.value);\n  };\n\n  const onSubmit = (e) => {\n    e.preventDefault()\n    // console.log(name, \"name==>\");\n    if (name.trim() === \"\") {\n      setErrorMessage(\"Please Fill required fields!\");\n      setName('')\n      setError(true);\n      return \"\";\n    }\n    // console.log(name.trim().length <3)\n    if(name.trim().length <3)\n    {\n      setErrorMessage(\"Name should have atleast 3 characters\");\n      setError(true);\n      return \" \"\n\n    }\n    if(externalLink){\n\n      if (\n        !externalLink.match(\n          /(http(s)?:\\/\\/.)?(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{2,256}\\.[a-z]{2,6}\\b([-a-zA-Z0-9@:%_\\+.~#?&//=]*)/g\n        )\n      ) {\n        // alert(\"external link must be a valid uri\")\n        setLinkError(true)\n        return  \"\"\n      }\n    }\n    // console.log(name,\"nmae\")\n    props.handleStep2Info(name, symbol, externalLink, description, supply);\n    props.currentStepAction();\n  };\n  return (\n    <div className=\"step2-container \" style={{marginBottom:\"14%\"}}>\n      <form onSubmit={onSubmit}>\n        \n      <div className=\"row\">\n        <p style={{ color: \"red\" }}>{error && errorMessage} </p>\n        <div className=\"col-md-6 col-sm-12\">\n          <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n            <div className=\"position-relative\">\n              <label className=\"text-white step-2-label\">Name</label>\n              <p\n                className=\"position-absolute\"\n                style={{ color: \"red\", top: \"0\", left: \"3.8rem\" }}\n              >\n                *\n              </p>\n            </div>\n            <input\n              className=\"step-2-input mt-2\"\n              type=\"text\"\n              onChange={(e) => onChangeName(e)}\n              value={name}\n              placeholder=\"item name\"\n              required={true}\n              maxLength=\"50\"\n              minLength=\"3\"\n            />\n          </div>\n\n          <div className=\"d-flex mt-4\" style={{ flexDirection: \"column\" }}>\n            <label className=\"text-white step-2-label\">Symbol</label>\n\n            {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              {\" \"}\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n            <input\n              className=\"step-2-input mt-2\"\n              type=\"text\"\n              onChange={(e) => onChangeSymbol(e)}\n              value={symbol}\n              placeholder=\"NFT Symbol\"\n              maxLength=\"50\"\n            />\n          </div>\n\n          <div className=\"d-flex  mt-4\" style={{ flexDirection: \"column\" }}>\n            <label className=\"text-white step-2-label\">External Link</label>\n            {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n            {/* <p style={{color:\"red\"}}>{linkError &&\"External Link must be a valid Url\"}</p> */}\n            <input\n              className=\"step-2-input mt-1\"\n              type=\"url\"\n              onChange={(e) => onChangeExternalLink(e)}\n              value={externalLink}\n              placeholder=\"https://yousite.com/item.1004\"\n              maxLength=\"50\"\n            />\n          </div>\n          <button\n            type=\"submit\"\n            className=\"btn btn-secondary start-btn mt-5\"\n            // onClick={() => onSubmit()}\n          >\n            Next\n          </button>\n        </div>\n\n        <div className=\"col-md-6 col-sm-12 mt-5 mt-md-0\">\n          <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n            <label className=\"text-white step-2-label\">Supply</label>\n            <p className=\"mb-0\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              The number of copies that can be minted{\" \"}\n            </p>\n            <input\n              className=\"step-2-input mt-2\"\n              type=\"number\"\n              onChange={(e) => onChangeSupply(e)}\n              value={supply}\n              placeholder=\"supply\"\n              max=\"100\"\n              min=\"1\"\n            />\n            {/* <select\n              className=\"form-select mt-2 network-dropdown\"\n              style={{\n                color: \"white\",\n                border: \"none\",\n                outline: \"none\",\n                maxWidth: \"22rem\",\n              }}\n              aria-label=\"Default select example\"\n              value={supply}\n              onChange={(e) => onChangeSupply(e)}\n            >\n              <option className=\"network-option\" value=\"1\" defaultValue={\"1\"}>\n                1\n              </option>\n              <option className=\"network-option\" value=\"2\">\n                2\n              </option>\n              <option className=\"network-option\" value=\"3\">\n                3\n              </option>\n              <option className=\"network-option\" value=\"4\">\n                4\n              </option>\n              <option className=\"network-option\" value=\"5\">\n                5\n              </option>\n            </select> */}\n          </div>\n          {/* //////////////////////// */}\n          <div className=\"d-flex  mt-4\" style={{ flexDirection: \"column\" }}>\n            <label className=\"text-white step-2-label\">Description</label>\n\n            {/* <p className=\"\" style={{ maxWidth: \"80%\", color: \"#A9A9A9\" }}>\n              Lorem Ipsum is simply dummy text of the printing and typesetting\n              industry.Printing and typesetting industry{\" \"}\n            </p> */}\n            <textarea\n              className=\"description p-3 mt-2\"\n              placeholder=\"Add Description\"\n              onChange={onChangeDescription}\n              value={description}\n              style={{ color: \"white\" }}\n              maxLength=\"600\"\n            />\n          </div>\n        </div>\n      </div>\n\n      </form>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step2);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/Step3.js",["288","289","290","291","292","293","294"],"import { useState } from \"react\";\n\nimport PropertiesImage from \"../../../../assets/images/Properties.svg\";\nimport AddBtnImage from \"../../../../assets/images/Add Button.svg\";\nimport LevelsBtn from \"../../../../assets/images/Levels.svg\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport PropertiesModal from \"../../../../components/PropertiesModal/ProppertiesModal\";\nimport LevelsModal from \"../../../../components/LevelsModal/LevelsModal\";\nimport \"./Step3.css\";\n////For Accordian\nimport * as React from \"react\";\nimport Accordion from \"@mui/material/Accordion\";\nimport AccordionSummary from \"@mui/material/AccordionSummary\";\nimport AccordionDetails from \"@mui/material/AccordionDetails\";\nimport Typography from \"@mui/material/Typography\";\nimport ExpandMoreIcon from \"@mui/icons-material/ExpandMore\";\nimport { Grid, ListItem, ListItemText } from \"@mui/material\";\nimport { Box } from \"@mui/system\";\n/////////////////\n\nconst Step3 = (props) => {\n  const [open, setOpen] = useState(false);\n  const [openLevelModal, setOpenLevelModal] = useState(false);\n\n  //for levels Modal\n  const [levelsInputs, setlevelsInputs] = useState(props.levels);\n  const [addMore, setAddMore] = useState(false);\n\n  //for properties Modal\n  const [propertiesValues, setPropertiesValues] = useState(props.properties);\n  const [addMoreProperty, setAddMoreProperty] = useState(false);\n\n  ///////\n  const handleOpen = () => setOpen(true);\n  const handleClose = () => setOpen(false);\n\n  const handleOpenLevel = () => setOpenLevelModal(true);\n  const handleCloseLevel = () => {\n    setOpenLevelModal(false);\n  };\n  //levels Methods\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n\n  let handleChange = (i, e) => {\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    // console.log(newFormValues,\"levels handle change\")\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    // let newFormValues = [...levelsInputs];\n    if (levelsInputs.length > 1) {\n      let newFormValues = [...levelsInputs];\n      newFormValues.splice(i, 1);\n      setlevelsInputs(newFormValues);\n    }\n  };\n\n  //propertiesMethods\n  const addMoreProperties = () => {\n    setAddMoreProperty(!addMoreProperty);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n  let handleChangeProperties = (i, e) => {\n    let newFormValues = [...propertiesValues];\n    // console.log(newFormValues,\"new form values before\")\n    newFormValues[i][e.target.name] = e.target.value;\n    // console.log(newFormValues,\"properties handle change\")\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormProperties = (i) => {\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n  const onSubmit = (propertiesField) => {\n    setPropertiesValues(propertiesField);\n    props.handleStep3PropertiesInfo(propertiesField);\n    // props.currentStepAction()\n  };\n  const onSubmitLevels = (levelsFields) => {\n    setlevelsInputs(levelsFields);\n    props.handleStep3LevelsInfo(levelsFields);\n  };\n  function onClickDelete(event) {\n    event.stopPropagation();\n    // Handle click here\n  }\n  // const {propertiesValues}=props;\n  return (\n    <div className=\"step3-container \" style={{ height: \"45vh\" }}>\n      {/* ///////////////////// */}\n      <Accordion className=\"transBG\" style={{backgroundColor:'unset !important'}}>\n        <AccordionSummary\n          className=\"transBG\"\n          expandIcon={<ExpandMoreIcon />}\n          aria-controls=\"panel1a-content\"\n          id=\"panel1a-header\"\n        >\n          {/* <Typography>Accordion 1</Typography> */}\n          <div\n            className=\"properties-container d-flex justify-content-between \"\n            onClick={onClickDelete}\n          >\n            <div>\n              <div className=\"d-flex align-items-center \">\n                <img src={PropertiesImage} style={{ height: \"2rem\" }} />\n                <p className=\"mb-0 text-white\" style={{ marginLeft: \"1rem\" }}>\n                  Properties\n                </p>\n                <img\n                  src={AddBtnImage}\n                  onClick={() => handleOpen()}\n                  className=\"ml-3\"\n                  style={{ height: \"1.5rem\", cursor: \"pointer\" }}\n                />\n              </div>\n              <p className=\"text-white mt-1\">\n                Textual traits that show up as a rectangles\n              </p>\n            </div>\n\n            {/* <div className=\"content-center\"  >\n          <img src={AddBtnImage} style={{ height: \"1.5rem\",cursor:\"pointer\"  }} />\n        </div> */}\n          </div>\n        </AccordionSummary>\n        <AccordionDetails className=\"transBG\">\n          {\n            propertiesValues && propertiesValues.length >0 &&\n          <ListItem>\n            \n            <Grid className=\"mt-4 text-white list-title\" item xs={6}>\n              {\"Name\"}\n            </Grid>\n            <Grid className=\"mt-4 text-white list-title\" item xs={6}>\n              {\"Value\"}\n            </Grid>\n            \n          </ListItem>\n          }\n          <ListItem>\n            <Grid container xs={12}>\n              {propertiesValues && propertiesValues.length > 0 ? (\n                propertiesValues.map((property, i) => {\n                  return (\n                    <>\n                      <Grid className=\"mt-4 text-white list-item\" item xs={6}>\n                        {property.name}\n                      </Grid>\n                      <Grid className=\"mt-4 text-white list-item\" item xs={6}>\n                        {property.value}\n                      </Grid>\n                    </>\n                  );\n                })\n              ) : (\n                <p className=\"text-white\">{\"No Properies Found\"} </p>\n              )}\n            </Grid>\n          </ListItem>\n        </AccordionDetails>\n      </Accordion>\n\n      {/* /////////////////// */}\n      <Accordion className=\"transBG\">\n        <AccordionSummary\n          className=\"transBG\"\n          expandIcon={<ExpandMoreIcon />}\n          aria-controls=\"panel1a-content\"\n          id=\"panel1a-header\"\n        >\n          {/* <Typography>Accordion 1</Typography> */}\n          <div\n            className=\"properties-container d-flex justify-content-between mt-4 \"\n            onClick={onClickDelete}\n          >\n            <div>\n              <div className=\"d-flex align-items-center \">\n                <img src={LevelsBtn} style={{ height: \"2rem\" }} />\n                <p className=\"mb-0 text-white\" style={{ marginLeft: \"1rem\" }}>\n                  Levels\n                </p>\n                <img\n                  src={AddBtnImage}\n                  onClick={() => handleOpenLevel()}\n                  className=\"ml-5\"\n                  style={{ height: \"1.5rem\", cursor: \"pointer\" }}\n                />\n              </div>\n              <p className=\"text-white mt-1\">\n                Numerical traits that show as a progress bar\n              </p>\n            </div>\n\n            {/* <div className=\"content-center\" onClick={() => handleOpenLevel()}>\n          <img src={AddBtnImage} style={{ height: \"1.5rem\",cursor:\"pointer\" }} />\n        </div> */}\n          </div>\n        </AccordionSummary>\n        <AccordionDetails>\n          {\n            levelsInputs && levelsInputs.length >0 &&\n          <ListItem>\n            <Grid className=\"mt-4 text-white list-title\" item xs={4}>\n              {\"Name\"}\n            </Grid>\n            <Grid className=\"mt-4 text-white list-title\" item xs={4}>\n              {\"Value\"}\n            </Grid>\n            <Grid className=\"mt-4 text-white list-title\" item xs={4}>\n              {\"Total\"}\n            </Grid>\n          </ListItem>\n          }\n\n          <ListItem>\n            <Grid container xs={12}>\n              {levelsInputs && levelsInputs.length > 0 ? (\n                levelsInputs.map((level, i) => {\n                  return (\n                    <>\n                      <Grid className=\"mt-4 text-white list-item\" item xs={4}>\n                        {level.name}\n                      </Grid>\n                      <Grid className=\"mt-4 text-white list-item\" item xs={4}>\n                        {level.value}\n                      </Grid>\n                      <Grid className=\"mt-4 text-white list-item\" item xs={4}>\n                        {level.total}\n                      </Grid>\n                    </>\n                  );\n                })\n              ) : (\n                <p className=\"text-white\">{\"No Levels Found\"}</p>\n              )}\n            </Grid>\n          </ListItem>\n        </AccordionDetails>\n      </Accordion>\n\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary start-btn mt-5 mb-5\"\n        onClick={() => props.currentStepAction()}\n      >\n        Next\n      </button>\n\n      <PropertiesModal\n        open={open}\n        handleOpen={handleOpen}\n        handleClose={handleClose}\n        addMoreProperties={addMoreProperties}\n        handleChangeProperties={handleChangeProperties}\n        removeFormProperties={removeFormProperties}\n        propertiesValues={propertiesValues}\n        addMoreProperty={addMoreProperty}\n        onSubmit={onSubmit}\n      />\n      <LevelsModal\n        open={openLevelModal}\n        handleOpen={handleOpenLevel}\n        handleClose={handleCloseLevel}\n        addMoreValues={addMoreValues}\n        handleChange={handleChange}\n        removeFormFields={removeFormFields}\n        levelsInputs={levelsInputs}\n        addMore={addMore}\n        onSubmitLevels={onSubmitLevels}\n      />\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step3);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step1/Step1.js",["295","296","297"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step4/Step4.js",["298","299","300","301","302","303","304"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.js",["305","306","307","308","309","310","311"],"import { useEffect, useState } from 'react';\nimport { Link } from 'react-router-dom';\nimport logo from '../../assets/images/logo.png'\nimport { connect } from 'react-redux'\nimport { getFooter } from './footer.action'\nimport {ENV} from './../../config/config';\n\nconst Footer = (props) => {\n\n    const [data, setData] = useState({\n        facebook: '',\n        twitter: '',\n        instagram: '',\n        youtube: '',\n        vine: '',\n        desc: ''\n    })\n\n    useEffect(() => {\n        props.getFooter()\n    }, [])\n\n    useEffect(() => {\n        if (props.settings.settingsAuth) {\n            setData(props.settings.settings)\n        }\n    }, [props.settings.settingsAuth])\n\n    return (\n        <footer className=\"footer-area\">\n            {/* Footer Top */}\n            <div className=\"footer-top\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Logo */}\n                                <Link className=\"navbar-brand\" to=\"/\">\n                                    <img src={logo} alt=\"\" />\n                                </Link>\n                                <p>{data.desc}</p>\n                                {/* Social Icons */}\n                                <div className=\"social-icons d-flex\">\n                                    {\n                                        data.facebook ?\n                                            <a href={data.facebook} target=\"_blank\">\n                                                <i className={\"fab fa-facebook-f\"} />\n                                                <i className={\"fab fa-facebook-f\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.twitter ?\n                                            <a href={data.twitter} target=\"_blank\">\n                                                <i className={\"fab fa-twitter\"} />\n                                                <i className={\"fab fa-twitter\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.instagram ?\n                                            <a href={data.instagram} target=\"_blank\">\n                                                <i className={\"fab fa-instagram\"} />\n                                                <i className={\"fab fa-instagram\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.youtube ?\n                                            <a href={data.youtube} target=\"_blank\">\n                                                <i className={\"fab fa-youtube\"} />\n                                                <i className={\"fab fa-youtube\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.vine ?\n                                            <a href={data.vine} target=\"_blank\">\n                                                <i className={\"fab fa-vine\"} />\n                                                <i className={\"fab fa-vine\"} />\n                                            </a> : ''\n                                    }\n\n\n\n\n\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Useful Links\"}</h4>\n                                <ul>\n                                    <li><Link to=\"/explore-all\">All NFTs</Link></li>\n                                    <li><Link to=\"/how-it-works\">How It Works</Link></li>\n                                    <li><Link to=\"/create\">Create</Link></li>\n                                    <li><Link to=\"/privacy-and-terms\">Privacy & Terms</Link></li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Community\"}</h4>\n                                <ul>\n                                    <li><Link to=\"/help-center\">Help Center</Link></li>\n                                    <li><Link to=\"/contact\">Contact</Link></li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Subscribe Us\"}</h4>\n                                {/* Subscribe Form */}\n                                <div className=\"subscribe-form d-flex align-items-center\">\n                                    <input type=\"email\" className=\"form-control\" placeholder=\"info@yourmail.com\" />\n                                    <button type=\"submit\" className=\"btn\"><i className=\"icon-paper-plane\" /></button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            {/* Footer Bottom */}\n            <div className=\"footer-bottom\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12\">\n                            {/* Copyright Area */}\n                            <div className=\"copyright-area d-flex flex-wrap justify-content-center justify-content-sm-between text-center py-4\">\n                                {/* Copyright Left */}\n                                <div className=\"copyright-left\">©2021 {ENV.appName}, All Rights Reserved.</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    );\n}\n\nconst mapStateToProps = state => ({\n    error: state.error,\n    settings: state.settings\n});\n\n\nexport default connect(mapStateToProps, { getFooter })(Footer);","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/header/header.js",["312","313","314","315","316","317","318"],"import React, { useState, useEffect } from 'react';\nimport { Link, useHistory } from 'react-router-dom';\nimport { connect } from 'react-redux';\nimport { setWalletAddress, getWalletAddress } from '../wallet/wallet.action'\nimport { connectMetamaskCopy } from '../../utils/web3'\nimport { logoutUser } from '../user/user.action';\nimport { ENV } from './../../config/config';\n\nconst Header = (props) => {\n    const history = useHistory();\n    // console.log(\"history\", history);\n    const [connectedAddress, setConnectedAddress] = useState('');\n    const [loader, setLoader] = useState(true);\n    const { _id } = ENV.getUserKeys('_id');\n\n    useEffect(async () => {\n        // COMMENTED TEMPORARILY\n        // METHOD 1\n        // props.getWalletAddress()\n\n        // METHOD 2 - a\n        // let connectedAddress = await connectMetamask();\n        // setConnectedAddress(connectedAddress)\n\n        // METHOD 3\n        // if (localStorage.getItem('wa')) {\n        //     let connectedAddress = window.atob(localStorage.getItem('wa'))\n        //     setConnectedAddress(connectedAddress)\n        // }\n\n        // METHOD 4\n        let connectedAddress = await connectMetamaskCopy();\n        setConnectedAddress(connectedAddress)\n        props.setWalletAddress(connectedAddress)\n    }, [])\n\n    // set loader to false when address is received\n    useEffect(() => {\n        if (connectedAddress)\n            setLoader(false)\n    }, [connectedAddress])\n\n    // COMMENTED TEMPORARILY\n    // METHOD 2 - b\n    // useEffect(() => {\n    //     if (props.wallet.walletAuth) {\n    //         const { connectedAddress } = props.wallet\n    //         setConnectedAddress(connectedAddress)\n    //     }\n    // }, [props.wallet.walletAuth])\n    const formatAddress = (address) => {\n        return address ? address.substr(0, 6) + '...' + address.substr(-4) : null;\n    }\n    const logoutUser = () => {\n        props.logoutUser();\n        history.push('/login');\n    }\n    \n    return (\n        <header id=\"header\">\n            {/* Navbar */}\n            <nav data-aos=\"zoom-out\" data-aos-delay={800} className=\"navbar navbar-expand\">\n                <div className=\"container header\">\n                    {/* Navbar Brand*/}\n                    <Link className=\"navbar-brand\" to=\"/\">\n                        <img className=\"navbar-brand-sticky\" src=\"/img/new_logo.jpeg\" alt=\"sticky brand-logo\" />\n                    </Link>\n                    <div className=\"ml-auto\" />\n                    {/* Navbar */}\n                    <ul className=\"navbar-nav items mx-auto\">\n                        <li className=\"nav-item dropdown\">\n                            <Link className=\"nav-link\" to=\"/\">Home</Link>\n                        </li>\n                        <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\">Explore <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><Link to=\"/explore-all\" className=\"nav-link\">Explore</Link></li>\n                                <li className=\"nav-item\"><Link to=\"/auctions\" className=\"nav-link\">Live Auctions</Link></li>\n                                {/* <li className=\"nav-item\"><Link to=\"/item-details\" className=\"nav-link\">Item Details</Link></li> */}\n                            </ul>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/activity\" className=\"nav-link\">Activity</Link>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/collections\" className=\"nav-link\">Collections</Link>\n                        </li>\n                        {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Community <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/blog\" className=\"nav-link\">Blog</a></li>\n                                <li className=\"nav-item\"><a href=\"/blog-single\" className=\"nav-link\">Blog Single</a></li>\n                                <li className=\"nav-item\"><a href=\"/help-center\" className=\"nav-link\">Help Center</a></li>\n                            </ul>\n                        </li> */}\n                        {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Pages <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/authors\" className=\"nav-link\">Authors</a></li>\n                                <li className=\"nav-item\"><a href=\"/author\" className=\"nav-link\">Author</a></li>\n                                <li className=\"nav-item\"><a href=\"/wallet-connect\" className=\"nav-link\">Wallet Connect</a></li>\n                                <li className=\"nav-item\"><a href=\"/create\" className=\"nav-link\">Create</a></li>\n                                <li className=\"nav-item\"><a href=\"/login\" className=\"nav-link\">Login</a></li>\n                                <li className=\"nav-item\"><a href=\"/signup\" className=\"nav-link\">Signup</a></li>\n                            </ul>\n                        </li> */}\n                        <li className=\"nav-item\">\n                            <Link to=\"/contact\" className=\"nav-link\">Contact</Link>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/history\" className=\"nav-link\">History</Link>\n                        </li>\n                    </ul>\n                    {/* Navbar Icons */}\n                    <ul className=\"navbar-nav icons\">\n                        <li className=\"nav-item\">\n                            <a href=\"#\" className=\"nav-link\" data-toggle=\"modal\" data-target=\"#search\">\n                                <i className=\"fas fa-search\" />\n                            </a>\n                        </li>\n                    </ul>\n                    {/* Navbar Toggler */}\n                    <ul className=\"navbar-nav toggle\">\n                        <li className=\"nav-item\">\n                            <a href=\"#\" className=\"nav-link\" data-toggle=\"modal\" data-target=\"#menu\">\n                                <i className=\"fas fa-bars toggle-icon m-0\" />\n                            </a>\n                        </li>\n                    </ul>\n                    {/* Navbar Action Button */}\n                    <ul className=\"navbar-nav action\">\n                        <li className=\"nav-item ml-3\">\n                            {\n                                connectedAddress && _id ?\n                                    <button className=\"btn ml-lg-auto btn-bordered-white\" onClick={logoutUser}><i className=\"icon-logout mr-md-2\" /> Logout</button>\n                                    // <span id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />{formatAddress(connectedAddress)}</span>\n                                    :\n                                    <Link to=\"/login\" id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />Login</Link>\n                            }\n\n                        </li>\n                    </ul>\n                </div>\n            </nav>\n        </header>\n    );\n};\n\nconst mapStateToProps = state => ({\n    wallet: state.wallet\n});\nexport default connect(mapStateToProps, { setWalletAddress, getWalletAddress, logoutUser })(Header);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["319","320"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 630,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(\n    props.levelsInputs\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage,setErrorMessage]=React.useState(\"\")\n  const [validate,setValidate]=React.useState(false)\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n      let newFormValues = [...levelsInputs];\n      newFormValues.splice(i, 1);\n      setlevelsInputs(newFormValues);\n \n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault()\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total ===\"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\")\n        return \"\";\n      }\n      if(+item.value > +item.total){\n        alert(\"inside\")\n        setError(true)\n        setValidate(true)\n        setErrorMessage(\"Value should be less then total!\")\n        return \"\";\n      }\n \n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n//  const handleValue=(item)=>{\n//    if(item.value > item.total){\n\n//      setError(true)\n//      return true\n//    }\n//    return false\n//  }\n//  const handleTotal=(item)=>{\n\n//  }\n// console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor:\"pointer\"\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={LevelsImage} alt={\"levels\"} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Add Levels\n              </p>\n            </div>\n              {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p className=\"text-center w-100 p-4 text-white\" style={{color:\"#FFFFFF\",opacity:\"0.70\",width:\"80%\",fontSize:\"14px\" }}>\n           Levels show up underneath your item, are clickable, and can be\nfiltered in you collection’s sidebar.\n            </p>\n       <form onSubmit={handleSubmit}>\n            <div className=\"row levels-scroll p-3\" style={{height:`${levelsInputs &&   levelsInputs.length > 0 ?\" 22vh\":\"14vh\"}`}}>\n              {levelsInputs &&\n                levelsInputs.length > 0 &&\n              levelsInputs.map((item, i) => {\n                return (\n                  <div className=\"d-flex\" key={i}>\n                    <div className=\"col-6 mt-2 \" key={i}>\n                      <div\n                        className=\"d-flex\"\n                        style={{ flexDirection: \"column\" }}\n                      >\n                     \n                        <label\n                          className=\"text-white\"\n                          style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                        >\n                          Name\n                        </label>\n\n                        <input\n                          className=\"step3-input mt-3 \"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => handleChange(i, e)}\n                          value={item.name || \"\"}\n                          placeholder=\"Name\"\n                          maxLength=\"50\"\n                          style={{\n                            backgroundColor: \"#000e29\",\n                            maxWidth: \"84%\",\n                            padding: \"0.6rem 1rem\",\n                          }}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-6 mt-3\">\n               \n                      <div\n                        className=\"d-flex position-relative\"\n                        style={{ flexDirection: \"column\" }}\n                      >\n                          \n                          \n                        <label\n                          className=\"text-white\"\n                          style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                        >\n                          Value\n                        </label>\n                        {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                        <div className=\"d-flex align-items-center  w-100\">\n\n                          <input\n                            className={`step3-input first-value mt-2 ${validate && item.value > item.total ? \"levels-value\":\"\"}`}\n                            type=\"number\"      \n                            min=\"1\"\n                            max={item.total ?item.total :\"1\"}\n                            onChange={(e) => handleChange(i, e)}\n                            value={item.value || \"\"}\n                            placeholder=\"Value\"\n                            name=\"value\"\n                    \n                            style={{\n                              backgroundColor: \"#000e29\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                       \n                          \n                          <p className=\"text-white mb-0 value-label\">Of</p>\n                          <input\n                            className={`step3-input first-value mt-2 ${validate && item.total < item.value ? \"levels-value\":\"\"}`}\n                            type=\"number\"\n                            min={item.value ?item.value :\"1\"}\n                            max=\"9999\"\n                            name=\"total\"\n                            placeholder=\"total\"\n                   \n                            onChange={(e) => handleChange(i, e)}\n                            value={item.total || \"\"}\n                            style={{\n                              backgroundColor: \"#000e29\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                        </div>\n                        <BsFillXCircleFill\n                          className=\"position-absolute levels-cross-icon\"\n                          style={{\n                            color: \"#00d3f3\",\n                            top: \"3rem\",\n                            right: \"0\",\n                            cursor: \"pointer\",\n                          }}\n                          onClick={() => removeFormFields(i)}\n                          />\n                      </div>\n                        \n                    </div>\n                  </div>\n                );\n              })}\n\n              <p\n                className=\" mt-4\"\n                style={{ color: \"#00d3f3\" ,cursor:\"pointer\",marginLeft:\"0.8rem\"}}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n        \n            <div className=\"w-100 text-center\">\n              <button\n                type=\"submit\"\n                className=\"btn btn-secondary start-btn mt-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   levelsInputs && levelsInputs?.length > 0\n                //     ? false\n                //     : true\n                // }\n                // onClick={() => {\n                //   handleSubmit()\n                // }}\n              >\n                Save\n              </button>\n            </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) => (\n  // console.log(state, \"state\"),\n  {\n    currentStep: state.dashboard.currentStep,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["321","322"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 630,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.propertiesValues\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white mt-0\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 22vh\"\n                    : \"14vh\"\n                }`,\n             \n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" style={{width:\"558px\"}} key={i}>\n                      <div className=\"col-6 mt-4\" key={i}>\n                        <div\n                          className=\"d-flex\"\n                          style={{ flexDirection: \"column\" }}\n                        >\n                          <label\n                            className=\"text-white\"\n                            style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                          >\n                            Name\n                          </label>\n                          <input\n                            className=\"step3-input mt-2 \"\n                            type=\"text\"\n                            name=\"name\"\n                            onChange={(e) => handleChange(i, e)}\n                            placeholder=\"Name\"\n                            value={item.name || \"\"}\n                            maxLength=\"40\"\n                            style={{\n                              backgroundColor: \"#000e29 !important\",\n                              maxWidth: \"84%\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                        </div>\n                      </div>\n\n                      <div className=\"col-6 mt-4\">\n                        <div\n                          className=\"d-flex position-relative\"\n                          style={{ flexDirection: \"column\" }}\n                        >\n                          <label\n                            className=\"text-white\"\n                            style={{\n                              fontSize: \"1.2rem\",\n                              fontWeight: \"bold\",\n                              marginLeft: \"2rem\",\n                            }}\n                          >\n                            Value\n                          </label>\n                          <input\n                            className=\"step3-input  mt-2\"\n                            type=\"text\"\n                            name=\"value\"\n                            onChange={(e) => handleChange(i, e)}\n                            placeholder=\"Value\"\n                            value={item.value || \"\"}\n                            maxLength=\"40\"\n                            style={{\n                              backgroundColor: \"#000e29 \",\n                              maxWidth: \"84%\",\n                              marginLeft: \"2rem\",\n                              padding: \"0.6rem 1rem\",\n                            }}\n                          />\n                          <BsFillXCircleFill\n                            className=\"position-absolute cross-icon\"\n                            style={{\n                              color: \"#00d3f3\",\n                              top: \"3rem\",\n                              left: \"15.8rem\",\n                              cursor: \"pointer\",\n                            }}\n                            onClick={() => removeFormFields(i)}\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n\n              <p\n                className=\" mt-4\"\n                style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Property\n              </p>\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   propertiesValues && propertiesValues?.length > 0\n                //     ? false\n                //     : true\n                // }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["323"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.action.js",["324"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport { GET_ERRORS, SET_USER, GET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, BEFORE_USER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { getCollections, setAuthState } from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n    return {\n        type: BEFORE_USER\n    }\n}\n\n// method to set user data\nexport const setUser = (user) => dispatch => {\n    dispatch(emptyError())\n    dispatch({\n        type: SET_USER,\n        payload: user\n    })\n}\n\n// method to get user data\nexport const getUser = () => dispatch => {\n    dispatch({\n        type: GET_USER\n    })\n}\n\n// method to login using wallet address and sign\nexport const login = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/login/`;\n    // const url = `http://localhost:5000/v1/front/auth/login/`;\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            const userId = data.data._id;\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/register/`;\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n            toast.success(data.message)\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getTopSellers = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/top-sellers`;\n    // const url = `http://3.142.91.8/v1/front/users/top-sellers`;\n    // console.log(url,\"testing url in top sellers\")\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        // console.log(\"data====>\",data);\n        if (data.status) {\n            dispatch({\n                type: TOP_SELLERS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        // console.log(\"errors===>\");\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getCreators = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/creators`;\n    // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n    \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        // console.log(data,\"creators data===>}}}\");\n        if (data.status) {\n            dispatch({\n                type: SET_CREATORS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/${userId}`;\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            dispatch({\n                type: SET_INDIVIDUAL_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => dispatch => {\n    dispatch(emptyError());\n    dispatch({\n        type: SET_INDIVIDUAL_USER,\n        payload: user\n    })\n};\n\nexport const logoutUser = () => (dispatch) => {\n    dispatch({\n        type: SET_USER,\n        userAuth: false,\n        userData: null\n    })\n    dispatch(setAuthState())\n    localStorage.removeItem('encuse');\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.actions.js",["325"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_COLLECTION, SET_AUTH_STATE, GET_COLLECTION, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\n\nexport const beforeCollection = () => {\n    return {\n        type: BEFORE_COLLECTION\n    }\n}\n\nexport const getCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}collection/get/${collectionId}`;\n \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getCollections = (qs = null) => dispatch => {\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        // console.log(error,\"all collections error\");\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const upsertCollection = (apiURL, body, method = 'POST') => dispatch => {\n\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n   \n    // const url = `http://localhost:5000/v1/front/${apiURL}`;\n\n\n    fetch(url, {\n        method,\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: UPSERT_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}collection/delete/${collectionId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const setAuthState = () => (dispatch) => {\n    dispatch({\n        type: SET_AUTH_STATE,\n    })\n}","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/gaTracker/gaTracket.js",["326"],"import { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport ReactGA from \"react-ga\";\nimport { connect } from \"react-redux\";\nimport { useSelector } from \"react-redux\";\n\n\n\nconst useGaTracker = () => {\n    const step=useSelector((state)=>state.dashboard.currentStep)\n    const location = useLocation();\n    const [initialized, setInitialized] = useState(false);\n\n    useEffect(() => {\n        if (!window.location.href.includes(\"localhost\")) {\n        ReactGA.initialize(\"UA-215431628-1\");\n        }\n        setInitialized(true);\n    }, []);\n\n    useEffect(() => {\n        if (initialized) {\n        \n            if(location.pathname === '/')\n            {\n\n                ReactGA.pageview(location.pathname + location.search );\n            }\n            else {\n                ReactGA.pageview(location.pathname + location.search + `/step${step}`);\n            }\n        }\n    }, [initialized, location, step]);\n};\n\nexport default useGaTracker;",{"ruleId":"327","severity":1,"message":"328","line":6,"column":8,"nodeType":"329","messageId":"330","endLine":6,"endColumn":17},{"ruleId":"331","severity":1,"message":"332","line":19,"column":6,"nodeType":"333","endLine":19,"endColumn":11,"suggestions":"334"},{"ruleId":"327","severity":1,"message":"335","line":2,"column":8,"nodeType":"329","messageId":"330","endLi