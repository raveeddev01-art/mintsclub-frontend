                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                      <tr>\n                                        <th scope=\"row\">1,250.009</th>\n                                        <td>$1,500.01</td>\n                                        <td>80% below</td>\n                                        <td>an hour ago</td>\n                                        <td>D2FB2D</td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingThree\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseThree\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseThree\"\n                              >\n                                <img\n                                  src={ListingIcon}\n                                  alt=\"price-history\"\n                                  className=\"me-2\"\n                                />\n                                Item listing\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseThree\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingThree\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"table-container listing-table\">\n                                  <table class=\"table table-borderless\">\n                                    <thead>\n                                      <tr>\n                                        <th scope=\"col\">Price</th>\n                                        <th scope=\"col\">USD Price</th>\n                                        <th scope=\"col\">Expiration</th>\n                                        <th scope=\"col\">From</th>\n                                        <th scope=\"col\">{\"\"}</th>\n                                      </tr>\n                                    </thead>\n                                    <tbody>\n                                      <tr>\n                                        <th scope=\"row\">0.025</th>\n                                        <td>$77.50</td>\n                                        <td>in a day</td>\n                                        <td>BBC1B3</td>\n                                        <td>\n                                          <button>Buy</button>\n                                        </td>\n                                      </tr>\n                                    </tbody>\n                                  </table>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-11 col-md-12 col-lg-7 col-xl-5 order-1 order-md-2 mx-auto mb-5 mb-md-0  mx-md-0\">\n                      <div className=\"collection-filter-accordion nft-stats-accordion\">\n                        <div\n                          className=\"accordion accordion-flush \"\n                          id=\"accordionFlushExample\"\n                        >\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingFour\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseFour\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseFour\"\n                              >\n                                Properties\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseFour\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingFour\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"row g-2 justify-content-center align-items-center\">\n                                  {propertiesData &&\n                                    propertiesData.map((data) => {\n                                      return (\n                                        <div className=\"col-6 col-sm-4 col-md-6\">\n                                          <div className=\"properties-content-container d-flex flex-column justify-content-center align-items-center text-center\">\n                                            <div className=\"properties-content\">\n                                              <span>{data.subTitle}</span>\n                                              <h3>{data.title}</h3>\n                                              <p>{data.content}</p>\n                                            </div>\n                                          </div>\n                                        </div>\n                                      );\n                                    })}\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSix\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSix\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSix\"\n                              >\n                                Stats\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSix\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSix\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingSeven\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseSeven\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseSeven\"\n                              >\n                                Levels\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseSeven\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingSeven\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingEight\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseEight\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseEight\"\n                              >\n                                Boosts\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseEight\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingEight\"\n                            >\n                              <div className=\"accordion-body\"></div>\n                            </div>\n                          </div>\n\n                          <div className=\"accordion-item\">\n                            <h2\n                              className=\"accordion-header\"\n                              id=\"flush-headingNine\"\n                            >\n                              <button\n                                className=\"accordion-button collapsed\"\n                                type=\"button\"\n                                data-toggle=\"collapse\"\n                                data-target=\"#flush-collapseNine\"\n                                aria-expanded=\"false\"\n                                aria-controls=\"flush-collapseNine\"\n                              >\n                                Details\n                              </button>\n                            </h2>\n                            <div\n                              id=\"flush-collapseNine\"\n                              className=\"accordion-collapse collapse\"\n                              aria-labelledby=\"flush-headingNine\"\n                            >\n                              <div className=\"accordion-body\">\n                                <div className=\"contact-address d-flex justify-content-between\">\n                                  <p>Contract Address</p>\n                                  <span>0x7227...3335</span>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Token ID</p>\n                                  <p>1584563428....</p>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Token Standard </p>\n                                  <p>ERC-721</p>\n                                </div>\n                                <div className=\"d-flex justify-content-between\">\n                                  <p>Blockchain </p>\n                                  <p>Polygon</p>\n                                </div>\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-11 col-sm-8 order-1 order-md-2 col-md-6 col-lg-5 col-xl-4 mx-auto\">\n                  <Card className=\"auction-card detail-card\">\n                    <div className=\"auction-img-wrapper\">\n                      <Card.Img\n                        variant=\"top\"\n                        src={nftDetail.image}\n                        alt=\"AuctionTopImg\"\n                      />\n                    </div>\n                    <Card.Body>\n                      <div>\n                        <span>Current price</span>\n                        <h3>\n                          {nftDetail.currentPrice}\n                          <span>\n                            (${\" \"}\n                            {(nftDetail.currentPrice * exchangeRate).toFixed(2)}\n                            )\n                          </span>\n                        </h3>\n                      </div>\n                      <div className=\" d-flex justify-content-between align-items-center mb-2\">\n                        <div className=\"d-flex align-items-center\">\n                          <img\n                            src={ClockIcon}\n                            alt=\"clock-icon\"\n                            className=\"me-1\"\n                          />\n                          <span>Sale ends March 8, 2022 at 7:40am PKT </span>\n                        </div>\n                        <div className=\"likes-container d-flex align-items-center\">\n                          <span>\n                            {nftDetail.likeCount ? nftDetail.likeCount : 0}\n                          </span>\n                          <img\n                            src={HeartIcon}\n                            alt=\"heart-icon\"\n                            className=\"ms-1\"\n                          />\n                        </div>\n                      </div>\n                      <button\n                        className=\"btn btn-linear-gradient d-flex align-items-center justify-content-center w-75 mx-auto\"\n                        onClick={() => handleRouting()}\n                      >\n                        <p>\n                          {ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId\n                            ? \"Sell\"\n                            : \"Buy Now\"}\n                        </p>\n                      </button>\n                    </Card.Body>\n                  </Card>\n                  <div className=\"detail-description-content mt-5\">\n                    <div className=\"d-flex align-items-center mb-3\">\n                      <img\n                        src={DescriptionIcon}\n                        alt=\"descriptionIcon\"\n                        className=\"me-1\"\n                      />\n                      <h6>Discription</h6>\n                    </div>\n                    <p>{nftDetail.description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-0 mt-md-4 order-3\">\n                  <div className=\"nftDetail-accordion\">\n                    <div\n                      className=\"accordion accordion-flush \"\n                      id=\"accordionFlushExample\"\n                    >\n                      <div className=\"accordion-item\">\n                        <h2 className=\"accordion-header\" id=\"flush-headingTen\">\n                          <button\n                            className=\"accordion-button collapsed\"\n                            type=\"button\"\n                            data-toggle=\"collapse\"\n                            data-target=\"#flush-collapseTen\"\n                            aria-expanded=\"false\"\n                            aria-controls=\"flush-collapseTen\"\n                          >\n                            <img\n                              src={ActivityIcon}\n                              alt=\"price-history\"\n                              className=\"me-2\"\n                            />\n                            Activity\n                          </button>\n                        </h2>\n                        <div\n                          id=\"flush-collapseTen\"\n                          className=\"accordion-collapse collapse\"\n                          aria-labelledby=\"flush-headingTen\"\n                        >\n                          <div className=\"accordion-body\">\n                            <div className=\"table-container\">\n                              <table class=\"table table-borderless\">\n                                <thead>\n                                  <tr>\n                                    <th scope=\"col\">Event</th>\n                                    <th scope=\"col\">Price</th>\n                                    <th scope=\"col\">From</th>\n                                    <th scope=\"col\">To</th>\n                                    <th scope=\"col\">Date</th>\n                                  </tr>\n                                </thead>\n                                <tbody>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                  <tr>\n                                    <th scope=\"row\">List</th>\n                                    <td>0.025</td>\n                                    <td>BBC1B3</td>\n                                    <td> </td>\n                                    <td>an hour ago</td>\n                                  </tr>\n                                </tbody>\n                              </table>\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n\n                      <div className=\"accordion-item\">\n                        <h2\n                          className=\"accordion-header\"\n                          id=\"flush-headingEleven\"\n                        >\n                          <button\n                            className=\"accordion-button collapsed\"\n                            type=\"button\"\n                            data-toggle=\"collapse\"\n                            data-target=\"#flush-collapseEleven\"\n                            aria-expanded=\"false\"\n                            aria-controls=\"flush-collapseEleven\"\n                          >\n                            <img\n                              src={MoreCollectionIcon}\n                              alt=\"price-history\"\n                              className=\"me-2\"\n                            />\n                            More from this collection\n                          </button>\n                        </h2>\n                        <div\n                          id=\"flush-collapseEleven\"\n                          className=\"accordion-collapse collapse\"\n                          aria-labelledby=\"flush-headingEleven\"\n                        >\n                          <div className=\"accordion-body\">\n                            <div className=\"row justify-content-center align-items-center g-3\">\n                              {nftsList && nftsList.length > 0 ? (\n                                nftsList.map((listing) => {\n                                  return (\n                                    <div className=\"col-6 col-sm-6 col-md-4 col-lg-2 px-1\">\n                                      <ListingCards\n                                        CardImg={listing.image}\n                                        name={listing.name}\n                                        price={listing.currentPrice}\n                                        // usd={\n                                        //   listing.currentPrice * exchangeRate\n                                        // }\n                                        id={listing._id}\n                                      />\n                                    </div>\n                                  );\n                                })\n                              ) : (\n                                <p className=\"text-center mt-4\">\n                                  No NFTs Found\n                                </p>\n                              )}\n                            </div>\n                            <div className=\"mt-4 detail-btn-collection text-center\">\n                              {nftsList.length > 0 && (\n                                <button className=\"btn btn-rounded-bordered\">\n                                  View collection\n                                </button>\n                              )}\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            {/* ///////////////////////////////////// Modal */}\n            <div className=\"modal-wrapper\">\n              {false && (\n                <Modal\n                  centered\n                  size=\"lg\"\n                  // className=\"place-bid-modal\"\n                  show={true}\n                  // onHide={this.closeModal}\n                >\n                  <Modal.Header className=\"text-center modal-title-wrapper text-white\">\n                    <Modal.Title>\n                      {2 === 2 ? \"Place A Bid\" : \"Make An Offer\"}\n                    </Modal.Title>\n                  </Modal.Header>\n                  {/* {\n                                isSubmitted && errors &&\n                                <Modal.Body className=\"row pt-2 pb-0\">\n                                    <div className=\"col-12\">\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\n                                    </div>\n                                </Modal.Body>\n                            } */}\n                  <Modal.Body>\n                    <div className=\"price-wrapper d-flex\">\n                      <div className=\"price-text position-relative\">\n                        <div className=\"text-white mb-2 absolute-wrapper\">\n                          <b>Price</b>\n                        </div>\n                        <div className=\"text-right mb-2\">\n                          <i className=\"fas fa-exclamation-circle ml-2 text-white\" />\n                        </div>\n                        <div className=\"d-flex\">\n                          <select\n                            className=\"form-control currency-options\"\n                            id=\"currency\"\n                            name=\"nftConfig.price.currency\"\n                            onChange={(e) => this.onChange(e)}\n                          >\n                            {currencies &&\n                              currencies.map((currency, index) => {\n                                return (\n                                  <option key={index} value={currency.symbol}>\n                                    {currency.symbol}\n                                  </option>\n                                );\n                              })}\n                          </select>\n                          <input\n                            type=\"text\"\n                            placeholder=\"Amount\"\n                            className=\"amount-btn ml-3\"\n                            name=\"nftConfig.price.amount\"\n                            placeholder=\"Amount\"\n                            className=\"amount-btn ml-3\"\n                            style={{ borderRadius: \"4px\" }}\n                            onChange={(e) => this.onChange(e)}\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            defaultValue={nftConfig.price.amount}\n                            required\n                          />\n                          <div className=\"text-right mb-2 dollar-wrapper\">\n                            $ 0.00\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </Modal.Body>\n                  <Modal.Body className=\"text-danger\">\n                    {validator.message(\n                      \"amount\",\n                      nftConfig.price.amount,\n                      \"required\"\n                    )}\n                  </Modal.Body>\n                  {/* <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\n                                <div className=\"offer-expiration-wrapper text-white\">\n                                    <b>Offer Expiration</b>\n                                </div>\n                                <div>\n                                    <div className=\"d-flex\">\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\n                                            style={{\n                                                padding: \"7px 55px 7px 55px\",\n                                                border: \"none\",\n                                                outline: \"none\",\n                                                borderRadius: \"4px\",\n                                                background: \"#808080\",\n                                                display: \"flex\",\n                                                alignItems: \"center\",\n                                                cursor: \"pointer\",\n                                                height: \"51px\",\n                                                color: \"#000\"\n                                            }}\n                                        >\n                                            {\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\n                                                    return (\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\n                                                    )\n                                                })\n                                            }\n                                        </select>\n                                        <div>\n                                            <div className=\"mr-auto budle-wrapper\">\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\n                                            </div>\n                                            <span className=\"text-danger message\">{validator.message('amount', nftConfig.price.amount, 'required')}</span>\n                                        </div>\n                                    </div>\n                                </div>\n                            </Modal.Body> */}\n                  <Modal.Body className=\"justify-content-center align-items-center\">\n                    <div className=\"d-flex justify-content-around place-bid-btn\">\n                      <button\n                        className=\"ethereum-btn mr-3 place-bid-ethereum-btn\"\n                        disabled={loader}\n                        // onClick={() => this.submit()}\n                      >\n                        {2 === 2 ? initData.bidBtn : initData.bidBtn}\n                      </button>\n                      {/* <button className=\"ethereum-btn\">Add funds</button> */}\n                    </div>\n                  </Modal.Body>\n                  <Modal.Footer>\n                    <button\n                      className=\"btn banner-btn btn-primary\"\n                      // onClick={this.closeModal}\n                    >\n                      Close\n                    </button>\n                  </Modal.Footer>\n                </Modal>\n              )}\n            </div>\n          </section>\n          <Footer />\n        </>\n      )}\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state, \"state in nft detail=>\"),\n  {\n    nftDetail: state.nft.nftsData,\n    nftsAuth: state.nft.nftsAuth,\n    nftsByCollection: state.nft.nftsByCollection,\n    nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  getNFT,\n  getNFTsByCollection,\n})(NFTDetail);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/explore-collections.js",["707","708","709","710"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\n\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport \"./explore-collections.css\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"./collections.actions\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { beforeCategory, getCategories } from \"./collections.actions\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Explore\"} title2={\"ExploreAll\"} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Collections</span>\n                    <h3 className=\"mb-0\">Explore all</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-lg-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={collection.banner}\n                        Subimg1={collection.logo}\n                        Subimg2={collection.featuredImg}\n                        Subimg3={collection.banner}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.user[0]?.username\n                            ? collection?.user[0]?.username\n                            : \"\"\n                        }\n                        NFTCount={collection.NFTCount}\n                        profileImage={collection?.user[0]?.profileImage}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    collections?.length === 10 &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["711","712","713"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  useEffect(() => {\n    props.getTopSellers();\n  }, []);\n  useEffect(() => {\n    setSellers(props.user.sellers);\n  }, [props.user.topSellersAuth]);\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <Link to={`/author/${author._id}`}>\n                          <div className=\"seller-avatar-container\">\n                            <img\n                              className=\"avatar-md rounded-circle\"\n                              src={AvatarImg}\n                              alt=\"\"\n                            />\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          </div>\n                        </Link>\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">{\"256.6ETH\"}</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>Top Sellers not available</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {/* {!empty &&\n                  collections?.length > 10 &&\n                  pagination.totalRecords <= collections.length && ( */}\n                <button className=\"btn btn-linear-gradient px-5\">\n                  Load more\n                </button>\n                {/* )} */}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList\n);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["714","715","716","717","718","719","720","721","722","723","724","725","726","727","728","729","730"],"import React, { useState, useEffect } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./allnft.css\";\nimport { beforeNFT, getNFTs, getMyLikedNfts } from \"../../nfts/nfts.action\";\nimport { ENV } from \"../../../config/config\";\nimport NavbarMain from \"../../navbar-main/NavbarMain\";\nimport Footer from \"../../footer/footer\";\nimport SearchIcon from \"../../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../../listing-cards/ListingCards\";\nimport FilterComponent from \"../../filter-component/FilterComponent\";\nimport { getCreators, beforeUser } from \"./../../user/user.action\";\nimport FullPageLoader from \"../../full-page-loader/full-page-loader\";\nimport { toggleLikeDislike } from \"../explore.action\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../../collections/collections.actions\";\nimport Breadcrumb from \"../../breadcrumb/breadcrumb\";\n\nconst AllNFT = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [collections, setCollections] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy:false,\n    auction:false,\n    latest:false,\n  });\n\n  \n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getCreators();\n    props.getCollections();\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n\n // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n //Get Top Sellers\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      setCreator(props.user.sellers);\n    }\n  }, [props.user.topSellersAuth]);\n\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      setCreator(props.user.creators);\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n\n //Get NFt's\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nfts, pagination } = props.nft.nftsData;\n      if (nfts) {\n        setNFTs(nfts);\n        setNFTPagination(pagination);\n        setFilterationLoader(false);\n        props.beforeNFT();\n\n        setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  //pagination\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setCollections(props.collections);\n    }\n  }, [props.getAuth]);\n\n\n\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    const nftQS = { page, limit };\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getNFTs(qs);\n  };\n  \n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n    console.log(value, \"value\");\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      page,\n      limit,\n      id,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const handleLikesTogleApi = (nftId, status) => {\n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n    // setNFTs(nfts);\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Explore\"} title2={\"AllNFT\"} />\n      <div className=\"collection-detail-content all-nft-content\">\n        <div className=\"container padding-wrapper pb-1\">\n          <div className=\"collections-listing\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img src={SearchIcon} alt=\"search-icon\" className=\"ms-3\" />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {sortoptions &&\n                      sortoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Collections={filterData.collections}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-12\">\n                <div className=\"no-of-items text-end mb-3\">\n                  <p>\n                    {nfts?.length}\n                    {\"  items\"}\n                  </p>\n                </div>\n              </div>\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Collections={collections}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9\">\n                {loader ? (\n                  <FullPageLoader />\n                ) : (\n                  <div className=\"row g-3\">\n                    {filterationLoader ? (\n                      <div className=\"text-center\">\n                        <div\n                          class=\"spinner-border text-secondary text-white \"\n                          role=\"status\"\n                        >\n                          <span class=\"sr-only\">Loading...</span>\n                        </div>\n                      </div>\n                    ) : nfts && nfts.length > 0 ? (\n                      nfts.map((listing) => {\n                        return (\n                          <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                            <ListingCards\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                              ownerId={listing.ownerId}\n                             \n                            />\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-white text-center mt-5 no-nft-title\">\n                        No NFTs Found\n                      </p>\n                    )}\n                    <div className=\"col-12\">\n                      <div className=\"mt-5 text-center\">\n                        {nftPagination?.total === nfts?.length\n                          ? \"\"\n                          : !filterationLoader && (\n                              <button\n                                className=\"btn btn-linear-gradient px-5\"\n                                onClick={() => handlePagination()}\n                              >\n                                Load more\n                              </button>\n                            )}\n                      </div>\n                    </div>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"all-nft-footer\">\n        <Footer />\n      </div>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFTs,\n  getCreators,\n  toggleLikeDislike,\n  getCollections,\n  getMyLikedNfts,\n})(AllNFT);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["731","732","733","734","735","736","737","738","739","740","741","742","743","744","745","746","747","748","749","750","751"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport \"./UserProfile.css\";\nimport { ENV } from \"../../config/config\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\nimport { getProfileNfts, beforeNFT, getMyLikedNfts } from \"../nfts/nfts.action\";\nimport { toggleLikeDislike } from \"../explore/explore.action\";\nimport { getUserById, beforeUser } from \"../user/user.action\";\nimport { Images } from \"../../assets/assets\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst UserProfile = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [nftsCopy, setNFTsCopy] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [user, setUser] = useState(\"\");\n  const [likedNfts, setLikedNfts] = useState();\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n  });\n  const [menuFilter, setMenuFilter] = useState(\"\");\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const priceoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  useEffect(() => {\n    let qs = { ownerId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getProfileNfts(qs);\n    let likedNftsQs = { userId: ENV.getUserKeys(\"_id\")._id };\n    likedNftsQs = ENV.objectToQueryString(likedNftsQs);\n    props.getMyLikedNfts(likedNftsQs);\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n\n  useEffect(() => {\n    if (props.profileNFTsStatus) {\n      if (!menuFilter) {\n        const Nfts = props.profileNFTs.nfts.filter(\n          (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n        );\n        setNFTs(Nfts);\n        setNFTsCopy(props.profileNFTs.nfts);\n        setLoader(false);\n        setFilterationLoader(false);\n      } else {\n        setNFTsCopy(props.profileNFTs.nfts);\n        handleNftFilter(menuFilter);\n        setLoader(false);\n        setFilterationLoader(false);\n      }\n    }\n  }, [props.profileNFTsStatus]);\n  // con\n\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    const { individualUserAuth, individualUser } = props;\n    if (individualUserAuth) {\n      setUser(individualUser);\n    }\n  }, [props.individualUserAuth]);\n\n  const ChangeTooltip = () =>\n    setTimeout(() => {\n      setAddressCopied(false);\n    }, 1000);\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter\n  ) => {\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    nftQS.ownerId = ENV.getUserKeys(\"_id\")._id;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getProfileNfts(qs);\n  };\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, limit: limit + 10 }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      page,\n      limit + 10,\n      collectionId,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setFilterationLoader(true);\n    const {\n      collectionId,\n      gtePrice,\n      ltePrice,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest,\n      page,\n      limit,\n    } = filter;\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      page,\n      limit,\n      id,\n      minValue,\n      maxValue,\n      categoryId,\n      oldest,\n      lowToHigh,\n      highToLow,\n      newest\n    );\n  };\n  const handleLikesTogleApi = (nftId, status) => {\n    increOrDecreLikes(nftId);\n    if (status === \"dislike\") {\n      let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n      setLikedNfts(result);\n      increOrDecreLikes(nftId, \"dec\");\n    } else {\n      let myLikedNfts = [];\n      if (likedNfts && likedNfts.length > 0) {\n        myLikedNfts = likedNfts;\n      }\n\n      let obj = {\n        _id: \"1234455\",\n        nftId,\n      };\n\n      myLikedNfts.push(obj);\n\n      setLikedNfts(myLikedNfts);\n      increOrDecreLikes(nftId, \"inc\");\n    }\n    // setNFTs(nfts);\n    let userId = ENV.getUserKeys(\"_id\")._id;\n\n    let obj = {\n      userId,\n      nftId,\n      count: 1,\n    };\n\n    props.toggleLikeDislike(obj);\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  const handleNftFilter = (id) => {\n    if (id === \"Collected\") {\n      const Nfts = nftsCopy.filter(\n        (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else if (id === \"Created\") {\n      const Nfts = nftsCopy.filter(\n        (item) =>\n          item.ownerId === ENV.getUserKeys(\"_id\")._id &&\n          item.creatorId === ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else {\n      handleFavFilter();\n    }\n  };\n\n  const handleFavFilter = () => {\n    let favNfts = [];\n    nftsCopy.map((item) => {\n      let foundNft = likedNfts.find((liked) => liked.nftId === item._id);\n      if (foundNft) {\n        favNfts.push(item);\n      }\n    });\n\n    setNFTs(favNfts);\n  };\n\n  const menuData = [\"Collected\", \"Created\", \"Favourited\"];\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"User\"} title2={\"UserProfile\"} />\n      <div className=\"collection-detail-hero\">\n        <img src={BannerImg} alt=\"BannerImg\" />\n      </div>\n      <div className=\"collection-detail-content\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12\">\n              <div className=\"collection-owner-avatar text-center\">\n                <img\n                  src={\n                    user?.profileImage\n                      ? user.profileImage\n                      : Images.placeholderImg\n                  }\n                  alt=\"owner-avatar\"\n                />\n              </div>\n              <div className=\"collection-owner-detail text-center mt-3\">\n                {user && (\n                  <div className=\"collection-owner-name\">\n                    <h3>{user.username ? user.username : \"unnamed\"}</h3>\n                  </div>\n                )}\n                <div\n                  className=\"user-address mt-4 d-flex align-items-center \"\n                  onClick={() => {\n                    navigator.clipboard.writeText(user.address);\n                    setAddressCopied(true);\n                    ChangeTooltip();\n                  }}\n                >\n                  <i className=\"fab fa-ethereum\"></i>\n                  <span>{isAddressCopied ? \"Copied\" : \"Copy\"}</span>\n                  {user && (\n                    <p className=\"acc-adress\">\n                      {user.address.slice(0, 10) +\n                        \"...\" +\n                        user.address.slice(-10)}\n                    </p>\n                  )}\n                </div>\n                <p>\n                  Joined <span>February 2022</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div className=\"collections-listing padding-wrapper\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12\">\n                <div className=\"explore-collection-section\">\n                  <div className=\"explore-collection-nav\">\n                    <div className=\"d-flex justify-content-center justify-content-md-end align-items-center\">\n                      {menuData.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleNftFilter(item);\n                              setMenuFilter(item);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img src={SearchIcon} alt=\"search-icon\" className=\"ms-3\" />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {priceoptions &&\n                      priceoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Chains={filterData.chains}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                <div className=\"row g-3\">\n                  {filterationLoader ? (\n                    <div className=\"text-center\">\n                      <div\n                        class=\"spinner-border text-secondary text-white \"\n                        role=\"status\"\n                      >\n                        <span class=\"sr-only\">Loading...</span>\n                      </div>\n                    </div>\n                  ) : nfts && nfts.length > 0 ? (\n                    nfts.map((listing) => {\n                      return (\n                        <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                          <ListingCards\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            // userProfile\n                          />\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-white text-center mt-5\">No NFTs Found</p>\n                  )}\n                </div>\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      props.profileNFTs.pagination > nfts.length &&\n                      nfts.length > 10 && (\n                        <button\n                          className=\"btn btn-linear-gradient px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state, \"state in userProfile\"),\n  {\n    profileNFTs: state.nft.profileNFTs,\n    profileNFTsStatus: state.nft.profileNFTsStatus,\n    myLikedNfts: state.nft.myLikedNfts,\n    myLikedNftsStatus: state.nft.myLikedNftsStatus,\n    individualUser: state.user.individualUser,\n    individualUserAuth: state.user.individualUserAuth,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  getProfileNfts,\n  beforeNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  getUserById,\n  beforeUser,\n})(UserProfile);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/layouts/layout2/layout2.jsx",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/redux/types.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/redux/types/types.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/top-seller/topseller2.js",["752","753","754","755"],"import React, { useEffect, useState } from \"react\";\r\nimport { connect } from \"react-redux\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\r\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\r\nimport \"./topseller.css\";\r\n\r\nconst exmpData = [\r\n  {\r\n    id: 1,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 2,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 3,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 4,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 5,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 6,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 7,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 8,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 9,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 10,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 11,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n  {\r\n    id: 12,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: \"Pablo-Shing\",\r\n    price: \"256.4 ETH\",\r\n  },\r\n];\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n  useEffect(() => {\r\n    setSellers(props.user.sellers);\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  return (\r\n    <section className=\"top-seller-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row\">\r\n          <div className=\"col-12\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content\">\r\n                <span>CREATIVE ARTIST</span>\r\n                <h3 className=\"mb-0\">Top Sellers</h3>\r\n              </div>\r\n              {props.viewAll ? (\r\n                <div className=\"intro-btn\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/top-sellers-list\"\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                </div>\r\n              ) : (\r\n                \"\"\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"row items\">\r\n          {sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              return (\r\n                <div\r\n                  key={`ts_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\r\n                >\r\n                  {/* Single Seller */}\r\n                  <div className=\"card\">\r\n                    <div className=\"single-seller d-flex align-items-center\">\r\n                      <Link to={`/author/${author._id}`}>\r\n                        <div className=\"seller-avatar-container\">\r\n                          <img\r\n                            className=\"avatar-md rounded-circle\"\r\n                            //   src={\r\n                            //     author.profileImage\r\n                            //       ? author.profileImage\r\n                            //       : ENV.globalPlaceholderImage\r\n                            //   }\r\n                            src={AvatarImg}\r\n                            alt=\"\"\r\n                          />\r\n                          <span className=\"seller-avatar-active\">\r\n                            <img src={SellerTickIcon} alt=\"tick-icon\" />\r\n                          </span>\r\n                        </div>\r\n                      </Link>\r\n                      {/* Seller Info */}\r\n                      <div className=\"seller-info ml-3 w-100\">\r\n                        <Link\r\n                          className=\"seller mb-2\"\r\n                          to={`/author/${author._id}`}\r\n                        >\r\n                          {author.username}\r\n                        </Link>\r\n                        <span className=\"text-end\">{\"256.6ETH\"}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })\r\n          ) : (\r\n            <p>Top Sellers not available</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["756","757","758","759","760","761","762","763","764","765","766","767","768","769","770","771","772","773"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\nimport moment from \"moment\";\r\nimport Countdown from \"react-countdown\";\r\nimport { Swiper, SwiperSlide } from \"swiper/react\";\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\nimport { useTimer } from \"react-timer-hook\";\r\nimport { getCreators, beforeUser } from \"./../user/user.action\";\r\nimport image from \"../../assets/images/placeholder.png\";\r\nimport DemoImg from \"../../assets/images/cl-cr-mainimg.png\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n// Swiper.use([Navigation, Pagination]);\r\nconst { globalPlaceholderImage, countDownRenderer } = ENV;\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [creators, setCreator] = useState([]);\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"\");\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n  useEffect(() => {\r\n    // console.log('auth', props.user.topSellersAuth)\r\n    if (props.user.topSellersAuth) {\r\n      setCreator(props.user.sellers);\r\n      setLoader(false);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n\r\n      setAuctions(auctions);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n  const filterCreator = (nft, field) => {\r\n    // console.log('creators', creators)\r\n    // console.log('nft owner', nft)\r\n    const result = creators.find((item) => item._id === nft.nftOwnerId);\r\n    // console.log('reuslt',result\r\n    if (result) {\r\n      if (field === \"userName\") {\r\n        if (result?.username) {\r\n          return result?.username;\r\n        } else {\r\n          return \"no username found\";\r\n        }\r\n      } else if (field == \"profileImage\") {\r\n        if (result.profileImage) {\r\n          return result?.profileImage;\r\n        } else {\r\n          return image;\r\n        }\r\n      }\r\n    }\r\n  };\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  const auctionDemoData = [\r\n    {\r\n      _id: 1,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 2,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 3,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 4,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 5,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 6,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 7,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n    {\r\n      _id: 8,\r\n      image: DemoImg,\r\n      auctionEndDate: new Date(\"2022/1/26 13:10:12\"),\r\n      name: \"Art\",\r\n    },\r\n  ];\r\n  const handleCategoryFilter = (desc) => {\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products. We want to be a part of your\r\n                    smile, success and future growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\r\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-center justify-content-sm-end align-content-xxl-start text-end\">\r\n                {categories &&\r\n                  categories.length > 0 &&\r\n                  categories.map((item, index) => {\r\n                    if (index <= 3) {\r\n                      return (\r\n                        <button\r\n                          className=\"me-1 me-sm-2\"\r\n                          onClick={() => handleCategoryFilter(item.description)}\r\n                        >\r\n                          {item.name}\r\n                        </button>\r\n                      );\r\n                    }\r\n                  })}\r\n                <div className=\"intro-btn\">\r\n                  {/* {auctions && auctions?.length > 4 && ( */}\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/auctions\"\r\n                  >\r\n                    View All\r\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\r\n                  </Link>\r\n                  {/* )} */}\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          {/* //replace arraySample to auctions */}\r\n          {auctionDemoData && auctionDemoData.length > 0 ? (\r\n            <div className=\"auctions-slides\">\r\n              <div className=\"\">\r\n                <CardSlider\r\n                  settings={ENV.auctionCollectionsSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions && auctions.length > 0 ? (\r\n                    auctions.map((item) => {\r\n                      return (\r\n                        <AuctionsCards\r\n                          endDate={item.auctionEndDate}\r\n                          image={item.image}\r\n                          ownerName={item.owner.username}\r\n                          name={item.name}\r\n                          id={item._id}\r\n                        />\r\n                      );\r\n                    })\r\n                  ) : (\r\n                    <p className=\"text-white text-center\">\r\n                      No Live Auctions Found\r\n                    </p>\r\n                  )}\r\n                </CardSlider>\r\n              </div>\r\n            </div>\r\n          ) : (\r\n            <p className=\"text-center ml-3\">No Live Auctions Found</p>\r\n          )}\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/explore/explore-home.js",["774","775","776","777","778","779"],"import React, { useState } from 'react';\nimport ExploreItems from './explore-items';\nimport { Link } from 'react-router-dom';\n\nconst initData = {\n    pre_heading: \"Exclusive Assets\",\n    heading: \"Explore\",\n    btn_1: \"View All\",\n}\n\nfunction ExploreHome() {\n    const [viewAll, setViewAll] = useState(false);\n\n    const getViewAll = (view) => {\n        setViewAll(view)\n    }\nconst nfts=[\n  1,2,3,4,5,6\n]\n    return (\n        <section className=\"explore-area load-more p-0\">\n            <div className=\"container\">\n                <div className=\"row\">\n                    {/* <div className=\"col-12\">\n                        <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                            <div className=\"intro-content\">\n                                <span>{initData.pre_heading}</span>\n                                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n                            </div>\n                            {\n                                viewAll &&\n                                <div className=\"intro-btn\">\n                                    <Link className=\"btn content-btn\" to=\"/explore-all\">{initData.btn_1}</Link>\n                                </div>\n                            }\n                        </div>\n                    </div> */}\n                </div>\n                {/* <ExploreItems key=\"exo\" setView={true} setViewAll={getViewAll} loadMoreBtn nfts={nfts}/> */}\n            </div>\n        </section>\n    );\n}\n\nexport default ExploreHome;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/popular-collections.js",["780","781","782","783","784"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\nimport Collections from \"./collections\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { connect } from \"react-redux\";\nimport { CollectionImages } from \"../../assets/assets.js\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst collectionData = [\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg1,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n  {\n    mainImg: CollectionImages.mainImg2,\n    subImg1: CollectionImages.subImg1,\n    subImg2: CollectionImages.subImg2,\n    subImg3: CollectionImages.subImg3,\n  },\n  {\n    mainImg: CollectionImages.mainImg3,\n    subImg1: CollectionImages.subImg4,\n    subImg2: CollectionImages.subImg5,\n    subImg3: CollectionImages.subImg6,\n  },\n];\n\nconst PopularCollections = (props) => {\n  return (\n    <>\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-0\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products. We want to be a part of your\n                    smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-center justify-content-sm-end align-content-xxl-start text-end\">\n                <button className=\"me-1 me-sm-2 active\">Arts</button>\n                <button className=\"me-1 me-sm-2\">Music</button>\n                <button className=\"me-1 me-sm-2\">Game</button>\n                <button className=\"me-1 me-sm-5\">Sport</button>\n                <div className=\"intro-btn\">\n                  <Link\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\n                    to=\"/popular-collections\"\n                  >\n                    View All\n                    <img src={ViewAllIcon} alt=\"arrow-left\" className=\"ms-2\" />\n                  </Link>\n                </div>\n              </div>\n            </div>\n          </div>\n          <CardSlider\n            settings={ENV.popularCollectionsSettings}\n            homeAuction={false}\n            data={[1, 2, 3, 4]}\n          >\n            {collectionData.map((collectionData) => {\n              return (\n                <CollectionsCard\n                  CardImg={collectionData.mainImg}\n                  Subimg1={collectionData.subImg1}\n                  Subimg2={collectionData.subImg2}\n                  Subimg3={collectionData.subImg3}\n                />\n              );\n            })}\n          </CardSlider>\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, { beforeCategory, getCategories })(\n  PopularCollections\n);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/footer/footer.js",["785","786","787","788","789","790","791","792"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  useEffect(() => {\n    if (props.settings.settingsAuth) {\n      setData(props.settings.settings);\n    }\n  }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div class=\"input-group notify-form\">\n                  <div class=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      class=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2021 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["793","794","795","796"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n    axiosPostFormData,\n    decimalNumberValidator,\n  } from \"./../../utils/functions\";\n  import axios from 'axios'\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    \n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    \nconsole.log(url,\"getNFTs\")\n\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n     \n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n\n      // alert(\"called\")\n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n   \n    });\n};\n\nexport const getNFTsByCollection=(id)=>(dispatch)=>{\n  \n\n  let data ={\n    collectionId:id\n  }\n\n\n  dispatch(emptyError());\n\n    const url = `${ENV.url}nfts/getNFTsByCollection`;\n    axios.post(url,data)\n    .then(function (response) {\n  \n      if (response.data.success) {\n              dispatch({\n                type:GET_NFTS_BY_COLLECTION,\n                payload:response.data.data\n              })\n         \n            } else {\n              dispatch({\n                type: GET_ERRORS,\n                payload: response.data,\n              });\n            }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n              type: GET_ERRORS,\n              payload: error,\n            });\n    });\n  \n  \n}\n\nexport const getMyLikedNfts=(qs='')=>(dispatch)=>{\n\n\n  dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url=url+qs\n    axios.get(url)\n    .then(function (response) {\nconsole.log()\n      if (response.data.success) {\n        dispatch({\n          type: GET_MYLIKED_NFTS,\n          payload: response.data.data,\n        });\n         \n            } else {\n             \n            }\n    })\n    .catch(function (error) {\n      console.log(error);\n    \n    });\n  \n  \n}\n\nexport const createNFT= async (formData)=>{\n    try {\n\n        const res = await axiosPostFormData(\n            \"nfts/create\",\n            formData,\n            true\n          );\n    }\n    catch(err){\n\n    }\n}\nexport const setNftToken = (formData) => async (dispatch) => {\n\n  const res = await axiosPostFormData(\n            \"nfts/storeNFTData\",\n            formData,\n            true\n          );\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        console.log(data,\"profile nfts\")\n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n          \n        } else {\n     \n        }\n      })\n      .catch((errors) => {\n     \n      });\n  };\n\n\n\n\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/explore/explore-items.js",["797","798","799","800","801","802","803"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nimport NftCard from '../collections/components/NftCard/NftCard'\nconst initData = {\n    btn_1: \"Load More\",\n}\n\nfunction ExploreItems(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n\n    useEffect(() => {\n        // get NFTs for explore section\n        const nftQS = { page: 1, limit: 4, explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }, [])\n\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            if (nftsData) {\n                setNFTs(nftsData.nfts)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n                setLoader(false)\n                if (props.setView)\n                    props.setViewAll(nftsData.nfts && nftsData.nfts.length > 0)\n            }\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n\n        // get more NFTs for explore section\n        const nftQS = { page: 1, limit: limit * (page + 1), explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n    return (\n        <>\n            {/* <div className={`row items ${props.class1 ? props.class1 : ''} ${!nfts.length ? 'justify-content-center' : ''}`}> */}\n            <div className=\"row\">\n            <div className=\"row justify-content-center mt-5 w-100\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                {/* <span>{initData.pre_heading}</span> */}\n                                <span>Explore</span>\n                                {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                                    <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                            </div>\n                        </div>\n                    </div>\n\n                {\n                    props.nfts && props.nfts.length > 0 ?\n                        props.nfts.map((item, idx) => {\n                            return (\n                                \n                                // <div key={`${props.key}_${idx}`} className={`col-12 col-sm-6 col-lg-3 item d-block ${props.class2 ? props.class2 : ''}`}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <Link to=\"/author\">\n                                //                         <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6>\n                                //                     </Link>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     {/* <span>{item.sold} of {item.copies}</span> */}\n                                //                 </div>\n                                //                 {/* <Link className=\"btn btn-bordered-white btn-smaller mt-3\" to=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</Link> */}\n                                //             </div>http://3.142.91.8/authorshttp://3.142.91.8/authors\n                                //         </div>\n                                //     </div>\n                                // </div>\n                                     \n                      <>\n                     \n                                     <div className=\"col-4 mt-5\">\n                                     <NftCard/>\n                                     </div>\n\n                                     </>\n                              \n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Explore</p>\n                }  </div>\n            {/* </div> */}\n            {\n                props.loadMoreBtn &&\n                <div className=\"row\">\n                    <div className=\"col-12 text-center\">\n                        <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                    </div>\n                </div>\n            }\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs })(ExploreItems);","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/user/user.action.js",["804"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport { GET_ERRORS, SET_USER, GET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, BEFORE_USER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { getCollections, setAuthState } from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n    return {\n        type: BEFORE_USER\n    }\n}\n\n// method to set user data\nexport const setUser = (user) => dispatch => {\n    dispatch(emptyError())\n    dispatch({\n        type: SET_USER,\n        payload: user\n    })\n}\n\n// method to get user data\nexport const getUser = () => dispatch => {\n    dispatch({\n        type: GET_USER\n    })\n}\n\n// method to login using wallet address and sign\nexport const login = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/login/`;\n    // const url = `http://localhost:5000/v1/front/auth/login/`;\n    console.log(payload,\"payload\")\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            const userId = data.data._id;\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => dispatch => {\n    \n    dispatch(emptyError());\n    const url = `${ENV.url}auth/register/`;\n \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        console.log(errors,\"register resonse\")\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n            toast.success(data.message)\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getTopSellers = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/top-sellers`;\n   \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n     \n        if (data.status) {\n            dispatch({\n                type: TOP_SELLERS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n     \n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getCreators = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/creators`;\n    // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n    \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n      \n        if (data.status) {\n            dispatch({\n                type: SET_CREATORS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/${userId}`;\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"user response\")\n        if (data.status) {\n            dispatch({\n                type: SET_INDIVIDUAL_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => dispatch => {\n    dispatch(emptyError());\n    dispatch({\n        type: SET_INDIVIDUAL_USER,\n        payload: user\n    })\n};\n\nexport const logoutUser = () => (dispatch) => {\n    dispatch({\n        type: SET_USER,\n        userAuth: false,\n        userData: null\n    })\n    dispatch(setAuthState())\n    localStorage.removeItem('encuse');\n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/auctions/auctions.action.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/collections.js",["805","806","807"],"import React, {\r\n  useState,\r\n  useEffect,\r\n  forwardRef,\r\n  useImperativeHandle,\r\n} from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { ENV } from \"../../config/config\";\r\nimport { beforeCollection, getCollections } from \"./collections.actions\";\r\nconst { collectionFeaturedImg, userDefaultImg } = ENV;\r\n\r\nconst Collections = forwardRef((props, ref) => {\r\n  const [collections, setCollections] = useState(null);\r\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    if (props.source) setSource(props.source);\r\n\r\n    if (props.setLoader) props.setLoader(false); //to be changed\r\n\r\n    getCollections();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.collection.getAuth) {\r\n      const { collections } = props.collection;\r\n      const userId = ENV.getUserKeys(\"_id\")._id;\r\n      if (props.mycollections) {\r\n        let myCollections = collections.filter(\r\n          (item) => item.userId === userId\r\n        );\r\n        setCollections(myCollections);\r\n      } else {\r\n        setCollections(collections);\r\n      }\r\n      props.beforeCollection();\r\n      if (props.setLoader) props.setLoader(false);\r\n    }\r\n  }, [props.collection.getAuth]);\r\n\r\n  const getCollections = (categoryId = null) => {\r\n    const filter = {\r\n      page: 1,\r\n    };\r\n    if (categoryId) filter.categoryId = categoryId;\r\n\r\n    if (props.userId) filter.userId = props.userId;\r\n\r\n    if (props.popular) filter.popular = true;\r\n\r\n    // if not all then apply limit\r\n    if (!props.all) filter.limit = props.limit ? props.limit : 8;\r\n    else filter.all = true;\r\n\r\n    const qs = ENV.objectToQueryString(filter);\r\n    props.getCollections(qs);\r\n  };\r\n\r\n  useImperativeHandle(ref, () => ({\r\n    getCatCollections: (catId) => {\r\n      if (props.setLoader) props.setLoader(true);\r\n\r\n      getCollections(catId);\r\n    },\r\n    colCount: collections?.length || 0,\r\n  }));\r\n\r\n  const dummyCollections = [\r\n    {\r\n      id: 1,\r\n      name: \"Modern Art collection\",\r\n      itemNos: \"5\",\r\n      owner: \"Abcd\",\r\n    },\r\n    {\r\n      id: 2,\r\n      name: \"Modern Art collection\",\r\n      itemNos: \"5\",\r\n      owner: \"Abcd\",\r\n    },\r\n  ];\r\n\r\n  return (\r\n    <div className=\"popular-collections-area\">\r\n      <div className=\"container\">\r\n        <div\r\n          className={`row items ${!collections && \"justify-content-center\"}`}\r\n        >\r\n          <>\r\n            {/* {collections && collections.length ? (\r\n              collections.map((item, idx) => { */}\r\n            {dummyCollections && dummyCollections.length ? (\r\n              dummyCollections.map((item, idx) => {\r\n                return (\r\n                  <div\r\n                    key={`cd_${idx}`}\r\n                    className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                  >\r\n                    <div className=\"card no-hover text-center\">\r\n                      <div className=\"image-over\">\r\n                        <Link\r\n                          to={`/collection-details/${window.btoa(item._id)}`}\r\n                        >\r\n                          <img\r\n                            className=\"card-img-top\"\r\n                            src={\r\n                              item.featuredImg\r\n                                ? item.featuredImg\r\n                                : collectionFeaturedImg\r\n                            }\r\n                            alt=\"Collection Featured Image\"\r\n                          />\r\n                        </Link>\r\n                        <Link\r\n                          className=\"seller\"\r\n                          to={\r\n                            source === 1\r\n                              ? `/collection-details/${window.btoa(item._id)}`\r\n                              : `/author/${item.user._id}`\r\n                          }\r\n                        >\r\n                          <div className=\"seller-thumb avatar-lg\">\r\n                            <img\r\n                              className=\"rounded-circle\"\r\n                              src={\r\n                                source === 1\r\n                                  ? item.logo\r\n                                  : item.user.profilePhoto\r\n                                  ? item.user.profilePhoto\r\n                                  : userDefaultImg\r\n                              }\r\n                              alt={\r\n                                source === 1 ? \"Collection Logo\" : \"User Avatar\"\r\n                              }\r\n                            />\r\n                          </div>\r\n                        </Link>\r\n                      </div>\r\n                      <div className=\"card-caption col-12 p-0\">\r\n                        <div className=\"card-body mt-4\">\r\n                          <Link\r\n                            to={`/collection-details/${window.btoa(item._id)}`}\r\n                          >\r\n                            <h5 className=\"mb-2\">{item.name}</h5>\r\n                          </Link>\r\n                          <span>\r\n                            {item.category\r\n                              ? item.category.name\r\n                              : \"Category: N/A\"}\r\n                          </span>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                );\r\n              })\r\n            ) : (\r\n              <div className=\"col-12\">\r\n                <p className=\"text-center mt-4\">No Collection Found</p>\r\n              </div>\r\n            )}\r\n          </>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n});\r\n\r\nconst mapStateToProps = (state) => ({\r\n  collection: state.collection,\r\n  error: state.error,\r\n});\r\n\r\nexport default connect(\r\n  mapStateToProps,\r\n  { beforeCollection, getCollections },\r\n  null,\r\n  { forwardRef: true }\r\n)(Collections);\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/header/header.js",["808","809","810","811","812","813","814"],"import React, { useState, useEffect } from \"react\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { setWalletAddress, getWalletAddress } from \"../wallet/wallet.action\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport { logoutUser } from \"../user/user.action\";\nimport { ENV } from \"./../../config/config\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport MintsClubLogo from \"../../assets/images/main-logo.svg\";\n\nconst Header = (props) => {\n  const history = useHistory();\n  // console.log(\"history\", history);\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [loader, setLoader] = useState(true);\n  const { _id } = ENV.getUserKeys(\"_id\");\n\n  useEffect(async () => {\n    // COMMENTED TEMPORARILY\n    // METHOD 1\n    // props.getWalletAddress()\n\n    // METHOD 2 - a\n    // let connectedAddress = await connectMetamask();\n    // setConnectedAddress(connectedAddress)\n\n    // METHOD 3\n    // if (localStorage.getItem('wa')) {\n    //     let connectedAddress = window.atob(localStorage.getItem('wa'))\n    //     setConnectedAddress(connectedAddress)\n    // }\n\n    // METHOD 4\n    let connectedAddress = await connectMetamaskCopy();\n    setConnectedAddress(connectedAddress);\n    props.setWalletAddress(connectedAddress);\n  }, []);\n\n  // set loader to false when address is received\n  useEffect(() => {\n    if (connectedAddress) setLoader(false);\n  }, [connectedAddress]);\n\n  // COMMENTED TEMPORARILY\n  // METHOD 2 - b\n  // useEffect(() => {\n  //     if (props.wallet.walletAuth) {\n  //         const { connectedAddress } = props.wallet\n  //         setConnectedAddress(connectedAddress)\n  //     }\n  // }, [props.wallet.walletAuth])\n  const formatAddress = (address) => {\n    return address ? address.substr(0, 6) + \"...\" + address.substr(-4) : null;\n  };\n  const logoutUser = () => {\n    props.logoutUser();\n    history.push(\"/login\");\n  };\n\n  return (\n    <header id=\"header\">\n      <div className=\"container header\">\n        {/* Navbar */}\n        <nav\n          data-aos=\"zoom-out\"\n          data-aos-delay={800}\n          className=\"navbar navbar-expand\"\n        >\n          {/* Navbar Brand*/}\n          <Link className=\"navbar-brand\" to=\"/\">\n            <img\n              className=\"navbar-brand-sticky\"\n              src={MintsClubLogo}\n              alt=\"sticky brand-logo\"\n            />\n          </Link>\n          <div className=\"ml-auto\" />\n          {/* Navbar */}\n          <ul className=\"navbar-nav items mx-auto\">\n            <li className=\"nav-item dropdown\">\n              <Link className=\"nav-link\" to=\"/\">\n                Home\n              </Link>\n            </li>\n            <li className=\"nav-item dropdown\">\n              <a className=\"nav-link\">\n                Explore <i className=\"fas fa-angle-down ml-1\" />\n              </a>\n              <ul className=\"dropdown-menu\">\n                <li className=\"nav-item\">\n                  <Link to=\"/explore-all\" className=\"nav-link\">\n                    Explore\n                  </Link>\n                </li>\n                <li className=\"nav-item\">\n                  <Link to=\"/auctions\" className=\"nav-link\">\n                    Live Auctions\n                  </Link>\n                </li>\n                {/* <li className=\"nav-item\"><Link to=\"/item-details\" className=\"nav-link\">Item Details</Link></li> */}\n              </ul>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/activity\" className=\"nav-link\">\n                Activity\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/collections\" className=\"nav-link\">\n                Collections\n              </Link>\n            </li>\n            {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Community <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/blog\" className=\"nav-link\">Blog</a></li>\n                                <li className=\"nav-item\"><a href=\"/blog-single\" className=\"nav-link\">Blog Single</a></li>\n                                <li className=\"nav-item\"><a href=\"/help-center\" className=\"nav-link\">Help Center</a></li>\n                            </ul>\n                        </li> */}\n            {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Pages <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/authors\" className=\"nav-link\">Authors</a></li>\n                                <li className=\"nav-item\"><a href=\"/author\" className=\"nav-link\">Author</a></li>\n                                <li className=\"nav-item\"><a href=\"/wallet-connect\" className=\"nav-link\">Wallet Connect</a></li>\n                                <li className=\"nav-item\"><a href=\"/create\" className=\"nav-link\">Create</a></li>\n                                <li className=\"nav-item\"><a href=\"/login\" className=\"nav-link\">Login</a></li>\n                                <li className=\"nav-item\"><a href=\"/signup\" className=\"nav-link\">Signup</a></li>\n                            </ul>\n                        </li> */}\n            <li className=\"nav-item\">\n              <Link to=\"/contact\" className=\"nav-link\">\n                Contact\n              </Link>\n            </li>\n            <li className=\"nav-item\">\n              <Link to=\"/history\" className=\"nav-link\">\n                History\n              </Link>\n            </li>\n          </ul>\n          {/* Navbar Icons */}\n          <ul className=\"navbar-nav icons\">\n            <li className=\"nav-item\">\n              <a\n                href=\"#\"\n                className=\"nav-link \"\n                data-toggle=\"modal\"\n                data-target=\"#search\"\n              >\n                <i className=\"fas fa-search\" />\n              </a>\n            </li>\n          </ul>\n          {/* Navbar Toggler */}\n          <ul className=\"navbar-nav toggle\">\n            <li className=\"nav-item\">\n              <a\n                href=\"#\"\n                className=\"nav-link\"\n                data-toggle=\"modal\"\n                data-target=\"#menu\"\n              >\n                <i className=\"fas fa-bars toggle-icon m-0\" />\n              </a>\n            </li>\n          </ul>\n          {/* Navbar Action Button */}\n          <ul className=\"navbar-nav action\">\n            <li className=\"nav-item ml-3\">\n              {connectedAddress && _id ? (\n                <button\n                  className=\"btn ml-lg-auto btn-linear-gradient\"\n                  onClick={logoutUser}\n                >\n                  <i className=\"icon-logout mr-md-2\" /> Logout\n                </button>\n              ) : (\n                // <span id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />{formatAddress(connectedAddress)}</span>\n                <Link\n                  to=\"/login\"\n                  id=\"wallet-address\"\n                  className=\"btn ml-lg-auto btn-linear-gradient\"\n                >\n                  {/* <i className=\"icon-wallet mr-md-2\" /> */}\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  Login\n                </Link>\n              )}\n            </li>\n          </ul>\n        </nav>\n      </div>\n    </header>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n});\nexport default connect(mapStateToProps, {\n  setWalletAddress,\n  getWalletAddress,\n  logoutUser,\n})(Header);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/hero/hero.js",["815","816"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport ExploreIcon from \"../../assets/images/explore-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-rounded-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                {/* <i className=\"icon-rocket mr-2\" /> */}\r\n                <img src={ExploreIcon} alt=\"exploreIcon\" className=\"me-2\" />\r\n                <p>Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"d-lg-none d-flex watch-video align-items-center mt-5 mb-4\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6 col-xl-7 \">\r\n            <Slider\r\n              setHandler={setHandler}\r\n              sliderRadioButtons={sliderRadioButtons}\r\n              handleRadioInputs={handleRadioInputs}\r\n              sliderChecked={sliderChecked}\r\n            />\r\n          </div>\r\n          <div className=\"d-none d-lg-block col-12 col-lg-7\">\r\n            <div className=\"watch-video d-flex align-items-center\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-5\">\r\n            <div className=\"btn-container mx-auto mx-lg-0\">\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn me-3\"\r\n                onClick={prevBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-left\"></i>\r\n              </button>\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn\"\r\n                onClick={nextBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-right\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default Hero;\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/work/work.js",["817","818","819"],"import React, { Component } from \"react\";\r\nimport WalletIcon from \"../../assets/images/setup-wallet-icon-white.svg\";\r\nimport CollectionIcon from \"../../assets/images/collection-icon-white.svg\";\r\nimport AddNftIcon from \"../../assets/images/add-nft-icon-white.svg\";\r\nimport SaleIcon from \"../../assets/images/sale-icon-white.svg\";\r\nimport axios from \"axios\";\r\nimport { init } from \"aos\";\r\n\r\n// const BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json/work\";\r\nconst BASE_URL = \"../../json-server/db.json/work\";\r\nconst initData = {\r\n  preHeading: \"How It Works\",\r\n  heading: \"Create and sell your NFTs\",\r\n  workData: [\r\n    {\r\n      id: 1,\r\n      icon: \"icons icon-wallet text-effect\",\r\n      img: WalletIcon,\r\n      title: \"Set up your wallet\",\r\n      text: \"Once you've set up your Celo or BSC Metamask wallet, connect to ARI NFT Marketplace by Signing In and clicking Login.\",\r\n    },\r\n    {\r\n      id: 2,\r\n      icon: \"icons icon-grid text-effect\",\r\n      img: CollectionIcon,\r\n      title: \"Create your collection\",\r\n      text: \"Click Create and set up your collection. Add social links, a description, profile & banner images, and set a secondary sales fee.\",\r\n    },\r\n    {\r\n      id: 3,\r\n      icon: \"icons icon-drawer text-effect\",\r\n      img: AddNftIcon,\r\n      title: \"Add your NFTs\",\r\n      text: \"Upload your work (image, video, audio, or 3D art), add a title and description, and customize your NFTs with properties, stats, and unlockable content.\",\r\n    },\r\n    {\r\n      id: 4,\r\n      icon: \"icons icon-bag text-effect\",\r\n      img: SaleIcon,\r\n      title: \"List them for sale\",\r\n      text: \"Choose between auctions, fixed-price listings, and declining-price listings. You choose how you want to sell your NFTs!\",\r\n    },\r\n  ],\r\n};\r\n// console.log('base url',BASE_URL)\r\nclass Work extends Component {\r\n  state = {\r\n    data: {},\r\n    workData: [],\r\n  };\r\n  componentDidMount() {\r\n    this.setState({\r\n      data: initData,\r\n      workData: initData.workData,\r\n    });\r\n    // axios.get(`${BASE_URL}`)\r\n    //     .then(res => {\r\n    //         this.setState({\r\n    //             data: res.data,\r\n    //             workData: res.data.workData\r\n    //         })\r\n    //         console.log(this.state.data)\r\n    //     })\r\n    // .catch(err => console.log(err))\r\n  }\r\n  render() {\r\n    return (\r\n      <section className=\"work-area padding-wrapper\">\r\n        <div className=\"container\">\r\n          <div className=\"row\">\r\n            <div className=\"col-12\">\r\n              {/* Intro */}\r\n              <div className=\"intro mb-4\">\r\n                <div className=\"intro-content\">\r\n                  <span>{this.state.data.preHeading}</span>\r\n                  <h3 className=\"mb-0\">{this.state.data.heading}</h3>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"row items mt-3 mt-lg-5\">\r\n            {this.state.workData.map((item, idx) => {\r\n              return (\r\n                <div\r\n                  key={`wd_${idx}`}\r\n                  className=\"col-12 col-sm-6 col-lg-3 item\"\r\n                >\r\n                  {/* Single Work */}\r\n                  <div className=\"single-work\">\r\n                    {/* <i className={`${item.icon} mb-5`} /> */}\r\n                    <img src={item.img} alt=\"icon\" className=\"mb-3\" />\r\n                    <h4 className=\"mb-3\">{item.title}</h4>\r\n                    <p>{item.text}</p>\r\n                  </div>\r\n                </div>\r\n              );\r\n            })}\r\n          </div>\r\n        </div>\r\n      </section>\r\n    );\r\n  }\r\n}\r\n\r\nexport default Work;\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/authors/authors.js",["820","821"],"import React, { useEffect, useState } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport {Link} from 'react-router-dom';\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst Authors = (props) => {\r\n    const [creators, setCreators] = useState([]);\r\n    useEffect(()=> {\r\n        props.getCreators();\r\n        window.scrollTo(0, 0)\r\n    }, []);\r\n    useEffect(()=> {\r\n        setCreators(props.user.sellers)\r\n      \r\n    }, [props.user.topSellersAuth]);\r\n\r\n    return (\r\n        <section className=\"popular-collections-area mt-5\">\r\n            <br />\r\n            <br />\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>Creators</span>\r\n                            <h3 className=\"mt-3 mb-0\">Our Creators</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row items\">\r\n                    {\r\n                        creators && creators.length ? \r\n                        creators.map((author, key)=> {\r\n                            return (\r\n                                <div key={`author_${key}`} className=\"col-12 col-sm-6 col-lg-3 item\">\r\n                                    <div className=\"card no-hover text-center\">\r\n                                        <div className=\"image-over\">\r\n                                            <Link to={`/author/${author._id}`}>\r\n                                                <img className=\"card-img-top\" src={author.profileImage ? author.profileImage: ENV.globalPlaceholderImage} alt=\"Author profile\" />\r\n                                            </Link>\r\n                                        </div>\r\n                                        <div className=\"card-caption col-12 p-0\">\r\n                                            <div className=\"card-body mt-1\">\r\n                                                <Link to={`/author/${author._id}`}>\r\n                                                    <h5>{author.username ? author.username : author.address} </h5>\r\n                                                </Link>\r\n                                                <button type=\"button\" className=\"btn btn-bordered-white btn-smaller\">Follow</button>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                  \r\n                                </div>\r\n                            )\r\n                        })\r\n                        : \r\n                        <p>No Creators Found</p>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n   \r\n    {\r\n    user: state.user\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getCreators })(Authors);","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/buy-sell/Buysell.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["822","823","824","825","826"],"import React, { useEffect, useState } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.svg\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../config/config\";\n\nimport { connect } from \"react-redux\";\n\nimport \"./AuctionsCard.css\";\nimport { propTypes } from \"react-recaptcha\";\n\nconst AuctionsCards = (props) => {\n  const { countDownRenderer } = ENV;\n  const history = useHistory();\n  // console.log(auctions,\"auctions123\")\n  return (\n    <Card\n      className=\"auction-card mx-2\"\n      onClick={() => history.push(`nftdetail/${props.id}`)}\n    >\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={props.image} alt=\"AuctionTopImg\" />\n        <div className=\"auction-countdown mb-3\">\n          <Countdown date={props.endDate} renderer={countDownRenderer} />\n        </div>\n      </div>\n      <Card.Body>\n        <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n          <div className=\"auction-card-avatar d-flex align-items-center\">\n            <img src={AvatarImg} alt=\"AvatarImg\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <span className=\"ms-4\">9+ Place Bit</span>\n          </div>\n\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <Card.Title>{props.name}</Card.Title>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>\n              {\"Owned by \"}\n              {props.ownerName}\n            </p>\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state in nfts\"),\n  ({});\n\nexport default connect(mapStateToProps, {})(AuctionsCards);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/collections.actions.js",["827","828"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_COLLECTION, SET_AUTH_STATE, GET_COLLECTION, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS,BEFORE_CATEGORY, GET_CATEGORIES,COLLECTION_CATEGORES ,MY_COLLECTIONS} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\n\nexport const beforeCollection = () => {\n    return {\n        type: BEFORE_COLLECTION\n    }\n}\n\nexport const getCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}collection/get/${collectionId}`;\n \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getCollections = (qs = null) => dispatch => {\n\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs)\n    url += `?${qs}`\n   console.log(url,\"url sending\")\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n   console.log(data,\"collections api response\")\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n       \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const myCollections = (userId) => dispatch => {\n\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/myCollectionList`;\n\n    if (userId)\n    url += `?userId=${userId}`\n    \n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            \n            dispatch({\n                type: MY_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data.message\n            })\n        }\n    }).catch(error => {\n      \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\nexport const upsertCollection = (apiURL, body, method = 'POST') => dispatch => {\n\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n\n    fetch(url, {\n        method,\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: UPSERT_COLLECTION,\n                payload: data\n            })\n            \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}collection/delete/${collectionId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const setAuthState = () => (dispatch) => {\n    dispatch({\n        type: SET_AUTH_STATE,\n    })\n}\nexport const beforeCategory = () => {\n    return {\n        type: BEFORE_CATEGORY\n    }\n}\nexport const getCategories = () => dispatch => {\n  \n    dispatch(emptyError());\n    const url = `${ENV.url}category/list`;\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n \n        if (data.status) {\n         \n            dispatch({\n                type: COLLECTION_CATEGORES,\n                payload: data.categories\n            })\n\n         \n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"error==>\")\n     \n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const toggleLikeDislike = (body) => dispatch => {\n let data=JSON.stringify(body)\n    const url = `${ENV.url}collectionLikes/likeDislike`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        data\n    }).then(res => res.json()).then(data => {\n  \n       \n    }).catch(error => {\n     console.log(error,\"error likes\")\n    })\n};","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/utils/functions.js",["829","830","831","832","833","834","835","836","837"],"import axios from \"axios\";\nimport { ENV } from '../config/config';\nimport { Redirect } from 'react-router-dom';\nimport { toast } from 'react-toastify'\nimport { useDispatch } from \"react-redux\";\nimport { emptyError } from '../redux/shared/error/error.action';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID } from '../redux/types';\nlet baseUrl = process.env.REACT_APP_BASE_URL;\n\nexport const axiosSyncPost = (url, data, isMultipart = false) => {\n  return new Promise((resolve, reject) => {\n    const params = new URLSearchParams();\n    let keys = Object.keys(data);\n    for (let x = 0; x < keys.length; x++) {\n      params.append(keys[x], data[keys[x]]);\n    }\n\n    const config = {\n      headers: {\n        'Content-Type': isMultipart ? 'multipart/form-data' : 'application/x-www-form-urlencoded',\n        \"Authorization\": ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n    };\n\n    url = baseUrl + url;\n\n    axios.post(url, params, config).then(\n      (res) => {\n        resolve(res.data);\n      },\n      (error) => {\n        resolve(error)\n      },\n    );\n  });\n};\n\nexport const axiosPostFormData = (url, body, isMultipart = false) => {\n\n  return new Promise((resolve, reject) => {\n    const config = {\n      headers: {\n        // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n        \"Authorization\": ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n    };\n    \n\n    // url = testingURl + url;\n\n\n    axios.post(ENV.url + url, body, config).then(\n      (res) => {\n        // console.log(res,\"res success\");\n        resolve(res.data)\n      },\n      (error) => {\n        console.log(error,\"res error\");\n        resolve(error)\n      },\n    );\n  });\n};\n\nexport const decimalNumberValidator = (evt) => {\n  let e = evt || window.event;\n\n  // Allow: backspace, delete, tab, escape, enter and .\n  const specialKeys = [46, 8, 9, 27, 13, 110]\n\n  // Allow: Ctrl+A,Ctrl+C,Ctrl+V, Command+A\n  if (specialKeys.includes(e.keyCode) ||\n    // Allow: Ctrl+A,Ctrl+C,Ctrl+Z,Ctrl+X Command+A\n    ((e.keyCode === 65 || e.keyCode === 67 || e.keyCode === 90 || e.keyCode === 88) && (e.ctrlKey === true || e.metaKey === true)) ||\n    // Allow: home, end, left, right, down, up\n    (e.keyCode >= 35 && e.keyCode <= 40)) {\n    // let it happen, don't do anything\n    return;\n  }\n\n  let key = e.keyCode || e.which;\n  if ((!e.shiftKey && !e.altKey && !e.ctrlKey) &&\n    (((key === 190 || key === 110) ||\n      (key >= 48 && key <= 57)) ||\n      (key >= 96 && key <= 105) ||\n      key === 8 || key === 9 || key === 13 ||\n      key === 35 || key === 36 ||\n      key === 37 || key === 39 ||\n      key === 46 || key === 45)) {\n  }\n  else {\n    e.returnValue = false;\n    if (e.preventDefault) e.preventDefault();\n  }\n}\nexport const setFixedPriceNftTOken=(body)=>{\n  let url = `${ENV.url}nftFixedTokens/getFixedtokens`;\n  // let url = `http://3.142.91.8/v1/front/auctions/live`;\n \n  // console.log(url,\"url==>123\")\n    \n\n  fetch(url, {\n      method: 'POST',\n      headers: {\n          'content-type': 'application/json',\n          'Authorization': ENV.Authorization,\n          'x-auth-token': ENV.x_auth_token,\n          'Access-Control-Allow-Origin': '*',\n          'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n      },\n      body:body\n  }).then(res => res.json()).then(data => {\n      // console.log(data,\"created nft token\")\n      if (data.success) {\n        \n      } else {\n         \n      }\n  }).catch(errors => {\n      console.log(errors,\"error\")\n  })\n}\n\nexport const changeOwnerShip=(nftOwnerId,currentUserId)=>{\n  // alert(\"changing ownership\")\n  let url = `${ENV.url}nfts/editNft`;\n  // console.log('fetch url', url)\nlet body={\n  nftOwnerId,\n  currentUserId\n}\n  fetch(url, {\n    method: 'PATCH',\n    headers: {\n      'content-type': 'application/json',\n      'Authorization': ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  },\n    body:JSON.stringify(body)\n     }).then(res => res.json()).then(data => {\n       if(data.status === 'success'){\n        toast.success(\"Successfully bought nft\")\n        window.location.href= '/explore-all'\n       }\n      // console.log(data,\"response from the change ownershiop\")\n     }).catch(errors => {\n       console.log('error',errors)\n    })\n}\nexport const acceptBit = (tokenId,body)  => {\n \n   \n    const url = `${ENV.url}bid/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n            window.location.href= '/explore-all'\n            // dispatch({\n            //     type: ACCEPT_BID,\n            //     payload: data\n            // })\n        } else {\n            toast.error(data.message)\n          \n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n      \n    })\n\n}\n\nexport const placeBidApi = (body) =>  {\n\n  console.log('im here')\n\n\n  const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n    //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n           \n            toast.success(data.message)\n            window.location.href= '/explore-all'\n            // dispatch({\n            //     type: CREATE_BID,\n            //     payload: data\n            // })\n        } else {\n            toast.error(data.message)\n            // dispatch({\n            //     type: GET_ERRORS,\n            //     payload: data\n            // })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        // dispatch({\n        //     type: GET_ERRORS,\n        //     payload: error\n        // })\n    })\n \n \n}","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["838","839","840","841"],"import React from \"react\";\nimport { Link, useHistory, useLocation } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [activeTab, setActiveTab] = React.useState(null);\n  const history = useHistory();\n  const location = useLocation();\n\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n    console.log(\"clicked\");\n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"dark\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <Navbar.Brand to=\"/\" href=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </Navbar.Brand>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav\n              className=\"mx-xl-auto\"\n              defaultActiveKey={`${location.pathname}`}\n            >\n              <Nav.Link to=\"/\" href=\"/\" className=\"nav-main-link\">\n                Home\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                active={activeTab === 1}\n                defaultActiveKey={activeTab}\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item\n                  to=\"/explore/exploreAll\"\n                  href=\"/explore/exploreAll\"\n                  active={activeTab === 1}\n                  eventKey={1}\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/explore/exploreAll\"\n                      ? \"active-item\"\n                      : \"\"\n                  }`}\n                  onClick={() => {\n                    setActiveTab(1);\n                  }}\n                >\n                  Explore All\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/explore/allNFT\"\n                  href=\"/explore/allNFT\"\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/explore/allNFT\" ? \"active-item\" : \"\"\n                  }`}\n                  eventKey={2}\n                  active={activeTab === 2}\n                  onClick={() => {\n                    setActiveTab(2);\n                  }}\n                >\n                  All NFT\n                </NavDropdown.Item>\n              </NavDropdown>\n\n              <Nav.Link to=\"/create\" href=\"/create\" className=\"nav-main-link\">\n                Create\n              </Nav.Link>\n              <Nav.Link\n                to=\"/userprofile\"\n                href=\"/userprofile\"\n                className=\"nav-main-link\"\n              >\n                Profile\n              </Nav.Link>\n\n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div class=\"search-box mt-1 mt-sm-0 d-sm-none\">\n                <input\n                  class=\"search-txt \"\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                />\n                <a class=\"search-btn\" href=\"#\">\n                  <img src={SearchIcon} alt=\"search-icon\" />\n                </a>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div class=\"search-box \">\n              <input\n                class=\"search-txt\"\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n              />\n              <a class=\"search-btn me-1 mt-1\" href=\"#\">\n                <img src={SearchIcon} alt=\"search-icon\" />\n              </a>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/components/NftCard/NftCard.js",["842","843"],"import react from \"react\";\nimport { Link } from \"react-router-dom\";\nimport \"./NftCard.css\";\n\nconst NftCard = (props) => {\n  const filterCreator = (nft) => {\n    const result = props.creators.find((item) => item._id === nft.nftOwnerId);\n    if (result?.username) {\n      return result?.username;\n    } else {\n      return \"no username found\";\n    }\n  };\n  const { userId, nft } = props;\n  return (\n    <div className=\"NftCard-Container \">\n      <Link to={`/item-details?item=${window.btoa(props.nft._id)}`}>\n        <img\n          src={\n            props?.nft?.image ? props.nft.image : \"https://picsum.photos/200\"\n          }\n          alt=\"testinImage\"\n          className=\"nft-car-img\"\n        />\n      </Link>\n\n      <div className=\"NftCard-description p-3\">\n        <p className=\"mb-0 text-white\">\n          {props?.nft?.name ? props.nft.name : \"someTHing\"}\n        </p>\n        <p className=\"text-white\">Owned By: {filterCreator(props.nft)}</p>\n        <div className=\"d-flex w-100 justify-content-between\">\n          <p className=\"mb-0 text-white\">\n            {props?.nft?.currentPrice ? props.nft.currentPrice : \"0.04\"}\n          </p>\n          <p className=\"mt-0 text-white\">\n            {props?.nft?.sold ? props.nft.sold : \"0\"} out of {props.nft.copies}\n          </p>\n        </div>\n        <div className=\"py-3\">\n          <Link\n            to={`/item-details?item=${window.btoa(props.nft._id)}`}\n            id=\"wallet-address\"\n            className=\"btn ml-lg-auto btn-bordered-white\"\n          >\n            <i className=\"icon-wallet mr-md-2\" />\n            {nft.nftOwnerId === userId\n              ? \"Sell NFT\"\n              : nft.sellingMethod === undefined\n              ? \"NFT Details\"\n              : nft.nftOwnerId !== userId && nft.sellingMethod == 1\n              ? \"Buy Now\"\n              : \"Place a Bid\"}\n          </Link>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default NftCard;\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/utils/web3.js",["844"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\n\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\n    const getWeb3 = async () => {\n        let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nexport const mintNFt = async (metaData) => {\n  let web3 = await getWeb3();\n  console.log(web3, \"web3==>\");\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n    let connectedAddress = await connectMetamask();\n    \n    const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n    let result = await contractM.methods\n      .mint(connectedAddress, 1, 23, \"0x\", metaData)\n      .send({ from: connectedAddress });\n   \n    console.log(result, \"result\");\n    return result;\n  } catch (err) {\n    console.log(err, \"error while minting\");\n    return err;\n  }\n};\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n  \n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n      \n    }\n  \n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        toast.success(\"wallet connected\");\n      }\n   \n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n \n    let accounts = await web3.eth.getAccounts();\n    return accounts[0];\n  \n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();;\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\n\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\n\n\nexport const mint = async () => {\n  \n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n  \n  try {\n   \n  } catch (e) {\n  \n  }\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = () => {\n  };\n\nexport const createNft = async () => {\n\n};\n\n\nexport const openNFTForBidding = async () => {\n \n};\n\nexport const setNftToken = (body) => {\n\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        window.location.href = \"/explore-all\";\n      \n      } else {\n      }\n    })\n    .catch((error) => {\n   \n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {\n  \n};\n\nexport const placeBidNft = async () => {\n \n};\n\nexport const SellOnFixedPrice = async () => {\n \n};\n\nexport const BuyFixedPriceNFTs = async () => {\n\n};\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async () => {\n\n};\nexport const signTransaction = async () => {\n\n};\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/assets/assets.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections-cards/CollectionsCard.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/explore/explore.action.js",["845"],"\nimport { ENV } from './../../config/config';\nimport axios from 'axios'\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n        console.log(response);\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/modal-menu/modal-menu.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/modal-search/modal-search.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/filter-component/FilterComponent.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["846","847"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile &&\n          <div className=\"options-icon like-icon text-white\">\n          \n            { validateIfLiked(likedNfts, id) ? (\n              <div className=\"heart-filled-container d-flex align-items-end\">\n                <AiFillHeart\n                  className=\"heart-fill-icon \"\n                  onClick={() => {\n                    handleLikesTogleApi(id, \"dislike\");\n                    setToggle(!toggle);\n                  }}\n                />{\" \"}\n                <p> {likesCount ? likesCount : 0} </p>\n              </div>\n            ) : (\n              <img\n                src={HeartIcon}\n                alt=\"OptionsIcon\"\n                onClick={() => {\n                  handleLikesTogleApi(id, \"like\");\n                  setToggle(!toggle);\n                }}\n              />\n            )}\n          </div>\n          }\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"   onClick={() => history.push(`/nftdetail/${id}`)}>\n          <p>{ownerId===ENV.getUserKeys(\"_id\")._id?\"View\":\"Buy Now\"}</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/footer/footer.action.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",["848","849","850","851","852","853"],"import React, { Component } from \"react\";\nimport Slider from \"react-slick\";\n// import CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport SliderNextIcon from \"../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport \"./CardSlider.css\";\nimport TwitchPlayer from \"react-player/twitch\";\nimport { data } from \"jquery\";\n\nexport default class CardSlider extends Component {\n  // const CardSlider = () => {\n  constructor(props) {\n    super(props);\n    this.next = this.next.bind(this);\n    this.previous = this.previous.bind(this);\n  }\n  next() {\n    this.slider.slickNext();\n  }\n  previous() {\n    this.slider.slickPrev();\n  }\n\n  handleArrows = () => {\n    const { data, homeAuctions } = this.props;\n    if (data && data.length > 0) {\n      if (homeAuctions && data.length > 4) {\n        return true;\n      } else if (!homeAuctions && data.length > 3) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n  render() {\n    const { settings, data, homeAuction } = this.props;\n    console.log(homeAuction, \"homeAuction\");\n\n    return (\n      <div className=\"container\">\n        {this.handleArrows() && (\n          <div className=\"text-end\">\n            <button\n              className=\"card-slider-btn mb-4 me-3\"\n              onClick={this.previous}\n            >\n              {/* <img src={SliderPrevIcon} alt=\"SliderPrevButton\" /> */}\n              <i class=\"fas fa-arrow-left\"></i>\n            </button>\n            <button className=\"card-slider-btn mb-4\" onClick={this.next}>\n              {/* <img src={SliderNextIcon} alt=\"SliderNextButton\" /> */}\n              <i class=\"fas fa-arrow-right\"></i>\n            </button>\n          </div>\n        )}\n        <Slider ref={(c) => (this.slider = c)} {...settings}>\n          {this.props.children}\n        </Slider>\n      </div>\n    );\n  }\n}\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/hero/component/slider.js",["854","855","856","857","858"],"import \"./slider.css\";\nimport { useState } from \"react\";\nimport HeroCards from \"../../hero-cards/HeroCards\";\nimport SliderNextIcon from \"../../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../../auctions-cards/AuctionsCards\";\nimport { map } from \"jquery\";\nimport { ListingImg, CollectionImages } from \"../../../assets/assets\";\n\nconst Slider = ({\n  setHandler,\n  sliderRadioButtons,\n  handleRadioInputs,\n  sliderChecked,\n}) => {\n  return (\n    <section id=\"slider\">\n      {sliderRadioButtons.map((item) => {\n        return (\n          <input\n            type=\"radio\"\n            name=\"slider\"\n            value={item.value}\n            checked={sliderChecked === item.value}\n            onChange={(e) => handleRadioInputs(e)}\n            id={item.id}\n          />\n        );\n      })}\n      <label for=\"s1\" id=\"slide1\" onClick={() => setHandler(1)}>\n        <HeroCards CardImg={ListingImg.listingImg1} className=\"slide\" />\n      </label>\n      <label for=\"s2\" id=\"slide2\" onClick={() => setHandler(2)}>\n        <HeroCards CardImg={ListingImg.listingImg2} className=\"slide\" />\n      </label>\n      <label for=\"s3\" id=\"slide3\" onClick={() => setHandler(3)}>\n        <HeroCards CardImg={ListingImg.listingImg3} className=\"slide\" />\n      </label>\n      <label for=\"s4\" id=\"slide4\" onClick={() => setHandler(4)}>\n        <HeroCards CardImg={ListingImg.listingImg4} className=\"slide\" />\n      </label>\n      <label for=\"s5\" id=\"slide5\" onClick={() => setHandler(5)}>\n        <HeroCards CardImg={CollectionImages.mainImg1} className=\"slide\" />\n      </label>\n      <label for=\"s6\" id=\"slide6\" onClick={() => setHandler(6)}>\n        <HeroCards CardImg={CollectionImages.mainImg2} className=\"slide\" />\n      </label>\n      <label for=\"s7\" id=\"slide7\" onClick={() => setHandler(7)}>\n        <HeroCards CardImg={CollectionImages.mainImg3} className=\"slide\" />\n      </label>\n    </section>\n  );\n};\n\nexport default Slider;\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",["859","860"],"import React from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.png\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport \"./HeroCards.css\";\n\nconst HeroCards = ({CardImg}) => {\n  return (\n    <Card className=\"auction-card hero-card mx-2\">\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"hero-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title>Music</Card.Title>\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <div className=\"auction-card-avatar d-flex align-items-center mb-4\">\n          <img src={AvatarImg} alt=\"AvatarImg\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n          <span className=\"ms-4\">9+ People Place Bit</span>\n        </div>\n\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owend by Jecica</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default HeroCards;\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/faq/faq.js",["861","862"],"import { useState, useEffect } from 'react';\r\nimport { connect } from \"react-redux\";\r\nimport { beforeFaq, getFaqs } from \"./faq.action\"\r\n\r\nconst Faq = (props) => {\r\n\r\n    const [data, setData] = useState(null)\r\n\r\n    useEffect(() => {\r\n        props.getFaqs()\r\n     \r\n    }, [])\r\n\r\n    useEffect(() =>{\r\n        if(props.faqs.faqsAuth){\r\n            const {faqs} = props.faqs.faqs\r\n            setData(faqs)\r\n        }\r\n    }, [props.faqs.faqsAuth])\r\n\r\n    return (\r\n        <section className=\"faq-area\">\r\n            <div className=\"container\">\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12 col-md-8 col-lg-7\">\r\n                        {/* Intro */}\r\n                        <div className=\"intro text-center\">\r\n                            <span>{\"FAQ\"}</span>\r\n                            <h3 className=\"mt-3 mb-0\">{\"Frequently Asked Questions\"}</h3>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row justify-content-center\">\r\n                    <div className=\"col-12\">\r\n                        {/* FAQ Content */}\r\n                        <div className=\"faq-content\">\r\n                            {/* Netstorm Accordion */}\r\n                            <div className=\"accordion\" id=\"netstorm-accordion\">\r\n                                <div className=\"row justify-content-center\">\r\n                                    <div className=\"col-12 col-md-10\">\r\n                                        {/* Single Accordion Item */}\r\n                                        {data ? data.map((item, idx) => {\r\n                                            return (\r\n                                                <div key={`fd_${idx}`} className=\"single-accordion-item p-3\">\r\n                                                    {/* Card Header */}\r\n                                                    <div className=\"card-header bg-inherit border-0 p-0\">\r\n                                                        <h2 className=\"m-0\">\r\n                                                            <button className={\"btn d-block text-left w-100 collapsed py-4\"} type=\"button\" data-toggle=\"collapse\" data-target={`#helpOption-${idx}`}>\r\n                                                                {item.title}\r\n                                                            </button>\r\n                                                        </h2>\r\n                                                    </div>\r\n                                                    <div id={`helpOption-${idx}`} className={\"collapse\"} data-parent=\"#netstorm-accordion\">\r\n                                                        {/* Card Body */}\r\n                                                        <div className=\"card-body py-3\" dangerouslySetInnerHTML={{__html: item.desc}}>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            );\r\n                                        }) : ''}\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    );\r\n}\r\n\r\nconst mapStateToProps = (state) => ({\r\n    faqs: state.faqs,\r\n    error: state.error,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeFaq, \r\n    getFaqs\r\n})(Faq);","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/author-profile/author-profile.js",["863","864","865","866","867"],"import React, { useEffect } from 'react';\r\nimport {ENV} from './../../config/config';\r\n\r\nconst AuthorProfile = (props) => {    \r\n    useEffect(()=> {\r\n\r\n    },[])\r\n    return (\r\n        <div className=\"card-wrapper\">\r\n       <div className=\"card no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.profileImage ? props.profileImage: ENV.globalPlaceholderImage} alt=\"User Profile\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body mt-4\">\r\n                    <h5 className=\"mb-3\">{props.username}</h5>\r\n                    <p className=\"my-3\">{props.description}</p>\r\n                    <div className=\"input-group\">\r\n                        <input type=\"text\" className=\"form-control\" placeholder=\"0x000000000000000000\" readOnly value={props.address}/>\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"social-icons d-flex justify-content-center my-3\">\r\n                        {\r\n                            props.facebookLink && <a className=\"facebook\" href={props.facebookLink} target=\"_blank\">\r\n                                <i className=\"fab fa-facebook-f\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.twitterLink && <a className=\"twitter\" href={props.twitterLink} target=\"_blank\">\r\n                                <i className=\"fab fa-twitter\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.gPlusLink && <a className=\"google-plus\" href={props.gPlusLink} target=\"_blank\">\r\n                                <i className=\"fab fa-google-plus-g\" />\r\n                            </a>\r\n                        }\r\n                        {\r\n                            props.vineLink && <a className=\"vine\" href={props.vineLink} target=\"_blank\">\r\n                                <i className=\"fab fa-vine\" />\r\n                            </a>\r\n                        }\r\n                    </div>\r\n                    {\r\n                        props.followText &&\r\n                        <a className=\"btn btn-bordered-white btn-smaller\" href=\"#\">{props.followText}</a>\r\n                    }\r\n                </div>\r\n            </div>\r\n        </div>\r\n        </div>\r\n \r\n    );\r\n}\r\nexport default AuthorProfile;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/filter-search2/filtersearch2.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/sidebar/sidebar.js",["868","869","870"],"import React, { Component } from 'react';\r\nimport axios from 'axios';\r\n\r\nconst BASE_URL = \"https://my-json-server.typicode.com/themeland/netstorm-json-2/sidebar\";\r\n\r\nclass Sidebar extends Component {\r\n    state = {\r\n        data: {},\r\n        widgetData_1: [],\r\n        widgetData_2: [],\r\n        widgetData_3: []\r\n    }\r\n    componentDidMount() {\r\n        axios.get(`${BASE_URL}`)\r\n            .then(res => {\r\n                this.setState({\r\n                    data: res.data,\r\n                    widgetData_1: res.data.widgetData_1,\r\n                    widgetData_2: res.data.widgetData_2,\r\n                    widgetData_3: res.data.widgetData_3\r\n                })\r\n            })\r\n            .catch(err => console.log(err))\r\n    }\r\n    render() {\r\n        return (\r\n            <aside className=\"col-12 col-lg-4 pl-lg-5 p-0 float-right sidebar\">\r\n                <div className=\"row\">\r\n                    <div className=\"col-12 align-self-center text-left\">\r\n                        {/* Widget [categories] */}\r\n                        <div className=\"item widget-categories\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_1}</h4>\r\n                            <ul className=\"list-group list-group-flush\">\r\n                                {this.state.widgetData_1.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdo_${idx}`} className=\"list-group-item d-flex justify-content-between align-items-center\">\r\n                                            <a href=\"#\">{item.title}</a>\r\n                                            <span className=\"badge circle\">{item.content}</span>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                        {/* Widget [tags] */}\r\n                        <div className=\"item widget-tags\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_2}</h4>\r\n                            {this.state.widgetData_2.map((item, idx) => {\r\n                                return (\r\n                                    <a key={`wdt_${idx}`} href=\"\" className=\"badge tag\">{item.title}</a>\r\n                                );\r\n                            })}\r\n                        </div>\r\n                        {/* Widget [share-this] */}\r\n                        <div className=\"item widget-share-this\">\r\n                            <h4 className=\"title\">{this.state.data.widgetTitle_3}</h4>\r\n                            <ul className=\"navbar-nav social share-list\">\r\n                                {this.state.widgetData_3.map((item, idx) => {\r\n                                    return (\r\n                                        <li key={`wdth_${idx}`} className=\"nav-item\">\r\n                                            <a href=\"#\" className=\"nav-link\"><i className={item.icon} /></a>\r\n                                        </li>\r\n                                    );\r\n                                })}\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </aside>\r\n        );\r\n    }\r\n}\r\n\r\nexport default Sidebar;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["871","872"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <label\n      className=\"w-100\"\n      onDrop={(e) => onDrop(e)}\n      onDragOver={(e) => dragOver(e)}\n      onDragEnter={(e) => dragEnter(e)}\n      onDragLeave={(e) => dragLeave(e)}\n    >\n      <div className=\"upload-image-border p-4 position-relative\">\n        {imageURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose\n              color=\"#e33d0bc2\"\n              className=\"uploaded-cross-icon\"\n              onClick={() => clearData()}\n            />\n            <img className=\"upload-image\" src={imageURL} alt=\"upload-image\" />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : videoURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <VideoComponent\n              videoUrl={videoURL}\n              videoStyles={videoStyles}\n              videoWidth=\"300\"\n            />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n          </div>\n        ) : audioSrc ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <AudioPlayer audioSrc={audioSrc} />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : (\n          <>\n            {\" \"}\n            <img\n              className=\"upload-image-place-holder\"\n              src={Images.uploadImage}\n              alt=\"upload-image\"\n            />\n            <div className=\"upload-details text-center mt-2\">\n              <p>Drag and drop your file</p>\n              <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n            </div>\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={(e) => onFileChange(e, \"onChange\")}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </>\n        )}\n      </div>\n    </label>\n  );\n};\n\nexport default Upload;\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/help/help.js",["873"],"import React, { Component } from 'react';\r\n\r\nconst initData = {\r\n    pre_heading: \"Help Center\",\r\n    heading: \"How can we help you?\",\r\n    content: \"\"\r\n}\r\n\r\nconst data = [\r\n    {\r\n        id: \"1\",\r\n        icon: \"icon icon-plane text-effect\",\r\n        title: \"Getting Started\",\r\n        content: \"Learn how to create an account, set up your wallet, and what you can do on NetStorm\"\r\n    },\r\n    {\r\n        id: \"2\",\r\n        icon: \"icon icon-note text-effect\",\r\n        title: \"Creating\",\r\n        content: \"Learn how to create your very first NFT and how to create your NFT collections so you can begin selling and sharing\"\r\n    },\r\n    {\r\n        id: \"3\",\r\n        icon: \"icon icon-handbag text-effect\",\r\n        title: \"Buying\",\r\n        content: \"Learn how to purchase your first NFT and understand gas fees and what's gas free on NetStorm\"\r\n    },\r\n    {\r\n        id: \"4\",\r\n        icon: \"icon icon-chart text-effect\",\r\n        title: \"Selling\",\r\n        content: \"Learn how list your NFTs for sale and understand the different ways to list your NFTs\"\r\n    },\r\n    {\r\n        id: \"5\",\r\n        icon: \"icon icon-link text-effect\",\r\n        title: \"Partners\",\r\n        content: \"Learn how you can partner with us to showcase your NFT drops\"\r\n    },\r\n    {\r\n        id: \"6\",\r\n        icon: \"icon icon-flag text-effect\",\r\n        title: \"Developers\",\r\n        content: \"Learn how you can develop with NetStorm &amp; sell them on Marketplace\"\r\n    }\r\n]\r\n\r\nclass HelpCenter extends Component {\r\n    state = {\r\n        initData: {},\r\n        data: []\r\n    }\r\n    componentDidMount(){\r\n        this.setState({\r\n            initData: initData,\r\n            data: data\r\n        })\r\n    }\r\n    render() {\r\n        return (\r\n            <section className=\"help-center-area\">\r\n                <div className=\"container\">\r\n                    <div className=\"row justify-content-center\">\r\n                        <div className=\"col-12 col-md-8 col-lg-7\">\r\n                            {/* Intro */}\r\n                            <div className=\"intro text-center\">\r\n                                <span>{this.state.initData.pre_heading}</span>\r\n                                <h3 className=\"mt-3 mb-0\">{this.state.initData.heading}</h3>\r\n                                <p>{this.state.initData.content}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className=\"row justify-content-center items\">\r\n                        {this.state.data.map((item, idx) => {\r\n                            return (\r\n                                <div key={`hd_${idx}`} className=\"col-12 col-md-6 col-lg-4 item\">\r\n                                    {/* Help Card */}\r\n                                    <div className=\"card help-card\">\r\n                                        <a className=\"d-block text-center\" href=\"#\">\r\n                                            <i className={item.icon} />\r\n                                            <h4>{item.title}</h4>\r\n                                            <p>{item.content}</p>\r\n                                        </a>\r\n                                    </div>\r\n                                </div>\r\n                            );\r\n                        })}\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        );\r\n    }\r\n}\r\n\r\nexport default HelpCenter;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/item-details/item-details.js",["874","875","876","877","878","879","880","881","882","883","884","885","886","887","888","889","890","891"],"import React, { Component } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport { Link } from 'react-router-dom';\r\nimport { beforeNFT, getNFT } from '../nfts/nfts.action';\r\nimport FullPageLoader from '../full-page-loader/full-page-loader'\r\nimport { ENV } from '../../config/config';\r\nimport moment from 'moment';\r\nimport Countdown from 'react-countdown';\r\nimport SimpleReactValidator from 'simple-react-validator'\r\nimport { decimalNumberValidator } from \"../../utils/functions\";\r\nimport { Container, Row, Col, Button, Modal } from \"react-bootstrap\";\r\nimport { beforeOffer, makeOffer, getOffers, deleteOffer, acceptOffer } from '../offers/offers.action'\r\nimport { beforeBid, placeBid, getBids, deleteBid, acceptBid } from '../bids/bids.action'\r\nimport {getCreators, beforeUser} from './../user/user.action';\r\nimport {getCurrentAddress,BuyFixedPriceNFTs,placeBidNft,acceptNftOffer} from '../../utils/web3';\r\nimport { toast } from 'react-toastify'\r\nconst { globalPlaceholderImage, countDownRenderer, currencies, objectToQueryString } = ENV\r\n\r\nconst initData = {\r\n    itemImg: \"/img/auction_2.jpg\",\r\n    date: \"2022-03-30\",\r\n    price_2: \"$500.89\",\r\n    bidBtn: \"Place a Bid\",\r\n    offerBtn: \"Buy Now\",\r\n    sellBtn: \"Sell\"\r\n}\r\n\r\n// expiry options\r\n\r\nconst expiryOptions = [\r\n    { label: '5 Days', value: moment().add(5, \"days\").format('DD/MM/YYYY') },\r\n    { label: '7 Days', value: moment().add(7, \"days\").format('DD/MM/YYYY') },\r\n    { label: 'A Month', value: moment().add(1, \"months\").format('DD/MM/YYYY') },\r\n    { label: 'Custom Date', value: -1 },\r\n]\r\n\r\n// make an offer / bid config.\r\n\r\nconst config1 = {\r\n    price: {\r\n        currency: ENV.currency,\r\n        amount: \"\",\r\n    },\r\n    expiry: {\r\n        date: expiryOptions[0].value,\r\n        time: moment(new Date()).format(\"HH:mm\"),\r\n        type: 1, // 1 for time & 2 for datetime-local\r\n        datetime: '' // for payload \r\n    }\r\n};\r\nlet nft1=[]\r\nclass ItemDetails extends Component {\r\n    isTimeoutAction = false;\r\n    constructor(props) {\r\n        super(props)\r\n        this.state = {\r\n            userId: ENV.getUserKeys()?._id,\r\n            offers: null,\r\n            offersPagination: null,\r\n\r\n            bids: null,\r\n            bidsPagination: null,\r\n            highestBidAmtt:null,\r\n            errors: '',\r\n            isSubmitted: false,\r\n            formValid: true,\r\n            loader: true,\r\n            nft: null,\r\n            nftAll:null,\r\n            isOpen: false,\r\n            creator:[],\r\n            nftConfig: config1 ,// make an offer / bid config.\r\n            nftsData:[],\r\n            bidsData:[],\r\n            creators:[],\r\n            myAddress:''\r\n        }\r\n        this.validator = new SimpleReactValidator({\r\n            autoForceUpdate: this,\r\n            messages: {\r\n                required: 'This field is required.'  // will override all messages\r\n            },\r\n        });\r\n\r\n    }\r\n\r\n    componentDidMount= async()=> {\r\n        window.scroll(0, 0)\r\n        let myAddress=await getCurrentAddress()\r\n     \r\n        this.setState({\r\n            myAddress\r\n        })\r\n        const query = new URLSearchParams(window.location.search)\r\n        this.getTokens()\r\n       \r\n        if (query.get('item')) {\r\n        \r\n            const nftId = window.atob(query.get('item'))\r\n            // console.log(nftId,\"nftId====>\");\r\n            if (nftId) {\r\n                this.props.getNFT(nftId);\r\n                this.getBids(nftId)\r\n\r\n                const bidQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getBids(bidQS);\r\n\r\n                const offerQS = ENV.objectToQueryString({ nftId })\r\n                this.props.getOffers(offerQS);\r\n                this.props.getCreators();\r\n            }\r\n        } else\r\n            this.props.history.push('/explore-all')\r\n    }\r\n\r\n    filterCreator=(nft)=>{\r\n     \r\n        // let nftId=this.state.nft.collection.userId\r\n    }\r\n    filterCreatorsInfo=(id,item)=>{\r\n      \r\n      let user= this.props.user?.creators?.find((item)=>item._id===id )\r\n      if(user){\r\n          if(item==\"username\"){\r\n             return user.username\r\n          }\r\n          if(item==\"profilePhoto\"){\r\n              return user?.profileImage\r\n          }\r\n          if(item==\"id\"){\r\n            return user._id\r\n          }\r\n      }\r\n    }\r\n\r\n    componentDidUpdate() {\r\n        // if (this.props.error)\r\n        //     this.setState({ loader: false })\r\n\r\n        if (this.props.nft.nftsAuth) {\r\n           \r\n            const nft = this.props.nft.nftsData\r\n            const allData=this.props.nft.nftAll\r\n           \r\n            //nft\r\n            nft1=nft\r\n            this.getBids(nft?._id)\r\n            this.setState({\r\n                \r\n                nft,\r\n            nftAll:allData\r\n                \r\n            }, () => {\r\n                this.props.beforeNFT()\r\n            })\r\n            this.filterCreator(nft)\r\n            const date1 = moment();\r\n            const date2 = moment(this.props?.nft?.nftAll?.sellingConfig?.duration?.endDate);\r\n           \r\n            // this.isTimeoutAction =  date2.diff(date1) > 0 ? false : true;\r\n            let result =  date2.diff(date1) > 0 ? false : true;\r\n            this.setState({\r\n                isTimeoutAction:result\r\n            })\r\n            // console.log(result,\"checking result\")\r\n        }\r\n\r\n        if (this.props.offer.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeOffer()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getOffers(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.getAuth) {\r\n            const { offers, pagination } = this.props.offer\r\n            this.setState({ loader: false, offers, offersPagination: pagination }, () => {\r\n                this.props.beforeOffer()\r\n            })\r\n        }\r\n\r\n        if (this.props.offer.deleteAuth) {\r\n            this.props.beforeOffer()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getOffers(qs)\r\n        }\r\n\r\n        if (this.props.bid.createAuth) {\r\n            this.setState({\r\n                // loader: false,\r\n                isOpen: false\r\n            }, () => {\r\n                this.props.beforeBid()\r\n\r\n                const { nft } = this.state\r\n                const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n                this.props.getBids(qs)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.getAuth) {\r\n         \r\n            const { bids, pagination, highestBidAmt } = this.props.bid\r\n        \r\n            let nft = { ...this.state.nft }\r\n\r\n            nft.highestBidAmt = highestBidAmt\r\n           \r\n            this.setState({ loader: false, bids, bidsPagination: pagination, nft }, () => {\r\n                this.props.beforeBid()\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.deleteAuth) {\r\n            this.props.beforeBid()\r\n\r\n            const { nft } = this.state\r\n            const qs = ENV.objectToQueryString({ nftId: nft._id })\r\n            this.props.getBids(qs)\r\n        }\r\n\r\n        if (this.props.offer.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeOffer()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n\r\n        if (this.props.bid.acceptAuth) {\r\n            this.setState({ loader: false }, () => {\r\n                this.props.beforeBid()\r\n                const { nft } = this.state\r\n                this.props.history.push(`collection-details/${window.btoa(nft.collection._id)}`)\r\n            })\r\n        }\r\n        //    console.log(this.props.user.topSellersAuth,\"kjkjkjlkjlkjkljlkjk\");\r\n\r\n        if(this.props.user.topSellersAuth && !this.state.creator?.length>0 ){\r\n            this.filterCreator(this.props.user.sellers)\r\n            this.setState({\r\n                creator:this.props.user.sellers,\r\n                creators:this.props.user.creators\r\n            })\r\n            // console.log(this.props.user.sellers,\"creators===}}}}}}}}}}}}}}}}}}}}}\");\r\n            // console.log(this.state.nft,\"nft below the creator===>\")\r\n        }\r\n        \r\n\r\n    }\r\n   \r\n    getBids=(nftId)=>{\r\n        const BASE_URL= process.env.REACT_APP_BASE_URL \r\n        fetch(BASE_URL + \"/bid/list\", {\r\n            method: 'GET',\r\n            headers: {\r\n                'content-type': 'application/json',\r\n                'Authorization': ENV.Authorization,\r\n                'x-auth-token': ENV.x_auth_token,\r\n                'Access-Control-Allow-Origin': '*',\r\n                'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n            }\r\n        }).then(res => res.json()).then(data => {\r\n       \r\n            let bids=data.data.allBids?.filter((item)=>item.nftId===nftId)          \r\n           \r\n            // const highestBidAmt = bids.length\r\n            var last_element = bids[bids?.length - 1];\r\n       \r\n            this.setState({\r\n                bidsData:bids,\r\n                highestBidAmtt: last_element?.price.amount\r\n\r\n            })\r\n            setTimeout(()=>{\r\n               this.setState({\r\n                   loader:false,\r\n               })\r\n            },2000)\r\n         \r\n        }).catch(error => {\r\n        console.log(error,\"error while getting bids\")\r\n           \r\n        })\r\n    }\r\n    openModal = () => {\r\n  \r\n        if(this.props?.nft?.nftAll.sellingMethod==1)\r\n        {\r\n            // console.log(\"inside if\")\r\n            var res= this.state.nftsData.data.find((item)=>item.nftId===this.state.nft._id)\r\n            // console.log(res,\"response\")               \r\n             // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n             this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n               this.setState({\r\n                   loader:false\r\n               })\r\n\r\n            }, 8000);\r\n          \r\n             BuyFixedPriceNFTs(this.props?.nft?.nftAll.currentPrice,res.nftToken,this.props.nft.nftAll._id)\r\n            \r\n        }\r\n        else {\r\n            // console.log(\"inside else\")\r\n            this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n        }\r\n      \r\n        // this.setState({ isOpen: true, nftConfig: config1, errors: '' });  \r\n    }\r\n\r\n    closeModal = () => this.setState({ isOpen: false });\r\n\r\n    onChange = (e) => {\r\n        const { nftConfig } = this.state;\r\n        const { name, value } = e.target;\r\n        let data = nftConfig;\r\n\r\n        const keys = name.split(\".\"); // nftConfig, price, currency\r\n        if (keys && keys[2])\r\n            data[keys[1]][keys[2]] = value;\r\n        else if (keys && keys[1])\r\n            data[keys[1]] = value;\r\n\r\n        if (keys && keys[1] === 'price' && keys[2] === 'amount')\r\n            data[keys[1]]['amount'] = Number(value)\r\n\r\n        if (keys && keys[1] === 'expiry' && keys[2] === 'date')\r\n            data[keys[1]]['type'] = Number(value) === -1 ? 2 : 1\r\n\r\n        // set datetime for days / months \r\n        if (data.expiry.type === 1)\r\n            data.expiry.datetime = moment(data.expiry.date + ' ' + data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n        // set datetime for custom date\r\n        else if (data.expiry.type === 2) {\r\n            data.expiry.datetime = moment(data.expiry.time, 'DD/MM/YYYY HH:mm')\r\n            data.expiry.date = moment(data.expiry.time, 'DD/MM/YYYY')\r\n        }\r\n\r\n        this.setState({\r\n            nftConfig: {\r\n                ...data\r\n            }\r\n        })\r\n    };\r\n\r\n    // submit when a bid is placed or when an offer is made\r\n    submit = () => {\r\n    //   console.log(this.state.myAddress,\"myaddress\")\r\n\r\n        this.setState({ isSubmitted: true, formValid: this.validator.allValid() }, () => {\r\n            const { formValid } = this.state\r\n            if (formValid) {\r\n                this.setState({\r\n                    loader: false               //need to convert true\r\n                }, () => {\r\n                    const { nft, nftConfig,nftAll } = this.state\r\n           \r\n                    // console.log(nftAll,\"checking nft==>\")\r\n                    const payload = {\r\n                        // ownerId: nft.owner._id,\r\n                        expiryDate: nftConfig.expiry.datetime,\r\n                        price: nftConfig.price,\r\n                        nftId: nft._id,\r\n                        bidBy:ENV.getUserKeys('_id'),\r\n                        user:ENV.getUserKeys('_id'),\r\n                        offerById:ENV.getUserKeys('_id'),\r\n                        toAddress:nftAll.ownerAddress,\r\n                        fromAddress:this.state.myAddress,\r\n\r\n                    }\r\n                    // console.log(payload,\"toaddress8888888\")\r\n           \r\n                    let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                    // console.log('check here selling method',nft.sellingMethod )\r\n                    // if selling method is 2 then go for bid\r\n                    if (nft.sellingMethod === 2) { // place a bid \r\n                        placeBidNft(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        // this.props.placeBid(payload,foundResult.nftToken,payload.price,nft.ownerAddress,this.state.myAddress)\r\n                        this.setState({\r\n                            loader:true\r\n                        })\r\n\r\n                        setTimeout(() => {\r\n                            this.setState({\r\n                                loader:false\r\n                            })\r\n                          \r\n                        }, 5000);\r\n                    } else if (nft.sellingMethod === 1) { // make an offer \r\n                       let res= this.state.nftsData.find((item)=>item.nftId===nft._id)\r\n                    //    console.log(res,\"response\")\r\n                             \r\n                        // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                        // BuyFixedPriceNFTs(payload.price,res.nftToken)\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                        // this.props.makeOffer(payload,foundResult,payload.price)\r\n                    }\r\n                    else{\r\n                        // console.log(nftAll,\"nftAll==>\")\r\n                        // console.log('single nft before fix price function', nft)\r\n                        let res= this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n                        // console.log(res,\"response\")\r\n                              \r\n                         // BuyFixedPriceNFTs(nftAll.ownerAddress,nftAll.currentPrice)\r\n                         BuyFixedPriceNFTs(payload.price,res.nftToken,nftAll.ownerAddress)\r\n                    }\r\n                })\r\n\r\n            }\r\n\r\n            else {\r\n                alert(\"in else\")\r\n                this.validator.showMessages()\r\n                this.validator.purgeFields()\r\n                this.setState({\r\n                    errors: 'Please fill all required fields in valid format.',\r\n                    formValid: false\r\n                }, () => {\r\n                    window.scroll(0, 0)\r\n                })\r\n            }\r\n            \r\n        })\r\n    }\r\n\r\n    deleteOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteOffer(offerId)\r\n        })\r\n    }\r\n\r\n    deleteBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.deleteBid(bidId)\r\n        })\r\n    }\r\n\r\n    acceptOffer = (offerId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            this.props.acceptBid({ offerId })\r\n        })\r\n\r\n    }\r\n\r\n    acceptBid = (bidId) => {\r\n        this.setState({\r\n            loader: true\r\n        }, () => {\r\n            const { nft, nftConfig,nftAll } = this.state\r\n        \r\n            let foundResult=this.state.nftsData.data.find((item)=>item.nftId===nft._id)\r\n  \r\n            const payload = {\r\n                bidId:bidId,\r\n                nftId: nft._id,\r\n                bidBy:ENV.getUserKeys('_id'),\r\n                user:ENV.getUserKeys('_id'),\r\n                toAddress:nftAll.ownerAddress,\r\n                fromAddress:this.state.myAddress,\r\n            }\r\n            this.setState({\r\n                loader:true\r\n            })\r\n\r\n            setTimeout(() => {\r\n                this.setState({\r\n                    loader:false\r\n                })\r\n              \r\n            }, 7000);\r\n            acceptNftOffer(foundResult.nftToken,payload)\r\n            // this.props.acceptBid(payload,foundResult.nftToken)\r\n             \r\n        })\r\n       \r\n    }\r\n    creatorUserName=()=>{\r\n        // console.log(this.state.creator,\"creator listing\");/\r\n        // console.log(this.props.nftAll,\"this.props.nftAll?\");\r\n\r\n       let result= this.state.creator.find((item)=>item._id===this.state?.nftAll?.userId)\r\n    //    console.log(result,\"result in the userName function===>\");\r\n       if(result?.username)\r\n       {\r\n\r\n           return result.username\r\n       }\r\n       else {\r\n           return \"no username\"\r\n       }\r\n    }\r\n     getTokens=()=>{\r\n\r\n        let url = process.env.REACT_APP_BASE_URL + `nftTokens/tokens`;\r\n      \r\n        fetch(url, {\r\n         method: 'GET',\r\n         headers: {\r\n            'content-type': 'application/json',\r\n            'Authorization': ENV.Authorization,\r\n            'x-auth-token': ENV.x_auth_token,\r\n            'Access-Control-Allow-Origin': '*',\r\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\r\n        },\r\n      \r\n      }).then(res => res.json()).then(data => {\r\n \r\n        //   console.log(data,\"data==>22222222222222222222222222222222222222\")\r\n      \r\n     this.setState({\r\n        nftsData:data\r\n     })\r\n      \r\n      }).catch(error => {\r\n        \r\n        console.log(error,\"error in catch blcok\")\r\n        \r\n      })\r\n    }\r\n    // filterCreatorsInfo=(id,item)=>{\r\n    //     // console.log(this.state.creators,\"creator in the filterCreatorsFunction\")\r\n    //   let user= this.state?.creators?.data?.find((item)=>item._id===id )\r\n    //   if(user){\r\n\r\n    //       if(item==\"username\"){\r\n    //          return user.username\r\n    //       }\r\n    //       if(item==\"profilePhoto\"){\r\n    //           return user?.profileImage\r\n    //       }\r\n    //       if(item==\"id\"){\r\n    //         return user._id\r\n    //       }\r\n    //   }\r\n      \r\n    // }\r\n\r\n    render() {\r\n        const { loader, nft, nftConfig, isSubmitted, errors, userId, bids, offers } = this.state\r\n        if(!ENV.getUserKeys('_id')._id){\r\n            toast.error(\"Pleas login to continue\")\r\n            this.props.history.push('/')\r\n               return \" \"\r\n           }\r\n           else {\r\n        return (\r\n            <>\r\n                <section className=\"item-details-area padding-wrapper pb-0\">\r\n                    {\r\n                        loader ?\r\n                            <FullPageLoader /> :\r\n                            <>\r\n                                {\r\n                                    nft && \r\n                                    <div className=\"container\">\r\n                                        <div className=\"row justify-content-between\">\r\n                                            <div className=\"col-12 col-lg-5\">\r\n                                                <div className=\"item-info\">\r\n                                                    <div className=\"item-thumb text-center\">\r\n                                                        <img src={nft.image} alt=\"NFT Image\" />\r\n                                                    </div>\r\n                                                    {\r\n                                                        nft.auctionEndDate &&\r\n                                                        <div className=\"card no-hover countdown-times mt-4\">\r\n                                                            <Countdown\r\n                                                                date={new Date(nft.auctionEndDate) + 10000}\r\n                                                                renderer={countDownRenderer}\r\n                                                            />\r\n                                                        </div>\r\n                                                    }\r\n                                                    {/* Tabs */}\r\n                                                    <ul className=\"netstorm-tab nav nav-tabs mt-4\" id=\"nav-tab\">\r\n                                                        <li>\r\n                                                            <a className=\"active\" id=\"bids-tab\" data-toggle=\"pill\" href=\"#bids\">\r\n                                                                <h5 className=\"m-0\">Bids</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                        {/* <li>\r\n                                                            <a id=\"offers-tab\" data-toggle=\"pill\" href=\"#offers\">\r\n                                                                <h5 className=\"m-0\">Offers</h5>\r\n                                                            </a>\r\n                                                        </li> */}\r\n                                                        <li>\r\n                                                            <a id=\"details-tab\" data-toggle=\"pill\" href=\"#details\">\r\n                                                                <h5 className=\"m-0\">Details</h5>\r\n                                                            </a>\r\n                                                        </li>\r\n                                                    </ul>\r\n                                                    \r\n                                                    {/* Tab Content */}\r\n                                                    <div className=\"tab-content\" id=\"nav-tabContent\">\r\n                                                        <div className=\"tab-pane fade show active\" id=\"bids\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {this.state.bidsData &&  this.props.user?.creators?.length > 0  ? \r\n                                                                \r\n                                                                    this.state.bidsData.map((item, idx) => {\r\n                                                                \r\n                                                                        return (\r\n                                                                            <li key={`bid_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                             \r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Bid listed for <strong>{item.price.amount} {item.price.currency} </strong>\r\n                                                                                     <span>{moment(item.createdAt).fromNow()} </span>\r\n                                                                                     <br />by <Link to={`/author/${item.bidById}`}>@{ this.filterCreatorsInfo(item.bidBy,'username')}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                     nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                      nft.nftOwnerId=== userId &&\r\n                                                                                    //   userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptBid(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                     \r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No bids found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div>\r\n\r\n                                                        {/* <div className=\"tab-pane fade\" id=\"offers\">\r\n                                                            <ul className=\"list-unstyled\">\r\n                                                                {offers && offers.length > 0 ?\r\n                                                                    offers.filter((item)=>item.nftId===nft._id).map((item, idx) => {\r\n                                                                        return (\r\n                                                                            <li key={`offer_${idx}`} className=\"single-tab-list d-flex align-items-start w-100\">\r\n                                                                                <img className=\"avatar-sm rounded-circle mr-3\" src={item?.offerBy?.profilePhoto} alt=\"\" />\r\n                                                                                <p className=\"m-0\">\r\n                                                                                    Offer listed for <strong>{item.price.amount} {item.price.currency}</strong> {moment(item.createdAt).fromNow()} <br />by <Link to={`/author/${item.nftId}`}>@{this.filterCreatorsInfo(item.offerById,\"username\")}</Link>\r\n                                                                                </p>\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.deleteOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-times text-danger\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                                {\r\n                                                                                    userId === item.nftId &&\r\n                                                                                    <div className=\"ml-auto\" onClick={() => this.acceptOffer(item._id)}>\r\n                                                                                        <i className=\"cursor-pointer fa fa-check text-success\" aria-hidden=\"true\" />\r\n                                                                                    </div>\r\n                                                                                }\r\n                                                                            </li>\r\n                                                                        );\r\n                                                                    }) :\r\n                                                                    <div className=\"mt-3\">No offers found</div>\r\n                                                                }\r\n                                                            </ul>\r\n                                                        </div> */}\r\n                                                        \r\n                                                        <div className=\"tab-pane fade\" id=\"details\">\r\n                                                            <div className=\"owner-meta d-flex align-items-center mt-3\">\r\n                                                                <span>Owner</span>\r\n                                                                <Link className=\"owner d-flex align-items-center ml-2\" to={`/author/${nft.owner?._id}`}>\r\n                                                                    <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto ? nft.owner.profilePhoto : globalPlaceholderImage} alt=\"Owner Image\" />\r\n                                                                    <h6 className=\"ml-2\">{nft.owner?.username}</h6>\r\n                                                                </Link>\r\n                                                            </div>\r\n                                                            <p className=\"mt-2\">Created : {moment(nft.createdAt).format('DD MMM YYYY')\r\n                                                            }</p>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                            <div className=\"col-12 col-lg-6\">\r\n                                                <div className=\"content mt-5 mt-lg-0\">\r\n                                                    <h3 className=\"m-0\">{nft.name}</h3>\r\n                                                    <p>{nft.description}</p>\r\n\r\n                                                    {/* Owner */}\r\n                                                    <div className=\"owner d-flex align-items-center\">\r\n                                                        <span>Owned By</span>\r\n                                                        <Link className=\"owner-meta d-flex align-items-center ml-3\" to={`/author/${nft.owner?._id}`}>\r\n                                                            <img className=\"avatar-sm rounded-circle\" src={nft.owner?.profilePhoto || globalPlaceholderImage} alt=\"Owner Avatar\" />\r\n                                                            <h6 className=\"ml-2\">\r\n                                                                {/* {nft.owner?.username}\r\n                                                                 */}\r\n                                                                 {this.creatorUserName()}\r\n                                                                </h6>\r\n                                                        </Link>\r\n                                                    </div>\r\n                                                    {/* Item Info List */}\r\n                                                    <div className=\"item-info-list mt-4\">\r\n                                                        <ul className=\"list-unstyled\">\r\n                                                            <li className=\"price d-flex justify-content-between\">\r\n                                                                <span>Current Price {nft.currentPrice || 0} {ENV.currency}</span>\r\n                                                                {/* <span>{initData.price_2}</span> */}\r\n                                                                <span>{nft.sold} of {nft.copies}</span>\r\n                                                            </li>\r\n                                                            <li>\r\n                                                                <span>Size </span>\r\n                                                                <span>{nft.size}</span>\r\n                                                            </li>\r\n                                                        </ul>\r\n                                                    </div>\r\n                                                    <div className=\"row items\">\r\n                                                        {/* Creator */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <a href=\"/author\">\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.creator?.profilePhoto || globalPlaceholderImage} alt=\"Creator Avatar\" />\r\n                                                                    </a>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`/author/${nft.creator?._id}`}>{\r\n                                                                          this.creatorUserName()\r\n                                                                        // nft.creator?.username\r\n                                                                        }</Link>\r\n                                                                        <span>Creator</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        {/* Collection */}\r\n                                                        <div className=\"col-12 col-md-6 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <div className=\"single-seller d-flex align-items-center\">\r\n                                                                    <Link to={`collection-details/${window.btoa(nft.collection?._id)}`}>\r\n                                                                        <img className=\"avatar-md rounded-circle\" src={nft.collection?.image} alt=\"Collection Image\" />\r\n                                                                    </Link>\r\n                                                                    <div className=\"seller-info ml-3\">\r\n                                                                        <Link className=\"seller mb-2\" to={`collection-details/${window.btoa(nft.collection?._id)}`}>{nft.collection?.name}</Link>\r\n                                                                        <span>Collection</span>\r\n                                                                    </div>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                        <div className=\"col-12 item px-lg-2\">\r\n                                                            <div className=\"card no-hover\">\r\n                                                                <h4 className=\"mt-0 mb-2\">Highest Bid</h4>\r\n                                                                <div className=\"price d-flex justify-content-betxween align-items-center\">\r\n                                                                    <span>{this.state.highestBidAmtt ? this.state.highestBidAmtt + ` ${ENV.currency}` : 'N/A'}</span>\r\n                                                                </div>\r\n                                                            </div>\r\n                                                        </div>\r\n                                                    </div>\r\n                                                    {\r\n\r\n                                                        nft.nftOwnerId=== userId ?\r\n                                                        <Link className=\"d-block btn btn-bordered-white mt-4 mb-4 w-100\" to={`/sell-item/${window.btoa(nft._id)}`}>{initData.sellBtn}</Link>\r\n                                                        :\r\n                                                        // <button className=\"d-block btn btn-bordered-white mt-4 w-100\" onClick={this.openModal(nft)}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn}</button>\r\n                                                        <>\r\n                                                             {/* this.isTimeoutAction ? 'Auction Timeout' : */}\r\n                                                             {/*  */}\r\n                                                            { \r\n                                                           this.props?.nft?.nftAll.sellingMethod &&\r\n                                                            <button  className=\"d-block btn btn-bordered-white mt-4 w-100\" disabled={this.isTimeoutAction || nft.copies===nft.sold}  onClick={()=>this.openModal()}>{this.isTimeoutAction?\"Auction Timeout\":( nft.sellingMethod === 2 ? initData.bidBtn : initData.offerBtn)}</button>}\r\n                                                             \r\n                                                            </>\r\n                                                    }\r\n                                                </div>\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                }\r\n                            </>\r\n\r\n                    }\r\n                </section>\r\n                <div className=\"modal-wrapper\">\r\n                    {\r\n                        nft &&\r\n                        <Modal\r\n                            centered\r\n                            size=\"lg\"\r\n                            className=\"\"\r\n                            show={this.state.isOpen}\r\n                            onHide={this.closeModal}\r\n                        >\r\n                            <Modal.Header className=\"text-center modal-title-wrapper\">\r\n                                <Modal.Title>\r\n                                    { nft.sellingMethod === 2 ? 'Place A Bid' : 'Make An Offer'}\r\n                                </Modal.Title>\r\n                            </Modal.Header>\r\n                            {\r\n                                isSubmitted && errors &&\r\n                                <Modal.Body className=\"row pt-2 pb-0\">\r\n                                    <div className=\"col-12\">\r\n                                        <span id=\"nft-err\" className=\"form-error-msg text-danger\">{errors}</span>\r\n                                    </div>\r\n                                </Modal.Body>\r\n                            }\r\n                            <Modal.Body>\r\n                                <div className=\"price-wrapper d-flex\">\r\n                                    <div className=\"price-text position-relative\">\r\n                                        <div className=\"text-white mb-2 absolute-wrapper\">\r\n                                            <b>Price</b>\r\n                                        </div>\r\n                                        <div className=\"text-right mb-2\">\r\n                                            <i className=\"fas fa-exclamation-circle ml-2\" />\r\n                                        </div>\r\n                                        <div className=\"d-flex\">\r\n                                            <select className=\"form-control\" id=\"currency\" name=\"nftConfig.price.currency\" onChange={(e) => this.onChange(e)}>\r\n                                                {\r\n                                                    currencies && currencies.map((currency, index) => {\r\n                                                        return (\r\n                                                            <option key={index} value={currency.symbol}>{currency.symbol}</option>\r\n                                                        )\r\n                                                    })\r\n                                                }\r\n                                            </select>\r\n                                            <input type=\"text\" placeholder=\"Amount\" className=\"amount-btn ml-3\" name=\"nftConfig.price.amount\" placeholder=\"Amount\" className=\"amount-btn ml-3\" style={{ borderRadius: \"4px\" }} onChange={(e) => this.onChange(e)} onKeyDown={(e) => decimalNumberValidator(e)} defaultValue={nftConfig.price.amount} required />\r\n                                            <div className=\"text-right mb-2 dollar-wrapper\">\r\n                                                $ 0.00\r\n                                            </div>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"text-danger\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</Modal.Body>\r\n                            <Modal.Body className=\"\" style={{ flexDirection: \"column\", display: \"block\", height: \"200px\" }}>\r\n                                <div className=\"offer-expiration-wrapper text-white\">\r\n                                    <b>Offer Expiration</b>\r\n                                </div>\r\n                                <div>\r\n                                    <div className=\"d-flex\">\r\n                                        <select className=\"form-control\" id=\"expiryDate\" name=\"nftConfig.expiry.date\" onChange={(e) => this.onChange(e)}\r\n                                            style={{\r\n                                                padding: \"7px 55px 7px 55px\",\r\n                                                border: \"none\",\r\n                                                outline: \"none\",\r\n                                                borderRadius: \"4px\",\r\n                                                background: \"#808080\",\r\n                                                display: \"flex\",\r\n                                                alignItems: \"center\",\r\n                                                cursor: \"pointer\",\r\n                                                height: \"51px\",\r\n                                                color: \"#000\"\r\n                                            }}\r\n                                        >\r\n                                            {\r\n                                                expiryOptions && expiryOptions.map((expiry, index) => {\r\n                                                    return (\r\n                                                        <option key={index} value={expiry.value}>{expiry.label}</option>\r\n                                                    )\r\n                                                })\r\n                                            }\r\n                                        </select>\r\n                                        <div>\r\n                                            <div className=\"mr-auto budle-wrapper\">\r\n                                                <input type={nftConfig.expiry.type === 1 ? \"time\" : \"datetime-local\"} style={{ marginLeft: \"1rem\", width: \"552px\" }} name=\"nftConfig.expiry.time\" value={nftConfig.expiry.time} onChange={(e) => this.onChange(e)} required />\r\n                                            </div>\r\n                                            <span className=\"text-danger message\">{this.validator.message('amount', nftConfig.price.amount, 'required')}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Body className=\"justify-content-center align-items-center\">\r\n                                <div className=\"d-flex justify-content-around\">\r\n                                    <button className=\"ethereum-btn mr-3\" disabled={loader} onClick={() => this.submit()}>{nft.sellingMethod === 2 ? initData.bidBtn : initData.bidBtn}</button>\r\n                                    {/* <button className=\"ethereum-btn\">Add funds</button> */}\r\n                                </div>\r\n                            </Modal.Body>\r\n                            <Modal.Footer>\r\n                                <button\r\n                                    className=\"btn banner-btn btn-primary\"\r\n                                    onClick={this.closeModal}\r\n                                >\r\n                                    Close\r\n                                </button>\r\n                            </Modal.Footer>\r\n                        </Modal>\r\n                    }\r\n                </div>\r\n            </>\r\n        );\r\n                }\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => (\r\n    // console.log('state', state),\r\n \r\n    {\r\n    nft: state.nft,\r\n    error: state.error,\r\n    offer: state.offer,\r\n    bid: state.bid,\r\n    user: state.user,\r\n    nftAll:state.nftAll,\r\n});\r\n\r\nexport default connect(mapStateToProps, {\r\n    beforeNFT, getNFT,\r\n    beforeOffer, makeOffer, getOffers, deleteOffer, beforeBid, placeBid, getBids, deleteBid, acceptOffer, acceptBid, beforeUser, getCreators ,\r\n})(ItemDetails);\r\n","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/contact/contact.action.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/nft-preview/nft-preview.js",["892"],"import React from 'react';\r\nimport { ENV } from '../../config/config'\r\nimport './nft-preview.css'\r\nconst itemPlaceholderImg = ENV.globalPlaceholderImage\r\n\r\nconst NFTPreview = (props) => {\r\n    return (\r\n       \r\n        <div className=\"card preview-nft-card no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.image ? props.image : itemPlaceholderImg} alt=\"NFT image\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body p-0 m-0\">\r\n                    {/* <h5 className=\"mb-3\">{props.name}</h5> */}\r\n                    {/* <p>{props.sold ? props.sold : 0} of {props.copies ? props.copies : 0} Copies</p> */}\r\n                    <p className=\"text-left nft-name-text mt-4\">{\"name\"}</p>\r\n                    <div className=\"d-flex justify-content-between\">\r\n\r\n                    <p className=\"text-white celo-text\">{props.currentPrice ? props.currentPrice : 0}{ENV.currency}</p>\r\n                    <p className=\"text-white\">{\"10/10\"}</p>\r\n                    </div>\r\n                    <div className=\"input-group\">\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n       \r\n    );\r\n}\r\n\r\nexport default NFTPreview;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/faq/faq.action.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/filter-search/filtersearch.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/collection-preview.js",["893","894"],"import React from 'react';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV\n\nconst CollectionPreview = ({ collection }) => {\n    return (\n        <>\n            <div className=\"card no-hover text-center \">\n                <div className=\"image-over\">\n                    <div>\n                        <img className=\"card-img-top\" src={collection.featuredImg ? collection.featuredImg : collectionFeaturedImg} alt=\"Collection Featured Image\" />\n                    </div>\n                    <div className=\"seller\">\n                        <div className=\"seller-thumb avatar-lg\">\n                            <img className=\"rounded-circle\" src={collection.logo} alt='Collection Logo' />\n                        </div>\n                    </div>\n                </div>\n                <div className=\"card-caption col-12 p-0\">\n                    <div className=\"card-body mt-4\">\n                        <div>\n                            <h5 className=\"mb-2\">{collection.name}</h5>\n                            <p className=\"mb-2\">\n                                {\n                                    collection.url ?\n                                        <div className=\"input-group\">\n                                            <input type=\"text\" className=\"form-control\" placeholder=\"Collection URL\" readOnly value={collection.url} />\n                                            <div className=\"input-group-append\" style={{ zIndex: 888 }}>\n                                                <button className=\"btn mr-0\"><i className=\"icon-docs\" /></button>\n                                            </div>\n                                        </div>\n                                        : ('URL: N/A')\n                                }\n                            </p>\n                            <p className=\"mb-2\">{collection.description ? collection.description : 'Description: N/A'}</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div className=\"row items\">\n                <div className=\"col-12 px-0 mt-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <img className=\"avatar-md rounded-circle\" src={collection.category?.image || categoryDefaultImg} alt=\"Category Image\" />\n                            <div className=\"seller-info ml-3\">\n                                <div className=\"seller\">{collection.category?.name || 'N/A'}</div>\n                                <span>Category</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div className=\"col-12 px-0 my-3\">\n                    <div className=\"card no-hover\">\n                        <div className=\"single-seller d-flex align-items-center\">\n                            <Link to=\"/author\">\n                                <img className=\"avatar-md rounded-circle\" src={collection.user?.profilePhoto || userDefaultImg} alt=\"User Avatar\" />\n                            </Link>\n                            <div className=\"seller-info ml-3\">\n                                <Link className=\"seller mb-2\" to=\"/author\">{collection.user?.username}</Link>\n                                <span>Creator</span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </>\n    );\n}\n\nexport default CollectionPreview;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/bids/bids.action.js",["895","896"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body,tokenId,price,toAddress,fromAddress) => dispatch => {\n    alert(\"in herer\")\n    // dispatch(emptyError());\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n    //    placeBidNft(body,tokenId,price,toAddress,fromAddress)\n           \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    // if (qs)\n    //     url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/offers/offers.action.js",["897"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice, acceptNftOffer} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body,tokenId,price) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n     \n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            acceptNftOffer(body);\n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],{"ruleId":"898","severity":1,"message":"899","line":18,"column":6,"nodeType":"900","endLine":18,"endColumn":11,"suggestions":"901"},{"ruleId":"902","severity":1,"message":"903","line":17,"column":8,"nodeType":"904","messageId":"905","endLine":17,"endColumn":24},{"ruleId":"902","severity":1,"message":"906","line":7,"column":8,"nodeType":"904","messageId":"905","endLine":7,"endColumn":20},{"ruleId":"902","severity":1,"message":"907","line":1,"column":28,"nodeType":"904","messageId":"905","endLine":1,"endColumn":36},{"ruleId":"908","severity":1,"message":"909","line":49,"column":1,"nodeType":"910","endLine":162,"endColumn":2},{"ruleId":"908","severity":1,"message":"909","line":8,"column":1,"nodeType":"910","endLine":27,"endColumn":2},{"ruleId":"911","severity":1,"message":"912","line":14,"column":17,"nodeType":"913","messageId":"914","endLine":14,"endColumn":30},{"ruleId":"908","severity":1,"message":"909","line":12,"column":1,"nodeType":"910","endLine":33,"endColumn":2},{