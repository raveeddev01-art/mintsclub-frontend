ules":"190"},{"filePath":"383","messages":"384","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"385","usedDeprecatedRules":"190"},{"filePath":"386","messages":"387","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"388","messages":"389","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"390","messages":"391","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"392","messages":"393","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"394","messages":"395","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"396","messages":"397","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"398","messages":"399","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"400","messages":"401","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/index.js",[],["402","403"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/App.js",["404","405","406","407"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/store.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/routes.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/privateRoute.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/utils/web3.js",["408","409","410"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/config/config.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/index.js",["411","412"],"import { combineReducers } from \"redux\";\nimport homeReducer from \"./../components/home/home.reducer\";\nimport mintsReducer from \"../redux/reducer/reducer\";\nimport auctionReducer from \"./../components/auctions/auctions.reducer\";\nimport nftReducer from \"./../components/nfts/nfts.reducer\";\nimport userReducer from \"./../components/user/user.reducer\";\nimport walletReducer from \"./../components/wallet/wallet.reducer\";\nimport categoryReducer from \"./../components/categories/categories.reducer\";\nimport collectionReducer from \"./../components/collections/collections.reducer\";\nimport errorReducer from \"./shared/error/error.reducer\";\nimport settingsReducer from \"../components/footer/footer.reducer\";\n\nimport offersReducer from \"../components/offers/offers.reducer\";\nimport bidsReducer from \"../components/bids/bids.reducer\";\n\nimport exploreAllReducer from \"../components/explore/explore.reducer\";\nimport createNftReducer from \"../components/create-nft/create-nft-reducer\";\n\nexport default combineReducers({\n  home: homeReducer,\n  dashboard: mintsReducer,\n  auction: auctionReducer,\n  nft: nftReducer,\n  user: userReducer,\n  wallet: walletReducer,\n  category: categoryReducer,\n  collection: collectionReducer,\n  error: errorReducer,\n\n  offer: offersReducer,\n  bid: bidsReducer,\n\n  explore: exploreAllReducer,\n});\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",["413"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/home/home.js",["414","415"],"import React, { useEffect } from \"react\";\nimport { Table, Pagination } from \"react-bootstrap\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller2\";\n\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n  \n      <NavbarMain />\n      <Hero />\n\n      <Auctions />\n   \n  \n      <TopSeller viewAll={\"View All\"} />\n   \n      <PopularCollections />\n     \n      <OwnCollection />\n      <Buysell />\n      <Footer />\n    </>\n  );\n}\n\nexport default Home;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["416","417","418","419","420","421"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/explore-collections.js",["422","423","424","425"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collection-details.js",["426","427","428","429","430","431","432","433","434","435","436","437","438","439","440","441","442","443","444"],"import React, { useState, useEffect, useRef } from \"react\";\n\nimport Explore from \"../explore/explore-all\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection, getCollection } from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"../../config/config\";\nimport { Accordion, Dropdown } from \"react-bootstrap\";\nimport Select from 'react-select'\nimport NftCard from './components/NftCard/NftCard';\nimport {getNFTs} from '../nfts/nfts.action'\nimport {getCreators, beforeUser} from './../user/user.action';\nimport { toast } from \"react-toastify\";\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV;\n\nconst CollectionDetails = (props) => {\n  const [collection, setCollection] = useState(null);\n  const [nfts, setNfts] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [limit, setLimit] = useState(2);\n  const [collectionLoader, setColLoader] = useState(true); // collections loader\n  const [nftsLoader, setNftsLoader] = useState(true); // NFTs loader\n  const [creators,setCreator]=useState([])\n  const nftsRef = useRef(null);\n\n  useEffect(() => {\n   \n    props.getNFTs()\n    window.scroll(0, 0);\n    const { collectionId } = props.match.params;\n    if (collectionId) props.getCollection(window.atob(collectionId));\n    else props.history.push(\"/collections\");\n  }, []);\n\n  // when collection data is received\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collection } = props.collection;\n  \n      setCollection(collection);\n      props.beforeCollection();\n      setColLoader(false);\n    }\n  }, [props.collection.getAuth]);\n   \n  useEffect(()=>{\n      \n    if(props.user.topSellersAuth ){\n    \n       setCreator(props.user.sellers)\n\n    }\n  },[props.user.topSellersAuth])\n\n  // handle show load more button state when pagination is set\n  useEffect(() => {\n   \n    if (nftPagination)\n        setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length && nfts.length > 0))\n  }, [nftPagination])\n\n  const loadMore = () => {\n    \n    // const { page, limit } = nftPagination\n    setLoader(true)\n    setLimit(limit + 2)\n    // get more NFTs for explore section\n    // getNFTs(1, limit * (page + 1));\n  }\n\n  const filterNfts=(nfts)=>{\n\n    if(collection)\n    {\n      const result_nft = nfts.filter((nft)=>nft?.collectionId===collection._id);\n      nfts.pagination = { page: 1, limit: 10, total: result_nft.length, pages: 1 }\n      setNfts(result_nft.slice(0, limit));\n      setNFTPagination(nfts.pagination)\n      getNftsLoader(false);\n    }\n  }\n\n\n\n\n  const getNFTs = (page = 1, limit = 2) => {\n      const nftQS = { page, limit }\n      if (props.collectionId)\n          nftQS.collectionId = props.collectionId\n      const qs = ENV.objectToQueryString(nftQS)\n      props.getNFTs(qs)\n  }\n\n  useEffect(()=>{\n    if(props.nft.nftsAuth)\n    {\n      const {nftsData}=props.nft;\n      filterNfts(nftsData)  \n    }\n\n  },[props?.nft?.nftsAuth,collection, limit])\n\n\n\n  const getNftsLoader = (loader) => {\n    setNftsLoader(loader);\n  };\n\n  return (\n    <section\n      className=\"author-area explore-area  popular-collections-area\"\n      style={{ padding: \"0px\" }}\n    >\n      {(collectionLoader || nftsLoader) && <FullPageLoader />}\n      <div className=\"\">\n        {collection  && (\n          <div className=\"row p-5\" style={{width:\"80%\",margin:\"auto\"}}>\n            <div className=\"col-4 p-4\">\n              {/* <CollectionPreview collection={collection} creators={creators} /> */}\n            </div>\n            <div className=\"col-8 \">\n              <div className=\"row justify-content-center mt-5\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  <div className=\"intro text-center mb-4\">\n                      {/* <span>{initData.pre_heading}</span> */}\n                      <span>Explore</span>\n                      {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                          <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row gx-5 p-4\">\n              \n                {\n                  nfts && creators && nfts.map((nft)=>{\n                  return (\n                    <div className=\"col-6 mt-5\" style={{}}>\n                      <NftCard nft={nft} creators={creators}/>\n                    </div>\n                    )\n                  })\n                }\n                {\n                  loadMoreBtn &&\n                  <div className=\"row w-100\">\n                      <div className=\"col-12 w-100 text-center\">\n                          <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>Load More</a>\n                      </div>\n                  </div>\n                }\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  {\n\n  error: state.error,\n  collection: state.collection,\n  nft:state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollection,\n  getNFTs,\n  getCreators,\n\n})(CollectionDetails);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/create-nft.js",["445","446","447","448","449"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/signup/signup.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.js",["450","451","452","453","454","455","456","457"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["458","459","460","461","462","463","464","465","466","467","468","469","470","471","472","473","474","475","476","477","478","479","480"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["481","482","483","484","485","486","487","488","489","490","491","492","493","494","495","496"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["497","498","499","500","501","502","503","504","505","506","507"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["508","509","510","511","512","513","514","515","516","517","518","519","520","521","522","523","524","525"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["526","527","528"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore-all.js",["529","530","531","532","533","534","535","536","537"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFTs } from \"../nfts/nfts.action\";\nimport { ENV } from \"../../config/config\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport ExploreItems from \"./explore-items\";\nimport NftCard from \"../collections/components/NftCard/NftCard\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { getCreators, beforeUser } from \"./../user/user.action\";\n\nconst initData = {\n  pre_heading: \"Explore\",\n  heading: \"Exclusive Digital Assets\",\n  content: \"\",\n  btn_1: \"Load More\",\n};\n\nfunction ExploreAll(props) {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const pathname = useHistory().location.pathname;\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (pathname === \"/explore-all\") setIntro(true);\n    getNFTs();\n    props.getCreators();\n  }, []);\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      setCreator(props.user.sellers);\n    }\n  }, [props.user.topSellersAuth]);\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      setCreator(props.user.creators);\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nftsData } = props.nft;\n      if (nftsData) {\n        setNFTs(nftsData);\n        setNFTPagination(nftsData.pagination);\n        props.beforeNFT();\n        if (props.setLoader) props.setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  const loadMore = () => {\n    const { page, limit } = nftPagination;\n    setLoader(true);\n    getNFTs(1, limit * (page + 1));\n  };\n\n  const getNFTs = (page = 1, limit = 4) => {\n    const nftQS = { page, limit, explore: true };\n\n    if (props.collectionId) nftQS.collectionId = props.collectionId;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    props.getNFTs(qs);\n  };\n\n  return (\n    <section\n      className=\"explore-area\"\n      style={{ paddingTop: `${intro ? \"150\" : \"30\"}px` }}\n    >\n      {loader && <FullPageLoader />}\n      <div className=\"container\">\n        {intro && (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              <div className=\"intro text-center mb-4\">\n                <span>{initData.pre_heading}</span>\n                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n              </div>\n            </div>\n          </div>\n        )}\n        <div className=\"row items gx-4 explore-items\">\n          {nfts && nfts.length > 0 && creators.length > 0 ? (\n            nfts.map((item, idx) => {\n              return (\n                <div className=\"col-3 mt-5\" style={{}}>\n                  <NftCard\n                    nft={item}\n                    creators={creators}\n                    userId={ENV.getUserKeys(\"_id\")._id}\n                  />\n                </div>\n              );\n            })\n          ) : (\n            <p className=\"text-center\">No Items Found to Exploree</p>\n          )}\n        </div>\n        {loadMoreBtn && (\n          <div className=\"row\">\n            <div className=\"col-12 text-center\">\n              <a\n                id=\"load-btn\"\n                className=\"btn btn-bordered-white mt-5\"\n                onClick={() => loadMore()}\n              >\n                {initData.btn_1}\n              </a>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs, getCreators })(\n  ExploreAll\n);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["538","539","540","541","542","543","544","545","546","547","548","549"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["550","551","552","553","554","555","556","557","558","559","560","561","562","563","564","565","566","567","568","569","570","571","572","573","574","575","576","577","578","579","580","581","582","583","584","585","586","587","588","589","590","591"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/home/home.reducer.js",["592","593"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["594","595","596","597","598","599","600","601","602","603","604","605","606","607","608","609","610","611","612"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["613","614","615","616","617","618"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["619"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["620"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["621"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/create-nft-reducer.js",["622"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/reducer/reducer.js",["623"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["624"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["625"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user/user.reducer.js",["626"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.reducer.js",["627"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["628"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["629"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["630"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout2/layout2.jsx",["631","632"],"import React, { Component } from \"react\";\nimport Particles from \"react-tsparticles\";\nimport NavbarMain from \"../../components/navbar-main/NavbarMain\";\nimport Footer from \"../../components/footer/footer\";\n// import Scrollup from '../../components/scroll-up/sroll-up';\n\nclass Layout2 extends Component {\n  render() {\n    const particlesData = {\n      fullScreen: {\n        zIndex: -5,\n      },\n      color: {\n        value: \"#5666fe\",\n      },\n      twinkle: {\n        lines: {\n          enable: true,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n        particles: {\n          enable: false,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n      },\n      wobble: {\n        distance: 5,\n        enable: false,\n        speed: 2,\n      },\n      particles: {\n        number: {\n          value: 25,\n          density: {\n            enable: true,\n            value_area: 800,\n          },\n        },\n        shape: {\n          type: \"circle\",\n          stroke: {\n            width: 0,\n            color: \"#5666fe\",\n          },\n          polygon: {\n            nb_sides: 5,\n          },\n          image: {\n            src: \"img/github.svg\",\n            width: 100,\n            height: 100,\n          },\n        },\n        opacity: {\n          value: 0.5,\n          random: false,\n          anim: {\n            enable: false,\n            speed: 1,\n            opacity_min: 0.1,\n            sync: false,\n          },\n        },\n        size: {\n          value: 3,\n          random: true,\n          anim: {\n            enable: false,\n            speed: 50,\n            size_min: 0.1,\n            sync: false,\n          },\n        },\n        line_linked: {\n          enable: true,\n          distance: 150,\n          color: \"#5666fe\",\n          opacity: 0.4,\n          width: 1,\n        },\n        move: {\n          enable: true,\n          speed: 1,\n          direction: \"none\",\n          random: false,\n          straight: false,\n          out_mode: \"out\",\n          bounce: false,\n          attract: {\n            enable: false,\n            rotateX: 600,\n            rotateY: 1200,\n          },\n        },\n      },\n      interactivity: {\n        detect_on: \"canvas\",\n        events: {\n          onhover: {\n            enable: true,\n            mode: \"grab\",\n          },\n          onclick: {\n            enable: true,\n            mode: \"push\",\n          },\n          resize: true,\n        },\n        modes: {\n          grab: {\n            distance: 140,\n            line_linked: {\n              opacity: 1,\n            },\n          },\n          bubble: {\n            distance: 400,\n            size: 40,\n            duration: 2,\n            opacity: 8,\n            speed: 2,\n          },\n          repulse: {\n            distance: 200,\n            duration: 0.4,\n          },\n          push: {\n            particles_nb: 4,\n          },\n          remove: {\n            particles_nb: 2,\n          },\n        },\n      },\n      retina_detect: true,\n      zLayers: 1,\n    };\n    return (\n      <>\n        {/* <NavbarMain /> */}\n        <div className=\"main\">\n          <Particles id=\"tsparticles\" options={{ ...particlesData }} />\n          {this.props.children}\n        </div>\n        {/* <Footer /> */}\n      </>\n    );\n  }\n}\n\nexport default Layout2;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/top-seller/topseller2.js",["633","634","635","636","637"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["638","639","640","641","642","643","644","645","646","647","648"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.js",["649","650","651","652","653","654","655","656"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  // useEffect(() => {\n  //   if (props.settings.settingsAuth) {\n  //     setData(props.settings.settings);\n  //   }\n  // }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div className=\"input-group notify-form\">\n                  <div className=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/popular-collections.js",["657","658","659","660","661","662","663","664","665","666"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/types.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collections.actions.js",["667","668","669"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user/user.action.js",["670","671"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["672","673","674","675","676"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore.action.js",["677"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/hero/hero.js",["678","679","680"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport ExploreIcon from \"../../assets/images/explore-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                <svg width=\"22px\" height=\"16px\">\r\n                  <path\r\n                    fill-rule=\"evenodd\"\r\n                    fill=\"rgb(255, 255, 255)\"\r\n                    d=\"M10.788,0.151 C10.596,0.153 10.412,0.232 10.279,0.370 C10.145,0.508 10.72,0.694 10.76,0.886 L10.76,3.525 C10.73,3.717 10.148,3.903 10.283,4.40 C10.418,4.177 10.603,4.255 10.795,4.255 C10.988,4.255 11.173,4.177 11.308,4.40 C11.443,3.903 11.518,3.717 11.515,3.525 L11.515,0.886 C11.519,0.691 11.444,0.503 11.307,0.365 C11.170,0.226 10.983,0.149 10.788,0.151 ZM5.53,1.591 C4.878,1.586 4.707,1.646 4.573,1.759 C4.438,1.872 4.350,2.29 4.324,2.203 C4.298,2.376 4.336,2.553 4.430,2.700 L5.630,4.619 C5.725,4.792 5.887,4.919 6.78,4.969 C6.269,5.19 6.472,4.989 6.640,4.884 C6.808,4.780 6.926,4.612 6.966,4.419 C7.6,4.226 6.964,4.24 6.852,3.862 L5.652,1.943 C5.526,1.730 5.300,1.597 5.53,1.591 L5.53,1.591 ZM16.515,1.598 C16.278,1.611 16.61,1.740 15.938,1.943 L14.738,3.862 C14.626,4.24 14.585,4.226 14.625,4.419 C14.665,4.612 14.782,4.780 14.950,4.884 C15.118,4.989 15.321,5.19 15.512,4.969 C15.703,4.919 15.865,4.792 15.960,4.619 L17.160,2.700 C17.254,2.550 17.290,2.372 17.260,2.198 C17.231,2.24 17.139,1.867 17.2,1.756 C16.865,1.646 16.691,1.589 16.515,1.598 L16.515,1.598 ZM8.569,4.964 C8.438,4.978 8.313,5.27 8.209,5.107 L7.377,5.729 L4.670,6.411 L4.655,6.411 C