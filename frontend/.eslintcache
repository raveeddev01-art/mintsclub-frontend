unt":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"188"},{"filePath":"367","messages":"368","errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"369","usedDeprecatedRules":"188"},{"filePath":"370","messages":"371","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"188"},{"filePath":"372","messages":"373","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"374","messages":"375","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"188"},{"filePath":"376","messages":"377","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"378","messages":"379","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"380","messages":"381","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"188"},{"filePath":"382","messages":"383","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"384","usedDeprecatedRules":"188"},{"filePath":"385","messages":"386","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"387","usedDeprecatedRules":"188"},{"filePath":"388","messages":"389","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"188"},{"filePath":"390","messages":"391","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"392","usedDeprecatedRules":"188"},{"filePath":"393","messages":"394","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"397","messages":"398","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"399","messages":"400","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"401","usedDeprecatedRules":"188"},{"filePath":"402","messages":"403","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"404","usedDeprecatedRules":"346"},{"filePath":"405","messages":"406","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"188"},{"filePath":"407","messages":"408","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"188"},{"filePath":"409","messages":"410","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"411","usedDeprecatedRules":"188"},"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/index.js",[],["412","413"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/App.js",["414","415","416"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\n// import 'swiper/swiper-bundle.css';\n\nconst App = React.memo((props) => {\n  // const [walletAddress, setWalletAddress] = useState(\"\");\n  let walletAddress = false;\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const history = useHistory();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  // ///set Interval\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address) {\n        toast.info(\"Please login with new address\");\n        walletAddress = address;\n        // setWalletAddress(address)\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n      // setWalletAddress(address);\n    }\n    // }\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={\n                    ENV.getUserKeys(\"_id\")._id || route.path === \"/login\"\n                      ? true\n                      : false\n                  }\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nexport default App;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/routes.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/config/config.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/web3.js",["417"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/index.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["418","419","420","421","422","423"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\n\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst Populars = forwardRef((props, ref) => {\n  const [popular, setpopular] = useState([]);\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"all\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getPopularCollections(null, 1);\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      const pagination = props.popularCollections.pagination;\n\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.finalCollectionListing) {\n        let finalCollectionListing = finalCollectionListing.filter(\n          (item) => item.userId === userId\n        );\n        setpopular(finalCollectionListing);\n      } else {\n        if (finalCollectionListing === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setpopular(finalCollectionListing);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.getPopularAuth]);\n\n  const getPopularCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getPopularCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getPopularCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getPopularCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getPopularCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Collections\"} title2={\"PopularCollections\"} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                {/* Intro */}\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Most Popular</span>\n                    <h3 className=\"mb-0\">Popular Collections</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-lg-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\">\n                  <span class=\"sr-only\">Loading...</span>\n                </div>\n              ) : popular && popular.length > 0 ? (\n                popular.map((item) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\">\n                      <CollectionsCard\n                        CardImg={item.featuredImg}\n                        Subimg1={handleImage(item, 0)}\n                        Subimg2={handleImage(item, 1)}\n                        Subimg3={handleImage(item, 2)}\n                        name={item.name}\n                        id={item._id}\n                        collection={item}\n                        userName={item.username[0]}\n                        NFTCount={item.totalNfts}\n                        profileImage={item.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No popular collections Found\n                </p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    popular?.length === 10 &&\n                    pagination.totalRecords > popular.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforePopularCollection,\n    getPopularCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.reducer.js",["424","425"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/create-nft.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collection-details.js",["426","427","428","429","430","431","432","433","434","435","436","437","438","439","440","441","442","443","444"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/create-nft-reducer.js",["445"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}",["446","447"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["448","449","450","451","452","453","454","455","456","457","458","459","460","461","462"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/explore-collections.js",["463","464","465","466"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from \"react\";\n\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport \"./explore-collections.css\";\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from \"./collections.actions\";\nimport { Images } from \"../../assets/assets\";\n\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { beforeCategory, getCategories } from \"./collections.actions\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      // console.log('collections', collections.nftDetail);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Explore\"} title2={\"Explore All\"} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper\">\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Collections</span>\n                    <h3 className=\"mb-0\">Explore all</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item,index) => {\n                      return (\n                        <button\n                        key={index}\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item,index) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\" key={index}>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div className=\"spinner-border text-white\" role=\"status\">\n                  <span className=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection,index) => {\n                  return (\n                    <div className=\"col-sm-6 col-lg-4\" key={index}>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : \"\"\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center text-white not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {!empty &&\n                    collections?.length === 10 &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-linear-gradient px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/signup/signup.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["467","468","469","470","471","472","473","474","475","476","477","478","479","480","481"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["482","483","484"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"./../../config/config\";\nimport { getTopSellers, beforeUser } from \"./../user/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["485"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["486"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["487","488","489","490","491"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { connect } from \"react-redux\";\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\nimport { getCreators } from \"./../user/user.action\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\n\n\nconst AuctionsList = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [auctions, setAuctions] = useState(null);\n  const [loader, setLoader] = useState(true); // auctions loader\n  const [categories, setCategories] = useState([]);\n  const [categoryId, setCategoryId] = useState(\"all\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    // get live auctions\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n    props.getCreators();\n  }, []);\n\n  // set live auctions\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions } = props.auction;\n\n      setAuctions(auctions);\n      setLoader(false)\n      props.beforeAuction();\n    }\n  }, [props.auction.auctionsAuth]);\n  useEffect(() => {\n    props.getCategories();\n  }, []);\n  useEffect(() => {\n    if (props.collectionFlag) {\n      setCategories(props.categories);\n    }\n  }, [props.collectionFlag]);\n\n  const handleCategoryFilter = (desc) => {\n    setLoader(true)\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getLiveAuctions(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Auctions\"} title2={\"LiveAuctions\"} />\n      <section className=\"explore-collection-section padding-wrapper\">\n        {\n        // loader ? (\n        //   <FullPageLoader />\n        // ) : (\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Auctions</span>\n                    <h3 className=\"mb-0\">Live Auctions</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(id);\n                            handleCategoryFilter(item.description);\n                          }}\n                          className={`${\n                            id === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {loader ? (\n                <div class=\"spinner-border text-white\" role=\"status\"></div>\n              ) : auctions && auctions.length > 0 ? (\n                auctions.map((item, index) => {\n                  return (\n                    <div className=\"col-11 col-sm-6 col-md-5 col-lg-4 col-xl-3\">\n                      <AuctionsCards\n                        key={index}\n                        item={item}\n                        ownerName={item.owner.username}\n                        userId={ENV.getUserKeys(\"_id\")._id}\n                        ownerId={item.owner._id}\n                        bidsProfile={item.bidInfo.bidByProfile}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-white text-center mt-5\">No Live Auctions Found</p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {auctions &&\n                    props.auction.pagination.total > auctions.length &&\n                    auctions.length > 10 && (\n                      <button className=\"btn btn-linear-gradient px-5\">\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        }\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  auction: state.auction,\n  user: state.user,\n  collectionFlag: state.collection.collectionFlag,\n  categories: state.collection.categories,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n  getCreators,\n  getCategories,\n  beforeCategory,\n})(AuctionsList);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["492","493","494","495","496","497"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["498","499","500","501","502","503","504","505","506"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["507","508","509","510","511","512","513","514","515","516","517"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.js",["518","519","520","521","522","523","524","525"],"import React, { useState, useEffect } from \"react\";\nimport { Redirect, useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"../wallet/wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  getCollections,\n  beforeCategory,\n  beforeCollection,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport { login, signup } from \"../user/user.action\";\nimport \"./wallet.css\";\n\nconst Wallet = (props) => {\n  const history = useHistory();\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [disabled,setDisabled]=useState(false)\n\n  const connectMetamaskCall = async () => {\n    setDisabled(true)\n    let connectedAddress = await connectMetamaskCopy();\n    if (connectedAddress){\n      setDisabled(false)\n    }\n    setConnectedAddress(connectedAddress);\n    setWalletAddress(connectedAddress);\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      console.log(\"errors\", props.error);\n\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setDisabled(false)\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    console.log(props.collection.getAuth, \"props.collection.getAuth\");\n    if (props.collection.getAuth === true) {\n      let collections = props.collection.collections;\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n\n      // let myCollections = collections.filter((el) => el.userId === userId);\n\n      // if (myCollections && myCollections.length > 0) {\n      props.beforeCollection();\n      //   history.push(\"/\");\n      // } else {\n      // }\n      history.push(\"/\");\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    \n    e.preventDefault();\n    setDisabled(true)\n    try {\n      if (validator.isEmail(email)) {\n        let sign = await signRequest();\n        let payload = {\n          address: connectedAddress,\n          // password: sign,\n          email: email,\n          username: username,\n          isApproved: false,\n        };\n        // console.log(payload, \"payload\");\n        props.signup(payload);\n      } else {\n        setErrorMessage(\"please enter valid email\");\n      }\n    } catch (err) {\n      toast.error(err.message);\n      setDisabled(false)\n    }\n  };\n\n  const login = async () => {\n    try {\n      setDisabled(true)\n      let sign = await signRequest();\n      let payload = {\n        address: connectedAddress,\n      };\n      \n      props.login(payload);\n    } catch (err) {\n      setDisabled(false)\n      toast.error(err.message);\n    }\n  };\n\n  const switchSignup = () => {\n    setShowSignUpComponent(true);\n  };\n\n  // if (props.user.userAuth) {\n  //     console.log(\"@@@@Collection-----@\", collections);\n  //     if(collections && collections.length>){\n  //         console.log(\"In Upper\")\n  //         return <Redirect to=\"/create\" />\n  //     }\n  //     else {\n  //         console.log(\"In Down\");\n  //         return <Redirect to=\"/collection/create\" />\n  //     }\n  // }\n\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div className=\"container\">\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Sign In</span>\n                  <h3 className=\"mt-3 mb-0\">SignIn to your account</h3>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                <div className=\"card single-wallet sign-in-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <h4 className=\"mb-0\">Address</h4>\n                    <p id=\"connected-address mt-3\">{connectedAddress}</p>\n                    {errorMessage && (\n                      <p className=\"text-gray\">{errorMessage}</p>\n                    )}\n                    {!showSignUp && (\n                      <>\n                        <button\n                          className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4\"\n                          type=\"button\"\n                          disabled={disabled}\n                          onClick={() => login()}\n                        >\n                          Sign In\n                        </button>\n                      </>\n                    )}\n                  \n                    {showSignUp && (\n                      <button\n                        className=\"btn btn-linear-gradient btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                        type=\"button\"\n                        onClick={() => switchSignup()}\n                      >\n                        Would you like to Signup?\n                      </button>\n                    )}\n                      {/* <div className=\"mt-3\">\n                      <a\n                        className=\"text-white back-link \"\n                        onClick={() => {\n                          setConnectedAddress(\"\");\n                          setWalletAddress(\"\");\n                        }}\n                      >\n                        Back\n                      </a>\n                    </div> */}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              {/* Intro */}\n              <div className=\"intro text-center\">\n                <span>SIGNUP</span>\n                <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                <p className=\"text-gray\">Create the account with the address</p>\n              </div>\n              {/* Item Form */}\n              <form\n                className=\"item-form card no-hover signup-card\"\n                onSubmit={(e) => signup(e)}\n              >\n                <div className=\"row\">\n                  {errorMessage && (\n                    <p className=\"text-center text-gray\">{errorMessage}</p>\n                  )}\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"address\"\n                        placeholder=\"Address\"\n                        required=\"required\"\n                        disabled={true}\n                        value={connectedAddress}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"email\"\n                        className=\"form-control sign-up-input\"\n                        name=\"email\"\n                        placeholder=\"Enter your Email\"\n                        required=\"required\"\n                        defaultValue={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"username\"\n                        placeholder=\"Enter your Username\"\n                        required=\"required\"\n                        defaultValue={username}\n                        onChange={(e) => setUsername(e.target.value)}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3 text-center\">\n                      <div className=\"form-check form-check-inline\">\n                        <input\n                          className=\"form-check-input\"\n                          type=\"radio\"\n                          name=\"inlineRadioOptions\"\n                          id=\"inlineRadio1\"\n                          defaultValue=\"option1\"\n                          autoComplete=\"off\"\n                        />\n                        <label\n                          className=\"form-check-label text-center text-gray\"\n                          htmlFor=\"inlineRadio1\"\n                        >\n                          I agree to{\" \"}\n                          <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"text-center\">\n                      <button\n                        className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4  text-white \"\n                        type=\"submit\"\n                        disabled={disabled}\n                      >\n                        Sign Up\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        ) : (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Wallet Connect</span>\n                  <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                  <p className=\"text-white mt-3\">\n                    Please select the wallet you want to connect to.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              {errorMessage && <p className=\"text-white\">{errorMessage}</p>}\n              <div\n                className=\"col-12 col-md-6 col-lg-4 item\"\n                onClick={() => connectMetamaskCall()}\n              >\n                {/* Single Wallet */}\n                <div className=\"card single-wallet whole-hover wallet-metamask-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <img\n                      className=\"avatar-lg\"\n                      src=\"/img/metamask2.png\"\n                      alt=\"\"\n                    />\n                    <h4 className=\"mb-0 my-3\">MetaMask</h4>\n                    <p>\n                      A browser extension with great flexibility. The web's most\n                      popular wallet\n                    </p>\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n  beforeCollection,\n})(Wallet);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["526"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["527"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/reducer/reducer.js",["528"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.reducer.js",["529"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["530"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.reducer.js",["531"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["532"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["533"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["534"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["535","536","537","538","539","540","541","542"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["543","544","545","546","547","548","549","550","551","552","553","554","555","556","557","558","559","560","561","562","563","564"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout2/layout2.jsx",["565","566"],"import React, { Component } from \"react\";\nimport Particles from \"react-tsparticles\";\nimport NavbarMain from \"../../components/navbar-main/NavbarMain\";\nimport Footer from \"../../components/footer/footer\";\n// import Scrollup from '../../components/scroll-up/sroll-up';\n\nclass Layout2 extends Component {\n  render() {\n    const particlesData = {\n      fullScreen: {\n        zIndex: -5,\n      },\n      color: {\n        value: \"#5666fe\",\n      },\n      twinkle: {\n        lines: {\n          enable: true,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n        particles: {\n          enable: false,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n      },\n      wobble: {\n        distance: 5,\n        enable: false,\n        speed: 2,\n      },\n      particles: {\n        number: {\n          value: 25,\n          density: {\n            enable: true,\n            value_area: 800,\n          },\n        },\n        shape: {\n          type: \"circle\",\n          stroke: {\n            width: 0,\n            color: \"#5666fe\",\n          },\n          polygon: {\n            nb_sides: 5,\n          },\n          image: {\n            src: \"img/github.svg\",\n            width: 100,\n            height: 100,\n          },\n        },\n        opacity: {\n          value: 0.5,\n          random: false,\n          anim: {\n            enable: false,\n            speed: 1,\n            opacity_min: 0.1,\n            sync: false,\n          },\n        },\n        size: {\n          value: 3,\n          random: true,\n          anim: {\n            enable: false,\n            speed: 50,\n            size_min: 0.1,\n            sync: false,\n          },\n        },\n        line_linked: {\n          enable: true,\n          distance: 150,\n          color: \"#5666fe\",\n          opacity: 0.4,\n          width: 1,\n        },\n        move: {\n          enable: true,\n          speed: 1,\n          direction: \"none\",\n          random: false,\n          straight: false,\n          out_mode: \"out\",\n          bounce: false,\n          attract: {\n            enable: false,\n            rotateX: 600,\n            rotateY: 1200,\n          },\n        },\n      },\n      interactivity: {\n        detect_on: \"canvas\",\n        events: {\n          onhover: {\n            enable: true,\n            mode: \"grab\",\n          },\n          onclick: {\n            enable: true,\n            mode: \"push\",\n          },\n          resize: true,\n        },\n        modes: {\n          grab: {\n            distance: 140,\n            line_linked: {\n              opacity: 1,\n            },\n          },\n          bubble: {\n            distance: 400,\n            size: 40,\n            duration: 2,\n            opacity: 8,\n            speed: 2,\n          },\n          repulse: {\n            distance: 200,\n            duration: 0.4,\n          },\n          push: {\n            particles_nb: 4,\n          },\n          remove: {\n            particles_nb: 2,\n          },\n        },\n      },\n      retina_detect: true,\n      zLayers: 1,\n    };\n    return (\n      <>\n        {/* <NavbarMain /> */}\n        <div className=\"main\">\n          <Particles id=\"tsparticles\" options={{ ...particlesData }} />\n          {this.props.children}\n        </div>\n        {/* <Footer /> */}\n      </>\n    );\n  }\n}\n\nexport default Layout2;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["567","568","569","570","571","572","573"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\n\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\n\r\nimport { getCreators } from \"./../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  // const [creators, setCreator] = useState([]);\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"all\");\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  const [isActive, setIsActive] = useState(0);\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n\r\n  // useEffect(() => {\r\n  //   if (props.user.topSellersAuth) {\r\n  //     setCreator(props.user.sellers);\r\n  //     setLoader(false);\r\n  //   }\r\n  // }, [props.user.topSellersAuth]);\r\n\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n      if (auctions) {\r\n        auctions.forEach((element, i) => {\r\n          auctions[i].totalBids = element.bidInfo?.bidBy?.length;\r\n        });\r\n      }\r\n\r\n      setAuctions(auctions);\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products. We want to be a part of your\r\n                    smile, success and future growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\r\n              {categoryId === \"all\" && auctions && auctions?.length <= 1 ? (\r\n                \"\"\r\n              ) : (\r\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                  {categories &&\r\n                    categories.length > 0 &&\r\n                    categories.map((item, id) => {\r\n                      if (id <= 3) {\r\n                        return (\r\n                          <button\r\n                            key={id}\r\n                            className={`${\r\n                              id === isActive ? \"home-active-category\" : \"\"\r\n                            } me-1 me-sm-2`}\r\n                            onClick={() => {\r\n                              setIsActive(id);\r\n                              handleCategoryFilter(item.description);\r\n                            }}\r\n                          >\r\n                            {item.name}\r\n                          </button>\r\n                        );\r\n                      }\r\n                    })}\r\n                  <div className=\"intro-btn\">\r\n                    <Link\r\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                      to=\"/auctions\"\r\n                    >\r\n                      View All\r\n                      <img\r\n                        src={ViewAllIcon}\r\n                        alt=\"arrow-left\"\r\n                        className=\"ms-2 d-none d-sm-block\"\r\n                      />\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auctions-slides\">\r\n            <div className=\"\">\r\n              {auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item, index) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        key={index}\r\n                        item={item}\r\n                        ownerName={item.owner.username}\r\n                        userId={ENV.getUserKeys(\"_id\")._id}\r\n                        ownerId={item.owner._id}\r\n                        bidsProfile={item.bidInfo.bidByProfile}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className=\"text-white text-center\">No Live Auctions Found</p>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.js",["574","575","576","577","578","579"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div className=\"input-group notify-form\">\n                  <div className=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/popular-collections.js",["580","581","582","583","584","585","586","587","588","589"],"import React, { useState, useEffect, useRef } from \"react\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { Link } from \"react-router-dom\";\n\nimport CollectionsCard from \"../collections-cards/CollectionsCard\";\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\nimport CardSlider from \"../card-slider/CardSlider\";\nimport { ENV } from \"../../config/config\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n} from \"../collections/collections.actions\";\nimport { connect } from \"react-redux\";\nimport { CollectionImages } from \"../../assets/assets.js\";\nimport { Images } from \"../../assets/assets\";\nconst initData = {\n  pre_heading: \"Most Popular\",\n  heading: \"Popular Collections\",\n  btnText: \"Explore More\",\n};\n\nconst PopularCollections = (props) => {\n  const [popular, setpopular] = useState([]);\n  const [categories, setCategories] = useState(null);\n  const [categoryId, setCategoryId] = useState(\"all\");\n  const [popularSettings, settPopularSettings] = useState();\n  const [isActive, setIsActive] = useState(0);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.category.getAuth) {\n      setCategories(props.category.categories);\n    }\n  }, [props.category.getAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n      let popularCollectionsSettings = ENV.popularCollectionsSettings;\n      if (finalCollectionListing.length > 3) {\n        popularCollectionsSettings.infinite = true;\n      } else {\n        popularCollectionsSettings.infinite = false;\n      }\n      settPopularSettings(popularCollectionsSettings);\n      setpopular(finalCollectionListing);\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  const handleCategoryFilter = (desc) => {\n    props.beforePopularCollection();\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getPopularCollections(qs);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === \"image\");\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <section className=\"popular-collections-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row mb-5\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=\" mb-0\">{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products. We want to be a part of your\n                    smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\n              {categoryId === \"all\" && popular && popular?.length == 0 ? (\n                \"\"\n              ) : (\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      if (id <= 3) {\n                        return (\n                          <button\n                            key={id}\n                            className={`${\n                              id === isActive ? \"home-active-category\" : \"\"\n                            } me-1 me-sm-2`}\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      }\n                    })}\n                  <div className=\"intro-btn\">\n                    <Link\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\n                      to=\"/popular-collections\"\n                    >\n                      View All\n                      <img\n                        src={ViewAllIcon}\n                        alt=\"arrow-left\"\n                        className=\"ms-2 d-none d-sm-none\"\n                      />\n                    </Link>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n          {popular && popular.length && popular.length > 0 ? (\n            <CardSlider\n              settings={ENV.popularCollectionsSettings}\n              data={popular}\n              homeAuction\n            >\n              {popular.map((item, i) => {\n                if (i < 8) {\n                  return (\n                    <CollectionsCard\n                      key={i}\n                      Subimg1={handleImage(item, 0)}\n                      Subimg2={handleImage(item, 1)}\n                      Subimg3={handleImage(item, 2)}\n                      collection={item}\n                      CardImg={item.featuredImg}\n                      name={item.name}\n                      id={item._id}\n                      userName={item.username[0]}\n                      NFTCount={item.totalNfts}\n                      profileImage={item.profileImage[0]}\n                    />\n                  );\n                }\n              })}\n            </CardSlider>\n          ) : (\n            <p className=\"text-center text-white not-found-title mt-5\">\n              No popular collections Found\n            </p>\n          )}\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(mapStateToProps, {\n  beforePopularCollection,\n  beforeCategory,\n  getCategories,\n  getPopularCollections,\n})(PopularCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.action.js",["590","591"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n    console.log(data,\"data\")\n      if (data.status) {\n        // ENV.encryptUserData(data.data);\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n   \n       \n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.action.js",["592"],"\nimport { ENV } from './../../config/config';\nimport {TOGGLE_LIKE_RES,BEFORE_TOGGLE_LIKE } from '../../redux/types';\nimport axios from 'axios'\n\nexport const beforeTogleLikeDislike=()=>dispatch=>{\n  dispatch({\n    type: BEFORE_TOGGLE_LIKE,\n  });\n}\n\nexport const toggleLikeDislike = (body) => dispatch => {\n \n    let data=JSON.stringify(body)\n       const url = `${ENV.url}nftLikes/likeDislike`;\n    \n    axios.post(url,body)\n      .then(function (response) {\n       \n        dispatch({\n          type: TOGGLE_LIKE_RES,\n          payload: true,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n   };","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["593","594","595","596","597"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  CREATE_ACITIVITY,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n} from \"./../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       \n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const update =\n  (body, qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .put(url, body)\n      .then(function (response) {\n        if (response.data.success) {\n        } else {\n        }\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n  };\n\nexport const createActivity = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}activity/create`;\n\n  axios\n    .post(url, body)\n    .then(function (response) {\n    \n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const getActivities =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}activity/get`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {\n       \n\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n  export const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {    \n        dispatch({\n          type:  GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n \n      })\n      .catch(function (error) {\n        console.log(error)\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n   \n      });\n  };\n\nexport const getNFTsByCollection = (id) => (dispatch) => {\n  let data = {\n    collectionId: id,\n  };\n\n  dispatch(emptyError());\n\n  const url = `${ENV.url}nfts/getNFTsByCollection`;\n  axios\n    .post(url, data)\n    .then(function (response) {\n      if (response.data.success) {\n        dispatch({\n          type: GET_NFTS_BY_COLLECTION,\n          payload: response.data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: response.data,\n        });\n      }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .get(url)\n      .then(function (response) {\n        console.log();\n        if (response.data.success) {\n          dispatch({\n            type: GET_MYLIKED_NFTS,\n            payload: response.data.data,\n          });\n        } else {\n        }\n      })\n      .catch(function (error) {\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const createNFT = async (formData) => async (dispatch)=>{\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  try{\n\n    const res = await axiosPostFormData(\"nfts/storeNFTData\", formData, true);\n  }catch(error){\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n       \n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n        } else {\n        }\n      })\n      .catch((errors) => {});\n  };\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero/hero.js",["598"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                <svg width=\"22px\" height=\"16px\">\r\n                  <path\r\n                    fillRule=\"evenodd\"\r\n                    fill=\"rgb(255, 255, 255)\"\r\n                    d=\"M10.788,0.151 C10.596,0.153 10.412,0.232 10.279,0.370 C10.145,0.508 10.72,0.694 10.76,0.886 L10.76,3.525 C10.73,3.717 10.148,3.903 10.283,4.40 C10.418,4.177 10.603,4.255 10.795,4.255 C10.988,4.255 11.173,4.177 11.308,4.40 C11.443,3.903 11.518,3.717 11.515,3.525 L11.515,0.886 C11.519,0.691 11.444,0.503 11.307,0.365 C11.170,0.226 10.983,0.149 10.788,0.151 ZM5.53,1.591 C4.878,1.586 4.707,1.646 4.573,1.759 C4.438,1.872 4.350,2.29 4.324,2.203 C4.298,2.376 4.336,2.553 4.4