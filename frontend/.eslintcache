 no-hover text-center\">\r\n            <div className=\"image-over\">\r\n                <img id=\"nft-image\" className=\"card-img-top\" src={props.image ? props.image : itemPlaceholderImg} alt=\"NFT image\" />\r\n            </div>\r\n            <div className=\"card-caption col-12 p-0\">\r\n                <div className=\"card-body p-0 m-0\">\r\n                    {/* <h5 className=\"mb-3\">{props.name}</h5> */}\r\n                    {/* <p>{props.sold ? props.sold : 0} of {props.copies ? props.copies : 0} Copies</p> */}\r\n                    <p className=\"text-left nft-name-text mt-4\">{\"name\"}</p>\r\n                    <div className=\"d-flex justify-content-between\">\r\n\r\n                    <p className=\"text-white celo-text\">{props.currentPrice ? props.currentPrice : 0}{ENV.currency}</p>\r\n                    <p className=\"text-white\">{\"10/10\"}</p>\r\n                    </div>\r\n                    <div className=\"input-group\">\r\n                        <div className=\"input-group-append\">\r\n                            <button><i className=\"icon-docs\" /></button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n       \r\n    );\r\n}\r\n\r\nexport default NFTPreview;","/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/faq/faq.action.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/filter-search/filtersearch.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/collections/collection-preview.js",["830","831"],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/bids/bids.action.js",["832","833"],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/offers/offers.action.js",["834"],"/home/adnan/Desktop/mintsClubV2/frontend-v2/frontend/src/components/vide