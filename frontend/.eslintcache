,7.101 C7.949,7.76 8.36,7.32 8.111,6.973 L8.868,6.404 ZM9.768,7.123 C9.577,7.132 9.398,7.216 9.269,7.358 C9.140,7.499 9.73,7.686 9.82,7.877 C9.91,8.68 9.175,8.247 9.317,8.375 C9.458,8.504 9.645,8.572 9.836,8.562 L11.755,8.562 C11.947,8.565 12.133,8.491 12.270,8.355 C12.407,8.220 12.484,8.36 12.484,7.843 C12.484,7.650 12.407,7.466 12.270,7.330 C12.133,7.195 11.947,7.121 11.755,7.123 L9.836,7.123 C9.813,7.122 9.791,7.122 9.768,7.123 L9.768,7.123 ZM4.798,7.843 C6.661,7.843 8.156,9.338 8.156,11.201 C8.156,13.65 6.661,14.560 4.798,14.560 C2.934,14.560 1.439,13.65 1.439,11.201 C1.439,9.338 2.934,7.843 4.798,7.843 ZM16.793,7.843 C18.656,7.843 20.151,9.338 20.151,11.201 C20.151,13.65 18.656,14.560 16.793,14.560 C14.929,14.560 13.434,13.65 13.434,11.201 C13.434,9.338 14.929,7.843 16.793,7.843 L16.793,7.843 ZM4.798,8.562 C3.349,8.562 2.159,9.753 2.159,11.202 C2.159,12.650 3.349,13.840 4.798,13.840 C6.247,13.840 7.437,12.650 7.437,11.202 C7.437,9.753 6.247,8.562 4.798,8.562 L4.798,8.562 ZM16.793,8.562 C15.344,8.562 14.154,9.753 14.154,11.202 C14.154,12.650 15.344,13.840 16.793,13.840 C18.241,13.840 19.432,12.650 19.432,11.202 C19.432,9.753 18.241,8.562 16.793,8.562 L16.793,8.562 ZM4.798,10.2 C5.469,10.2 5.997,10.531 5.997,11.202 C5.997,11.872 5.469,12.401 4.798,12.401 C4.127,12.401 3.598,11.872 3.598,11.202 C3.598,10.531 4.127,10.2 4.798,10.2 ZM16.793,10.2 C17.464,10.2 17.992,10.531 17.992,11.202 C17.992,11.872 17.464,12.401 16.793,12.401 C16.122,12.401 15.593,11.872 15.593,11.202 C15.593,10.531 16.122,10.2 16.793,10.2 L16.793,10.2 Z\"\r\n                  />\r\n                </svg>\r\n                <p className=\"ms-1\">Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"d-lg-none d-flex watch-video align-items-center mt-5 mb-4\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6 col-xl-7 \">\r\n            <Slider\r\n              setHandler={setHandler}\r\n              sliderRadioButtons={sliderRadioButtons}\r\n              handleRadioInputs={handleRadioInputs}\r\n              sliderChecked={sliderChecked}\r\n            />\r\n          </div>\r\n          <div className=\"d-none d-lg-block col-12 col-lg-7\">\r\n            <div className=\"watch-video d-flex align-items-center\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-5\">\r\n            <div className=\"btn-container mx-auto mx-lg-0\">\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn me-3\"\r\n                onClick={prevBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-left\"></i>\r\n              </button>\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn\"\r\n                onClick={nextBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-right\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default Hero;\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/authors/authors.js",["1761","1762"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/header/header.js",["1763","1764","1765","1766","1767","1768","1769"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["1770","1771"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/buy-sell/Buysell.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["1772","1773","1774","1775","1776"],"import React, { useEffect, useState } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport AvatarImg from \"../../assets/images/seller-avatar.png\";\nimport HeartIcon from \"../../assets/images/heart-icon.svg\";\nimport ThreeDots from \"../../assets/images/threeDots.svg\";\nimport ArrowUp from \"../../assets/images/arrowUp.svg\";\nimport Bucket from \"../../assets/images/bucket.png\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../config/config\";\n\nimport { connect } from \"react-redux\";\n\nimport \"./AuctionsCard.css\";\nimport { propTypes } from \"react-recaptcha\";\n\nconst AuctionsCards = (props) => {\n  const { countDownRenderer } = ENV;\n  const history = useHistory();\n  // console.log(auctions,\"auctions123\")\n  return (\n    <Card\n      className=\"auction-card mx-2\"\n      onClick={() => history.push(`nftdetail/${props.id}`)}\n    >\n      <div className=\"auction-img-wrapper\">\n        <Card.Img variant=\"top\" src={props.image} alt=\"AuctionTopImg\" />\n        <div className=\"auction-countdown\">\n          <Countdown date={props.endDate} renderer={countDownRenderer} />\n        </div>\n      </div>\n      <Card.Body>\n        <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n          <div className=\"auction-card-avatar d-flex align-items-center\">\n            <img src={AvatarImg} alt=\"AvatarImg\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <img src={AvatarImg} alt=\"AvatarImg\" className=\"avatar-above-img\" />\n            <span className=\"ms-4\">9+ Place Bit</span>\n          </div>\n\n          <div className=\"options-icon\">\n            <img src={ThreeDots} alt=\"OptionsIcon\" />\n          </div>\n        </div>\n        <Card.Title>{props.name}</Card.Title>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>\n              {\"Owned by \"}\n              {props.ownerName.length > 8\n                ? props.ownerName.substring(0, 6) + \"...\"\n                : props.ownerName}\n            </p>\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>68.4 ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn d-flex align-items-center justify-content-center\">\n          <img src={Bucket} alt=\"\" className=\"me-1\" />\n          <p>Place a Bit</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state in nfts\"),\n  ({});\n\nexport default connect(mapStateToProps, {})(AuctionsCards);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/filter-component/FilterComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections-cards/CollectionsCard.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["1777","1778"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n \n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id || !sellingMethod\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",["1779","1780","1781","1782","1783","1784","1785","1786","1787"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/web3.js",["1788","1789"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\n\n\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\n\nexport const mintNFt = async (metaData, id, amount,recipientValue) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n  const value=Number(recipientValue)* 1000000000000000000;\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, \"0x\", metaData,connectedAddress,recipientValue)\n      .send({ from: connectedAddress, gassPrice: 5000000 });\n    console.log(result, \"result of minting\");\n    return result;\n  } catch (err) {\n    console.log(err, \"error while minting\");\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const openNFTForBidding = async (biddingTime, startTime, tokenId) => {\n  try {\n    console.log(typeof tokenId,\"tokenId\")\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id=Number(tokenId)\n\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id)\n      .send({ from: connectedAddress });\n    if (result) {\n      console.log(result, \"open for bidding result\");\n      return result;\n    }\n  } catch (err) {\n    console.log(err, \"open for bid error\");\n    return err;\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let bidAmount = Number(amount) * 1000000000000000000;\n\n    let id=Number(tokenId)\n    \n    const result = await contractM.methods\n      .bid(id)\n      .send({ from: connectedAddress, value: bidAmount, gas: 5000000 });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    \n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\nexport const putonsale= async (tokenId,amount,price)=>{\n  \n  try{\n  \n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n      const contractM = await getContractMethods();\n      let weiAmount =BigInt( Number(price) * 1000000000000000000);\n   \n      let id=Number(tokenId)\n      const result = await contractM.methods\n      .putonsale(id,amount,weiAmount)\n      .send({ from: connectedAddress, gas: 5000000 });\n   \n      if(result){\n        return result\n      }\n  }catch(err){\n    console.log(err,\"error\")\n    throw new Error(err);\n  }\n}\n\nexport const BuyFixedPriceNFT= async (amount,tokenId,setConfirmed,setTransactionHash)=>{\n  try{\n\n    let connectedAddress = await connectMetamask();\n      const contractM = await getContractMethods();\n      let id=Number(tokenId)\n      let weiAmount = Number(amount) * 1000000000000000000;\n      const result = await contractM.methods\n      .BuyFixedPriceNFT(id)\n      .send({ from: connectedAddress,value:weiAmount,gas: 5000000}).on('transactionHash',function(hash){\n        console.log(hash,\"hash\")\n        setTransactionHash(hash)\n        setConfirmed(true)\n      }).on('confirmation',function(confirmationNumber,receipt){\n        console.log(\"confirmed2\")\n      })\n\n      console.log(result,\"result\")\n      if(result){\n        return result\n      }\n  }catch(err){\n    console.log(err)\n    setConfirmed(false)\n    \n    throw new Error(err);\n  }\n}\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\n\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\nexport const mint = async () => {\n  const web3 = await getWeb3();\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  try {\n  } catch (e) {}\n};\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      console.log(e);\n    }\n  });\n};\n\nexport const ClaimFundsAfterBidding = () => {};\n\nexport const createNft = async () => {};\n\nexport const setNftToken = (body) => {\n  let url = process.env.REACT_APP_BASE_URL + `nftTokens/addToken`;\n  alert(\"calling\");\n\n  fetch(url, {\n    method: \"POST\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n    body: JSON.stringify(body),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        window.location.href = \"/explore-all\";\n      } else {\n      }\n    })\n    .catch((error) => {\n      console.log(error, \"error in catch blcok\");\n      if (error.response && error.response.data) {\n      }\n    });\n};\n\nexport const NftOwner = async () => {};\n\nexport const placeBidNft = async () => {};\n\nexport const SellOnFixedPrice = async () => {};\n\nexport const BuyFixedPriceNFTs = async () => {};\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n\nexport const acceptNftOffer = async () => {};\nexport const signTransaction = async () => {};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modal-menu/modal-menu.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modal-search/modal-search.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["1790","1791"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <label\n      className=\"w-100\"\n      onDrop={(e) => onDrop(e)}\n      onDragOver={(e) => dragOver(e)}\n      onDragEnter={(e) => dragEnter(e)}\n      onDragLeave={(e) => dragLeave(e)}\n    >\n      <div className=\"upload-image-border p-4 position-relative\">\n        {imageURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose\n              color=\"#e33d0bc2\"\n              className=\"uploaded-cross-icon\"\n              onClick={() => clearData()}\n            />\n            <img className=\"upload-image\" src={imageURL} alt=\"upload-image\" />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : videoURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <VideoComponent\n              videoUrl={videoURL}\n              videoStyles={videoStyles}\n              videoWidth=\"300\"\n            />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n          </div>\n        ) : audioSrc ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <AudioPlayer audioSrc={audioSrc} />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : (\n          <>\n            {\" \"}\n            <img\n              className=\"upload-image-place-holder\"\n              src={Images.uploadImage}\n              alt=\"upload-image\"\n            />\n            <div className=\"upload-details text-center mt-2\">\n              <p>Drag and drop your file</p>\n              <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n            </div>\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={(e) => onFileChange(e, \"onChange\")}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </>\n        )}\n      </div>\n    </label>\n  );\n};\n\nexport default Upload;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-preview/nft-preview.js",["1792"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore-items.js",["1793","1794","1795","1796","1797","1798","1799"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.js",["1800","1801","1802"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero/component/slider.js",["1803","1804","1805","1806","1807"],"import \"./slider.css\";\nimport { useState } from \"react\";\nimport HeroCards from \"../../hero-cards/HeroCards\";\nimport SliderNextIcon from \"../../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../../assets/images/sliderprevArrow.png\";\nimport AuctionsCards from \"../../auctions-cards/AuctionsCards\";\nimport { map } from \"jquery\";\nimport { ListingImg, CollectionImages } from \"../../../assets/assets\";\n\nconst Slider = ({\n  setHandler,\n  sliderRadioButtons,\n  handleRadioInputs,\n  sliderChecked,\n}) => {\n  return (\n    <section id=\"slider\">\n      {sliderRadioButtons.map((item) => {\n        return (\n          <input\n            type=\"radio\"\n            name=\"slider\"\n            value={item.value}\n            checked={sliderChecked === item.value}\n            onChange={(e) => handleRadioInputs(e)}\n            id={item.id}\n          />\n        );\n      })}\n      <label for=\"s1\" id=\"slide1\" onClick={() => setHandler(1)}>\n        <HeroCards CardImg={ListingImg.listingImg1} className=\"slide\" />\n      </label>\n      <label for=\"s2\" id=\"slide2\" onClick={() => setHandler(2)}>\n        <HeroCards CardImg={ListingImg.listingImg2} className=\"slide\" />\n      </label>\n      <label for=\"s3\" id=\"slide3\" onClick={() => setHandler(3)}>\n        <HeroCards CardImg={ListingImg.listingImg3} className=\"slide\" />\n      </label>\n      <label for=\"s4\" id=\"slide4\" onClick={() => setHandler(4)}>\n        <HeroCards CardImg={ListingImg.listingImg4} className=\"slide\" />\n      </label>\n      <label for=\"s5\" id=\"slide5\" onClick={() => setHandler(5)}>\n        <HeroCards CardImg={CollectionImages.mainImg1} className=\"slide\" />\n      </label>\n      <label for=\"s6\" id=\"slide6\" onClick={() => setHandler(6)}>\n        <HeroCards CardImg={CollectionImages.mainImg2} className=\"slide\" />\n      </label>\n      <label for=\"s7\" id=\"slide7\" onClick={() => setHandler(7)}>\n        <HeroCards CardImg={CollectionImages.mainImg3} className=\"slide\" />\n      </label>\n    </section>\n  );\n};\n\nexport default Slider;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/components/NftCard/NftCard.js",["1808","1809"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contact/contact.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collection-preview.js",["1810","1811"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/filter-search/filtersearch.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/faq/faq.js",["1812","1813"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/author-profile/author-profile.js",["1814","1815","1816","1817","1818"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/filter-search2/filtersearch2.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/help/help.js",["1819"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/sidebar/sidebar.js",["1820","1821","1822"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/item-details/item-details.js",["1823","1824","1825","1826","1827","1828","1829","1830","1831","1832","1833","1834","1835","1836","1837","1838","1839","1840"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/faq/faq.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.action.js",["1841"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.action.js",["1842","1843"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_BID, GET_BIDS, DELETE_BID, CREATE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {placeBidNft, acceptNftOffer} from '../../utils/web3'\nexport const beforeBid = () => {\n    return {\n        type: BEFORE_BID\n    }\n};\n\nexport const placeBid = (body) => dispatch => {\n\n    const url = `${ENV.url}bid/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n      console.log('data', data)\n        if (data.success) {\n          \n            toast.success(data.message)\n            dispatch({\n                type: CREATE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      console.log('listing', error)\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n \n};\nexport const getBidSByNftId=(qs='')=>dispatch=>{\n    let url = `${ENV.url}bid/claimableBidListbyNftId`;\n    if(qs){\n        url+=`?${qs}`   \n     }\n\n     fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n       \n        if (data.status) {\n            dispatch({\n                type: GETBIDS_BY_NFT,\n                payload: data.data.Bids\n            })\n        } else {\n            \n        }\n    }).catch(error => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n}\n\nexport const getBids = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/list`;\n    // if (qs)\n    //     url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"bids reponse==>\")\n        if (data.success) {\n            dispatch({\n                type: GET_BIDS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteBid = (bidId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}bid/delete/${bidId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"delete bid response\")\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"delete bid error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptBid = (body,tokenId) => dispatch => {\n    dispatch(emptyError());\n   \n    const url = `${ENV.url}bid/accept`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n           \n        //   acceptNftOffer(tokenId,body);\n            \n            toast.success(data.message)\n\n            dispatch({\n                type: ACCEPT_BID,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["1844","1845","1846","1847","1848","1849","1850","1851","1852","1853","1854","1855","1856","1857","1858","1859","1860","1861","1862"],"import React, { useEffect, useState } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport \"./user-edit-profile.css\";\nimport { editImages } from \"../../assets/assets\";\nimport { ReactComponent as ProfileEditSVG } from \"../../assets/images/edit-pen.svg\";\n/////////\n\nimport { connect } from \"react-redux\";\nimport AuthorProfile from \"../author-profile/author-profile\";\nimport { SET_INDIVIDUAL_USER } from \"../../redux/types\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { signRequest } from \"./../../utils/web3\";\nimport { ENV } from \"./../../config/config\";\nimport { toast } from \"react-toastify\";\nimport { useHistory } from \"react-router-dom\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\n\nconst EditProfile = (props) => {\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [facebookLink, setFbLink] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [gPlusLink, setgPlusLink] = useState(\"\");\n  const [vineLink, setVineLink] = useState(\"\");\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n      console.log(props.user, \"props.user==>\");\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      props.beforeUser();\n      setLoader(false);\n\n      setConnectedAddress(address ? address : \"\");\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      setBannerUrl(bannerImage ? bannerImage : \"\");\n\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      setLoader(false);\n      history.push(\"/userprofile\");\n    }\n  }, [props.user.userAuth]);\n\n  useEffect(() => {\n    if (props.error) {\n      setErrors(props.error.message);\n      goToTop();\n    }\n  }, [props.error]);\n\n  const goToTop = () => {\n    $(\"html, body\").animate(\n      {\n        scrollTop: 0,\n      },\n      600\n    );\n  };\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setImageUrl(fileURL);\n      setImage(file);\n    }\n  };\n\n  const onBannerChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setBannerUrl(fileURL);\n      setBannerImage(file);\n    }\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    let obj = {\n      image,\n      banner,\n      username,\n      instaLink,\n      webLink,\n      description,\n      email,\n      address,\n      instaLink,\n      twitterLink,\n    };\n\n    console.log(obj, \"obj\");\n    setErrors(\"\");\n    setLoader(true);\n    setIsSubmitted(true);\n    let isFormValid = validator.allValid() ? true : false;\n    if (isFormValid) {\n      try {\n        // let signature = await signRequest();\n        setLoader(true);\n        console.log(ENV.getUserKeys(\"_id\")._id, \"id\");\n        var formData = new FormData();\n        formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n        if (image) {\n          formData.append(\"profileImage\", image);\n        }\n        if (banner) {\n          formData.append(\"bannerImage\", banner);\n        }\n        formData.append(\"bio\", description);\n        formData.append(\"twitterLink\", twitterLink);\n        formData.append(\"username\", username);\n        formData.append(\"email\", email);\n        formData.append(\"webLink\", webLink);\n        formData.append(\"instaLink\", instaLink);\n        console.log(\"sending request\");\n        // return ''\n        props.updateProfile(formData);\n      } catch (e) {}\n    } else {\n      validator.showMessages();\n      setErrors(\"Please fill all required fields in valid format.\");\n      goToTop();\n    }\n  };\n  return (\n    <>\n      {loader && <FullPageLoader />}\n      <NavbarMain />\n      <Breadcrumb title1={\"Profile\"} title2={\"EditProfile\"} />\n      <section className=\"edit-profile padding-wrapper\">\n        <form onSubmit={submit}>\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Set Up Your Profile</span>\n                    <h3 className=\"mb-0\">Profile Setting</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                <div className=\"edit-inp-subheading\">\n                  <h6>Profile Image</h6>\n                </div>\n                <div className=\"edit-avatar pt-4\">\n                  <img\n                    src={imageUrl ? imageUrl : editImages.EditAvatar}\n                    alt=\"editavatar\"\n                  />\n\n                  <label>\n                    <div className=\"avatar-btn-pen\">\n                      <ProfileEditSVG />\n                    </div>\n                    <input\n                      type=\"file\"\n                      accept=\".png,.jpeg,.jpg\"\n                      onChange={(e) => onFileChange(e)}\n                      style={{ display: \"none\" }}\n                      name=\"image\"\n                    />\n                  </label>\n                </div>\n                <div className=\"edit-banner-container\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Profile Banner</h6>\n                  </div>\n                  <div className=\"edit-banner pt-4\">\n                    <img\n                      src={bannerUrl ? bannerUrl : editImages.EditBanner}\n                      alt=\"editavatar\"\n                    />\n                    <label>\n                      <div className=\"banner-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => onBannerChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"banner\"\n                      />\n                    </label>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                <div className=\"row g-4\">\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Username</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"username\"\n                        placeholder=\"User Name\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        onChange={(e) => setUsername(e.target.value)}\n                        defaultValue={username}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"username\", username, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Email Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"email\"\n                        placeholder=\"Email Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        readOnly\n                        value={email}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"email\", email, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Wallet Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"address\"\n                        placeholder=\"Wallet Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        value={address}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"address\", address, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-8\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Bio</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <textarea\n                        name=\"bio\"\n                        placeholder=\"Bio\"\n                        onChange={(e) => setDescription(e.target.value)}\n                        defaultValue={description}\n                      ></textarea>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Links</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Twitter}\n                          alt=\"twitterlink\"\n                        />\n                        <input\n                          name=\"twitterlink\"\n                          placeholder=\"Twitter Link\"\n                          autocomplete=\"off\"\n                          ype=\"url\"\n                          onChange={(e) => setTwitterLink(e.target.value)}\n                          defaultValue={twitterLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Insta}\n                          alt=\"instalink\"\n                        />\n                        <input\n                          name=\"instagramlink\"\n                          placeholder=\"Instagram Link\"\n                          type=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => setInstaLink(e.target.value)}\n                          defaultValue={instaLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Website}\n                          alt=\"websitelink\"\n                        />\n                        <input\n                          name=\"websitelink\"\n                          placeholder=\"Website Link\"\n                          ype=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => setWebLink(e.target.value)}\n                          defaultValue={webLink}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                <div className=\"\">\n                  <button className=\"btn btn-linear-gradient\">\n                    Save changes\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </form>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  console.log(state, \"state\"),\n  {\n    wallet: state.wallet,\n    user: state.user,\n    error: state.error,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n})(EditProfile);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/videoCard.js",["1863"],"import React, { useRef } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./videoCard.css\";\nimport useVideoPlayer from \"./components/useVideoPlayer\";\n\nconst VideoCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const videoElement = useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div className=\"auction-img-wrapper\">\n        <div className=\"card-img-top\">\n          <div className=\"video-wrapper\">\n            <video\n              src={CardImg}\n              ref={videoElement}\n              onTimeUpdate={handleOnTimeUpdate}\n            />\n            <div className=\"controls\">\n              <div className=\"actions\">\n                <button className=\"play-pause-btn\" onClick={togglePlay}>\n                  {playerState.isPlaying ? (\n                    <i className=\"fa fa-play\"></i>\n                  ) : (\n                    <i className=\"fa fa-pause\"></i>\n                  )}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          <div className=\"options-icon like-icon text-white\">\n            {validateIfLiked(likedNfts, id) ? (\n              <>\n                <AiFillHeart\n                  className=\"heart-fill-icon\"\n                  onClick={() => {\n                    handleLikesTogleApi(id, \"dislike\");\n                    setToggle(!toggle);\n                  }}\n                />{\" \"}\n                {likesCount ? likesCount : 0}\n              </>\n            ) : (\n              <img\n                src={HeartIcon}\n                alt=\"OptionsIcon\"\n                onClick={() => {\n                  handleLikesTogleApi(id, \"like\");\n                  setToggle(!toggle);\n                }}\n              />\n            )}\n          </div>\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\">\n          <p>Buy now</p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default VideoCards;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["1864"],"import React from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport \"./CreateCollections.css\";\nimport { editImages } from \"../../assets/assets\";\nimport { ReactComponent as ProfileEditSVG } from \"../../assets/images/edit-pen.svg\";\nimport CollectionUploadIcon from \"../../assets/images/collection-upload-icon.svg\";\nconst CreateCollections = () => {\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Collections\"} title2={\"CreateCollections\"} />\n      <section className=\"edit-profile padding-wrapper create-collection-container\">\n        <form>\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Create Now</span>\n                    <h3 className=\"mb-0\">Create New Collection</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                <div className=\"edit-inp-subheading\">\n                  <h6>Logo Image</h6>\n                </div>\n                <div className=\"collection-logo-container pt-2\">\n                  <div className=\"colection-avatar\"></div>\n                  <label>\n                    <div className=\"avatar-btn-pen\">\n                      <ProfileEditSVG />\n                    </div>\n                    <input\n                      type=\"file\"\n                      accept=\".png,.jpeg,.jpg\"\n                      style={{ display: \"none\" }}\n                      name=\"image\"\n                    />\n                  </label>\n                </div>\n                <div className=\"\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Featured Image</h6>\n                  </div>\n                  <div className=\"upload-featured-container\">\n                    <div className=\"upload-featured-img\">\n                      <div>\n                        <img src={CollectionUploadIcon} alt=\"upload-icon\" />\n                      </div>\n                      <div className=\"upload-featured-img-content pt-2\">\n                        <h6 className=\"pb-1\">Browse Files</h6>\n                        <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                      </div>\n                    </div>\n                    <label>\n                      <input\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        style={{ display: \"none\" }}\n                        name=\"banner\"\n                      />\n                    </label>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                <div className=\"row g-4\">\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Name</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"name\"\n                        placeholder=\"Name\"\n                        autocomplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>URL</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input name=\"url\" placeholder=\"URL\" autocomplete=\"off\" />\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Select Category</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <select>\n                        <option value=\"\" className=\"d-none\">\n                          Select Collection\n                        </option>\n                        <option>Music</option>\n                        <option>Art</option>\n                      </select>\n                    </div>\n                  </div>\n                  <div className=\"col-md-8\">\n                    <div className=\"edit-inp-subheading pt-4\">\n                      <h6>Discription</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <textarea\n                        name=\"discription\"\n                        placeholder=\"Discription\"\n                      ></textarea>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                <div className=\"\">\n                  <button className=\"btn btn-linear-gradient\">\n                    Create Collections\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </form>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nexport default CreateCollections;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BuyModal.js",["1865","1866","1867","1868","1869","1870","1871","1872","1873"],"import React, { useState } from \"react\";\nimport { Modal, Button, Spinner } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport NftImg from \"../../assets/images/listingImg3.png\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nconst BuyModal = (props) => {\n\n  const [purchase, setPurchase] = useState(true);\n  const [checkBox, setCheckBox] = useState(false);\n  const {\n    name,\n    image,\n    price,\n    exchangeRate,\n    tokenId,\n    modal,\n    setModal,\n    BuyNow,\n    confirmed,\n    transactionHash,\n    transactionSuccess,\n  } = props;\n\n  return confirmed === \"\" ? (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Complete Checkout\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center\">\n          <div className=\"col-md-8\">\n            <div className=\"d-flex align-items-center\">\n              <div className=\"modal-nft-container\">\n                <div className=\"modal-nft-img\">\n                  <img src={image} alt=\"nft-img\" />\n                </div>\n              </div>\n              <div className=\"modal-nft-conntent ms-2\">\n                <p>{name}</p>\n                <p>\n                  {name} # {tokenId}\n                </p>\n                <p>Creator Fees: 5%</p>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-4\">\n            <div className=\"modal-nft-detail text-end\">\n              <p>{price} ETH</p>\n              <p>${(price * exchangeRate).toFixed(2)}</p>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-6 col-md-8\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-6 col-md-4\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>{price} ETH</h6>\n              <p>${(price * exchangeRate).toFixed(2)}</p>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container\">\n            {checkBox ? (\n              <div\n                className=\"custom-checked-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <img src={TickIcon} alt=\"checked\" />\n              </div>\n            ) : (\n              <div\n                className=\"custom-uncheck-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></div>\n            )}\n            <p>\n              By checking this box,I agree to MintsClub{\" \"}\n              <Link>Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <Button\n          onClick={() => {\n            BuyNow();\n          }}\n          className=\"btn btn-linear-gradient mt-2\"\n        >\n          Confirm Checkout\n        </Button>\n      </Modal.Footer>\n    </Modal>\n  ) : (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal purchase-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          {!transactionSuccess\n            ? \"Your Purchase is Processing\"\n            : \"Your Purchase has processed!\"}\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"modal-nft-container\">\n          <div className=\"modal-nft-img\">\n            <img src={image} alt=\"nft-img\" />\n          </div>\n        </div>\n        <div className=\"modal-nft-purchased mt-3\">\n          {!transactionSuccess ? (\n            <p>\n              Woo! You just Purchased FancyLaday. It should be confirmed on the\n              blockchain shortly\n            </p>\n          ) : (\n            <p>\n              {\" \"}\n              Woo! You just Purchased FancyLaday. It's been confirmed on the\n              blockchain shortly\n            </p>\n          )}\n        </div>\n        <div className=\"modal-nft-status mt-4\">\n          <div className=\"modal-status-subheadings d-flex align-items-center justify-content-between\">\n            <p> Status </p>\n            <p> Transaction Hash </p>\n          </div>\n          <div className=\"modal-status-content d-flex align-items-center justify-content-between\">\n            <div className=\"status-process d-flex align-items-center\">\n              {!transactionSuccess ? (\n                <>\n                  <Spinner\n                    animation=\"border\"\n                    role=\"status\"\n                    size=\"sm\"\n                    variant=\"primary\"\n                    className=\"me-1\"\n                  ></Spinner>\n                  <p>Processing</p>\n                </>\n              ) : (\n                <>\n                  <CheckCircleIcon />\n                </>\n              )}\n            </div>\n            <div className=\"status-address\">\n              <p>\n                {\n                  (transactionHash.slice(0, 6),\n                  \".....\",\n                  transactionHash.slice(-6))\n                }\n              </p>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <p>Share</p>\n        </div>\n        <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-linkedin-in\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-facebook-f\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-instagram\"} />\n          </a>\n          <a href=\"#\" target=\"_blank\">\n            <i className={\"fab fa-twitter\"} />\n          </a>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default BuyModal;\n",{"ruleId":"1874","replacedBy":"1875"},{"ruleId":"1876","replacedBy":"1877"},{"ruleId":"1878","severity":1,"message":"1879","line":18,"column":6,"nodeType":"1880","endLine":18,"endColumn":11,"suggestions":"1881"},{"ruleId":"1882","severity":1,"message":"1883","line":17,"column":8,"nodeType":"1884","messageId":"1885","endLine":17,"endColumn":24},{"ruleId":"1882","severity":1,"message":"1886","line":4,"column":10,"nodeType":"1884","messageId":"1885","endLine":4,"endColumn":17},{"ruleId":"1882","severity":1,"message":"1887","line":1,"column":28,"nodeType":"1884","messageId":"1885","endLine":1,"endColumn":36},{"ruleId":"1888","severity":1,"message":"1889","line":12,"column":1,"nodeType":"1890","endLine":33,"endColumn":2},{"ruleId":"1888","severity":1,"message":"1889","line":49,"column":1,"nodeType":"1890","endLine":162,"endColumn":2},{"ruleId":"1888","severity":1,"message":"1889","line":8,"column":1,"nodeType":"1890","endLine":27,"endColumn":2},{"ruleId":"1891","severity":1,"message":"1892","line":14,"column":17,"nodeType":"1893","messageId":"1894","endLine":14,"endColumn":30},{"ruleId":"1888","severity":1,"message":"1889","line":11,"column":1,"nodeType":"1890","endLine":55,"endColumn":2},{"ruleId":"1888","severity":1,"message":"1889","line":8,"column":1,"nodeType":"1890","endLine":28,"endColumn":2},{"ruleId":"1888","severity":1,"message":"1889","line":8,"column":1,"nodeType":"1890","endLine":32,"endColumn":2},{"ruleId":"1888","severity":1,"message":"1889","line":8,"column":1,"nodeType":"1890","endLine":27,"endColumn":2},{"ruleId":"1888","severity":1,"message":"1889","line":13,"column":1,"nodeType":"1890","endLine":56,"endColumn":2},{"ruleId":"1888","severity":1,"message":"1889","line":19,"column":1,"nodeType":"1890","endLine":91,"endColumn":2},{"ruleId":"1888","