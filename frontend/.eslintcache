nconst Home = (props) => {\n  //  useEffect(()=>{\n  // },[])\n  GaTracker();\n  const networksData = [\n    { name: \"Ethereum\", image: Ethereum },\n    { name: \"Polygon\", image: Polygon },\n    { name: \"Cardano\", image: Cardano },\n    { name: \"Binance SmartChain\", image: Binance },\n  ];\n\n  const history = useHistory();\n\n  return (\n    <div className=\"home-container\">\n      <div className=\"container\">\n        <div className=\"pt-3\">\n          <Navbar />\n        </div>\n        <div className=\"mt-4 details-container\">\n          <div className=\" d-flex justify-content-between home-info-container\">\n            <div className=\" \">\n              <div className=\"details\">\n                <div className=\"\" style={{ maxWidth: \"31rem\" }}>\n                  <p\n                    className=\"text-white mint-title\"\n                    style={{ fontSize: \"46px\", fontWeight: \"bold\" }}\n                  >\n                    Let's Mint Your NFTs\n                  </p>\n                  <p\n                    className=\"text-white mint-title\"\n                    style={{ fontSize: \"30px\", fontWeight: \"bold\" }}\n                  >\n                    All you can Mint for {\" \"}\n                    <span style={{color: \"#fcd70d\"}}>Free !</span> \n                  </p>\n                  {/* <p className=\"text-white\" style={{ fontSize: \"20px\" }}>\n                    Lorem Ipsum is simply dummy text of the printing and\n                    typesetting industry.{\" \"}\n                  </p> */}\n                </div>\n              </div>\n\n              <div className=\"networks \">\n                <p\n                  className=\"text-white select-network-heading\"\n                  style={{ fontSize: \"36px\" }}\n                >\n                  Select Network\n                </p>\n                <div className=\"networks-list-container mt-4 d-flex \">\n                  {/* {networksData.map((item, index) => {\n                    return (\n                      <div\n                        className=\"network\"\n                        disabled={true}\n                        key={index}\n                     \n                      >\n                      \n                        <img\n                          src={item.image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\n                            \"Ethereum\" === item.name ? \"\" : \"selected-network\"\n                          }`}\n                        />\n                        {\"Ethereum\" !== item.name && (\n                          <span className=\"tooltiptext\">Coming soon</span>\n                        )}\n                      \n                        <p\n                          className={`ml-1 mt-2 ${\n                            \"Ethereum\" === item.name\n                              ? \"network-title-yellow\"\n                              : \"network-title-white\"\n                          }`}\n                          style={{ fontSize: \"14px\" }}\n                        >\n                          {item.name === \"Binance SmartChain\" ? (\n                            <p>\n                              {\"Binance\"} <br /> {\"SmartChain\"}\n                            </p>\n                          ) : (\n                            item.name\n                          )}\n                        </p>\n                      </div>\n                    );\n                  })} */}\n                  {\n                    <div\n                      className=\"network d-flex\"\n                      disabled={true}\n                      //  key={index}\n                    >\n                      {/* {networksData.map((item, index) => {\n                        return (\n                          <div>\n                            <img\n                              src={item.image}\n                              alt=\"coming soon\"\n                              style={{\n                                width: \"4rem\",\n                                cursor: \"pointer\",\n                              }}\n                              className={`network-img  ${\n                                \"Ethereum\" === item.name\n                                  ? \"\"\n                                  : \"selected-network\"\n                              } ${index !== 0 ? \"ml-3\" : \"ml-0\"}`}\n                            />\n                            <p\n                              className={`text-white mt-1  ${\n                                index !== 0 ? \"ml-3\" : \"ml-0\"\n                              }`}\n                            >\n                              {item.name}\n                            </p>\n                            {\"Ethereum\" !== item.name && (\n                              <span\n                                className=\"tooltiptext\"\n                                style={{\n                                  display: `${\n                                    \"Ethereum\" === item.name ? \"none\" : \"block\"\n                                  }`,\n                                }}\n                              >\n                                Coming soon\n                              </span>\n                            )}\n                          </div>\n                        );\n                      })} */}\n                      <div className=\"\">\n                        <img\n                          src={networksData[0].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\n                            \"Ethereum\" === networksData[0].name\n                              ? \"\"\n                              : \"selected-network\"\n                          }`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[0].name}\n                        </p>\n                      </div>\n                      <div className=\" ml-3 polygon position-relative\">\n                        <span className=\"tooltiptext1 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[1].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[1].name}\n                        </p>\n                      </div>\n\n                      <div className=\" ml-3 cardano position-relative\" >\n                        <span className=\"tooltiptext2 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[2].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[2].name}\n                        </p>\n                      </div>\n\n                      <div className=\" ml-3 binance position-relative\">\n                        <span className=\"tooltiptext3 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[3].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img   ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                        {\"Binance\"} <br /> {\"SmartChain\"}\n                        </p>\n                      </div>\n                    </div>\n                  }\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-4\"\n                onClick={() => history.push(\"/fourStepForm\")}\n              >\n                Lets Start\n              </button>\n            </div>\n\n            <div className=\"d-flex  home-slider-wrapper \">\n              <div\n                className=\"home-slider-container\"\n                style={{ marginLeft: \"2rem\" }}\n              >\n                <SimpleSlider assetList={WordsFamousNfts} />\n                {/* {\n                  !spinner &&\n\n                  }\n                  <div className=\"d-flex justify-content-center align-items-center h-100\" style={{display:`${spinner?\"none\":\"block\"}`}}>\n\n                    <div className=\"lds-ellipsis\"><div></div><div></div><div></div><div></div></div>\n                  </div>  */}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// const mapStateToProps = (state) =>\n//   // console.log(state, \"state\"),\n//   ({\n//     hometest: state.home,\n//   });\n\n// export default connect(mapStateToProps, {\n//   hometest,\n// })(Home);\nexport default Home;\n",["588","589"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/index.js",["590","591","592"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Navbar/navbar.js",["593","594","595","596","597","598","599","600","601"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/exportData.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Slider/slider.js",["602","603","604"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/web3.js",["605","606","607","608","609","610","611"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/actions/actions.js",["612","613","614","615"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.js",["616","617","618","619","620","621","622","623"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step2/Step2.js",["624","625"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step4/Step4.js",["626","627","628","629","630","631","632","633","634","6