Line":17,"endColumn":11},{"ruleId":"417","severity":1,"message":"418","line":11,"column":9,"nodeType":"419","endLine":16,"endColumn":11},"no-unused-vars","'GaTracker' is defined but never used.","Identifier","unusedVar","react-hooks/exhaustive-deps","React Hook useEffect has missing dependencies: 'tawkToKey' and 'tawkToPropertyId'. Either include them or remove the dependency array. Outer scope values like 'ENV' aren't valid dependencies because mutating them doesn't re-render the component.","ArrayExpression",["485"],"'layout1' is defined but never used.","'layout3' is defined but never used.","'layout4' is defined but never used.","'connect' is defined but never used.","'useState' is defined but never used.","import/no-anonymous-default-export","Unexpected default export of anonymous function","ExportDefaultDeclaration","no-dupe-keys","Duplicate key 'featuredItems'.","ObjectExpression","unexpected","'useEffect' is defined but never used.","'nft1' is defined but never used.","'nft2' is defined but never used.","'nft3' is defined but never used.","'nft4' is defined but never used.","'nft5' is defined but never used.","'Container' is defined but never used.","no-native-reassign",["486"],"no-negated-in-lhs",["487"],"'ProgressBar' is defined but never used.","'visible' is assigned a value but never used.","'setVisible' is assigned a value but never used.","'mintsLogoSmily' is defined but never used.","'fullNavIcon' is defined but never used.","'tawkToPropertyId' is assigned a value but never used.","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"488","text":"489"},{"range":"490","text":"489"},{"range":"491","text":"489"},{"range":"492","text":"489"},"'WordsFamousNfts' is defined but never used.","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","'network' is assigned a value but never used.","'accounts' is assigned a value but never used.","'dotenv' is defined but never used.","'msToTime' is defined but never used.","'config' is assigned a value but never used.",["486"],["487"],"React Hook useEffect has a missing dependency: 'props'. Either include it or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["493"],"React Hook useEffect has a missing dependency: 'props.settings.settings'. Either include it or remove the dependency array. If 'setData' needs the current value of 'props.settings.settings', you can also switch to useReducer instead of useState and read 'props.settings.settings' in the reducer.",["494"],{"range":"495","text":"489"},{"range":"496","text":"489"},{"range":"497","text":"489"},{"range":"498","text":"489"},{"range":"499","text":"489"},"'linkError' is assigned a value but never used.","'httpValidation' is assigned a value but never used.","'setCaptchaMessage' is assigned a value but never used.","'setDeployNetwork' is assigned a value but never used.","'deploy' is assigned a value but never used.","'setMaxLimit' is assigned a value but never used.","react/jsx-no-duplicate-props","No duplicate props allowed","JSXAttribute","noDuplicateProps",{"range":"500","text":"489"},"'loader' is assigned a value but never used.","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression",["501"],"'formatAddress' is assigned a value but never used.","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","'IconButton' is defined but never used.","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'AddBtnImage' is defined but never used.","'PropertiesModal' is defined but never used.","'LevelsModal' is defined but never used.","'Typography' is defined but never used.","'ListItemText' is defined but never used.","'InfoComp' is defined but never used.","'genStyle' is assigned a value but never used.","'userId' is assigned a value but never used.","'errorMessage' is assigned a value but never used.","array-callback-return","Array.prototype.map() expects a value to be returned at the end of arrow function.","expectedAtEnd","'ALL_COLLECTIONS' is defined but never used.","'Navbar' is defined but never used.","'SimpleSlider' is defined but never used.","'history' is assigned a value but never used.",{"desc":"502","fix":"503"},"no-global-assign","no-unsafe-negation",[1772,1772]," rel=\"noreferrer\"",[2028,2028],[2287,2287],[2547,2547],{"desc":"504","fix":"505"},{"desc":"506","fix":"507"},[1644,1644],[2086,2086],[2526,2526],[2966,2966],[3396,3396],[15962,15962],{"desc":"504","fix":"508"},"Update the dependencies array to be: [tawkToKey, tawkToPropertyId]",{"range":"509","text":"510"},"Update the dependencies array to be: [props]",{"range":"511","text":"512"},"Update the dependencies array to be: [props.settings.settings, props.settings.settingsAuth]",{"range":"513","text":"514"},{"range":"515","text":"512"},[617,622],"[tawkToKey, tawkToPropertyId]",[513,515],"[props]",[645,674],"[props.settings.settings, props.settings.settingsAuth]",[1276,1278]]