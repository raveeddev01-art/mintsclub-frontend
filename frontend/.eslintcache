awkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  useEffect(() => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n  \n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {\n              routes.map((route, index) => {\n                return (\n                  <PrivateRoute\n                    key={index}\n                    path={route.path}\n                    exact={route.exact}\n                    access={true}\n                    component={props =>\n                      <route.layout {...props} title={route.title}>\n                        <route.component {...props} />\n                      </route.layout>\n                    }\n                  />\n                )\n              })\n            }\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  )\n}\n\nexport default App\n","/Users/zain/Documents/projects/ariswap/frontend/src/serviceWorker.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/privateRoute.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/routes.js",["256","257","258"],"// layouts\nimport layout1 from './layouts/layout1/layout1';\nimport layout2 from './layouts/layout2/layout2';\nimport layout3 from './layouts/layout3/layout3';\nimport layout4 from './layouts/layout4/layout4';\n// components\n// import Home from './components/home/home';\nimport Dashboard from './Screens/Home/home'\nimport FourStepForm from './Screens/FourStepForm/index'\n// import ExploreAll from './components/explore/explore-all';\n// import LiveAuctions from './components/auctions/live-auctions-list';\n// import ItemDetails from './components/item-detail/item-detail';\n// import Activity from './components/activity/activity';\n// import Blog from './components/blog/blog';\n// import BlogSingle from './components/blog-single/blog-single';\n// import HelpCenter from './components/help-center/help-center';\n// import Authors from './components/authors-list/authors-list';\n// import Author from './components/author/author';\n// import Profile from './components/profile/profile';\n// import CreateNFT from './components/create-nft/create-nft';\n// import MyCollections from './components/collections/my-collections';\n// import CreateCollection from './components/create-collection/create-collection';\n// import CollectionDetails from './components/collections/collection-details';\n// import Wallet from './components/wallet/wallet';\n// import Signup from './components/signup/signup';\n// import Contact from './components/contact/contact';\n// import SellNFT from './components/nfts/sell-nft';\n// import NotFound from './components/not-found/not-found';\n// import HowItWorks from './components/how-it-works/how-it-works';\n// import PrivacyTerms from './components/privacy-&-terms/privacy-&-terms';\n\n// routes\nconst routes = [\n    { path: '/', access: true, exact: true, title: 'Home', layout: layout2, component: Dashboard },\n    { path: '/fourStepForm', access: true, exact: true, title: 'Explore', layout: layout2, component: FourStepForm },\n    // { path: '/explore-all', access: true, exact: true, title: 'Explore', layout: layout2, component: ExploreAll },\n    // { path: '/auctions', access: true, exact: true, title: 'Live Auctions', layout: layout2, component: LiveAuctions },\n    // { path: '/item-details', access: true, exact: true, title: 'Item Details', layout: layout2, component: ItemDetails },\n    // { path: '/sell-item/:itemId?', access: true, exact: true, title: 'Sell Item', layout: layout2, component: SellNFT },\n    // { path: '/activity', access: true, exact: true, title: 'Activity', layout: layout2, component: Activity },\n    // { path: '/blog', access: true, exact: true, title: 'Blog', layout: layout1, component: Blog },\n    // { path: '/blog-single', access: true, exact: true, title: 'Blog Single', layout: layout1, component: BlogSingle },\n    // { path: '/help-center', access: true, exact: true, title: 'Help Center', layout: layout1, component: HelpCenter },\n    // { path: '/authors', access: true, exact: true, title: 'Authors', layout: layout2, component: Authors },\n    // { path: '/author/:authorId?', access: true, exact: true, title: 'Author Profile', layout: layout1, component: Author },\n    // { path: '/profile', access: true, exact: true, title: 'Profile', layout: layout1, component: Profile },\n    // { path: '/create', access: true, exact: true, title: 'Create', layout: layout2, component: CreateNFT },\n    // { path: '/collections', access: true, exact: true, title: 'Collections', layout: layout2, component: MyCollections },\n    // { path: '/collection/create', access: true, exact: true, title: 'Create Collection', layout: layout2, component: CreateCollection },\n    // { path: '/collection-details/:collectionId?', access: true, exact: true, title: 'Collection Details', layout: layout1, component: CollectionDetails },\n    // { path: '/login', access: true, exact: true, title: 'login', layout: layout4, component: Wallet },\n    // { path: '/signup', access: true, exact: true, title: 'Signup', layout: layout4, component: Signup },\n    // { path: '/contact', access: true, exact: true, title: 'Contact', layout: layout1, component: Contact },\n    // { path: '/how-it-works', access: true, exact: true, title: 'How It Works', layout: layout1, component: HowItWorks },\n    // { path: '/privacy-and-terms', access: true, exact: true, title: 'Privacy & Terms', layout: layout1, component: PrivacyTerms },\n    // { path: '/*', access: true, exact: true, name: 'Not Found', layout: layout3, component: NotFound }\n];\n\nexport default routes;","/Users/zain/Documents/projects/ariswap/frontend/src/redux/index.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/gaTracker/gaTracket.js",["259"],"import { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport ReactGA from \"react-ga\";\nimport { connect } from \"react-redux\";\nimport { useSelector } from \"react-redux\";\n\n\n\nconst useGaTracker = () => {\n    const step=useSelector((state)=>state.dashboard.currentStep)\n    const location = useLocation();\n    const [initialized, setInitialized] = useState(false);\n\n    useEffect(() => {\n        if (!window.location.href.includes(\"localhost\")) {\n        ReactGA.initialize(\"UA-215431628-1\");\n        }\n        setInitialized(true);\n    }, []);\n\n    useEffect(() => {\n        if (initialized) {\n        \n            if(location.pathname === '/')\n            {\n\n                ReactGA.pageview(location.pathname + location.search );\n            }\n            else {\n                ReactGA.pageview(location.pathname + location.search + `/step${step}`);\n            }\n        }\n    }, [initialized, location, step]);\n};\n\nexport default useGaTracker;","/Users/zain/Documents/projects/ariswap/frontend/src/config/config.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/full-page-loader/full-page-loader.js",["260"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/index.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/Screens/Home/home.js",["261","262","263","264","265","266","267"],"/Users/zain/Documents/projects/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/home/home.reducer.js",["268","269"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/redux/reducer/reducer.js",["270"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  }\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n            \n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/Users/zain/Documents/projects/ariswap/frontend/src/components/collections/collections.reducer.js",["271"],"import { BEFORE_COLLECTION, GET_COLLECTION, SET_AUTH_STATE, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\n\nconst initialState = {\n    collection: null,\n    collections: null,\n    allCollections:null,\n    pagination: null,\n    deleteAuth: false,\n    upsertAuth: false,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload.collection,\n                getAuth: true\n            }\n            case ALL_COLLECTIONS:\n                return {\n                    ...state,\n                    collection: action.payload.allCollections,\n                    getAuth: true\n                }\n        case SET_AUTH_STATE:\n            return {\n                ...state,\n                getAuth: false\n            }\n\n        case UPSERT_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                upsertAuth: true\n            }\n        case DELETE_COLLECTION:\n            return {\n                ...state,\n                collection: action.payload,\n                deleteAuth: true\n            }\n        case GET_COLLECTIONS:\n            return {\n                ...state,\n                collections: action.payload.collections,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_COLLECTION:\n            return {\n                ...state,\n                collection: null,\n                collections: null,\n                pagination: null,\n                deleteAuth: false,\n                upsertAuth: false,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/nfts/nfts.reducer.js",["272"],"import { BEFORE_NFT, GET_NFTS, GET_NFT, UPSERT_NFT,NFTALL } from '../../redux/types';\n\nconst initialState = {\n    nftsData: {},\n    nftAll:{},\n    nftsAuth: false,\n    upsertAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case UPSERT_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                upsertAuth: true\n            }\n        case GET_NFT:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n            case NFTALL:\n        \n                return {\n                    ...state,\n                    nftAll: action.payload,\n                }\n            \n        case GET_NFTS:\n            return {\n                ...state,\n                nftsData: action.payload,\n                nftsAuth: true\n            }\n        case BEFORE_NFT:\n            return {\n                ...state,\n                nftsData: {},\n                nftsAuth: false,\n                upsertAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/user/user.reducer.js",["273"],"import { BEFORE_USER, SET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, GET_USER } from '../../redux/types';\n\nconst initialState = {\n    userData: null,\n    userAuth: false,\n    creatorsAuth: false,\n    topSellersAuth: false,\n    individualUserAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_USER:\n            return {\n                ...state,\n                userData: action.payload,\n                userAuth: true\n            }\n        case GET_USER:\n            return {\n                ...state\n            }\n        case SET_CREATORS:\n            return {\n                ...state,\n                creators: action.payload,\n                creatorsAuth: true\n            }\n        case TOP_SELLERS:\n            return {\n                ...state,\n                sellers: action.payload,\n                topSellersAuth: true\n            }\n        case SET_INDIVIDUAL_USER:\n            return {\n                ...state,\n                individualUser: action.payload,\n                individualUserAuth: true\n            }\n        case BEFORE_USER:\n            return {\n                ...state,\n                userData: null,\n                userAuth: false,\n                creatorsAuth: false,\n                topSellersAuth: false,\n                individualUserAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/faq/faq.reducer.js",["274"],"import { BEFORE_FAQ, GET_FAQS } from '../../redux/types';\n\nconst initialState = {\n    faqs: null,\n    faqsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FAQS:\n            return {\n                ...state,\n                faqs: action.payload,\n                faqsAuth: true\n            }\n        case BEFORE_FAQ:\n            return {\n                ...state,\n                faqs: null,\n                faqsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/footer/footer.reducer.js",["275"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/bids/bids.reducer.js",["276"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            return {\n                ...state,\n                bids: action.payload.bids,\n                pagination: action.payload.pagination,\n                highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/contact/contact.reducer.js",["277"],"import { BEFORE_CONTACT, CREATE_CONTACT } from '../../redux/types';\n\nconst initialState = {\n    contactAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case CREATE_CONTACT:\n            return {\n                ...state,\n                contactAuth: true\n            }\n        case BEFORE_CONTACT:\n            return {\n                ...state,\n                contactAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/categories/categories.reducer.js",["278"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/auctions/auctions.reducer.js",["279"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/offers/offers.reducer.js",["280"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/wallet/wallet.reducer.js",["281"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/redux/shared/error/error.reducer.js",["282"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/Users/zain/Documents/projects/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/Users/zain/Documents/projects/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/Users/zain/Documents/projects/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],"/Users/zain/Documents/projects/ariswap/frontend/src/redux/types.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/redux/types/types.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/redux/actions/actions.js",["283","284"],"import { toast } from \"react-toastify\";\nimport Web3 from \"web3\";\nimport {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  // DEPLOY_CONTRACT,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n} from \"../types/types\";\n\n\nimport { ENV } from \"../../config/config\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport axios from \"axios\";\nimport dotenv from \"dotenv\";\nexport const currentStepAction = () => (dispatch) => {\n  // alert(\"called\")\n  \n  dispatch({\n    type: CURRENT_STEP,\n  });\n};\nexport const currentStepDecrement = () => (dispatch) => {\n  dispatch({\n    type: CURRENT_STEP_DECREMENT,\n  });\n};\nexport const clearCurrentStep = () => (dispatch) => {\n  dispatch({\n    type: CLEAR_CURRENT_STEP,\n  });\n};\n\nexport const contractResponse = () => (dispatch) => {\n  dispatch({\n    type: CONTRACT_REPONSE,\n  });\n};\n\nexport const deployContract = (data, address, supply) => (dispatch) => {\n  // dispatch({\n  //   type: CONNECT_WELLET,\n  //   payload: address,\n  // });\n\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/createUser`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then(\n      (res) => {\n        // console.log(res, \"response from backendfdkfd\");\n        const abi = res.data.data.abi;\n        if (res.data.status === true) {\n          let metaDataList = [];\n          for (let i = 1; i <= supply; i++) {\n            metaDataList.push(res.data.data.metaData);\n            dispatch({\n              type: SET_CONTRACT_INFO,\n              payload: res.data,\n            });\n          }\n\n          try {\n            const web3 = new Web3(Web3.givenProvider);\n            // const gasPrice = \"5000000\";\n            let contract = new web3.eth.Contract(abi, null, {\n              data: res.data.data.bytecode,\n\n              from: address,\n              // gas: 4600000,\n            });\n            contract\n              .deploy({\n                data: res.data.data.bytecode,\n                arguments: [res.data.data.name, res.data.data.symbol],\n              })\n              .send({\n                from: address,\n                // gas: gasPrice,\n              })\n              .then((contractInstance) => {\n                toast.success(\"Contract Deployed Successfully!\");\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n\n                let info = {\n                  ...res.data,\n                  contractAddress: contractInstance.options.address,\n                };\n                dispatch({\n                  type: SET_CONTRACT_INFO,\n                  payload: {\n                    data: { ...info },\n                  },\n                });\n                dispatch({\n                  type: CONTRACT_ADDRESS,\n                  payload: contractInstance.options.address,\n                });\n                const contractData = {\n                  contractadd: contractInstance.options.address,\n                  Network: \"Etherium\",\n                  Deployed: true,\n                };\n\n                dispatch({\n                  type: CONTRACT_REPONSE,\n                  payload: contractData,\n                });\n              })\n              .catch((err) => {\n                // console.log(\"error\", err);\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n                toast.error(\"Transaction Failed please check wallet history!\");\n              });\n          } catch (err) {\n            dispatch({\n              type: LOADER,\n              payload: false,\n            });\n            toast.error(\"Transaction Failed please check wallet history!\");\n          }\n        } else {\n          dispatch({\n            type: LOADER,\n            payload: false,\n          });\n          // console.log(res, \"dkfjdkfjkdjfkd\");\n          toast.error(res.data.data);\n\n          // dispatch({\n          //   type: CONTRACT_REPONSE,\n          //   payload: res.data,\n          // });\n        }\n        // console.log(res);\n      },\n      (error) => {\n        console.log(error,\"error handle\")\n        toast.error(error.response.data.data);\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        // console.log(error, \"error==dfjdkf\");\n        dispatch({\n          type: CONTRACT_ERROR_MESSAGE,\n          payload: error,\n        });\n        // alert(\"contract response\")\n        // dispatch({\n        //   type: CONTRACT_REPONSE,\n        //   payload: error,\n        // });\n        // resolve(error)\n      }\n    )\n    .catch((err) => {\n      console.log(err, \"error later==>\");\n    });\n};\n\nexport const mintToken = (data, address, supply, email) => (dispatch) => {\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n  // console.log('here is data', data)\n  dispatch({\n    type: CONNECT_WELLET,\n    payload: address,\n  });\n  let metaDataList = [];\n  // console.log(data, \"data=====>\");\n  let metaData = \"\";\n  if (!data.data) {\n    metaData = data;\n  } else {\n    metaData = data.data.metaData;\n  }\n\n  for (let i = 1; i <= supply; i++) {\n    metaDataList.push(metaData);\n  }\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n  // console.log(\"metaDataList\", metaDataList);\n\n  try {\n    const web3 = new Web3(Web3.givenProvider);\n    // console.log('web3', web3);\n    const contractM = new web3.eth.Contract(\n      data.data.abi,\n      data.contractAddress\n    );\n    // console.log(\"metaDataList\", metaDataList);\n    contractM.methods\n      .batchMint(address, metaDataList, supply)\n      .send({\n        from: address,\n        // gas: 5000000,\n      })\n      .then((response) => {\n        // console.log(response, \"res of createNFT===>\");\n        handleEmailRequest(email);\n        let count = localStorage.getItem(address);\n        if (count) {\n          console.log(typeof (+count*1),\"issueee\")\n          localStorage.setItem(address, (+count*1) + 1);\n        } else {\n          localStorage.setItem(address, 1);\n        }\n        toast.success(\"Minting Successful\");\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        dispatch({\n          type: TOKEN_ID,\n          payload: response,\n        });\n        dispatch({\n          type: MINTING_RESPONSE,\n          payload: response,\n        });\n      })\n      .catch((err) => {\n        console.log(err, \"error==>\");\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        toast.error(\"Transaction Failed please check wallet history!\");\n      });\n  } catch (err) {\n    dispatch({\n      type: LOADER,\n      payload: false,\n    });\n    toast.error(\"Transaction Failed please check wallet history!\");\n  }\n};\nconst handleEmailRequest = (email) => {\n  let data = {\n    email,\n  };\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/addEmail`;\n  // console.log(url);\n  axios\n    .post(url,data, config)\n    .then((res) => {\n      // console.log(res, \"email response==>\");\n    })\n    .catch((err) => console.log(err));\n};\nexport const setContractInfo = () => (dispatch) => {\n  dispatch({\n    type: SET_CONTRACT_INFO,\n  });\n};\n\nexport const connectWallet = () => (dispatch) => {\n  connectMetamaskCopy()\n    .then((address) =>\n      // console.log(address,\"address\"),\n      dispatch({\n        type: CONNECT_WELLET,\n        payload: address,\n      })\n    )\n    .catch((err) => console.log(err, \"error\"));\n};\n\nexport const hometest = () => (dispatch) => {\n  // dispatch({\n  // type:HOME_TEST,\n  // payload: data\n  // })\n  // dispatch(emptyError());\n  // const url = `${ENV.url}/nfts/${type}`;\n  // fetch(url, {\n  // method,\n  // headers: {\n  // 'Authorization': ENV.Authorization,\n  // 'x-auth-token': ENV.x_auth_token,\n  // 'Access-Control-Allow-Origin': '*',\n  // 'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  // },\n  // body\n  // }).then(res => res.json()).then(data => {\n  // if (data.success) {\n  // toast.success(data.message)\n  // dispatch({\n  // type: UPSERT_NFT,\n  // payload: data\n  // })\n  // } else {\n  // toast.error(data.message)\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: data\n  // })\n  // }\n  // }).catch(error => {\n  // if (error.response && error.response.data) {\n  // const { data } = error.response\n  // if (data.message)\n  // toast.error(data.message)\n  // }\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: error\n  // })\n  // })\n};\n","/Users/zain/Documents/projects/ariswap/frontend/src/utils/web3.js",["285","286"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/Navbar/navbar.js",["287","288","289","290","291","292","293","294","295"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/Slider/slider.js",["296","297","298"],"/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step2/Step2.js",["299","300","301","302"],"/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step1/Step1.js",["303","304","305"],"import { useState } from \"react\";\nimport \"./Step1.css\";\n// import { RiFolderUploadLine} from \"react-icons/ri\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport { BsImageFill } from \"react-icons/bs\";\nimport uploadIcon from \"../../../../assets/images/uploadIcon.png\";\nimport { connect } from \"react-redux\";\nimport { BsUpload } from \"react-icons/bs\";\nimport { MdClose } from \"react-icons/md\";\nimport { IconButton } from \"@mui/material\";\n\nconst Step1 = (props) => {\n  const [file, setFile] = useState(\"\");\n  const [img, setImage] = useState(props.imageURl);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [videoUrl, setVideoUrl] = useState(props.videoURL);\n  // console.log(process.env,\"config.baseurl===>\")\n\n  const onFileChange = (event) => {\n    setErrorMessage(\"\");\n\n    if (event.target.files[0]) {\n      // console.log(event.target.files[0], \"event.target.files[0]==>\");\n\n      let type = event.target.files[0].type;\n      // console.log(type,\"typee\")\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\"\n      ) {\n        let fileSize = formatBytes(event.target.files[0].size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          setErrorMessage(\"File size limit is exceeded\");\n        } else {\n          let url = URL.createObjectURL(event.target.files[0]);\n          if (event.target.files[0].type === \"video/mp4\") {\n            setVideoUrl(url);\n            setImage(\"\");\n          } else {\n            setImage(url);\n            setVideoUrl(\"\");\n            // console.log(formatBytes(event.target.files[0].size).split(' ') ,\"event.target.files[0]==>\")\n            setFile(event.target.files[0]);\n          }\n        }\n        if (\n          type === \"image/jpeg\" ||\n          type === \"image/png\" ||\n          type === \"image/gif\" ||\n          type === \"video/mp4\"\n        ) {\n          let fileSize = formatBytes(event.target.files[0].size).split(\" \");\n          if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n            setErrorMessage(\"File size limit is exceeded\");\n          } else {\n            let url = URL.createObjectURL(event.target.files[0]);\n            if (event.target.files[0].type === \"video/mp4\") {\n              setVideoUrl(url);\n              setImage(\"\");\n            } else {\n              setImage(url);\n              setVideoUrl(\"\");\n              // console.log(formatBytes(event.target.files[0].size).split(' ') ,\"event.target.files[0]==>\")\n              setFile(event.target.files[0]);\n            }\n          }\n        } else {\n          setErrorMessage(\"File not supported!\");\n        }\n      } else {\n        setErrorMessage(\"File not supported!\");\n      }\n    }\n  };\n  function formatBytes(bytes, decimals = 2) {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  }\n\n  // On file upload (click the upload button)\n  const onFileUpload = () => {\n    if (img === \"\" && videoUrl === \"\") {\n      setErrorMessage(\"Please upload a file\");\n      return \"\";\n    }\n    // console.log(file);\n    props.handleStep1Info(file, videoUrl, img);\n    props.currentStepAction();\n  };\n  const dragOver = (e) => {\n    e.preventDefault();\n  };\n\n  const dragEnter = (e) => {\n    e.preventDefault();\n  };\n\n  const dragLeave = (e) => {\n    e.preventDefault();\n  };\n  const onDrop = (e) => {\n    e.preventDefault();\n    setErrorMessage(\"\");\n    const files = e.dataTransfer.files[0];\n    if (files) {\n      const type = e.dataTransfer.files[0].type;\n      console.log(files);\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\"\n      ) {\n        let fileSize = formatBytes(files.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          setErrorMessage(\"File size limit is exceeded\");\n        } else {\n          let url = URL.createObjectURL(files);\n          if (files.type === \"video/mp4\") {\n            setVideoUrl(url);\n            setImage(\"\");\n          } else {\n            setImage(url);\n            setVideoUrl(\"\");\n            // console.log(formatBytes(e.target.files[0].size).split(' ') ,\"e.target.files[0]==>\")\n            setFile(files);\n          }\n        }\n      } else {\n        setErrorMessage(\"File not supported!\");\n      }\n    }\n  };\n\n  const removeVideo = (event) => {\n    event.preventDefault();\n    event.stopPropagation();\n    setVideoUrl(\"\");\n  };\n\n  const removeImage = (event) => {\n    event.preventDefault();\n    event.stopPropagation();\n    setImage(\"\");\n  };\n\n  // console.log(props,\"props==>\")\n  return (\n    <div className=\"\">\n      <p className=\"text-white upload-img-title mb-1\">Upload Asset</p>\n      <p\n        className=\"text-white testingkkk \"\n        style={{ fontSize: \"14px\", padding: \"0rem\", margin: \"0rem\" }}\n      >\n        File type supported:JPEG/PNG/GIF/MP4 max size 100 MB.{\" \"}\n      </p>\n      {videoUrl && (\n        <div className=\"position-relative\" style={{width:\"210px\"}}>\n        <video className=\"mt-4\" width=\"210\" controls>\n          <source src={videoUrl} />\n        </video>\n          <MdClose\n                  color=\"#e33d0bc2\"\n                  className=\"\"\n                  onClick={removeVideo}\n                  style={{\n                    fontSize: \"2.5rem\",\n                    cursor: \"pointer\",\n                    top: \"28px\",\n                    right:\"4px\",\n                    position: \"absolute\",\n                    zIndex: 99,\n                  }}\n                />\n        </div>\n        \n      )}\n      <p style={{ color: \"red\" }}>{errorMessage && errorMessage}</p>\n      {!img ? (\n        <>\n          {!videoUrl && !img && (\n            <label\n              className=\"text-center d-flex mt-2\"\n              style={{ cursor: \"pointer\", width: \"14vw\" }}\n            >\n              <div\n                className=\"file-container text-white d-flex justify-content-center align-items-center mt-2 mb-5\"\n                onDrop={(e) => onDrop(e)}\n                onDragOver={(e) => dragOver(e)}\n                onDragEnter={(e) => dragEnter(e)}\n                onDragLeave={(e) => dragLeave(e)}\n              >\n                <div\n                  className=\"d-flex h-100 justify-content-center align-items-center \"\n                  style={{ flexDirection: \"column\", cursor: \"pointer\" }}\n                >\n                  {/* <RiFolderUploadLine className=\"upload-icon\" /> */}\n                  <img className=\"upload-icon mb-3\" src={uploadIcon} />\n\n                  <p\n                    style={{\n                      color: \"#aaabab\",\n                      fontSize: \"14px\",\n                      margin: \"0rem\",\n                    }}\n                  >\n                    Add photo or video <br /> or Drag and drop\n                  </p>\n                  <input\n                    type=\"file\"\n                    style={{ display: \"none\" }}\n                    onChange={onFileChange}\n                    accept=\".mp4, .png,.jpeg\"\n                  />\n                </div>\n              </div>\n            </label>\n          )}\n          {videoUrl && (\n            <div\n              onDrop={(e) => onDrop(e)}\n              onDragOver={(e) => dragOver(e)}\n              onDragEnter={(e) => dragEnter(e)}\n              onDragLeave={(e) => dragLeave(e)}\n     \n            >\n              <label>\n              \n                <div\n                  className=\"d-flex align-items-center justify-content-center mb-3\"\n                  style={{\n                    backgroundColor: \"#001d43\",\n                    width: \"13.2rem\",\n                    height: \"3rem\",\n                    borderRadius: \"10px\",\n                    cursor: \"pointer\",\n                  }}\n                >\n                  <BsUpload style={{ fontSize: \"1.4rem\", color: \"white\" }} />\n                </div>\n                <input\n                  type=\"file\"\n                  style={{ display: \"none\" }}\n                  onChange={onFileChange}\n                  accept=\".mp4, .png,.jpeg\"\n                  onDrop={(e) => onFileChange(e)}\n                  onDragOver={(e) => onFileChange(e)}\n                  onDragEnter={(e) => onFileChange(e)}\n                  onDragLeave={(e) => onFileChange(e)}\n                />\n              </label>\n            </div>\n          )}\n        </>\n      ) : (\n        <div\n          className=\"text-white d-flex  mt-4 mb-5\"\n          style={{ cursor: \"pointer\" }}\n          onDrop={(e) => onDrop(e)}\n          onDragOver={(e) => dragOver(e)}\n          onDragEnter={(e) => dragEnter(e)}\n          onDragLeave={(e) => dragLeave(e)}\n        >\n          <label className=\"text-center position-relative label-parent\">\n            <MdClose\n              color=\"#e33d0bc2\"\n              className=\"\"\n              onClick={removeImage}\n              style={{\n                fontSize: \"2.5rem\",\n                cursor: \"pointer\",\n                top: 0,\n                right: 0,\n                position: \"absolute\",\n                zIndex: 99,\n              }}\n            />\n            <img\n              className=\"selected-file \"\n              src={img}\n              alt=\"uploaded image\"\n              style={{ cursor: \"pointer\" }}\n            />\n\n            <BsImageFill\n              className=\"position-absolute upload-img-icon\"\n              style={{ fontSize: \"1.2rem\", cursor: \"pointer\" }}\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n            />\n          </label>\n        </div>\n      )}\n\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary start-btn mt-5 mb-5\"\n        onClick={() => onFileUpload()}\n      >\n        Next\n      </button>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step1);\n","/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/Step3.js",["306","307","308","309","310","311"],"/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step4/Step4.js",["312","313","314","315","316","317","318","319","320"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/footer/footer.js",["321","322","323","324","325","326","327"],"import { useEffect, useState } from 'react';\nimport { Link } from 'react-router-dom';\nimport logo from '../../assets/images/logo.png'\nimport { connect } from 'react-redux'\nimport { getFooter } from './footer.action'\nimport {ENV} from './../../config/config';\n\nconst Footer = (props) => {\n\n    const [data, setData] = useState({\n        facebook: '',\n        twitter: '',\n        instagram: '',\n        youtube: '',\n        vine: '',\n        desc: ''\n    })\n\n    useEffect(() => {\n        props.getFooter()\n    }, [])\n\n    useEffect(() => {\n        if (props.settings.settingsAuth) {\n            setData(props.settings.settings)\n        }\n    }, [props.settings.settingsAuth])\n\n    return (\n        <footer className=\"footer-area\">\n            {/* Footer Top */}\n            <div className=\"footer-top\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Logo */}\n                                <Link className=\"navbar-brand\" to=\"/\">\n                                    <img src={logo} alt=\"\" />\n                                </Link>\n                                <p>{data.desc}</p>\n                                {/* Social Icons */}\n                                <div className=\"social-icons d-flex\">\n                                    {\n                                        data.facebook ?\n                                            <a href={data.facebook} target=\"_blank\">\n                                                <i className={\"fab fa-facebook-f\"} />\n                                                <i className={\"fab fa-facebook-f\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.twitter ?\n                                            <a href={data.twitter} target=\"_blank\">\n                                                <i className={\"fab fa-twitter\"} />\n                                                <i className={\"fab fa-twitter\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.instagram ?\n                                            <a href={data.instagram} target=\"_blank\">\n                                                <i className={\"fab fa-instagram\"} />\n                                                <i className={\"fab fa-instagram\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.youtube ?\n                                            <a href={data.youtube} target=\"_blank\">\n                                                <i className={\"fab fa-youtube\"} />\n                                                <i className={\"fab fa-youtube\"} />\n                                            </a> : ''\n                                    }\n\n                                    {\n                                        data.vine ?\n                                            <a href={data.vine} target=\"_blank\">\n                                                <i className={\"fab fa-vine\"} />\n                                                <i className={\"fab fa-vine\"} />\n                                            </a> : ''\n                                    }\n\n\n\n\n\n                                </div>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Useful Links\"}</h4>\n                                <ul>\n                                    <li><Link to=\"/explore-all\">All NFTs</Link></li>\n                                    <li><Link to=\"/how-it-works\">How It Works</Link></li>\n                                    <li><Link to=\"/create\">Create</Link></li>\n                                    <li><Link to=\"/privacy-and-terms\">Privacy & Terms</Link></li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3 res-margin\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Community\"}</h4>\n                                <ul>\n                                    <li><Link to=\"/help-center\">Help Center</Link></li>\n                                    <li><Link to=\"/contact\">Contact</Link></li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 col-lg-3\">\n                            {/* Footer Items */}\n                            <div className=\"footer-items\">\n                                {/* Footer Title */}\n                                <h4 className=\"footer-title\">{\"Subscribe Us\"}</h4>\n                                {/* Subscribe Form */}\n                                <div className=\"subscribe-form d-flex align-items-center\">\n                                    <input type=\"email\" className=\"form-control\" placeholder=\"info@yourmail.com\" />\n                                    <button type=\"submit\" className=\"btn\"><i className=\"icon-paper-plane\" /></button>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            {/* Footer Bottom */}\n            <div className=\"footer-bottom\">\n                <div className=\"container\">\n                    <div className=\"row\">\n                        <div className=\"col-12\">\n                            {/* Copyright Area */}\n                            <div className=\"copyright-area d-flex flex-wrap justify-content-center justify-content-sm-between text-center py-4\">\n                                {/* Copyright Left */}\n                                <div className=\"copyright-left\">©2021 {ENV.appName}, All Rights Reserved.</div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </footer>\n    );\n}\n\nconst mapStateToProps = state => ({\n    error: state.error,\n    settings: state.settings\n});\n\n\nexport default connect(mapStateToProps, { getFooter })(Footer);","/Users/zain/Documents/projects/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/header/header.js",["328","329","330","331","332","333","334"],"import React, { useState, useEffect } from 'react';\nimport { Link, useHistory } from 'react-router-dom';\nimport { connect } from 'react-redux';\nimport { setWalletAddress, getWalletAddress } from '../wallet/wallet.action'\nimport { connectMetamaskCopy } from '../../utils/web3'\nimport { logoutUser } from '../user/user.action';\nimport { ENV } from './../../config/config';\n\nconst Header = (props) => {\n    const history = useHistory();\n    // console.log(\"history\", history);\n    const [connectedAddress, setConnectedAddress] = useState('');\n    const [loader, setLoader] = useState(true);\n    const { _id } = ENV.getUserKeys('_id');\n\n    useEffect(async () => {\n        // COMMENTED TEMPORARILY\n        // METHOD 1\n        // props.getWalletAddress()\n\n        // METHOD 2 - a\n        // let connectedAddress = await connectMetamask();\n        // setConnectedAddress(connectedAddress)\n\n        // METHOD 3\n        // if (localStorage.getItem('wa')) {\n        //     let connectedAddress = window.atob(localStorage.getItem('wa'))\n        //     setConnectedAddress(connectedAddress)\n        // }\n\n        // METHOD 4\n        let connectedAddress = await connectMetamaskCopy();\n        setConnectedAddress(connectedAddress)\n        props.setWalletAddress(connectedAddress)\n    }, [])\n\n    // set loader to false when address is received\n    useEffect(() => {\n        if (connectedAddress)\n            setLoader(false)\n    }, [connectedAddress])\n\n    // COMMENTED TEMPORARILY\n    // METHOD 2 - b\n    // useEffect(() => {\n    //     if (props.wallet.walletAuth) {\n    //         const { connectedAddress } = props.wallet\n    //         setConnectedAddress(connectedAddress)\n    //     }\n    // }, [props.wallet.walletAuth])\n    const formatAddress = (address) => {\n        return address ? address.substr(0, 6) + '...' + address.substr(-4) : null;\n    }\n    const logoutUser = () => {\n        props.logoutUser();\n        history.push('/login');\n    }\n    \n    return (\n        <header id=\"header\">\n            {/* Navbar */}\n            <nav data-aos=\"zoom-out\" data-aos-delay={800} className=\"navbar navbar-expand\">\n                <div className=\"container header\">\n                    {/* Navbar Brand*/}\n                    <Link className=\"navbar-brand\" to=\"/\">\n                        <img className=\"navbar-brand-sticky\" src=\"/img/new_logo.jpeg\" alt=\"sticky brand-logo\" />\n                    </Link>\n                    <div className=\"ml-auto\" />\n                    {/* Navbar */}\n                    <ul className=\"navbar-nav items mx-auto\">\n                        <li className=\"nav-item dropdown\">\n                            <Link className=\"nav-link\" to=\"/\">Home</Link>\n                        </li>\n                        <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\">Explore <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><Link to=\"/explore-all\" className=\"nav-link\">Explore</Link></li>\n                                <li className=\"nav-item\"><Link to=\"/auctions\" className=\"nav-link\">Live Auctions</Link></li>\n                                {/* <li className=\"nav-item\"><Link to=\"/item-details\" className=\"nav-link\">Item Details</Link></li> */}\n                            </ul>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/activity\" className=\"nav-link\">Activity</Link>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/collections\" className=\"nav-link\">Collections</Link>\n                        </li>\n                        {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Community <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/blog\" className=\"nav-link\">Blog</a></li>\n                                <li className=\"nav-item\"><a href=\"/blog-single\" className=\"nav-link\">Blog Single</a></li>\n                                <li className=\"nav-item\"><a href=\"/help-center\" className=\"nav-link\">Help Center</a></li>\n                            </ul>\n                        </li> */}\n                        {/* <li className=\"nav-item dropdown\">\n                            <a className=\"nav-link\" href=\"#\">Pages <i className=\"fas fa-angle-down ml-1\" /></a>\n                            <ul className=\"dropdown-menu\">\n                                <li className=\"nav-item\"><a href=\"/authors\" className=\"nav-link\">Authors</a></li>\n                                <li className=\"nav-item\"><a href=\"/author\" className=\"nav-link\">Author</a></li>\n                                <li className=\"nav-item\"><a href=\"/wallet-connect\" className=\"nav-link\">Wallet Connect</a></li>\n                                <li className=\"nav-item\"><a href=\"/create\" className=\"nav-link\">Create</a></li>\n                                <li className=\"nav-item\"><a href=\"/login\" className=\"nav-link\">Login</a></li>\n                                <li className=\"nav-item\"><a href=\"/signup\" className=\"nav-link\">Signup</a></li>\n                            </ul>\n                        </li> */}\n                        <li className=\"nav-item\">\n                            <Link to=\"/contact\" className=\"nav-link\">Contact</Link>\n                        </li>\n                        <li className=\"nav-item\">\n                            <Link to=\"/history\" className=\"nav-link\">History</Link>\n                        </li>\n                    </ul>\n                    {/* Navbar Icons */}\n                    <ul className=\"navbar-nav icons\">\n                        <li className=\"nav-item\">\n                            <a href=\"#\" className=\"nav-link\" data-toggle=\"modal\" data-target=\"#search\">\n                                <i className=\"fas fa-search\" />\n                            </a>\n                        </li>\n                    </ul>\n                    {/* Navbar Toggler */}\n                    <ul className=\"navbar-nav toggle\">\n                        <li className=\"nav-item\">\n                            <a href=\"#\" className=\"nav-link\" data-toggle=\"modal\" data-target=\"#menu\">\n                                <i className=\"fas fa-bars toggle-icon m-0\" />\n                            </a>\n                        </li>\n                    </ul>\n                    {/* Navbar Action Button */}\n                    <ul className=\"navbar-nav action\">\n                        <li className=\"nav-item ml-3\">\n                            {\n                                connectedAddress && _id ?\n                                    <button className=\"btn ml-lg-auto btn-bordered-white\" onClick={logoutUser}><i className=\"icon-logout mr-md-2\" /> Logout</button>\n                                    // <span id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />{formatAddress(connectedAddress)}</span>\n                                    :\n                                    <Link to=\"/login\" id=\"wallet-address\" className=\"btn ml-lg-auto btn-bordered-white\"><i className=\"icon-wallet mr-md-2\" />Login</Link>\n                            }\n\n                        </li>\n                    </ul>\n                </div>\n            </nav>\n        </header>\n    );\n};\n\nconst mapStateToProps = state => ({\n    wallet: state.wallet\n});\nexport default connect(mapStateToProps, { setWalletAddress, getWalletAddress, logoutUser })(Header);\n","/Users/zain/Documents/projects/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/footer/footer.action.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["335"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/user/user.action.js",["336"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport { GET_ERRORS, SET_USER, GET_USER, SET_CREATORS, TOP_SELLERS, SET_INDIVIDUAL_USER, BEFORE_USER } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { getCollections, setAuthState } from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n    return {\n        type: BEFORE_USER\n    }\n}\n\n// method to set user data\nexport const setUser = (user) => dispatch => {\n    dispatch(emptyError())\n    dispatch({\n        type: SET_USER,\n        payload: user\n    })\n}\n\n// method to get user data\nexport const getUser = () => dispatch => {\n    dispatch({\n        type: GET_USER\n    })\n}\n\n// method to login using wallet address and sign\nexport const login = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/login/`;\n    // const url = `http://localhost:5000/v1/front/auth/login/`;\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            const userId = data.data._id;\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}auth/register/`;\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'Access-Control-Allow-Origin': '*',\n            'x-auth-token': ENV.x_auth_token\n        },\n        body: JSON.stringify(payload)\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch(getCollections());\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/`;\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            ENV.encryptUserData(data.data);\n            dispatch({\n                type: SET_USER,\n                payload: data.data\n            })\n            toast.success(data.message)\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getTopSellers = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/top-sellers`;\n    // const url = `http://3.142.91.8/v1/front/users/top-sellers`;\n    // console.log(url,\"testing url in top sellers\")\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        // console.log(\"data====>\",data);\n        if (data.status) {\n            dispatch({\n                type: TOP_SELLERS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        // console.log(\"errors===>\");\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getCreators = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/creators`;\n    // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n    \n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        // console.log(data,\"creators data===>}}}\");\n        if (data.status) {\n            dispatch({\n                type: SET_CREATORS,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}users/${userId}`;\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.status) {\n            dispatch({\n                type: SET_INDIVIDUAL_USER,\n                payload: data.data\n            })\n        } else {\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(errors => {\n        dispatch({\n            type: GET_ERRORS,\n            payload: errors\n        })\n    })\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => dispatch => {\n    dispatch(emptyError());\n    dispatch({\n        type: SET_INDIVIDUAL_USER,\n        payload: user\n    })\n};\n\nexport const logoutUser = () => (dispatch) => {\n    dispatch({\n        type: SET_USER,\n        userAuth: false,\n        userData: null\n    })\n    dispatch(setAuthState())\n    localStorage.removeItem('encuse');\n}","/Users/zain/Documents/projects/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["337","338"],"/Users/zain/Documents/projects/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["339","340"],"/Users/zain/Documents/projects/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/components/collections/collections.actions.js",["341"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_COLLECTION, SET_AUTH_STATE, GET_COLLECTION, GET_COLLECTIONS, UPSERT_COLLECTION, DELETE_COLLECTION, ALL_COLLECTIONS } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\n\nexport const beforeCollection = () => {\n    return {\n        type: BEFORE_COLLECTION\n    }\n}\n\nexport const getCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}collection/get/${collectionId}`;\n \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getCollections = (qs = null) => dispatch => {\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs)\n        url += `?${qs}`\n\n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n      \n        if (data.success) {\n            dispatch({\n                type: GET_COLLECTIONS,\n                payload: data.data\n            })\n         \n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        // console.log(error,\"all collections error\");\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const upsertCollection = (apiURL, body, method = 'POST') => dispatch => {\n\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n   \n    // const url = `http://localhost:5000/v1/front/${apiURL}`;\n\n\n    fetch(url, {\n        method,\n        headers: {\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: UPSERT_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteCollection = (collectionId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}collection/delete/${collectionId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_COLLECTION,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const setAuthState = () => (dispatch) => {\n    dispatch({\n        type: SET_AUTH_STATE,\n    })\n}","/Users/zain/Documents/projects/ariswap/frontend/src/utils/exportData.js",[],"/Users/zain/Documents/projects/ariswap/frontend/src/Screens/FourStepForm/infoComp.js",[],{"ruleId":"342","severity":1,"message":"343","line":6,"column":8,"nodeType":"344","messageId":"345","endLine":6,"endColumn":17},{"ruleId":"346","severity":1,"message":"347","line":19,"column":6,"nodeType":"348","endLine":19,"endColumn":11,"suggestions":"349"},{"ruleId":"342","severity":1,"message":"350","line":2,"column":8,"nodeType":"344","messageId":"345","endLine":2,"endColumn":15},{"ruleId":"342","severity":1,"message":"351","line":4,"column":8,"nodeType":"344","messageId":"345","en