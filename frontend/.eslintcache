config' is assigned a value but never used.","'network' is assigned a value but never used.","'accounts' is assigned a value but never used.","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","'WordsFamousNfts' is defined but never used.","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","'linkError' is assigned a value but never used.","'httpValidation' is assigned a value but never used.","no-useless-escape","Unnecessary escape character: \\+.","Literal","unnecessaryEscape",["398","399"],["400","401"],"'IconButton' is defined but never used.","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'Typography' is defined but never used.","'ListItemText' is defined but never used.","'Box' is defined but never used.","'setCaptchaMessage' is assigned a value but never used.","'setDeployNetwork' is assigned a value but never used.","'deploy' is assigned a value but never used.","'setMaxLimit' is assigned a value but never used.","react/jsx-no-duplicate-props","No duplicate props allowed","JSXAttribute","noDuplicateProps","React Hook useEffect has a missing dependency: 'props'. Either include it or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["402"],"React Hook useEffect has a missing dependency: 'props.settings.settings'. Either include it or remove the dependency array. If 'setData' needs the current value of 'props.settings.settings', you can also switch to useReducer instead of useState and read 'props.settings.settings' in the reducer.",["403"],"react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"404","text":"405"},{"range":"406","text":"405"},{"range":"407","text":"405"},{"range":"408","text":"405"},{"range":"409","text":"405"},"'loader' is assigned a value but never used.","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression",["410"],"'formatAddress' is assigned a value but never used.","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","'genStyle' is assigned a value but never used.","'userId' is assigned a value but never used.","'errorMessage' is assigned a value but never used.","array-callback-return","Array.prototype.map() expects a value to be returned at the end of arrow function.","expectedAtEnd","'ALL_COLLECTIONS' is defined but never used.",{"desc":"411","fix":"412"},{"messageId":"413","fix":"414","desc":"415"},{"messageId":"416","fix":"417","desc":"418"},{"messageId":"413","fix":"419","desc":"415"},{"messageId":"416","fix":"420","desc":"418"},{"desc":"421","fix":"422"},{"desc":"423","fix":"424"},[1644,1644]," rel=\"noreferrer\"",[2086,2086],[2526,2526],[2966,2966],[3396,3396],{"desc":"421","fix":"425"},"Update the dependencies array to be: [tawkToKey, tawkToPropertyId]",{"range":"426","text":"427"},"removeEscape",{"range":"428","text":"429"},"Remove the `\\`. This maintains the current functionality.","escapeBackslash",{"range":"430","text":"431"},"Replace the `\\` with `\\\\` to include the actual backslash character.",{"range":"432","text":"429"},{"range":"433","text":"431"},"Update the dependencies array to be: [props]",{"range":"434","text":"435"},"Update the dependencies array to be: [props.settings.settings, props.settings.settingsAuth]",{"range":"436","text":"437"},{"range":"438","text":"435"},[612,617],"[tawkToKey, tawkToPropertyId]",[2538,2539],"",[2538,2538],"\\",[2581,2582],[2581,2581],[513,515],"[props]",[645,674],"[props.settings.settings, props.settings.settingsAuth]",[1276,1278]]