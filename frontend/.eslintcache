d/src/components/wallet/wallet.js",["588","589","590","591","592","593"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/contact/contact.js",["594"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/nfts/sell-nft.js",["595","596","597","598","599","600","601","602","603","604","605","606","607","608"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/shared/error/error.reducer.js",["609"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/item-detail/item-detail.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/blog/blog.js",["610","611"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/activity/activity.js",["612"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/help-center/help-center.js",["613"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/author/author.js",["614","615","616","617","618","619","620","621"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/blog-single/blog-single.js",["622","623"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/authors-list/authors-list.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/create-collection/create-collection.js",["624","625"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/profile/profile.js",["626","627","628","629","630"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/signup/signup.js",["631","632"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/not-found/not-found.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/how-it-works/how-it-works.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/privacy-&-terms/privacy-&-terms.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/explore-collections.js",["633","634","635","636","637","638"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/user-profile/UserProfile.js",["639","640","641","642","643","644","645","646","647","648","649","650","651","652","653","654","655","656","657","658","659"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/explore/all-nft/allnft.js",["660","661","662","663","664","665","666","667","668","669","670","671","672","673","674","675","676","677","678","679","680","681","682","683","684","685","686","687","688","689","690","691"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collection-details/collectiondetails.js",["692","693","694","695","696","697","698","699","700","701","702","703","704","705","706","707","708","709","710"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/nft-detail/nftdetail.js",["711","712","713","714","715","716","717","718","719","720","721","722"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],["723","724"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/Slider/slider.js",["725","726","727"],"import React, { useState, useEffect } from \"react\";\nimport \"./slider.css\";\nimport Slider from \"react-slick\";\nimport \"slick-carousel/slick/slick.css\";\nimport \"slick-carousel/slick/slick-theme.css\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\n// import image from \"../../assets/images/test.jpg\";\nimport nftBack from \"../../assets/images/nftBack.png\";\n// import nftImage from \"../../assets/images/nftImage.png\";\n\nconst SimpleSlider = (props) => {\n  const [showSlider, setShowSlider] = useState(false);\n  useEffect(() => {\n    if (showSlider == false) {\n      setTimeout(() => {\n        setShowSlider(true);\n      }, 300);\n    }\n  });\n  const settings = {\n    dots: true,\n    infinite: true,\n    speed: 500,\n    slidesToShow: 1,\n    slidesToScroll: 1,\n  };\n\n  return (\n    <div\n      className=\"position-relative slider-container\"\n      style={{ backgroundColor: \"\" }}\n    >\n      {/* <h2> Single Item</h2> */}\n\n      <img\n        src={nftBack}\n        style={{ width: \"26rem\", minWidth: \"26rem\" }}\n        className=\"slider-bg\"\n      />\n\n      <div\n        className=\"position-absolute nfts-title-container\"\n        style={{ top: \"-3rem\", right: \"9rem\" }}\n      >\n        <p\n          className=\"text-white mb-0 worlds-famous\"\n          style={{\n            fontSize: \"34px\",\n            fontWeight: \"bold\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          World's Famous\n        </p>\n        <p\n          className=\"mb-0 text-white nfts-title\"\n          style={{\n            // fontSize: \"165px\",\n            fontSize: \"8.2vw\",\n            fontWeight: \"bold\",\n            marginTop: \"-3rem\",\n            // fontFamily: \"Manrope\",\n          }}\n        >\n          NFT's\n        </p>\n      </div>\n      <div\n        className=\"position-relative slider-wrapper\"\n        style={{\n          bottom: \"22rem\",\n          right: \"-2rem\",\n          cursor: \"pointer\",\n          display: showSlider ? \"block\" : \"none\",\n        }}\n      >\n        <Slider {...settings}>\n          {props.assetList.map((nft, index) => {\n            return (\n              <div key={index} onClick={() => window.open(nft.link)}>\n                <img\n                  src={nft.img}\n                  className=\"slider-img\"\n                  alt={nft}\n                  style={{ objectFit: \"cover\" }}\n                />\n              </div>\n            );\n          })}\n        </Slider>\n      </div>\n    </div>\n  );\n};\nexport default SimpleSlider;\n",["728","729"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/Navbar/navbar.js",["730","731","732","733","734","735","736","737","738"],"// import react from 'react'\nimport \"./navbar.css\";\nimport { useHistory } from \"react-router-dom\";\nimport { BsTwitter } from \"react-icons/bs\";\nimport { SiDiscord } from \"react-icons/si\";\nimport { FaTelegramPlane } from \"react-icons/fa\";\nimport { GrReddit } from \"react-icons/gr\";\nimport { AiFillHome } from \"react-icons/ai\";\nimport mintsLogoSmily from \"../../assets/images/mintsClubSmilyLogo1.png\";\nimport MintsClub from \"../../assets/images/MintsClub-White.png\";\nimport { ENV } from \"../../config/config\";\nimport fullNavIcon from \"../../assets/images/mintsClubLogo1.png\";\n\nconst Navbar = () => {\n  const history = useHistory();\n  const twitter = ENV.twitterLink;\n  const discordLink = ENV.discordLink;\n  const telegramLink = ENV.telegramLink;\n  const redditLink = ENV.redditLink;\n\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n\n  return (\n    <div className=\"nav align-items-center\">\n      <input type=\"checkbox\" id=\"nav-check\" />\n      {/* <div className=\"nav-icon\" ><img src={fullNavIcon} width=\"20%\" /></div> */}\n      <div className=\"nav-header\" style={{ width: \"25%\" }}>\n        <div className=\"nav-title\" onClick={() => history.push(\"/\")}>\n          <img src={MintsClub} width=\"100%\" />\n        </div>\n      </div>\n      <div className=\"nav-btn\">\n        <label htmlFor=\"nav-check\">\n          <span></span>\n          <span></span>\n          <span></span>\n        </label>\n      </div>\n\n      <div className=\"nav-links\">\n        <a\n          className=\"navbar-item\"\n          href=\"#\"\n          target=\"_blank\"\n          style={{ color: \"#ffd33e\" }}\n        >\n          <AiFillHome className=\"home-icon \" />\n          Home\n        </a>\n\n        {twitter && twitter.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={twitter} target=\"_blank\">\n              <BsTwitter className=\"home-icon \" />\n              Twitter\n            </a>\n          </>\n        )}\n\n        {discordLink && discordLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={discordLink} target=\"_blank\">\n              <SiDiscord className=\"home-icon \" />\n              Discord\n            </a>\n          </>\n        )}\n\n        {telegramLink && telegramLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={telegramLink} target=\"_blank\">\n              <FaTelegramPlane className=\"home-icon \" />\n              Telegram\n            </a>\n          </>\n        )}\n\n        {redditLink && redditLink.length > 0 && (\n          <>\n            <a className=\"navbar-item\" href={redditLink} target=\"_blank\">\n              <GrReddit className=\"home-icon \" />\n              Reddit\n            </a>\n          </>\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default Navbar;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/utils/exportData.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/types.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/types/types.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/nfts/nfts.action.js",["739","740","741","742"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/auctions/home-auctions.js",["743","744","745","746","747","748","749","750","751","752","753","754","755","756","757","758","759"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/footer/footer.js",["760","761","762","763","764","765","766","767"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/user/user.action.js",["768"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/collections.js",["769","770","771"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/utils/web3.js",["772","773","774","775","776","777","778"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/hero/hero.js",["779","780"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/top-seller/topseller2.js",["781","782","783","784"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/assets/assets.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/filter-component/FilterComponent.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/actions/actions.js",["785","786","787","788"],"import { toast } from 'react-toastify';\nimport Web3 from 'web3';\nimport {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  // DEPLOY_CONTRACT,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS,\n  SET_OTP_EMAIL\n} from '../types/types';\n\nimport { ENV } from '../../config/config';\nimport { connectMetamaskCopy } from '../../utils/web3';\nimport axios from 'axios';\nimport dotenv from 'dotenv';\nexport const currentStepAction = () => (dispatch) => {\n  // alert(\"called\")\n\n  dispatch({\n    type: CURRENT_STEP,\n  });\n};\nexport const currentStepDecrement = () => (dispatch) => {\n  dispatch({\n    type: CURRENT_STEP_DECREMENT,\n  });\n};\nexport const clearCurrentStep = () => (dispatch) => {\n  dispatch({\n    type: CLEAR_CURRENT_STEP,\n  });\n};\n\nexport const contractResponse = () => (dispatch) => {\n  dispatch({\n    type: CONTRACT_REPONSE,\n  });\n};\nexport const setProperties = (data) => (dispatch) => {\n  // alert(\"callled\")\n  dispatch({\n    type: SET_PROPERTIES,\n    payload: data,\n  });\n};\nexport const setLevels = (data) => (dispatch) => {\n  dispatch({\n    type: SET_LEVELS,\n    payload: data,\n  });\n};\nexport const setOtpEmail=(data)=>(dispatch)=>{\n  dispatch({\n    type: SET_OTP_EMAIL,\n    payload: data,\n  });\n}\n\nexport const sendOtp = (data) => (dispatch) => {\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/sendVerficationEmail`;\n\n  axios.post(url, data, config).then(\n    (res) => {\n      //  alert(\"email sent\")\n      // console.log(res);\n      if (res.status === 200) {\n        //  toast.success(\"Otp Verification Code sent to \")\n      }\n    },\n    (err) => {\n      console.log(err, 'error');\n      alert('error while sending email');\n    }\n  );\n};\nfunction msToTime(ms) {\n  let seconds = (ms / 1000).toFixed(1);\n  let minutes = (ms / (1000 * 60)).toFixed(1);\n  let hours = (ms / (1000 * 60 * 60)).toFixed(1);\n  let days = (ms / (1000 * 60 * 60 * 24)).toFixed(1);\n  if (seconds < 60) return seconds + ' Sec';\n  else if (minutes < 60) return minutes + ' Min';\n  else if (hours < 24) return hours + ' Hrs';\n  else return days + ' Days';\n}\n\nexport const verifyOtp = (email, otp) => (dispatch) => {\n  let data = {\n    email,\n    otp,\n  };\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/verify`;\n  console.log(url);\n\n  axios.post(url, data, config).then(\n    (res) => {\n      console.log(res,\"res\")\n      if(res.data.email){\n\n        if(res.data.email!==email){\n          toast.error('Invalid Email or OTP');\n          return \" \"\n        }\n      }\n\n    if(res.data.status==false){\n      toast.error(res.data.message);\n      return \" \"\n    }\n\n      if (res.data.status === true) {\n        \n        setOtpEmail(res.data.data[0].email)\n        if (res.data.diffMins < -10) {\n          toast.error('Token is  Expired ,Please resend token & try again');\n          return ' ';\n        } else {\n          toast.success(res.data.message);\n      \n          dispatch({\n            type: SET_OTP_STATUS,\n            payload: true,\n          });\n        }\n      }\n      else {\n        // console.log(\"error\")\n        toast.error(res.data.message);\n      }\n    },\n    (err) => {\n     toast.error(\"Invalid OTP or Email\")\n    }\n  );\n};\n\nexport const deployContract = (data, address, supply) => (dispatch) => {\n\n\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/createUser`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then(\n      (res) => {\n        // console.log(res, \"response from backendfdkfd\");\n        const abi = res.data.data.abi;\n        if (res.data.status === true) {\n          let metaDataList = [];\n\n          for (let i = 1; i <= supply; i++) {\n            metaDataList.push(res.data.data.metaData);\n            dispatch({\n              type: SET_CONTRACT_INFO,\n              payload: res.data,\n            });\n          }\n\n          try {\n            const web3 = new Web3(Web3.givenProvider);\n            // const gasPrice = \"5000000\";\n            let contract = new web3.eth.Contract(abi, null, {\n              data: res.data.data.bytecode,\n\n              from: address,\n              // gas: 4600000,\n            });\n            contract\n              .deploy({\n                data: res.data.data.bytecode,\n                arguments: [res.data.data.name, res.data.data.symbol],\n              })\n              .send({\n                from: address,\n                // gas: gasPrice,\n              })\n              .then((contractInstance) => {\n                toast.success('Contract Deployed Successfully!');\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n\n                let info = {\n                  ...res.data,\n                  contractAddress: contractInstance.options.address,\n                };\n                dispatch({\n                  type: SET_CONTRACT_INFO,\n                  payload: {\n                    data: { ...info },\n                  },\n                });\n                dispatch({\n                  type: CONTRACT_ADDRESS,\n                  payload: contractInstance.options.address,\n                });\n                const contractData = {\n                  contractadd: contractInstance.options.address,\n                  Network: 'Etherium',\n                  Deployed: true,\n                };\n\n                dispatch({\n                  type: CONTRACT_REPONSE,\n                  payload: contractData,\n                });\n              })\n              .catch((err) => {\n                // console.log(\"error\", err);\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n                toast.error('Transaction Failed please check wallet history!');\n              });\n          } catch (err) {\n            dispatch({\n              type: LOADER,\n              payload: false,\n            });\n            toast.error('Transaction Failed please check wallet history!');\n          }\n        } else {\n          dispatch({\n            type: LOADER,\n            payload: false,\n          });\n          // console.log(res, \"dkfjdkfjkdjfkd\");\n          toast.error(res.data.data);\n\n          // dispatch({\n          //   type: CONTRACT_REPONSE,\n          //   payload: res.data,\n          // });\n        }\n        // console.log(res);\n      },\n      (error) => {\n        // console.log(error, 'error handle');\n        toast.error(error.response.data.data);\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        // console.log(error, \"error==dfjdkf\");\n        dispatch({\n          type: CONTRACT_ERROR_MESSAGE,\n          payload: error,\n        });\n        // alert(\"contract response\")\n        // dispatch({\n        //   type: CONTRACT_REPONSE,\n        //   payload: error,\n        // });\n        // resolve(error)\n      }\n    )\n    .catch((err) => {\n      console.log(err, 'error later==>');\n    });\n};\n\nexport const mintToken = (data, address, supply, email) => (dispatch) => {\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n  // console.log('here is data', data)\n  dispatch({\n    type: CONNECT_WELLET,\n    payload: address,\n  });\n  let metaDataList = [];\n  // console.log(data, \"data=====>\");\n  let metaData = '';\n  if (!data.data) {\n    metaData = data;\n  } else {\n    metaData = data.data.metaData;\n  }\n\n  for (let i = 1; i <= supply; i++) {\n    metaDataList.push(metaData);\n  }\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n  // console.log(\"metaDataList\", metaDataList);\n\n  try {\n    const web3 = new Web3(Web3.givenProvider);\n    // console.log('web3', web3);\n    const contractM = new web3.eth.Contract(\n      data.data.abi,\n      data.contractAddress\n    );\n    // console.log(\"metaDataList\", metaDataList);\n    contractM.methods\n      .batchMint(address, metaDataList, supply)\n      .send({\n        from: address,\n        // gas: 5000000,\n      })\n      .then((response) => {\n        // console.log(response, \"res of createNFT===>\");\n        handleEmailRequest(email);\n        let count = localStorage.getItem(address);\n        if (count) {\n          console.log(typeof (+count * 1), 'issueee');\n          localStorage.setItem(address, +count * 1 + 1);\n        } else {\n          localStorage.setItem(address, 1);\n        }\n        toast.success('Minting Successful');\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        dispatch({\n          type: TOKEN_ID,\n          payload: response,\n        });\n        dispatch({\n          type: MINTING_RESPONSE,\n          payload: response,\n        });\n      })\n      .catch((err) => {\n        console.log(err, 'error==>');\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        toast.error('Transaction Failed please check wallet history!');\n      });\n  } catch (err) {\n    dispatch({\n      type: LOADER,\n      payload: false,\n    });\n    toast.error('Transaction Failed please check wallet history!');\n  }\n};\nconst handleEmailRequest = (email) => {\n  let data = {\n    email,\n  };\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/addEmail`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then((res) => {\n      // console.log(res, \"email response==>\");\n    })\n    .catch((err) => console.log(err));\n};\nexport const setContractInfo = () => (dispatch) => {\n  dispatch({\n    type: SET_CONTRACT_INFO,\n  });\n};\n\nexport const connectWallet = () => (dispatch) => {\n  connectMetamaskCopy()\n    .then((address) =>\n      // console.log(address,\"address\"),\n      dispatch({\n        type: CONNECT_WELLET,\n        payload: address,\n      })\n    )\n    .catch((err) => console.log(err, 'error'));\n};\n\nexport const hometest = () => (dispatch) => {\n  // dispatch({\n  // type:HOME_TEST,\n  // payload: data\n  // })\n  // dispatch(emptyError());\n  // const url = `${ENV.url}/nfts/${type}`;\n  // fetch(url, {\n  // method,\n  // headers: {\n  // 'Authorization': ENV.Authorization,\n  // 'x-auth-token': ENV.x_auth_token,\n  // 'Access-Control-Allow-Origin': '*',\n  // 'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  // },\n  // body\n  // }).then(res => res.json()).then(data => {\n  // if (data.success) {\n  // toast.success(data.message)\n  // dispatch({\n  // type: UPSERT_NFT,\n  // payload: data\n  // })\n  // } else {\n  // toast.error(data.message)\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: data\n  // })\n  // }\n  // }).catch(error => {\n  // if (error.response && error.response.data) {\n  // const { data } = error.response\n  // if (data.message)\n  // toast.error(data.message)\n  // }\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: error\n  // })\n  // })\n};\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/utils/functions.js",["789","790","791","792","793","794","795","796","797"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/utils/abiSetup.js",["798"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/footer/footer.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/collections/collections.actions.js",["799","800"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/bids/bids.action.js",["801","802"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/card-slider/CardSlider.js",["803","804","805","806","807","808"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/hero/component/slider.js",["809","810","811","812","813"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/videoComponent/videoComponent.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["814","815","816"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(props.levelsInputs);\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage, setErrorMessage] = React.useState(\"\");\n  const [validate, setValidate] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues.splice(i, 1);\n    setlevelsInputs(newFormValues);\n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total === \"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\");\n        return \"\";\n      }\n      if (+item.value > +item.total) {\n        alert(\"inside\");\n        setError(true);\n        setValidate(true);\n        setErrorMessage(\"Value should be less then total!\");\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n  //  const handleValue=(item)=>{\n  //    if(item.value > item.total){\n\n  //      setError(true)\n  //      return true\n  //    }\n  //    return false\n  //  }\n  //  const handleTotal=(item)=>{\n\n  //  }\n  // console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"550px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 mx-auto justify-content-center\">\n              <div className=\"d-flex\">\n                <img\n                  src={LevelsImage}\n                  alt={\"levels\"}\n                  style={{ height: \"2rem\" }}\n                />\n                <p\n                  className=\"text-white\"\n                  style={{\n                    fontSize: \"1.3rem\",\n                    fontWeight: \"bold\",\n                    marginLeft: \"1rem\",\n                  }}\n                >\n                  Add Levels\n                </p>\n              </div>\n            </div>\n            {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Levels show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n            <form onSubmit={handleSubmit}>\n              <div\n                className=\"row levels-scroll p-3 \"\n                style={{\n                  height: `${\n                    levelsInputs && levelsInputs.length > 0\n                      ? \"8.3rem\"\n                      : \"7.3rem\"\n                  }`,\n                }}\n              >\n                {levelsInputs &&\n                  levelsInputs.length > 0 &&\n                  levelsInputs.map((item, i) => {\n                    return (\n                      <div\n                        className=\"row\"\n                        key={i}\n                        style={{\n                          marginBottom: `${\n                            levelsInputs && levelsInputs.length > 1\n                              ? \"12px\"\n                              : \"0\"\n                          }`,\n                        }}\n                      >\n                        <div className=\"col-10 col-sm-6 mt-2 \" key={i}>\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            <input\n                              className=\"step3-input mt-3 name-inp\"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              value={item.name || \"\"}\n                              placeholder=\"Name\"\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 mt-2\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                            <div className=\"values-total-inp w-100\">\n                              <input\n                                className={`step3-input first-value mt-3 values-inp ${\n                                  validate && item.value > item.total\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min=\"1\"\n                                max={\n                                  item.total == \"0\"\n                                    ? \"1\"\n                                    : item.total\n                                    ? item.total\n                                    : \"1\"\n                                }\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.value || \"\"}\n                                placeholder=\"Value\"\n                                autoComplete=\"off\"\n                                name=\"value\"\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n\n                              <p className=\"text-white mb-0 value-label mt-3\">\n                                Of\n                              </p>\n                              <input\n                                className={`step3-input first-value values-inp mt-3 ${\n                                  validate && item.total < item.value\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min={item.value ? item.value : \"1\"}\n                                max=\"9999\"\n                                name=\"total\"\n                                placeholder=\"Total\"\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.total || \"\"}\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                            </div>\n                            <BsFillXCircleFill\n                              className=\"position-absolute levels-cross-icon\"\n                              style={{\n                                color: \"#00d3f3\",\n                                top: \"3rem\",\n                                right: \"-1rem\",\n                                cursor: \"pointer\",\n                              }}\n                              onClick={() => removeFormFields(i)}\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                <div className=\"W-100 text-center\"></div>\n              </div>\n              <p\n                className=\" col-8 mt-4\"\n                style={{\n                  color: \"#00d3f3\",\n                  cursor: \"pointer\",\n                  marginLeft: \"0.8rem\",\n                }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n\n              <div className=\"w-100 text-center\">\n                <button\n                  type=\"submit\"\n                  className=\"btn btn-secondary start-btn mt-5 text-center\"\n                  style={{ width: \"9rem\" }}\n                  // disabled={\n                  //   levelsInputs && levelsInputs?.length > 0\n                  //     ? false\n                  //     : true\n                  // }\n                  // onClick={() => {\n                  //   handleSubmit()\n                  // }}\n                >\n                  Save\n                </button>\n              </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["817","818"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.properties\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"500px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white mt-0\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 7.95rem\"\n                    : \"7.95rem\"\n                }`,\n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" style={{ width: \"558px\" }} key={i}>\n                      <div className=\"row\">\n                        <div\n                          className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1\"\n                          key={i}\n                        >\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <input\n                              className=\"step3-input mt-2 \"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              placeholder=\"Name\"\n                              value={item.name || \"\"}\n                              maxLength=\"30\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29 !important\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n\n                        <div className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1 ml-0 ml-md-4\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{\n                                fontSize: \"1.2rem\",\n                                fontWeight: \"bold\",\n                              }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <div className=\"d-flex align-items-center w-100\">\n                              <input\n                                className=\"step3-input  mt-2\"\n                                type=\"text\"\n                                name=\"value\"\n                                onChange={(e) => handleChange(i, e)}\n                                placeholder=\"Value\"\n                                value={item.value || \"\"}\n                                maxLength=\"30\"\n                                autoComplete=\"off\"\n                                style={{\n                                  backgroundColor: \"#000e29 \",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                              <BsFillXCircleFill\n                                className=\"ml-1 ml-sm-2\"\n                                style={{\n                                  color: \"#00d3f3\",\n                                  top: \"3rem\",\n                                  left: \"13.8rem\",\n                                  cursor: \"pointer\",\n                                }}\n                                onClick={() => removeFormFields(i)}\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <p\n              className=\" mt-4 ml-4\"\n              style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n              onClick={() => addMoreValues()}\n            >\n              {\" \"}\n              Add Property\n            </p>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-2 mt-md-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   propertiesValues && propertiesValues?.length > 0\n                //     ? false\n                //     : true\n                // }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["819","820"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\nimport Modal from \"@mui/material/Modal\";\nimport { AiOutlineClose } from \"react-icons/ai\";\nimport { BiArrowBack } from \"react-icons/bi\";\n\nimport \"./PreviewModal.css\";\nimport { maxWidth } from \"@mui/system\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 830,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n};\n\nconst genStyle = {\n  row: {\n    display: \"grid\",\n  },\n};\n// let array = [1];\n\nconst PreviewModal = (props) => {\n  // console.log(props,\"props\")\n  const {\n    previewModal,\n    handlePreviewModal,\n    previewModalStep,\n    handlePreviewModalSteps,\n    onDeploy,\n    info,\n  } = props;\n  const handleNextStep = () => {\n    if (previewModalStep === 1) {\n      handlePreviewModalSteps(\"next\");\n    } else {\n      onDeploy();\n    }\n  };\n  // console.log(props,\"props\")\n  return (\n    <div>\n      <Modal\n        open={previewModal}\n        onClose={handlePreviewModal}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"preview-modal-container pt-4 px-1 px-md-5\">\n            <div className=\"w-100 d-flex justify-content-between \">\n              {previewModalStep > 1 ? (\n                <BiArrowBack\n                  className=\"text-white \"\n                  style={{\n                    fontSize: \"1.8rem\",\n                    cursor: \"pointer\",\n                  }}\n                  onClick={() => handlePreviewModalSteps(\"back\")}\n                />\n              ) : (\n                <span></span>\n              )}\n              <AiOutlineClose\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.8rem\",\n                  cursor: \"pointer\",\n                }}\n                onClick={() => handlePreviewModal()}\n              />\n            </div>\n\n            {previewModalStep === 1 ? (\n              <div className=\"row  preview-modal-info\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text \">Preview</p>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div className=\"previewModal-img\">\n                    {info.img && (\n                      <img\n                        src={info.img ? info.img : \"\"}\n                        className=\"mt-3\"\n                        style={{\n                          width: \"100%\",\n                          height: \"100%\",\n                          borderRadius: \"10px\",\n                          objectFit: \"contain\",\n                        }}\n                        alt=\"preview\"\n                      />\n                    )}\n                    {info.videoUrl && (\n                      <video className=\"preview-video-view mt-3\" controls>\n                        <source src={info.videoUrl} />\n                      </video>\n                    )}\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white external-label ml-0 my-2 ml-0\">\n                      External Link\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"url\"\n                      value={\n                        (info.externalLink && info.externalLink.trim()) ||\n                        \"- externalLink -\"\n                      }\n                      placeholder=\"- externalLink -\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label mb-2 ml-0\">\n                      Name\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={info.name || \"\"}\n                      placeholder=\"name\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Email\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"email\"\n                      value={info.email || \"\"}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Symbol\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={\n                        (info.symbol && info.symbol.trim()) || \"- symbol -\"\n                      }\n                      placeholder=\"- symbol -\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Description\n                    </label>\n                    <textarea\n                      className=\"p-3 mt-1 w-100 externalLink-input\"\n                      placeholder=\"- Description -\"\n                      value={\n                        (info.description && info.description.trim()) ||\n                        \"- Description -\"\n                      }\n                      style={{\n                        color: \"#aaabab\",\n                        marginLeft: \"2rem\",\n                        margin: \"0\",\n                        width: \"100%\",\n                      }}\n                      maxLength=\"600\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Supply\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"number\"\n                      value={info.supply || \"- supply -\"}\n                      disabled={true}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      placeholder=\"- supply -\"\n                      maxLength=\"50\"\n                    />\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\" preview-modal-info rowCust\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text mb-3\">Preview</p>\n                </div>\n\n                <p className=\"text-white font-weight-bold preview-properties-title \">\n                  Properties{\" \"}\n                </p>\n\n                <div\n                  className=\"rowCust px-3 mb-3\"\n                  style={{\n                    overflowY: \"auto\",\n                    height: \"5.1rem\",\n                    overflowX: \"hidden\",\n                  }}\n                >\n                  {props.properties && props.properties.length > 0 ? (\n                    props.properties.map((item, index) => {\n                      return (\n                        <div\n                          className=\"row justify-content-between\"\n                          key={index}\n                        >\n                          <div className=\"col-12  col-md-6\" key={index}>\n                            <label\n                              className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                              for=\"preview-name\"\n                            >\n                              Name\n                            </label>\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.name || \"\"}\n                              maxLength=\"50\"\n                              placeholder=\"item name\"\n                              disabled={true}\n                              id=\"preview-name\"\n                            />\n                          </div>\n\n                          <div className=\"col-12 col-md-6 pr-lg-0\">\n                            <label\n                              className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                              for=\"preview-value\"\n                            >\n                              Value\n                            </label>\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.value || \"\"}\n                              placeholder=\"Value\"\n                              maxLength=\"50\"\n                              disabled={true}\n                              id=\"preview-value\"\n                            />\n                          </div>\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center\" style={{ color: \"#A9A9A9\" }}>\n                      {\"No Properties Found\"}\n                    </p>\n                  )}\n                </div>\n                <div className=\"previewdivider ml-3\"></div>\n                {/* ////////////////////////////////////////////// */}\n                <div className=\"mt-3\">\n                  <p className=\"text-white font-weight-bold preview-levels-title\">\n                    Levels{\" \"}\n                  </p>\n                  <div\n                    className=\"rowCust px-3\"\n                    style={{\n                      overflowY: \"auto\",\n                      overflowX: \"hidden\",\n                      height: \"5.1rem\",\n                    }}\n                  >\n                    {props.levels && props.levels.length > 0 ? (\n                      props.levels.map((item, index) => {\n                        return (\n                          <div className=\"row\" key={index}>\n                            <div className=\"col-12 col-md-6 \" key={index}>\n                              <label\n                                className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                                for=\"preview-name\"\n                              >\n                                Name\n                              </label>\n                              <input\n                                className=\"preview-input-step-2 value-input-preview w-100\"\n                                type=\"url\"\n                                value={item.name || \"\"}\n                                placeholder=\"Levels\"\n                                style={{\n                                  marginTop: `${\n                                    index === 0 ? \"0rem\" : \"1.2rem\"\n                                  }`,\n                                  maxWidth: \"90%\",\n                                }}\n                                // maxLength=\"50\"\n                                disabled={true}\n                              />\n                            </div>\n\n                            <div className=\"col-12 col-md-6 \">\n                              <label\n                                className=\"text-white ml-3 mb-1 preview-deplow-labels\"\n                                for=\"preview-name\"\n                              >\n                                Value\n                              </label>\n                              <div\n                                className=\"d-flex align-items-center justify-content-between ml-3 preview-modal-value-2\"\n                                style={{\n                                  marginTop: `${\n                                    index === 0 ? \"0rem\" : \"1.2rem\"\n                                  }`,\n                                  width: \"93%\",\n                                }}\n                              >\n                                <input\n                                  className=\"preview-modal-step\"\n                                  type=\"number\"\n                                  pattern=\"[0-9]+\"\n                                  // maxlength=\"4\"\n                                  value={item.value || \"\"}\n                                  placeholder=\"Value\"\n                                  name=\"value\"\n                                  disabled={true}\n                                  style={{\n                                    padding: \"0.6rem 1rem\",\n                                    width: \"45%\",\n                                  }}\n                                />\n\n                                <p className=\"text-white mb-0 mx-2\">Of</p>\n                                <input\n                                  className=\"preview-modal-step\"\n                                  type=\"number\"\n                                  min=\"1\"\n                                  max=\"5\"\n                                  name=\"total\"\n                                  placeholder=\"total\"\n                                  disabled={true}\n                                  // onInput=\"javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);\"\n                                  value={item.total || \"\"}\n                                  style={{\n                                    padding: \"0.6rem 1rem\",\n                                    width: \"45%\",\n                                  }}\n                                />\n                              </div>\n                            </div>\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\" text-center\" style={{ color: \"#A9A9A9\" }}>\n                        {\"No levels Found\"}\n                      </p>\n                    )}\n                  </div>\n                </div>\n              </div>\n            )}\n            <div className=\"w-100 text-center\">\n              <p className=\"text-white my-3\">{previewModalStep}/2</p>\n              {previewModalStep > 1 && props.maxLimit && (\n                <p className=\"text-danger\">\n                  {\"Maximum deployment limit reached,Please contact support\"}\n                </p>\n              )}\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary preview-btn mb-3\"\n                disabled={props.maxLimit && previewModalStep > 1 ? true : false}\n                onClick={() => handleNextStep()}\n              >\n                {previewModalStep === 1 ? \"Next\" : \"Deploy\"}\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nexport default PreviewModal;\n","/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/auctions/auctions.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/header/header.js",["821","822","823","824","825","826","827"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/explore/explore.action.js",["828"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/categories/categories.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/author-profile/author-profile.js",["829","830","831","832","833"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/faq/faq.js",["834","835"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/contact/contact.action.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/authors/authors.js",["836","837"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/sidebar/sidebar.js",["838","839","840"],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/components/filter-search2/filtersearch2.js",[],"/home/adnan/Desktop/mintsClub/ariswap/frontend/src/componen