ecatedRules":"190"},{"filePath":"395","messages":"396","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"397","usedDeprecatedRules":"190"},{"filePath":"398","messages":"399","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"400","messages":"401","errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"402","usedDeprecatedRules":"190"},{"filePath":"403","messages":"404","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"405","messages":"406","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"407","usedDeprecatedRules":"190"},{"filePath":"408","messages":"409","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"410","messages":"411","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"412","usedDeprecatedRules":"190"},{"filePath":"413","messages":"414","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"415","messages":"416","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"417","messages":"418","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"419","messages":"420","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"421","usedDeprecatedRules":"190"},{"filePath":"422","messages":"423","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"424","messages":"425","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"190"},{"filePath":"426","messages":"427","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/index.js",[],["428","429"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/store.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/App.js",["430","431","432"],"import React, { Suspense, useEffect } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./components/full-page-loader/full-page-loader\";\nimport { useHistory } from \"react-router\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { getWalletAddress } from \"./utils/web3\";\nimport { toast } from \"react-toastify\";\n// import 'swiper/swiper-bundle.css';\n\nconst App = React.memo((props) => {\n  // const [walletAddress, setWalletAddress] = useState(\"\");\n  let walletAddress = false;\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n  const history = useHistory();\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  // ///set Interval\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address) {\n        toast.info(\"Please login with new address\");\n        walletAddress = address;\n        // setWalletAddress(address)\n        localStorage.clear();\n        history.push(\"/login\");\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n      // setWalletAddress(address);\n    }\n    // }\n  };\n\n  return (\n    <React.Fragment>\n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={\n                    ENV.getUserKeys(\"_id\")._id || route.path === \"/login\"\n                      ? true\n                      : false\n                  }\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nexport default App;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/privateRoute.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/routes.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/index.js",["433","434"],"import { combineReducers } from \"redux\";\nimport homeReducer from \"./../components/home/home.reducer\";\nimport mintsReducer from \"../redux/reducer/reducer\";\nimport auctionReducer from \"./../components/auctions/auctions.reducer\";\nimport nftReducer from \"./../components/nfts/nfts.reducer\";\nimport userReducer from \"./../components/user/user.reducer\";\nimport walletReducer from \"./../components/wallet/wallet.reducer\";\nimport categoryReducer from \"./../components/categories/categories.reducer\";\nimport collectionReducer from \"./../components/collections/collections.reducer\";\nimport errorReducer from \"./shared/error/error.reducer\";\nimport settingsReducer from \"../components/footer/footer.reducer\";\n\nimport offersReducer from \"../components/offers/offers.reducer\";\nimport bidsReducer from \"../components/bids/bids.reducer\";\n\nimport exploreAllReducer from \"../components/explore/explore.reducer\";\nimport createNftReducer from \"../components/create-nft/create-nft-reducer\";\n\nexport default combineReducers({\n  home: homeReducer,\n  dashboard: mintsReducer,\n  auction: auctionReducer,\n  nft: nftReducer,\n  user: userReducer,\n  wallet: walletReducer,\n  category: categoryReducer,\n  collection: collectionReducer,\n  error: errorReducer,\n\n  offer: offersReducer,\n  bid: bidsReducer,\n\n  explore: exploreAllReducer,\n});\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/utils/web3.js",["435","436","437"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/config/config.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/home/home.reducer.js",["438","439"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["440"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/home/home.js",["441","442"],"import React, { useEffect } from \"react\";\nimport { Table, Pagination } from \"react-bootstrap\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller2\";\n\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n  \n      <NavbarMain />\n      <Hero />\n\n      <Auctions />\n   \n  \n      <TopSeller viewAll={\"View All\"} />\n   \n      <PopularCollections />\n     \n      <OwnCollection />\n      <Buysell />\n      <Footer />\n    </>\n  );\n}\n\nexport default Home;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore-all.js",["443","444","445","446","447","448"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFTs } from \"../nfts/nfts.action\";\nimport { ENV } from \"../../config/config\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport NftCard from \"../collections/components/NftCard/NftCard\";\nimport { useHistory } from \"react-router-dom\";\nimport { getCreators } from \"./../user/user.action\";\n\nconst initData = {\n  pre_heading: \"Explore\",\n  heading: \"Exclusive Digital Assets\",\n  content: \"\",\n  btn_1: \"Load More\",\n};\n\nfunction ExploreAll(props) {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const pathname = useHistory().location.pathname;\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (pathname === \"/explore-all\") setIntro(true);\n    getNFTs();\n    props.getCreators();\n  }, []);\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      setCreator(props.user.sellers);\n    }\n  }, [props.user.topSellersAuth]);\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      setCreator(props.user.creators);\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nftsData } = props.nft;\n      if (nftsData) {\n        setNFTs(nftsData);\n        setNFTPagination(nftsData.pagination);\n        props.beforeNFT();\n        if (props.setLoader) props.setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  const loadMore = () => {\n    const { page, limit } = nftPagination;\n    setLoader(true);\n    getNFTs(1, limit * (page + 1));\n  };\n\n  const getNFTs = (page = 1, limit = 4) => {\n    const nftQS = { page, limit, explore: true };\n\n    if (props.collectionId) nftQS.collectionId = props.collectionId;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    props.getNFTs(qs);\n  };\n\n  return (\n    <section\n      className=\"explore-area\"\n      style={{ paddingTop: `${intro ? \"150\" : \"30\"}px` }}\n    >\n      {loader && <FullPageLoader />}\n      <div className=\"container\">\n        {intro && (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              <div className=\"intro text-center mb-4\">\n                <span>{initData.pre_heading}</span>\n                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n              </div>\n            </div>\n          </div>\n        )}\n        <div className=\"row items gx-4 explore-items\">\n          {nfts && nfts.length > 0 && creators.length > 0 ? (\n            nfts.map((item, idx) => {\n              return (\n                <div key={idx} className=\"col-3 mt-5\">\n                  <NftCard\n                    nft={item}\n                    creators={creators}\n                    userId={ENV.getUserKeys(\"_id\")._id}\n                  />\n                </div>\n              );\n            })\n          ) : (\n            <p className=\"text-center\">No Items Found to Exploree</p>\n          )}\n        </div>\n        {loadMoreBtn && (\n          <div className=\"row\">\n            <div className=\"col-12 text-center\">\n              <a\n                id=\"load-btn\"\n                className=\"btn btn-bordered-white mt-5\"\n                onClick={() => loadMore()}\n              >\n                {initData.btn_1}\n              </a>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs, getCreators })(\n  ExploreAll\n);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/create-nft-reducer.js",["449"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collection-details.js",["450","451","452","453","454","455","456","457","458","459","460","461","462","463","464","465","466","467","468"],"import React, { useState, useEffect, useRef } from \"react\";\n\nimport Explore from \"../explore/explore-all\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection, getCollection } from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"../../config/config\";\nimport { Accordion, Dropdown } from \"react-bootstrap\";\nimport Select from 'react-select'\nimport NftCard from './components/NftCard/NftCard';\nimport {getNFTs} from '../nfts/nfts.action'\nimport {getCreators, beforeUser} from './../user/user.action';\nimport { toast } from \"react-toastify\";\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV;\n\nconst CollectionDetails = (props) => {\n  const [collection, setCollection] = useState(null);\n  const [nfts, setNfts] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [limit, setLimit] = useState(2);\n  const [collectionLoader, setColLoader] = useState(true); // collections loader\n  const [nftsLoader, setNftsLoader] = useState(true); // NFTs loader\n  const [creators,setCreator]=useState([])\n  const nftsRef = useRef(null);\n\n  useEffect(() => {\n   \n    props.getNFTs()\n    window.scroll(0, 0);\n    const { collectionId } = props.match.params;\n    if (collectionId) props.getCollection(window.atob(collectionId));\n    else props.history.push(\"/collections\");\n  }, []);\n\n  // when collection data is received\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collection } = props.collection;\n  \n      setCollection(collection);\n      props.beforeCollection();\n      setColLoader(false);\n    }\n  }, [props.collection.getAuth]);\n   \n  useEffect(()=>{\n      \n    if(props.user.topSellersAuth ){\n    \n       setCreator(props.user.sellers)\n\n    }\n  },[props.user.topSellersAuth])\n\n  // handle show load more button state when pagination is set\n  useEffect(() => {\n   \n    if (nftPagination)\n        setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length && nfts.length > 0))\n  }, [nftPagination])\n\n  const loadMore = () => {\n    \n    // const { page, limit } = nftPagination\n    setLoader(true)\n    setLimit(limit + 2)\n    // get more NFTs for explore section\n    // getNFTs(1, limit * (page + 1));\n  }\n\n  const filterNfts=(nfts)=>{\n\n    if(collection)\n    {\n      const result_nft = nfts.filter((nft)=>nft?.collectionId===collection._id);\n      nfts.pagination = { page: 1, limit: 10, total: result_nft.length, pages: 1 }\n      setNfts(result_nft.slice(0, limit));\n      setNFTPagination(nfts.pagination)\n      getNftsLoader(false);\n    }\n  }\n\n\n\n\n  const getNFTs = (page = 1, limit = 2) => {\n      const nftQS = { page, limit }\n      if (props.collectionId)\n          nftQS.collectionId = props.collectionId\n      const qs = ENV.objectToQueryString(nftQS)\n      props.getNFTs(qs)\n  }\n\n  useEffect(()=>{\n    if(props.nft.nftsAuth)\n    {\n      const {nftsData}=props.nft;\n      filterNfts(nftsData)  \n    }\n\n  },[props?.nft?.nftsAuth,collection, limit])\n\n\n\n  const getNftsLoader = (loader) => {\n    setNftsLoader(loader);\n  };\n\n  return (\n    <section\n      className=\"author-area explore-area  popular-collections-area\"\n      style={{ padding: \"0px\" }}\n    >\n      {(collectionLoader || nftsLoader) && <FullPageLoader />}\n      <div className=\"\">\n        {collection  && (\n          <div className=\"row p-5\" style={{width:\"80%\",margin:\"auto\"}}>\n            <div className=\"col-4 p-4\">\n              {/* <CollectionPreview collection={collection} creators={creators} /> */}\n            </div>\n            <div className=\"col-8 \">\n              <div className=\"row justify-content-center mt-5\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  <div className=\"intro text-center mb-4\">\n                      {/* <span>{initData.pre_heading}</span> */}\n                      <span>Explore</span>\n                      {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                          <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row gx-5 p-4\">\n              \n                {\n                  nfts && creators && nfts.map((nft)=>{\n                  return (\n                    <div className=\"col-6 mt-5\" style={{}}>\n                      <NftCard nft={nft} creators={creators}/>\n                    </div>\n                    )\n                  })\n                }\n                {\n                  loadMoreBtn &&\n                  <div className=\"row w-100\">\n                      <div className=\"col-12 w-100 text-center\">\n                          <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>Load More</a>\n                      </div>\n                  </div>\n                }\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  {\n\n  error: state.error,\n  collection: state.collection,\n  nft:state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollection,\n  getNFTs,\n  getCreators,\n\n})(CollectionDetails);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["469"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/signup/signup.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.js",["470","471","472","473","474","475","476","477"],"import React, { useState, useEffect } from \"react\";\nimport { Redirect, useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"../wallet/wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  getCollections,\n  beforeCategory,\n  beforeCollection,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport { login, signup } from \"../user/user.action\";\nimport \"./wallet.css\";\n\nconst Wallet = (props) => {\n  const history = useHistory();\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [disabled,setDisabled]=useState(false)\n\n  const connectMetamaskCall = async () => {\n    setDisabled(true)\n    let connectedAddress = await connectMetamaskCopy();\n    if (connectedAddress){\n      setDisabled(false)\n    }\n    setConnectedAddress(connectedAddress);\n    setWalletAddress(connectedAddress);\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      console.log(\"errors\", props.error);\n\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setDisabled(false)\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    console.log(props.collection.getAuth, \"props.collection.getAuth\");\n    if (props.collection.getAuth === true) {\n      let collections = props.collection.collections;\n\n      const userId = ENV.getUserKeys(\"_id\")._id;\n\n      // let myCollections = collections.filter((el) => el.userId === userId);\n\n      // if (myCollections && myCollections.length > 0) {\n      props.beforeCollection();\n      //   history.push(\"/\");\n      // } else {\n      // }\n      history.push(\"/\");\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    \n    e.preventDefault();\n    setDisabled(true)\n    try {\n      if (validator.isEmail(email)) {\n        let sign = await signRequest();\n        let payload = {\n          address: connectedAddress,\n          // password: sign,\n          email: email,\n          username: username,\n          isApproved: false,\n        };\n        // console.log(payload, \"payload\");\n        props.signup(payload);\n      } else {\n        setErrorMessage(\"please enter valid email\");\n      }\n    } catch (err) {\n      toast.error(err.message);\n      setDisabled(false)\n    }\n  };\n\n  const login = async () => {\n    try {\n      setDisabled(true)\n      let sign = await signRequest();\n      let payload = {\n        address: connectedAddress,\n      };\n      \n      props.login(payload);\n    } catch (err) {\n      setDisabled(false)\n      toast.error(err.message);\n    }\n  };\n\n  const switchSignup = () => {\n    setShowSignUpComponent(true);\n  };\n\n  // if (props.user.userAuth) {\n  //     console.log(\"@@@@Collection-----@\", collections);\n  //     if(collections && collections.length>){\n  //         console.log(\"In Upper\")\n  //         return <Redirect to=\"/create\" />\n  //     }\n  //     else {\n  //         console.log(\"In Down\");\n  //         return <Redirect to=\"/collection/create\" />\n  //     }\n  // }\n\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div className=\"container\">\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Sign In</span>\n                  <h3 className=\"mt-3 mb-0\">SignIn to your account</h3>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                <div className=\"card single-wallet sign-in-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <h4 className=\"mb-0\">Address</h4>\n                    <p id=\"connected-address mt-3\">{connectedAddress}</p>\n                    {errorMessage && (\n                      <p className=\"text-gray\">{errorMessage}</p>\n                    )}\n                    {!showSignUp && (\n                      <>\n                        <button\n                          className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4\"\n                          type=\"button\"\n                          disabled={disabled}\n                          onClick={() => login()}\n                        >\n                          Sign In\n                        </button>\n                      </>\n                    )}\n                  \n                    {showSignUp && (\n                      <button\n                        className=\"btn btn-linear-gradient btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                        type=\"button\"\n                        onClick={() => switchSignup()}\n                      >\n                        Would you like to Signup?\n                      </button>\n                    )}\n                      {/* <div className=\"mt-3\">\n                      <a\n                        className=\"text-white back-link \"\n                        onClick={() => {\n                          setConnectedAddress(\"\");\n                          setWalletAddress(\"\");\n                        }}\n                      >\n                        Back\n                      </a>\n                    </div> */}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              {/* Intro */}\n              <div className=\"intro text-center\">\n                <span>SIGNUP</span>\n                <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                <p className=\"text-gray\">Create the account with the address</p>\n              </div>\n              {/* Item Form */}\n              <form\n                className=\"item-form card no-hover signup-card\"\n                onSubmit={(e) => signup(e)}\n              >\n                <div className=\"row\">\n                  {errorMessage && (\n                    <p className=\"text-center text-gray\">{errorMessage}</p>\n                  )}\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"address\"\n                        placeholder=\"Address\"\n                        required=\"required\"\n                        disabled={true}\n                        value={connectedAddress}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"email\"\n                        className=\"form-control sign-up-input\"\n                        name=\"email\"\n                        placeholder=\"Enter your Email\"\n                        required=\"required\"\n                        defaultValue={email}\n                        onChange={(e) => setEmail(e.target.value)}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3\">\n                      <input\n                        type=\"text\"\n                        className=\"form-control sign-up-input\"\n                        name=\"username\"\n                        placeholder=\"Enter your Username\"\n                        required=\"required\"\n                        defaultValue={username}\n                        onChange={(e) => setUsername(e.target.value)}\n                        autoComplete=\"off\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"form-group mt-3 text-center\">\n                      <div className=\"form-check form-check-inline\">\n                        <input\n                          className=\"form-check-input\"\n                          type=\"radio\"\n                          name=\"inlineRadioOptions\"\n                          id=\"inlineRadio1\"\n                          defaultValue=\"option1\"\n                          autoComplete=\"off\"\n                        />\n                        <label\n                          className=\"form-check-label text-center text-gray\"\n                          htmlFor=\"inlineRadio1\"\n                        >\n                          I agree to{\" \"}\n                          <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                        </label>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-12\">\n                    <div className=\"text-center\">\n                      <button\n                        className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4  text-white \"\n                        type=\"submit\"\n                        disabled={disabled}\n                      >\n                        Sign Up\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              </form>\n            </div>\n          </div>\n        ) : (\n          <>\n            <div className=\"row justify-content-center\">\n              <div className=\"col-12 col-md-8 col-lg-7\">\n                {/* Intro */}\n                <div className=\"intro text-center\">\n                  <span>Wallet Connect</span>\n                  <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                  <p className=\"text-white mt-3\">\n                    Please select the wallet you want to connect to.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className=\"row justify-content-center items\">\n              {errorMessage && <p className=\"text-white\">{errorMessage}</p>}\n              <div\n                className=\"col-12 col-md-6 col-lg-4 item\"\n                onClick={() => connectMetamaskCall()}\n              >\n                {/* Single Wallet */}\n                <div className=\"card single-wallet whole-hover wallet-metamask-card\">\n                  <span className=\"d-block text-center\" href=\"/login\">\n                    <img\n                      className=\"avatar-lg\"\n                      src=\"/img/metamask2.png\"\n                      alt=\"\"\n                    />\n                    <h4 className=\"mb-0 my-3\">MetaMask</h4>\n                    <p>\n                      A browser extension with great flexibility. The web's most\n                      popular wallet\n                    </p>\n                  </span>\n                </div>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n  beforeCollection,\n})(Wallet);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["478","479","480","481","482","483","484","485","486","487","488"],"import React, { useState, useEffect } from \"react\";\nimport { useLocation, useHistory } from \"react-router-dom\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport \"./collectiondetails.css\";\nimport FlagIcon from \"../../assets/images/detail-flag.svg\";\nimport ShareIcon from \"../../assets/images/detail-share.svg\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport {\n  getNFTsByCollection,\n  getNFTs,\n  beforeNFT,\n  getMyLikedNfts,\n} from \"../nfts/nfts.action\";\nimport { connect } from \"react-redux\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport { ENV } from \"../../config/config\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport VideoCard from \"../test-video-card/videoCard\";\nimport BannerPh from \"../../assets/images/collection-detailBg.png\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\nconst CollectionDetailsPage = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [nfts, setNfts] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [keyword, setKeyword] = useState(\"\");\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n  });\n  const location = useLocation();\n  const history = useHistory();\n\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    chains: {\n      label: \"Chains\",\n      option: [\"Ethereum\"],\n    },\n  };\n\n  useEffect(() => {\n    getNFTs();\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      if (props.nfts.length > 0) {\n        setDisabled(false);\n      } else {\n        if (initial) {\n          setDisabled(true);\n        }\n      }\n      setNfts(props.nfts);\n\n      setLoader(false);\n\n      setFilterationLoader(false);\n    }\n  }, [props.nftsAuth]);\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 40,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter,\n    keyword,\n    buy,\n    auction,\n    latest\n  ) => {\n    setFilterationLoader(true);\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    nftQS.collectionId = location.state._id;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    if (keyword) nftQS.keyword = keyword;\n    if (buy) nftQS.buy = buy;\n    if (auction) nftQS.auction = auction;\n    if (latest) nftQS.latest = latest;\n\n    const qs = ENV.objectToQueryString(nftQS);\n\n    props.getNFTs(qs);\n  };\n\n  const handleSortOptions = (e) => {\n    setInitial(false);\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    setInitial(false);\n    setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      filter.gtePrice,\n      filter.ltePrice,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false);\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      id == \"Buy Now\" ? true : false,\n      id == \"On Auction\" ? true : false,\n      id == \"New\" ? true : false\n    );\n  };\n\n  const handleSearchKeyword = () => {\n    setInitial(false);\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n  ///////////Likes\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const { name, banner, logo, description, username } = location.state;\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n\n      <NavbarMain />\n      <Breadcrumb\n        title1={\"Collections\"}\n        title2={\"CollectionDetail\"}\n        title1Handler={() => history.push(\"/explore/exploreAll\")}\n      />\n      <div className=\"collection-detail-hero w-100\">\n        <img className=\"w-100\" src={BannerPh} alt=\"BannerImg\" />\n      </div>\n      <div className=\"collection-detail-content\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              <div className=\"collection-owner-avatar\">\n                <img src={logo} alt=\"owner-avatar\" />\n              </div>\n              <div className=\"d-md-flex align-items-center justify-content-between mt-5\">\n                <div className=\"collection-owner-detail\">\n                  <div className=\"collection-owner-name d-flex align-items-center\">\n                    <h3>\n                      {name}{\" \"}\n                      <img src={TickIcon} alt=\"tick-icon\" className=\"ms-2\" />\n                    </h3>\n                  </div>\n                  {username && username?.[0] && (\n                    <p>\n                      Created by <span>{username?.[0]}</span>\n                    </p>\n                  )}\n                </div>\n                <div className=\" d-block d-md-none\">\n                  <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                    <p>{description}</p>\n                  </div>\n                </div>\n                {/* <div className=\"collection-owner-btns mt-3 mt-md-0 ms-auto\">\n                      <button className=\"me-1 me-sm-2 me-lg-3\">\n                        <img src={FlagIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button className=\"me-1 me-sm-1 me-lg-3\">\n                        <img src={ShareIcon} alt=\"\" flag-icon />\n                      </button>\n                      <button>+ Add to wishlist</button>\n                    </div> */}\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-7 col-md-6 col-lg-5 d-none d-md-block\">\n              <div className=\"collection-owner-detail pe-xl-5 mt-4\">\n                <p>{description}</p>\n              </div>\n            </div>\n            {/* <div className=\"col-12 col-lg-7 mt-3 mt-sm-5\">\n                  <div className=\"d-flex align-items-center justify-content-center justify-content-lg-end\">\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>items</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Owner</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Prize floor</p>\n                    </div>\n                    <div className=\"collection-stats d-flex flex-column justify-content-center align-items-center text-center me-1\">\n                      <span>50</span>\n                      <p>Volume trade</p>\n                    </div>\n                  </div>\n                </div> */}\n          </div>\n          <div className=\"collections-listing padding-wrapper\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img\n                    src={SearchIcon}\n                    alt=\"search-icon\"\n                    className=\"ms-3\"\n                    onClick={handleSearchKeyword}\n                  />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                    onChange={(e) => setKeyword(e.target.value)}\n                    onKeyPress={(e) =>\n                      e.key === \"Enter\" && handleSearchKeyword()\n                    }\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option\n                            key={index}\n                            value={collection.label}\n                            disabled={disabled}\n                          >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {sortoptions &&\n                      sortoptions.map((collection, index) => {\n                        return (\n                          <option\n                            key={index}\n                            value={collection.label}\n                            disabled={disabled}\n                          >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                      onChangeMinPrice={onChangeMinPrice}\n                      onChangeMaxPrice={onChangeMaxPrice}\n                      minValue={minValue}\n                      maxValue={maxValue}\n                      applyMinMaxFilter={applyMinMaxFilter}\n                      handleStatusFilter={handleStatusFilter}\n                      disabled={disabled}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row mt-5\">\n            <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n              <FilterComponent\n                Status={filterData.status}\n                Chains={filterData.chains}\n                onChangeMinPrice={onChangeMinPrice}\n                onChangeMaxPrice={onChangeMaxPrice}\n                minValue={minValue}\n                maxValue={maxValue}\n                applyMinMaxFilter={applyMinMaxFilter}\n                handleStatusFilter={handleStatusFilter}\n                disabled={disabled}\n              />\n            </div>\n            <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n              <div className=\"row g-3\">\n                {filterationLoader ? (\n                  <div className=\"text-center\">\n                    <div\n                      class=\"spinner-border text-secondary text-white \"\n                      role=\"status\"\n                    >\n                      <span class=\"sr-only\">Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((listing) => {\n                    return (\n                      <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                        {listing.fileType === \"image\" ? (\n                          <ListingCards\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            sellingMethod={listing.sellingMethod}\n                          />\n                        ) : (\n                          <VideoCard\n                            CardImg={listing.image}\n                            name={listing.name}\n                            price={listing.currentPrice}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            id={listing._id}\n                            likesCount={listing.likeCount}\n                            likedNfts={likedNfts}\n                            ownerId={listing.ownerId}\n                            fileType={listing.fileType}\n                            sellingMethod={listing.sellingMethod}\n                          />\n                        )}\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-white mt-5 text-center no-nfts-title\">\n                    No NFT's Found\n                  </p>\n                )}\n              </div>\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {nfts && props.pagination > nfts.length && nfts.length > 10 && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  nfts: state.nft.nftsData.nfts,\n  pagination: state.nft.nftsData.pagination,\n  nftsAuth: state.nft.nftsAuth,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFTsByCollection,\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n})(CollectionDetailsPage);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504","505","506","507"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["508","509","510","511","512","513","514","515","516","517","518","519","520","521","522"],"import React, { useState, useEffect } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./allnft.css\";\nimport { beforeNFT, getNFTs, getMyLikedNfts } from \"../../nfts/nfts.action\";\nimport { ENV } from \"../../../config/config\";\nimport NavbarMain from \"../../navbar-main/NavbarMain\";\nimport Footer from \"../../footer/footer\";\nimport SearchIcon from \"../../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../../listing-cards/ListingCards\";\nimport FilterComponent from \"../../filter-component/FilterComponent\";\nimport { getCreators, beforeUser } from \"./../../user/user.action\";\nimport FullPageLoader from \"../../full-page-loader/full-page-loader\";\nimport { toggleLikeDislike, beforeTogleLikeDislike } from \"../explore.action\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../../collections/collections.actions\";\nimport Breadcrumb from \"../../breadcrumb/breadcrumb\";\nimport VideoCard from \"../../test-video-card/videoCard\";\nimport { validateNetwork } from \"../../../utils/web3\";\nimport { toast } from \"react-toastify\";\nconst AllNFT = (props) => {\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [collections, setCollections] = useState([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [keyword, setKeyword] = useState(\n    props?.location?.state ? props.location.state : \"\"\n  );\n  const [likedNfts, setLikedNfts] = useState();\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial, setInitial] = useState(true);\n  const [disabled, setDisabled] = useState(false);\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n  });\n  useEffect(() => {\n    if (props?.location?.state) {\n      setKeyword(props?.location?.state);\n      handleSearchKeyword(props?.location?.state);\n    }\n  }, [props?.location?.state]);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getCreators();\n    props.getCollections();\n    if (props?.location?.state) {\n      let searchQs = { keyword: props.location.state };\n      searchQs = ENV.objectToQueryString(searchQs);\n      props.getNFTs(searchQs);\n    } else {\n      getNFTs();\n    }\n\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n  }, []);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // props.beforeUser()\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  //Get Top Sellers\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      setCreator(props.user.sellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      setCreator(props.user.creators);\n      props.beforeUser();\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n\n  //Get NFt's\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nfts, pagination } = props.nft.nftsData;\n      if (nfts) {\n        if (nfts.length > 0) {\n          setDisabled(false);\n        } else {\n          if (initial) {\n            setDisabled(true);\n          }\n        }\n        setNFTs(nfts);\n        setNFTPagination(pagination);\n        setFilterationLoader(false);\n        props.beforeNFT();\n\n        setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  //pagination\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setCollections(props.collections);\n      props.beforeCollection();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter,\n    keyword,\n    buy,\n    auction,\n    latest\n  ) => {\n    const nftQS = { page, limit };\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    if (keyword) nftQS.keyword = keyword;\n    if (buy) nftQS.buy = buy;\n    if (auction) nftQS.auction = auction;\n    if (latest) nftQS.latest = latest;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string of all nfts\");\n    props.getNFTs(qs);\n  };\n\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const sortoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  const handleSortOptions = (e) => {\n    setFilterationLoader(true);\n    setInitial(false);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      filter.gtePrice,\n      filter.ltePrice,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      id,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleSearchKeyword = (value) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      value ? value : keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    getNFTs(\n      filter.page,\n      filter.limit,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      id == \"Buy Now\" ? true : false,\n      id == \"On Auction\" ? true : false,\n      id == \"New\" ? true : false\n    );\n  };\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n  console.log(nfts,\"nfts=>\")\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Explore\"} title2={\"All NFT\"} />\n      <div className=\"collection-detail-content all-nft-content\">\n        <div className=\"container padding-wrapper pb-1\">\n          <div className=\"collections-listing\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0 position-relative\">\n                  <img\n                    src={SearchIcon}\n                    alt=\"search-icon\"\n                    className=\"ms-3\"\n                    onClick={handleSearchKeyword}\n                  />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                    onChange={(e) => setKeyword(e.target.value)}\n                    onKeyPress={(e) =>\n                      e.key === \"Enter\" && handleSearchKeyword()\n                    }\n                    value={keyword}\n                  />\n                  {/* <IoCloseSharp className=\"position-absolute input-clear\"/> */}\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option\n                            key={index}\n                            value={collection.label}\n                            disabled={disabled}\n                          >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {sortoptions &&\n                      sortoptions.map((collection, index) => {\n                        return (\n                          <option\n                            key={index}\n                            value={collection.label}\n                            disabled={disabled}\n                          >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Collections={collections}\n                      collectionsLabel={\"Collections\"}\n                      onChangeMinPrice={onChangeMinPrice}\n                      onChangeMaxPrice={onChangeMaxPrice}\n                      minValue={minValue}\n                      maxValue={maxValue}\n                      applyMinMaxFilter={applyMinMaxFilter}\n                      handleCollectionsFilter={handleCollectionsFilter}\n                      handleStatusFilter={handleStatusFilter}\n                      disabled={disabled}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-12\">\n                <div className=\"no-of-items text-end mb-3\">\n                  <p>\n                    {nfts?.length}\n                    {\"  items\"}\n                  </p>\n                </div>\n              </div>\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Collections={collections}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                  handleStatusFilter={handleStatusFilter}\n                  disabled={disabled}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9\">\n                {loader ? (\n                  <FullPageLoader />\n                ) : (\n                  <div className=\"row g-3\">\n                    {filterationLoader ? (\n                      <div className=\"text-center\">\n                        <div\n                          className=\"spinner-border text-secondary text-white \"\n                          role=\"status\"\n                        >\n                          <span className=\"sr-only\">Loading...</span>\n                        </div>\n                      </div>\n                    ) : nfts && nfts.length > 0 ? (\n                      nfts.map((listing, index) => {\n                        return (\n                          <div\n                            key={index}\n                            className=\"col-6 col-md-4 col-lg-3 px-1\"\n                          >\n                            {listing.fileType === \"image\" ? (\n                              <ListingCards\n                                CardImg={listing.image}\n                                name={listing.name}\n                                price={listing.currentPrice}\n                                handleLikesTogleApi={handleLikesTogleApi}\n                                id={listing._id}\n                                likesCount={listing.likeCount}\n                                likedNfts={likedNfts}\n                                ownerId={listing.ownerId}\n                                fileType={listing.fileType}\n                                sellingMethod={listing.sellingMethod}\n                                auctionStartDate={listing?.auctionStartDate}\n                                auctionEndDate={listing?.auctionEndDate}\n                              />\n                            ) : (\n                              <VideoCard\n                                CardImg={listing.image}\n                                name={listing.name}\n                                price={listing.currentPrice}\n                                handleLikesTogleApi={handleLikesTogleApi}\n                                id={listing._id}\n                                likesCount={listing.likeCount}\n                                likedNfts={likedNfts}\n                                ownerId={listing.ownerId}\n                                fileType={listing.fileType}\n                                sellingMethod={listing.sellingMethod}\n                                auctionStartDate={listing?.auctionStartDate}\n                                auctionEndDate={listing?.auctionEndDate}\n                              />\n                            )}\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-white text-center mt-5 no-nft-title\">\n                        No NFTs Found\n                      </p>\n                    )}\n                    <div className=\"col-12\">\n                      <div className=\"mt-5 text-center\">\n                        {nftPagination?.total === nfts?.length\n                          ? \"\"\n                          : !filterationLoader && (\n                              <button\n                                className=\"btn btn-linear-gradient px-5\"\n                                onClick={() => handlePagination()}\n                              >\n                                Load more\n                              </button>\n                            )}\n                      </div>\n                    </div>\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"all-nft-footer\">\n        <Footer />\n      </div>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n \n  {\n  nft: state.nft,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  user: state.user,\n  getAuth: state.collection.getAuth,\n  collections: state.collection.collections,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFTs,\n  getCreators,\n  toggleLikeDislike,\n  getCollections,\n  getMyLikedNfts,\n  beforeCollection,\n  beforeUser,\n  beforeTogleLikeDislike,\n})(AllNFT);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["523"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["524","525","526","527","528","529","530","531","532"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { connect } from \"react-redux\";\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\nimport { getCreators } from \"./../user/user.action\";\nimport {\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { ENV } from \"../../config/config\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\n\nconst AuctionsList = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [auctions, setAuctions] = useState(null);\n  const [loader, setLoader] = useState(false); // auctions loader\n  const [creators, setCreator] = useState([]);\n  const [categories, setCategories] = useState([]);\n  const [categoryId, setCategoryId] = useState(\"all\");\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    // get live auctions\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n    props.getCreators();\n  }, []);\n\n  // set live auctions\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions, pagination } = props.auction;\n\n      setAuctions(auctions);\n      props.beforeAuction();\n    }\n  }, [props.auction.auctionsAuth]);\n  useEffect(() => {\n    props.getCategories();\n  }, []);\n  useEffect(() => {\n    if (props.collectionFlag) {\n      setCategories(props.categories);\n    }\n  }, [props.collectionFlag]);\n\n  const handleCategoryFilter = (desc) => {\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getLiveAuctions(qs);\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Auctions\"} title2={\"LiveAuctions\"} />\n      <section className=\"explore-collection-section padding-wrapper\">\n        {loader ? (\n          <FullPageLoader />\n        ) : (\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Auctions</span>\n                    <h3 className=\"mb-0\">Live Auctions</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(id);\n                            handleCategoryFilter(item.description);\n                          }}\n                          className={`${\n                            id === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\">\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-4 align-items-center justify-content-center\">\n              {auctions && auctions.length > 0 ? (\n                auctions.map((item) => {\n                  return (\n                    <div className=\"col-11 col-sm-6 col-md-5 col-lg-4 col-xl-3\">\n                      <AuctionsCards\n                        endDate={item.auctionEndDate}\n                        image={item.image}\n                        ownerName={item.owner.username}\n                        name={item.name}\n                        id={item._id}\n                        fileType={item.fileType}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-white text-center\">No Live Auctions Found</p>\n              )}\n\n              <div className=\"col-12\">\n                <div className=\"mt-5 text-center\">\n                  {auctions &&\n                    props.auction.pagination.total > auctions.length &&\n                    auctions.length > 10 && (\n                      <button className=\"btn btn-linear-gradient px-5\">\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  auction: state.auction,\n  user: state.user,\n  collectionFlag: state.collection.collectionFlag,\n  categories: state.collection.categories,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n  getCreators,\n  getCategories,\n  beforeCategory,\n})(AuctionsList);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["533","534","535","536","537","538","539","540","541","542","543","544","545","546","547","548","549","550","551"],"import React, { useState, useEffect } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport { connect } from \"react-redux\";\nimport \"./UserProfile.css\";\nimport { ENV } from \"../../config/config\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport ListingCards from \"../listing-cards/ListingCards\";\nimport FilterComponent from \"../filter-component/FilterComponent\";\nimport BannerImg from \"../../assets/images/collection-detailBg.png\";\nimport { getProfileNfts, beforeNFT, getMyLikedNfts } from \"../nfts/nfts.action\";\nimport {\n  toggleLikeDislike,\n  beforeTogleLikeDislike,\n} from \"../explore/explore.action\";\nimport { getUserById, beforeUser } from \"../user/user.action\";\nimport { Images } from \"../../assets/assets\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport { Link } from \"react-router-dom\";\nimport VideoCard from \"../test-video-card/videoCard\";\nimport {\n  validateNetwork,\n} from \"../../utils/web3\";\nimport { toast } from \"react-toastify\";\n\nconst UserProfile = (props) => {\n  const [isActive, setIsActive] = useState(0);\n  const [isAddressCopied, setAddressCopied] = useState(false);\n  const [activeFilter, setActiveFilter] = useState(false);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [nftsCopy, setNFTsCopy] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const [minValue, setMinValue] = useState(\"\");\n  const [maxValue, setMaxValue] = useState(\"\");\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [user, setUser] = useState(\"\");\n  const [likedNfts, setLikedNfts] = useState();\n  const [keyword, setKeyword] = useState(\"\");\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [initial,setInitial]=useState(true)\n  const [disabled,setDisabled]=useState(false)\n  const [filter, setFilter] = useState({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n  });\n  const [menuFilter, setMenuFilter] = useState(\"\");\n  const itemoptions = [\n    { value: \"single\", label: \"Single\" },\n    { value: \"double\", label: \"Double\" },\n  ];\n\n  const priceoptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recantly Created\" },\n  ];\n\n  useEffect(() => {\n    let qs = { ownerId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getProfileNfts(qs);\n    let likedNftsQs = { userId: ENV.getUserKeys(\"_id\")._id };\n    likedNftsQs = ENV.objectToQueryString(likedNftsQs);\n    props.getMyLikedNfts(likedNftsQs);\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n\n  useEffect(() => {\n    if (props.profileNFTsStatus) {\n      if (!menuFilter) {\n        const Nfts = props.profileNFTs.nfts.filter(\n          (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n        );\n        if(Nfts.length>0){\n          setDisabled(false)\n        }\n        else {\n          if(initial){\n\n            setDisabled(true) \n          }\n\n        }\n        setNFTs(Nfts);\n        setNFTsCopy(props.profileNFTs.nfts);\n        setLoader(false);\n        setFilterationLoader(false);\n      } else {\n        setNFTsCopy(props.profileNFTs.nfts);\n        handleNftFilter(menuFilter);\n        setLoader(false);\n        setFilterationLoader(false);\n      }\n    }\n  }, [props.profileNFTsStatus]);\n\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    const { individualUserAuth, individualUser } = props;\n    if (individualUserAuth) {\n      setUser(individualUser);\n    }\n  }, [props.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const ChangeTooltip = () =>\n    setTimeout(() => {\n      setAddressCopied(false);\n    }, 1000);\n  const getNFTs = (\n    page = 1,\n    limit = 10,\n    collectionIdFilter,\n    gtePriceFilter,\n    ltePriceFilter,\n    categoryIdFilter,\n    oldestFilter,\n    lowToHighFilter,\n    highToLowFilter,\n    newestFilter,\n    keyword,\n    buy,\n    auction,\n    latest\n  ) => {\n    props.beforeNFT();\n    const nftQS = { page, limit };\n\n    if (collectionIdFilter) nftQS.collectionId = collectionIdFilter;\n    if (gtePriceFilter) nftQS.gtePrice = gtePriceFilter;\n    if (gtePriceFilter) nftQS.ltePrice = ltePriceFilter;\n    if (categoryIdFilter) nftQS.categoryId = categoryIdFilter;\n    if (oldestFilter) nftQS.oldest = oldestFilter;\n    if (lowToHighFilter) nftQS.lowToHigh = lowToHighFilter;\n    if (highToLowFilter) nftQS.highToLow = highToLowFilter;\n    if (newestFilter) nftQS.newest = newestFilter;\n    if (keyword) nftQS.keyword = keyword;\n    if (buy) nftQS.buy = buy;\n    if (auction) nftQS.auction = auction;\n    if (latest) nftQS.latest = latest;\n\n    nftQS.ownerId = ENV.getUserKeys(\"_id\")._id;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    console.log(qs, \"query string\");\n    props.getProfileNfts(qs);\n  };\n  const handleSortOptions = (e) => {\n    setInitial(false)\n    setFilterationLoader(true);\n\n    const { value } = e.target;\n\n    if (value === \"Low To High\") {\n      setFilter((prev) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        true,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"High To Low\") {\n      setFilter((prev) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        true,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Oldest\") {\n      setFilter((prev) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        true,\n        false,\n        false,\n        false,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else if (value === \"Recantly Created\") {\n      setFilter((prev) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n      getNFTs(\n        filter.page,\n        filter.limit,\n        filter.collectionId ? filter.collectionId : false,\n        filter.gtePrice,\n        filter.ltePrice,\n        false,\n        false,\n        false,\n        false,\n        true,\n        keyword,\n        filter.buy,\n        filter.auction,\n        filter.latest\n      );\n    } else {\n    }\n    // setDetails(prev => ({...prev, name: target.value}))\n  };\n  const onChangeMinPrice = (e) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e) => {\n    setMaxValue(e.target.value);\n  };\n\n  const filterData = {\n    status: {\n      label: \"Status\",\n      option: [\"Buy Now\", \"On Auction\", \"New\", \"Has Offer\"],\n    },\n    collections: {\n      label: \"Collections\",\n      option: [\"Art\", \"Music\"],\n    },\n  };\n\n  const handlePagination = () => {\n    setInitial(false)\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, limit: filter.limit + 10 }));\n    getNFTs(\n      filter.page,\n      filter.filter.limit + 10,\n      filter.collectionId,\n      filter.gtePrice,\n      filter.ltePrice,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false)\n    setFilterationLoader(true);\n    setFilter((prev) => ({ ...prev, gtePrice: minValue, ltePrice: maxValue }));\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleCollectionsFilter = (id) => {\n    setInitial(false)\n    setFilterationLoader(true);\n\n    setFilter((prev) => ({ ...prev, collectionId: id }));\n    getNFTs(\n      filter.page,\n      filter.limit,\n      id,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleSearchKeyword = () => {\n    setInitial(false)\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      filter.buy,\n      filter.auction,\n      filter.latest\n    );\n  };\n\n  const handleStatusFilter = (id) => {\n    setInitial(false)\n    getNFTs(\n      filter.page,\n      filter.limit + 10,\n      filter.collectionId,\n      minValue,\n      maxValue,\n      filter.categoryId,\n      filter.oldest,\n      filter.lowToHigh,\n      filter.highToLow,\n      filter.newest,\n      keyword,\n      id == \"Buy Now\" ? true : false,\n      id == \"On Auction\" ? true : false,\n      id == \"New\" ? true : false\n    );\n  };\n  const handleLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n    if (!likeButtonDisable) {\n      setLikeBtnDisable(true);\n      let userId = ENV.getUserKeys(\"_id\")._id;\n\n      let data = {\n        userId,\n        nftId,\n        count: 1,\n      };\n      if ((status === \"dislike\") & (likesCount > 0)) {\n        let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n        setLikedNfts(result);\n        increOrDecreLikes(nftId, \"dec\");\n        props.toggleLikeDislike(data);\n      }\n      if (status === \"like\") {\n        let myLikedNfts = [];\n        if (likedNfts && likedNfts.length > 0) {\n          myLikedNfts = likedNfts;\n        }\n\n        let obj = {\n          _id: \"1234455\",\n          nftId,\n        };\n\n        myLikedNfts.push(obj);\n\n        setLikedNfts(myLikedNfts);\n        increOrDecreLikes(nftId, \"inc\");\n        props.toggleLikeDislike(data);\n      }\n      // setNFTs(nfts);\n    }\n  }else {\n    toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n  }\n  };\n\n  const increOrDecreLikes = (id, status) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n\n  const handleNftFilter = (id) => {\n    if (id === \"Collected\") {\n      const Nfts = nftsCopy.filter(\n        (item) => item.creatorId !== ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else if (id === \"Created\") {\n      const Nfts = nftsCopy.filter(\n        (item) =>\n          item.ownerId === ENV.getUserKeys(\"_id\")._id &&\n          item.creatorId === ENV.getUserKeys(\"_id\")._id\n      );\n      setNFTs(Nfts);\n    } else {\n      handleFavFilter();\n    }\n  };\n\n  const handleFavFilter = () => {\n    let favNfts = [];\n    nftsCopy.map((item) => {\n      let foundNft = likedNfts.find((liked) => liked.nftId === item._id);\n      if (foundNft) {\n        favNfts.push(item);\n      }\n    });\n\n    setNFTs(favNfts);\n  };\n\n  const menuData = [\"Collected\", \"Created\", \"Favourited\"];\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"User\"} title2={\"UserProfile\"} />\n      <div className=\"collection-detail-hero\">\n        <img\n          className=\"w-100\"\n          src={user?.bannerImage ? user?.bannerImage : BannerImg}\n          alt=\"BannerImg\"\n        />\n      </div>\n      <div className=\"collection-detail-content\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12\">\n              <div className=\"collection-owner-avatar user-avatar-container text-center\">\n                <img\n                  src={\n                    user?.profileImage\n                      ? user.profileImage\n                      : Images.placeholderImg\n                  }\n                  alt=\"owner-avatar\"\n                />\n                <div className=\"edit-btn-container\">\n                  <Link to=\"/editprofile\" className=\"btn-edit-profile\">\n                    <i class=\"fas fa-edit\"></i>\n                    <p className=\"ms-1\">Edit</p>\n                  </Link>\n                </div>\n              </div>\n              <div className=\"collection-owner-detail text-center mt-3\">\n                {user && (\n                  <div className=\"collection-owner-name\">\n                    <h3>{user.username ? user.username : \"unnamed\"}</h3>\n                  </div>\n                )}\n                <div\n                  className=\"user-address mt-4 d-flex align-items-center \"\n                  onClick={() => {\n                    navigator.clipboard.writeText(user.address);\n                    setAddressCopied(true);\n                    ChangeTooltip();\n                  }}\n                >\n                  <span>{isAddressCopied ? \"Copied\" : \"Copy\"}</span>\n                  {user && (\n                    <>\n                      <i className=\"fab fa-ethereum\"></i>\n                      <p className=\"acc-adress\">\n                        {user.address.slice(0, 10) +\n                          \"...\" +\n                          user.address.slice(-10)}\n                      </p>\n                    </>\n                  )}\n                </div>\n                {user && (\n                  <p>\n                    Joined <span>February 2022</span>\n                  </p>\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"collections-listing padding-wrapper\">\n            <div className=\"row g-3 align-items-center justify-content-center justify-content-lg-start \">\n              <div className=\"col-12\">\n                <div className=\"explore-collection-section\">\n                  <div className=\"explore-collection-nav\">\n                    <div className=\"d-flex justify-content-center justify-content-md-end align-items-center\">\n                      {menuData.map((item, id) => {\n                        return (\n                          <button\n                            onClick={() => {\n                              setIsActive(id);\n                              handleNftFilter(item);\n                              setMenuFilter(item);\n                            }}\n                            className={`${\n                              id === isActive ? \"active-explore-nav\" : \"\"\n                            } me-2 me-xl-3`}\n                            // disabled={disabled}\n                          >\n                            {item}\n                          </button>\n                        );\n                      })}\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-search-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <img\n                    src={SearchIcon}\n                    alt=\"search-icon\"\n                    className=\"ms-3\"\n                    onClick={handleSearchKeyword}\n                  />\n                  <input\n                    type=\"text\"\n                    className=\"form-control\"\n                    placeholder=\"Search\"\n                    onChange={(e) => setKeyword(e.target.value)}\n                    onKeyPress={(e) =>\n                      e.key === \"Enter\" && handleSearchKeyword()\n                    }\n                  />\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Item:</p>\n                  </div>\n                  <select name=\"collection-select\">\n                    {itemoptions &&\n                      itemoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label} >\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-4 col-lg-3\">\n                <div className=\"collection-select-bar d-flex align-items-center justify-content-around mx-auto mx-md-0\">\n                  <div className=\"ms-2\">\n                    <p>Sort:</p>\n                  </div>\n\n                  <select name=\"collection-select\" onChange={handleSortOptions}>\n                    {priceoptions &&\n                      priceoptions.map((collection, index) => {\n                        return (\n                          <option key={index} value={collection.label} disabled={disabled}>\n                            {collection.label}\n                          </option>\n                        );\n                      })}\n                  </select>\n                </div>\n              </div>\n              <div className=\"col-12 d-sm-none\">\n                <div className=\"sm-filter-btn d-flex align-items-center justify-content-center\">\n                  <button\n                    className={`${\n                      activeFilter ? \"filter-btn-active\" : \"filter-btn-inactive\"\n                    } ps-2`}\n                    onClick={() => setActiveFilter(!activeFilter)}\n                  >\n                    Filters\n                  </button>\n                </div>\n                <div\n                  className={`${\n                    activeFilter ? \"d-block\" : \"d-none\"\n                  } sm-filter-options`}\n                >\n                  <div className=\"col-10 mx-auto mt-2\">\n                    <FilterComponent\n                      Status={filterData.status}\n                      Chains={filterData.chains}\n                      collectionsLabel={\"Collections\"}\n                      onChangeMinPrice={onChangeMinPrice}\n                      onChangeMaxPrice={onChangeMaxPrice}\n                      minValue={minValue}\n                      maxValue={maxValue}\n                      applyMinMaxFilter={applyMinMaxFilter}\n                      handleCollectionsFilter={handleCollectionsFilter}\n                      handleStatusFilter={handleStatusFilter}\n                      disabled={disabled}\n                    />\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"row mt-5\">\n              <div className=\"col-10 col-sm-4 col-md-3 col-lg-3 d-none d-sm-block\">\n                <FilterComponent\n                  Status={filterData.status}\n                  Chains={filterData.chains}\n                  collectionsLabel={\"Collections\"}\n                  onChangeMinPrice={onChangeMinPrice}\n                  onChangeMaxPrice={onChangeMaxPrice}\n                  minValue={minValue}\n                  maxValue={maxValue}\n                  applyMinMaxFilter={applyMinMaxFilter}\n                  handleCollectionsFilter={handleCollectionsFilter}\n                  handleStatusFilter={handleStatusFilter}\n                  disabled={disabled}\n                />\n              </div>\n              <div className=\"col-12 col-sm-8 col-md-9 col-lg-9 mt-5 mt-sm-0\">\n                <div className=\"row g-3\">\n                  {filterationLoader ? (\n                    <div className=\"text-center\">\n                      <div\n                        class=\"spinner-border text-secondary text-white \"\n                        role=\"status\"\n                      >\n                        <span class=\"sr-only\">Loading...</span>\n                      </div>\n                    </div>\n                  ) : nfts && nfts.length > 0 ? (\n                    nfts.map((listing) => {\n                      return (\n                        <div className=\"col-6 col-md-4 col-lg-3 px-1\">\n                          {listing.fileType === \"image\" ? (\n                            <ListingCards\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                              ownerId={listing.ownerId}\n                              sellingMethod={listing.sellingMethod}\n                              // userProfile\n                            />\n                          ) : (\n                            <VideoCard\n                              CardImg={listing.image}\n                              name={listing.name}\n                              price={listing.currentPrice}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              id={listing._id}\n                              likesCount={listing.likeCount}\n                              likedNfts={likedNfts}\n                              ownerId={listing.ownerId}\n                              fileType={listing.fileType}\n                              sellingMethod={listing.sellingMethod}\n                            />\n                          )}\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-white text-center mt-5\">No NFTs Found</p>\n                  )}\n                </div>\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      props.profileNFTs.pagination > nfts.length &&\n                      nfts.length > 10 && (\n                        <button\n                          className=\"btn btn-linear-gradient px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  profileNFTs: state.nft.profileNFTs,\n  profileNFTsStatus: state.nft.profileNFTsStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  individualUser: state.user.individualUser,\n  individualUserAuth: state.user.individualUserAuth,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getProfileNfts,\n  beforeNFT,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  getUserById,\n  beforeUser,\n  beforeTogleLikeDislike,\n})(UserProfile);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["552","553","554","555","556","557","558","559","560","561","562","563","564","565","566","567","568","569"],"import React, { useEffect, useState } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport \"./user-edit-profile.css\";\nimport { editImages } from \"../../assets/assets\";\nimport { ReactComponent as ProfileEditSVG } from \"../../assets/images/edit-pen.svg\";\n/////////\n\nimport { connect } from \"react-redux\";\nimport { SET_INDIVIDUAL_USER } from \"../../redux/types\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n} from \"./../user/user.action\";\nimport { signRequest } from \"./../../utils/web3\";\nimport { ENV } from \"./../../config/config\";\nimport { toast } from \"react-toastify\";\nimport { useHistory } from \"react-router-dom\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\n\nconst EditProfile = (props) => {\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [facebookLink, setFbLink] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [gPlusLink, setgPlusLink] = useState(\"\");\n  const [vineLink, setVineLink] = useState(\"\");\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const [bioError, setBioError] = useState(false);\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n\n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      props.beforeUser();\n      setLoader(false);\n\n      setConnectedAddress(address ? address : \"\");\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      setBannerUrl(bannerImage ? bannerImage : \"\");\n      setImage(profileImage ? profileImage : \"\");\n      setBannerImage(bannerImage ? bannerImage : \"\");\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n      setLoader(false);\n      props.beforeUser();\n      history.push(\"/userprofile\");\n    }\n  }, [props.user.userAuth]);\n\n  useEffect(() => {\n    if (props.error) {\n      setErrors(props.error.message);\n      goToTop();\n    }\n  }, [props.error]);\n\n  const goToTop = () => {\n    $(\"html, body\").animate(\n      {\n        scrollTop: 0,\n      },\n      600\n    );\n  };\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setImageUrl(fileURL);\n      setImage(file);\n    }\n  };\n\n  const onBannerChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setBannerUrl(fileURL);\n      setBannerImage(file);\n    }\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    let obj = {\n      image,\n      banner,\n      username,\n      instaLink,\n      webLink,\n      description,\n      email,\n      address,\n      instaLink,\n      twitterLink,\n    };\n    if (description && description.length < 3) {\n      setBioError(true);\n      return \"\";\n    } else {\n      setBioError(false);\n    }\n    setErrors(\"\");\n    setLoader(true);\n    setIsSubmitted(true);\n    let isFormValid = validator.allValid() ? true : false;\n    if (isFormValid) {\n      try {\n        // let signature = await signRequest();\n        setLoader(true);\n\n        var formData = new FormData();\n        formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n        if (image) {\n          formData.append(\"profileImage\", image);\n        }\n        if (banner) {\n          formData.append(\"bannerImage\", banner);\n        }\n        formData.append(\"bio\", description);\n        formData.append(\"twitterLink\", twitterLink);\n        formData.append(\"username\", username);\n        formData.append(\"email\", email);\n        formData.append(\"webLink\", webLink);\n        formData.append(\"instaLink\", instaLink);\n\n        // return ''\n        props.updateProfile(formData);\n      } catch (e) {\n        console.log(\"in catch block\");\n        setLoader(false);\n      }\n    } else {\n      validator.showMessages();\n      setErrors(\"Please fill all required fields in valid format.\");\n      goToTop();\n    }\n  };\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n      <NavbarMain />\n      <Breadcrumb title1={\"Profile\"} title2={\"EditProfile\"} />\n      <section className=\"edit-profile padding-wrapper\">\n        <form onSubmit={submit}>\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Set Up Your Profile</span>\n                    <h3 className=\"mb-0\">Profile Setting</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                <div className=\"edit-inp-subheading\">\n                  <h6>Profile Image</h6>\n                </div>\n                <div className=\"edit-avatar pt-4\">\n                  <img\n                    src={imageUrl ? imageUrl : editImages.EditAvatar}\n                    alt=\"editavatar\"\n                  />\n\n                  <label>\n                    <div className=\"avatar-btn-pen\">\n                      <ProfileEditSVG />\n                    </div>\n                    <input\n                      type=\"file\"\n                      accept=\".png,.jpeg,.jpg\"\n                      onChange={(e) => onFileChange(e)}\n                      style={{ display: \"none\" }}\n                      name=\"image\"\n                    />\n                  </label>\n                </div>\n                <div className=\"edit-banner-container\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Profile Banner</h6>\n                  </div>\n                  <div className=\"edit-banner pt-4\">\n                    <img\n                      src={bannerUrl ? bannerUrl : editImages.EditBanner}\n                      alt=\"editavatar\"\n                    />\n                    <label>\n                      <div className=\"banner-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => onBannerChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"banner\"\n                      />\n                    </label>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                <div className=\"row g-4\">\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Username</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"username\"\n                        placeholder=\"User Name\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        onChange={(e) => setUsername(e.target.value)}\n                        defaultValue={username}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"username\", username, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Email Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"email\"\n                        placeholder=\"Email Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        readOnly\n                        value={email}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"email\", email, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Wallet Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"address\"\n                        placeholder=\"Wallet Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        value={address}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"address\", address, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-8\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Bio</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      {bioError && (\n                        <p className=\"text-danger \">Minimum 3 words required</p>\n                      )}\n                      <textarea\n                        name=\"bio\"\n                        placeholder=\"Bio\"\n                        maxLength=\"300\"\n                        onChange={(e) => setDescription(e.target.value)}\n                        defaultValue={description}\n                      ></textarea>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Links</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Twitter}\n                          alt=\"twitterlink\"\n                        />\n                        <input\n                          name=\"twitterlink\"\n                          placeholder=\"Twitter Link\"\n                          autocomplete=\"off\"\n                          type=\"url\"\n                          onChange={(e) => setTwitterLink(e.target.value)}\n                          defaultValue={twitterLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Insta}\n                          alt=\"instalink\"\n                        />\n                        <input\n                          name=\"instagramlink\"\n                          placeholder=\"Instagram Link\"\n                          type=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => setInstaLink(e.target.value)}\n                          defaultValue={instaLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Website}\n                          alt=\"websitelink\"\n                        />\n                        <input\n                          name=\"websitelink\"\n                          placeholder=\"Website Link\"\n                          ype=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => setWebLink(e.target.value)}\n                          defaultValue={webLink}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                <div className=\"\">\n                  <button className=\"btn btn-linear-gradient\">\n                    Save changes\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </form>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n})(EditProfile);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["570","571","572","573","574","575"],"import React, { Component } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport \"./CreateCollections.css\";\nimport { editImages } from \"../../assets/assets\";\nimport { ReactComponent as ProfileEditSVG } from \"../../assets/images/edit-pen.svg\";\nimport CollectionUploadIcon from \"../../assets/images/collection-upload-icon.svg\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport UploadIcon from \"../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\n\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        logoUrl: \"\",\n        bannerUrl: \"\",\n        featuredImgUrl: \"\",\n        description: \"\",\n      },\n      categories: null,\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate() {\n    if (this.props.error) {\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      this.setState({ categories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: \"\", featuredImgUrl: \"\" };\n    this.setState({ collection });\n  };\n\n  render() {\n    const { collection, errors, loader, isSubmitted, categories } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      return (\n        <>\n          <NavbarMain />\n          <Breadcrumb title1={\"Create\"} title2={\"Create Collection\"} />\n          <section className=\"edit-profile padding-wrapper create-collection-container\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Create Now</span>\n                      <h3 className=\"mb-0\">Create New Collection</h3>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Logo Image</h6>\n                    <span className=\"text-danger\">\n                      {this.validator.message(\n                        \"logo\",\n                        collection.logo,\n                        \"required\"\n                      )}\n                    </span>\n                  </div>\n                  <div className=\"collection-logo-container pt-2\">\n                    {collection && collection.logo ? (\n                      <img\n                        src={collection.logoUrl}\n                        className=\"colection-avatar-img\"\n                      />\n                    ) : (\n                      <div className=\"colection-avatar\"></div>\n                    )}\n                    <label>\n                      <div className=\"avatar-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        id=\"logo\"\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => this.onFileChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"logo\"\n                      />\n                    </label>\n                  </div>\n                  <div className=\"\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Featured Image</h6>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"logo\",\n                          collection.featuredImg,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-featured-container\">\n                      {collection && collection.featuredImg ? (\n                        <div className=\"uploaded-featured-container\">\n                          <img\n                            src={collection.featuredImgUrl}\n                            className=\"uploaded-featured-img\"\n                          />\n                          <div className=\"uploaded-featured-hover w-100\">\n                            <div className=\"uploaded-featured-cross\">\n                              <MdClose\n                                color=\"#e33d0bc2\"\n                                className=\"uploaded-cross-icon\"\n                                onClick={() => this.clearData()}\n                              />\n                            </div>\n                            <label>\n                              <div className=\"text-center\">\n                                <img src={UploadIcon} alt=\"upload-icon\" />\n                              </div>\n                              <input\n                                id=\"featuredImg\"\n                                type=\"file\"\n                                accept=\".png,.jpeg,.jpg\"\n                                style={{ display: \"none\" }}\n                                name=\"featuredImg\"\n                                onChange={(e) => this.onFileChange(e)}\n                              />\n                            </label>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className=\"upload-featured-img\">\n                          <label>\n                            <div className=\"text-center\">\n                              <img\n                                src={CollectionUploadIcon}\n                                alt=\"upload-icon\"\n                              />\n                            </div>\n                            <div className=\"upload-featured-img-content pt-2\">\n                              <h6 className=\"pb-1\">Browse Files</h6>\n                              <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                            </div>\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                          </label>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Name</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"name\",\n                            collection.name,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"name\"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.name}\n                          placeholder=\"Name\"\n                          maxLength=\"55\"\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>URL</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\"url\", collection.url, \"url\")}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"url\"\n                          type=\"text\"\n                          name=\"url\"\n                          placeholder=\"URL\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.url}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Select Category</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"category\",\n                            collection.categoryId,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <select\n                          id=\"category\"\n                          name=\"categoryId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Select Collection\n                          </option>\n                          {categories &&\n                            categories.map((category, index) => {\n                              return (\n                                <option key={index} value={category._id}>\n                                  {category.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                      </div>\n                    </div>\n                    <div className=\"col-md-8\">\n                      <div className=\"edit-inp-subheading pt-4\">\n                        <h6>Discription</h6>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <textarea\n                          name=\"description\"\n                          placeholder=\"Discription\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.description}\n                          maxLength=\"150\"\n                        ></textarea>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                  <div className=\"\">\n                    <button\n                      type=\"button\"\n                      className=\"btn btn-linear-gradient\"\n                      onClick={(e) => this.submit(e)}\n                    >\n                      Create Collection\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n          <Footer />\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/reducer/reducer.js",["576"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user/user.reducer.js",["577"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.reducer.js",["578"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["579"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["580"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["581"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["582"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["583","584","585","586","587","588"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from 'react';\nimport NavbarMain from '../navbar-main/NavbarMain';\nimport CollectionsCard from '../collections-cards/CollectionsCard';\nimport Footer from '../footer/footer';\nimport { connect } from 'react-redux';\nimport { ENV } from '../../config/config';\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from '../collections/collections.actions';\nimport FullPageLoader from '../full-page-loader/full-page-loader';\n\nimport Breadcrumb from '../breadcrumb/breadcrumb';\nimport { Images } from '../../assets/assets';\n\nconst Populars = forwardRef((props, ref) => {\n  const [popular, setpopular] = useState([]);\n  const [isActive, setIsActive] = useState('All');\n  const [collections, setCollections] = useState(null);\n\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState('all');\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getPopularCollections(null, 1);\n    const qs = ENV.objectToQueryString({\n      myFilter: 'all',\n    });\n\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      const pagination = props.popularCollections.pagination;\n\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n\n      setPagination(pagination);\n      const userId = ENV.getUserKeys('_id')._id;\n      if (props.finalCollectionListing) {\n        let finalCollectionListing = finalCollectionListing.filter(\n          (item) => item.userId === userId\n        );\n        setpopular(finalCollectionListing);\n      } else {\n        if (finalCollectionListing === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setpopular(finalCollectionListing);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.getPopularAuth]);\n\n  const getPopularCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getPopularCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getPopularCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getPopularCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getPopularCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === 'image');\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={'Collections'} title2={'PopularCollections'} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className='explore-collection-section padding-wrapper'>\n          <div className='container'>\n            <div className='row mb-5'>\n              <div className='col-12'>\n                {/* Intro */}\n                <div className='intro'>\n                  <div className='intro-content'>\n                    <span>Most Popular</span>\n                    <h3 className='mb-0'>Popular Collections</h3>\n                  </div>\n                </div>\n              </div>\n              <div className='col-12 explore-collection-nav'>\n                <div className='d-none d-lg-flex justify-content-lg-end text-end align-items-center'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? 'active-explore-nav' : ''\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className='row justify-content-center justify-content-sm-start align-items-center text-center d-lg-none'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className='col-6 col-sm-3'>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? 'active-explore-nav' : ''\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className='row g-4 align-items-center justify-content-center'>\n              {loader ? (\n                <div class='spinner-border text-white' role='status'>\n                  <span class='sr-only'>Loading...</span>\n                </div>\n              ) : popular && popular.length > 0 ? (\n                popular.map((item) => {\n                  return (\n                    <div className='col-sm-6 col-lg-4'>\n                      <CollectionsCard\n                        CardImg={item.featuredImg}\n                        Subimg1={handleImage(item, 0)}\n                        Subimg2={handleImage(item, 1)}\n                        Subimg3={handleImage(item, 2)}\n                        name={item.name}\n                        id={item._id}\n                        collection={item}\n                        userName={item.username[0]}\n                        NFTCount={item.totalNfts}\n                        profileImage={item.profileImage[0]}\n                        // handleLikesTogle={handleLikesTogleApi}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className='text-center text-white not-found-title mt-5'>\n                  No popular collections Found\n                </p>\n              )}\n\n              <div className='col-12'>\n                <div className='mt-5 text-center'>\n                  {!empty &&\n                    popular?.length === 10 &&\n                    pagination.totalRecords > popular.length && (\n                      <button\n                        className='btn btn-linear-gradient px-5'\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforePopularCollection,\n    getPopularCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(Populars);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/explore-collections.js",["589","590","591","592"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n} from 'react';\n\nimport NavbarMain from '../navbar-main/NavbarMain';\nimport './explore-collections.css';\nimport CollectionsCard from '../collections-cards/CollectionsCard';\nimport Footer from '../footer/footer';\nimport { connect } from 'react-redux';\nimport { ENV } from '../../config/config';\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n} from './collections.actions';\nimport { Images } from '../../assets/assets';\n\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { beforeCategory, getCategories } from './collections.actions';\nimport Breadcrumb from '../breadcrumb/breadcrumb';\n\nconst ExploreCollections = forwardRef((props, ref) => {\n  const [isActive, setIsActive] = useState('All');\n  const [collections, setCollections] = useState(null);\n  const [categoriesLoader, setCatLoader] = useState(true); // categories loader\n  const [collectionsLoader, setColLoader] = useState(true); // collections loader\n  const [source, setSource] = useState(1); // 1 for my collections, 2 for popular collections\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState('');\n  const [categories, setCategories] = useState();\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (props.source) setSource(props.source);\n\n    if (props.setLoader) props.setLoader(false); //to be changed\n\n    getCollections(null, 1);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      // console.log('collections', collections.nftDetail);\n      const userId = ENV.getUserKeys('_id')._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (category, page, pageLimit) => {\n    const filter = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  useImperativeHandle(ref, () => ({\n    getCatCollections: (catId) => {\n      if (props.setLoader) props.setLoader(true);\n\n      getCollections(catId, page);\n    },\n    colCount: collections?.length || 0,\n  }));\n\n  const handlePagination = () => {\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n\n  const handleFilterCategory = (category) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter((nft) => nft.fileType === 'image');\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={'Explore'} title2={'Explore All'} />\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className='explore-collection-section padding-wrapper'>\n          <div className='container'>\n            <div className='row mb-5'>\n              <div className='col-12'>\n                <div className='intro'>\n                  <div className='intro-content'>\n                    <span>Collections</span>\n                    <h3 className='mb-0'>Explore all</h3>\n                  </div>\n                </div>\n              </div>\n              <div className='col-12 explore-collection-nav'>\n                <div className='d-none d-xxl-flex justify-content-lg-end text-end align-items-center'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <button\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? 'active-explore-nav' : ''\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className='row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item) => {\n                      return (\n                        <div className='col-6 col-sm-3'>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? 'active-explore-nav' : ''\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className='row g-4 align-items-center justify-content-center'>\n              {loader ? (\n                <div class='spinner-border text-white' role='status'>\n                  <span class='sr-only'>Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection) => {\n                  return (\n                    <div className='col-sm-6 col-lg-4'>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : ''\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className='text-center text-white not-found-title mt-5'>\n                  No Collections found\n                </p>\n              )}\n              <div className='col-12'>\n                <div className='mt-5 text-center'>\n                  {!empty &&\n                    collections?.length === 10 &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className='btn btn-linear-gradient px-5'\n                        onClick={() => handlePagination()}\n                      >\n                        Load more\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      )}\n      <Footer />\n    </>\n  );\n});\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n});\n\nexport default connect(\n  mapStateToProps,\n  {\n    beforeCollection,\n    getCollections,\n    beforeCategory,\n    getCategories,\n    toggleLikeDislike,\n  },\n  null,\n  { forwardRef: true }\n)(ExploreCollections);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/create-nft.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["593","594","595","596","597","598","599","600","601","602","603","604","605","606","607","608","609","610","611","612","613","614","615","616","617","618","619","620","621","622","623","624","625","626","627","628","629","630","631","632","633","634","635"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["636","637","638","639"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { Link } from 'react-router-dom';\nimport { ENV } from './../../config/config';\nimport { getTopSellers, beforeUser } from './../user/user.action';\nimport AvatarImg from '../../assets/images/seller-avatar.png';\nimport SellerTickIcon from '../../assets/images/seller-tick-icon.svg';\nimport './topseller.css';\nimport NavbarMain from '../navbar-main/NavbarMain';\nimport Footer from '../footer/footer';\nimport Breadcrumb from '../breadcrumb/breadcrumb';\nimport { Images } from '../../assets/assets';\n\nconst TopSellerList = (props) => {\n  const [sellers, setSellers] = useState([]);\n  // const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [pagination, setPagination] = useState(null);\n  const [empty, setEmpty] = useState(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    // setPage(page);\n    //setLimit(limit + 10);\n    let qs = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    //console.log('testing qurty string', qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={'Sellers'} title2={'TopSellers'} />\n      <section className='top-seller-area padding-wrapper'>\n        <div className='container'>\n          <div className='row'>\n            <div className='col-12'>\n              {/* Intro */}\n              <div className='intro d-flex justify-content-between align-items-end m-0'>\n                <div className='intro-content'>\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className='mb-0'>Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className='row items'>\n            {sellers && sellers.length ? (\n              sellers.map((author, idx) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className='col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards'\n                  >\n                    {/* Single Seller */}\n                    <div className='card'>\n                      <div className='single-seller d-flex align-items-center'>\n                        <div className='seller-avatar-container'>\n                          <img\n                            className='avatar-md rounded-circle'\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt='AvatarImg'\n                          />\n                          {author.profileImage ? (\n                            <span className='seller-avatar-active'>\n                              <img src={SellerTickIcon} alt='tick-icon' />\n                            </span>\n                          ) : (\n                            ''\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className='seller-info ml-3 w-100'>\n                          <Link\n                            className='seller mb-2'\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className='text-end'>\n                            {' '}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className='col-12'>\n              <div className='mt-5 text-center'>\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className='btn btn-linear-gradient px-5'\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  beforeUser\n);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["640"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/layouts/layout2/layout2.jsx",["641","642"],"import React, { Component } from \"react\";\nimport Particles from \"react-tsparticles\";\nimport NavbarMain from \"../../components/navbar-main/NavbarMain\";\nimport Footer from \"../../components/footer/footer\";\n// import Scrollup from '../../components/scroll-up/sroll-up';\n\nclass Layout2 extends Component {\n  render() {\n    const particlesData = {\n      fullScreen: {\n        zIndex: -5,\n      },\n      color: {\n        value: \"#5666fe\",\n      },\n      twinkle: {\n        lines: {\n          enable: true,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n        particles: {\n          enable: false,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n      },\n      wobble: {\n        distance: 5,\n        enable: false,\n        speed: 2,\n      },\n      particles: {\n        number: {\n          value: 25,\n          density: {\n            enable: true,\n            value_area: 800,\n          },\n        },\n        shape: {\n          type: \"circle\",\n          stroke: {\n            width: 0,\n            color: \"#5666fe\",\n          },\n          polygon: {\n            nb_sides: 5,\n          },\n          image: {\n            src: \"img/github.svg\",\n            width: 100,\n            height: 100,\n          },\n        },\n        opacity: {\n          value: 0.5,\n          random: false,\n          anim: {\n            enable: false,\n            speed: 1,\n            opacity_min: 0.1,\n            sync: false,\n          },\n        },\n        size: {\n          value: 3,\n          random: true,\n          anim: {\n            enable: false,\n            speed: 50,\n            size_min: 0.1,\n            sync: false,\n          },\n        },\n        line_linked: {\n          enable: true,\n          distance: 150,\n          color: \"#5666fe\",\n          opacity: 0.4,\n          width: 1,\n        },\n        move: {\n          enable: true,\n          speed: 1,\n          direction: \"none\",\n          random: false,\n          straight: false,\n          out_mode: \"out\",\n          bounce: false,\n          attract: {\n            enable: false,\n            rotateX: 600,\n            rotateY: 1200,\n          },\n        },\n      },\n      interactivity: {\n        detect_on: \"canvas\",\n        events: {\n          onhover: {\n            enable: true,\n            mode: \"grab\",\n          },\n          onclick: {\n            enable: true,\n            mode: \"push\",\n          },\n          resize: true,\n        },\n        modes: {\n          grab: {\n            distance: 140,\n            line_linked: {\n              opacity: 1,\n            },\n          },\n          bubble: {\n            distance: 400,\n            size: 40,\n            duration: 2,\n            opacity: 8,\n            speed: 2,\n          },\n          repulse: {\n            distance: 200,\n            duration: 0.4,\n          },\n          push: {\n            particles_nb: 4,\n          },\n          remove: {\n            particles_nb: 2,\n          },\n        },\n      },\n      retina_detect: true,\n      zLayers: 1,\n    };\n    return (\n      <>\n        {/* <NavbarMain /> */}\n        <div className=\"main\">\n          <Particles id=\"tsparticles\" options={{ ...particlesData }} />\n          {this.props.children}\n        </div>\n        {/* <Footer /> */}\n      </>\n    );\n  }\n}\n\nexport default Layout2;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/types.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.js",["643","644","645","646","647","648","649","650"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  // useEffect(() => {\n  //   if (props.settings.settingsAuth) {\n  //     setData(props.settings.settings);\n  //   }\n  // }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div className=\"input-group notify-form\">\n                  <div className=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/collections.actions.js",["651","652","653"],"import { toast } from 'react-toastify';\nimport {\n  GET_ERRORS,\n  BEFORE_COLLECTION,\n  SET_AUTH_STATE,\n  GET_COLLECTION,\n  GET_COLLECTIONS,\n  UPSERT_COLLECTION,\n  DELETE_COLLECTION,\n  ALL_COLLECTIONS,\n  BEFORE_CATEGORY,\n  GET_CATEGORIES,\n  COLLECTION_CATEGORES,\n  MY_COLLECTIONS,\n  GET_POPULAR_COLLECTIONS,\n  BEFORE_POPULAR_COLLECTION,\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport { CgData } from 'react-icons/cg';\n\nexport const beforeCollection = () => {\n  return {\n    type: BEFORE_COLLECTION,\n  };\n};\n\nexport const getCollection = (collectionId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}collection/get/${collectionId}`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        dispatch({\n          type: GET_COLLECTION,\n          payload: data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getCollections =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    // let url = `http://3.142.91.8/v1/front/collection/list`;\n    let url = `${ENV.url}collection/list`;\n\n    if (qs) url += `?${qs}`;\n    //console.log(url, 'url sending');\n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        'content-type': 'application/json',\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        //console.log(data, 'collections api response');\n        if (data.success) {\n          dispatch({\n            type: GET_COLLECTIONS,\n            payload: data.data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\nexport const myCollections = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  let url = `${ENV.url}collection/myCollectionList`;\n\n  if (userId) url += `?userId=${userId}`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      console.log(data,\"res of collection getting\")\n      if (data.success) {\n        dispatch({\n          type: MY_COLLECTIONS,\n          payload: data.data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data.message,\n        });\n      }\n    })\n    .catch((error) => {\n      console.lof(error,\"erro while getting collections\")\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const upsertCollection =\n  (apiURL, body, method = 'POST') =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}${apiURL}`;\n\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_COLLECTION,\n            payload: data,\n          });\n        } else {         \n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        console.log(error.response.data)\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const deleteCollection = (collectionId) => (dispatch) => {\n  dispatch(emptyError());\n  let url = `${ENV.url}collection/delete/${collectionId}`;\n\n  fetch(url, {\n    method: 'DELETE',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        toast.success(data.message);\n        dispatch({\n          type: DELETE_COLLECTION,\n          payload: data,\n        });\n      } else {\n        toast.error(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const setAuthState = () => (dispatch) => {\n  dispatch({\n    type: SET_AUTH_STATE,\n  });\n};\nexport const beforeCategory = () => {\n  return {\n    type: BEFORE_CATEGORY,\n  };\n};\nexport const getCategories = () => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}category/list`;\n\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: COLLECTION_CATEGORES,\n          payload: data.categories,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((error) => {\n      //console.log(error, 'error==>');\n\n      if (error.response && error.response.data) {\n        const { data } = error.response;\n        if (data.message) toast.error(data.message);\n      }\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const toggleLikeDislike = (body) => (dispatch) => {\n  let data = JSON.stringify(body);\n  const url = `${ENV.url}collectionLikes/likeDislike`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    data,\n  })\n    .then((res) => res.json())\n    .then((data) => {})\n    .catch((error) => {\n      //console.log(error, 'error likes');\n    });\n};\n\nexport const beforePopularCollection = () => {\n  return {\n    type: BEFORE_POPULAR_COLLECTION,\n  };\n};\n\nexport const getPopularCollections =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}collection/popular`;\n\n    if (qs) url += `?${qs}`;\n    //console.log(url, 'url sending');\n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        'content-type': 'application/json',\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        //console.log(data, 'popular collections api response');\n        if (data.success) {\n          dispatch({\n            type: GET_POPULAR_COLLECTIONS,\n            payload: data.data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/user/user.action.js",["654","655"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/top-seller/topseller2.js",["656","657","658","659","660"],"import React, { useEffect, useState } from 'react';\r\nimport { connect } from 'react-redux';\r\nimport { Link } from 'react-router-dom';\r\nimport { ENV } from './../../config/config';\r\nimport { getTopSellers, beforeUser } from './../user/user.action';\r\nimport ViewAllIcon from '../../assets/images/view-all-arrow.svg';\r\nimport AvatarImg from '../../assets/images/seller-avatar.png';\r\nimport SellerTickIcon from '../../assets/images/seller-tick-icon.svg';\r\nimport './topseller.css';\r\nimport { Images } from '../../assets/assets';\r\n\r\nconst exmpData = [\r\n  {\r\n    id: 1,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 2,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 3,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 4,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 5,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 6,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 7,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 8,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 9,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 10,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 11,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n  {\r\n    id: 12,\r\n    img: AvatarImg,\r\n    icon: SellerTickIcon,\r\n    authorName: 'Pablo-Shing',\r\n    price: '256.4 ETH',\r\n  },\r\n];\r\n\r\nconst TopSeller = (props) => {\r\n  const [sellers, setSellers] = useState([]);\r\n\r\n  useEffect(() => {\r\n    props.getTopSellers();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.user.topSellersAuth) {\r\n      setSellers(props.user.sellers.topSellers);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  return (\r\n    <section className='top-seller-area padding-wrapper'>\r\n      <div className='container'>\r\n        <div className='row'>\r\n          <div className='col-12'>\r\n            {/* Intro */}\r\n            <div className='intro d-flex justify-content-between align-items-end m-0'>\r\n              <div className='intro-content'>\r\n                <span>CREATIVE ARTIST</span>\r\n                <h3 className='mb-0'>Top Sellers</h3>\r\n              </div>\r\n              {sellers && sellers.length > 12 && props.viewAll ? (\r\n                <div className='intro-btn'>\r\n                  <Link\r\n                    className='btn btn-rounded-bordered btn-viewAll'\r\n                    to='/top-sellers-list'\r\n                  >\r\n                    {props.viewAll}\r\n                    <img src={ViewAllIcon} alt='arrow-left' className='ms-2' />\r\n                  </Link>\r\n                </div>\r\n              ) : (\r\n                ''\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className='row items'>\r\n          {sellers && sellers.length ? (\r\n            sellers.map((author, idx) => {\r\n              if (idx <= 11) {\r\n                return (\r\n                  <div\r\n                    key={`ts_${idx}`}\r\n                    className='col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards'\r\n                  >\r\n                    {/* Single Seller */}\r\n                    <div className='card'>\r\n                      <div className='single-seller d-flex align-items-center'>\r\n                        <div className='seller-avatar-container'>\r\n                          <img\r\n                            className='avatar-md rounded-circle'\r\n                            src={\r\n                              author.profileImage === null\r\n                                ? Images.profilePlaceholder\r\n                                : author.profileImage\r\n                            }\r\n                            alt='AvatarImg'\r\n                          />\r\n                          {author.profileImage ? (\r\n                            <span className='seller-avatar-active'>\r\n                              <img src={SellerTickIcon} alt='tick-icon' />\r\n                            </span>\r\n                          ) : (\r\n                            ''\r\n                          )}\r\n                        </div>\r\n\r\n                        {/* Seller Info */}\r\n                        <div className='seller-info ml-3 w-100'>\r\n                          <Link\r\n                            className='seller mb-2'\r\n                            to={`/author/${author._id}`}\r\n                          >\r\n                            {author.username}\r\n                          </Link>\r\n                          <span className='text-end'>\r\n                            {' '}\r\n                            {author.totalETH.toFixed(2)}\r\n                          </span>\r\n                        </div>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                );\r\n              }\r\n            })\r\n          ) : (\r\n            <p className='text-white text-center'>No Top Sellers Found</p>\r\n          )}\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => ({\r\n  user: state.user,\r\n});\r\n\r\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\r\n  TopSeller\r\n);\r\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["661","662","663","664","665","666","667","668","669"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { beforeAuction, getLiveAuctions } from \"./auctions.action\";\r\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport $ from \"jquery\";\r\n\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\n\r\nimport { getCreators } from \"./../user/user.action\";\r\nimport ViewAllIcon from \"../../assets/images/view-all-arrow.svg\";\r\n//CardSliders\r\nimport CardSlider from \"../card-slider/CardSlider\";\r\nimport AuctionsCards from \"../auctions-cards/AuctionsCards\";\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from \"../collections/collections.actions\";\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [creators, setCreator] = useState([]);\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState(\"all\");\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  const [isActive, setIsActive] = useState(0);\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: \"all\",\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.user.topSellersAuth) {\r\n      setCreator(props.user.sellers);\r\n      setLoader(false);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n      if (auctions) {\r\n        auctions.forEach((element, i) => {\r\n          auctions[i].totalBids = element.bidInfo?.bidBy?.length;\r\n        });\r\n      }\r\n\r\n      setAuctions(auctions);\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $(\".swiper-wrapper\").slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n\r\n  \r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className=\"container\">\r\n          <div className=\"row mb-5\">\r\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4\">\r\n              {/* Intro */}\r\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n                <div className=\"intro-content\">\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products. We want to be a part of your\r\n                    smile, success and future growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className=\"col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0\">\r\n              {categoryId === \"all\" && auctions && auctions?.length == 0 ? (\r\n                \"\"\r\n              ) : (\r\n                <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                  {categories &&\r\n                    categories.length > 0 &&\r\n                    categories.map((item, id) => {\r\n                      if (id <= 3) {\r\n                        return (\r\n                          <button\r\n                            key={id}\r\n                            className={`${\r\n                              id === isActive ? \"home-active-category\" : \"\"\r\n                            } me-1 me-sm-2`}\r\n                            onClick={() => {\r\n                              setIsActive(id);\r\n                              handleCategoryFilter(item.description);\r\n                            }}\r\n                          >\r\n                            {item.name}\r\n                          </button>\r\n                        );\r\n                      }\r\n                    })}\r\n                  <div className=\"intro-btn\">\r\n                    <Link\r\n                      className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                      to=\"/auctions\"\r\n                    >\r\n                      View All\r\n                      <img\r\n                        src={ViewAllIcon}\r\n                        alt=\"arrow-left\"\r\n                        className=\"ms-2 d-none d-sm-block\"\r\n                      />\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"auctions-slides\">\r\n            <div className=\"\">\r\n              {auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item, index) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        key={index}\r\n                        endDate={item.auctionEndDate}\r\n                        image={item.image}\r\n                        ownerName={item.owner.username}\r\n                        name={item.name}\r\n                        id={item._id}\r\n                        highestBid={item.highestBid}\r\n                        totalBids={item.totalBids}\r\n                        currentPrice={item.currentPrice}\r\n                        bidsProfile={item.bidInfo.bidByProfile}\r\n                        userId={ENV.getUserKeys(\"_id\")._id}\r\n                        ownerId={item.owner._id}\r\n                        fileType={item.fileType}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className=\"text-white text-center\">No Live Auctions Found</p>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["670","671"],"import React, { useState } from \"react\";\nimport { Link, useHistory, useLocation } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport LoginIcon from \"../../assets/images/login-icon.svg\";\nimport SearchIcon from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection } from \"../../components/collections/collections.actions\";\n\nconst NavbarMain = (props) => {\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  const [path, setPath] = React.useState(null);\n  const [activeTab, setActiveTab] = React.useState(null);\n  const [searchactive, setSearchActive] = useState(false);\n  const [searchValue,setSearchValue]=useState('')\n  const history = useHistory();\n  const location = useLocation();\n\n  const handleChange = (e) => {\n    setSearchValue(e.target.value)\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword=()=>{\n    if(searchValue!=='' && searchValue.length>=3){\n\n      history.push({\n        pathname:\"/explore/allNFT\",\n        state:searchValue\n      })\n    }\n\n  }\n  const clearLocalStorage = () => {\n    if (userId) {\n      localStorage.clear();\n    }\n   \n    history.push(\"/login\");\n  };\n  React.useEffect(() => {\n    setPath(location.path);\n  }, [location.pathname]);\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          bg=\"light\"\n          expand=\"xl\"\n          variant=\"dark\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <Navbar.Brand to=\"/\" href=\"/\" className=\"navbar-brand-logo\">\n            <img src={MintsClub} alt=\"logo\" />\n          </Navbar.Brand>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav\n              className=\"mx-xl-auto\"\n              defaultActiveKey={`${location.pathname}`}\n            >\n              <Nav.Link to=\"/\" href=\"/\" className=\"nav-main-link\">\n                Home\n              </Nav.Link>\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                active={activeTab === 1}\n                defaultactivekey={activeTab}\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item\n                  to=\"/explore/exploreAll\"\n                  href=\"/explore/exploreAll\"\n                  active={activeTab === 1}\n                  eventKey={1}\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/explore/exploreAll\"\n                      ? \"active-item\"\n                      : \"\"\n                  }`}\n                  onClick={() => {\n                    setActiveTab(1);\n                  }}\n                >\n                  Explore All\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/explore/allNFT\"\n                  href=\"/explore/allNFT\"\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/explore/allNFT\" ? \"active-item\" : \"\"\n                  }`}\n                  eventKey={2}\n                  active={activeTab === 2}\n                  onClick={() => {\n                    setActiveTab(2);\n                  }}\n                >\n                  All NFT\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                active={activeTab === 1}\n                defaultactivekey={activeTab}\n                className={`nav-main-link dropdown-bg ${\n                  location.pathname === \"/create\" ? \"active-item\" : \"\"\n                }`}\n              >\n                <NavDropdown.Item\n                  to=\"/create\"\n                  href=\"/create\"\n                  active={activeTab === 1}\n                  eventKey={1}\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/create\" ? \"active-item\" : \"\"\n                  }`}\n                  onClick={() => {\n                    setActiveTab(1);\n                  }}\n                >\n                  Create NFT\n                </NavDropdown.Item>\n                <NavDropdown.Item\n                  to=\"/createcollection\"\n                  href=\"/createcollection\"\n                  className={`nav-main-link main-nav-dd-items ${\n                    location.pathname === \"/createcollection\"\n                      ? \"active-item\"\n                      : \"\"\n                  }`}\n                  eventKey={2}\n                  active={activeTab === 2}\n                  onClick={() => {\n                    setActiveTab(2);\n                  }}\n                >\n                  Create Collection\n                </NavDropdown.Item>\n              </NavDropdown>\n\n              {/* <Nav.Link to=\"/create\" href=\"/create\" className=\"nav-main-link\">\n                Create\n              </Nav.Link> */}\n              <Nav.Link\n                to=\"/userprofile\"\n                href=\"/userprofile\"\n                className=\"nav-main-link\"\n              >\n                Profile\n              </Nav.Link>\n           \n             \n             \n              <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link>\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) =>\n                    e.key === \"Enter\" && handleSearchKeyword()\n                  }\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={()=>handleSearchKeyword()}\n                >\n                  <img src={SearchIcon}  alt=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) =>\n                  e.key === \"Enter\" && handleSearchKeyword()\n                }\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={()=>handleSearchKeyword()}\n              >\n                <img src={SearchIcon} alt=\"search-icon\" />\n              </button>\n            </div>\n            <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <img src={LoginIcon} alt=\"loginIcon\" className=\"me-2\" />\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link>\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/popular-collections.js",["672","673","674","675","676","677","678","679","680","681"],"import React, { useState, useEffect, useRef } from 'react';\nimport FullPageLoader from '../../components/full-page-loader/full-page-loader';\nimport { Link } from 'react-router-dom';\n\nimport CollectionsCard from '../collections-cards/CollectionsCard';\nimport ViewAllIcon from '../../assets/images/view-all-arrow.svg';\nimport CardSlider from '../card-slider/CardSlider';\nimport { ENV } from '../../config/config';\nimport { beforeCategory, getCategories } from '../categories/categories.action';\nimport {\n  beforePopularCollection,\n  getPopularCollections,\n} from '../collections/collections.actions';\nimport { connect } from 'react-redux';\nimport { CollectionImages } from '../../assets/assets.js';\nimport { Images } from '../../assets/assets';\nconst initData = {\n  pre_heading: 'Most Popular',\n  heading: 'Popular Collections',\n  btnText: 'Explore More',\n};\n\nconst PopularCollections = (props) => {\n  const [popular, setpopular] = useState([]);\n  const [categories, setCategories] = useState(null);\n  const [categoryId, setCategoryId] = useState('all');\n  const [popularSettings, settPopularSettings] = useState();\n  const [isActive, setIsActive] = useState(0);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: 'all',\n    });\n    props.getPopularCollections(qs);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.category.getAuth) {\n      setCategories(props.category.categories);\n    }\n  }, [props.category.getAuth]);\n\n  useEffect(() => {\n    if (props.getPopularAuth) {\n      const collectionListing = props.popularCollections.collectionsList;\n      if (collectionListing) {\n        collectionListing.forEach((element, i) => {\n          if (element.likesCount.length > 0) {\n            var sumLikes = element.likesCount.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].likesCount = sumLikes;\n          }\n          collectionListing[i].likesCount = 0;\n\n          collectionListing[i].totalNfts = element.nfts[0].image\n            ? element.nfts?.length\n            : 0;\n          if (element.soldCopies.length > 0) {\n            var soldCopiesSum = element.soldCopies.reduce(function (a, b) {\n              return a + b;\n            }, 0);\n            collectionListing[i].soldCopies = soldCopiesSum;\n          }\n\n          collectionListing[i].soldCopies = 0;\n        });\n      }\n\n      const finalCollectionListing = collectionListing.sort(\n        (a, b) => b.likesCount - a.likesCount || b.soldCopies - a.soldCopies\n      );\n      let popularCollectionsSettings = ENV.popularCollectionsSettings;\n      if (finalCollectionListing.length > 3) {\n        popularCollectionsSettings.infinite = true;\n      } else {\n        popularCollectionsSettings.infinite = false;\n      }\n      settPopularSettings(popularCollectionsSettings);\n      setpopular(finalCollectionListing);\n      props.beforePopularCollection();\n    }\n  }, [props.getPopularAuth]);\n\n  const handleCategoryFilter = (desc) => {\n    props.beforePopularCollection();\n    setCategoryId(desc);\n    const qs = ENV.objectToQueryString({ myFilter: desc });\n    props.getPopularCollections(qs);\n  };\n\n  const handleImage = (item, index) => {\n    if (item?.nfts[index]?.image) {\n      let result = item.nfts.filter((nft) => nft.fileType === 'image');\n      if (result.length >= index) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      <section className='popular-collections-area padding-wrapper'>\n        <div className='container'>\n          <div className='row mb-5'>\n            <div className='col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4'>\n              <div className='intro d-flex justify-content-between align-items-end m-0'>\n                <div className='intro-content'>\n                  <span>{initData.pre_heading}</span>\n                  <h3 className=' mb-0'>{initData.heading}</h3>\n                  <p>\n                    Explore on the world's best & largest NFT marketplace with\n                    our beautiful NFT products. We want to be a part of your\n                    smile, success and future growth.\n                  </p>\n                </div>\n              </div>\n            </div>\n            <div className='col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0'>\n              {categoryId === 'all' && popular && popular?.length == 0 ? (\n                ''\n              ) : (\n                <div className='popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end'>\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item, id) => {\n                      if (id <= 3) {\n                        return (\n                          <button\n                            key={id}\n                            className={`${\n                              id === isActive ? 'home-active-category' : ''\n                            } me-1 me-sm-2`}\n                            onClick={() => {\n                              setIsActive(id);\n                              handleCategoryFilter(item.description);\n                            }}\n                          >\n                            {item.name}\n                          </button>\n                        );\n                      }\n                    })}\n                  <div className='intro-btn'>\n                    <Link\n                      className='btn btn-rounded-bordered btn-viewAll'\n                      to='/popular-collections'\n                    >\n                      View All\n                      <img\n                        src={ViewAllIcon}\n                        alt='arrow-left'\n                        className='ms-2 d-none d-sm-none'\n                      />\n                    </Link>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n          {popular && popular.length && popular.length > 0 ? (\n            <CardSlider\n              settings={ENV.popularCollectionsSettings}\n              data={popular}\n              homeAuction\n            >\n              {popular.map((item, i) => {\n                if (i < 8) {\n                  return (\n                    <CollectionsCard\n                      key={i}\n                      CardImg={item.featuredImg}\n                      Subimg1={handleImage(item, 0)}\n                      Subimg2={handleImage(item, 1)}\n                      Subimg3={handleImage(item, 2)}\n                      name={item.name}\n                      id={item._id}\n                      collection={item}\n                      userName={item.username[0]}\n                      NFTCount={item.totalNfts}\n                      profileImage={item.profileImage[0]}\n                    />\n                  );\n                }\n              })}\n            </CardSlider>\n          ) : (\n            <p className='text-center text-white not-found-title mt-5'>\n              No popular collections Found\n            </p>\n          )}\n        </div>\n      </section>\n    </>\n  );\n};\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  category: state.category,\n  popularCollections: state.collection.popularCollections,\n  getPopularAuth: state.collection.getPopularAuth,\n});\n\nexport default connect(mapStateToProps, {\n  beforePopularCollection,\n  beforeCategory,\n  getCategories,\n  getPopularCollections,\n})(PopularCollections);\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/hero/hero.js",["682"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n              Explore on the world's best & largest NFT marketplace\r\n            </p>\r\n            {/* Buttons */}\r\n            <div className=\"button-group mt-lg-5 d-flex\">\r\n              <Link\r\n                className=\"btn btn-linear-gradient btn-hero-create\"\r\n                to={connectedAddress ? \"/create\" : \"/login\"}\r\n              >\r\n                {/* <i className=\"icon-note mr-2\" /> */}\r\n                <img src={CreateIcon} alt=\"createIcon\" className=\"me-2\" />\r\n                <p>Create</p>\r\n              </Link>\r\n              <Link\r\n                className=\"btn btn-blue-bordered btn-hero-explore\"\r\n                to=\"/explore/exploreAll\"\r\n              >\r\n                <svg width=\"22px\" height=\"16px\">\r\n                  <path\r\n                    fill-rule=\"evenodd\"\r\n                    fill=\"rgb(255, 255, 255)\"\r\n                    d=\"M10.788,0.151 C10.596,0.153 10.412,0.232 10.279,0.370 C10.145,0.508 10.72,0.694 10.76,0.886 L10.76,3.525 C10.73,3.717 10.148,3.903 10.283,4.40 C10.418,4.177 10.603,4.255 10.795,4.255 C10.988,4.255 11.173,4.177 11.308,4.40 C11.443,3.903 11.518,3.717 11.515,3.525 L11.515,0.886 C11.519,0.691 11.444,0.503 11.307,0.365 C11.170,0.226 10.983,0.149 10.788,0.151 ZM5.53,1.591 C4.878,1.586 4.707,1.646 4.573,1.759 C4.438,1.872 4.350,2.29 4.324,2.203 C4.298,2.376 4.336,2.553 4.430,2.700 L5.630,4.619 C5.725,4.792 5.887,4.919 6.78,4.969 C6.269,5.19 6.472,4.989 6.640,4.884 C6.808,4.780 6.926,4.612 6.966,4.419 C7.6,4.226 6.964,4.24 6.852,3.862 L5.652,1.943 C5.526,1.730 5.300,1.597 5.53,1.591 L5.53,1.591 ZM16.515,1.598 C16.278,1.611 1