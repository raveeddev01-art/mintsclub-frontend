-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.reducer.js",["283"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/offers/offers.reducer.js",["284"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/bids/bids.reducer.js",["285"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/contact/contact.reducer.js",["286"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.reducer.js",["287"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/Home/home.js",["288","289","290","291","292","293","294","295"],"import { useEffect } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { connect } from \"react-redux\";\n// import { hometest } from \"../../Redux/actions/actions\";\nimport Navbar from \"../../components/Navbar/navbar\";\nimport SimpleSlider from \"../../components/Slider/slider\";\n// import image from \"../../assets/images/test.jpg\";\nimport Polygon from \"../../assets/images/icon 2.svg\";\n// import Ethereum from \"../../assets/images/Ethereum.svg\";\nimport Cardano from \"../../assets/images/icon 3.svg\";\nimport Binance from \"../../assets/images/icon4.svg\";\nimport Ethereum from \"../../assets/images/icon1.png\";\n// import nft2 from \"../../assets/images/icon4.svg\";\n// import nft3 from \"../../assets/images/icon 2.svg\";\n////////////////////////\nimport nft1 from \"../../assets/images/nft1.jpg\";\nimport nft2 from \"../../assets/images/nft2.webp\";\nimport nft3 from \"../../assets/images/nft3.jpeg\";\nimport nft4 from \"../../assets/images/nft4.webp\";\nimport nft5 from \"../../assets/images/nft5.jpg\";\nimport GaTracker from \"../../gaTracker/gaTracket\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\nimport { Container } from \"react-bootstrap\";\n\nimport \"./home.css\";\n\nconst Home = (props) => {\n  //  useEffect(()=>{\n  // },[])\n  GaTracker();\n  const networksData = [\n    { name: \"Ethereum\", image: Ethereum },\n    { name: \"Polygon\", image: Polygon },\n    { name: \"Cardano\", image: Cardano },\n    { name: \"Binance SmartChain\", image: Binance },\n  ];\n\n  const history = useHistory();\n\n  return (\n    <div className=\"home-container\">\n      <div className=\"container\">\n        <div className=\"pt-3\">\n          <Navbar />\n        </div>\n        <div className=\"mt-4 details-container\">\n          <div className=\" d-flex justify-content-between home-info-container\">\n            <div className=\" \">\n              <div className=\"details\">\n                <div className=\"\" style={{ maxWidth: \"31rem\" }}>\n                  <p\n                    className=\"text-white mint-title\"\n                    style={{ fontSize: \"46px\", fontWeight: \"bold\" }}\n                  >\n                    Let's Mint Your NFTs\n                  </p>\n                  <p\n                    className=\"text-white mint-title\"\n                    style={{ fontSize: \"30px\", fontWeight: \"bold\" }}\n                  >\n                    All you can Mint for {\" \"}\n                    <span style={{color: \"#fcd70d\"}}>Free !</span> \n                  </p>\n                  {/* <p className=\"text-white\" style={{ fontSize: \"20px\" }}>\n                    Lorem Ipsum is simply dummy text of the printing and\n                    typesetting industry.{\" \"}\n                  </p> */}\n                </div>\n              </div>\n\n              <div className=\"networks \">\n                <p\n                  className=\"text-white select-network-heading\"\n                  style={{ fontSize: \"36px\" }}\n                >\n                  Select Network\n                </p>\n                <div className=\"networks-list-container mt-4 d-flex \">\n                  {/* {networksData.map((item, index) => {\n                    return (\n                      <div\n                        className=\"network\"\n                        disabled={true}\n                        key={index}\n                     \n                      >\n                      \n                        <img\n                          src={item.image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\n                            \"Ethereum\" === item.name ? \"\" : \"selected-network\"\n                          }`}\n                        />\n                        {\"Ethereum\" !== item.name && (\n                          <span className=\"tooltiptext\">Coming soon</span>\n                        )}\n                      \n                        <p\n                          className={`ml-1 mt-2 ${\n                            \"Ethereum\" === item.name\n                              ? \"network-title-yellow\"\n                              : \"network-title-white\"\n                          }`}\n                          style={{ fontSize: \"14px\" }}\n                        >\n                          {item.name === \"Binance SmartChain\" ? (\n                            <p>\n                              {\"Binance\"} <br /> {\"SmartChain\"}\n                            </p>\n                          ) : (\n                            item.name\n                          )}\n                        </p>\n                      </div>\n                    );\n                  })} */}\n                  {\n                    <div\n                      className=\"network d-flex\"\n                      disabled={true}\n                      //  key={index}\n                    >\n                      {/* {networksData.map((item, index) => {\n                        return (\n                          <div>\n                            <img\n                              src={item.image}\n                              alt=\"coming soon\"\n                              style={{\n                                width: \"4rem\",\n                                cursor: \"pointer\",\n                              }}\n                              className={`network-img  ${\n                                \"Ethereum\" === item.name\n                                  ? \"\"\n                                  : \"selected-network\"\n                              } ${index !== 0 ? \"ml-3\" : \"ml-0\"}`}\n                            />\n                            <p\n                              className={`text-white mt-1  ${\n                                index !== 0 ? \"ml-3\" : \"ml-0\"\n                              }`}\n                            >\n                              {item.name}\n                            </p>\n                            {\"Ethereum\" !== item.name && (\n                              <span\n                                className=\"tooltiptext\"\n                                style={{\n                                  display: `${\n                                    \"Ethereum\" === item.name ? \"none\" : \"block\"\n                                  }`,\n                                }}\n                              >\n                                Coming soon\n                              </span>\n                            )}\n                          </div>\n                        );\n                      })} */}\n                      <div className=\"\">\n                        <img\n                          src={networksData[0].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\n                            \"Ethereum\" === networksData[0].name\n                              ? \"\"\n                              : \"selected-network\"\n                          }`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[0].name}\n                        </p>\n                      </div>\n                      <div className=\" ml-3 polygon position-relative\">\n                        <span className=\"tooltiptext1 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[1].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[1].name}\n                        </p>\n                      </div>\n\n                      <div className=\" ml-3 cardano position-relative\" >\n                        <span className=\"tooltiptext2 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[2].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                          {networksData[2].name}\n                        </p>\n                      </div>\n\n                      <div className=\" ml-3 binance position-relative\">\n                        <span className=\"tooltiptext3 tooltiptext\">Coming soon</span>\n                        <img\n                          src={networksData[3].image}\n                          alt=\"coming soon\"\n                          style={{\n                            width: \"4rem\",\n                            cursor: \"pointer\",\n                            // padding: \"0rem 0rem 0rem 1rem\",\n                          }}\n                          className={`network-img   ${\"selected-network\"}`}\n                        />\n                        <p className=\"text-white mt-2\">\n                        {\"Binance\"} <br /> {\"SmartChain\"}\n                        </p>\n                      </div>\n                    </div>\n                  }\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-4\"\n                onClick={() => history.push(\"/fourStepForm\")}\n              >\n                Lets Start\n              </button>\n            </div>\n\n            <div className=\"d-flex  home-slider-wrapper \">\n              <div\n                className=\"home-slider-container\"\n                style={{ marginLeft: \"2rem\" }}\n              >\n                <SimpleSlider assetList={WordsFamousNfts} />\n                {/* {\n                  !spinner &&\n\n                  }\n                  <div className=\"d-flex justify-content-center align-items-center h-100\" style={{display:`${spinner?\"none\":\"block\"}`}}>\n\n                    <div className=\"lds-ellipsis\"><div></div><div></div><div></div><div></div></div>\n                  </div>  */}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// const mapStateToProps = (state) =>\n//   // console.log(state, \"state\"),\n//   ({\n//     hometest: state.home,\n//   });\n\n// export default connect(mapStateToProps, {\n//   hometest,\n// })(Home);\nexport default Home;\n",["296","297"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/index.js",["298","299","300"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout2/layout2.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/layouts/layout1/layout1.jsx",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Navbar/navbar.js",["301","302","303","304","305","306","307","308","309"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/exportData.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Slider/slider.js",["310","311","312"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/utils/web3.js",["313","314"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/actions/actions.js",["315","316","317","318"],"import { toast } from 'react-toastify';\nimport Web3 from 'web3';\nimport {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  // DEPLOY_CONTRACT,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS,\n  SET_OTP_EMAIL\n} from '../types/types';\n\nimport { ENV } from '../../config/config';\nimport { connectMetamaskCopy } from '../../utils/web3';\nimport axios from 'axios';\nimport dotenv from 'dotenv';\nexport const currentStepAction = () => (dispatch) => {\n  // alert(\"called\")\n\n  dispatch({\n    type: CURRENT_STEP,\n  });\n};\nexport const currentStepDecrement = () => (dispatch) => {\n  dispatch({\n    type: CURRENT_STEP_DECREMENT,\n  });\n};\nexport const clearCurrentStep = () => (dispatch) => {\n  dispatch({\n    type: CLEAR_CURRENT_STEP,\n  });\n};\n\nexport const contractResponse = () => (dispatch) => {\n  dispatch({\n    type: CONTRACT_REPONSE,\n  });\n};\nexport const setProperties = (data) => (dispatch) => {\n  // alert(\"callled\")\n  dispatch({\n    type: SET_PROPERTIES,\n    payload: data,\n  });\n};\nexport const setLevels = (data) => (dispatch) => {\n  dispatch({\n    type: SET_LEVELS,\n    payload: data,\n  });\n};\nexport const setOtpEmail=(data)=>(dispatch)=>{\n  dispatch({\n    type: SET_OTP_EMAIL,\n    payload: data,\n  });\n}\n\nexport const sendOtp = (data) => (dispatch) => {\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/sendVerficationEmail`;\n\n  axios.post(url, data, config).then(\n    (res) => {\n      //  alert(\"email sent\")\n      // console.log(res);\n      if (res.status === 200) {\n        //  toast.success(\"Otp Verification Code sent to \")\n      }\n    },\n    (err) => {\n      console.log(err, 'error');\n      alert('error while sending email');\n    }\n  );\n};\nfunction msToTime(ms) {\n  let seconds = (ms / 1000).toFixed(1);\n  let minutes = (ms / (1000 * 60)).toFixed(1);\n  let hours = (ms / (1000 * 60 * 60)).toFixed(1);\n  let days = (ms / (1000 * 60 * 60 * 24)).toFixed(1);\n  if (seconds < 60) return seconds + ' Sec';\n  else if (minutes < 60) return minutes + ' Min';\n  else if (hours < 24) return hours + ' Hrs';\n  else return days + ' Days';\n}\n\nexport const verifyOtp = (email, otp) => (dispatch) => {\n  let data = {\n    email,\n    otp,\n  };\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}otpVerification/verify`;\n  console.log(url);\n\n  axios.post(url, data, config).then(\n    (res) => {\n      console.log(res,\"res\")\n      if(res.data.email){\n\n        if(res.data.email!==email){\n          toast.error('Invalid Email or OTP');\n          return \" \"\n        }\n      }\n\n    if(res.data.status==false){\n      toast.error(res.data.message);\n      return \" \"\n    }\n\n      if (res.data.status === true) {\n        \n        setOtpEmail(res.data.data[0].email)\n        toast.success(res.data.message);\n        if (res.data.diffMins < -10) {\n          toast.error('Token is  Expired ,Please resend token & try again');\n          return ' ';\n        } else {\n      \n          dispatch({\n            type: SET_OTP_STATUS,\n            payload: true,\n          });\n        }\n      }\n      else {\n        // console.log(\"error\")\n        toast.error(res.data.message);\n      }\n    },\n    (err) => {\n     toast.error(\"Invalid OTP or Email\")\n    }\n  );\n};\n\nexport const deployContract = (data, address, supply) => (dispatch) => {\n\n\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/createUser`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then(\n      (res) => {\n        // console.log(res, \"response from backendfdkfd\");\n        const abi = res.data.data.abi;\n        if (res.data.status === true) {\n          let metaDataList = [];\n\n          for (let i = 1; i <= supply; i++) {\n            metaDataList.push(res.data.data.metaData);\n            dispatch({\n              type: SET_CONTRACT_INFO,\n              payload: res.data,\n            });\n          }\n\n          try {\n            const web3 = new Web3(Web3.givenProvider);\n            // const gasPrice = \"5000000\";\n            let contract = new web3.eth.Contract(abi, null, {\n              data: res.data.data.bytecode,\n\n              from: address,\n              // gas: 4600000,\n            });\n            contract\n              .deploy({\n                data: res.data.data.bytecode,\n                arguments: [res.data.data.name, res.data.data.symbol],\n              })\n              .send({\n                from: address,\n                // gas: gasPrice,\n              })\n              .then((contractInstance) => {\n                toast.success('Contract Deployed Successfully!');\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n\n                let info = {\n                  ...res.data,\n                  contractAddress: contractInstance.options.address,\n                };\n                dispatch({\n                  type: SET_CONTRACT_INFO,\n                  payload: {\n                    data: { ...info },\n                  },\n                });\n                dispatch({\n                  type: CONTRACT_ADDRESS,\n                  payload: contractInstance.options.address,\n                });\n                const contractData = {\n                  contractadd: contractInstance.options.address,\n                  Network: 'Etherium',\n                  Deployed: true,\n                };\n\n                dispatch({\n                  type: CONTRACT_REPONSE,\n                  payload: contractData,\n                });\n              })\n              .catch((err) => {\n                // console.log(\"error\", err);\n                dispatch({\n                  type: LOADER,\n                  payload: false,\n                });\n                toast.error('Transaction Failed please check wallet history!');\n              });\n          } catch (err) {\n            dispatch({\n              type: LOADER,\n              payload: false,\n            });\n            toast.error('Transaction Failed please check wallet history!');\n          }\n        } else {\n          dispatch({\n            type: LOADER,\n            payload: false,\n          });\n          // console.log(res, \"dkfjdkfjkdjfkd\");\n          toast.error(res.data.data);\n\n          // dispatch({\n          //   type: CONTRACT_REPONSE,\n          //   payload: res.data,\n          // });\n        }\n        // console.log(res);\n      },\n      (error) => {\n        // console.log(error, 'error handle');\n        toast.error(error.response.data.data);\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        // console.log(error, \"error==dfjdkf\");\n        dispatch({\n          type: CONTRACT_ERROR_MESSAGE,\n          payload: error,\n        });\n        // alert(\"contract response\")\n        // dispatch({\n        //   type: CONTRACT_REPONSE,\n        //   payload: error,\n        // });\n        // resolve(error)\n      }\n    )\n    .catch((err) => {\n      console.log(err, 'error later==>');\n    });\n};\n\nexport const mintToken = (data, address, supply, email) => (dispatch) => {\n  dispatch({\n    type: LOADER,\n    payload: true,\n  });\n  // console.log('here is data', data)\n  dispatch({\n    type: CONNECT_WELLET,\n    payload: address,\n  });\n  let metaDataList = [];\n  // console.log(data, \"data=====>\");\n  let metaData = '';\n  if (!data.data) {\n    metaData = data;\n  } else {\n    metaData = data.data.metaData;\n  }\n\n  for (let i = 1; i <= supply; i++) {\n    metaDataList.push(metaData);\n  }\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n  // console.log(\"metaDataList\", metaDataList);\n\n  try {\n    const web3 = new Web3(Web3.givenProvider);\n    // console.log('web3', web3);\n    const contractM = new web3.eth.Contract(\n      data.data.abi,\n      data.contractAddress\n    );\n    // console.log(\"metaDataList\", metaDataList);\n    contractM.methods\n      .batchMint(address, metaDataList, supply)\n      .send({\n        from: address,\n        // gas: 5000000,\n      })\n      .then((response) => {\n        // console.log(response, \"res of createNFT===>\");\n        handleEmailRequest(email);\n        let count = localStorage.getItem(address);\n        if (count) {\n          console.log(typeof (+count * 1), 'issueee');\n          localStorage.setItem(address, +count * 1 + 1);\n        } else {\n          localStorage.setItem(address, 1);\n        }\n        toast.success('Minting Successful');\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        dispatch({\n          type: TOKEN_ID,\n          payload: response,\n        });\n        dispatch({\n          type: MINTING_RESPONSE,\n          payload: response,\n        });\n      })\n      .catch((err) => {\n        console.log(err, 'error==>');\n        dispatch({\n          type: LOADER,\n          payload: false,\n        });\n        toast.error('Transaction Failed please check wallet history!');\n      });\n  } catch (err) {\n    dispatch({\n      type: LOADER,\n      payload: false,\n    });\n    toast.error('Transaction Failed please check wallet history!');\n  }\n};\nconst handleEmailRequest = (email) => {\n  let data = {\n    email,\n  };\n\n  const config = {\n    headers: {\n      // 'Content-Type': isMultipart ? 'multipart/form-data' : 'application/json',\n    },\n  };\n\n  let url = `${ENV.url}/users/addEmail`;\n  // console.log(url);\n  axios\n    .post(url, data, config)\n    .then((res) => {\n      // console.log(res, \"email response==>\");\n    })\n    .catch((err) => console.log(err));\n};\nexport const setContractInfo = () => (dispatch) => {\n  dispatch({\n    type: SET_CONTRACT_INFO,\n  });\n};\n\nexport const connectWallet = () => (dispatch) => {\n  connectMetamaskCopy()\n    .then((address) =>\n      // console.log(address,\"address\"),\n      dispatch({\n        type: CONNECT_WELLET,\n        payload: address,\n      })\n    )\n    .catch((err) => console.log(err, 'error'));\n};\n\nexport const hometest = () => (dispatch) => {\n  // dispatch({\n  // type:HOME_TEST,\n  // payload: data\n  // })\n  // dispatch(emptyError());\n  // const url = `${ENV.url}/nfts/${type}`;\n  // fetch(url, {\n  // method,\n  // headers: {\n  // 'Authorization': ENV.Authorization,\n  // 'x-auth-token': ENV.x_auth_token,\n  // 'Access-Control-Allow-Origin': '*',\n  // 'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n  // },\n  // body\n  // }).then(res => res.json()).then(data => {\n  // if (data.success) {\n  // toast.success(data.message)\n  // dispatch({\n  // type: UPSERT_NFT,\n  // payload: data\n  // })\n  // } else {\n  // toast.error(data.message)\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: data\n  // })\n  // }\n  // }).catch(error => {\n  // if (error.response && error.response.data) {\n  // const { data } = error.response\n  // if (data.message)\n  // toast.error(data.message)\n  // }\n  // dispatch({\n  // type: GET_ERRORS,\n  // payload: error\n  // })\n  // })\n};\n",["319","320"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.js",["321","322","323","324","325","326","327"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step2/Step2.js",["328","329"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step4/Step4.js",["330","331","332","333","334","335","336","337","338","339"],"import { useState, useEffect } from \"react\";\nimport MetamaskImg from \"../../../../assets/images/metamask.svg\";\nimport RefreshImg from \"../../../../assets/images/Refresh.svg\";\nimport DetailsImg from \"../../../../assets/images/Details.svg\";\nimport DiscordImg from \"../../../../assets/images/Discord.svg\";\nimport ReactCaptcha from \"../../../../components/Captcha/Captcha\";\n// import { connectMetamaskCopy } from \"../../../../Utils/web3\";\nimport PreviewModal from \"../../../../components/PreviewModal/PreviewModal\";\n// import { CopyToClipboard } from \"react-copy-to-clipboard\";\nimport { MdContentCopy } from \"react-icons/md\";\nimport { getNetworkNameByChainId } from \"../../../../utils/web3\";\nimport {\n  connectWallet,\n  contractResponse,\n  sendOtp,\n  verifyOtp,\n} from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport \"./Step4.css\";\nimport copy from \"copy-to-clipboard\";\nimport { toast } from \"react-toastify\";\nimport { getWalletAddress } from \"../../../../utils/web3\";\nimport { ENV } from \"../../../../config/config\";\nimport { ProgressBar } from \"react-bootstrap\";\n// import Stepper from \"../../../../Components/Stepper/Stepper\";\n// import { propTypes } from \"react-bootstrap/esm/Image\";\nconst Step4 = (props) => {\n  const { discordLink } = ENV;\n  // console.log(props,\"props in setp 4\")\n  const [isVisible, setIsvisible] = useState(false);\n  // const [isValidate, setIsvalidate] = useState(false);\n  const [captchaStatus, setCaptchaStatus] = useState(false);\n  const [captchaError, setCaptchaError] = useState(false);\n  const [captchaMessage, setCaptchaMessage] = useState(\n    \"Invalid Captchca Please Try Again\"\n  );\n  const [email, setEmail] = useState(props.email);\n  const [deployNetwork, setDeployNetwork] = useState(\"\");\n  const [deploy, setDeploy] = useState(false);\n  // const [compile, setCompile] = useState(false);\n  const [loadingMessage, setLoadingMessage] = useState(\"\");\n  const [error, setError] = useState(false);\n  const [emailError, setEmailError] = useState(false);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  //otp verification\n  const [otp, setOtp] = useState(\"\");\n  const [otpError, setOtpError] = useState(false);\n\n  //previewModal\n  const [previewModal, setPreviewModal] = useState(false);\n  const [previewModalStep, setPreviewModalStep] = useState(1);\n  const [maxLimit, setMaxLimit] = useState(false);\n\n  const handleCaptcha = (value) => {\n    // console.log(value);\n    setCaptchaStatus(value);\n    setCaptchaError(false);\n    // if (value) {\n    //   setIsvalidate(true);\n    // }\n  };\n  const checkInternetConnection = () => {\n    var ifConnected = window.navigator.onLine;\n    if (!ifConnected) {\n      toast.error(\"Internet Connection not available!\");\n      return false;\n    } else {\n      return true;\n    }\n  };\n\n  const onChangeEmail = (e) => {\n    setError(false);\n    setEmailError(false);\n    setEmail(e.target.value.trimStart());\n    props.handleStep4Info(e.target.value.trimStart());\n  };\n\n  const handleVisible = () => {\n    setIsvisible(true);\n  };\n\n  const submitCaptcha = () => {\n    // console.log(captchaStatus, \"captchaStatus\");\n    if (checkInternetConnection()) {\n    if (email && emailValidate()) {\n      if (captchaStatus) {\n        // setIsvalidate(true);\n        props.handleCaptchaValidation(true);\n        let data = {\n          email,\n        };\n        toast.success(`Verification OTP code is sent to ${email}`);\n        props.sendOtp(data);\n      } else {\n        setCaptchaError(true);\n      }\n    } else {\n      setEmailError(true);\n      setErrorMessage(\"Please proivde Email.\");\n    }\n  }\n  };\n\n  const onConnect = () => {\n    // props.connectWallet()\n    if (!email) {\n      setEmailError(true);\n      setErrorMessage(\"Email is required\");\n      return \"\";\n    } else {\n      const validate = emailValidate();\n      if (!validate) return \"\";\n    }\n\n    getWalletAddress().then((address) => {\n      // let count = localStorage.getItem(address);\n      // // console.log(count,\"count\")\n      // if (+count > 100) {\n      //   toast.error(\"Maximum Deployment Limit Reached with This Wallet Address! Please contact support.\");\n      //   setMaxLimit(true)\n      //   return \"\";\n      // }\n      // else {\n      //   setMaxLimit(false)\n      // }\n    });\n\n    if (email === \"\") {\n      setError(true);\n      return \"\";\n    }\n\n    props.handleDeployContract();\n  };\n  const emailValidate = () => {\n    if (\n      !String(email)\n        .toLowerCase()\n        .match(\n          /^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/\n        )\n    ) {\n      setEmailError(true);\n      setErrorMessage(\"Email must be valid\");\n      return false;\n    }\n    return true;\n  };\n\n  const onReload = () => {\n \n    if (!email) {\n      setEmailError(true);\n      setErrorMessage(\"Email is required\");\n      return \"\";\n    } else {\n      const validate = emailValidate();\n      if (!validate) return \"\";\n    }\n\n    if (!props.contractReponse) {\n      setDeploy(true);\n\n      // props.contractResponse();\n      props.handleStep4Info(email, deployNetwork);\n      props.handleDeployContract();\n    }\n  };\n\n  const onMint = () => {\n    if (checkInternetConnection()) {\n      if (email === \"\") {\n        setError(true);\n        return \"\";\n      }\n\n      getNetworkNameByChainId()\n        .then((network) => {\n          // console.log(network,\"network==>\")\n          // console.log(props,\"props==>9\")\n          if (network === props.connectedNetwork || !props.connectedNetwork) {\n            setLoadingMessage(\"Please wait your NFT is Minting...\");\n\n            setDeploy(true);\n            props.handleStep4Info(email, deployNetwork);\n\n            props.handleMinting(props.contractInfo, email);\n          } else {\n            toast.error(\n              `Please connect with ${props.connectedNetwork} network`\n            );\n          }\n        })\n        .catch((err) => {});\n    }\n  };\n  useEffect(() => {}, [props.connectedAddressFlag]);\n\n  useEffect(() => {\n    // console.log('all props ', props)\n    // console.log('response for contract ', props.contractResponse)\n  }, [props.contractResponse]);\n\n  const handlePreviewModal = () => {\n    // if(!email)\n    setPreviewModalStep(1);\n    setPreviewModal(!previewModal);\n  };\n\n  const handlePreviewModalSteps = (action) => {\n    if (action === \"next\") {\n      setPreviewModalStep(2);\n    } else {\n      setPreviewModalStep(1);\n    }\n  };\n\n  const onDeploy = () => {\n    if (checkInternetConnection()) {\n      setPreviewModal(false);\n      setLoadingMessage(\"Please wait your contract is Deploying...\");\n      setDeploy(true);\n      props.handleStep4Info(email, deployNetwork);\n      props.handleDeployment();\n    }\n  };\n  // console.log(props,\"tokenId===>\")\n  const displayToken = () => {\n    if (props?.tokenId) {\n      return props.tokenId;\n    }\n    if (props.tokenMinted) {\n      if (+props.supply > 1) {\n        return ` 1-${props.supply}`;\n      }\n    }\n  };\n  const handleOtpVerification = () => {\n    if (checkInternetConnection()) {\n      if (!otp.trim()) {\n        setOtpError(true);\n      } else {\n        props.verifyOtp(email, otp);\n      }\n    }\n  };\n  const sendEmailOtp = () => {\n    if (checkInternetConnection()) {\n      console.log(checkInternetConnection())\n    if (emailValidate()) {\n      let data = {\n        email,\n      };\n      toast.success(`Verification OTP code is sent to ${email}`);\n      props.sendOtp(data);\n    }\n  }\n  };\n  // console.log(props);\n  return (\n    <div className=\"step4-container w-80\">\n      {/* Metamask container */}\n      <div className=\"metamask-container \">\n        <div className=\"d-md-flex justify-content-between w-100 step-4-wrapper\">\n          <div className=\"form-container w-50\">\n            <div className=\"d-flex \" style={{ flexDirection: \"column\" }}>\n              <div className=\"position-relative\">\n                <label className=\"text-white step4-label\">Email</label>\n                {error && (\n                  <p className=\"mb-0\" style={{ color: \"red\" }}>\n                    {errorMessage}\n                  </p>\n                )}\n                <p\n                  className=\"position-absolute\"\n                  style={{ color: \"red\", top: \"0\", left: \"3.9rem\" }}\n                >\n                  *\n                </p>\n                <p className=\"mb-1\" style={{ color: \"red\" }}>\n                  {emailError && errorMessage}\n                </p>\n              </div>\n\n              <input\n                className=\"step-4-input mt-2\"\n                type=\"text\"\n                onChange={(e) => onChangeEmail(e)}\n                onBlur={(e) => emailValidate(e)}\n                disabled={false}\n                disabled={\n                  props.walletAddress || props.otpVerification ? true : false\n                }\n                value={email}\n                placeholder=\"example@gmail.com\"\n                style={{ maxWidth: \"22rem\", color: \"white\" }}\n              />\n            </div>\n\n            {props.isValidate === false ? (\n              <div className=\"mt-4\">\n                <label className=\"text-white mb-2 step4-label\">\n                  Verify Captcha\n                </label>\n                <ReactCaptcha\n                  handleCaptcha={handleCaptcha}\n                  handleVisible={handleVisible}\n                  isVisible={isVisible}\n                />\n                <p className=\"text-danger mb-0 mt-1\">\n                  {captchaError && captchaMessage}\n                </p>\n                <button\n                  // className=\"btn btn-primary step4-btn\"\n                  className=\"btn btn-secondary start-btn\"\n                  style={{ marginTop: \"0.8rem\" }}\n                  onClick={() => submitCaptcha()}\n                >\n                  Submit\n                </button>\n              </div>\n            ) : // <>\n            !props.otpVerification ? (\n              <div className=\"d-flex flex-column\">\n                <label className=\"text-white step4-label mt-4\">OTP</label>\n                {otpError && (\n                  <p className=\"text-danger  my-1\">Please Enter OTP</p>\n                )}\n                <input\n                  className=\"step-4-input mt-2\"\n                  type=\"Number\"\n                  onChange={(e) => {\n                    setOtpError(false);\n                    setOtp(e.target.value);\n                  }}\n                  placeholder=\"Enter OTP\"\n                  style={{ maxWidth: \"22rem\", color: \"white\" }}\n                />\n                <button\n                  className=\"btn btn-secondary verify-otp-btn mt-4\"\n                  style={{ marginTop: \"0.8rem\", maxWidth: \"22rem\" }}\n                  onClick={() => handleOtpVerification()}\n                >\n                  Verify\n                  {/* <div class=\"spinner-border verify-spinner\" role=\"status\">\n                    <span class=\"sr-only\">Loading...</span>\n                  </div> */}\n                </button>\n                <button\n                  // className=\"btn btn-primary step4-btn\"\n                  className=\"btn btn-secondary verify-otp-btn mt-4\"\n                  style={{ marginTop: \"0.8rem\", maxWidth: \"22rem\" }}\n                  onClick={() => sendEmailOtp()}\n                >\n                  Resend OTP\n                  {/* <div class=\"spinner-border verify-spinner\" role=\"status\">\n                    <span class=\"sr-only\">Loading...</span>\n                  </div> */}\n                </button>\n              </div>\n            ) : (\n              // <>\n              // !props.otpVerification ? (\n              //   <div className=\"d-flex flex-column\">\n              //     <label className=\"text-white step4-label mt-4\">OTP</label>\n              //     {otpError && (\n              //       <p className=\"text-danger  my-1\">Please Enter OTP</p>\n              //     )}\n              //     <input\n              //       className=\"step-4-input mt-2\"\n              //       type=\"Number\"\n              //       onChange={(e) => {\n              //         setOtpError(false);\n              //         setOtp(e.target.value);\n              //       }}\n              //       placeholder=\"Enter OTP\"\n              //       style={{ maxWidth: \"22rem\", color: \"white\" }}\n              //     />\n              //     <button\n              //       // className=\"btn btn-primary step4-btn\"\n              //       className=\"btn btn-secondary verify-otp-btn mt-4\"\n              //       style={{ marginTop: \"0.8rem\", maxWidth: \"22rem\" }}\n              //       onClick={() => handleOtpVerification()}\n              //     >\n              //       Verify\n              //       {/* <div class=\"spinner-border verify-spinner\" role=\"status\">\n              //         <span class=\"sr-only\">Loading...</span>\n              //       </div> */}\n              //     </button>\n              //   </div>\n              // ) :\n              <div className=\"d-flex mt-4\" style={{ flexDirection: \"column\" }}>\n                <div>\n                  <img\n                    src={MetamaskImg}\n                    style={{ width: \"2rem\", marginRight: \"0.8rem\" }}\n                  />\n                  <div className=\"position-relative\">\n                    <label className=\"text-white step4-label\">\n                      Connect Wallet\n                    </label>\n                    <p\n                      className=\"position-absolute\"\n                      style={{ color: \"red\", top: \"0\", left: \"10.4rem\" }}\n                    >\n                      *\n                    </p>\n                  </div>\n                </div>\n                <p className=\"mb-0 mt-2\" style={{ color: \"#aaabab\" }}>\n                  {\" \"}\n                  Connect Wallet with Metamask\n                </p>\n                <div className=\"d-flex align-items-center w-100\">\n                  <button\n                    className={`btn btn-primary my-3 ${\n                      props.walletAddress ? \"step4-btn\" : \"start-btn\"\n                    }`}\n                    style={{ marginTop: \"0.8rem\" }}\n                    disabled={\n                      props.contractReponse || props.walletAddress\n                        ? true\n                        : false\n                    }\n                    onClick={() => onConnect()}\n                  >\n                    {props.walletAddress ? props.walletAddress : \"Connect\"}\n                  </button>\n                  {!props.loader && !props.contractReponse && (\n                    <img\n                      src={RefreshImg}\n                      style={{\n                        width: \"2rem\",\n                        marginLeft: \"0.8rem\",\n                        cursor: \"pointer\",\n                      }}\n                      disabled={props.contractReponse ? true : false}\n                      onClick={() => onReload()}\n                    />\n                  )}\n                </div>\n              </div>\n            )}\n          </div>\n          <div className=\"discord-container discordJoinCls w-50\">\n            <div\n              className=\"d-flex align-items-center\"\n              style={{ width: \"100%\" }}\n            >\n              <img\n                src={DiscordImg}\n                style={{ width: \"2rem\", marginRight: \"1rem\" }}\n                alt=\"\"\n              />\n              <p className=\"step4-label text-white mb-0\"> Join Discord</p>\n            </div>\n            <p className=\"\" style={{ color: \"#aaabab\" }}>\n              “NFTs are the next big disruptor, just as the internet and\n              eCommerce was.” — Gary Vaynerchuck, Investment guru Mainstream\n              community of digital celebrities and collectors awaits you on\n              Discord!\n            </p>\n            <a\n              className=\"btn btn-secondary discord-btn  mt-2 navbar-item\"\n              style={{ padding: \"0.4rem 6rem !important\" }}\n              href={discordLink}\n              target=\"_blank\"\n            >\n              Join\n            </a>\n          </div>\n        </div>\n        {props.walletAddress && (\n          <div className=\"w-100 text-center mt-4\">\n            <button\n              className=\"btn btn-primary start-btn\"\n              style={{\n                marginTop: \"0.8rem\",\n                backgroundColor: \"#FCD70D  !important\",\n                color: \"black !important\",\n              }}\n              disabled={props.contractReponse ? true : false}\n              onClick={handlePreviewModal}\n            >\n              Preview\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* Details */}\n\n      {props.loader &&\n      (props.contractReponse == false || props.mintingResponse === false) ? (\n        <div className=\"w-100 text-center mt-4\">\n          <div\n            className=\"spinner-border\"\n            style={{ color: \"white\" }}\n            role=\"status\"\n          ></div>\n          <p className=\"text-white\">{loadingMessage}</p>\n          {/* <Stepper/> */}\n        </div>\n      ) : (\n        (props.contractReponse || props.mintingResponse) &&\n        !props.contractError && (\n          <div className=\"step4-details-container mb-2 d-flex justify-content-center w-100\">\n            <div className=\"w-100 d-flex flex-column justify-content-center align-items-center\">\n              <div className=\" w-100 d-flex justify-content-center mt-4\">\n                <div className=\"d-flex align-items-center\">\n                  <img\n                    src={DetailsImg}\n                    style={{ width: \"1.4rem\", marginRight: \"0.5rem\" }}\n                  />\n                  <p className=\"text-white details-title mb-0\">Details</p>\n                </div>\n              </div>\n\n              <div className=\"details-box py-4 mt-4\">\n                <div className=\"details-box-content d-flex justify-content-between flex-row p-2 p-sm-4\">\n                  <div>\n                    <p className=\"info\">Contract Address</p>\n\n                    {props.tokenMinted && props.tokenMinted.length > 0 ? (\n                      <p className=\"info\"> {\"Token ID's\"} </p>\n                    ) : props.tokenId ? (\n                      <p className=\"info\"> {\"Token ID\"} </p>\n                    ) : (\n                      \"\"\n                    )}\n\n                    <p className=\"info\">Token Standard</p>\n                    <p className=\"info\">Blockchain</p>\n                  </div>\n\n                  <div>\n                    <div className=\"d-flex\">\n                      <p\n                        className=\"info\"\n                        style={{\n                          color: \"rgb(68, 209, 249)\",\n                          marginRight: \"0.3rem\",\n                        }}\n                      >\n                        {\" \"}\n                        {props.contractAddress\n                          ? `${String(props.contractAddress).substr(\n                              0,\n                              10\n                            )}.....${String(props.contractAddress).substr(\n                              -10,\n                              String(props.contractAddress).length\n                            )}`\n                          : \"0xsbms....dks33\"}\n                      </p>\n\n                      <MdContentCopy\n                        onClick={() => {\n                          copy(props?.contractAddress);\n                          toast.success(\"Address Copied!\");\n                        }}\n                        style={{\n                          color: \"white\",\n                          width: \"1.3rem\",\n                          height: \"1.3rem\",\n                          cursor: \"pointer\",\n                          marginTop: \"0rem\",\n                        }}\n                      />\n                    </div>\n\n                    {props.tokenId ? (\n                      <p className=\"info\"> {displayToken()} </p>\n                    ) : props.tokenMinted && props.tokenMinted.length > 0 ? (\n                      <p className=\"info\"> {displayToken()} </p>\n                    ) : (\n                      \"\"\n                    )}\n\n                    <p className=\"info \">ERC-721</p>\n                    <p className=\"info \">Ethereum</p>\n                  </div>\n                </div>\n                <div className=\"w-100 text-center \">\n                  {!props.mintingResponse && (\n                    <button\n                      className=\"btn btn-primary mintbtn\"\n                      onClick={() => onMint()}\n                    >\n                      Let's Mint\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )\n      )}\n      <PreviewModal\n        previewModal={previewModal}\n        handlePreviewModal={handlePreviewModal}\n        handlePreviewModalSteps={handlePreviewModalSteps}\n        previewModalStep={previewModalStep}\n        onDeploy={onDeploy}\n        properties={props.properties}\n        levels={props.levels}\n        info={props.info}\n        maxLimit={maxLimit}\n      />\n      <div\n        className=\"progress-bar-custom\"\n        style={{ width: \"64%\", margin: \"3rem auto 0 auto\" }}\n      >\n        <ProgressBar\n          className={`${\n            props.currentStep === 4\n              ? \"progress-bar-green\"\n              : \"progress-bar-yellow\"\n          }`}\n          now={props.currentStep * 25}\n        />\n        <p className=\"text-white text-center mt-2\">{props.currentStep}/4</p>\n      </div>\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    connectedAddress: state.dashboard.connectedAddress,\n    connectedAddressFlag: state.dashboard.connectedAddressFlag,\n    contractReponse: state.dashboard.contractReponse,\n    contractError: state.dashboard.contractError,\n    contractInfo: state.dashboard.contractInfo,\n    mintingResponse: state.dashboard.mintingResponse,\n    loader: state.dashboard.loader,\n    tokenId: state.dashboard.tokenId,\n    contractAddress: state.dashboard.contractAddress,\n    tokenMinted: state.dashboard.tokenMinted,\n    otpVerification: state.dashboard.otpVerification,\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n    otpEmail: state.dashboard.otpEmail,\n  });\n\nexport default connect(mapStateToProps, {\n  connectWallet,\n  contractResponse,\n  sendOtp,\n  verifyOtp,\n})(Step4);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-search/modal-search.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/modal-menu/modal-menu.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/scroll-up/sroll-up.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/header/header.js",["340","341","342","343","344","345","346"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step1/Step1.js",["347","348","349"],"import { useState, useEffect } from \"react\";\nimport \"./Step1.css\";\n// import { RiFolderUploadLine} from \"react-icons/ri\";\nimport { currentStepAction } from \"../../../../redux/actions/actions\";\nimport { BsImageFill } from \"react-icons/bs\";\nimport uploadIcon from \"../../../../assets/images/uploadIcon.png\";\nimport { connect } from \"react-redux\";\nimport { BsUpload } from \"react-icons/bs\";\nimport { MdClose } from \"react-icons/md\";\nimport { Grid, IconButton, Typography } from \"@mui/material\";\nimport { ProgressBar } from \"react-bootstrap\";\nimport VideoView from \"../../../../components/videoComponent/videoComponent\";\n\nconst Step1 = (props) => {\n  const [file, setFile] = useState(\"\");\n  const [img, setImage] = useState(props.imageURl);\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [videoUrl, setVideoUrl] = useState(props.videoURL);\n  // console.log(process.env,\"config.baseurl===>\")\n\n  useEffect(() => {\n    // console.log(videoUrl);\n  }, [videoUrl]);\n  const onFileChange = (event) => {\n    setErrorMessage(\"\");\n\n    if (event.target.files[0]) {\n      // console.log(event.target.files[0], \"event.target.files[0]==>\");\n\n      let type = event.target.files[0].type;\n      // console.log(type,\"typee\")\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\"\n      ) {\n        let fileSize = formatBytes(event.target.files[0].size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          setErrorMessage(\"File size limit is exceeded\");\n        } else {\n          let url = URL.createObjectURL(event.target.files[0]);\n          if (event.target.files[0].type === \"video/mp4\") {\n            setVideoUrl(url);\n            setImage(\"\");\n          } else {\n            setImage(url);\n            setVideoUrl(\"\");\n            // console.log(formatBytes(event.target.files[0].size).split(' ') ,\"event.target.files[0]==>\")\n            setFile(event.target.files[0]);\n          }\n        }\n        if (\n          type === \"image/jpeg\" ||\n          type === \"image/png\" ||\n          type === \"image/gif\" ||\n          type === \"video/mp4\"\n        ) {\n          let fileSize = formatBytes(event.target.files[0].size).split(\" \");\n          if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n            setErrorMessage(\"File size limit is exceeded\");\n          } else {\n            let url = URL.createObjectURL(event.target.files[0]);\n            if (event.target.files[0].type === \"video/mp4\") {\n              setVideoUrl(url);\n              setImage(\"\");\n            } else {\n              setImage(url);\n              setVideoUrl(\"\");\n              // console.log(formatBytes(event.target.files[0].size).split(' ') ,\"event.target.files[0]==>\")\n              setFile(event.target.files[0]);\n            }\n          }\n        } else {\n          setErrorMessage(\"File not supported!\");\n        }\n      } else {\n        setErrorMessage(\"File not supported!\");\n      }\n    }\n  };\n  function formatBytes(bytes, decimals = 2) {\n    if (bytes === 0) return \"0 Bytes\";\n\n    const k = 1024;\n    const dm = decimals < 0 ? 0 : decimals;\n    const sizes = [\"Bytes\", \"KB\", \"MB\", \"GB\", \"TB\", \"PB\", \"EB\", \"ZB\", \"YB\"];\n\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n\n    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + \" \" + sizes[i];\n  }\n\n  // On file upload (click the upload button)\n  const onFileUpload = () => {\n    if (img === \"\" && videoUrl === \"\") {\n      setErrorMessage(\"Please upload a file\");\n      return \"\";\n    }\n    // console.log(file);\n    props.handleStep1Info(file, videoUrl, img);\n    props.currentStepAction();\n  };\n  const dragOver = (e) => {\n    e.preventDefault();\n  };\n\n  const dragEnter = (e) => {\n    e.preventDefault();\n  };\n\n  const dragLeave = (e) => {\n    e.preventDefault();\n  };\n  const onDrop = (e) => {\n    // alert(\"onDrag video\")\n\n    e.preventDefault();\n    setErrorMessage(\"\");\n    setVideoUrl(\"\");\n    const files = e.dataTransfer.files[0];\n    if (files) {\n      const type = e.dataTransfer.files[0].type;\n      console.log(files);\n      if (\n        type === \"image/jpeg\" ||\n        type === \"image/png\" ||\n        type === \"image/gif\" ||\n        type === \"video/mp4\"\n      ) {\n        let fileSize = formatBytes(files.size).split(\" \");\n        if (+fileSize[0] > 100 && fileSize[1] === \"MB\") {\n          setErrorMessage(\"File size limit is exceeded\");\n        } else {\n        \n\n          let url = URL.createObjectURL(files);\n          if (files.type === \"video/mp4\") {\n       \n\n            setVideoUrl(url);\n            props.handleStep1Info(file, videoUrl, img);\n\n            // setTimeout(()=>{\n\n            //   // setVideoUrl(url);\n            // },1000)\n            setImage(\"\");\n          } else {\n            setImage(url);\n            setVideoUrl(\"\");\n            // console.log(formatBytes(e.target.files[0].size).split(' ') ,\"e.target.files[0]==>\")\n            setFile(files);\n          }\n        }\n      } else {\n        setErrorMessage(\"File not supported!\");\n      }\n    }\n  };\n\n  const removeVideo = (event) => {\n    event.preventDefault();\n    event.stopPropagation();\n    setVideoUrl(\"\");\n  };\n\n  const removeImage = (event) => {\n    event.preventDefault();\n    event.stopPropagation();\n    setImage(\"\");\n  };\n\n  return (\n    <>\n      <p className=\"text-white upload-img-title mb-1\">Upload Asset</p>\n      <p\n        className=\"text-white testingkkk \"\n        style={{ fontSize: \"14px\", padding: \"0rem\", margin: \"0rem\" }}\n      >\n        File type supported:JPEG/PNG/GIF/MP4 max size 100 MB.{\" \"}\n      </p>\n      {videoUrl && (\n        <div\n          className=\"position-relative\"\n          style={{ width: \"210px\" }}\n          onDrop={(e) => onDrop(e)}\n          onDragOver={(e) => dragOver(e)}\n          onDragEnter={(e) => dragEnter(e)}\n          onDragLeave={(e) => dragLeave(e)}\n        >\n          <VideoView videoUrl={videoUrl} />\n\n          <MdClose\n            color=\"#e33d0bc2\"\n            className=\"\"\n            onClick={removeVideo}\n            style={{\n              fontSize: \"2.5rem\",\n              cursor: \"pointer\",\n              top: \"28px\",\n              right: \"4px\",\n              position: \"absolute\",\n              zIndex: 99,\n            }}\n          />\n        </div>\n      )}\n\n      {/* <p style={{ color: \"red\" }}>{errorMessage && errorMessage}</p> */}\n      <Grid container style={{ justifyContent: \"space-between\" }}>\n        <Grid item md={6}>\n          {!img ? (\n            <>\n              {!videoUrl && !img && (\n                <>\n                  <label\n                    className=\"text-center d-flex mt-2\"\n                    style={{ cursor: \"pointer\" }}\n                  >\n                    <div\n                      className=\"file-container text-white d-flex justify-content-center align-items-center mt-2 mb-5\"\n                      onDrop={(e) => onDrop(e)}\n                      onDragOver={(e) => dragOver(e)}\n                      onDragEnter={(e) => dragEnter(e)}\n                      onDragLeave={(e) => dragLeave(e)}\n                    >\n                      <div\n                        className=\"d-flex h-100 justify-content-center align-items-center \"\n                        style={{ flexDirection: \"column\", cursor: \"pointer\" }}\n                      >\n                        {/* <RiFolderUploadLine className=\"upload-icon\" /> */}\n                        <img className=\"upload-icon mb-3\" src={uploadIcon} />\n\n                        <p\n                          style={{\n                            color: \"#aaabab\",\n                            fontSize: \"14px\",\n                            margin: \"0rem\",\n                          }}\n                        >\n                          Add photo or video <br /> or Drag and drop\n                        </p>\n                        <input\n                          type=\"file\"\n                          style={{ display: \"none\" }}\n                          onChange={onFileChange}\n                          accept=\".mp4, .png,.jpeg\"\n                        />\n                      </div>\n                    </div>\n                  </label>\n                  <p style={{ color: \"red\" }}>{errorMessage && errorMessage}</p>\n                  <div\n                    onDrop={(e) => onDrop(e)}\n                    onDragOver={(e) => dragOver(e)}\n                    onDragEnter={(e) => dragEnter(e)}\n                    onDragLeave={(e) => dragLeave(e)}\n                    className=\"mb-4\"\n                  >\n                    <label>\n                      <div\n                        className=\"d-flex align-items-center justify-content-center mb-3\"\n                        style={{\n                          backgroundColor: \"#001d43\",\n                          width: \"13.2rem\",\n                          height: \"3rem\",\n                          borderRadius: \"10px\",\n                          cursor: \"pointer\",\n                        }}\n                      >\n                        <BsUpload\n                          style={{ fontSize: \"1.4rem\", color: \"white\" }}\n                        />\n                      </div>\n                      <input\n                        type=\"file\"\n                        style={{ display: \"none\" }}\n                        onChange={onFileChange}\n                        accept=\".mp4, .png,.jpeg\"\n                        onDrop={(e) => onFileChange(e)}\n                        onDragOver={(e) => onFileChange(e)}\n                        onDragEnter={(e) => onFileChange(e)}\n                        onDragLeave={(e) => onFileChange(e)}\n                      />\n                    </label>\n                  </div>\n                </>\n              )}\n              {videoUrl && (\n                <div\n                  onDrop={(e) => onDrop(e)}\n                  onDragOver={(e) => dragOver(e)}\n                  onDragEnter={(e) => dragEnter(e)}\n                  onDragLeave={(e) => dragLeave(e)}\n                >\n                  <label>\n                    <div\n                      className=\"d-flex align-items-center justify-content-center mb-3\"\n                      style={{\n                        backgroundColor: \"#001d43\",\n                        width: \"13.2rem\",\n                        height: \"3rem\",\n                        borderRadius: \"10px\",\n                        cursor: \"pointer\",\n                      }}\n                    >\n                      <BsUpload\n                        style={{ fontSize: \"1.4rem\", color: \"white\" }}\n                      />\n                    </div>\n                    <input\n                      type=\"file\"\n                      style={{ display: \"none\" }}\n                      onChange={onFileChange}\n                      accept=\".mp4, .png,.jpeg\"\n                      onDrop={(e) => onFileChange(e)}\n                      onDragOver={(e) => onFileChange(e)}\n                      onDragEnter={(e) => onFileChange(e)}\n                      onDragLeave={(e) => onFileChange(e)}\n                    />\n                  </label>\n                </div>\n              )}\n            </>\n          ) : (\n            <>\n              <div\n                className=\"text-white d-flex  mt-4 mb-5\"\n                style={{ cursor: \"pointer\" }}\n                onDrop={(e) => onDrop(e)}\n                onDragOver={(e) => dragOver(e)}\n                onDragEnter={(e) => dragEnter(e)}\n                onDragLeave={(e) => dragLeave(e)}\n              >\n                <label className=\"text-center position-relative label-parent\">\n                  <MdClose\n                    color=\"#e33d0bc2\"\n                    className=\"\"\n                    onClick={removeImage}\n                    style={{\n                      fontSize: \"2.5rem\",\n                      cursor: \"pointer\",\n                      top: 0,\n                      right: 0,\n                      position: \"absolute\",\n                      zIndex: 99,\n                    }}\n                  />\n                  <img\n                    className=\"selected-file \"\n                    src={img}\n                    alt=\"uploaded image\"\n                    style={{ cursor: \"pointer\" }}\n                  />\n\n                  <BsImageFill\n                    className=\"position-absolute upload-img-icon\"\n                    style={{ fontSize: \"1.2rem\", cursor: \"pointer\" }}\n                  />\n                  <input\n                    type=\"file\"\n                    style={{ display: \"none\" }}\n                    onChange={onFileChange}\n                    accept=\".mp4, .png,.jpeg\"\n                  />\n                </label>\n              </div>\n              <div\n                onDrop={(e) => onDrop(e)}\n                onDragOver={(e) => dragOver(e)}\n                onDragEnter={(e) => dragEnter(e)}\n                onDragLeave={(e) => dragLeave(e)}\n                className=\"mb-4\"\n              >\n                <label>\n                  <div\n                    className=\"d-flex align-items-center justify-content-center mb-3\"\n                    style={{\n                      backgroundColor: \"#001d43\",\n                      width: \"13.2rem\",\n                      height: \"3rem\",\n                      borderRadius: \"10px\",\n                      cursor: \"pointer\",\n                    }}\n                  >\n                    <BsUpload style={{ fontSize: \"1.4rem\", color: \"white\" }} />\n                  </div>\n                  <input\n                    type=\"file\"\n                    style={{ display: \"none\" }}\n                    onChange={onFileChange}\n                    accept=\".mp4, .png,.jpeg\"\n                    onDrop={(e) => onFileChange(e)}\n                    onDragOver={(e) => onFileChange(e)}\n                    onDragEnter={(e) => onFileChange(e)}\n                    onDragLeave={(e) => onFileChange(e)}\n                  />\n                </label>\n              </div>\n            </>\n          )}\n        </Grid>\n        <Grid item md={5} className=\"d-none d-md-block\">\n          <Typography className=\"text-white\" textAlign=\"justify\">\n            <strong>Do you know? </strong>\n            10% of the world’s GDP will be tokenized by 2027. Source: World\n            Economic Forum InvoBlox is your biggest cheerleader and empowers you\n            to become part of the 24$ trillion token industry for FREE! Let’s be\n            partners and create the digital awesomeness the world awaits …\n            (What’s your plan?)\n          </Typography>\n        </Grid>\n      </Grid>\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary start-btn mt-5 mt-md-3 mt-lg-0\"\n        onClick={() => onFileUpload()}\n      >\n        Next\n      </button>\n      <div\n        className=\"progress-bar-custom\"\n        style={{ width: \"64%\", margin: \"4rem auto 0 auto\" }}\n      >\n        <ProgressBar\n          className={`${\n            props.currentStep === 4\n              ? \"progress-bar-green\"\n              : \"progress-bar-yellow\"\n          }`}\n          now={props.currentStep * 25}\n        />\n        <p className=\"text-white text-center mt-2\">{props.currentStep}/4</p>\n      </div>\n    </>\n  );\n};\n\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(Step1);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/Step3.js",["350","351","352","353","354","355","356","357","358"],"import { useState } from \"react\";\n\nimport PropertiesImage from \"../../../../assets/images/Properties.svg\";\nimport AddBtnImage from \"../../../../assets/images/Add Button.svg\";\nimport LevelsBtn from \"../../../../assets/images/Levels.svg\";\nimport {\n  currentStepAction,\n  setProperties,\n  setLevels,\n} from \"../../../../redux/actions/actions\";\nimport { connect } from \"react-redux\";\nimport PropertiesModal from \"../../../../components/PropertiesModal/ProppertiesModal\";\nimport LevelsModal from \"../../../../components/LevelsModal/LevelsModal\";\nimport \"./Step3.css\";\n////For Accordian\nimport * as React from \"react\";\nimport Accordion from \"@mui/material/Accordion\";\nimport AccordionSummary from \"@mui/material/AccordionSummary\";\nimport AccordionDetails from \"@mui/material/AccordionDetails\";\nimport Typography from \"@mui/material/Typography\";\nimport ExpandMoreIcon from \"@mui/icons-material/ExpandMore\";\nimport { Grid, ListItem, ListItemText } from \"@mui/material\";\nimport InfoComp from \"../../infoComp\";\nimport { BsFillInfoCircleFill } from \"react-icons/bs\";\n/////////////////\nimport { ProgressBar } from \"react-bootstrap\";\nimport PropertyModal from './PropertyModal';\nimport LevelModal from './LevelsModal';\n\nconst Step3 = (props) => {\n  // const [open, setOpen] = useState(false);\n  // const [openLevelModal, setOpenLevelModal] = useState(false);\n\n  ///////\n  // const handleOpen = () => setOpen(true);\n  // const handleClose = () => setOpen(false);\n\n  // const handleOpenLevel = () => setOpenLevelModal(true);\n  // const handleCloseLevel = () => {\n  //   setOpenLevelModal(false);\n  // };\n\n  const onSubmit = (propertiesField) => {\n    props.setProperties(propertiesField);\n  };\n  const onSubmitLevels = (levelsFields) => {\n    props.setLevels(levelsFields);\n  };\n  function onClickDelete(event) {\n    event.stopPropagation();\n    // Handle click here\n  }\n\n  return (\n    <div className=\"step3-container \" style={{ height: \"45vh\" }}>\n      {/* ///////////////////// */}\n      <Accordion\n        className=\"transBG\"\n        style={{ backgroundColor: \"unset !important\" }}\n      >\n        <AccordionSummary\n          className=\"transBG\"\n          expandIcon={<ExpandMoreIcon />}\n          aria-controls=\"panel1a-content\"\n          id=\"panel1a-header\"\n        >\n          {/* <Typography>Accordion 1</Typography> */}\n          <div\n            className=\"properties-container d-flex justify-content-between \"\n            onClick={onClickDelete}\n          >\n            <div className=\"ml-2\">\n              <div className=\"d-flex align-items-center \">\n                <img src={PropertiesImage} style={{ height: \"2rem\" }} />\n                <p className=\"mb-0 text-white \" style={{ marginLeft: \"1rem\" }}>\n                  Properties{\" \"}\n                  <span className=\"infoIcon position-relative\">\n                    <BsFillInfoCircleFill />{\" \"}\n                    <span className=\"tooltiptext properties-tooltip\">\n                      Textual Traits of the NFTs\n                    </span>\n                  </span>\n                </p>\n                {/* <img\n                  src={AddBtnImage}\n                  onClick={() => handleOpen()}\n                  className=\"ml-3\"\n                  style={{ height: \"1.5rem\", cursor: \"pointer\" }}\n                /> */}\n                <PropertyModal propertiesValues={props.properties} onSubmit={onSubmit}/>\n              </div>\n              <p className=\"text-white mt-1\">\n                Textual traits that show up as a rectangles\n              </p>\n            </div>\n          </div>\n        </AccordionSummary>\n        <AccordionDetails className=\"transBG\">\n          {props.properties && props.properties.length > 0 && (\n            <ListItem>\n              <Grid className=\"text-white list-title py-0\" item xs={6}>\n                {\"Name\"}\n              </Grid>\n              <Grid className=\"text-white list-title py-0\" item xs={6}>\n                {\"Value\"}\n              </Grid>\n            </ListItem>\n          )}\n          <ListItem>\n            <Grid container xs={12} className=\"properties-grid\">\n              {props.properties && props.properties.length > 0 ? (\n                props.properties.map((property, i) => {\n                  return (\n                    <>\n                      <Grid className=\"py-2 text-white list-item\" item xs={6}>\n                        {property.name}\n                      </Grid>\n                      <Grid className=\"py-2 text-white list-item\" item xs={6}>\n                        {property.value}\n                      </Grid>\n                    </>\n                  );\n                })\n              ) : (\n                <p className=\"text-white\">{\"No Properies Found\"} </p>\n              )}\n            </Grid>\n          </ListItem>\n        </AccordionDetails>\n      </Accordion>\n\n      {/* /////////////////// */}\n      <Accordion className=\"transBG\">\n        <AccordionSummary\n          className=\"transBG\"\n          expandIcon={<ExpandMoreIcon />}\n          aria-controls=\"panel1a-content\"\n          id=\"panel1a-header\"\n        >\n          {/* <Typography>Accordion 1</Typography> */}\n          <div\n            className=\"properties-container d-flex justify-content-between mt-4 \"\n            onClick={onClickDelete}\n          >\n            <div className=\"ml-2\">\n              <div className=\"d-flex align-items-center \">\n                <img src={LevelsBtn} style={{ height: \"2rem\" }} />\n                <p className=\"mb-0 text-white\" style={{ marginLeft: \"1rem\" }}>\n                  Levels{\" \"}\n                  <span className=\"infoIcon position-relative\">\n                    <BsFillInfoCircleFill />{\" \"}\n                    <span className=\"tooltiptext properties-tooltip\">\n                      Textual Traits of the NFTs\n                    </span>\n                  </span>\n                </p>\n                <LevelModal levels={props.levels} onSubmitLevels={onSubmitLevels} />\n              </div>\n              <p className=\"text-white mt-1\">\n                Numerical traits that show as a progress bar\n              </p>\n            </div>\n          </div>\n        </AccordionSummary>\n        <AccordionDetails>\n          {props.levels && props.levels.length > 0 && (\n            <ListItem>\n              <Grid className=\"text-white list-title py-0\" item xs={4}>\n                {\"Name\"}\n              </Grid>\n              <Grid className=\"text-white list-title py-0\" item xs={4}>\n                {\"Value\"}\n              </Grid>\n              <Grid className=\"text-white list-title py-0\" item xs={4}>\n                {\"Total\"}\n              </Grid>\n            </ListItem>\n          )}\n\n          <ListItem>\n            <Grid container xs={12} className=\"properties-grid\">\n              {props.levels && props.levels.length > 0 ? (\n                props.levels.map((level, i) => {\n                  return (\n                    <>\n                      <Grid className=\"py-2 text-white list-item\" item xs={4}>\n                        {level.name}\n                      </Grid>\n                      <Grid className=\"py-2 text-white list-item\" item xs={4}>\n                        {level.value}\n                      </Grid>\n                      <Grid className=\"py-2 text-white list-item\" item xs={4}>\n                        {level.total}\n                      </Grid>\n                    </>\n                  );\n                })\n              ) : (\n                <p className=\"text-white\">{\"No Levels Found\"}</p>\n              )}\n            </Grid>\n          </ListItem>\n        </AccordionDetails>\n      </Accordion>\n\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary start-btn mt-3 mb-5\"\n        onClick={() => props.currentStepAction()}\n      >\n        Next\n      </button>\n      <div\n        className=\"progress-bar-custom\"\n        style={{ width: \"64%\", margin: \"3rem auto 0 auto\" }}\n      >\n        <ProgressBar\n          className={`${\n            props.currentStep === 4\n              ? \"progress-bar-green\"\n              : \"progress-bar-yellow\"\n          }`}\n          now={props.currentStep * 25}\n        />\n        <p className=\"text-white text-center mt-2\">{props.currentStep}/4</p>\n      </div>\n\n      {/* <PropertiesModal\n        open={open}\n        handleOpen={handleOpen}\n        handleClose={handleClose}\n        propertiesValues={props.properties}\n        onSubmit={onSubmit}\n      /> */}\n      {/* <LevelsModal\n        open={openLevelModal}\n        handleOpen={handleOpenLevel}\n        handleClose={handleCloseLevel}\n        levelsInputs={props.levels}\n        onSubmitLevels={onSubmitLevels}\n      /> */}\n    </div>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  // console.log(state, \"state\"),\n  {\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n  setLevels,\n  setProperties,\n})(Step3);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/Captcha/Captcha.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PreviewModal/PreviewModal.js",["359"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\nimport Modal from \"@mui/material/Modal\";\nimport { AiOutlineClose } from \"react-icons/ai\";\nimport { BiArrowBack } from \"react-icons/bi\";\n\nimport \"./PreviewModal.css\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  width: 830,\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n};\n\nconst genStyle = {\n  row: {\n    display: \"grid\",\n  },\n};\n// let array = [1];\n\nconst PreviewModal = (props) => {\n  // console.log(props,\"props\")\n  const {\n    previewModal,\n    handlePreviewModal,\n    previewModalStep,\n    handlePreviewModalSteps,\n    onDeploy,\n    info,\n  } = props;\n  const handleNextStep = () => {\n    if (previewModalStep === 1) {\n      handlePreviewModalSteps(\"next\");\n    } else {\n      onDeploy();\n    }\n  };\n  // console.log(props,\"props\")\n  return (\n    <div>\n      <Modal\n        open={previewModal}\n        onClose={handlePreviewModal}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box sx={style}>\n          <div className=\"preview-modal-container pt-4 px-1 px-md-5\">\n            <div className=\"w-100 d-flex justify-content-between \">\n              {previewModalStep > 1 ? (\n                <BiArrowBack\n                  className=\"text-white \"\n                  style={{\n                    fontSize: \"1.8rem\",\n                    cursor: \"pointer\",\n                  }}\n                  onClick={() => handlePreviewModalSteps(\"back\")}\n                />\n              ) : (\n                <span></span>\n              )}\n              <AiOutlineClose\n                className=\"text-white\"\n                style={{\n                  fontSize: \"1.8rem\",\n                  cursor: \"pointer\",\n                }}\n                onClick={() => handlePreviewModal()}\n              />\n            </div>\n\n            {previewModalStep === 1 ? (\n              <div className=\"row  preview-modal-info\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text \">Preview</p>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div className=\"previewModal-img\">\n                    {info.img && (\n                      <img\n                        src={info.img ? info.img : \"\"}\n                        className=\"mt-3\"\n                        style={{\n                          width: \"100%\",\n                          height: \"100%\",\n                          borderRadius: \"10px\",\n                          objectFit: \"cover\",\n                        }}\n                        alt=\"preview\"\n                      />\n                    )}\n                    {info.videoUrl && (\n                      <video width=\"260\" controls>\n                        <source src={info.videoUrl} />\n                      </video>\n                    )}\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white external-label ml-0 my-2 ml-0\">\n                      External Link\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"url\"\n                      value={\n                        (info.externalLink && info.externalLink.trim()) ||\n                        \"- externalLink -\"\n                      }\n                      placeholder=\"- externalLink -\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                </div>\n                <div className=\"col-md-6 col-sm-12 mt-4 d-flex justify-content-start flex-column\">\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label mb-2 ml-0\">\n                      Name\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={info.name || \"\"}\n                      placeholder=\"name\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Email\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"email\"\n                      value={info.email || \"\"}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Symbol\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"text\"\n                      value={\n                        (info.symbol && info.symbol.trim()) || \"- symbol -\"\n                      }\n                      placeholder=\"- symbol -\"\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      maxLength=\"50\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Description\n                    </label>\n                    <textarea\n                      className=\"p-3 mt-1 w-100 externalLink-input\"\n                      placeholder=\"- Description -\"\n                      value={\n                        (info.description && info.description.trim()) ||\n                        \"- Description -\"\n                      }\n                      style={{\n                        color: \"#aaabab\",\n                        marginLeft: \"2rem\",\n                        margin: \"0\",\n                        width: \"100%\",\n                      }}\n                      maxLength=\"600\"\n                      disabled={true}\n                    />\n                  </div>\n                  <div\n                    className=\"d-flex mt-3 \"\n                    style={{ flexDirection: \"column\" }}\n                  >\n                    <label className=\"text-white preview-label my-2 ml-0\">\n                      Supply\n                    </label>\n                    <input\n                      className=\" mt-1 w-100 externalLink-input\"\n                      type=\"number\"\n                      value={info.supply || \"- supply -\"}\n                      disabled={true}\n                      style={{ margin: \"0\", width: \"100%\" }}\n                      placeholder=\"- supply -\"\n                      maxLength=\"50\"\n                    />\n                  </div>\n                </div>\n              </div>\n            ) : (\n              <div className=\" preview-modal-info rowCust\">\n                <div className=\"w-100 text-center\">\n                  <p className=\"text-white preview-text mb-3\">Preview</p>\n                </div>\n\n                <p className=\"text-white preview-properties-title\">\n                  Properties{\" \"}\n                </p>\n\n                <div\n                  className=\"rowCust px-3\"\n                  style={{\n                    overflowY: \"auto\",\n                    height: \"5rem\",\n                    overflowX: \"hidden\",\n                  }}\n                >\n                  {props.properties && props.properties.length > 0 ? (\n                    props.properties.map((item, index) => {\n                      return (\n                        <div\n                          className=\"row justify-content-between\"\n                          key={index}\n                        >\n                          <div className=\"col-12  col-md-6 mt-4\" key={index}>\n                            <input\n                              className=\"preview-input-step-2 \"\n                              type=\"url\"\n                              value={item.name || \"\"}\n                              maxLength=\"50\"\n                              placeholder=\"item name\"\n                              disabled={true}\n                            />\n                          </div>\n\n                          <div className=\"col-12 col-md-6 pr-lg-0 mt-4\">\n                            <input\n                              className=\"preview-input-step-2 value-input-preview w-100\"\n                              style={{ maxWidth: \"90%\" }}\n                              type=\"url\"\n                              value={item.value || \"\"}\n                              placeholder=\"Value\"\n                              maxLength=\"50\"\n                              disabled={true}\n                            />\n                          </div>\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center\" style={{ color: \"#A9A9A9\" }}>\n                      {\"No Properties Found\"}\n                    </p>\n                  )}\n                </div>\n\n                {/* ////////////////////////////////////////////// */}\n                <div\n                  className=\"rowCust mt-5 px-3\"\n                  style={{\n                    overflowY: \"auto\",\n                    overflowX: \"hidden\",\n                    height: \"6rem\",\n                  }}\n                >\n                  <p className=\"text-white preview-levels-title ml-3\">\n                    Levels{\" \"}\n                  </p>\n                  {props.levels && props.levels.length > 0 ? (\n                    props.levels.map((item, index) => {\n                      return (\n                        <div className=\"row\" key={index}>\n                          <div\n                            className=\"col-12 col-md-6 mt-2 w-sm-75 w-md-100\"\n                            key={index}\n                          >\n                            <input\n                              className=\"preview-input-step-2  \"\n                              type=\"url\"\n                              value={item.name || \"\"}\n                              placeholder=\"Levels\"\n                              style={{\n                                marginTop: `${index === 0 ? \"0rem\" : \"1.2rem\"}`,\n                              }}\n                              // maxLength=\"50\"\n                              disabled={true}\n                            />\n                          </div>\n\n                          <div className=\"col-12 col-md-6 w-sm-75 w-md-100\">\n                            <div\n                              className=\"d-flex align-items-center  w-100 \"\n                              style={{\n                                marginTop: `${\n                                  index === 0 ? \"0.3rem\" : \"1.2rem\"\n                                }`,\n                              }}\n                            >\n                              <input\n                                className=\"preview-input-step-2  first-value  mt-2 \"\n                                type=\"number\"\n                                pattern=\"[0-9]+\"\n                                // maxlength=\"4\"\n                                value={item.value || \"\"}\n                                placeholder=\"Value\"\n                                name=\"value\"\n                                disabled={true}\n                                style={{\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n\n                              <p className=\"text-white mb-0 of-text\">Of</p>\n                              <input\n                                className=\"preview-input-step-2  first-value mt-2 \"\n                                type=\"number\"\n                                min=\"1\"\n                                max=\"5\"\n                                name=\"total\"\n                                placeholder=\"total\"\n                                disabled={true}\n                                // onInput=\"javascript: if (this.value.length > this.maxLength) this.value = this.value.slice(0, this.maxLength);\"\n                                value={item.total || \"\"}\n                                style={{\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      );\n                    })\n                  ) : (\n                    <p className=\" text-center\" style={{ color: \"#A9A9A9\" }}>\n                      {\"No levels Found\"}\n                    </p>\n                  )}\n                </div>\n              </div>\n            )}\n            <div className=\"w-100 text-center\">\n              <p className=\"text-white my-3\">{previewModalStep}/2</p>\n              {previewModalStep > 1 && props.maxLimit && (\n                <p className=\"text-danger\">\n                  {\"Maximum deployment limit reached,Please contact support\"}\n                </p>\n              )}\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary preview-btn mb-3\"\n                disabled={props.maxLimit && previewModalStep > 1 ? true : false}\n                onClick={() => handleNextStep()}\n              >\n                {previewModalStep === 1 ? \"Next\" : \"Deploy\"}\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nexport default PreviewModal;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/user/user.action.js",["360"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/infoComp.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/LevelsModal/LevelsModal.js",["361","362","363"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport LevelsImage from \"../../assets/images/Levels.svg\";\nimport \"./LevelModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst LevelsModal = (props) => {\n  const [levelsInputs, setlevelsInputs] = React.useState(props.levelsInputs);\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n  const [errorMessage, setErrorMessage] = React.useState(\"\");\n  const [validate, setValidate] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setlevelsInputs([...levelsInputs, { name: \"\", value: \"\", total: \"\" }]);\n  };\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues[i][e.target.name] = e.target.value;\n    setlevelsInputs(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...levelsInputs];\n    newFormValues.splice(i, 1);\n    setlevelsInputs(newFormValues);\n  };\n\n  const handleSubmit = (e) => {\n    e.preventDefault();\n    var errorFlag = false;\n    levelsInputs.map((item) => {\n      if (item.name.trim() === \"\" || item.value === \"\" || item.total === \"\") {\n        errorFlag = true;\n        setError(true);\n        setErrorMessage(\"Please fill all fields to save!\");\n        return \"\";\n      }\n      if (+item.value > +item.total) {\n        alert(\"inside\");\n        setError(true);\n        setValidate(true);\n        setErrorMessage(\"Value should be less then total!\");\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmitLevels(levelsInputs);\n      props.handleClose();\n    }\n  };\n  //  const handleValue=(item)=>{\n  //    if(item.value > item.total){\n\n  //      setError(true)\n  //      return true\n  //    }\n  //    return false\n  //  }\n  //  const handleTotal=(item)=>{\n\n  //  }\n  // console.log(levelsInputs,\"props.levelsInputs\")\n\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"550px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\"text-white position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                color: \"#00d3f3\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 mx-auto justify-content-center\">\n              <div className=\"d-flex\">\n                <img\n                  src={LevelsImage}\n                  alt={\"levels\"}\n                  style={{ height: \"2rem\" }}\n                />\n                <p\n                  className=\"text-white\"\n                  style={{\n                    fontSize: \"1.3rem\",\n                    fontWeight: \"bold\",\n                    marginLeft: \"1rem\",\n                  }}\n                >\n                  Add Levels\n                </p>\n              </div>\n            </div>\n            {/* <p style={{color:\"red\"}}>{\"Value should be less then total\"}</p> */}\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Levels show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n            <form onSubmit={handleSubmit}>\n              <div\n                className=\"row levels-scroll p-3 \"\n                style={{\n                  height: `${\n                    levelsInputs && levelsInputs.length > 0\n                      ? \"7.95rem\"\n                      : \"7.95rem\"\n                  }`,\n                }}\n              >\n                {levelsInputs &&\n                  levelsInputs.length > 0 &&\n                  levelsInputs.map((item, i) => {\n                    return (\n                      <div className=\"row\" key={i}>\n                        <div className=\"col-10 col-sm-6 mt-2 \" key={i}>\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            <input\n                              className=\"step3-input mt-3 \"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              value={item.name || \"\"}\n                              placeholder=\"Name\"\n                              maxLength=\"50\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n                        <div className=\"col-12 col-sm-6 mt-3\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n\n                            {/* <p style={{color:\"red\"}}>{\"value should be less then total\"}</p> */}\n                            <div className=\"d-flex align-items-center  w-100\">\n                              <input\n                                className={`step3-input first-value mt-2 ${\n                                  validate && item.value > item.total\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min=\"1\"\n                                max={\n                                  item.total == \"0\"\n                                    ? \"1\"\n                                    : item.total\n                                    ? item.total\n                                    : \"1\"\n                                }\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.value || \"\"}\n                                placeholder=\"Value\"\n                                autoComplete=\"off\"\n                                name=\"value\"\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n\n                              <p className=\"text-white mb-0 value-label\">Of</p>\n                              <input\n                                className={`step3-input first-value mt-2 ${\n                                  validate && item.total < item.value\n                                    ? \"levels-value\"\n                                    : \"\"\n                                }`}\n                                type=\"number\"\n                                min={item.value ? item.value : \"1\"}\n                                max=\"9999\"\n                                name=\"total\"\n                                placeholder=\"Total\"\n                                onChange={(e) => handleChange(i, e)}\n                                value={item.total || \"\"}\n                                style={{\n                                  backgroundColor: \"#000e29\",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                            </div>\n                            <BsFillXCircleFill\n                              className=\"position-absolute levels-cross-icon\"\n                              style={{\n                                color: \"#00d3f3\",\n                                top: \"3rem\",\n                                right: \"-1rem\",\n                                cursor: \"pointer\",\n                              }}\n                              onClick={() => removeFormFields(i)}\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                <div className=\"W-100 text-center\"></div>\n              </div>\n              <p\n                className=\" col-8 mt-4\"\n                style={{\n                  color: \"#00d3f3\",\n                  cursor: \"pointer\",\n                  marginLeft: \"0.8rem\",\n                }}\n                onClick={() => addMoreValues()}\n              >\n                {\" \"}\n                Add Level\n              </p>\n              {/* <button type=\"submit\" class=\"btn btn-primary\">Submit</button> */}\n\n              <div className=\"w-100 text-center\">\n                <button\n                  type=\"submit\"\n                  className=\"btn btn-secondary start-btn mt-5 text-center\"\n                  style={{ width: \"9rem\" }}\n                  // disabled={\n                  //   levelsInputs && levelsInputs?.length > 0\n                  //     ? false\n                  //     : true\n                  // }\n                  // onClick={() => {\n                  //   handleSubmit()\n                  // }}\n                >\n                  Save\n                </button>\n              </div>\n            </form>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(LevelsModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/PropertiesModal/ProppertiesModal.js",["364","365"],"import * as React from \"react\";\nimport Box from \"@mui/material/Box\";\n// import Button from \"@mui/material/Button\";\n// import Typography from \"@mui/material/Typography\";\nimport Modal from \"@mui/material/Modal\";\nimport PropertiesMOdal from \"../../assets/images/Properties.svg\";\nimport \"./ProppertiesModal.css\";\nimport { connect } from \"react-redux\";\nimport { currentStepAction } from \"../../redux/actions/actions\";\nimport { IoMdClose } from \"react-icons/io\";\nimport { BsFillXCircleFill } from \"react-icons/bs\";\n\nconst style = {\n  position: \"absolute\",\n  top: \"50%\",\n  left: \"50%\",\n  transform: \"translate(-50%, -50%)\",\n  bgcolor: \"background.paper\",\n  border: \"2px solid #000\",\n  boxShadow: 24,\n  p: 4,\n};\n\nconst BasicModal = (props) => {\n  const [propertiesValues, setPropertiesValues] = React.useState(\n    props.properties\n  );\n  const [addMore, setAddMore] = React.useState(false);\n  const [error, setError] = React.useState(false);\n\n  React.useEffect(() => {}, []);\n\n  const addMoreValues = () => {\n    setAddMore(!addMore);\n    setPropertiesValues([...propertiesValues, { name: \"\", value: \"\" }]);\n  };\n\n  let handleChange = (i, e) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues[i][e.target.name] = e.target.value;\n    setPropertiesValues(newFormValues);\n  };\n\n  let removeFormFields = (i) => {\n    setError(false);\n    let newFormValues = [...propertiesValues];\n    newFormValues.splice(i, 1);\n    setPropertiesValues(newFormValues);\n  };\n\n  const handleSubmit = () => {\n    var errorFlag = false;\n    propertiesValues.map((item) => {\n      if (item.name.trim() === \"\" || item.value.trim() === \"\") {\n        errorFlag = true;\n        setError(true);\n        return \"\";\n      }\n    });\n    if (!errorFlag) {\n      props.onSubmit(propertiesValues);\n      props.handleClose();\n    }\n  };\n  // console.log(props.propertiesValues, \"propertiesValues\");\n  return (\n    <div>\n      <Modal\n        open={props.open}\n        onClose={props.handleClose}\n        aria-labelledby=\"modal-modal-title\"\n        aria-describedby=\"modal-modal-description\"\n      >\n        <Box\n          sx={style}\n          style={{ maxHeight: \"500px\", width: \"35%\" }}\n          className=\"leads-modal\"\n        >\n          <div className=\"properties-modal-container position-relative\">\n            <IoMdClose\n              className=\" position-absolute\"\n              style={{\n                top: \"1\",\n                right: \"2\",\n                fontSize: \"1.8rem\",\n                cursor: \"pointer\",\n              }}\n              onClick={() => props.handleClose()}\n            />\n            <div className=\"title-container d-flex w-100 justify-content-center \">\n              <img src={PropertiesMOdal} style={{ height: \"2rem\" }} />\n              <p\n                className=\"text-white mt-0\"\n                style={{\n                  fontSize: \"1.3rem\",\n                  fontWeight: \"bold\",\n                  marginLeft: \"1rem\",\n                }}\n              >\n                Properties\n              </p>\n            </div>\n\n            <p className=\"text-center mb-0\" style={{ color: \"red\" }}>\n              {error && \"Please fill all fields to save!\"}\n            </p>\n            <p\n              className=\"text-center w-100 p-4 text-white\"\n              style={{\n                color: \"#FFFFFF\",\n                opacity: \"0.70\",\n                width: \"80%\",\n                fontSize: \"14px\",\n              }}\n            >\n              Properties show up underneath your item, are clickable, and can be\n              filtered in you collection’s sidebar.\n            </p>\n\n            <div\n              className=\"row modal-scroll \"\n              style={{\n                height: `${\n                  propertiesValues && propertiesValues.length > 0\n                    ? \" 7.95rem\"\n                    : \"7.95rem\"\n                }`,\n              }}\n            >\n              {propertiesValues &&\n                propertiesValues.length > 0 &&\n                propertiesValues.map((item, i) => {\n                  return (\n                    <div className=\"d-flex\" style={{ width: \"558px\" }} key={i}>\n                      <div className=\"row\">\n                        <div\n                          className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1\"\n                          key={i}\n                        >\n                          <div\n                            className=\"d-flex\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{ fontSize: \"1.2rem\", fontWeight: \"bold\" }}\n                            >\n                              Name{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"53px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <input\n                              className=\"step3-input mt-2 \"\n                              type=\"text\"\n                              name=\"name\"\n                              onChange={(e) => handleChange(i, e)}\n                              placeholder=\"Name\"\n                              value={item.name || \"\"}\n                              maxLength=\"40\"\n                              autoComplete=\"off\"\n                              style={{\n                                backgroundColor: \"#000e29 !important\",\n                                maxWidth: \"84%\",\n                                padding: \"0.6rem 1rem\",\n                              }}\n                            />\n                          </div>\n                        </div>\n\n                        <div className=\"col-9 col-sm-5 col-md-5 col-lg-5 mt-4 mb-1 ml-0 ml-md-4\">\n                          <div\n                            className=\"d-flex position-relative\"\n                            style={{ flexDirection: \"column\" }}\n                          >\n                            <label\n                              className=\"text-white position-relative\"\n                              style={{\n                                fontSize: \"1.2rem\",\n                                fontWeight: \"bold\",\n                              }}\n                            >\n                              Value{\" \"}\n                              <span\n                                className=\"position-absolute\"\n                                style={{\n                                  color: \"red\",\n                                  bottom: \"3px\",\n                                  left: \"52px\",\n                                }}\n                              >\n                                *\n                              </span>\n                            </label>\n                            <div className=\"d-flex align-items-center w-100\">\n                              <input\n                                className=\"step3-input  mt-2\"\n                                type=\"text\"\n                                name=\"value\"\n                                onChange={(e) => handleChange(i, e)}\n                                placeholder=\"Value\"\n                                value={item.value || \"\"}\n                                maxLength=\"40\"\n                                autoComplete=\"off\"\n                                style={{\n                                  backgroundColor: \"#000e29 \",\n                                  maxWidth: \"84%\",\n                                  padding: \"0.6rem 1rem\",\n                                }}\n                              />\n                              <BsFillXCircleFill\n                                className=\"ml-1 ml-sm-2\"\n                                style={{\n                                  color: \"#00d3f3\",\n                                  top: \"3rem\",\n                                  left: \"13.8rem\",\n                                  cursor: \"pointer\",\n                                }}\n                                onClick={() => removeFormFields(i)}\n                              />\n                            </div>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              <div className=\"W-100 text-center\"></div>\n            </div>\n            <p\n              className=\" mt-4 ml-4\"\n              style={{ color: \"#00d3f3\", cursor: \"pointer\" }}\n              onClick={() => addMoreValues()}\n            >\n              {\" \"}\n              Add Property\n            </p>\n            <div className=\"w-100 text-center\">\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary start-btn mt-2 mt-md-5 text-center\"\n                style={{ width: \"9rem\" }}\n                // disabled={\n                //   propertiesValues && propertiesValues?.length > 0\n                //     ? false\n                //     : true\n                // }\n                onClick={() => {\n                  handleSubmit();\n                }}\n              >\n                Save\n              </button>\n            </div>\n          </div>\n        </Box>\n      </Modal>\n    </div>\n  );\n};\nconst mapStateToProps = (state) =>\n  // console.log(state, \"state\"),\n  ({\n    currentStep: state.dashboard.currentStep,\n    levels: state.dashboard.levels,\n    properties: state.dashboard.properties,\n  });\n\nexport default connect(mapStateToProps, {\n  currentStepAction,\n})(BasicModal);\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/collections.actions.js",["366"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/Home-Ui/HomeUi.js",["367","368","369","370","371","372","373","374","375"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/navbar-componnent/NavbarComponent.js",["376","377"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/slider-component/sliderExmp.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/FourStepForm/StepsComponents/Step3/LevelsModal.js",["378"],"import React, {useState} from \"react\";\nimport AddBtnImage from \"../.