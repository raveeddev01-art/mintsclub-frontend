77","line":54,"column":33,"nodeType":"371","messageId":"378","endLine":54,"endColumn":35},{"ruleId":"336","severity":1,"message":"337","line":88,"column":15,"nodeType":"335","endLine":88,"endColumn":71},{"ruleId":"379","replacedBy":"380"},{"ruleId":"381","replacedBy":"382"},{"ruleId":"303","severity":1,"message":"383","line":21,"column":7,"nodeType":"305","messageId":"306","endLine":21,"endColumn":15},{"ruleId":"303","severity":1,"message":"384","line":46,"column":19,"nodeType":"305","messageId":"306","endLine":46,"endColumn":25},{"ruleId":"303","severity":1,"message":"385","line":2,"column":128,"nodeType":"305","messageId":"306","endLine":2,"endColumn":143},{"ruleId":"303","severity":1,"message":"323","line":4,"column":10,"nodeType":"305","messageId":"306","endLine":4,"endColumn":17},"no-unused-vars","'GaTracker' is defined but never used.","Identifier","unusedVar","react-hooks/exhaustive-deps","React Hook useEffect has missing dependencies: 'tawkToKey' and 'tawkToPropertyId'. Either include them or remove the dependency array. Outer scope values like 'ENV' aren't valid dependencies because mutating them doesn't re-render the component.","ArrayExpression",["386"],"'layout1' is defined but never used.","'layout3' is defined but never used.","'layout4' is defined but never used.","'useState' is defined but never used.","import/no-anonymous-default-export","Unexpected default export of anonymous function","ExportDefaultDeclaration","no-dupe-keys","Duplicate key 'featuredItems'.","ObjectExpression","unexpected","'useEffect' is defined but never used.","'connect' is defined but never used.","no-sequences","Unexpected use of comma operator.","SequenceExpression","unexpectedCommaExpression","'Header' is defined but never used.","'Footer' is defined but never used.","'ModalSearch' is defined but never used.","'ModalMenu' is defined but never used.","'Scrollup' is defined but never used.","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","'dotenv' is defined but never used.","'config' is assigned a value but never used.","'network' is assigned a value but never used.","'accounts' is assigned a value but never used.","'linkError' is assigned a value but never used.","no-useless-escape","Unnecessary escape character: \\+.","Literal","unnecessaryEscape",["387","388"],["389","390"],"jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'setCaptchaMessage' is assigned a value but never used.","'setDeployNetwork' is assigned a value but never used.","'deploy' is assigned a value but never used.","eqeqeq","Expected '===' and instead saw '=='.","BinaryExpression","React Hook useEffect has a missing dependency: 'props'. Either include it or remove the dependency array. However, 'props' will change when *any* prop changes, so the preferred fix is to destructure the 'props' object outside of the useEffect call and refer to those specific props inside useEffect.",["391"],"React Hook useEffect has a missing dependency: 'props.settings.settings'. Either include it or remove the dependency array. If 'setData' needs the current value of 'props.settings.settings', you can also switch to useReducer instead of useState and read 'props.settings.settings' in the reducer.",["392"],"react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","noTargetBlankWithoutNoreferrer",{"range":"393","text":"394"},{"range":"395","text":"394"},{"range":"396","text":"394"},{"range":"397","text":"394"},{"range":"398","text":"394"},"'loader' is assigned a value but never used.","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression",["399"],"'formatAddress' is assigned a value but never used.","The href attribute is required for an anchor to be keyboard accessible. Provide a valid, navigable address as the href value. If you cannot provide an href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","'errorMessage' is assigned a value but never used.","array-callback-return","Array.prototype.map() expects a value to be returned at the end of arrow function.","expectedAtEnd","no-native-reassign",["400"],"no-negated-in-lhs",["401"],"'genStyle' is assigned a value but never used.","'userId' is assigned a value but never used.","'ALL_COLLECTIONS' is defined but never used.",{"desc":"402","fix":"403"},{"messageId":"404","fix":"405","desc":"406"},{"messageId":"407","fix":"408","desc":"409"},{"messageId":"404","fix":"410","desc":"406"},{"messageId":"407","fix":"411","desc":"409"},{"desc":"412","fix":"413"},{"desc":"414","fix":"415"},[1644,1644]," rel=\"noreferrer\"",[2086,2086],[2526,2526],[2966,2966],[3396,3396],{"desc":"412","fix":"416"},"no-global-assign","no-unsafe-negation","Update the dependencies array to be: [tawkToKey, tawkToPropertyId]",{"range":"417","text":"418"},"removeEscape",{"range":"419","text":"420"},"Remove the `\\`. This maintains the current functionality.","escapeBackslash",{"range":"421","text":"422"},"Replace the `\\` with `\\\\` to include the actual backslash character.",{"range":"423","text":"420"},{"range":"424","text":"422"},"Update the dependencies array to be: [props]",{"range":"425","text":"426"},"Update the dependencies array to be: [props.settings.settings, props.settings.settingsAuth]",{"range":"427","text":"428"},{"range":"429","text":"426"},[612,617],"[tawkToKey, tawkToPropertyId]",[2477,2478],"",[2477,2477],"\\",[2520,2521],[2520,2520],[513,515],"[props]",[645,674],"[props.settings.settings, props.settings.settingsAuth]",[1276,1278]]