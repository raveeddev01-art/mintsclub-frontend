\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport VideoCard from \"../test-video-card/videoCard\";\nimport StatsInfo from \"../create-nft/components/statsinfo\";\nimport LevelsInfo from \"../create-nft/components/levelsinfo\";\nimport Banner from \"../banner/banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../own-collection-today/own-collection-today\";\nimport NFTImg from \"../../assets/images/nft-detail.png\";\nimport { Images } from \"../../assets/assets\";\nimport NftCard from \"../nft-card/nft-card\";\n\nconst NFTDetail = (props) => {\n  const [exchangeRate, setExchangeRate] = useState(0);\n  const [toggle, setToggle] = React.useState(true);\n  const [likedNfts, setLikedNfts] = useState();\n  const [nftDetail, setNftDetail] = useState(\"\");\n  const [listedItem, setListedItem] = useState([]);\n  const [nfts, setNFTs] = useState([]);\n  const [activities, setActivities] = useState([]);\n  const [itemsListing, setItemsListing] = useState([]);\n  const [loader, setLoader] = useState(true);\n  const [price, setPrice] = useState(0);\n  const [bids, setBids] = useState(null);\n  const [offers, setOffers] = useState(null);\n  const [modalShow, setModalShow] = useState(false);\n  const [modalShow1, setModalShow1] = useState(false);\n  const [likeButtonDisable, setLikeBtnDisable] = useState(null);\n  const [modal, setModal] = useState(1);\n  const [confirmed, setConfirmed] = useState(\"\");\n  const [transactionHash, setTransactionHash] = useState(\"\");\n  const [transactionSuccess, setTransactionSuccess] = useState(false);\n  const [bidModalShow, setBidModalShow] = useState(false);\n  const [balance, setBalance] = useState(\"\");\n  const [disabled, setDisabled] = useState(false);\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n  let nftId = props.match.params.id;\n  let userId = ENV.getUserKeys(\"_id\")._id;\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  useEffect(async () => {\n    props.getNFT(nftId);\n    let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n    qs = ENV.objectToQueryString(qs);\n    props.getMyLikedNfts(qs);\n    validateIfLiked();\n\n    let balance = await getBalance();\n    setBalance(balance);\n  }, [props.match.params.id]);\n\n  useEffect(() => {\n    if (props.createAuth) {\n      setLoader(false);\n      history.push(\"/explore/allNFT\");\n    }\n  }, [props.createAuth]);\n\n  useEffect(() => {\n    if (props.buyAuth) {\n      setLoader(false);\n      setDisabled(false);\n      setTransactionSuccess(true);\n      props.getNFT(nftId);\n      let qs = { userId: ENV.getUserKeys(\"_id\")._id };\n      qs = ENV.objectToQueryString(qs);\n      props.getMyLikedNfts(qs);\n      validateIfLiked();\n      props.getBids();\n      toast.success(\"You have purchased NFT successfully\");\n      history.push(\"/userprofile\");\n    }\n  }, [props.buyAuth]);\n\n  useEffect(() => {\n    if (props.createAuthOffer) {\n      setLoader(false);\n      history.push(\"/explore/allNFT\");\n    }\n  }, [props.createAuthOffer]);\n\n  // Get Liked Nfts\n  useEffect(() => {\n    if (props.myLikedNftsStatus) {\n      setLikedNfts(props.myLikedNfts);\n      // validateIfLiked(props.myLikedNfts);\n      props.beforeNFT();\n    }\n  }, [props.myLikedNftsStatus]);\n\n  useEffect(() => {\n    if (props.getAuthOffer) {\n      setOffers(props.offers);\n    }\n  }, [props.getAuthOffer]);\n\n  useEffect(() => {\n    if (props.getAuth) {\n      setBids(props.bids);\n      // props.beforeBid();\n    }\n  }, [props.getAuth]);\n\n  useEffect(() => {\n    if (props.nftsAuth) {\n      setNftDetail(props.nftDetail);\n      setLoader(false);\n\n      //get activities\n      let activityQs = { nftId: props.nftDetail._id };\n      activityQs = ENV.objectToQueryString(activityQs);\n      props.getActivities(activityQs);\n\n      //getItemsListing\n      let itemsListingQS = { collectionId: props.nftDetail.collectionId };\n      itemsListingQS = ENV.objectToQueryString(itemsListingQS);\n      props.getItemsListing(itemsListingQS);\n\n      //get offers\n      if (props.nftDetail.sellingMethod) {\n        if (props.nftDetail.sellingMethod === 1) {\n          let qs = { nftId: props.nftDetail._id };\n          qs = ENV.objectToQueryString(qs);\n          props.getOffers(qs);\n        } else {\n          let qs = { nftId: props.nftDetail._id };\n          qs = ENV.objectToQueryString(qs);\n          props.getBids(qs);\n        }\n      }\n      //get bids\n      if (nftDetail?.sellingMethod === 2) {\n        let nftBidsQs = { nftId };\n        nftBidsQs = ENV.objectToQueryString(nftBidsQs);\n        props.getBidSByNftId(nftBidsQs);\n      }\n\n      let fivePerc = \"\";\n      if (\n        props.nftDetail.highestBid === 0 ||\n        props.nftDetail.highestBid === undefined\n      ) {\n        fivePerc = (5 / 100) * props.nftDetail.currentPrice;\n        fivePerc = fivePerc + props.nftDetail.currentPrice;\n      } else {\n        fivePerc = (5 / 100) * props.nftDetail.highestBid;\n        fivePerc = fivePerc + props.nftDetail.highestBid;\n      }\n      let result = fivePerc.toString().slice(0, 8);\n\n      setPrice(result);\n      validateIfLiked(likedNfts, props.nftDetail);\n\n      props.getNFTsByCollection(props.nftDetail.collectionId);\n    }\n  }, [props.nftsAuth]);\n\n  useEffect(() => {\n    if (props.nftsByCollectionStatus) {\n      let moreCollection = [];\n      if (props.nftsByCollection && props.nftsByCollection?.length) {\n        moreCollection = props.nftsByCollection.filter(\n          (item) => item._id !== nftDetail._id\n        );\n      }\n      setNFTs(moreCollection);\n    }\n  }, [props.nftsByCollectionStatus]);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  useEffect(() => {\n    if (props.activitiesAuth) {\n      setActivities(props.activities);\n    }\n  }, [props.activitiesAuth]);\n  useEffect(() => {\n    if (props.itemsListingAuth) {\n      setItemsListing(props.itemsListing);\n    }\n  }, [props.itemsListingAuth]);\n\n  const handleRouting = async () => {\n    if (await validateNetwork()) {\n      if (\n        ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId &&\n        nftDetail.sellingMethod === 2\n      ) {\n        EndAuction();\n      } else if (ENV.getUserKeys(\"_id\")._id === nftDetail?.ownerId) {\n        history.push({\n          pathname: `/sell-item/${nftDetail._id}`,\n          state: nftDetail,\n        });\n      } else if (nftDetail.sellingMethod === 2) {\n        setBidModalShow(true);\n      } else if (nftDetail.sellingMethod === 1) {\n        setModalShow(true);\n      } else {\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  //toggleLikes\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const handleLikesTogleApi = async (nftId, status) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        setToggle(!toggle);\n\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let data = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if ((status === \"dislike\") & (nftDetail.likesCount > 0)) {\n          let nft = nftDetail;\n          nft.likesCount = nft.likesCount - 1;\n\n          setNftDetail(nft);\n          props.toggleLikeDislike(data);\n        } else {\n          let nft = nftDetail;\n          nft.likesCount = nft.likesCount + 1;\n\n          setNftDetail(nft);\n\n          props.toggleLikeDislike(data);\n        }\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const handleCollectionLikesTogleApi = async (nftId, status, likesCount) => {\n    if (await validateNetwork()) {\n      if (!likeButtonDisable) {\n        setLikeBtnDisable(true);\n        let userId = ENV.getUserKeys(\"_id\")._id;\n\n        let body = {\n          userId,\n          nftId,\n          count: 1,\n        };\n\n        if (status === \"dislike\" && likesCount > 0) {\n          let result = likedNfts.filter((item) => item.nftId !== nftId);\n\n          setLikedNfts(result);\n          increOrDecreLikes(nftId, \"dec\");\n\n          props.toggleLikeDislike(body);\n        }\n\n        if (status === \"like\") {\n          let myLikedNfts = [];\n          if (likedNfts && likedNfts.length > 0) {\n            myLikedNfts = likedNfts;\n          }\n\n          let obj = {\n            _id: \"1234455\",\n            nftId,\n          };\n\n          myLikedNfts.push(obj);\n\n          setLikedNfts(myLikedNfts);\n          increOrDecreLikes(nftId, \"inc\");\n          props.toggleLikeDislike(body);\n        }\n        // setNFTs(nfts);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n  const increOrDecreLikes = (id, status) => {\n    let updatedNfts = [];\n    if (status === \"dec\") {\n      updatedNfts = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(updatedNfts);\n    } else {\n      let updatedNfts = nfts.map((item) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(updatedNfts);\n    }\n  };\n\n  //match if nft liked\n\n  const validateIfLiked = (nfts, nft) => {\n    if (nfts && nfts?.length > 0) {\n      let result = nfts.find((item) => item.nftId == nft._id);\n\n      if (result) {\n        return setToggle(true);\n      } else {\n        return setToggle(false);\n      }\n    } else {\n      return setToggle(false);\n    }\n  };\n\n  const calculatePricePercantage = () => {\n    let fivePerc = \"\";\n    let result = \"\";\n    if (nftDetail.highestBid === 0 || nftDetail.highestBid === undefined) {\n      fivePerc = (5 / 100) * nftDetail.currentPrice;\n\n      result = fivePerc + nftDetail.currentPrice;\n\n      return result;\n    } else {\n      fivePerc = (5 / 100) * nftDetail.highestBid;\n      result = fivePerc + nftDetail.highestBid;\n      return result.toString().slice(0, 8);\n    }\n  };\n\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n\n  useEffect(() => {\n    if (props.togleLikeRes) {\n      setLikeBtnDisable(false);\n      props.beforeTogleLikeDislike();\n    }\n  }, [props.togleLikeRes]);\n\n  const onChange = (e) => {\n    let result = e.target.value.slice(0, 8);\n\n    setPrice(result);\n  };\n  const handleModalSubmit = async () => {\n    if (await validateNetwork()) {\n      setLoader(true);\n\n      if (nftDetail.sellingMethod === 2) {\n        placeBid();\n      } else {\n        makeOffer();\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n  const placeBid = async () => {\n    if (await validateNetwork()) {\n      try {\n        let result = await placeABid(price, nftDetail.nftToken);\n        if (result) {\n          const payload = {\n            ownerId: nftDetail.ownerId,\n            bidAmount: price,\n            nftId: nftDetail._id,\n            bidBy: ENV.getUserKeys(\"_id\")._id,\n            isAccepted: false,\n            // expiryDate: nftConfig.expiry.datetime,\n            toAddress: nftDetail.ownerAddress,\n            fromAddress: await connectMetamask(),\n          };\n\n          props.placeBid(payload);\n          createActivity(\"Bid\", price);\n        }\n      } catch (err) {\n        console.log(err, \"error\");\n        setLoader(false);\n\n        toast.error(err);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const makeOffer = async () => {\n    setLoader(true);\n    try {\n      // let result = await placeABid(price, nftDetail.nftToken);\n      let result = true;\n      if (result) {\n        const payload = {\n          toAddress: nftDetail.ownerAddress,\n          fromAddress: await connectMetamask(),\n          offerBy: ENV.getUserKeys(\"_id\")._id,\n          ownerId: nftDetail.ownerId,\n          nftId: nftDetail._id,\n          price: price,\n          // expiryDate: nftConfig.expiry.datetime,\n          isAccepted: false,\n          isExpired: false,\n        };\n\n        props.makeOffer(payload);\n      }\n    } catch (err) {\n      setLoader(false);\n\n      toast.error(err);\n    }\n  };\n  const getPercentageChange = (oldNumber, newNumber) => {\n    var decreaseValue = oldNumber - newNumber;\n\n    return (decreaseValue / oldNumber) * 100;\n  };\n\n  const deleteBid = (id) => {\n    let result = bids.filter((bid) => bid._id !== id);\n    setBids(result);\n    props.deleteBid(id);\n    createActivity(\"Cancel Bid\");\n  };\n\n  // const deleteOffer = (id) => {\n  //   let result = offers.filter((offer) => offer._id !== id);\n  //   setOffers(result);\n  //   props.deleteOffer(id);\n  // };\n\n  const auctionEndTimeConversion = (auctionEndDate) => {\n    var dateString = moment(new Date(auctionEndDate))\n      .utc(true)\n      .format(\"MMMM D, Y\");\n    var timeString = moment(new Date(auctionEndDate)).utc(true).format(\"h:mma\");\n    var totalDateTime = dateString + \" at \" + timeString + \" PKT\";\n    return totalDateTime;\n  };\n\n  const BuyNow = async () => {\n    if (await validateNetwork()) {\n      setDisabled(true);\n      try {\n        let currentPrice = \"\";\n        let nftToken = \"\";\n\n        if (modalShow1) {\n          currentPrice = listedItem.currentPrice;\n          nftToken = listedItem.tokenId;\n          nftId = listedItem._id;\n        } else {\n          currentPrice = nftDetail.currentPrice;\n          nftToken = nftDetail.nftToken;\n        }\n\n        const result = await BuyFixedPriceNFT(\n          currentPrice,\n          nftToken,\n          setConfirmed,\n          setTransactionHash\n        );\n        if (result) {\n          let ownerAddress = await getWalletAddress();\n          let payload = {\n            userId,\n            nftId,\n            ownerAddress,\n          };\n          props.beforeOffer();\n          props.buyNow(payload);\n          createActivity(\"Transfer\", false, ownerAddress);\n        }\n      } catch (err) {\n        setDisabled(false);\n        toast.error(err);\n      }\n    } else {\n      toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    }\n  };\n\n  const createActivity = async (type, bidPrice, address) => {\n    const { _id, ownerId, ownerAddress, currentPrice } = nftDetail;\n    let price = \"\";\n    let toAddress = \"\";\n    if (bidPrice) {\n      price = bidPrice;\n    } else {\n      price = currentPrice;\n    }\n\n    if (type === \"Transfer\" || type === \"Bid\") {\n      toAddress = address;\n    }\n\n    let activityPayload = {\n      nftId: _id,\n      ownerId,\n      fromAddress:\n        type === \"Transfer\" ? ownerAddress : await getWalletAddress(),\n      activityType: type,\n      toAddress,\n      price: price,\n    };\n    props.createActivity(activityPayload);\n  };\n  const handleAcitivityIcon = (type) => {\n    if (type === \"Mint\") {\n      return <MdShoppingCart />;\n    } else if (type === \"List\") {\n      return <BsTagFill />;\n    } else if (type === \"Bid\") {\n      return <FaHandPaper />;\n    } else {\n      return <BiTransferAlt />;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    //check if i am owner\n\n    if (\n      ENV.getUserKeys(\"_id\")._id == nftDetail.ownerId ||\n      nftDetail.sellingMethod === 1\n    ) {\n      return true;\n    }\n    if (startDate && endDate && nftDetail.sellingMethod) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n      // if (\n      //  ( auctionStartDate.setHours(0, 0, 0, 0) <=\n      //     currentDate.setHours(0, 0, 0, 0) )&&\n      //  ( auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0))\n      // )\n      if (currentDate > auctionStartDate && currentDate < auctionEndDate) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n  const EndAuction = async () => {\n    try {\n      setLoader(true);\n      let result = await endAuction(nftDetail.tokenId);\n      if (result) {\n        let res = await axios.patch(\n          `${ENV.url}nfts/endAuction/${nftDetail._id}`\n        );\n        if (res.data.success) {\n          toast.success(res.data.message);\n          history.push(\"/userprofile\");\n        }\n      }\n    } catch (err) {\n      toast.error(err);\n      setLoader(false);\n    }\n  };\n\n  const {\n    name,\n    _id,\n    copies,\n    remainingCopies,\n    likesCount,\n    sellingMethod,\n    properties,\n    levels,\n    stats,\n    nftToken,\n    lowestNftPrice,\n    fileType,\n    image,\n    user,\n    ownerId,\n    auctionStartDate,\n    auctionEndDate,\n    description,\n    currentPrice,\n    collectionId,\n    collection,\n    tokenId,\n  } = nftDetail;\n\n  const bannerData = {\n    subHeading: \"NFT\",\n    heading: \"NFT Details\",\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n\n  const detailWallet = [\n    {\n      title: \"Contract Address\",\n      content: \"0xe90.........4BcAc06\",\n    },\n    {\n      title: \"Token ID\",\n      content: \"452\",\n    },\n    {\n      title: \"Token Standard\",\n      content: \"ERC - 1155\",\n    },\n    {\n      title: \"Blockchain\",\n      content: \"Ethereum\",\n    },\n  ];\n  let nftInfo = [\n    {\n      title: \"Contract Address\",\n      value:\n        ENV.mintsClubContractAddress.slice(0, 6) +\n        \"....\" +\n        ENV.mintsClubContractAddress.slice(-6),\n    },\n    {\n      title: \"Token ID\",\n      value: tokenId,\n    },\n    {\n      title: \"Token Standard\",\n      value: \"ERC-1155\",\n    },\n    {\n      title: \"Blockchain\",\n      value: \"Ethereum\",\n    },\n  ];\n\n  return (\n    <>\n      <Banner\n        subHeading={bannerData.subHeading}\n        heading={bannerData.heading}\n        content={bannerData.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      {loader && <FullPageLoader />}\n\n      <div className=\"new-nft-detail padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-lg-4 col-xl-3 order-1 order-lg-0 d-none d-lg-block\">\n              <div className=\"detail-box\">\n                <h6>Properties</h6>\n                <hr />\n                {properties && properties.length > 0 ? (\n                  properties.map((detail) => {\n                    return (\n                      <div className=\"detail-rounded-type d-flex align-items-center\">\n                        <div className=\"detail-rounded-name\">\n                          <p>{detail.name}:</p>\n                        </div>\n                        <div className=\"detail-content\">\n                          <p>{detail.type}</p>\n                        </div>\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center\">No Properties Foud</p>\n                )}\n              </div>\n              <div className=\"detail-box\">\n                <h6>Stats</h6>\n                <hr />\n                <div>\n                  {stats && stats?.length > 0 ? (\n                    stats.map((item) => {\n                      return <StatsInfo name={item.name} value={item.value} />;\n                    })\n                  ) : (\n                    <p className=\"text-center\">No Stats Foud</p>\n                  )}\n                </div>\n              </div>\n              <div className=\"detail-box\">\n                <h6>Levels</h6>\n                <hr />\n                <div>\n                  {levels && levels.length > 0 ? (\n                    levels.map((item) => {\n                      return <LevelsInfo name={item.name} value={item.value} />;\n                    })\n                  ) : (\n                    <p className=\" text-center\">No Levels Foud</p>\n                  )}\n                </div>\n              </div>\n              <div className=\"detail-box\">\n                <h6>Details</h6>\n                <hr />\n                {nftInfo.map((item) => {\n                  return (\n                    <div\n                      className=\"detail-rounded-type d-flex align-items-center\"\n                      onClick={() => {\n                        item.title === \"Contract Address\" &&\n                          window.open(\n                            \"https://rinkeby.etherscan.io/address/0x328106925e0e5721725ec92fc256b7e6cbdd8e43\",\n                            \"_blank\"\n                          );\n                      }}\n                    >\n                      <div className=\"detail-rounded-name\">\n                        <p>{item.title}:</p>\n                      </div>\n                      <div className=\"detail-content\">\n                        <p> {item.value}</p>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n\n            <div className=\"col-lg-8 col-xl-9 order-0 order-lg-1\">\n              <div className=\"row g-4 g-lg-5 g-xl-4\">\n                <div className=\"col-xl-6\">\n                  {fileType === \"image\" ? (\n                    <div className=\"nft-img-container mx-auto mx-lg-0\">\n                      <img src={image} alt=\"nft-image\" />\n                    </div>\n                  ) : (\n                    \n                    <div className=\"card-img-top\">\n                      <div className=\"video-wrapper\">\n                        <video\n                          src={image}\n                          ref={videoElement}\n                          onTimeUpdate={handleOnTimeUpdate}\n                        />\n                        <div className=\"controls\">\n                          <div className=\"actions\">\n                            <button\n                              className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                              onClick={togglePlay}\n                            >\n                              {playerState.isPlaying ? (\n                                <BsFillPauseFill />\n                              ) : (\n                                <BsFillPlayFill />\n                              )}\n                            </button>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  )}\n                </div>\n                <div className=\"col-xl-6\">\n                  <div className=\"nft-img-detail\">\n                    <h5>NFT Details:</h5>\n                  </div>\n                  <div className=\"nft-img-detail-box\">\n                    <div className=\"nft-detail-rounded-box\">\n                      <p>\n                        {name && name.length > 30\n                          ? name.slice(0, 30) + \"...\"\n                          : name}\n                      </p>\n                    </div>\n                    <div className=\"row g-2 g-sm-4\">\n                      <div className=\"col-6 col-sm-4 col-xl-6 col-xxl-4\">\n                        <div className=\"nft-detail-rounded-box\">\n                          <p>\n                            Total Copies: <span>{copies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-xl-6 col-xxl-4\">\n                        <div className=\"nft-detail-rounded-box\">\n                          <p>\n                            Sold: <span>{copies - remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                      <div className=\"col-6 col-sm-4 col-xl-6 col-xxl-4\">\n                        <div className=\"nft-detail-rounded-box\">\n                          <p>\n                            Remaining: <span>{remainingCopies}</span>\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"nft-detail-price d-flex align-items-center  mb-3\">\n                      <div className=\"d-flex align-items-center me-2\">\n                        <img src={Images.onsale} className=\"me-3\" />\n                        <h2>{currentPrice}</h2>\n                      </div>\n                      <div className=\"price-in-dollar\">\n                        <p> ($ {(currentPrice * exchangeRate).toFixed(2)})</p>\n                      </div>\n                    </div>\n                    <div className=\"nft-detail-rounded-box on-sale\">\n                      <p>\n                        Copies On Sale:{\" \"}\n                        <span>\n                          {\" \"}\n                          {nftDetail?.copiesForAuction\n                            ? nftDetail?.copiesForAuction\n                            : 0}\n                        </span>\n                      </p>\n                    </div>\n                    <div className=\"nft-detail-date d-flex align-items-center\">\n                      <p>\n                        {sellingMethod === 2 && (\n                          <>\n                            {auctionEndDate &&\n                              checkIfAuctionStartedorEnded(\n                                auctionStartDate,\n                                auctionEndDate\n                              ) && (\n                                <>\n                                  <img\n                                    src={Images.ClockIcon}\n                                    alt=\"clock-icon\"\n                                    className=\"me-1\"\n                                  />\n                                  <span>\n                                    Sale ends{\" \"}\n                                    {auctionEndTimeConversion(\n                                      new Date(auctionEndDate)\n                                    )}{\" \"}\n                                  </span>\n                                </>\n                              )}\n                          </>\n                        )}\n                      </p>\n                    </div>\n                  </div>\n                  <div className=\"nft-detail-owner d-flex align-items-center\">\n                    <img\n                      src={user?.profileImage?user?.profileImage:Images.placeholderImg}\n                      alt=\"avatar\"\n                      className=\"me-2\"\n                    />\n                    <p>\n                      Owned by:{\" \"}\n                      <span className=\"ms-1\">\n                        {\" \"}\n                        {ownerId === userId\n                          ? \"You\"\n                          : user?.username\n                          ? user.username\n                          : \"unnamed\"}\n                      </span>\n                    </p>\n                  </div>\n                  <div className=\"nft-detail-btn\">\n                    {checkIfAuctionStartedorEnded(\n                      auctionStartDate,\n                      auctionEndDate\n                    ) && (\n                      <button\n                        disabled={disabled}\n                        onClick={() => handleRouting()}\n                      >\n                        {\" \"}\n                        {ENV.getUserKeys(\"_id\")._id == ownerId &&\n                        sellingMethod == 2\n                          ? \"End Auction\"\n                          : ENV.getUserKeys(\"_id\")._id == ownerId &&\n                            sellingMethod == 1\n                          ? \"Resale\"\n                          : ENV.getUserKeys(\"_id\")._id == ownerId\n                          ? \"Sell\"\n                          : sellingMethod === 2\n                          ? \"Place A Bid\"\n                          : sellingMethod === 1\n                          ? \"Buy Now\"\n                          : \"\"}\n                      </button>\n                    )}\n                  </div>\n                </div>\n                <div className=\"col-12 d-block d-lg-none\">\n                  <div className=\"detail-box\">\n                    <h6>Properties</h6>\n                    <hr />\n                    {properties && properties.length > 0 ? (\n                      properties.map((detail) => {\n                        return (\n                          <div className=\"detail-rounded-type d-flex align-items-center\">\n                            <div className=\"detail-rounded-name\">\n                              <p>{detail.name}:</p>\n                            </div>\n                            <div className=\"detail-content\">\n                              <p>{detail.type}</p>\n                            </div>\n                          </div>\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-center\">No Properties Foud</p>\n                    )}\n                  </div>\n                  <div className=\"detail-box\">\n                    <h6>Stats</h6>\n                    <hr />\n                    {stats && stats?.length > 0 ? (\n                      stats.map((item) => {\n                        return (\n                          <StatsInfo name={item.name} value={item.value} />\n                        );\n                      })\n                    ) : (\n                      <p className=\"text-center\">No Stats Foud</p>\n                    )}\n                  </div>\n\n                  <div className=\"detail-box\">\n                    <h6>Levels</h6>\n                    <hr />\n                    <div>\n                      {levels && levels.length > 0 ? (\n                        levels.map((item) => {\n                          return (\n                            <LevelsInfo name={item.name} value={item.value} />\n                          );\n                        })\n                      ) : (\n                        <p className=\"text-center\">No Levels Foud</p>\n                      )}\n                    </div>\n                  </div>\n                  <div className=\"detail-box\">\n                    <h6>Details</h6>\n                    <hr />\n                    {detailWallet.map((detail) => {\n                      return (\n                        <div className=\"detail-rounded-type d-flex align-items-center\">\n                          <div className=\"detail-rounded-name\">\n                            <p>{detail.title}:</p>\n                          </div>\n                          <div className=\"detail-content\">\n                            <p>{detail.content}</p>\n                          </div>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n                <div className=\"col-12 mt-lg-5\">\n                  <div className=\"detail-bg-box\">\n                    <h5>Descriptions:</h5>\n                    <hr />\n                    <p>{description}</p>\n                  </div>\n                </div>\n                <div className=\"col-12\">\n                  <div className=\"detail-bg-box\">\n                    <h5>Offers:</h5>\n                    <hr />\n                    <div className=\"table-container\">\n                      <table className=\"table table-borderless\">\n                        {bids && bids.length > 0 && (\n                          <thead>\n                            <tr>\n                              <th scope=\"col\">Price</th>\n                              <th scope=\"col\">USD Price</th>\n                              <th scope=\"col\">Floor Difference</th>\n\n                              <th scope=\"col\">From</th>\n                            </tr>\n                          </thead>\n                        )}\n                        <tbody>\n                          {sellingMethod === 2 &&\n                          bids &&\n                          bids.length > 0 ? (\n                            <>\n                              {bids.map((bid, index) => {\n                                return (\n                                  <tr key={index}>\n                                    <th scope=\"row\">{bid.bidAmount}</th>\n                                    <td>\n                                      $\n                                      {(bid.bidAmount * exchangeRate).toFixed(\n                                        2\n                                      )}\n                                    </td>\n                                    <td>\n                                      {getPercentageChange(\n                                        bid.bidAmount,\n                                        lowestNftPrice\n                                      ).toFixed(0)}\n                                      %{\" \"}\n                                      {bid.bidAmount > lowestNftPrice\n                                        ? \"above\"\n                                        : \"below\"}\n                                    </td>\n                                    <td>{bid.fromAddress.slice(3, 8)}</td>\n                                  </tr>\n                                );\n                              })}\n                            </>\n                          ) : (\n                            <p className=\"text-center d-flex justify-content-center align-items-center\">\n                              No Offers Found\n                            </p>\n                          )}\n                        </tbody>\n                      </table>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12\">\n                  <div className=\"detail-bg-box\">\n                    <h5>Activity:</h5>\n                    <hr />\n                    <div className=\"table-container\">\n                      {activities && activities.length > 0 ? (\n                        <table className=\"table table-borderless\">\n                          <thead>\n                            <tr>\n                              <th scope=\"col\">Event</th>\n                              <th scope=\"col\">Price</th>\n                              <th scope=\"col\">From</th>\n                              <th scope=\"col\">To</th>\n                              <th scope=\"col\">Date</th>\n                            </tr>\n                          </thead>\n                          <tbody>\n                            {activities.map((activity, index) => {\n                              return (\n                                <tr>\n                                  <th scope=\"row\" key={index}>\n                                    <div className=\"d-flex align-items-center\">\n                                      {handleAcitivityIcon(\n                                        activity.activityType\n                                      )}\n                                      <p className=\"ps-1\">\n                                        {\" \"}\n                                        {activity.activityType}{\" \"}\n                                      </p>\n                                    </div>\n                                  </th>\n                                  <td>\n                                    {activity.price ? activity.price : \"\"}\n                                  </td>\n                                  <td>\n                                    {activity.fromAddress\n                                      ? activity.fromAddress.slice(-8)\n                                      : \"null address\"}\n                                  </td>\n                                  <td>\n                                    {activity.toAddress\n                                      ? activity.toAddress.slice(-8)\n                                      : \"\"}{\" \"}\n                                  </td>\n                                  <td>\n                                    <div>\n                                      <ReactTimeAgo\n                                        date={activity.createdAt}\n                                        locale=\"en-US\"\n                                      />\n                                    </div>\n                                  </td>\n                                </tr>\n                              );\n                            })}\n                          </tbody>\n                        </table>\n                      ) : (\n                        <p className=\"text-white d-flex align-items-center justify-content-center w-100 h-100\">\n                          No Activities Found\n                        </p>\n                      )}\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 order-2 mt-5\">\n              <div className=\"detail-more-collection\">\n                <h6>More from this collection</h6>\n              </div>\n              <div className=\"row align-items-center g-3\">\n                {nfts && nfts.length > 0 ? (\n                  nfts.map((nft, id) => {\n                    if (id <= 3) {\n                      return (\n                        <div\n                          className=\"col-10 col-sm-6 col-md-4 col-lg-3 px-1\"\n                          key={id}\n                        >\n                          {\n                            <NftCard\n                              data={nft}\n                              handleLikesTogleApi={handleLikesTogleApi}\n                              likedNfts={likedNfts}\n                              owner={nft?.owner[0]}\n                            />\n                          }\n                        </div>\n                      );\n                    }\n                  })\n                ) : (\n                  <p className=\"text-center mt-4\">No NFTs Found</p>\n                )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <OwnCollectionToday />\n      <BuyModal\n        show={modalShow}\n        onHide={() => {\n          setModalShow(false);\n          setConfirmed(false);\n          setModal(1);\n          setTransactionSuccess(false);\n        }}\n        name={name}\n        price={currentPrice}\n        image={image}\n        exchangeRate={exchangeRate}\n        tokenId={nftToken}\n        modal={modal}\n        setModal={setModal}\n        buyNow={BuyNow}\n        confirmed={confirmed}\n        transactionHash={transactionHash}\n        transactionSuccess={transactionSuccess}\n        disabled={disabled}\n      />\n      <BuyModal\n        show={modalShow1}\n        onHide={() => {\n          setModalShow1(false);\n          setConfirmed(false);\n          setModal(1);\n          setTransactionSuccess(false);\n        }}\n        name={listedItem.name}\n        price={listedItem.currentPrice}\n        image={listedItem.image}\n        exchangeRate={exchangeRate}\n        tokenId={listedItem.nftToken}\n        modal={modal}\n        setModal={setModal}\n        buyNow={BuyNow}\n        confirmed={confirmed}\n        transactionHash={transactionHash}\n        transactionSuccess={transactionSuccess}\n        disabled={disabled}\n      />\n      <BidModal\n        show={bidModalShow}\n        calculatePricePercantage={calculatePricePercantage}\n        handleModalSubmit={handleModalSubmit}\n        onChange={onChange}\n        decimalNumberValidator={decimalNumberValidator}\n        balance={balance}\n        price={price}\n        onHide={() => setBidModalShow(false)}\n      />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  nftDetail: state.nft.nftsData,\n  nftsAuth: state.nft.nftsAuth,\n  nftsByCollection: state.nft.nftsByCollection,\n  nftsByCollectionStatus: state.nft.nftsByCollectionStatus,\n  myLikedNfts: state.nft.myLikedNfts,\n  myLikedNftsStatus: state.nft.myLikedNftsStatus,\n  activities: state.nft.itemActivities,\n  activitiesAuth: state.nft.activitiesAuth,\n  itemsListing: state.nft.itemsListing,\n  itemsListingAuth: state.nft.itemsListingAuth,\n  createAuth: state.bid.createAuth,\n  createAuthOffer: state.offer.createAuth,\n  buyAuth: state.offer.buyAuth,\n  getAuth: state.bid.getAuth,\n  getAuthOffer: state.offer.getAuth,\n  offers: state.offer.offers,\n  bids: state.bid.bids,\n  bidsByNft: state.bid.bidsByNft,\n  bidsByNftAuth: state.bid.bidsBYNftAuth,\n  togleLikeRes: state.explore.togleLikeRes,\n});\n\nexport default connect(mapStateToProps, {\n  getNFT,\n  beforeNFT,\n  getNFTsByCollection,\n  toggleLikeDislike,\n  getMyLikedNfts,\n  placeBid,\n  getBids,\n  getBidSByNftId,\n  beforeBid,\n  deleteBid,\n  beforeTogleLikeDislike,\n  makeOffer,\n  beforeOffer,\n  getOffers,\n  deleteOffer,\n  buyNow,\n  createActivity,\n  getActivities,\n  getItemsListing,\n})(NFTDetail);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["488","489","490","491","492","493","494","495","496","497","498","499","500","501","502","503","504","505","506","507","508"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["509","510","511","512","513","514","515","516","517","518"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["519","520","521"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["522","523","524","525","526","527","528"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["529","530","531","532","533","534","535","536","537","538"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/home/home.reducer.js",["539","540"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["541"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["542"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.reducer.js",["543"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["544","545","546","547","548","549","550","551","552"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/reducer/reducer.js",["553"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.reducer.js",["554"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.reducer.js",["555"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.reducer.js",["556"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.reducer.js",["557"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["558"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["559"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",["560","561"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout/layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/home-auctions.js",["562","563","564","565","566","567","568"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/top-seller/topseller.js",["569","570"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/popular-collections.js",["571","572","573","574","575","576","577","578","579"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections/collections.actions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/user/user.action.js",["580","581"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero/hero.js",["582","583","584","585"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["586","587","588","589"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.js",["590","591","592","593","594","595"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/buy-sell/Buysell.js",["596","597"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/own-collection-today/own-collection-today.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/collections-cards/CollectionsCard.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/banner/banner.js",["598"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/filterComponent/filterComponent.js",["599","600","601"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/explore/explore.action.js",["602"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nfts/nfts.action.js",["603","604","605","606","607"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["608","609","610"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/footer/footer.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/nft-card/nft-card.js",["611","612","613","614","615","616","617","618","619"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/test-video-card/videoCard.js",["620"],"import React, { useRef } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./videoCard.css\";\nimport useVideoPlayer from \"./components/useVideoPlayer\";\nimport { ENV } from \"../../config/config\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\n\nconst VideoCard = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  likedNfts,\n  ownerId,\n  sellingMethod,\n  userProfile,\n  auctionStartDate,\n  auctionEndDate,\n  copies,\n  remainingCopies,\n  ownerName\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n  const videoElement = useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div className=\"auction-img-wrapper\">\n        <div className=\"card-img-top\">\n          <div className=\"video-wrapper\">\n            <video\n              src={CardImg}\n              ref={videoElement}\n              onTimeUpdate={handleOnTimeUpdate}\n            />\n            <div className=\"controls\">\n              <div className=\"actions\">\n                <button\n                  className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                  onClick={togglePlay}\n                >\n                  {playerState.isPlaying ? (\n                    <BsFillPauseFill />\n                  ) : (\n                    <BsFillPlayFill />\n                  )}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          <div className=\"auction-owner-name\">\n            <p>{copies-remainingCopies} Sold</p>\n          </div>\n          <div className=\"auction-owner-name\">\n            <p>{remainingCopies} Remaining</p>\n          </div>\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n          <div className=\"auction-owner-name\">\n            <p>Owner</p>\n          </div>\n          <div className=\"d-flex align-items-center ps-1\">\n            <span>{ownerName}</span>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default VideoCard;\n",["621","622"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/levelsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/statsinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BidModal.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/BuyModal.js",["623","624","625","626"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/offers/offers.action.js",["627"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/bids/bids.action.js",["628","629"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/ApprovalModal.js",["630","631","632"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["633"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n  ownerName,\n  copies,\n  remainingCopies,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name.length>16 ? name.slice(0,16)+\"...\" : name}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n        <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center\">\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{copies - remainingCopies} Sold</p>\n            </div>\n          )}\n          {remainingCopies && (\n            <div className=\"auction-owner-name\">\n              <p>{remainingCopies} Remaining</p>\n            </div>\n          )}\n        </div>\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        {ownerName && (\n          <div className=\"auction-card-owner-container d-flex justify-content-between align-items-center  mb-2\">\n            <div className=\"auction-owner-name\">\n              <p>Owner</p>\n            </div>\n            <div className=\"d-flex align-items-center ps-1\">\n              <span>\n                {ownerId === ENV.getUserKeys(\"_id\")._id ? \"You\" : ownerName}\n              </span>\n            </div>\n          </div>\n        )}\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center \"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/propertiesinfo.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/StatsModal.js",["634"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/PropertiesModal.js",["635"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/modals/LevelsModal.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/filter-component/FilterComponent.js",[],["636","637"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["638","639"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/aboutus/aboutus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/contactus/contactus.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/components/faqs/faqs.js",["640","641"],{"ruleId":"642","severity":1,"message":"643","line":18,"column":13,"nodeType":"644","endLine":20,"endColumn":4},{"ruleId":"642","severity":1,"message":"645","line":20,"column":6,"nodeType":"646","endLine":20,"endColumn":11,"suggestions":"647"},{"ruleId":"642","severity":1,"message":"648","line":2