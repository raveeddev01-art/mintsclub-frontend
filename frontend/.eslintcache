             >\n                  <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                    <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                      <div className=\"ps-2\">\n                        <h6>Name:</h6>\n                      </div>\n                      <div className=\"inp-container\">\n                        <input\n                          type=\"text\"\n                          name=\"name\"\n                          value={item.name}\n                          onKeyDown={(e) =>\n                            firstInputCharacterSpace(e, item.name.length)\n                          }\n                          onChange={(e) => handleChange(i, e, \"levels\")}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                    <div className=\"d-flex align-items-center justify-content-between\">\n                      <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                        <div className=\"ps-2\">\n                          <h6>Value:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={item.value}\n                            min=\"1\"\n                            onKeyDown={(e) => decimalNumberValidator(e)}\n                            onChange={(e) => {\n                              if (\n                                +e.target.value > 5 ||\n                                (+e.target.value <= 0 && item.value == \"\") ||e.target.value.includes(\".\")\n                              ) {\n                                return \"\";\n                              }\n                              handleChange(i, e, \"levels\");\n                            }}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"value-inp-of mx-3\">\n                        <h6>of</h6>\n                      </div>\n                      <div className=\"bid-inp-container modal-value-inp\">\n                        <div className=\"inp-container \">\n                          <input\n                            type=\"number\"\n                            name=\"value\"\n                            value={5}\n                            autoComplete=\"off\"\n                            className=\"text-center\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                    <div className=\"inp-close text-end me-2\">\n                      <button>\n                        <img\n                          src={InputClose}\n                          alt=\"closemodal\"\n                          onClick={() => removeFormFields(i, \"levels\")}\n                        />\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"levels\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3 \"\n            disabled={levels && levels.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default LevelsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/PropertiesModal/PropertiesModal.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Breadcrumb/Breadcrumb.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/HeroLoader.tsx",["668"],"import ContentLoader, { IContentLoaderProps } from 'react-content-loader'\nimport './ImageLoader.css'\nconst HeroLoader=(props: any)=>{\n\n    return (\n        <ContentLoader\n        // width={450}\n        // height={400}      \n        backgroundColor=\"#f0f0f0\"\n        foregroundColor=\"#dedede\"\n        style={{width:\"100%\",height:\"400px\"}}\n        className=\"\"\n        {...props}\n      >\n        {/* <rect x=\"43\" y=\"304\" rx=\"4\" ry=\"4\" width=\"271\" height=\"9\" />\n        <rect x=\"44\" y=\"323\" rx=\"3\" ry=\"3\" width=\"119\" height=\"6\" /> */}\n        <rect className=\"w-100 h-100\" rx=\"30\" ry=\"30\" />\n      </ContentLoader>\n    )\n}\n\nexport default HeroLoader;",{"ruleId":"669","replacedBy":"670"},{"ruleId":"671","replacedBy":"672"},{"ruleId":"673","severity":1,"message":"674","line":1,"column":38,"nodeType":"675","messageId":"676","endLine":1,"endColumn":48},{"ruleId":"677","severity":1,"message":"678","line":19,"column":13,"nodeType":"679","endLine":21,"endColumn":4},{"ruleId":"677","severity":1,"message":"680","line":21,"column":6,"nodeType":"681","endLine":21,"endColumn":11,"suggestions":"682"},{"ruleId":"677","severity":1,"message":"683","line":50,"column":6,"nodeType":"681","endLine":50,"endColumn":8,"suggestions":"684"},{"ruleId":"669","replacedBy":"670"},{"ruleId":"671","replacedBy":"672"},{"ruleId":"685","severity":1,"message":"686","line":1,"column":17,"nodeType":"675","messageId":"676","endLine":1,"endColumn":31