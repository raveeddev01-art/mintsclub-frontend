arningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"220"},{"filePath":"434","messages":"435","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"436","usedDeprecatedRules":"220"},{"filePath":"437","messages":"438","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"230"},{"filePath":"439","messages":"440","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"220"},{"filePath":"441","messages":"442","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"220"},{"filePath":"443","messages":"444","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"230"},{"filePath":"445","messages":"446","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"447","usedDeprecatedRules":"230"},{"filePath":"448","messages":"449","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"450","messages":"451","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"452","messages":"453","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"230"},{"filePath":"454","messages":"455","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"456","usedDeprecatedRules":"230"},{"filePath":"457","messages":"458","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"459","usedDeprecatedRules":"230"},{"filePath":"460","messages":"461","errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"462","usedDeprecatedRules":"230"},{"filePath":"463","messages":"464","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"465","usedDeprecatedRules":"230"},{"filePath":"466","messages":"467","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"468","messages":"469","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"470","usedDeprecatedRules":"230"},{"filePath":"471","messages":"472","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"230"},{"filePath":"473","messages":"474","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"230"},{"filePath":"475","messages":"476","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"477","usedDeprecatedRules":"230"},"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/index.js",[],["478","479"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/App.js",["480","481","482","483"],"import React, { Suspense, useEffect, useContext } from \"react\";\nimport routes from \"./routes\";\nimport { PrivateRoute } from \"./privateRoute\";\nimport { Switch } from \"react-router-dom\";\nimport FullPageLoader from \"./Components/FullPageLoader/FullPageLoader\";\nimport tawkTo from \"tawkto-react\";\nimport { ENV } from \"./config/config\";\nimport \"./App.css\";\nimport { toast } from \"react-toastify\";\nimport useGaTracker from \"./gaTracker/gaTracket\";\nimport { connect } from \"react-redux\";\nimport { beforeWallet, setWalletAddress } from \"./pages/wallet/wallet.action\";\n\nconst App = React.memo((props) => {\n  useGaTracker();\n  const tawkToPropertyId = ENV.tawkToPropertyId;\n  const tawkToKey = ENV.tawkToKey;\n\n  useEffect(async () => {\n    tawkTo(tawkToPropertyId, tawkToKey);\n  }, [ENV]);\n\n  useEffect(() => {\n    if (!window.ethereum) {\n      return;\n    }\n    const accountWasChanged = (accounts) => {\n      setWallet(accounts[0]);\n    };\n\n    const getAndSetAccount = async () => {\n      const changedAccounts = await window.ethereum.request({\n        method: \"eth_requestAccounts\",\n      });\n      if (changedAccounts.length === 0) {\n        toast.error(\"you are not connected with metamask\");\n      }\n      setWallet(changedAccounts[0]);\n    };\n    window.ethereum.on(\"accountsChanged\", accountWasChanged);\n    window.ethereum.on(\"connect\", getAndSetAccount);\n    // window.ethereum.on(\"disconnect\", ()=>alert(\"account cleared\"));\n    window.ethereum.request({ method: \"eth_requestAccounts\" }).then(\n      (accounts) => {\n        setWallet(accounts[0]);\n      },\n      (error) => {}\n    );\n    return () => {};\n  }, []);\n\n  const setWallet = (address) => {\n    props.beforeWallet();\n    props.setWalletAddress(address);\n  };\n\n\n  return (\n    <React.Fragment>\n    \n      <Suspense fallback={<FullPageLoader />}>\n        <div>\n          <Switch>\n            {routes.map((route, index) => {\n              return (\n                <PrivateRoute\n                  key={index}\n                  path={route.path}\n                  exact={route.exact}\n                  access={route.access}\n                  component={(props) => (\n                    <route.layout {...props} title={route.title}>\n                      <route.component {...props} />\n                    </route.layout>\n                  )}\n                />\n              );\n            })}\n          </Switch>\n        </div>\n\n      </Suspense>\n    </React.Fragment>\n  );\n});\n\nconst mapStateToProps = (state) => ({});\n\nexport default connect(mapStateToProps, {\n  setWalletAddress,\n  beforeWallet,\n})(App);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/serviceWorker.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/store.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/AppContextProvider.tsx",[],["484","485"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/routes.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/privateRoute.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/index.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/wallet/wallet.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/gaTracker/gaTracket.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/config/config.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/FullPageLoader/FullPageLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/darkmode/DarkModeState.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/errorHandler/ErrorHandlerState.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/combineComponents.tsx",["486"],"import React, { ComponentProps, FC } from \"react\";\n\nexport const combineComponents = (...components: FC[]): FC => {\n  return components.reduce(\n    (AccumulatedComponents: any, CurrentComponent: any) => {\n      return ({ children }: any): JSX.Element => {\n        return (\n          <AccumulatedComponents>\n            <CurrentComponent>{children}</CurrentComponent>\n          </AccumulatedComponents>\n        );\n      };\n    },\n    ({ children }) => <>{children}</>\n  );\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/wallet/wallet.js",["487","488","489","490","491","492"],"import React, { useState, useEffect } from \"react\";\nimport { useHistory } from \"react-router-dom\";\nimport validator from \"validator\";\nimport { connect } from \"react-redux\";\nimport {\n  signRequest,\n  connectWithMetamask,\n  getChainId,\n  switchNetworkToChainId,\n} from \"../../utils/web3\";\nimport { beforeWallet, setWalletAddress } from \"./wallet.action\";\nimport { toast } from \"react-toastify\";\nimport {\n  beforeCategory,\n  beforeCollection,\n} from \"../collections/collections.actions\";\nimport { login, signup } from \"../../Components/User/user.action\";\n// import {setWalletAddress} from \"../../redux/shared/shared/shared.action\"\nimport { Images } from \"../../assets/assets\";\nimport \"./wallet.css\";\nimport Banner from \"../../Components/Banner/Banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport { getWalletAddress, validateNetwork } from \"../../utils/web3\";\nimport { ENV } from \"../../config/config\";\nconst Wallet = (props) => {\n  const history = useHistory();\n  let walletAddress = false;\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [errorMessage, setErrorMessage] = useState(\"\");\n  const [showSignUp, setShowSignUp] = useState(false);\n  const [showSignUpComponent, setShowSignUpComponent] = useState(false);\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [disabled, setDisabled] = useState(false);\n  const [loader, setLoader] = useState(false);\n  useEffect(async () => {\n    let address = await getWalletAddress();\n    if (address) {\n      setConnectedAddress(address);\n    }\n    window.ethereum.on(\"disconnect\", () => setConnectedAddress(null));\n  }, []);\n\n  const connectMetamaskCall = async () => {\n    if (detectMobile() && !window.ethereum) {\n      window.open(\n        \"https://metamask.app.link/dapp/mintsclub-v2-marketplace.invo.zone/\"\n      );\n    } else {\n      // if (await validateNetwork()) {\n      if (getChainId !== ENV.chainId) {\n        try {\n          await switchNetworkToChainId(ENV.chainId);\n        } catch (error) {\n          return toast.error(error.message);\n        }\n      }\n      let connectedAddress = false;\n      setDisabled(true);\n      if (detectMobile()) {\n        connectedAddress = await getWalletAddress();\n      } else {\n        connectedAddress = await connectWithMetamask();\n      }\n      if (connectedAddress) {\n        setDisabled(false);\n      }\n      setConnectedAddress(connectedAddress);\n      // } else {\n      //   toast.error(\n      //     \"Please Connect Your Metamask With Ethereum Rinkby Network\"\n      //   );\n      // }\n    }\n  };\n  const detectMobile = () => {\n    if (\n      /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(\n        navigator.userAgent\n      )\n    ) {\n      return true;\n    } else {\n      return false;\n    }\n  };\n\n  useEffect(() => {\n    props.beforeCategory();\n    if (props.error) {\n      setErrorMessage(props.error.message);\n      if (props.error.notExist) {\n        setDisabled(false);\n        setShowSignUp(true);\n      } else {\n        setShowSignUp(false);\n      }\n    }\n  }, [props.error]);\n\n  useEffect(() => {\n    if (props.collection.getAuth&&ENV.getUserKeys(\"_id\")?._id) {\n      props.beforeCollection();\n      toast.success(\"User logged in successfully\");\n      history.push(\"/\");\n    }\n  }, [props.collection.getAuth]);\n\n  const signup = async (e) => {\n    e.preventDefault();\n    if (getChainId !== ENV.chainId) {\n      try {\n        let newAcc = await switchNetworkToChainId(ENV.chainId);\n        props.setWalletAddress(newAcc);\n        setConnectedAddress(newAcc);\n      } catch (error) {\n        return toast.error(error.message);\n      }\n    }\n    setDisabled(true);\n    try {\n      if (validator.isEmail(email)) {\n        await signRequest();\n        let payload = {\n          address: connectedAddress,\n          email: email,\n          username: username,\n          isApproved: false,\n        };\n        props.signup(payload);\n      } else {\n        setErrorMessage(\"please enter valid email\");\n      }\n    } catch (err) {\n      toast.error(err.message);\n      setDisabled(false);\n    }\n  };\n\n  const login = async () => {\n    if (getChainId !== ENV.chainId) {\n      try {\n        let newAcc = await switchNetworkToChainId(ENV.chainId);\n        props.setWalletAddress(newAcc);\n        setConnectedAddress(newAcc);\n      } catch (error) {\n     \n      }\n    }\n    try {\n      setDisabled(true);\n      setLoader(true);\n      await signRequest();\n      let payload = {\n        address: connectedAddress,\n      };\n      props.setWalletAddress(connectedAddress)\n\n      props.login(payload);\n    } catch (err) {\n      setDisabled(false);\n      setLoader(false);\n      toast.error(err.message);\n    }\n    // } else {\n    //   toast.error(\"Please Connect Your Metamask With Ethereum Rinkby Network\");\n    // }\n  };\n\n  useEffect(() => {\n    const interval = setInterval(() => {\n      handleMetamaskStatus();\n    }, 2000);\n\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleMetamaskStatus = async () => {\n    const address = await getWalletAddress();\n\n    if (walletAddress) {\n      if (walletAddress !== address) {\n        walletAddress = address;\n        setShowSignUpComponent(false);\n        setShowSignUp(false);\n        setErrorMessage(false);\n        setConnectedAddress(address);\n      }\n    } else {\n      const address = await getWalletAddress();\n      walletAddress = address;\n    }\n  };\n\n  const signInbannerData = {\n    subHeading: \"Login\",\n    heading: \"Login Information\",\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n  return (\n    <section\n      className={\n        !showSignUpComponent\n          ? `wallet-connect-area wallet-wrapper`\n          : `author-area wallet-wrapper`\n      }\n    >\n      <div>\n        {connectedAddress && !showSignUpComponent ? (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n            <div className=\"padding-wrapper\">\n              <div className=\"container\">\n                <div className=\"row justify-content-center\">\n                  <div className=\"col-12 col-md-8 col-lg-7\">\n                    {/* Intro */}\n                    <div className=\"intro wallet-intro  text-center\">\n                      <span>Sign in</span>\n                      <h3 className=\"mt-3 mb-0\">Sign in to your account</h3>\n                      <p className=\"mt-3\">\n                        Please Click to Sign in your Account.\n                      </p>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"row justify-content-center items mb-5\">\n                  <div className=\"col-12 col-sm-9 col-md-7 col-lg-5 col-xl-5 item\">\n                    <div className=\"sign-in-card\">\n                      <span\n                        className=\"sign-content-wrapper text-center\"\n                        href=\"/login\"\n                      >\n                        <h4 className=\"mb-0\">Address</h4>\n                        <p className=\"mt-4\">{connectedAddress}</p>\n                        {errorMessage && (\n                          <p className=\"text-danger\">{errorMessage}</p>\n                        )}\n                        {!showSignUp && (\n                          <>\n                            <button\n                              className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4\"\n                              type=\"button\"\n                              disabled={disabled || loader}\n                              onClick={() => login()}\n                            >\n                              {loader ? (\n                                <div className=\"text-center\">\n                                  <div\n                                    className=\"spinner-border sign-in-spinner text-white\"\n                                    role=\"status\"\n                                  >\n                                    <span className=\"sr-only\">Loading...</span>\n                                  </div>\n                                </div>\n                              ) : (\n                                \"Sign in\"\n                              )}\n                            </button>\n                          </>\n                        )}\n\n                        {showSignUp && (\n                          <button\n                            className=\"btn btn-linear-gradient btn-signin w-75 mx-auto mt-3 mt-sm-4 text-white\"\n                            type=\"button\"\n                            onClick={() => history.push(\"/signup\")}\n                          >\n                            Would you like to Signup?\n                          </button>\n                        )}\n                      </span>\n                    </div>\n                    <button\n                      className=\"change-wallet-btn mt-5 d-flex mx-auto\"\n                      onClick={() => setConnectedAddress(null)}\n                    >\n                      Change Wallet Address\n                    </button>\n\n                    <span className=\"new-member mt-5 d-flex justify-content-center\">\n                      New Member?\n                      {!detectMobile() ? (\n                        <a className=\"register-member mx-1\" href={\"/signup\"}>\n                          {\" \"}\n                          Register\n                        </a>\n                      ) : (\n                        <a\n                          className=\"register-member mx-1\"\n                          onClick={() =>\n                            window.open(\n                              \"https://metamask.app.link/dapp/mintsclub-v2-marketplace.invo.zone/signup\"\n                            )\n                          }\n                        >\n                          {\" \"}\n                          Register\n                        </a>\n                      )}\n                      here.\n                    </span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : showSignUpComponent ? (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n\n            <div className=\"container\">\n              <div className=\"row justify-content-center\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  {/* Intro */}\n                  <div className=\"intro text-center\">\n                    <span>SIGNUP</span>\n                    <h3 className=\"mt-3 mb-0\">Create an Account</h3>\n                    <p className=\"text-gray\">\n                      Create the account with the address\n                    </p>\n                  </div>\n                  {/* Item Form */}\n                  <form\n                    className=\"item-form card no-hover signup-card\"\n                    onSubmit={(e) => signup(e)}\n                  >\n                    <div className=\"row\">\n                      {errorMessage && (\n                        <p className=\"text-center text-gray\">{errorMessage}</p>\n                      )}\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control sign-up-input\"\n                            name=\"address\"\n                            placeholder=\"Address\"\n                            required=\"required\"\n                            disabled={true}\n                            value={connectedAddress}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"email\"\n                            className=\"form-control sign-up-input\"\n                            name=\"email\"\n                            placeholder=\"Enter your Email\"\n                            required=\"required\"\n                            defaultValue={email}\n                            onChange={(e) => setEmail(e.target.value)}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3\">\n                          <input\n                            type=\"text\"\n                            className=\"form-control sign-up-input\"\n                            name=\"username\"\n                            placeholder=\"Enter your Username\"\n                            required=\"required\"\n                            defaultValue={username}\n                            onChange={(e) => setUsername(e.target.value)}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"form-group mt-3 text-center\">\n                          <div className=\"form-check form-check-inline\">\n                            <input\n                              className=\"form-check-input\"\n                              type=\"radio\"\n                              name=\"inlineRadioOptions\"\n                              id=\"inlineRadio1\"\n                              defaultValue=\"option1\"\n                              autoComplete=\"off\"\n                            />\n                            <label\n                              className=\"form-check-label text-center text-gray\"\n                              htmlFor=\"inlineRadio1\"\n                            >\n                              I agree to{\" \"}\n                              <a href=\"/privacy-and-terms\">Privacy Policy</a>\n                            </label>\n                          </div>\n                        </div>\n                      </div>\n                      <div className=\"col-12\">\n                        <div className=\"text-center\">\n                          <button\n                            className=\"btn btn-linear-gradient btn-signin mt-3 mt-sm-4  text-white \"\n                            type=\"submit\"\n                            disabled={disabled}\n                          >\n                            Sign Up\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  </form>\n                </div>\n              </div>\n            </div>\n          </>\n        ) : (\n          <>\n            <div className=\"log-in-banner\">\n              <Banner\n                subHeading={signInbannerData.subHeading}\n                heading={signInbannerData.heading}\n                content={signInbannerData.content}\n                bgImg={BannerBg}\n              />\n            </div>\n            <div className=\"padding-wrapper\">\n              <div className=\"container mb-5\">\n                <div className=\"row justify-content-center\">\n                  <div className=\"col-12 col-md-8 col-lg-7\">\n                    <div className=\"intro wallet-intro text-center\">\n                      <span>Wallet Connect</span>\n                      <h3 className=\"mt-3 mb-0\">Connect your Wallet</h3>\n                      {/* <p className=\" mt-3\">\n                        Please select the wallet you want to connect to.\n                      </p> */}\n                    </div>\n                  </div>\n                </div>\n                <div\n                  className=\"connect-metamask-container text-center mx-auto\"\n                  onClick={() => connectMetamaskCall()}\n                >\n                  <img\n                    className=\"avatar-lg mt-4\"\n                    src={Images.metamaskImg}\n                    alt=\"\"\n                  />\n                  <p className=\"metamask-title mt-2\">Metamask</p>\n                  <p className=\"metamask-desc px-sm-0 px-3\">\n                    A browser extension with great flexibility.\n                    <br className=\"d-none d-sm-block\" /> The web's most popular\n                    wallet\n                  </p>\n                </div>\n\n                <span className=\"new-member d-flex  justify-content-center mt-5\">\n                  Don't have Metamask ? Click\n                  <span\n                    className=\"register-member mx-1\"\n                    onClick={() => window.open(\"https://metamask.io/download/\")}\n                  >\n                    {\" \"}\n                    Here{\" \"}\n                  </span>\n                  to Install.\n                </span>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  wallet: state.wallet,\n  collection: state.collection,\n  user: state.user,\n  error: state.error,\n});\n\nexport default connect(mapStateToProps, {\n  beforeWallet,\n  setWalletAddress,\n  login,\n  signup,\n  beforeCategory,\n  beforeCollection,\n})(Wallet);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/signup/signup.js",["493","494","495"],"import React, { useEffect, useState } from \"react\";\r\nimport { useHistory } from \"react-router\";\r\nimport Banner from \"../../Components/Banner/Banner\";\r\nimport BannerBg from \"../../assets/images/hero-bg.png\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { connectMetamaskCopy, signRequest } from \"../../utils/web3\";\r\nimport { toast } from \"react-toastify\";\r\nimport { signup } from \"../../Components/User/user.action\";\r\nimport \"./signup.css\";\r\n\r\nconst SignUp = (props) => {\r\n  const [checkBox, setCheckBox] = useState(false);\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n  const [email, setEmail] = useState(\"\");\r\n  const [username, setUsername] = useState(\"\");\r\n  const [loader, setLoader] = useState(false);\r\n\r\n  const history = useHistory();\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n     setConnectedAddress(connectedAddress);\r\n  }, []);\r\n  \r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.error?.message) {\r\n      toast.error(props.error.message);\r\n      setLoader(false);\r\n    }\r\n  }, [props.error]);\r\n  useEffect(() => {\r\n    if (props.userAuth) {\r\n      toast.success(\"Signed up successfully\");\r\n      history.push(\"/\");\r\n    }\r\n  }, [props.userAuth]);\r\n\r\n  const signup = async (e) => {\r\n    e.preventDefault();\r\n    try {\r\n      setLoader(true);\r\n      let sign = await signRequest();\r\n      let payload = {\r\n        address: connectedAddress,\r\n        email: email,\r\n        username: username,\r\n        isApproved: false,\r\n      };\r\n      props.signup(payload);\r\n    } catch (err) {\r\n      setLoader(false);\r\n      toast.error(err.message);\r\n    }\r\n  };\r\n\r\n  const signInbannerData = {\r\n    subHeading: \"Sign Up\",\r\n    heading: \"Create an Account\",\r\n    content:\r\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\r\n  };\r\n\r\n  return (\r\n    <>\r\n      <Banner\r\n        subHeading={signInbannerData.subHeading}\r\n        heading={signInbannerData.heading}\r\n        content={signInbannerData.content}\r\n        bgImg={BannerBg}\r\n      />\r\n      <section className=\"signup-section padding-wrapper mb-5\">\r\n        <div className=\"container\">\r\n          <form onSubmit={signup}>\r\n            <div className=\"row\">\r\n              <div className=\"signup-title\">\r\n                <p className=\"create-acc mt-5\">Create Account</p>\r\n                <p className=\"acc-info\">\r\n                  There’s no account linked to the address, Please SingUp first.\r\n                </p>\r\n              </div>\r\n              <div className=\"col-12 mt-5\">\r\n                <label className=\"label-common\">Address:*</label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  id=\"url\"\r\n                  type=\"text\"\r\n                  name=\"url\"\r\n                  placeholder={connectedAddress}\r\n                  readOnly\r\n                />\r\n              </div>\r\n              <div className=\"col-md-6 col-sm-12 mt-5\">\r\n                <label className=\"label-common \">\r\n                  Enter your email address:*\r\n                </label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  type=\"email\"\r\n                  name=\"email\"\r\n                  placeholder=\"Enter your Email\"\r\n                  required\r\n                  defaultValue={email}\r\n                  onChange={(e) => setEmail(e.target.value)}\r\n                  maxLength=\"55\"\r\n                  autoComplete=\"off\"\r\n                />\r\n              </div>\r\n              <div className=\"col-md-6 col-sm-12 mt-5\">\r\n                <label className=\"label-common\">Enter your username:*</label>\r\n                <input\r\n                  className=\"input-common mt-2\"\r\n                  type=\"text\"\r\n                  name=\"username\"\r\n                  maxLength=\"55\"\r\n                  placeholder=\"Enter your Username\"\r\n                  required\r\n                  defaultValue={username}\r\n                  onChange={(e) => setUsername(e.target.value)}\r\n                  autoComplete=\"off\"\r\n                />\r\n              </div>\r\n              <div>\r\n                <div className=\"checkbox-container d-flex align-items-center mt-5\">\r\n                  {checkBox ? (\r\n                    <span\r\n                      className=\"custom-checked-box me-2\"\r\n                      onClick={() => setCheckBox(!checkBox)}\r\n                    >\r\n                      <svg\r\n                        xmlns=\"http://www.w3.org/2000/svg\"\r\n                        width=\"13\"\r\n                        height=\"10\"\r\n                      >\r\n                        <path\r\n                          fill-rule=\"evenodd\"\r\n                          fill=\"#FFF\"\r\n                          d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\r\n                        />\r\n                      </svg>\r\n                    </span>\r\n                  ) : (\r\n                    <span\r\n                      className=\"custom-uncheck-box me-2\"\r\n                      onClick={() => setCheckBox(!checkBox)}\r\n                    ></span>\r\n                  )}\r\n                  <p>\r\n                    By checking this box, I agree to MintsClub{\" \"}\r\n                    <Link to=\"/termsandconditions\" target=\"_blank\">{\"Terms & Conditions\" }</Link>\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <button\r\n              disabled={\r\n                !checkBox || email.trim() === \"\" || username.trim() === \"\"\r\n              }\r\n              type=\"submit\"\r\n              className=\"btn btn-linear-gradient sign-up-btn mt-5\"\r\n            >\r\n              {loader ? (\r\n                <div className=\"text-center\">\r\n                  <div\r\n                    className=\"spinner-border text-white sign-up-loader\"\r\n                    role=\"status\"\r\n                  >\r\n                    <span className=\"sr-only\">Loading...</span>\r\n                  </div>\r\n                </div>\r\n              ) : (\r\n                \"Sign Up\"\r\n              )}\r\n            </button>\r\n          </form>\r\n        </div>\r\n      </section>\r\n    </>\r\n  );\r\n};\r\n\r\nconst mapStateToProps = (state) => (\r\n  {\r\n    wallet: state.wallet,\r\n    collection: state.collection,\r\n    user: state.user,\r\n    userAuth: state.user.userAuth,\r\n    error: state.error,\r\n  }\r\n);\r\n\r\nexport default connect(mapStateToProps, {\r\n  signup,\r\n})(SignUp);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/wallet/wallet.reducer.js",["496"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/home/home.reducer.js",["497","498"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/auctions.reducer.js",["499"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/explore.reducer.js",["500"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/types.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Nfts/nfts.reducer.js",["501"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION,\n  CREATE_NFT_AUTH\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  createNFTauth:false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n      case  CREATE_NFT_AUTH:\n        return {\n          ...state,\n          createNFTauth:true,\n        }\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n        createNFTauth:false\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n      case BEFORE_NFTS_BY_COLLECTION:\n        return {\n          ...state,\n          nftsByCollectionStatus: false,\n        }\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/User/user.reducer.js",["502"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Categories/categories.reducer.js",["503"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/collections.reducer.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Offers/offers.reducer.js",["504"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n          \n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Bids/bids.reducer.js",["505"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            \n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/footer.reducer.js",["506"],"import {SUBSCRIBE, BEFORE_FOOTER,SUBSCRIBE_RESPONSE } from '../../redux/types';\n\nconst initialState = {\n    subscribeAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n            case BEFORE_FOOTER:\n                return {\n                    ...state,\n                    subscribeAuth: false,\n                }\n                case SUBSCRIBE:\n                    return {\n                        ...state,\n                        subscribeAuth:false,  \n                    }\n                    case SUBSCRIBE_RESPONSE:\n                        return {\n                            ...state,\n                            subscribeAuth:true,\n                        }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["507"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}\n\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/redux/shared/error/error.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/home/home.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/home-auction-list.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/not-found/not-found.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/top-seller/topsellerlist.tsx",["508","509","510"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"../../config/config\";\nimport { getTopSellers, beforeUser } from \"../../Components/User/user.action\";\nimport SellerTickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport \"./topseller.css\";\nimport NavbarMain from \"../../Components/NavbarMain/NavbarMain\";\nimport Footer from \"../../Components/Footer/Footer\";\nimport Breadcrumb from \"../../Components/Breadcrumb/Breadcrumb\";\nimport { Images } from \"../../assets/assets\";\n\nconst TopSellerList = (props:any) => {\n  const [sellers, setSellers] = useState<any>([]);\n  const [limit, setLimit] = useState<any>(10);\n  const [pagination, setPagination] = useState<any>(null);\n  const [empty, setEmpty] = useState<any>(false);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    props.getTopSellers();\n  }, []);\n\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      const { topSellers, pagination } = props.user.sellers;\n      if (topSellers === null) {\n        setEmpty(true);\n      } else {\n        setEmpty(false);\n      }\n      setPagination(pagination);\n      setSellers(topSellers);\n      props.beforeUser();\n    }\n  }, [props.user.topSellersAuth]);\n\n  const handlePagination = () => {\n    let qs:any = { limit: limit + 10, page: 1 };\n    qs = ENV.objectToQueryString(qs);\n    props.getTopSellers(qs);\n  };\n  return (\n    <>\n      <NavbarMain />\n      <Breadcrumb title1={\"Sellers\"} title2={\"TopSellers\"} />\n      <section className=\"top-seller-area padding-wrapper\">\n        <div className=\"container\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Intro */}\n              <div className=\"intro d-flex justify-content-between align-items-end m-0\">\n                <div className=\"intro-content\">\n                  <span>CREATIVE ARTIST</span>\n                  <h3 className=\"mb-0\">Top Sellers</h3>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"row items\">\n            {sellers && sellers.length ? (\n              sellers.map((author:any, idx:any) => {\n                return (\n                  <div\n                    key={`ts_${idx}`}\n                    className=\"col-12 col-sm-6 col-lg-4 col-xl-3 item top-seller-cards\"\n                  >\n                    {/* Single Seller */}\n                    <div className=\"card top-seller-card\">\n                      <div className=\"single-seller d-flex align-items-center\">\n                        <div className=\"seller-avatar-container\">\n                          <img\n                            className=\"avatar-md rounded-circle\"\n                            src={\n                              author.profileImage === null\n                                ? Images.profilePlaceholder\n                                : author.profileImage\n                            }\n                            alt=\"AvatarImg\"\n                          />\n                          {author.profileImage ? (\n                            <span className=\"seller-avatar-active\">\n                              <img src={SellerTickIcon} alt=\"tick-icon\" />\n                            </span>\n                          ) : (\n                            \"\"\n                          )}\n                        </div>\n\n                        {/* Seller Info */}\n                        <div className=\"seller-info ml-3 w-100\">\n                          <Link\n                            className=\"seller text-capitalize mb-2\"\n                            to={`/author/${author._id}`}\n                          >\n                            {author.username}\n                          </Link>\n                          <span className=\"text-end\">\n                            {\" \"}\n                            {author.totalETH.toFixed(2)}\n                          </span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })\n            ) : (\n              <p>No Top Sellers Found</p>\n            )}\n            <div className=\"col-12\">\n              <div className=\"mt-5 text-center\">\n                {!empty &&\n                  sellers?.length === 10 &&\n                  pagination.totalRecords > sellers.length && (\n                    <button\n                      className=\"btn btn-linear-gradient px-5\"\n                      onClick={() => handlePagination()}\n                    >\n                      Load more\n                    </button>\n                  )}\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state:any) => ({\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeUser, getTopSellers })(\n  TopSellerList,\n  // beforeUser\n);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/aboutus/aboutus.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/faqs/faqs.tsx",["511","512"],"import React, { useEffect } from \"react\";\nimport \"./faqs.css\";\nimport Banner from \"../../Components/Banner/Banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport { Accordion, Card } from \"react-bootstrap\";\nimport { faqsBanner,faqsData } from \"../../utils/exportData\";\n\nconst Faqs = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={faqsBanner.subHeading}\n        heading={faqsBanner.heading}\n        content={faqsBanner.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper faqs\">\n        <div className=\"container\">\n          <div className=\"row align-items-center justify-content-center\">\n            <div className=\"col-12\">\n              <div\n                className=\"faqs-accordion accordion accordion-flush mx-auto\"\n                id=\"accordionFlushExample\"\n              >\n                {faqsData.map((faq, id) => {\n                  return (\n                    <div className=\"accordion-item mb-4\">\n                      <h2 className=\"accordion-header\" id={`${id}`}>\n                        <button\n                          className=\"accordion-button collapsed\"\n                          type=\"button\"\n                          data-toggle=\"collapse\"\n                          data-target={`#c${id}`}\n                          aria-expanded=\"false\"\n                          aria-controls={`c${id}`}\n                        >\n                          <span>Q{`${id + 1}.`}</span>\n                          {faq.question}\n                        </button>\n                      </h2>\n                      <div\n                        id={`c${id}`}\n                        className=\"accordion-collapse collapse\"\n                        aria-labelledby={`${id}`}\n                      >\n                        <div className=\"accordion-body\">\n                          <p>{faq.ans}</p>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default Faqs;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/privacy-policy/privacyPolicy.tsx",["513"],"import React, { useEffect } from \"react\";\nimport \"./privacyPolicy.css\";\nimport Banner from \"../../Components/Banner/Banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg2.png\";\nimport { privacyBanner } from \"../../utils/exportData\";\n\n\nconst PrivacyPolicy = () => {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n  return (\n    <>\n      <Banner\n        subHeading={privacyBanner.subHeading}\n        heading={privacyBanner.heading}\n        content={privacyBanner.content}\n        bgImg={BannerBg}\n        bannerImg={BannerImage}\n      />\n      <div className=\"padding-wrapper privacy\">\n        <div className=\"container\">\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Privacy Policy</h5>\n            <p>\n              MintsClub is committed to protecting your privacy. We have\n              prepared this Privacy Policy to describe our working practices\n              regarding the Personal Data we collect, use, and share in\n              connection with the MintsClub website, as described in our Terms\n              of Service (collectively, the “Service”). “NFT” as per this\n              Privacy Policy refers to a non-fungible token or similar digital\n              item implemented on a blockchain (such as the Ethereum\n              blockchain), which uses smart contracts to link to or otherwise be\n              associated with certain content or data.\n              <br />\n              By using our platform and the Services, you accept the terms of\n              this Policy and our Terms of Use, and consent to our collection,\n              use, disclosure, and retention of your information as described in\n              this Policy. If you have not done so already, please also review\n              our terms of use. The terms of use contain provisions that limit\n              our liability to you and require you to resolve any dispute with\n              us on an individual basis and not as part of any class or\n              representative action. <br />\n              <span>\n                IF YOU DO NOT AGREE WITH ANY PART OF THIS PRIVACY POLICY OR OUR\n                TERMS OF USE, THEN PLEASE DO NOT USE ANY OF THE SERVICES.\n              </span>\n              <br />\n              Please note that this Policy does not apply to information\n              collected through third-party websites or services that you may\n              access through the Services or that you submit to us through\n              email, text message or other electronic message or offline.\n            </p>\n          </div>\n          <div className=\"privacy-content\">\n            <h5>Information We Collect</h5>\n            <p>We may collect information about you in a range of ways.</p>\n            <ul>\n              <li>\n                {\" \"}\n                Identity information, such as your first name, last name,\n                username or similar identifier, title, date of birth and gender.\n              </li>\n              <li>\n                {\" \"}\n                Contact information, such as your postal address, email address\n                and telephone number.\n              </li>\n              <li>\n                {\" \"}\n                Profile information, such as your, profile picture, username and\n                wallet address, interests, preferences, feedback and survey\n                responses.\n              </li>\n              <li>\n                {\" \"}\n                Feedback and correspondence, such as information you provide in\n                your responses to surveys, when you participate in market\n                research activities, report a problem with Service, receive\n                customer support or otherwise correspond with us.\n              </li>\n              <li>\n                {\" \"}\n                Financial information, such as your credit card or other payment\n                card details.\n              </li>\n              <li>\n                {\" \"}\n                Transaction information, such details about purchases you make\n                through the Service and billing details.\n              </li>\n              <li>\n                {\" \"}\n                Usage information, such as information about how you use the\n                Service and interact with us.\n              </li>\n              <li>\n                {\" \"}\n                Marketing information, such as your preferences for receiving\n                marketing communications and details about how you engage with\n                them.\n              </li>\n              <li>\n                {\" \"}\n                Financial information, such as bank account number and bank\n                routing number; financial assets holdings.\n              </li>\n              <li>\n                {\" \"}\n                Technical information, such as your Ethereum wallet address,\n                application programming interface (API)-key and network\n                information regarding transactions. Please note that your\n                Ethereum wallet address is not collected by{\" \"}\n                <a href=\"https://metamask.io/\" target=\"_blank\">\n                  Metamask{\" \"}\n                </a>\n                or associated plugins and mobile applications.\n              </li>\n            </ul>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected by other means</h5>\n            <p>\n              As you navigate through and interact with the MintsClub website,\n              we may use automatic data collection technologies to collect\n              certain information about your equipment, browsing actions, and\n              patterns, including:\n              <br />\n              Information Collected by Our Servers. To provide our Service and\n              make it more useful to you, we (or a third party service provider)\n              collect information from you, including, but not limited to, your\n              browser type, operating system, Internet Protocol (“IP”) address,\n              mobile device ID, blockchain address, wallet type, and date/time\n              stamps.\n              <br />\n              Log Files. We gather certain information automatically and store\n              it in log files. This information includes IP addresses, browser\n              type, Internet service provider (“ISP”), referring/exit pages,\n              operating system, date/time stamps, and clickstream data. We use\n              this information to analyze trends, administer the Service, track\n              users’ movements around the Service, and better tailor our\n              Services to match our users’ needs and improve their experience.\n              <br />\n              Cookies. Like many online services, we use cookies to collect\n              information. We may use both session Cookies (which expire once\n              you close your web browser) and persistent Cookies (which stay on\n              your computer until you delete them) to analyze how users interact\n              with our Service, make improvements to our product quality, and\n              provide users with a more personalized experience.\n              <br />\n              Pixel Tag. In addition, we use “Pixel Tags” (also referred to as\n              clear Gifs, Web beacons, or Web bugs). Pixel Tags allow us to\n              analyze how users find our Service, make the Service more useful\n              to you, and tailor your experience with us to meet your particular\n              interests and needs.\n              <br />\n              Analytics Services. In addition to the tracking technologies we\n              place like Cookies and Pixel Tags, other companies may set their\n              own cookies or similar tools when you visit our Service. This\n              includes third-party analytics services (“Analytics Services”)\n              that we engage to help analyze how users use the Service. The\n              information generated by the Cookies or other technologies about\n              your use of our Service (the “Analytics Information”) is\n              transmitted to the Analytics Services. The Analytics Services use\n              Analytics Information to compile reports on user activity, which\n              we may receive on an individual or aggregate basis. We use the\n              information we get from Analytics Services to improve our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected from Third-Parties</h5>\n            <p>\n              We may receive Personal and/or Anonymous Data about you from\n              companies that offer their products and/or services for use in\n              conjunction with our Service or whose products and/or services may\n              be linked from our Service. For example, third-party wallet\n              providers provide us with your blockchain address and certain\n              other information you choose to share with those wallets\n              providers. We may add this to the data we have already collected\n              from or about you through our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Information Collected from Public Blockchains</h5>\n            <p>\n              We may collect data from your activity that is publicly visible\n              and/or accessible on blockchains. This may include blockchain\n              addresses and information regarding purchases, sales, or transfers\n              of NFTs, which may then be associated with other data you have\n              provided to us.e have already collected from or about you through\n              our Service.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Use of Your Personal Data</h5>\n            <p>\n              When we collect your Personal Data from you, we will inform you at\n              the time as to the reason we are requesting such Personal Data.\n              The Company uses your Personal Data in any or all of the following\n              ways:\n            </p>\n            <ul>\n              <li> To facilitate you in the creation of your account.</li>\n              <li> Recognise you as a legitimate user of our platform.</li>\n              <li>\n                {\" \"}\n                Provide you with our Service, which includes helping you view,\n                explore, and create NFTs using our platform and, at your own\n                risk, connect with other users to purchase, sell NFTs on public\n                blockchains.\n              </li>\n              <li>\n                {\" \"}\n                Administration of our Service and quality of experience when you\n                interact with our platform.\n              </li>\n              <li> Provide customer support and respond to your queries.</li>\n              <li>\n                {\" \"}\n                Show your username next to the NFTs currently or previously\n                accessible in your third-party wallet, and next to NFTs on which\n                you have interacted.\n              </li>\n              <li>\n                {\" \"}\n                Send you notifications related to activity on the platform,\n                including notifications of offers on your NFTs.\n              </li>\n              <li>\n                {\" \"}\n                Send you newsletters, promotional materials, and other notices\n                related to our Services.\n              </li>\n              <li>\n                {\" \"}\n                To comply with applicable laws and cooperate with investigations\n                by law enforcement agencies.\n              </li>\n            </ul>\n          </div>\n          <div className=\"privacy-content\">\n            <h5>Disclosure of your Personal Data</h5>\n            <h6>\n              Third Party Service Providers:{\" \"}\n              <span>\n                We may share your Personal Data with third party service\n                providers.\n              </span>\n            </h6>\n            <h6>\n              Analytics:{\" \"}\n              <span>\n                We may share your data to be used by analytic platforms or other\n                such equivalent tools which make use of statistical information.\n              </span>\n            </h6>\n            <h6>\n              Legal Rights:{\" \"}\n              <span>\n                We may also share information as required by law, regulation,\n                legal process, or governmental request.\n              </span>\n            </h6>\n            <h6>\n              Other Disclosures:{\" \"}\n              <span>\n                We may also disclose your Personal Data: to fulfill the purpose\n                for which you provide it; for any other purpose disclosed by us\n                when you provide it; or with your consent.\n              </span>\n            </h6>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Third-Party Websites</h5>\n            <p>\n              Our platform may contain links to third-party websites. When you\n              click on a link to any other website or location, you will leave\n              our website and go to another site, and another entity may collect\n              Personal Data from you. We have no control over, do not review,\n              and cannot be responsible for these third-party websites or their\n              content. Please be aware that the terms of this Privacy Policy do\n              not apply to these third-party websites or their content, or to\n              any collection of your Personal Data after you click on links to\n              such third-party websites.\n              <br />\n              You may access other third-party services through the Site, for\n              example by clicking on links to those third-party services from\n              within the Site. We are not responsible for the privacy policies\n              and/or practices of these third-party services, and we encourage\n              you to carefully review their privacy policies.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Third-Party Wallets</h5>\n            <p>\n              To use the MintsClub NFT platform, you must use a third-party\n              wallet which allows you to engage in transactions on public\n              blockchains. Your interactions with any third-party wallet\n              provider are governed by the applicable terms of service and\n              privacy policy of the respective third party.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Security of Data</h5>\n            <p>\n              We care about the security of your data and use adequate physical,\n              administrative, and technological measures to maintain the\n              security of the data collected through our platform. Nonetheless,\n              no physical and logical security framework is perfect, and hence\n              no guarantee can be provided. In the unfortunate event where any\n              data is compromised as a result of a security breach, we will take\n              steps to investigate and remedy the situation at the earliest. We\n              will also notify any such individuals whose information may have\n              been compromised.\n              <br />\n              It is imperative that you understand the seriousness associated\n              with the security of your digital wallet, the responsibility of\n              which is yours. We insist that you take steps to ensure it and any\n              information related to your wallet remains secure at all times. If\n              you discover an issue related to your wallet, please contact your\n              wallet provider.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Data Storage and Retention</h5>\n            <p>\n              Your Personal Data may be retained for as long as you continue to\n              use our platform, have an account registered with us, or for as\n              long as it is necessary to fulfill the purposes mentioned in this\n              Privacy Policy. Personal Data may be retained even after your\n              account has been deactivated, if such retention is reasonably\n              necessary to comply with our legal obligations, to resolve\n              disputes, prevent fraud and abuse, enforce our Terms or other\n              agreements, and/or protect our legitimate interests. We will\n              delete any Personal Data where it is no longer required for\n              purposes mentioned in this privacy policy.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Your Rights</h5>\n            <p>\n              If you are a user belonging from the European Economic Area or\n              United Kingdom, or are a California resident, you have certain\n              rights under the respective European and UK General Data\n              Protection Regulations (“GDPR”) and the respective California\n              Consumer Privacy Act (“CCPA”).\n              <br />\n              ​Collectively, depending the situation you have the following data\n              protection rights:\n            </p>\n            <ul>\n              <li>\n                {\" \"}\n                The right to access, update or to delete the information we have\n                on you. Whenever made possible, you can access, update or\n                request deletion of your Personal Data.\n              </li>\n              <li>\n                {\" \"}\n                The right of rectification. You have the right to have your\n                information rectified if that information is inaccurate or\n                incomplete.\n              </li>\n              <li>\n                {\" \"}\n                The right of restriction. You have the right to request that we\n                restrict processing of your personal information.\n              </li>\n              <li>\n                {\" \"}\n                The right to erasure or right to be forgotten. If at any time\n                you do not agree with the collection or use of your personal\n                information as mentioned in this privacy policy and you want us\n                to delete your data.\n              </li>\n              <li>\n                {\" \"}\n                The right to data portability. You have the right to be given a\n                copy of the information we have on you in a structured,\n                machine-readable and commonly used format and have the right to\n                transmit that data to another controller on request.\n              </li>\n              <li>\n                {\" \"}\n                The right to withdraw consent. You may withdraw your consent to\n                the processing of data or information for the purposes as\n                mentioned in this privacy policy.\n              </li>\n              <li>\n                {\" \"}\n                The right to deactivate cookies. If you wish to restrict or\n                block all the cookies which are set by our websites, please use\n                the tool available on the particular website (if applicable), or\n                refer to the Help function within your browser to learn how to\n                manage your settings within your browser.\n              </li>\n            </ul>\n            <p>\n              In some situations we may not be able to enact upon your request,\n              if there is lawful reason or legal obligation that prevents us\n              from timely compliance with such request.\n              <br />\n              In order to exercise any of the above rights you may drop your\n              request with our chatbot.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Changes to Privacy Policy </h5>\n            <p>\n              MintsClub may make changes to this Privacy Policy at any time. We\n              insist all visitors and users to our website to frequently review\n              the Privacy Policy, to learn about the latest changes to our\n              privacy practices and other operational mechanisms. Any changes to\n              our privacy policy will be accompanied with a ‘last updated date’\n              for your convenience.\n              <br />\n              Your continued use of the Website or our platform’s services\n              indicates your acknowledgement and/or acceptance of any changes to\n              the updated Privacy Policy.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Privacy for Children</h5>\n            <p>\n              MintsClub does not target, and is not intended to attract, users\n              under the age of eighteen (18) years. We do not knowingly collect\n              Personal Data from users under the age of eighteen (18) years or\n              send requests to users under the age of eighteen (18) years for\n              Personal Data.\n            </p>\n          </div>\n          <div className=\"privacy-content mb-lg-5\">\n            <h5>Contact and Queries</h5>\n            <p>\n              If you have any questions or concerns regarding this Privacy\n              Policy or Mints.Club data collection or processing practices, or\n              if you want to report any security violations to us, drop your\n              queries with our chatbot.\n            </p>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n};\n\nexport default PrivacyPolicy;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/terms-conditions/termsConditions.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/connect-wallet/connect-wallet.tsx",["514","515"],"import React, { useState } from \"react\";\nimport Button from \"react-bootstrap/Button\";\nimport Container from \"react-bootstrap/Container\";\nimport Tab from \"react-bootstrap/Tab\";\nimport Tabs from \"react-bootstrap/Tabs\";\nimport \"./connect-wallet.css\";\nimport { connectModal } from \"../../assets/assets\";\n\nconst walletButtons = [\n  {\n    name: \"MetaMask\",\n    img: connectModal.metaImg,\n  },\n  {\n    name: \"Coinbase Wallet\",\n    img: connectModal.coinBaseImg,\n  },\n  {\n    name: \"WalletConnect\",\n    img: connectModal.wcImg,\n  },\n  {\n    name: \"Glow\",\n    img: connectModal.glowImg,\n  },\n  {\n    name: \"Phantom\",\n    img: connectModal.phantomImg,\n  },\n];\n\nexport default function connectWallet() {\n  return (\n    <>\n      <Container>\n        <div className=\"connect-wallet-container\">\n          <h3 className=\"modal-title\">Connect Your Wallet</h3>\n          <p className=\"modal-description\">\n            Select what network and wallet you want to connect\n          </p>\n          <div className=\"model-tabs\">\n            <Tabs defaultActiveKey=\"ethereum\" id=\"uncontrolled-tab-example\">\n              <Tab eventKey=\"ethereum\" title=\"Ethereum\">\n                <div className=\"tab-inner-content\">\n                  {walletButtons.map((button:any) => {\n                    return (\n                      <button className=\"wallet-button\">\n                        <img src={button.img} alt=\"services\" />\n                        {button.name}\n                      </button>\n                    );\n                  })}\n                </div>\n              </Tab>\n              <Tab eventKey=\"polygon\" title=\"Polygon\">\n                2\n              </Tab>\n              <Tab eventKey=\"cardano\" title=\"Cardano\">\n                3\n              </Tab>\n              <Tab eventKey=\"bsc\" title=\"BSC\">\n                3\n              </Tab>\n            </Tabs>\n            <button className=\"show-more-btn\">Show More</button>\n          </div>\n        </div>\n      </Container>\n    </>\n  );\n}\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/explore-collections/explore-collections.tsx",["516","517","518","519","520"],"import React, {\n  useState,\n  useEffect,\n  forwardRef,\n  useImperativeHandle,\n  FC,\n} from \"react\";\nimport \"./explore-collections.scss\";\nimport CollectionsCard from \"../../Components/CollectionsCards/CollectionsCard\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeCollection,\n  getCollections,\n  toggleLikeDislike,\n  beforeCategory,\n  getCategories,\n} from \"../collections/collections.actions\";\nimport { Images } from \"../../assets/assets\";\nimport FullPageLoader from \"../../Components/FullPageLoader/FullPageLoader\";\nimport OwnCollectionToday from \"../../Components/OwnCollectionToday/OwnCollectionToday\";\nimport Banner from \"../../Components/Banner/Banner\";\nimport BannerBg from \"../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../assets/images/bannerimg.png\";\nimport { exploreCollectionBanner } from \"../../utils/exportData\";\nimport { ExploreCollectionInt } from \"../../interfaces/ExploreCollections/interface\";\nconst ExploreCollections: FC<ExploreCollectionInt> = (props) => {\n  const [isActive, setIsActive] = useState(\"All\");\n  const [collections, setCollections] = useState<any[] | null>(null);\n  const [categoriesLoader, setCatLoader] = useState(true);\n  const [collectionsLoader, setColLoader] = useState(true);\n  const [page, setPage] = useState(1);\n  const [limit, setLimit] = useState(10);\n  const [selectedCategory, setSelectedCategory] = useState(\"\");\n  const [categories, setCategories] = useState<any[] | null>(null);\n  const [empty, setEmpty] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [pagination, setPagination] = useState<any>(null);\n\n  useEffect(() => {\n    window.scroll(0, 0);\n\n    if (props.setLoader) props.setLoader(false);\n\n    getCollections(null, 1, null);\n    props.getCategories();\n  }, []);\n\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collections, pagination } = props.collection;\n      setPagination(pagination);\n      const userId = ENV.getUserKeys(\"_id\")._id;\n      if (props.mycollections) {\n        let myCollections = collections.filter(\n          (item: any) => item.userId === userId\n        );\n        setCollections(myCollections);\n      } else {\n        if (collections === null) {\n          setEmpty(true);\n        } else {\n          setEmpty(false);\n        }\n        setCollections(collections);\n\n        setColLoader(false);\n        setLoader(false);\n      }\n      props.beforeCollection();\n    }\n  }, [props.collection.getAuth]);\n\n  useEffect(() => {\n    if (props.collection.collectionFlag) {\n      setCategories(props.collection.categories);\n\n      props.beforeCategory();\n      setCatLoader(false);\n    }\n  }, [props.collection.collectionFlag]);\n\n  const getCollections = (\n    category: string | null,\n    page: number | null,\n    pageLimit: number | null\n  ) => {\n    const filter: any = {\n      page,\n    };\n\n    if (props.userId) filter.userId = props.userId;\n    if (props.popular) filter.popular = true;\n    if (category) filter.myFilter = category;\n    if (!props.all) filter.limit = pageLimit ? pageLimit : 10;\n    else filter.all = true;\n\n    const qs = ENV.objectToQueryString(filter);\n\n    props.getCollections(qs);\n  };\n\n  // useImperativeHandle(ref, () => ({\n  //   getCatCollections: (catId:string) => {\n  //     if (props.setLoader) props.setLoader(true);\n\n  //     getCollections(catId, page);\n  //   },\n  //   colCount: collections?.length || 0,\n  // }));\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    setPage(page);\n    setLimit(limit + 10);\n    getCollections(selectedCategory, page, limit + 10);\n  };\n  const handleFilterCategory = (category: string) => {\n    setLoader(true);\n    setPage(1);\n    setLimit(10);\n    getCollections(category, 1, 10);\n  };\n\n  const handleImage = (item: any, index: number) => {\n    if (item?.nftDetail[index]?.image) {\n      let result = item.nftDetail.filter(\n        (nft: any) => nft.fileType === \"image\"\n      );\n      if (result.length >= index && result.length !== 0) {\n        return result[index]?.image;\n      } else {\n        return Images.imagePlaceholder;\n      }\n    } else {\n      return Images.imagePlaceholder;\n    }\n  };\n\n  return (\n    <>\n      {categoriesLoader && collectionsLoader ? (\n        <FullPageLoader />\n      ) : (\n        <section className=\"explore-collection-section padding-wrapper pt-0\">\n          <Banner\n            subHeading={exploreCollectionBanner.subHeading}\n            heading={exploreCollectionBanner.heading}\n            content={exploreCollectionBanner.content}\n            bgImg={BannerBg}\n            bannerImg={BannerImage}\n          />\n          <div className=\"container\">\n            <div className=\"row mb-5\">\n              <div className=\"col-12 explore-collection-nav\">\n                <div className=\"d-none d-xxl-flex justify-content-lg-end text-end align-items-center\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item: any, index: number) => {\n                      return (\n                        <button\n                          key={index}\n                          onClick={() => {\n                            setIsActive(item.name);\n                            setSelectedCategory(item.description);\n                            handleFilterCategory(item.description);\n                          }}\n                          className={`${\n                            item.name === isActive ? \"active-explore-nav\" : \"\"\n                          } me-2 me-xl-3`}\n                        >\n                          {item.name}\n                        </button>\n                      );\n                    })}\n                </div>\n                <div className=\"row justify-content-center justify-content-sm-start align-items-center text-center d-xxl-none\">\n                  {categories &&\n                    categories.length > 0 &&\n                    categories.map((item: any, index: any) => {\n                      return (\n                        <div className=\"col-6 col-sm-3\" key={index}>\n                          <button\n                            onClick={() => {\n                              setIsActive(item.name);\n                              setSelectedCategory(item.description);\n                              handleFilterCategory(item.description);\n                            }}\n                            className={\n                              isActive === item.name ? \"active-explore-nav\" : \"\"\n                            }\n                          >\n                            {item.name}\n                          </button>\n                        </div>\n                      );\n                    })}\n                </div>\n              </div>\n            </div>\n            <div className=\"row g-1 align-items-center justify-content-center\">\n              {loader ? (\n                <div className=\"spinner-border\" role=\"status\">\n                  <span className=\"sr-only\">Loading...</span>\n                </div>\n              ) : collections && collections.length > 0 ? (\n                collections.map((collection: any, index: number) => {\n                  return (\n                    <div className=\"col-sm-6 col-md-4 col-xl-3\" key={index}>\n                      <CollectionsCard\n                        CardImg={collection.featuredImg}\n                        Subimg1={handleImage(collection, 0)}\n                        Subimg2={handleImage(collection, 1)}\n                        Subimg3={handleImage(collection, 2)}\n                        name={collection.name}\n                        id={collection._id}\n                        collection={collection}\n                        userName={\n                          collection?.username[0] ? collection.username[0] : \"\"\n                        }\n                        NFTCount={\n                          collection.nftDetail[0].image\n                            ? collection.nftDetail?.length\n                            : 0\n                        }\n                        profileImage={collection?.profileImage[0]}\n                        ownerAddress={collection?.ownerAddress}\n                        connectedAddress={props.connectedAddress}\n                      />\n                    </div>\n                  );\n                })\n              ) : (\n                <p className=\"text-center not-found-title mt-5\">\n                  No Collections found\n                </p>\n              )}\n              <div className=\"col-12\">\n                <div className=\"mt-5 d-flex justify-content-center align-items-center\">\n                  {!empty &&\n                    collections?.length === 10 &&\n                    !loader &&\n                    pagination.totalRecords > collections.length && (\n                      <button\n                        className=\"btn btn-rounded-bordered px-5\"\n                        onClick={() => handlePagination()}\n                      >\n                        Load more...\n                      </button>\n                    )}\n                </div>\n              </div>\n            </div>\n          </div>\n          <OwnCollectionToday />\n        </section>\n      )}\n    </>\n  );\n};\nconst mapStateToProps = (state: any) => ({\n  collection: state.collection,\n  error: state.error,\n  category: state.category,\n  categories: state.collection,\n  pagination: state.pagination,\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollections,\n  beforeCategory,\n  getCategories,\n  toggleLikeDislike,\n})(ExploreCollections);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/popular-collections-list/popular-collections-list.tsx",["521","522","523"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collection-details/collectiondetails.tsx",["524","525","526"],"import { useState, useEffect, FC } from \"react\";\nimport { useLocation, useHistory } from \"react-router-dom\";\nimport \"./collectiondetails.css\";\nimport TickIcon from \"../../assets/images/seller-tick-icon.svg\";\nimport { connect } from \"react-redux\";\nimport { ENV } from \"../../config/config\";\nimport { validateNetwork } from \"../../utils/web3\";\nimport Listing from \"../../Components/Listing/Listing\";\nimport { toast } from \"react-toastify\";\nimport Banner from \"../../Components/Banner/Banner\";\nimport BannerBg from \"../../assets/images/profileBg.png\";\nimport { Images } from \"../../assets/assets\";\nimport OwnCollectionToday from \"../../Components/OwnCollectionToday/OwnCollectionToday\";\nimport { CollectionDetailInt } from \"../../interfaces/CollectionDetail/interface\";\nimport {\n  useGetMyLikedNFTs,\n  useGetNFTs,\n  useLikeDislike,\n} from \"../../hooks/CollectionDetails\";\n\nconst CollectionDetailsPage: FC<CollectionDetailInt> = (props) => {\n  const [nfts, setNfts] = useState<any>(null);\n  const [filterationLoader, setFilterationLoader] = useState<boolean>(true);\n  const [likedNfts, setLikedNfts] = useState<Array<any> | null>(null);\n  const [likeButtonDisable, setLikeBtnDisable] = useState<boolean | null>(null);\n  const [nftPagination, setNFTPagination] = useState<object | null>(null);\n  const [disabled, setDisabled] = useState(false);\n  const location: any = useLocation();\n  const [filter, setFilter] = useState<any>({collectionId:location.state.id});\n  const history = useHistory();\n\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  ////Get My liked NFTs\n  const onSuccessLikedNFTs = (data: any) => {\n    setLikedNfts(data.data.data);\n  };\n  const {} = useGetMyLikedNFTs(\n    ENV.objectToQueryString({ userId: ENV.getUserKeys(\"_id\")._id }),\n    onSuccessLikedNFTs\n  );\n\n  //Get NFTs\n\n  const onSuccessNFTs = (data: any) => {\n    setFilterationLoader(false);\n    setNFTPagination(data.data.data.pagination);\n    setNfts(data.data.data.nfts);\n  };\n\n  const { isLoading: isLoadingNFTs } = useGetNFTs(\n    filter,\n    onSuccessNFTs,\n  );\n\n  const onSuccessLikeDislike = () => {\n    setLikeBtnDisable(false);\n  };\n\n  //Like/Dislike\n  const { mutate } =\n    useLikeDislike(onSuccessLikeDislike);\n\n\n\n  ///////////Likes\n  const handleLikesTogleApi = async (\n    nftId: string,\n    status: string,\n    likesCount: number\n  ) => {\n    if (ENV.getUserKeys(\"_id\")?._id) {\n      if (await validateNetwork()) {\n        if (!likeButtonDisable) {\n          setLikeBtnDisable(true);\n          let userId = ENV.getUserKeys(\"_id\")._id;\n          let body = {\n            userId,\n            nftId,\n            count: 1,\n          };\n\n          if (status === \"dislike\" && likesCount > 0) {\n            let result = likedNfts?.filter((item) => item.nftId !== nftId);\n            if (result) {\n              setLikedNfts(result);\n            }\n            increOrDecreLikes(nftId, \"dec\");\n            mutate(body);\n          }\n\n          if (status === \"like\") {\n            let myLikedNfts = [];\n            if (likedNfts && likedNfts.length > 0) {\n              myLikedNfts = likedNfts;\n            }\n\n            let obj = {\n              _id: \"1234455\",\n              nftId,\n            };\n\n            myLikedNfts.push(obj);\n\n            setLikedNfts(myLikedNfts);\n            increOrDecreLikes(nftId, \"inc\");\n            mutate(body);\n          }\n          // setNFTs(nfts);\n        }\n      } else {\n        toast.error(\n          \"Please Connect Your Metamask With Ethereum Rinkby Network\"\n        );\n      }\n    } else {\n      history.push(\"/login\");\n    }\n  };\n\n  const increOrDecreLikes = (id: string, status: string) => {\n    if (status === \"dec\") {\n      let newResult = nfts?.map((item: any) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNfts(newResult);\n    } else {\n      let final = nfts?.map((item: any) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNfts(final);\n    }\n  };\n\n  const fetchData = (filterObj: object) => {\n    setFilter(filterObj);\n  };\n  const { name, logo, description, username }: any = location.state;\n\n  const bannerData = {\n    subHeading: \"Nfts\",\n    heading: \"Collections Info\",\n  };\n\n  return (\n    <>\n      <section className=\"user-profile pt-0\">\n        <Banner\n          subHeading={bannerData.subHeading}\n          heading={bannerData.heading}\n          bgImg={BannerBg}\n        />\n        <div className=\"collection-detail-content\">\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"d-flex flex-column flex-md-row align-items-center align-items-sm-start\">\n                  <div className=\"ms-lg-5 collection-owner-avatar user-avatar-container me-3 flex-fill\">\n                    <img\n                      src={logo ? logo : Images.profilePlaceholder}\n                      alt=\"owner-avatar\"\n                    />\n                  </div>\n                  <div className=\"collection-owner-detail text-center text-sm-start mt-2 mt-sm-4\">\n                    <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n                      <div className=\"collection-owner-name\">\n                        <h3>\n                          {name}{\" \"}\n                          <span>\n                            <img\n                              src={TickIcon}\n                              alt=\"tick-icon\"\n                              className=\"ms-2\"\n                            />\n                          </span>\n                        </h3>\n                      </div>\n                      {username?.[0] && (\n                        <div>\n                          <p>\n                            Created By: <span>{username?.[0]}</span>\n                          </p>\n                        </div>\n                      )}\n                    </div>\n                    <div className=\"collection-owner-description mt-3\">\n                      <p>{description && description} </p>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-7 col-md-6 col-lg-5\"></div>\n            </div>\n          </div>\n        </div>\n        <Listing\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={isLoadingNFTs}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          path=\"/explore/nftdetail/\"\n          collectionDetail\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\nconst mapStateToProps = (state: any) => ({\n  nft: state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, {})(CollectionDetailsPage);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/all-nfts/allnft.tsx",["527","528","529","530","531"],"import { useState, useEffect, FC } from \"react\";\nimport { connect } from \"react-redux\";\nimport \"./allnft.css\";\nimport {\n  beforeNFT,\n  getNFTs,\n  getMyLikedNfts,\n} from \"../../../Components/Nfts/nfts.action\";\nimport { ENV } from \"../../../config/config\";\nimport { getCreators, beforeUser } from \"../../../Components/User/user.action\";\nimport { toggleLikeDislike, beforeTogleLikeDislike } from \"../explore.action\";\nimport {\n  beforeCollection,\n  getCollections,\n} from \"../../collections/collections.actions\";\nimport { validateNetwork } from \"../../../utils/web3\";\nimport { toast } from \"react-toastify\";\nimport Listing from \"../../../Components/Listing/Listing\";\nimport Banner from \"../../../Components/Banner/Banner\";\nimport BannerBg from \"../../../assets/images/hero-bg.png\";\nimport BannerImage from \"../../../assets/images/bannerimg.png\";\nimport OwnCollectionToday from \"../../../Components/OwnCollectionToday/OwnCollectionToday\";\nimport { useHistory } from \"react-router-dom\";\nimport { AllNFTsbBanner } from \"../../../utils/exportData\";\nimport { ALLNFTINT } from \"../../../interfaces/allnfts/interface\";\nimport {\n  useGetMyLikedNFTs,\n  useGetNFTs,\n  useLikeDislike,\n} from \"../../../hooks/CollectionDetails\";\nimport {useGetCollections} from \"../../../hooks/AllNFTs\";\n\n\nconst AllNFT: FC<ALLNFTINT> = (props) => {\n  const [nftPagination, setNFTPagination] = useState<any>(null);\n  const [nfts, setNFTs] = useState<any>([]); // NFTs for explore section\n  const [collections, setCollections] = useState<Array<object>>([]);\n  const [filterationLoader, setFilterationLoader] = useState(true);\n  const [likedNfts, setLikedNfts] = useState<any>(null);\n  const [likeButtonDisable, setLikeBtnDisable] = useState<boolean | null>(null);\n  const [disabled, setDisabled] = useState(false);\n  const [filter, setFilter] = useState<any>({ limit: 10, page: 1 });\n  const history = useHistory();\n\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  useEffect(() => {\n    props.getCollections();\n    if (props?.location?.state) {\n      let searchQs: object | string = {\n        keyword: props.location.state,\n        page: 1,\n        limit: 10,\n      };\n      setFilter(searchQs);\n      setFilterationLoader(true);\n      window.history.replaceState(null, \"\");\n\n    } \n\n  }, []);\n\n  ////Get My liked NFTs\n  const onSuccessLikedNFTs = (data: any) => {\n    setLikedNfts(data.data.data);\n  };\n  const {} = useGetMyLikedNFTs(\n    ENV.objectToQueryString({ userId: ENV.getUserKeys(\"_id\")._id }),\n    onSuccessLikedNFTs\n  );\n\n  //Get NFTs\n\n  const onSuccessNFTs = (data: any) => {\n    setFilterationLoader(false);\n    setNFTPagination(data.data.data.pagination);\n    setNFTs(data.data.data.nfts);\n  };\n\n  const { isLoading: isLoadingNFTs } = useGetNFTs(filter, onSuccessNFTs);\n\n  const onSuccessLikeDislike = () => {\n    setLikeBtnDisable(false);\n  };\n\n  //Like/Dislike\n  const { mutate } = useLikeDislike(onSuccessLikeDislike);\n  const fetchData = (filterObj: object | null) => {\n    setFilter(filterObj);\n    // getNFTs(filterObj);\n  };\n\n  //Get Collections\n  const onSuccessCollections=(data:any)=>{\n    setCollections(data.data.data.collections);\n\n  }\n  const{isLoading}=useGetCollections(onSuccessCollections)\n\n  const handleLikesTogleApi = async (\n    nftId: string,\n    status: string,\n    likesCount: number\n  ) => {\n    if (\n      ENV.getUserKeys(\"address\")?.address?.toUpperCase() ===\n      props.connectedAddress?.toUpperCase()\n    ) {\n      if (await validateNetwork()) {\n        if (!likeButtonDisable || likeButtonDisable === null) {\n          setLikeBtnDisable(true);\n          let userId = ENV.getUserKeys(\"_id\")._id;\n\n          let body = {\n            userId,\n            nftId,\n            count: 1,\n          };\n\n          if (status === \"dislike\" && likesCount > 0) {\n            let result = likedNfts.filter((item: any) => item.nftId !== nftId);\n\n            setLikedNfts(result);\n            increOrDecreLikes(nftId, \"dec\");\n\n            mutate(body);\n          }\n\n          if (status === \"like\") {\n            let myLikedNfts: any = [];\n            if (likedNfts && likedNfts.length > 0) {\n              myLikedNfts = likedNfts;\n            }\n\n            let obj = {\n              _id: \"1234455\",\n              nftId,\n            };\n\n            myLikedNfts.push(obj);\n\n            setLikedNfts(myLikedNfts);\n            increOrDecreLikes(nftId, \"inc\");\n            mutate(body);\n          }\n          // setNFTs(nfts);\n        }\n      } else {\n        toast.error(\n          \"Please Connect Your Metamask With Ethereum Rinkby Network\"\n        );\n      }\n    } else {\n      if (ENV.getUserKeys(\"address\")?.address) {\n        toast.info(\"Please login with new connected account\");\n      } else {\n        toast.info(\"Please login first to continue\");\n      }\n      history.push(\"/login\");\n    }\n  };\n  const increOrDecreLikes = (id: string, status: string) => {\n    if (status === \"dec\") {\n      let newResult = nfts.map((item: any) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          if (item?.likeCount > 0) {\n            return { ...item, likeCount: item.likeCount - 1 };\n          }\n        }\n      });\n      setNFTs(newResult);\n    } else {\n      let final = nfts.map((item: any) => {\n        if (item._id !== id) {\n          return item;\n        } else {\n          return { ...item, likeCount: item.likeCount + 1 };\n        }\n      });\n      setNFTs(final);\n    }\n  };\n  return (\n    <>\n      <section className=\"explore-collection-section padding-wrapper pt-0\">\n        <Banner\n          subHeading={AllNFTsbBanner.subHeading}\n          heading={AllNFTsbBanner.heading}\n          content={AllNFTsbBanner.content}\n          bgImg={BannerBg}\n          bannerImg={BannerImage}\n        />\n        <Listing\n          collections={collections}\n          disabled={disabled}\n          totalItems={nfts && nfts.length}\n          filterationLoader={filterationLoader}\n          setFilterationLoader={setFilterationLoader}\n          nfts={nfts}\n          loader={isLoadingNFTs}\n          likedNfts={likedNfts}\n          nftPagination={nftPagination}\n          handleLikesTogleApi={handleLikesTogleApi}\n          fetchData={fetchData}\n          initialKeyword={props?.location?.state}\n          path=\"/explore/nftdetail/\"\n        />\n      </section>\n      <OwnCollectionToday />\n    </>\n  );\n};\nconst mapStateToProps = (state: any) => ({\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {\n  beforeNFT,\n  getNFTs,\n  getCreators,\n  toggleLikeDislike,\n  getCollections,\n  getMyLikedNfts,\n  beforeCollection,\n  beforeUser,\n  beforeTogleLikeDislike,\n})(AllNFT);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/darkmode/DarkModeContext.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/context/errorHandler/ErrorHandlerContext.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/create-nft.tsx",["532","533","534","535"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/sell-nft/SellNFT.tsx",["536","537","538","539","540","541","542","543","544","545","546","547","548","549","550","551","552","553"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/nft-detail/nftdetail.tsx",["554","555","556","557","558","559","560","561","562","563","564","565","566","567","568","569","570","571","572","573","574","575","576","577","578","579","580","581","582","583"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/user-profile/UserProfile.tsx",["584","585","586","587","588","589","590","591","592","593","594"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-collections/CreateCollections.tsx",["595","596","597","598","599","600","601","602","603","604","605","606"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/user-edit-profile/user-edit-profile.tsx",["607","608","609","610","611","612","613","614","615","616","617"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout/layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/layouts/home-layout/home-layout.jsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/collections.actions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/User/user.action.js",["618","619"],"import { toast } from 'react-toastify';\nimport { ENV } from '../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../../pages/collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        toast.success(data.message);\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });     \n      }\n    })\n    .catch((errors) => {\n      // console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n  \n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n   \n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n   \n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n        \n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n     \n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/assets/assets.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/web3.js",["620"],"import Web3 from \"web3\";\nimport { toast } from \"react-toastify\";\n\nimport { ENV } from \"./../config/config\";\nimport abi from \"./abis/v2-abi.json\";\nconst mintsClubContractAddress = ENV.mintsClubContractAddress;\n\nlet requiredChainId = parseInt(process.env.REACT_APP_REQUIRED_CHAIN);\n\n/////////////////////////////////////////////////////////////////////////////MintsClub market start /////////////////////////\n\nconst getWeb3 = async () => {\n  let instance;\n  if (window.ethereum) {\n    await window.web3.currentProvider.enable();\n    instance = new Web3(window.web3.currentProvider);\n  } else {\n    instance = new Web3(\"http://localhost:7545\");\n  }\n\n  return instance;\n};\n\nconst getContractMethods = async () => {\n  let web3 = await getWeb3();\n  const contractM = new web3.eth.Contract(abi, mintsClubContractAddress);\n  return contractM;\n};\nconst getNetworkName = (chainId) => {\n  let networks = {\n    1: \"Ethereum Mainnet\",\n    4: \"Ethereum Rinkby\",\n    3: \"Ethereum Ropsten\",\n    42: \"Ethereum Kovan\",\n    5: \"Ethereum Goerli\",\n  };\n  return networks[chainId];\n};\n\nexport const getNetworkNameByChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    let currentNetwork = getNetworkName(chainId);\n    return currentNetwork;\n  }\n};\nexport const getChainId = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let chainId = await web3.eth.getChainId();\n    return chainId;\n  }\n};\nexport const validateNetwork = async () => {\n  let prevNetwork = await getNetworkNameByChainId();\n\n  if (prevNetwork === \"Ethereum Rinkby\") {\n    return true;\n  } else {\n    return false;\n  }\n};\nexport const getBalance = async () => {\n  let web3 = await getWeb3();\n  let address = await getWalletAddress();\n  let balance = await web3.eth.getBalance(address);\n  let ethBalance = web3.utils.fromWei(balance, \"ether\");\n\n  return ethBalance;\n};\n\nexport const mintNFt = async (metaData, amount) => {\n  let web3 = await getWeb3();\n\n  if (!web3) {\n    toast.error(\"No web3 instance found\");\n    return false;\n  }\n\n  const nftAmount = Number(amount);\n\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let result = await contractM.methods\n      .mint(connectedAddress, nftAmount, metaData)\n      .send({ from: connectedAddress });\n\n    return result;\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const openNFTForBidding = async (\n  biddingTime,\n  startTime,\n  tokenId,\n  copies\n) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let id = Number(tokenId);\n    const result = await contractM.methods\n      .startAuction(biddingTime, startTime, connectedAddress, id, copies)\n      .send({ from: connectedAddress });\n    let web3 = await getWeb3();\n    let sellId = await web3.utils.hexToNumber(result.events[0].raw.data);\n    if (sellId) {\n      return sellId;\n    }\n  } catch (err) {\n    throw new Error(err);\n  }\n};\n\nexport const placeABid = async (amount, tokenId) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const bidAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n    // let bidAmount = Number(amount) * 1000000000000000000;\n    console.log(bidAmount, \"bidAmount\");\n    let id = Number(tokenId);\n    let web3 = await getWeb3();\n\n    const result = await contractM.methods\n      .bid(id)\n      .send({\n        from: connectedAddress,\n        value: bidAmount,\n        gasPrice: web3.utils.toHex(web3.utils.toWei(\"10\", \"gwei\")),\n      });\n\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    console.log(err,\"error while bidding\")\n    if (err?.message) {\n      toast.error(err.message);\n    } else {\n      toast.error(\"Transaction Failed ,Please check wallet history\");\n    }\n    throw new Error(err);\n  }\n};\n\nexport const putonsale = async (tokenId, amount, price) => {\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    let weiAmount = BigInt(Web3.utils.toWei(price, \"ether\"));\n    let web3 = await getWeb3();\n    let id = Number(tokenId);\n    const result = await contractM.methods\n      .putonsale(id, amount, weiAmount)\n      .send({\n        from: connectedAddress,\n        gasPrice: web3.utils.toHex(web3.utils.toWei(\"10\", \"gwei\")),\n      });\n    let sellId = await web3.utils.hexToNumber(result.events[0].raw.data);\n    if (sellId) {\n      return sellId;\n    }\n  } catch (err) {\n    // console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const BuyFixedPriceNFT = async (\n  amount,\n  tokenId,\n  setConfirmed,\n  setTransactionHash\n) => {\n  setConfirmed(\"pending\");\n  try {\n    /* global BigInt */\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n\n    const weiAmount = Number(BigInt(Web3.utils.toWei(`${amount}`, \"ether\")));\n\n    const result = await contractM.methods\n      .BuyFixedPriceNFT(tokenId)\n      .send({ from: connectedAddress, value: weiAmount, gas: 5000000 })\n      .on(\"transactionHash\", function (hash) {\n        setTransactionHash(hash);\n        setConfirmed(true);\n      })\n      .on(\"confirmation\", function (confirmationNumber, receipt) {});\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    setConfirmed(false);\n    // console.log(err);\n\n    throw new Error(err);\n  }\n};\nexport const setApprovalForAll = async (setApprovalStatus) => {\n  try {\n    let connectedAddress = await connectMetamask();\n    const contractM = await getContractMethods();\n    const result = await contractM.methods\n      .setApprovalForAll(ENV.mintsClubContractAddress, true)\n      .send({\n        from: connectedAddress,\n      })\n      .on(\"transactionHash\", function (hash) {\n        // setTransactionHash(hash);\n        setApprovalStatus(\"in-progress\");\n      });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    toast.error(err.message);\n    throw new Error(err);\n  }\n};\n\nexport const claimNFTfromContract = async (tokenId) => {\n  try {\n    let web3 = await getWeb3();\n    let connectedAddress = await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.claimNft(tokenId).send({\n      from: connectedAddress,\n      gasPrice: web3.utils.toHex(web3.utils.toWei(\"10\", \"gwei\")),\n\n    });\n    if (result) {\n      return result;\n    }\n  } catch (err) {\n    // console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\nexport const endAuctionFromContract = async (tokenId) => {\n  try {\n    let web3 = await getWeb3();\n    let connectedAddress = await getMetamaskConnectedAddress();\n    const contractM = await getContractMethods();\n    const result = contractM.methods.auctionEnd(tokenId).send({\n      from: connectedAddress,\n      gasPrice: web3.utils.toHex(web3.utils.toWei(\"10\", \"gwei\")),\n    });\n    if (result) {\n      // console.log(result, \"result\");\n      return result;\n    }\n  } catch (err) {\n    // console.log(err, \"error\");\n    throw new Error(err);\n  }\n};\n\nexport const getMetamaskConnectedAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\n\n// export const acceptOffer= async (amount,tokenId)=>{\n//   try{\n\n//     let connectedAddress = await connectMetamask();\n//       const contractM = await getContractMethods();\n//       let weiAmount = Number(amount) * 1000000000000000000;\n//       let id=Number(tokenId)\n//       const result = await contractM.methods\n//       .BuyFixedPriceNFT(id,weiAmount)\n//       .send({ from: connectedAddress});\n//       if(result){\n//         return result\n//       }\n//   }catch(err){\n//     throw new Error(err);\n//   }\n// }\n\nexport const getCurrentAddress = async () => {\n  let web3 = await getWeb3();\n  let accounts = await web3.eth.getAccounts();\n  let address = accounts[0];\n  return address;\n};\n//////////////////////////////////////////////////////////////////////////////////ariswap functions start///////////////////////////\n\nexport const connectMetamaskCopy = async (address) => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n\n    let currentNetwork = getNetworkName(chainId);\n    if (!currentNetwork) {\n      // toast.error(\"Please Connect your metamask with Ethereum Network\");\n      return false;\n    }\n    if (chainId !== requiredChainId) {\n    }\n\n    if (accounts[0]) {\n      if (accounts[0] === address) {\n        toast.success(\"wallet is already connected\");\n      } else {\n        // toast.success(\"wallet connected\");\n      }\n\n      return accounts[0];\n    } else {\n      let address = await signRequest();\n\n      // toast.success(\"wallet connected\");\n      return address[0];\n    }\n  } else {\n    toast.error(\"This app requires metamask,Please Install Metamask \");\n  }\n};\nexport const getWalletAddress = async () => {\n  let web3 = await getWeb3();\n\n  let accounts = await web3.eth.getAccounts();\n  return accounts[0];\n};\nexport const connectMetamask = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n    let accounts = await web3.eth.getAccounts();\n    let chainId = await web3.eth.getChainId();\n    if (chainId !== requiredChainId) {\n    }\n    return accounts[0];\n  } else {\n    toast.error(\"Please install metamask to connect to the Marketplace\");\n  }\n};\nexport const connectWithMetamask = async () => {\n  try {\n    let web3 = await getWeb3();\n    await window.ethereum.request({\n      method: \"wallet_requestPermissions\",\n      params: [\n        {\n          eth_accounts: {},\n        },\n      ],\n    });\n    let accounts = await web3.eth.getAccounts();\n    return accounts[0];\n  } catch (err) {\n    toast.error(err.message);\n  }\n};\n\nexport const switchNetworkToChainId = async (id) => {\n  if (window.ethereum) {\n    try {\n      let web3 = await getWeb3();\n      await web3.currentProvider.request({\n        method: \"wallet_switchEthereumChain\",\n        params: [{ chainId: Web3.utils.toHex(4) }],\n      });\n      let accounts = await web3.eth.getAccounts();\n      return accounts[0];\n    } catch (err) {\n      toast.error(err.message);\n      throw new Error(err);\n    }\n  }\n};\nexport const signRequest = async () => {\n  if (window.ethereum) {\n    let web3 = await getWeb3();\n\n    let accounts = await web3.eth.getAccounts();\n    let address = accounts[0];\n    let signature = await handleSignMessage(address);\n    return signature;\n  } else {\n    alert(\"Please install metamask to connect to the Marketplace\");\n  }\n};\n\n\n\nconst handleSignMessage = (address) => {\n  return new Promise((resolve, reject) => {\n    try {\n      const web3 = new Web3(Web3.givenProvider);\n      web3.eth.personal.sign(\n        web3.utils.fromUtf8(\n          `${ENV.appName} uses this cryptographic signature in place of a password, verifying that you are the owner of this address.`\n        ),\n        address,\n        (err, signature) => {\n          if (err) return reject(err);\n          return resolve(signature);\n        }\n      );\n    } catch (e) {\n      // console.log(e);\n    }\n  });\n};\n\n\n\n\n\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Banner/Banner.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/exportData.js",["621"],"import nft1 from \"../assets/images/famous1.jpeg\";\nimport nft2 from \"../assets/images/famous2.webp\";\nimport nft3 from \"../assets/images/famous3.jpg\";\nimport nft4 from \"../assets/images/famous4.jpg\";\nimport nft5 from \"../assets/images/famous5.png\";\nimport nft6 from \"../assets/images/famous6.jpeg\";\nimport nft7 from \"../assets/images/famous7.jpeg\";\nimport { aboutusImages } from \"../assets/assets\";\n\nimport {\n  AiFillHeart,\n  BsTagFill,\n  GrTransaction,\n  MdShoppingCart,\n} from \"react-icons/all\";\nexport const WordsFamousNfts = [\n  {\n    img: nft3,\n  },\n  {\n    img: nft2,\n  },\n  {\n    img: nft1,\n  },\n  { img: nft4 },\n  { img: nft5 },\n  { img: nft6 },\n  { img: nft7 },\n];\n\nexport const iconByActivity = {\n  minted: <MdShoppingCart />,\n  transfer: <GrTransaction />,\n  list: <BsTagFill />,\n};\n////About Us/////\n\nexport const aboutUsBanner = {\n  subHeading: \"Who we are\",\n  heading: \"Company Profile\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nexport const services = [\n  {\n    name: \"Blockchain Consultancy\",\n    img: aboutusImages.consultancy,\n  },\n  {\n    name: \"Token Development\",\n    img: aboutusImages.development,\n  },\n  {\n    name: \"NFT Marketplace\",\n    img: aboutusImages.marketplace,\n  },\n  {\n    name: \"DApp Development\",\n    img: aboutusImages.dapp,\n  },\n  {\n    name: \"DeFi Development\",\n    img: aboutusImages.defi,\n  },\n  {\n    name: \"Crypto Exchange Development\",\n    img: aboutusImages.crypto,\n  },\n];\n\nexport const comingSoon = [\n  {\n    name: \"Binance\",\n    img: aboutusImages.binance,\n  },\n  {\n    name: \"Cardano\",\n    img: aboutusImages.cardano,\n  },\n  {\n    name: \"Solana\",\n    img: aboutusImages.solana,\n  },\n  {\n    name: \"Algorand\",\n    img: aboutusImages.algoran,\n  },\n];\n\nexport const getBannerData=(subHeading,heading)=>{\n return  {\n    subHeading: subHeading,\n    heading: heading,\n    content:\n      \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n  };\n}\n//All NFTs\nexport const AllNFTsbBanner = {\n  subHeading: \"Explore\",\n  heading: \"All NFTs\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//Explore Collections\nexport const exploreCollectionBanner = {\n  subHeading: \"Collections\",\n  heading: \"Explore all\",\n  content:\n    \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//Create NFT\nexport const createNFTbanner = {\n  subHeading: \"Get Started\",\n  heading: \"Create NFT\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//Faqs\nexport const faqsBanner = {\n  subHeading: \"Ask\",\n  heading: \"FAQ\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\nexport const faqsData = [\n  {\n    question: \"What is MintsClub?\",\n    ans: \"MintsClub is a revolutionary 21st Century blockchain product that brings users one step closer to experiencing Metaverse. The users can mint their digital assets such as images, GIFs, games, sports accessories and more into the cryptomarket and establish a stable revenue stream.\",\n  },\n  {\n    question: \"What is a MintsClub token?\",\n    ans: \"MintsClub token, famously known as Non-fungible Token (NFT) is a distinct cryptographic token that exists on the blockchain platform and cannot be replicated. Tokenization of digital assets has made it easier to buy and sell while reducing the threat of fraudulent acts.\",\n  },\n  {\n    question: \"What is the total supply of MINT?\",\n    ans: \"The total supply of 1-inch Mint tokens is 1.5 billion.\",\n  },\n  {\n    question: \"Where can I buy/sell MINT?\",\n    ans: \"You can sell your NFTs on blockchain marketplaces such as Binance, Cardano, Solana and Algoran and now, MintsClub.\",\n  },\n];\n\n//NFT Data\nexport const nftBanner = {\n  subHeading: \"NFT\",\n  heading: \"NFT Details\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//popular-collections-list\nexport const popularBanner = {\n  subHeading: \"Collections\",\n  heading: \"Popular Collections\",\n  content:\n    \" Explore on the world’s best & largest NFT marketplace with our beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//privacePolicy \nexport const privacyBanner = {\n  subHeading: \"Our Privacy Policy\",\n  heading: \"Privacy Policy\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};\n\n//sellNFT\nexport const sellNFTBanner = {\n  subHeading: \"NFT\",\n  heading: \"NFT Details\",\n  content:\n    \"Explore on the world’s best & largest NFT marketplace with our  beautiful NFT products. We want to be a part of your smile, success and future growth.\",\n};","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/all-nfts/explore.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/Footer.tsx",["622","623","624","625","626","627","628"],"import { useEffect, useState, FC } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connect } from \"react-redux\";\nimport { getFooter, beforeFooter, subscribeUser } from \"./footer.action\";\nimport { firstInputCharacterSpace } from \"../../utils/functions\";\nimport EmailIcon from \"../../assets/images/mailbox-icon.svg\";\nimport { useLocation } from \"react-router-dom\";\nimport \"./Footer.css\";\nimport { toast } from \"react-toastify\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { footerInt } from \"../../interfaces/components\";\n\nconst Footer: FC<footerInt> = (props) => {\n  const [email, setEmail] = useState<any>(\"\");\n  const [loader, setLoader] = useState<any>(false);\n\n  useEffect(() => {\n    if (props.subscribeAuth && props.error === null) {\n      setLoader(false);\n      toast.success(\"Subscribed successfully\");\n      props.beforeFooter();\n    }\n  }, [props.subscribeAuth]);\n\n  useEffect(() => {\n    if (props.error !== null) {\n      toast.error(props.error.message);\n      setLoader(false);\n\n      props.emptyError();\n    }\n  }, [props.error]);\n\n  const subscribe = () => {\n    if (email.trim() === \"\") {\n      return toast.error(\"Please enter an email to subscribe\");\n    }\n    if (validateEmail(email)) {\n      props.beforeFooter();\n      setLoader(true);\n      props.subscribeUser(email);\n    } else {\n      toast.error(\"Please enter a valid email address\");\n    }\n  };\n\n  const validateEmail = (email: any) => {\n    return String(email)\n      .toLowerCase()\n      .match(\n        /^(([^<>()[\\]\\\\.,;:\\s@\"]+(\\.[^<>()[\\]\\\\.,;:\\s@\"]+)*)|(\".+\"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$/\n      );\n  };\n  const location = useLocation();\n  return (\n    <footer className=\"footer-area\">\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin  text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Who Are We?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/aboutus\">About Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/faqs\">FAQs</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Join MintsClub\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/login\">Sign In</Link>\n                  </li>\n\n                  <li>\n                    <Link to=\"/Signup\">Sign Up</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-md-3 col-lg-2 res-margin text-center  text-md-start\">\n              <div className=\"footer-items\">\n                <h4 className=\"footer-title\">{\"Quick Links\"}</h4>\n                <ul>\n                  {location.pathname !== \"/login\" &&\n                    location.pathname !== \"/Signup\" && (\n                      <>\n                        <li>\n                          <Link to=\"/auctions\">Live Auction</Link>\n                        </li>\n                        <li>\n                          <Link to=\"/popular-collections\">\n                            Popular Collections\n                          </Link>\n                        </li>\n                      </>\n                    )}\n                  <li>\n                    <Link to=\"/privacypolicy\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/termsandconditions\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin\">\n              <div className=\"footer-items footer-notify-item text-center text-lg-end\">\n                <h4 className=\"footer-title\">\n                  Never Miss The NFT Beat! <br /> Subscribe To Our Latest News\n                </h4>\n                <div className=\"notify-form\">\n                  <div className=\"email-icon\">\n                    <img src={EmailIcon} alt=\"mail-box\" />\n                  </div>\n                  <input\n                    type=\"email\"\n                    maxLength={50}\n                    onKeyDown={(e) => firstInputCharacterSpace(e, email)}\n                    onChange={(e) => setEmail(e.target.value)}\n                    placeholder=\"youremail@xyz.com\"\n                  />\n                  <div>\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                      disabled={loader}\n                      onClick={() => subscribe()}\n                    >\n                      {loader ? (\n                        <div\n                          className=\"spinner-border footer-loader\"\n                          role=\"status\"\n                        >\n                          <span className=\"sr-only\">Loading...</span>\n                        </div>\n                      ) : (\n                        \"Subscribe\"\n                      )}\n                    </button>\n                  </div>\n                </div>\n                {/* <p>{data.desc}</p> */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-end\">\n                  <a\n                    href={\"https://www.linkedin.com/showcase/mints-club\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a\n                    href={\"https://www.facebook.com/MintsClub.io/\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a\n                    href={\"https://www.instagram.com/mintsclub/\"}\n                    target=\"_blank\"\n                  >\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={\"https://twitter.com/MintsClub\"} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              <div className=\"copyright-text\">\n                © 2022 All rights reserved by mintsclub.io\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state: any) => ({\n  error: state.error,\n  settings: state.settings,\n  subscribeAuth: state.footer.subscribeAuth,\n});\n\nexport default connect(mapStateToProps, {\n  subscribeUser,\n  emptyError,\n  beforeFooter,\n})(Footer);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Nfts/nfts.action.js",["629","630"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING,\n  BEFORE_NFTS_BY_COLLECTION,\n  CREATE_NFT_AUTH,\n} from \"../../redux/types\";\nimport { ENV } from \"../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport { axiosPostFormData, handleRequest } from \"../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\n\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(method, `/nfts/${type}`, body);\n      console.log(result, \"result\");\n      const { data, success, message } = result.data;\n      if (success) {\n        toast.success(message);\n        dispatch({\n          type: UPSERT_NFT,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(\"get\", \"nfts/list\", null, qs);\n      const { data, success } = result.data;\n      if (success) {\n        dispatch({\n          type: GET_NFTS,\n          payload: data,\n        });\n        dispatch({\n          type: NFTALL,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const getNFT = (nftId) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let result = await handleRequest(\"get\", `nfts/get/${nftId}`);\n    const { data, success } = result.data;\n    if (success) {\n      dispatch({\n        type: NFTALL,\n        payload: data,\n      });\n      dispatch({\n        type: GET_NFT,\n        payload: data,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: result.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const createActivity = (body) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let res = await handleRequest(\"post\", \"activity/create\", body);\n    const { success, data } = res.data;\n    if (!success) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: res.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getActivities =\n  (qs = null) =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      let result = await handleRequest(\"get\", \"activity/get\", null, qs);\n      const { data, success } = result.data;\n      if (success) {\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: result.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\nexport const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n    axios\n      .get(url)\n      .then(function (response) {\n        dispatch({\n          type: GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\nexport const beforeNFTByCollection = () => (dispatch) => {\n  dispatch({\n    type: BEFORE_NFTS_BY_COLLECTION,\n  });\n};\n\nexport const getNFTsByCollection = (id) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    let payload = {\n      collectionId: id,\n    };\n    let result = await handleRequest(\n      \"post\",\n      \"nfts/getNFTsByCollection\",\n      payload\n    );\n    const { data, success } = result.data;\n    if (success) {\n      dispatch({\n        type: GET_NFTS_BY_COLLECTION,\n        payload: data,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: result.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n    try {\n      const res = await handleRequest(\"get\", \"nftLikes/userNftLikes\", null, qs);\n      const { success, data } = res.data;\n      if (success) {\n        dispatch({\n          type: GET_MYLIKED_NFTS,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: res.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n\nexport const createNFT = async (formData) => async (dispatch) => {\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  try {\n    const res = await handleRequest(\"post\", \"nfts/storeNFTData\", formData);\n    const { success } = res.data;\n    if (success) {\n      toast.success(\"NFT created successfully\");\n      dispatch({\n        type: CREATE_NFT_AUTH,\n      });\n    } else {\n      dispatch({\n        type: GET_ERRORS,\n        payload: res.data,\n      });\n    }\n  } catch (error) {\n    dispatch({\n      type: GET_ERRORS,\n      payload: error,\n    });\n  }\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  async (dispatch) => {\n    dispatch(emptyError());\n\n    try {\n      const res = await handleRequest(\"get\", \"nfts/list\", null, qs);\n      const { data, success } = res.data;\n      if (success) {\n        dispatch({\n          type: GET_PROFILE_NFTS,\n          payload: data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: res.data,\n        });\n      }\n    } catch (error) {\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    }\n  };\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/HomeAuctions.ts",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/PopularCollections.ts",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/CollectionDetails.ts",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/hooks/AllNFTs.ts",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/home-auctions.tsx",["631","632"],"import { useEffect, useState, FC } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connect } from \"react-redux\";\r\nimport { ENV } from \"../../config/config\";\r\nimport \"slick-carousel\";\r\nimport \"../../assets/slick/slick.min.css\";\r\nimport \"../../assets/slick/slick-theme.min.css\";\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from \"swiper/core\";\r\nimport \"swiper/swiper-bundle.css\";\r\nimport \"./auction.css\";\r\n//CardSliders\r\nimport CardSlider from \"../../Components/CardSlider/CardSlider\";\r\nimport AuctionsCards from \"../../Components/AuctionsCards/AuctionsCards\";\r\nimport { HomeAuction } from \"../../interfaces/home-auctions/interface\";\r\nimport { useGetCategories } from \"../../hooks/PopularCollections\";\r\nimport { useGetLiveAuctions } from \"../../hooks/HomeAuctions\";\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\nconst initData = {\r\n  pre_heading: \"Auctions\",\r\n  heading: \"Live Auctions\",\r\n  btnText: \"View All\",\r\n};\r\n\r\nconst AuctionsOne: FC<HomeAuction> = () => {\r\n  const [auctions, setAuctions] = useState<Array<object> | null>(null);\r\n  const [categories, setCategories] = useState<any | null>(null);\r\n  const [categoryId, setCategoryId] = useState(\"all\");\r\n  const [auctionSettings, setAuctionSettings] = useState<object | null>(null);\r\n  const [isActive, setIsActive] = useState(0);\r\n  const [filterationLoader, setFilterationLoader] = useState(true);\r\n\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n  }, []);\r\n\r\n  //Get categories\r\n  const onSuccessCategories = (data: any) => {\r\n    setCategories(data.data.categories);\r\n  };\r\n  const { isLoading: isLoadingCategories } = useGetCategories(\r\n    null,\r\n    onSuccessCategories\r\n  );\r\n\r\n  //get LiveAuctions\r\n\r\n  const onSuccessLiveAuctions = (data: any) => {\r\n    setLiveAuctions(data.data.data.auctions);\r\n  };\r\n\r\n  const setLiveAuctions = (auctions: any) => {\r\n    if (auctions) {\r\n      auctions.forEach((element: any, i: number) => {\r\n        auctions[i].totalBids = element.bidInfo?.bidBy?.length;\r\n      });\r\n    }\r\n    setAuctions(auctions);\r\n    setFilterationLoader(false);\r\n    let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n    if (auctions.length > 4) {\r\n      auctionCollectionsSettings.infinite = true;\r\n    } else {\r\n      auctionCollectionsSettings.infinite = false;\r\n    }\r\n    setAuctionSettings(auctionCollectionsSettings);\r\n  };\r\n  const { isLoading: isLoadingLiveAuctions } = useGetLiveAuctions(\r\n    categoryId,\r\n    onSuccessLiveAuctions\r\n  );\r\n\r\n  useEffect(() => {\r\n    const interval = setInterval(() => {\r\n      checkIfAuctionEnded();\r\n    }, 3000);\r\n    return () => clearInterval(interval);\r\n  }, [auctions]);\r\n\r\n  const checkIfAuctionEnded = () => {\r\n    if (auctions && auctions?.length > 0) {\r\n      auctions.forEach((item: any, index: number) => {\r\n        let auctionEndDate = new Date(item.auctionEndDate);\r\n        let currentDate = new Date();\r\n        if (currentDate > auctionEndDate) {\r\n          let updatedAuctions = [...auctions];\r\n          updatedAuctions.splice(index, 1);\r\n          setAuctions(updatedAuctions);\r\n        }\r\n      });\r\n    }\r\n  };\r\n\r\n  const handleCategoryFilter = (desc: string) => {\r\n    setFilterationLoader(true);\r\n    setCategoryId(desc);\r\n  };\r\n\r\n  return (\r\n    <section className=\"live-auctions-area padding-wrapper\">\r\n      <div className=\"container\">\r\n        <div className=\"row mb-5\">\r\n          <div className=\"col-12 col-md-8\">\r\n            {/* Intro */}\r\n            <div className=\"intro d-flex justify-content-between align-items-end m-0\">\r\n              <div className=\"intro-content clr-blue\">\r\n                <span>{initData.pre_heading}</span>\r\n                <h3 className=\"mb-0\">{initData.heading}</h3>\r\n                <p>\r\n                  Explore on the world's best & largest NFT marketplace with our\r\n                  beautiful NFT products. <br className=\"d-none d-xxl-block\" />\r\n                  We want to be a part of your smile, success and future growth.\r\n                </p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-4 mt-3 mt-lg-0\">\r\n            {categoryId === \"all\" &&\r\n            (!auctions || (auctions && auctions?.length <= 1)) &&\r\n            !filterationLoader ? (\r\n              \"\"\r\n            ) : (\r\n              <div className=\"popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end\">\r\n                {categories &&\r\n                  categories.length > 0 &&\r\n                  categories.map((item: any, id: number) => {\r\n                    if (id <= 3) {\r\n                      return (\r\n                        <button\r\n                          key={id}\r\n                          className={`${\r\n                            id === isActive ? \"home-active-category\" : \"\"\r\n                          } me-1 me-sm-3 me-lg-4`}\r\n                          onClick={() => {\r\n                            setIsActive(id);\r\n                            handleCategoryFilter(item.description);\r\n                          }}\r\n                        >\r\n                          {item.name}\r\n                        </button>\r\n                      );\r\n                    }\r\n                  })}\r\n                <div className=\"intro-btn\">\r\n                  <Link\r\n                    className=\"btn btn-rounded-bordered btn-viewAll\"\r\n                    to=\"/auctions\"\r\n                  >\r\n                    View All\r\n                  </Link>\r\n                </div>\r\n              </div>\r\n            )}\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"auctions-slides\">\r\n          <>\r\n            {filterationLoader || isLoadingLiveAuctions||isLoadingCategories ? (\r\n              <div className=\"spinner-loader-wrapper\">\r\n                <div className=\"spinner-border text-secondary\" role=\"status\">\r\n                  <span className=\"sr-only\">Loading...</span>\r\n                </div>\r\n              </div>\r\n            ) : auctions && auctions.length > 0 ? (\r\n              <CardSlider\r\n                settings={auctionSettings}\r\n                data={auctions}\r\n                homeAuction\r\n              >\r\n                {auctions.map((item: any, index: number) => {\r\n                  return (\r\n                    <AuctionsCards\r\n                      cardBg={\"card-bg-gray\"}\r\n                      key={index}\r\n                      item={item}\r\n                      ownerName={item?.owner?.username}\r\n                      userId={ENV.getUserKeys(\"_id\")?._id}\r\n                      ownerId={item.owner?._id}\r\n                      bidsProfile={item?.bidInfo?.bidByProfile}\r\n                      index={index}\r\n                    />\r\n                  );\r\n                })}\r\n              </CardSlider>\r\n            ) : (\r\n              <p className=\"text-center py-5 no-auction-msg\">\r\n                No Live Auctions Found\r\n              </p>\r\n            )}\r\n          </>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\nconst mapStateToProps = () => ({});\r\nexport default connect(mapStateToProps, {})(AuctionsOne);\r\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/top-seller/topseller.tsx",["633","634"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/collections/popular-collections.tsx",["635","636","637","638","639","640"],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Hero/Hero.tsx",["641","642"],"import { useEffect, useState,FC } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport { connectMetamaskCopy } from \"../../utils/web3\";\nimport \"./Hero.css\";\nimport Play from \"../../assets/images/play.svg\";\nimport CardSlider from \"../CardSlider/CardSlider\";\nimport HeroCards from \"../HeroCards/HeroCards\";\nimport { ENV } from \"../../config/config\";\nimport {\n  beforeAuction,\n  getLiveAuctions,\n} from \"../../pages/auctions/auctions.action\";\nimport { connect } from \"react-redux\";\nimport { WordsFamousNfts } from \"../../utils/exportData\";\nimport { HeroInt } from \"../../interfaces/components\";\nconst Hero:FC< HeroInt>= (props) => {\n  const [connectedAddress, setConnectedAddress] = useState<any>(\"\");\n  const [data, setData] = useState<any>(null);\n  const [status, setStatus] = useState<any>(null);\n  const heroSettings = ENV.heroSettings;\n\n  useEffect( () => {\n    const setAddress=async ()=>{\n\n      let connectedAddress = await connectMetamaskCopy();\n      setConnectedAddress(connectedAddress);\n    }\n    setAddress()\n  }, []);\n\n  useEffect(() => {\n    const qs = ENV.objectToQueryString({\n      myFilter: \"all\",\n    });\n    props.getLiveAuctions(qs);\n  }, []);\n\n  useEffect(() => {\n    if (props.auction.auctionsAuth) {\n      const { auctions } = props.auction;\n      let updatedAuctions = [];\n      if (auctions && auctions.length > 1) {\n        props.beforeAuction();\n        setStatus(\"auctions\");\n        updatedAuctions = auctions.filter((item:any) => item.fileType === \"image\");\n        if (updatedAuctions?.length > 6) {\n          updatedAuctions = updatedAuctions.slice(0, 6);\n        }\n        setData(updatedAuctions);\n      } else {\n        setStatus(\"nfts\");\n        setData(WordsFamousNfts);\n      }\n    }\n  }, [props.auction.auctionsAuth]);\n\n  return (\n    <section className=\"hero-section padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row align-items-center\">\n          <div className=\"col-12 col-lg-6\">\n            <h1 className=\"mt-4\">\n              Discover, Collect, <br /> <span>and sell</span> Rare\n              <br />\n              Digital Art <span> NFTs </span>\n            </h1>\n            <p className=\"mp-explore-text\">\n              Build the leading platform for cutting-edge and next gen\n              Blockchain.\n            </p>\n            {/* Buttons */}\n            <div className=\"button-group mt-lg-5 d-flex\">\n              <Link\n                className=\"btn btn-linear-gradient btn-hero-create me-sm-4\"\n                to={connectedAddress ? \"/create\" : \"/login\"}\n              >\n                Create\n              </Link>\n              <div className=\"watch-video d-flex align-items-center\">\n                <button className=\"hero-play-btn\">\n                  <img src={Play} alt=\"play\" />\n                </button>\n                <span className=\"ms-4\">Watch video to learn more ...</span>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-12 col-lg-6\">\n            <CardSlider settings={heroSettings}>\n              {data &&\n                data.length > 0 &&\n                data.map((auction:any, id:any) => {\n                  return (\n                    <HeroCards\n                      key={id}\n                      data={auction}\n                      status={status}\n                      // className=\"slide\"\n                    />\n                  );\n                })}\n            </CardSlider>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state:any) => ({\n  auction: state.auction,\n  nft: state.nft,\n});\nexport default connect(mapStateToProps, {\n  beforeAuction,\n  getLiveAuctions,\n})(Hero);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/OwnCollectionToday/OwnCollectionToday.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/BuySell/BuySell.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/AuctionsCards/AuctionsCards.tsx",["643"],"import React, { useState,FC } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport ArrowUp from \"../../assets/images/arrowUp.svg\";\nimport Countdown from \"react-countdown\";\nimport { ENV } from \"../../config/config\";\nimport useVideoPlayer from \"../TestVideoCard/Components/UseVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport { connect } from \"react-redux\";\nimport \"./AuctionsCard.css\";\nimport { Images } from \"../../assets/assets\";\nimport ImageLoader from \"../ContentLoader/ImageLoader\";\nimport AuctionAudio from \"../AuctionAudio/AuctionAudio\";\nimport {AuctionCardInterface} from '../../interfaces/components';\n\n\nconst AuctionsCards:FC<AuctionCardInterface> = ({\n  ownerName,\n  userId,\n  bidsProfile,\n  item,\n  cardBg,\n  key,\n  connectedAddress,\n}) => {\n  const { countDownRenderer } = ENV;\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay } =\n    useVideoPlayer(videoElement);\n  const [loader, setLoader] = useState<any>(true);\n  const {\n    image,\n    auctionEndDate,\n    name,\n    _id,\n    highestBid,\n    totalBids,\n    currentPrice,\n    fileType,\n    ownerAddress,\n  } = item;\n  const { profilePhoto } = item?.owner;\n  \n  return (\n    <Card key={key} className={`auction-card ${cardBg} mx-auto mx-sm-2`}>\n      <div className=\"auction-img-wrapper\">\n        {fileType === \"image\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Card.Img\n              variant=\"top\"\n              onLoad={() => setLoader(false)}\n              onClick={() => history.push(`explore/nftdetail/${_id}`)}\n              src={image}\n              alt=\"AuctionTopImg\"\n              style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n            />\n          </>\n        ) : fileType === \"video\" ? (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n                <ImageLoader />\n              </div>\n\n              <video\n                src={image}\n                onEnded={() => {\n                  togglePlay();\n                }}\n                onCanPlay={() => {\n                  setLoader(false);\n                }}\n                ref={videoElement}\n                // onTimeUpdate={handleOnTimeUpdate}\n                style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : fileType === \"audio\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n\n            <AuctionAudio\n              src={image}\n              onLoadCallback={() => setLoader(false)}\n              loader={loader}\n            />\n          </>\n        ) : (\n          \" \"\n        )}\n\n        <div className=\"auction-countdown d-flex flex-column justify-content-center align-items-center\">\n          <Countdown date={auctionEndDate} renderer={countDownRenderer} />\n          <div className=\"auction-card-avatar-container d-flex align-items-center justify-content-between\">\n            <div className=\"auction-card-avatar d-flex align-items-center\">\n              {bidsProfile &&\n                bidsProfile.length > 0 &&\n                bidsProfile.map((item:any, i:any) => {\n                  if (i <= 2) {\n                    return (\n                      <img\n                        src={item === null ? Images.placeholderImg : item}\n                        alt=\"AvatarImg\"\n                        key={i}\n                      />\n                    );\n                  }\n                })}\n\n              <span className={`${totalBids === 0 ? \"\" : \"ms-4\"}`}>\n                {totalBids === 0\n                  ? \"No Bids Found\"\n                  : totalBids < 4\n                  ? totalBids + \" People Placed Bid\"\n                  : totalBids - 1 + \"+ People Placed Bid\"}\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body>\n        <Card.Title onClick={() => history.push(`explore/nftdetail/${_id}`)}>\n          <div>\n            {name && name.length > 10 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"auction-owner-price d-flex align-items-center\">\n            <img src={ArrowUp} alt=\"\" className=\"me-1\" />\n            <span>{totalBids > 0 ? highestBid : currentPrice}</span>\n          </div>\n        </Card.Title>\n        <div className=\"auction-card-owner-container d-flex align-items-center mb-2\">\n          <div className=\"auction-owner-avatar\">\n            <img\n              src={profilePhoto ? profilePhoto : Images.placeholderImg}\n              alt=\"avatar\"\n            />\n          </div>\n\n          <div className=\"ms-2 auction-owner-name\">\n            <p>\n              {\"Owned by:\"}\n              <span className=\"text-capitalize ms-1\">\n                {!ownerName\n                  ? \"unnamed\"\n                  : connectedAddress?.toUpperCase() ===\n                    ownerAddress?.toUpperCase()\n                  ? \"You\"\n                  : ownerName && ownerName.length > 12\n                  ? ownerName.substring(0, 12) + \"....\"\n                  : ownerName}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn\"\n          onClick={() => history.push(`explore/nftdetail/${_id}`)}\n        >\n          {connectedAddress?.toUpperCase() === ownerAddress?.toUpperCase() ||\n          !userId\n            ? \"View\"\n            : \"Place a Bid\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state:any) => ({\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {})(AuctionsCards);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Listing/Listing.tsx",["644","645","646"],"import { useState, useEffect, FC } from \"react\";\nimport \"./Listing.css\";\nimport { ReactComponent as SearchIcon } from \"../../assets/images/searchicon.svg\";\nimport NftCard from \"../NftCard/NftCard\";\nimport FullPageLoader from \"../FullPageLoader/FullPageLoader\";\nimport Select from \"react-select\";\nimport { decimalNumberValidator } from \"../../utils/functions\";\nimport { listingInt } from \"../../interfaces/components\";\n\nconst Listing: FC<listingInt> = (props) => {\n  const [minValue, setMinValue] = useState<any>(\"\");\n  const [maxValue, setMaxValue] = useState<any>(\"\");\n  const [statusActive, setStatusActive] = useState<any>(null);\n  const [filterActive, setFilterActive] = useState<any>(false);\n  const [initial, setInitial] = useState<any>(true);\n  const [selectedOption, setSelectedOption] = useState<any>();\n  const [collectionActive, setCollectionActive] = useState<any>(null);\n  const [isActive, setIsActive] = useState<any>(1);\n  const [keyword, setKeyword] = useState<any>(\n    props.initialKeyword ? props.initialKeyword : \"\"\n  );\n  const [filter, setFilter] = useState<any>({\n    collectionId: false,\n    gtePrice: false,\n    ltePrice: false,\n    categoryId: false,\n    oldest: false,\n    lowToHigh: false,\n    highToLow: false,\n    newest: false,\n    page: 1,\n    limit: 10,\n    buy: false,\n    auction: false,\n    latest: false,\n    keyword: props.initialKeyword ? props.initialKeyword : \"\",\n  });\n\n  const priceOptions = [\n    { value: \"lowtohigh\", label: \"Low To High\" },\n    { value: \"hightolow\", label: \"High To Low\" },\n    { value: \"oldest\", label: \"Oldest\" },\n    { value: \"newest\", label: \"Recently Created\" },\n  ];\n  useEffect(() => {\n    const { initialKeyword } = props;\n    if (initialKeyword) {\n      let capitalizeValue = capitalize(initialKeyword);\n      setKeyword(capitalizeValue);\n      handleSearchKeyword(capitalizeValue);\n    }\n  }, [props.initialKeyword]);\n\n  useEffect(() => {\n    fetchData(filter);\n  }, [filter]);\n  const handleSelectChange = (selectedOption: any) => {\n    setSelectedOption(selectedOption);\n  };\n  const selectCustomStyles = {};\n\n  const statusData = [\"Buy Now\", \"On Auction\", \"New\"];\n  const handleFilters = () => {\n    setFilterActive(!filterActive);\n  };\n  const isHideCollection = () => {\n    if (props.collectionDetail) {\n      return false;\n    }\n    if (props.UserProfile) {\n      if (isActive === 1) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return true;\n    }\n  };\n\n  const handleSortOptions = (e: any) => {\n    setFilterationLoader(true);\n    setInitial(false);\n\n    const { label } = e;\n    if (label === \"Low To High\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        lowToHigh: true,\n        highToLow: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"High To Low\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        highToLow: true,\n        lowToHigh: false,\n        oldest: false,\n        newest: false,\n      }));\n    } else if (label === \"Oldest\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        oldest: true,\n        highToLow: false,\n        lowToHigh: false,\n        newest: false,\n      }));\n    } else if (label === \"Recently Created\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        newest: true,\n        oldest: false,\n        highToLow: false,\n        lowToHigh: false,\n      }));\n    } else {\n    }\n  };\n\n  const onChangeMinPrice = (e: any) => {\n    setMinValue(e.target.value);\n  };\n  const onChangeMaxPrice = (e: any) => {\n    setMaxValue(e.target.value);\n  };\n\n  const handlePagination = () => {\n    window.scroll(0, 500);\n    if (!UserProfile) {\n      setInitial(false);\n      setFilterationLoader(true);\n      setFilter((prev: any) => ({ ...prev, limit: filter.limit + 10 }));\n    } else {\n      getPaginatedData?.();\n    }\n  };\n\n  const applyMinMaxFilter = () => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev: any) => ({\n      ...prev,\n      gtePrice: minValue,\n      ltePrice: maxValue,\n    }));\n  };\n\n  const handleCollectionsFilter = (id: string) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    setFilter((prev: any) => ({ ...prev, collectionId: id }));\n  };\n\n  const handleSearchKeyword = (value: any) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    let capitalizeValue = \"\";\n    if (value) {\n      capitalizeValue = capitalize(value);\n    }\n    setFilter((prev: any) => ({ ...prev, keyword: capitalizeValue }));\n  };\n\n  const handleStatusFilter = (id: string) => {\n    setInitial(false);\n    setFilterationLoader(true);\n    if (id === \"Buy Now\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        buy: true,\n        auction: false,\n        newest: false,\n      }));\n    } else if (id === \"On Auction\") {\n      setFilter((prev: any) => ({\n        ...prev,\n        auction: true,\n        buy: false,\n        newest: false,\n      }));\n    } else {\n      setFilter((prev: any) => ({\n        ...prev,\n        newest: true,\n        buy: false,\n        auction: false,\n      }));\n    }\n  };\n  const handleClearFilter = (id: any) => {\n    if (id === \"status\") {\n      setFilterationLoader(true);\n      setFilter((prev: any) => ({\n        ...prev,\n        buy: false,\n        auction: false,\n        new: false,\n      }));\n    } else if (id === \"price\") {\n      setFilterationLoader(true);\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setFilter((prev: any) => ({ ...prev, ltePrice: false, gtePrice: false }));\n    } else if (id === \"collections\") {\n      setFilterationLoader(true);\n      setFilter((prev: any) => ({ ...prev, collectionId: false }));\n    } else {\n      setMinValue(\"\");\n      setMaxValue(\"\");\n      setStatusActive(null);\n      setCollectionActive(null);\n      setSelectedOption(null);\n      setFilterActive(null);\n      setKeyword(\"\");\n      setFilter({\n        collectionId: false,\n        gtePrice: false,\n        ltePrice: false,\n        categoryId: false,\n        oldest: false,\n        lowToHigh: false,\n        highToLow: false,\n        newest: false,\n        page: filter.page,\n        limit: filter.limit,\n        buy: false,\n        auction: false,\n        latest: false,\n      });\n    }\n  };\n  const capitalize = (word: string) => {\n    return word[0].toUpperCase() + word.slice(1).toLowerCase();\n  };\n\n  const {\n    collections,\n    disabled,\n    menuData,\n    handleNftFilter,\n    setMenuFilter,\n    filterationLoader,\n    setFilterationLoader,\n    nfts,\n    loader,\n    likedNfts,\n    nftPagination,\n    handleLikesTogleApi,\n    fetchData,\n    path,\n    getPaginatedData,\n    UserProfile,\n  } = props;\n\n  return (\n    <div className=\"filterhoc-wrapper padding-wrapper\">\n      <div className=\"container\">\n        <div className=\"row justify-content-center justify-content-lg-start\">\n          <div className=\"col-12 order-0\">\n            <div\n              className={`d-flex flex-column flex-md-row align-items-center justify-content-md-between`}\n            >\n              <div className=\"search-input mb-4 mb-md-0\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Search items and accounts\"\n                  maxLength={50}\n                  onChange={(e: any) => {\n                    if (keyword.trim() === \"\" && e.target.value.trim() === \"\") {\n                      return false;\n                    } else if (e.target.value === \"\") {\n                      handleSearchKeyword(false);\n                      setKeyword(e.target.value);\n                    } else {\n                      setKeyword(e.target.value);\n                    }\n                  }}\n                  onKeyPress={(e: any) =>\n                    e.key === \"Enter\" && handleSearchKeyword(keyword)\n                  }\n                  value={keyword}\n                />\n                <SearchIcon />\n              </div>\n              <div className=\"sort-by-select mb-4 mb-md-0\">\n                <p className=\"me-3\">Sort by:</p>\n                <Select\n                  className=\"react-select-cls\"\n                  classNamePrefix=\"react-select\"\n                  styles={selectCustomStyles}\n                  // defaultValue={priceOptions[3]}\n                  value={selectedOption}\n                  isSearchable={false}\n                  onChange={(value) => {\n                    handleSelectChange(value);\n                    handleSortOptions(value);\n                  }}\n                  options={priceOptions}\n                />\n              </div>\n              <div className=\"mob-filters-btn d-flex d-lg-none align-items-center justify-content-center\">\n                <button\n                  className={`${filterActive ? \"mob-active-filter\" : \"\"}`}\n                  onClick={handleFilters}\n                >\n                  Filters\n                </button>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-12 my-5 order-2 order-lg-1 \">\n            <div className=\"hero-nav d-flex flex-column flex-sm-row align-items-center justify-content-between\">\n              <div>\n                {\" \"}\n                {menuData &&\n                  menuData.length > 0 &&\n                  menuData.map((item, id) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          setIsActive(id);\n                          handleNftFilter?.(item);\n                          setMenuFilter?.(item);\n                        }}\n                        className={`${\n                          id === isActive ? \"active-hero-nav\" : \"\"\n                        } me-2 me-xl-3`}\n                      >\n                        {item}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"total-items mt-3 mt-sm-0\">\n                <p>\n                  Total items:{\" \"}\n                  <span>{nftPagination?.total ? nftPagination?.total : 0}</span>\n                </p>\n              </div>\n            </div>\n          </div>\n          <div\n            className={`${\n              filterActive ? \"d-block d-lg-block\" : \"d-none d-lg-block\"\n            } col-md-5 col-lg-4 col-xl-3 order-1 order-lg-2 mt-4 mt-lg-0`}\n          >\n            <div className=\"filter-container mb-4\">\n              <h6>Status</h6>\n              <hr />\n              <div className=\"d-flex flex-wrap align-items-center \">\n                {statusData &&\n                  statusData.map((status: any, id: any) => {\n                    return (\n                      <button\n                        key={id}\n                        onClick={() => {\n                          handleStatusFilter(status);\n                          setStatusActive(status);\n                        }}\n                        className={`${\n                          status === statusActive ? \"active-filter-btn\" : \"\"\n                        } filter-btn me-3`}\n                      >\n                        {status}\n                      </button>\n                    );\n                  })}\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {statusActive && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => {\n                      setStatusActive(null);\n                      handleClearFilter(\"status\");\n                    }}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            <div className=\"filter-container mb-4\">\n              <h6>Price</h6>\n              <hr />\n              <div className=\"min-max-inp d-flex flex-column flex-sm-row align-items-center justify-content-center justify-content-sm-between mb-2\">\n                <div className=\"d-flex flex-column flex-sm-row align-items-center justify-content-center\">\n                  <input\n                    type=\"number\"\n                    placeholder=\"Min\"\n                    className=\"me-sm-2\"\n                    value={minValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMinPrice}\n                  ></input>\n                  <input\n                    type=\"number\"\n                    placeholder=\"Max\"\n                    className=\"mt-3 mt-sm-0 me-sm-2\"\n                    value={maxValue}\n                    onKeyDown={(e) => decimalNumberValidator(e)}\n                    onChange={onChangeMaxPrice}\n                  ></input>\n                </div>\n                <button\n                  className=\"mt-3 mt-sm-0\"\n                  onClick={() => applyMinMaxFilter()}\n                  disabled={disabled || minValue === \"\" || maxValue === \"\"}\n                >\n                  Apply\n                </button>\n              </div>\n              <div className=\"d-flex align-items-end justify-content-end\">\n                {minValue && maxValue && (\n                  <button\n                    className=\"filter-clear-btn\"\n                    onClick={() => handleClearFilter(\"price\")}\n                  >\n                    Clear\n                  </button>\n                )}\n              </div>\n            </div>\n            {isHideCollection() && (\n              <div className=\"filter-container hoc-collections-container mb-4\">\n                <h6>Collections</h6>\n                <hr />\n                <div className=\"d-flex flex-wrap align-items-center \">\n                  {collections && collections.length > 0 ? (\n                    collections.map((collection: any, id: any) => {\n                      return (\n                        <button\n                          key={id}\n                          onClick={() => {\n                            handleCollectionsFilter(collection._id);\n                            setCollectionActive(id);\n                          }}\n                          className={`${\n                            id === collectionActive ? \"active-filter-btn\" : \"\"\n                          } filter-btn me-2 me-xl-3`}\n                        >\n                          {collection.name}\n                        </button>\n                      );\n                    })\n                  ) : (\n                    <p className=\"text-center mx-auto\">No Collections Found</p>\n                  )}\n                </div>\n                <div className=\"d-flex align-items-end justify-content-end\">\n                  {collectionActive !== null && (\n                    <button\n                      className=\"filter-clear-btn\"\n                      onClick={() => {\n                        setCollectionActive(null);\n                        handleClearFilter(\"collections\");\n                      }}\n                    >\n                      Clear\n                    </button>\n                  )}\n                </div>\n              </div>\n            )}\n            <div className=\"d-flex align-items-center justify-content-center btn-clear-all\">\n              <button onClick={() => handleClearFilter(null)}>\n                Clear All Filters\n              </button>\n            </div>\n          </div>\n          <div className=\"col-lg-8 col-xl-9 order-3\">\n            {loader ? (\n              <FullPageLoader />\n            ) : (\n              <div className=\"row g-1\">\n                {filterationLoader ? (\n                  <div className=\"text-center\">\n                    <div\n                      className=\"spinner-border text-secondary\"\n                      role=\"status\"\n                    >\n                      <span className=\"sr-only\">Loading...</span>\n                    </div>\n                  </div>\n                ) : nfts && nfts.length > 0 ? (\n                  nfts.map((nft: any, index: number) => {\n                    return (\n                      <div\n                        key={index}\n                        className=\"col-12 col-sm-6 col-md-4 col-lg-6 col-xl-4\"\n                      >\n                        {\n                          <NftCard\n                            data={nft}\n                            handleLikesTogleApi={handleLikesTogleApi}\n                            likedNfts={likedNfts}\n                            owner={nft.owner}\n                            path={path}\n                            index={index}\n                          />\n                        }\n                      </div>\n                    );\n                  })\n                ) : (\n                  <p className=\"text-center mt-5 no-nft-title\">No NFTs Found</p>\n                )}\n                <div className=\"col-12\">\n                  <div className=\"mt-5 text-center\">\n                    {nfts &&\n                      nftPagination?.total > nfts.length &&\n                      !filterationLoader && (\n                        <button\n                          className=\"btn btn-rounded-bordered px-5\"\n                          onClick={() => handlePagination()}\n                        >\n                          Load more...\n                        </button>\n                      )}\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default Listing;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/NavbarMain/NavbarMain.tsx",["647","648","649","650","651"],"import { useEffect, useState, useContext, FC } from \"react\";\nimport { Link, useHistory, useLocation, NavLink } from \"react-router-dom\";\nimport MintsClub from \"../../assets/images/main-logo.svg\";\nimport { ReactComponent as LoginIcon } from \"../../assets/images/login-icon.svg\";\nimport { ReactComponent as SearchIcon } from \"../../assets/images/nav-search-icon.svg\";\nimport { Container, Nav, Navbar, NavDropdown } from \"react-bootstrap\";\nimport { ENV } from \"../../config/config\";\nimport \"./NavbarMain.css\";\nimport { connect } from \"react-redux\";\nimport DarkModeButton from \"../DarkModeButton/DarkModeButton\";\nimport { beforeCollection } from \"../../pages/collections/collections.actions\";\nimport { headerImages } from \"../../assets/assets\";\nimport darkModeContext from \"../../context/darkmode/DarkModeContext\";\n\nconst NavbarMain = () => {\n  const [searchactive, setSearchActive] = useState<any>(false);\n  const [searchValue, setSearchValue] = useState<any>(\"\");\n  const history = useHistory();\n  const { darkMode, setDarkMode } = useContext(darkModeContext);\n\n  const handleChange = (e: any) => {\n    setSearchValue(e.target.value);\n    e.target.value ? setSearchActive(true) : setSearchActive(false);\n  };\n  const handleSearchKeyword = () => {\n    if (searchValue !== \"\" && searchValue.length >= 3) {\n      history.push({\n        pathname: \"/explore/allNFT\",\n        state: searchValue,\n      });\n    }\n  };\n  const clearLocalStorage = () => {\n    if (ENV?.getUserKeys(\"_id\")?._id) {\n      localStorage.clear();\n      history.push(\"/login\");\n    }\n  };\n\n  const setDark = () => {\n    localStorage.setItem(\"theme\", \"dark\");\n    document.documentElement.setAttribute(\"data-theme\", \"dark\");\n  };\n\n  const setLight = () => {\n    localStorage.setItem(\"theme\", \"light\");\n    document.documentElement.setAttribute(\"data-theme\", \"light\");\n  };\n  const storedTheme = localStorage.getItem(\"theme\");\n  const prefersDark =\n    window.matchMedia &&\n    window.matchMedia(\"(prefers-color-scheme: dark)\").matches;\n\n  const defaultDark =\n    storedTheme === \"dark\" || (storedTheme === null && prefersDark);\n\n  const toggleTheme = (e: any) => {\n    if (e.target.checked) {\n      setDark();\n      setDarkMode(true);\n    } else {\n      setLight();\n      setDarkMode(false);\n    }\n  };\n\n  useEffect(() => {\n    if (defaultDark) {\n      setDark();\n      setDarkMode(true);\n    }\n  }, []);\n  console.log(ENV?.getUserKeys(\"_id\"));\n\n  return (\n    <div className=\"main-nav-section\">\n      <Container className=\"main-nav-container\">\n        <Navbar\n          expand=\"xl\"\n          className=\"navbar-main-custom align-items-center px-0 py-4\"\n        >\n          <NavLink to=\"/\" className=\"navbar-brand-logo\">\n            <img\n              src={darkMode ? headerImages.logoDark : MintsClub}\n              alt=\"logo\"\n            />\n          </NavLink>\n          <Navbar.Toggle aria-controls=\"basic-navbar-nav\" />\n          <Navbar.Collapse id=\"basic-navbar-nav\">\n            <Nav className={\"ms-xl-auto\"}>\n              <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/\">Home</NavLink>\n              </Nav.Link>\n\n              <NavDropdown\n                title=\"Explore\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/exploreAll\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Explore All\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/explore/allNFT\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    All NFT\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Create\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/create\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Create NFT\n                  </NavLink>\n                </NavDropdown.Item>\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/createcollection\"\n                    className={`nav-main-link main-nav-dd-items`}\n                  >\n                    Create Collection\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              <NavDropdown\n                title=\"Profile\"\n                id=\"navbarScrollingDropdown\"\n                className={`nav-main-link dropdown-bg`}\n              >\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/userprofile\"\n                    className={`nav-main-link main-nav-dd-itemss`}\n                  >\n                    Profile\n                  </NavLink>\n                </NavDropdown.Item>\n                {/* <NavDropdown.Item> */}\n                <DarkModeButton\n                  toggleTheme={toggleTheme}\n                  defaultDark={defaultDark}\n                />\n                {/* </NavDropdown.Item> */}\n                <NavDropdown.Item>\n                  <NavLink\n                    to=\"/login\"\n                    className={`nav-main-link main-nav-dd-items`}\n                    onClick={() => clearLocalStorage()}\n                  >\n                    {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                  </NavLink>\n                </NavDropdown.Item>\n              </NavDropdown>\n              {/* <Nav.Link className=\"nav-main-link\">\n                <NavLink to=\"/userprofile\" className=\"nav-main-link\">\n                  Profile\n                </NavLink>\n              </Nav.Link> */}\n              {/* <Link\n                to={`/login`}\n                onClick={() => clearLocalStorage()}\n                id=\"wallet-address\"\n                className=\"btn ml-lg-auto btn-linear-gradient d-sm-none\"\n              >\n                <div onClick={() => clearLocalStorage()}>\n                  <span className=\"me-2\">\n                    <LoginIcon />\n                  </span>\n                  {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n                </div>\n              </Link> */}\n              <div className={`search-box mt-1 mt-sm-0 d-sm-none`}>\n                <input\n                  className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                  type=\"text\"\n                  name=\"\"\n                  placeholder=\"Type to Search\"\n                  onChange={handleChange}\n                  onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n                />\n                <button\n                  className={`search-btn me-1 mt-1 ${\n                    searchactive ? \"activeSearchBtn\" : \"\"\n                  }`}\n                  onClick={() => handleSearchKeyword()}\n                >\n                  <SearchIcon className=\"search-icon\" />\n                </button>\n              </div>\n            </Nav>\n          </Navbar.Collapse>\n          <div className=\"main-nav-right d-none d-sm-flex justify-content-around align-items-center\">\n            <div className=\"search-box \">\n              <input\n                className={`search-txt ${searchactive ? \"activeSearch\" : \"\"}`}\n                type=\"text\"\n                name=\"\"\n                placeholder=\"Type to Search\"\n                onChange={handleChange}\n                onKeyPress={(e) => e.key === \"Enter\" && handleSearchKeyword()}\n              />\n              <button\n                className={`search-btn me-1 mt-1 ${\n                  searchactive ? \"activeSearchBtn\" : \"\"\n                }`}\n                onClick={() => handleSearchKeyword()}\n              >\n                <SearchIcon className=\"search-icon\" />\n              </button>\n            </div>\n            {/* <Link\n              to=\"/login\"\n              id=\"wallet-address\"\n              className=\"btn ml-lg-auto btn-linear-gradient btn-login\"\n            >\n              <div\n                onClick={() => {\n                  props.beforeCollection();\n                  clearLocalStorage();\n                }}\n              >\n                <span className=\"me-2\">\n                  <LoginIcon />\n                </span>\n                {ENV.getUserKeys(\"_id\")._id ? \"Logout\" : \"Login\"}\n              </div>\n            </Link> */}\n          </div>\n        </Navbar>\n      </Container>\n    </div>\n  );\n};\n\nconst mapStateToProps = () => ({});\n\nexport default connect(mapStateToProps, { beforeCollection })(NavbarMain);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/utils/functions.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Categories/categories.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/CardSlider/CardSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/CollectionsCards/CollectionsCard.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/AuctionAudio/AuctionAudio.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/ImageLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/TestVideoCard/Components/UseVideoPlayer.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/NftCard/NftCard.tsx",["652","653","654","655"],"import React, { useState, FC } from \"react\";\nimport { Card } from \"react-bootstrap\";\nimport { useHistory } from \"react-router\";\nimport useVideoPlayer from \"../TestVideoCard/Components/UseVideoPlayer\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\nimport placeholderImg from \"../../assets/images/placeholder.png\";\nimport { connect } from \"react-redux\";\nimport \"./NftCard.scss\";\nimport { Images } from \"../../assets/assets\";\nimport ImageLoader from \"../ContentLoader/ImageLoader\";\nimport Audio from \"../Audio/Audio\";\nimport { NFTCardInt } from \"../../interfaces/components\";\n\nconst NFTCard: FC<NFTCardInt> = (props) => {\n  const history = useHistory();\n  const videoElement = React.useRef(null);\n  const { playerState, togglePlay } = useVideoPlayer(videoElement);\n  const [loader, setLoader] = useState<any>(true);\n  const {\n    image,\n    name,\n    _id,\n    fileType,\n    cardBg,\n    ownerId,\n    likeCount,\n    currentPrice,\n    copies,\n    remainingCopies,\n    ownerAddress,\n  } = props.data;\n  const { username, profileImage, profilePhoto } = props?.owner;\n  const { likedNfts } = props;\n  const validateIfLiked = (likedNfts1: any, id: string) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className={`nft-card ${cardBg} m-1 mx-auto mx-sm-1`}>\n      <div className=\"nft-img-wrapper\">\n        {fileType === \"image\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Card.Img\n              variant=\"top\"\n              onLoad={() => setLoader(false)}\n              onClick={() => history.push(`${props.path}${_id}`)}\n              src={image}\n              alt=\"AuctionTopImg\"\n              style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n            />\n          </>\n        ) : fileType === \"video\" ? (\n          <div className=\"card-img-top\">\n            <div className=\"video-wrapper\">\n              <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n                <ImageLoader />\n              </div>\n              <video\n                id=\"video1\"\n                src={image}\n                ref={videoElement}\n                onEnded={() => {\n                  togglePlay();\n                }}\n                onCanPlay={() => {\n                  setLoader(false);\n                }}\n                style={{ display: `${!loader ? \"block\" : \"none\"}` }}\n              />\n\n              <div className=\"controls\">\n                <div className=\"actions\">\n                  <button\n                    className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                    onClick={togglePlay}\n                  >\n                    {playerState.isPlaying ? (\n                      <BsFillPauseFill />\n                    ) : (\n                      <BsFillPlayFill />\n                    )}\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        ) : fileType === \"audio\" ? (\n          <>\n            <div style={{ display: `${loader ? \"block\" : \"none\"}` }}>\n              <ImageLoader />\n            </div>\n            <Audio\n              src={image}\n              onLoadCallback={() => {\n                setLoader(false);\n                return false;\n              }}\n              loader={loader}\n              fileType={fileType}\n            />\n          </>\n        ) : (\n          \" \"\n        )}\n      </div>\n      <Card.Body>\n        <Card.Title>\n          <div>\n            {name && name.length > 15 ? name.slice(0, 10) + \"...\" : name}\n          </div>\n          <div className=\"nft-owner-price d-flex align-items-center\">\n            <span className=\"me-2\">{likeCount ? likeCount : 0}</span>\n            {!validateIfLiked(likedNfts, _id) ? (\n              <img\n                src={Images.whiteEmptyHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"like\", likeCount);\n                }}\n              />\n            ) : (\n              <img\n                src={Images.whiteFillHeart}\n                alt=\"\"\n                onClick={() => {\n                  props.handleLikesTogleApi(_id, \"dislike\", likeCount);\n                }}\n              />\n            )}\n          </div>\n        </Card.Title>\n        <div className=\"nft-status \">\n          <div className=\"status-info status-sold\">\n            <span className=\"status\">\n              Sold:{\" \"}\n              <span className=\"status-count\">{copies - remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n          <div className=\"status-info status-remaining\">\n            <span className=\"status\">\n              Remaining: <span className=\"status-count\">{remainingCopies}</span>{\" \"}\n            </span>\n          </div>\n        </div>\n\n        <div className=\"mt-3\">\n          <span className=\"nft-price mt-2\">\n            <img className=\"me-2\" src={Images.nftPriceTag} />\n            Price:<a className=\"price ms-1\">{currentPrice} ETH</a>\n          </span>\n        </div>\n        <div className=\"nft-card-owner-container d-flex align-items-center mb-2 mt-3\">\n          <div className=\"nft-owner-avatar\">\n            <img\n              src={\n                !profilePhoto && !profileImage\n                  ? placeholderImg\n                  : profilePhoto\n                  ? profilePhoto\n                  : profileImage\n              }\n              alt=\"avatar\"\n            />\n          </div>\n          <div className=\"ms-2 nft-owner-name\">\n            <p>\n              {\"Owned by:\"}\n              <span className=\"text-capitalize ms-1\">\n                {ownerAddress?.toUpperCase() ===\n                props.connectedAddress?.toUpperCase()\n                  ? \"You\"\n                  : username && username?.length > 19\n                  ? username.substring(0, 19) + \"...\"\n                  : username?.length <= 19\n                  ? username\n                  : \"unnamed\"}\n              </span>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"nft-bit-btn\"\n          onClick={() => history.push(`${props.path}${_id}`)}\n        >\n          {\"View Detail\"}\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nconst mapStateToProps = (state: any) => ({\n  connectedAddress: state.wallet.connectedAddress,\n});\n\nexport default connect(mapStateToProps, {})(NFTCard);\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/DarkModeButton/DarkModeButton.tsx",["656"],"import \"./DarkModeButton.css\";\nimport { styled } from \"@mui/material/styles\";\nimport FormGroup from \"@mui/material/FormGroup\";\nimport FormControlLabel from \"@mui/material/FormControlLabel\";\nimport Switch, { SwitchProps } from \"@mui/material/Switch\";\nimport SunImg from \"../../assets/images/sun-fill.svg\";\n\nconst DarkModeButton = (props:any) => {\n  return (\n    <div className=\"toggle-theme-wrapper\">\n      <p>Dark Mode</p>\n      <FormGroup>\n        <FormControlLabel\n          sx={{ mr: 0 }}\n          control={<Android12Switch\n            checked={props.defaultDark}\n            onChange={props.toggleTheme} />} label={undefined}        />\n      </FormGroup>\n    </div>\n  );\n};\n\nexport default DarkModeButton;\n\nconst Android12Switch = styled(Switch)(({ theme }) => ({\n  padding: 8,\n  \"& .Mui-checked\": { color: \"#fff\" },\n  \"& .Mui-checked+.MuiSwitch-track\": {\n    backgroundColor: \"#000 !important\",\n  },\n  \"& .MuiSwitch-track\": {\n    borderRadius: 22 / 2,\n    \"&:before, &:after\": {\n      content: '\"\"',\n      position: \"absolute\",\n      top: \"50%\",\n      transform: \"translateY(-50%)\",\n      width: 16,\n      height: 16,\n    },\n    \"&:before\": {\n      backgroundImage: `url(${SunImg})`,\n      left: \"15px\",\n      backgroundRepeat: \"no-repeat\",\n      height: \"11px\",\n      width: \"11px\",\n    },\n    \"&:after\": {\n      backgroundImage: `url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" height=\"16\" width=\"16\" viewBox=\"0 0 24 24\"><path fill=\"${encodeURIComponent(\n        theme.palette.getContrastText(theme.palette.primary.main)\n      )}\" d=\"M19,13H5V11H19V13Z\" /></svg>')`,\n      right: 12,\n    },\n  },\n  \"& .MuiSwitch-thumb\": {\n    boxShadow: \"none\",\n    width: 16,\n    height: 16,\n    margin: 2,\n  },\n}));\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/CollectionSubLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Audio/Audio.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/auctions/auctions.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Footer/footer.action.js",["657"],"import { ENV } from \"../../config/config\";\nimport {\n  GET_ERRORS,\n  BEFORE_FOOTER,\n  GET_FOOTER,\n  SUBSCRIBE_RESPONSE,\n  SUBSCRIBE,\n} from \"../../redux/types\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport axios from \"axios\";\n\nexport const beforeFooter = () => {\n  return {\n    type: BEFORE_FOOTER,\n  };\n};\n\nexport const getFooter = () => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({ type: SUBSCRIBE });\n  const url = `${ENV.url}/settings/get`;\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.success) {\n        dispatch({\n          type: GET_FOOTER,\n          payload: data.settings,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const subscribeUser = (email) => async (dispatch) => {\n  dispatch(emptyError());\n  try {\n    const response = await axios.post(`${ENV.url}users/subscribe`, { email });\n    dispatch({\n      type: SUBSCRIBE_RESPONSE,\n    });\n    // console.log(response, \"response\");\n  } catch (error) {\n    // console.log(error.response, \"error\");\n    dispatch({\n      type: GET_ERRORS,\n      payload: error.response.data,\n    });\n  }\n};\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/HeroCards/HeroCards.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Offers/offers.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Bids/bids.action.js",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/NftDetailLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Table/Table.tsx",["658"],"import { useEffect, useState } from \"react\";\nimport {\n  BsTagFill,\n  BiTransferAlt,\n  MdShoppingCart,\n  FaHandPaper,\n} from \"react-icons/all\";\nimport ReactTimeAgo from \"react-time-ago\";\nimport { TableInterface } from \"../../interfaces/components\";\nconst Table: React.FC<TableInterface> = ({\n  titles,\n  data,\n  lowestNftPrice,\n  exchangeRate,\n  status,\n}) => {\n  const [info, setInfo] = useState<any>(null);\n\n  useEffect(() => {\n    if (status === \"Offers\") {\n      formateBidsInfo();\n    } else {\n      formateActivityInfo();\n    }\n  }, [data]);\n\n  const getPercentageChange = (oldNumber: number, newNumber: number) => {\n    var decreaseValue = oldNumber - newNumber;\n\n    return (decreaseValue / oldNumber) * 100;\n  };\n\n  const handleAcitivityIcon = (type: string) => {\n    if (type === \"Mint\") {\n      return <MdShoppingCart />;\n    } else if (type === \"List\") {\n      return <BsTagFill />;\n    } else if (type === \"Bid\") {\n      return <FaHandPaper />;\n    } else {\n      return <BiTransferAlt />;\n    }\n  };\n\n  const formateBidsInfo = () => {\n    if (data && data.length > 0) {\n      let formatedData = data.map((item: any) => {\n        return {\n          item1: item.bidAmount,\n          item2: `$ ${(item.bidAmount * exchangeRate).toFixed(2)}`,\n          item3: `${\n            Number(\n              getPercentageChange(item.bidAmount, lowestNftPrice).toFixed(0)\n            ) %\n              item.bidAmount >\n            lowestNftPrice\n              ? \"above\"\n              : \"below\"\n          }`,\n          item4: `${\n            item.fromAddress.slice(0, 4) + \"...\" + item.fromAddress.slice(-4)\n          }`,\n        };\n      });\n      setInfo(formatedData);\n    }\n  };\n\n  const formateActivityInfo = () => {\n    if (data && data.length > 0) {\n      let formatedData: any = data.map((item: any) => {\n        return {\n          item1: (\n            <div className=\"d-flex align-items-center\">\n              {handleAcitivityIcon(item.activityType)}\n              <p className=\"ps-1\"> {item.activityType} </p>\n            </div>\n          ),\n          item2: item.price,\n          item3: `${\n            item.fromAddress\n              ? item.fromAddress.slice(0, 4) +\n                \"...\" +\n                item.fromAddress.slice(-6)\n              : \"null address\"\n          }`,\n          item4: `${\n            item.toAddress\n              ? item.toAddress.slice(0, 4) + \"...\" + item.toAddress.slice(-4)\n              : \"\"\n          }`,\n          item5: (\n            <div>\n              <ReactTimeAgo date={item.createdAt} locale=\"en-US\" />\n            </div>\n          ),\n        };\n      });\n      setInfo(formatedData);\n    }\n  };\n  return (\n    <div className=\"table-container\">\n      <table className=\"table table-borderless\">\n        {data && data.length > 0 && (\n          <thead>\n            <tr>\n              {titles.map((item: any) => {\n                return <th scope=\"col\">{item}</th>;\n              })}\n            </tr>\n          </thead>\n        )}\n        <tbody>\n          {info && info.length > 0 ? (\n            <>\n              {info.map((val: any, index: any) => {\n                return (\n                  <tr key={index}>\n                    <th scope=\"row\">{val.item1}</th>\n                    <td>{val.item2}</td>\n                    <td>{val.item3}</td>\n                    <td>{val.item4}</td>\n                    {val.item5 && <td>{val.item5}</td>}\n                  </tr>\n                );\n              })}\n            </>\n          ) : (\n            <p className=\"text-center d-flex justify-content-center align-items-center\">\n              {` No ${status} Found`}\n            </p>\n          )}\n        </tbody>\n      </table>\n    </div>\n  );\n};\nexport default Table;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/levelsinfo.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/statsinfo.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/ContentLoader/SellNFTLoader.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/BidModal/BidModal.tsx",["659"],"import React, { useState, useEffect,FC } from \"react\";\nimport { Modal, Button } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport \"../BuyModal/BuyModal.css\"\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport axios from \"axios\";\nimport { BidModalInt } from \"../../../interfaces/components\";\n\nconst BidModal:FC<BidModalInt> = (props) => {\n  const [checkBox, setCheckBox] = useState<any>(false);\n  const [exchangeRate, setExchangeRate] = useState<any>(0);\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  const {\n    onChange,\n    decimalNumberValidator,\n    handleModalSubmit,\n    calculatePricePercantage,\n    onHide,\n    balance,\n    price,\n    show,\n  } = props;\n  \n  return (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className={`buy-modal bid-modal ${show === true ? \"modal-is-open\" : \" \"}`}\n      centered\n      autoFocus={true}\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Place a Bid\n        </Modal.Title>\n\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to place bid!\"}\n        </p>\n\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Price</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"bid-inp-container d-flex align-items-center\">\n          <div className=\"inp-container d-flex align-items-center justify-content-between\">\n            <div>\n              <input\n                type=\"number\"\n                placeholder=\"Place Your Bid\"\n                name=\"nftConfig.price.amount\"\n                style={{ borderRadius: \"4px\" }}\n                onChange={(e) => onChange(e)}\n                onKeyDown={(e) => decimalNumberValidator(e)}\n                defaultValue={calculatePricePercantage()}\n                value={price}\n              />\n            </div>\n            <div className=\"dollar-rate text-end\">\n              <p className=\"\">\n                ${price ? (price * exchangeRate).toFixed(2) : 0}\n              </p>\n            </div>\n          </div>\n          <div className=\"inp-currency\">\n            <h6>ETH</h6>\n          </div>\n        </div>\n        <div className=\"bid-balance text-start\">\n          <p>Balance: {Number(balance).toFixed(4)} ETH</p>\n        </div>\n        {balance !== \"\" && balance === 0 && (\n          <p className=\"text-center insufcient-funds text-danger\">\n            Please Add Balance to place bid\n          </p>\n        )}\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\">Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n          onClick={() => {\n            handleModalSubmit();\n            onHide();\n          }}\n          disabled={\n            +price < calculatePricePercantage() ||\n            balance === 0 ||\n            !checkBox ||\n            +price > +balance\n          }\n        >\n          Confirm Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default BidModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/BuyModal/BuyModal.tsx",["660","661","662"],"import { useState,FC } from \"react\";\nimport { Modal, Button, Spinner } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../../assets/images/tick-checkbox.svg\";\nimport { ReactComponent as FbIcon } from \"../../../assets/images/fb-blue.svg\";\nimport { ReactComponent as TwitterIcon } from \"../../../assets/images/twitter-blue.svg\";\nimport { ReactComponent as LinkedinIcon } from \"../../../assets/images/linkedin-blue.svg\";\nimport { ReactComponent as InstaIcon } from \"../../../assets/images/insta-blue.svg\";\nimport { ReactComponent as VideoIcon } from \"../../../assets/images/buy-video-icon.svg\";\nimport { ReactComponent as AudioIcon } from \"../../../assets/images/audio-icon.svg\";\nimport ModalSmiley from \"../../../assets/images/model-smiley.svg\";\nimport { Buy } from \"../../../interfaces/components\";\nconst BuyModal:FC<Buy> = (props) => {\n  const [purchase, setPurchase] = useState<any>(true);\n  const [checkBox, setCheckBox] = useState<any>(false);\n  const {\n    name,\n    image,\n    price,\n    exchangeRate,\n    tokenId,\n    buyNow,\n    confirmed,\n    transactionHash,\n    transactionSuccess,\n    onHide,\n    disabled,\n    balance,\n    fileType,\n  } = props;\n\n  return confirmed === \"\" || confirmed === false || confirmed === \"pending\" ? (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Complete Checkout\n        </Modal.Title>\n        <p className=\"text-danger text-center mt-1 mb-0 insufienct-funds\">\n          {+price > +balance && \"Insufficient funds to buy this NFT\"}\n        </p>\n        <div className=\"modal-close-container\">\n          <Button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                {fileType === \"image\" ? (\n                  <img src={image} alt=\"nft-img\" />\n                ) : fileType === \"video\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <VideoIcon />\n                  </div>\n                ) : fileType === \"audio\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <AudioIcon />\n                  </div>\n                ) : (\n                  \"\"\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container d-flex align-items-center mt-5\">\n            {checkBox ? (\n              <span\n                className=\"custom-checked-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"10\">\n                  <path\n                    fill-rule=\"evenodd\"\n                    fill=\"#FFF\"\n                    d=\"M11.356.624c.034.009-.617.141-.838.368-1.93 1.93-3.692 3.823-5.546 5.712L2.794 4.961h-.001a1.223 1.223 0 0 0-.897-.26c-.321.036-.616.198-.116.45-.904.252-.997.574-.962 1.309.036-.093.342.201.451.403l3.049 2.434a1.218 1.218 0 0 0 1.626-.095C8.138 7.8 10.103 4.854 12.246 2.71A1.22 1.22 0 0 0 12.24.967c.16-.229-.555-.352-.884-.343z\"\n                  />\n                </svg>\n              </span>\n            ) : (\n              <span\n                className=\"custom-uncheck-box me-2\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></span>\n            )}\n            <p>\n              By checking this box, I agree to MintsClub{\" \"}\n              <Link to=\"/termsandconditions\" target=\"_blank\">Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => {\n            buyNow();\n          }}\n          disabled={!checkBox || disabled || +price > +balance}\n          className=\"btn btn-linear-gradient btn-bid-modal mt-2\"\n        >\n          {confirmed === \"pending\" ? (\n            <div className=\"spinner-border approve-spinner\" role=\"status\"></div>\n          ) : (\n            \"Confirm Checkout\"\n          )}\n        </button>\n      </Modal.Footer>\n    </Modal>\n  ) : (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal purchase-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          {!transactionSuccess\n            ? \"Your Purchase is Processing\"\n            : \"Your Purchase has processed!\"}\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        {transactionSuccess && (\n          <div className=\"modal-nft-purchased  mt-3\">\n            <p>\n              <span className=\"me-4\">\n                <img src={ModalSmiley} alt=\"smiley\" />\n              </span>\n              {`  Woo! You just Purchased ${\n                name && name.length > 10 ? name.slice(0, 10) + \"...\" : name\n              }. It should be confirmed on the\n              blockchain`}\n            </p>\n          </div>\n        )}\n        <div className=\"buy-modal-subheadings-container d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Item</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Subtotal</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"row w-100 align-items-center justify-content-center g-4\">\n          <div className=\"col-md-3\">\n            <div className=\"modal-nft-container mx-auto mx-md-0\">\n              <div className=\"modal-nft-img\">\n                {fileType === \"image\" ? (\n                  <img src={image} alt=\"nft-img\" />\n                ) : fileType === \"video\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <VideoIcon />\n                  </div>\n                ) : fileType === \"audio\" ? (\n                  <div className=\"buy-media-wrapper\">\n                    <AudioIcon />\n                  </div>\n                ) : (\n                  \"\"\n                )}\n              </div>\n            </div>\n          </div>\n          <div className=\"col-md-9\">\n            <div className=\"modal-nft-content\">\n              <div className=\"row align-items-center justify-content-between\">\n                <div className=\"col-12 mb-3\">\n                  <div className=\"modal-nft-detail-heading\">\n                    <p>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <span>\n                      {name && name.length > 10\n                        ? name.slice(0, 10) + \"...\"\n                        : name}{\" \"}\n                      # {tokenId}\n                    </span>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>\n                      {price} <span>ETH</span>\n                    </p>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail\">\n                    <h6>\n                      Creator Fees: <span>5%</span>\n                    </h6>\n                  </div>\n                </div>\n                <div className=\"col-6\">\n                  <div className=\"modal-nft-detail text-end\">\n                    <p>${(price * exchangeRate).toFixed(2)}</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"row w-100 align-items-center total-row mt-3\">\n          <div className=\"col-4\">\n            <div className=\"modal-nft-detail\">\n              <p>Total</p>\n            </div>\n          </div>\n          <div className=\"col-8\">\n            <div className=\"modal-nft-detail text-end\">\n              <h6>\n                {price} <span>ETH</span>\n              </h6>\n              <span>${(price * exchangeRate).toFixed(2)}</span>\n            </div>\n          </div>\n        </div>\n        <div className=\"buy-modal-subheadings-container buy-modal-status w-100 d-flex justify-content-between align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Status</p>\n          </div>\n          <div className=\"buy-modal-subheadings\">\n            <p>Transaction Hash</p>\n          </div>\n        </div>\n        <div className=\"modal-status-content d-flex align-items-center justify-content-between mt-2 pb-5\">\n          <div className=\"status-process d-flex align-items-center\">\n            {!transactionSuccess ? (\n              <>\n                <Spinner\n                  animation=\"border\"\n                  role=\"status\"\n                  size=\"sm\"\n                  variant=\"primary\"\n                  className=\"me-2\"\n                ></Spinner>\n                <p>Processing</p>\n              </>\n            ) : (\n              <>\n                <CheckCircleIcon />\n              </>\n            )}\n          </div>\n          <div\n            className=\"status-address\"\n            onClick={() =>\n              window.open(\n                `https://rinkeby.etherscan.io/tx/${transactionHash}`,\n                \"_blank\"\n              )\n            }\n          >\n            <p>\n              {transactionHash.slice(0, 6) +\n                \".....\" +\n                transactionHash.slice(-6)}\n            </p>\n          </div>\n        </div>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <p>Share</p>\n        </div>\n        <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n\n          <FbIcon className=\"social-icon\" onClick={()=>window.open(\"https://www.facebook.com/MintsClub.io/\")} />\n          <TwitterIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://twitter.com/MintsClub\")}/>\n          <LinkedinIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://www.linkedin.com/showcase/mints-club\")}/>\n          <InstaIcon  className=\"social-icon\"   onClick={()=>window.open(\"https://www.instagram.com/mintsclub/\")}/>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\nexport default BuyModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/ApprovalModal/ApprovalModal.tsx",["663","664","665"],"import {FC} from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport { Spin } from \"react-cssfx-loading\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport { Images } from \"../../../assets/assets\";\nimport { ApprovalModalInt } from \"../../../interfaces/components\";\nimport \"./ApprovalModal.css\";\n\nconst ApprovalModal:FC<ApprovalModalInt> = ({\n  approvalStatus,\n  approveAccount,\n  show,\n  onHide,\n  address,\n}) => {\n  return (\n    <>\n      {\n        <Modal\n          show={show}\n          onHide={onHide}\n          size=\"lg\"\n          dialogClassName=\"approval-modal-dialog\"\n          contentClassName=\"approval-modal-content\"\n          className=\"approval-modal\"\n          centered\n        >\n          <Modal.Header>\n            <Modal.Title className=\"acc-title mt-lg-3 mt-5\">\n              {approvalStatus === \"approved\"\n                ? \"Congratulations\"\n                : approvalStatus === \"in-progress\"\n                ? \"We’re on it\"\n                : \"Your account if not approved yet.\"}\n            </Modal.Title>\n            <div className=\"modal-close-container\" onClick={onHide}>\n              <button>\n                <img src={ModalClose} alt=\"closemodal\" />\n              </button>\n            </div>\n          </Modal.Header>\n          <Modal.Body>\n            {approvalStatus === \"approved\" ? (\n              <>\n                <img src={Images.sellerTickIcon} className=\"success-icon\" />\n                <div className=\"w-100 px-4 mb-2\">\n                  <div className=\"acc-approved-container mt-5 mb-5\">\n                    <p className=\"acc-approved ms-4 mb-0\">\n                      Your Account has been approved.\n                    </p>\n                    <img src={Images.smile} className=\"smile-img\" />\n                  </div>\n                </div>\n              </>\n            ) : approvalStatus === \"in-progress\" ? (\n              <>\n                <div className=\"approval-spinner mb-4\">\n                  <Spin color=\"#5666FE\" width=\"60px\" height=\"60px\"></Spin>\n                </div>\n                <p className=\"processing-title text-center w-100\">\n                  Processing...\n                </p>\n                <div className=\"w-100 px-3\">\n                  <p className=\"approve-msg text-start ms-3 mt-3 \">\n                    Wallet Address\n                  </p>\n                  <input\n                    className=\"input-common mb-5\"\n                    value={address}\n                    readOnly\n                  />\n                </div>\n              </>\n            ) : (\n              <>\n                <img\n                  src={Images.metamaskImg}\n                  className=\"approve-metamask-img\"\n                />\n                <div className=\" w-100 px-3\">\n                  <p className=\"approve-msg w-100 text-start ms-3 mt-3 \">\n                    Please approve your wallet address to reach us\n                  </p>\n                  <input className=\"input-common\" value={address} readOnly />\n                </div>\n                <button\n                  className=\"btn btn-linear-gradient mt-4 my-4 get-approved-btn\"\n                  disabled={approvalStatus === \"pending\"}\n                  onClick={() => approveAccount()}\n                >\n                  {approvalStatus === \"pending\" ? (\n                    <div\n                      className=\"spinner-border approve-spinner\"\n                      role=\"status\"\n                    ></div>\n                  ) : (\n                    \"Get Approved\"\n                  )}\n                </button>\n              </>\n            )}\n          </Modal.Body>\n        </Modal>\n       \n      }\n    </>\n  );\n};\nexport default ApprovalModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/StatsModal/StatsModal.tsx",["666"],"import {FC} from \"react\";\nimport { Modal } from \"react-bootstrap\";\nimport ModalClose from \"../../../assets/images/modal-close.svg\";\nimport InputClose from \"../../../assets/images/inp-close.svg\";\nimport \"../PropertiesModal/PropertiesModal.css\";\nimport { toast } from \"react-toastify\";\nimport {\n  decimalNumberValidator,\n  firstInputCharacterSpace,\n} from \"../../../utils/functions\";\nimport {StatsInt} from \"../../../interfaces/components\";\nconst StatsModal:FC<StatsInt> = (props) => {\n  const { show, onHide } = props;\n  const { addMoreValues, handleChange, removeFormFields, stats, onSave } =\n    props;\n  const handleSubmit = () => {\n    if (stats && stats.length > 0) {\n      let isEmpty = stats.filter(\n        (item:any) => item.name === \"\" || item.value === \"\"\n      );\n      if (isEmpty.length > 0) {\n        toast.error(\"Please Fill Empty Fields \");\n        return \"\";\n      } else {\n        onSave(\"stats\");\n      }\n    }\n  };\n  return (\n    <Modal\n      {...props}\n      show={show}\n      onHide={onHide}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal properties-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">Add Stats</Modal.Title>\n\n        <div className=\"modal-close-container\">\n          <button onClick={onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </button>\n        </div>\n      </Modal.Header>\n      <Modal.Body className=\"mt-0 pt-0 px-0 px-sm-3\">\n        <form>\n          <div className=\"nft-modalfields-container pe-2 pe-sm-0 px-sm-2 py-sm-2\">\n            {stats &&\n              stats.length > 0 &&\n              stats.map((item:any, i:any) => {\n                return (\n                  <div\n                    className=\"row g-2 align-items-center justify-content-between mt-3\"\n                    key={i}\n                  >\n                    <div className=\"col-sm-5 order-1 order-sm-0 mt-0\">\n                      <div className=\"bid-inp-container d-flex align-items-center mt-0\">\n                        <div className=\"ps-2\">\n                          <h6>Name:</h6>\n                        </div>\n                        <div className=\"inp-container\">\n                          <input\n                            type=\"text\"\n                            name=\"name\"\n                            value={item.name}\n                            onKeyDown={(e) =>\n                              firstInputCharacterSpace(e, item.name.length)\n                            }\n                            onChange={(e) => handleChange(i, e, \"stats\")}\n                            autoComplete=\"off\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-5 order-2 order-sm-1 mt-3 mt-sm-0\">\n                      <div className=\"d-flex align-items-center justify-content-between\">\n                        <div className=\"bid-inp-container modal-value-inp d-flex align-items-center\">\n                          <div className=\"ps-2\">\n                            <h6>Value:</h6>\n                          </div>\n                          <div className=\"inp-container\">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              min=\"1\"\n                              onKeyDown={(e) => {\n                                decimalNumberValidator(e);\n                              }}\n                              value={item.value}\n                              onChange={(e) => {\n                                if (\n                                  +e.target.value > 5 ||\n                                  (+e.target.value <= 0 && item.value == \"\")\n                                  ||e.target.value.includes(\".\")\n                                ) {\n                                  return \"\";\n                                }\n                                handleChange(i, e, \"stats\");\n                              }}\n                              autoComplete=\"off\"\n                            />\n                          </div>\n                        </div>\n                        <div className=\"value-inp-of mx-3\">\n                          <h6>of</h6>\n                        </div>\n                        <div className=\"bid-inp-container modal-value-inp\">\n                          <div className=\"inp-container \">\n                            <input\n                              type=\"number\"\n                              name=\"value\"\n                              value={5}\n                              autoComplete=\"off\"\n                              className=\"text-center\"\n                            />\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                    <div className=\"col-sm-1 order-0 order-sm-2 mb-2 mb-sm-0\">\n                      <div className=\"inp-close text-end me-2\">\n                        <button type=\"submit\">\n                          <img\n                            src={InputClose}\n                            alt=\"closemodal\"\n                            onClick={() => removeFormFields(i, \"stats\")}\n                          />\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n          </div>\n        </form>\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer d-flex align-items-center\">\n          <button\n            className=\"btn modal-btn-addMore mt-2\"\n            onClick={() => addMoreValues(\"stats\")}\n          >\n            Add more\n          </button>\n          <button\n            className=\"btn btn-linear-gradient modal-btn-save mt-2 ms-3\"\n            disabled={stats && stats.length === 0}\n            onClick={handleSubmit}\n          >\n            Save\n          </button>\n        </div>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default StatsModal;\n","/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/pages/create-nft/components/propertiesinfo.tsx",[],"/home/usman/integrate-mintsClub-ariswap/mitsclub-front-v2/frontend-v2/frontend/src/Components/Modals/LevelsModal/LevelsModal.tsx",["667