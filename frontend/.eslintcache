0 C18.241,13.840 19.432,12.650 19.432,11.202 C19.432,9.753 18.241,8.562 16.793,8.562 L16.793,8.562 ZM4.798,10.2 C5.469,10.2 5.997,10.531 5.997,11.202 C5.997,11.872 5.469,12.401 4.798,12.401 C4.127,12.401 3.598,11.872 3.598,11.202 C3.598,10.531 4.127,10.2 4.798,10.2 ZM16.793,10.2 C17.464,10.2 17.992,10.531 17.992,11.202 C17.992,11.872 17.464,12.401 16.793,12.401 C16.122,12.401 15.593,11.872 15.593,11.202 C15.593,10.531 16.122,10.2 16.793,10.2 L16.793,10.2 Z\"\r\n                  />\r\n                </svg>\r\n                <p className=\"ms-1\">Explore</p>\r\n              </Link>\r\n            </div>\r\n            <div className=\"d-lg-none d-flex watch-video align-items-center mt-5 mb-4\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-6 col-xl-7 \">\r\n            <Slider\r\n              setHandler={setHandler}\r\n              sliderRadioButtons={sliderRadioButtons}\r\n              handleRadioInputs={handleRadioInputs}\r\n              sliderChecked={sliderChecked}\r\n            />\r\n          </div>\r\n          <div className=\"d-none d-lg-block col-12 col-lg-7\">\r\n            <div className=\"watch-video d-flex align-items-center\">\r\n              <img src={PlayIcon} alt=\"playIcon\" className=\"me-2\" />\r\n              <span>Watch video to learn more</span>\r\n            </div>\r\n          </div>\r\n          <div className=\"col-12 col-lg-5\">\r\n            <div className=\"btn-container mx-auto mx-lg-0\">\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn me-3\"\r\n                onClick={prevBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-left\"></i>\r\n              </button>\r\n              <button\r\n                className=\"hero-slider-btn card-slider-btn\"\r\n                onClick={nextBtnHandler}\r\n              >\r\n                <i class=\"fas fa-arrow-right\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default Hero;\r\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/navbar-main/NavbarMain.js",["681","682"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/owncollection/OwnCollection.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/buy-sell/Buysell.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/assets/assets.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/breadcrumb/breadcrumb.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/test-video-card/videoCard.js",["683"],"import React, { useRef } from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./videoCard.css\";\nimport useVideoPlayer from \"./components/useVideoPlayer\";\nimport { ENV } from \"../../config/config\";\nimport { BsFillPlayFill, BsFillPauseFill } from \"react-icons/bs\";\n\nconst VideoCard = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  ownerId,\n  sellingMethod,\n  userProfile,\n  auctionStartDate,\n  auctionEndDate,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n  const videoElement = useRef(null);\n  const { playerState, togglePlay, handleOnTimeUpdate } =\n    useVideoPlayer(videoElement);\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div className=\"auction-img-wrapper\">\n        <div className=\"card-img-top\">\n          <div className=\"video-wrapper\">\n            <video\n              src={CardImg}\n              ref={videoElement}\n              onTimeUpdate={handleOnTimeUpdate}\n            />\n            <div className=\"controls\">\n              <div className=\"actions\">\n                <button\n                  className=\"play-pause-btn d-flex align-items-center justify-content-center\"\n                  onClick={togglePlay}\n                >\n                  {playerState.isPlaying ? (\n                    <BsFillPauseFill />\n                  ) : (\n                    <BsFillPlayFill />\n                  )}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default VideoCard;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/filter-component/FilterComponent.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/redux/types/types.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/listing-cards/ListingCards.js",["684","685"],"import React from \"react\";\nimport { useHistory } from \"react-router\";\nimport { Card } from \"react-bootstrap\";\nimport CardImg from \"../../assets/images/cl-cr-mainimg.png\";\nimport HeartIcon from \"../../assets/images/unlike-icon.svg\";\nimport { AiFillHeart } from \"react-icons/ai\";\nimport \"./ListingCards.css\";\nimport { ENV } from \"../../config/config\";\n\nconst ListingCards = ({\n  CardImg,\n  handleLikesTogleApi,\n  id,\n  name,\n  price,\n  likesCount,\n  liked,\n  likedNfts,\n  userProfile,\n  ownerId,\n  sellingMethod,\n  auctionStartDate,\n  auctionEndDate,\n}) => {\n  const history = useHistory();\n  const [toggle, setToggle] = React.useState(true);\n  React.useEffect(() => {\n    return () => \"\";\n  }, [toggle]);\n\n  const validateIfLiked = (likedNfts1, id) => {\n    if (likedNfts && likedNfts?.length > 0) {\n      let result = likedNfts.find((item) => item.nftId == id);\n      if (result) {\n        return true;\n      } else {\n        return false;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  const checkIfAuctionStartedorEnded = (startDate, endDate) => {\n    if (startDate !== null || endDate !== null) {\n      let currentDate = new Date();\n      let auctionStartDate = new Date(startDate);\n      let auctionEndDate = new Date(endDate);\n\n      if (\n        auctionStartDate.setHours(0, 0, 0, 0) <=\n          currentDate.setHours(0, 0, 0, 0) &&\n        auctionEndDate.setHours(0, 0, 0, 0) >= currentDate.setHours(0, 0, 0, 0)\n      ) {\n        return true;\n      }\n    } else {\n      return false;\n    }\n  };\n\n  return (\n    <Card className=\"auction-card listing-card\">\n      <div\n        className=\"auction-img-wrapper listing-img-wrapper\"\n        onClick={() => history.push(`/nftdetail/${id}`)}\n      >\n        <Card.Img variant=\"top\" src={CardImg} alt=\"AuctionTopImg\" />\n      </div>\n      <Card.Body className=\"d-flex flex-column\">\n        <div className=\"listing-card-title-container d-flex align-items-center justify-content-between\">\n          <Card.Title onClick={() => history.push(`/nftdetail/${id}`)}>\n            {name ? name : \"item name\"}\n          </Card.Title>\n          {!userProfile && (\n            <div className=\"options-icon like-icon text-white\">\n              {validateIfLiked(likedNfts, id) ? (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <AiFillHeart\n                    className=\"heart-fill-icon \"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"dislike\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />{\" \"}\n                  <p> {likesCount ? likesCount : 0} </p>\n                </div>\n              ) : (\n                <div className=\"heart-filled-container d-flex align-items-end\">\n                  <img\n                    src={HeartIcon}\n                    alt=\"OptionsIcon\"\n                    onClick={() => {\n                      handleLikesTogleApi(id, \"like\", likesCount);\n                      setToggle(!toggle);\n                    }}\n                  />\n                  <p className=\"ms-1\"> {likesCount ? likesCount : 0} </p>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        <div\n          className=\"auction-card-owner-container d-flex justify-content-between align-items-center mb-2\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <div className=\"auction-owner-name\">\n            <p>Price</p>\n          </div>\n          <div className=\"d-flex align-items-center\">\n            <span>{price} ETH</span>\n          </div>\n        </div>\n        <button\n          className=\"auction-bit-btn listing-buy-btn d-flex align-items-center justify-content-center\"\n          onClick={() => history.push(`/nftdetail/${id}`)}\n        >\n          <p>\n            {ownerId === ENV.getUserKeys(\"_id\")._id ||\n            !sellingMethod ||\n            !checkIfAuctionStartedorEnded(auctionStartDate, auctionEndDate)\n              ? \"View\"\n              : sellingMethod === 2\n              ? \"Place Bid\"\n              : \"Buy Now\"}\n          </p>\n        </button>\n      </Card.Body>\n    </Card>\n  );\n};\n\nexport default ListingCards;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/scroll-up/sroll-up.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/offers/offers.action.js",["686"],"import { toast } from 'react-toastify';\nimport { GET_ERRORS, BEFORE_OFFER, GET_OFFERS, DELETE_OFFER, CREATE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport { ENV } from './../../config/config';\nimport {SellOnFixedPrice, acceptNftOffer} from '../../utils/web3'\nexport const beforeOffer = () => {\n    return {\n        type: BEFORE_OFFER\n    }\n};\n\nexport const makeOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/offer/create`;\n\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n        console.log(data,\"data\")\n        if (data.success) {\n            // SellOnFixedPrice(tokenId,price)\n            toast.success(data.message)\n            dispatch({\n                type: CREATE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        console.log(error,\"error\")\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const getOffers = (qs = '') => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/list`;\n    if (qs)\n        url += `?${qs}`\n\n   \n    fetch(url, {\n        method: 'GET',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n   console.log(data,\"data\")\n        if (data.success) {\n            dispatch({\n                type: GET_OFFERS,\n                payload: data.data\n            })\n        } else {\n            if (!qs)\n                toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const deleteOffer = (offerId) => dispatch => {\n    dispatch(emptyError());\n    let url = `${ENV.url}offer/delete/${offerId}`;\n\n    fetch(url, {\n        method: 'DELETE',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        }\n    }).then(res => res.json()).then(data => {\n        if (data.success) {\n            toast.success(data.message)\n            dispatch({\n                type: DELETE_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\n\nexport const acceptOffer = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}offer/accept`;\n\n    fetch(url, {\n        method: 'PUT',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            acceptNftOffer(body);\n            toast.success(data.message)\n            dispatch({\n                type: ACCEPT_OFFER,\n                payload: data\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n        if (error.response && error.response.data) {\n            const { data } = error.response\n            if (data.message)\n                toast.error(data.message)\n        }\n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};\nexport const buyNow = (body) => dispatch => {\n    dispatch(emptyError());\n    const url = `${ENV.url}nfts/buyNft`;\nconsole.log(\"sending buy now djfjlkdjsfljsdklf\")\n    fetch(url, {\n        method: 'POST',\n        headers: {\n            'content-type': 'application/json',\n            'Authorization': ENV.Authorization,\n            'x-auth-token': ENV.x_auth_token,\n            'Access-Control-Allow-Origin': '*',\n            'x-access-token': ENV.getUserKeys('accessToken') && ENV.getUserKeys('accessToken').accessToken ? ENV.getUserKeys('accessToken').accessToken : ''\n        },\n        body: JSON.stringify(body)\n    }).then(res => res.json()).then(data => {\n\n        if (data.success) {\n            \n            dispatch({\n                type: BUY_NOW,\n            })\n        } else {\n            toast.error(data.message)\n            dispatch({\n                type: GET_ERRORS,\n                payload: data\n            })\n        }\n    }).catch(error => {\n      \n        dispatch({\n            type: GET_ERRORS,\n            payload: error\n        })\n    })\n};","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/bids/bids.action.js",["687","688"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/utils/exportData.js",["689"],"import nft1 from \"../assets/images/nft1.jpg\";\nimport nft2 from \"../assets/images/nft2.webp\";\nimport nft3 from '../assets/images//nft3.jpeg';\nimport nft4 from \"../assets/images/nft4.webp\";\nimport nft5 from \"../assets/images/nft5.jpg\";\nimport {\n  AiFillHeart,\n  BsTagFill,\n  GrTransaction,\n  MdShoppingCart,\n} from \"react-icons/all\";\nexport const WordsFamousNfts = [\n    {\n      img: nft3,\n      link: \"https://niftygateway.com/itemdetail/primary/0x0151834a6997f89eb8372ac54ac077d79bb4d1e0/7\",\n    },\n    {\n      img: nft1,\n      link: \"https://onlineonly.christies.com/s/beeple-first-5000-days/beeple-b-1981-1/112924?ldp_breadcrumb=back\",\n    },\n    {\n      img: nft2,\n      link: \"https://niftygateway.com/marketplace?collection=0x12f28e2106ce8fd8464885b80ea865e98b465149&tokenId=100010001\",\n    },\n    { img: nft4, link: \"https://foundation.app/@snowden/~/24437\" },\n    { img: nft5, link: \"https://www.phillips.com/mdj\" },\n  ];\n\n\n  export const iconByActivity={\n    minted:<MdShoppingCart/>,\n    transfer:<GrTransaction/>,\n    list:<BsTagFill/>\n  }","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/utils/functions.js",["690","691","692","693","694","695","696","697","698"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/BidModal.js",["699","700","701","702"],"import React, { useState, useEffect } from \"react\";\nimport { Modal, Button } from \"react-bootstrap\";\nimport { Link } from \"react-router-dom\";\nimport ModalClose from \"../../assets/images/modal-close.svg\";\nimport NftImg from \"../../assets/images/listingImg3.png\";\nimport \"./BuyModal.css\";\nimport CheckCircleIcon from \"@mui/icons-material/CheckCircle\";\nimport TickIcon from \"../../assets/images/tick-checkbox.svg\";\nimport axios from \"axios\";\n\nconst BidModal = (props) => {\n  const [bid, setBid] = useState();\n  const [checkBox, setCheckBox] = useState(false);\n  const [exchangeRate, setExchangeRate] = useState(0);\n  useEffect(() => {\n    axios\n      .get(\n        \"https://min-api.cryptocompare.com/data/price?fsym=ETH&tsyms=USD,ETH\"\n      )\n      .then((res) => {\n        const currentUSD = res.data.USD;\n        setExchangeRate(currentUSD);\n      });\n  }, []);\n  const {\n    onChange,\n    decimalNumberValidator,\n    handleModalSubmit,\n    calculatePricePercantage,\n    onHide,\n    balance,\n    price,\n  } = props;\n\n  return (\n    <Modal\n      {...props}\n      size=\"lg\"\n      dialogClassName=\"buy-modal-dialog\"\n      contentClassName=\"buy-modal-content\"\n      className=\"buy-modal bid-modal\"\n      centered\n    >\n      <Modal.Header>\n        <Modal.Title id=\"contained-modal-title-vcenter\">\n          Place a Bid\n        </Modal.Title>\n        <div className=\"modal-close-container\">\n          <Button onClick={props.onHide}>\n            <img src={ModalClose} alt=\"closemodal\" />\n          </Button>\n        </div>\n        <div className=\"buy-modal-subheadings-container d-flex align-items-center\">\n          <div className=\"buy-modal-subheadings\">\n            <p>Price</p>\n          </div>\n        </div>\n      </Modal.Header>\n      <Modal.Body>\n        <div className=\"bid-inp-container d-flex align-items-center\">\n          <div className=\"inp-container\">\n            <input\n              type=\"number\"\n              placeholder=\"Place Your Bid\"\n              name=\"nftConfig.price.amount\"\n              style={{ borderRadius: \"4px\" }}\n              onChange={(e) => onChange(e)}\n              onKeyDown={(e) => decimalNumberValidator(e)}\n              defaultValue={calculatePricePercantage()}\n              // disabled={balance===0?true:false}\n\n              value={price}\n            />\n\n            <div className=\"dollar-rate text-end\">\n              <p className=\"\">\n                ${price ? (price * exchangeRate).toFixed(2) : 0}\n              </p>\n            </div>\n          </div>\n          <div className=\"inp-currency\">\n            <h6>ETH</h6>\n          </div>\n        </div>\n        <div className=\"bid-balance\">\n          <p>Balance: {Number(balance).toFixed(4)} ETH</p>\n        </div>\n        {balance !== \"\" && balance === 0 && (\n          <p className=\"text-center text-danger\">\n            Please Add Balance to place bid\n          </p>\n        )}\n      </Modal.Body>\n      <Modal.Footer>\n        <div className=\"modal-nft-footer\">\n          <div className=\"checkbox-container\">\n            {checkBox ? (\n              <div\n                className=\"custom-checked-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              >\n                <img src={TickIcon} alt=\"checked\" />\n              </div>\n            ) : (\n              <div\n                className=\"custom-uncheck-box\"\n                onClick={() => setCheckBox(!checkBox)}\n              ></div>\n            )}\n            <p>\n              By checking this box,I agree to MintsClub{\" \"}\n              <Link>Terms of Services</Link>\n            </p>\n          </div>\n        </div>\n        <button\n          className=\"btn btn-linear-gradient mt-2\"\n          onClick={() => {\n            handleModalSubmit();\n            onHide();\n          }}\n          disabled={price < calculatePricePercantage() || balance === 0}\n        >\n          Confirm Checkout\n        </button>\n      </Modal.Footer>\n    </Modal>\n  );\n};\n\nexport default BidModal;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/BuyModal.js",["703","704","705","706","707","708","709","710","711"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/test-video-card/components/useVideoPlayer.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions/auctions.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/explore/explore-items.js",["712","713","714","715","716","717","718"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nimport NftCard from '../collections/components/NftCard/NftCard'\nconst initData = {\n    btn_1: \"Load More\",\n}\n\nfunction ExploreItems(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n\n    useEffect(() => {\n        // get NFTs for explore section\n        const nftQS = { page: 1, limit: 4, explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }, [])\n\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            if (nftsData) {\n                setNFTs(nftsData.nfts)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n                setLoader(false)\n                if (props.setView)\n                    props.setViewAll(nftsData.nfts && nftsData.nfts.length > 0)\n            }\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n\n        // get more NFTs for explore section\n        const nftQS = { page: 1, limit: limit * (page + 1), explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n    return (\n        <>\n            {/* <div className={`row items ${props.class1 ? props.class1 : ''} ${!nfts.length ? 'justify-content-center' : ''}`}> */}\n            <div className=\"row\">\n            <div className=\"row justify-content-center mt-5 w-100\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                {/* <span>{initData.pre_heading}</span> */}\n                                <span>Explore</span>\n                                {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                                    <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                            </div>\n                        </div>\n                    </div>\n\n                {\n                    props.nfts && props.nfts.length > 0 ?\n                        props.nfts.map((item, idx) => {\n                            return (\n                                \n                                // <div key={`${props.key}_${idx}`} className={`col-12 col-sm-6 col-lg-3 item d-block ${props.class2 ? props.class2 : ''}`}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <Link to=\"/author\">\n                                //                         <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6>\n                                //                     </Link>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     {/* <span>{item.sold} of {item.copies}</span> */}\n                                //                 </div>\n                                //                 {/* <Link className=\"btn btn-bordered-white btn-smaller mt-3\" to=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</Link> */}\n                                //             </div>http://3.142.91.8/authorshttp://3.142.91.8/authors\n                                //         </div>\n                                //     </div>\n                                // </div>\n                                     \n                      <>\n                     \n                                     <div className=\"col-4 mt-5\">\n                                     <NftCard/>\n                                     </div>\n\n                                     </>\n                              \n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Explore</p>\n                }  </div>\n            {/* </div> */}\n            {\n                props.loadMoreBtn &&\n                <div className=\"row\">\n                    <div className=\"col-12 text-center\">\n                        <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                    </div>\n                </div>\n            }\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs })(ExploreItems);","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/auctions-cards/AuctionsCards.js",["719","720","721","722","723","724","725"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections/components/NftCard/NftCard.js",["726","727"],"import react from \"react\";\nimport { Link } from \"react-router-dom\";\nimport \"./NftCard.css\";\n\nconst NftCard = (props) => {\n  const filterCreator = (nft) => {\n    const result = props.creators.find((item) => item._id === nft.nftOwnerId);\n    if (result?.username) {\n      return result?.username;\n    } else {\n      return \"no username found\";\n    }\n  };\n  const { userId, nft } = props;\n  return (\n    <div className=\"NftCard-Container \">\n      <Link to={`/item-details?item=${window.btoa(props.nft._id)}`}>\n        <img\n          src={\n            props?.nft?.image ? props.nft.image : \"https://picsum.photos/200\"\n          }\n          alt=\"testinImage\"\n          className=\"nft-car-img\"\n        />\n      </Link>\n\n      <div className=\"NftCard-description p-3\">\n        <p className=\"mb-0 text-white\">\n          {props?.nft?.name ? props.nft.name : \"someTHing\"}\n        </p>\n        <p className=\"text-white\">Owned By: {filterCreator(props.nft)}</p>\n        <div className=\"d-flex w-100 justify-content-between\">\n          <p className=\"mb-0 text-white\">\n            {props?.nft?.currentPrice ? props.nft.currentPrice : \"0.04\"}\n          </p>\n          <p className=\"mt-0 text-white\">\n            {props?.nft?.sold ? props.nft.sold : \"0\"} out of {props.nft.copies}\n          </p>\n        </div>\n        <div className=\"py-3\">\n          <Link\n            to={`/item-details?item=${window.btoa(props.nft._id)}`}\n            id=\"wallet-address\"\n            className=\"btn ml-lg-auto btn-bordered-white\"\n          >\n            <i className=\"icon-wallet mr-md-2\" />\n            {nft.nftOwnerId === userId\n              ? \"Sell NFT\"\n              : nft.sellingMethod === undefined\n              ? \"NFT Details\"\n              : nft.nftOwnerId !== userId && nft.sellingMethod == 1\n              ? \"Buy Now\"\n              : \"Place a Bid\"}\n          </Link>\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default NftCard;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/footer/footer.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/card-slider/CardSlider.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/collections-cards/CollectionsCard.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/hero/component/slider.js",["728","729","730","731","732","733"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/hero-cards/HeroCards.js",["734","735"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/wallet/wallet.action.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/components/upload.js",["736","737"],"import VideoComponent from \"../../videoComponent/videoComponent\";\nimport UploadIcon from \"../../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\nimport AudioPlayer from \"../../audioPlayer/AudioPlayer\";\nimport \"./upload.css\";\nconst videoStyles = {\n  width: \"100%\",\n  height: \"100%\",\n};\n\nconst Upload = ({\n  Images,\n  onFileChange,\n  imageURL,\n  onDrop,\n  dragOver,\n  dragEnter,\n  dragLeave,\n  videoURL,\n  audioSrc,\n  clearData,\n}) => {\n  return (\n    <label\n      className=\"w-100\"\n      onDrop={(e) => onDrop(e)}\n      onDragOver={(e) => dragOver(e)}\n      onDragEnter={(e) => dragEnter(e)}\n      onDragLeave={(e) => dragLeave(e)}\n    >\n      <div className=\"upload-image-border p-4 position-relative\">\n        {imageURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose\n              color=\"#e33d0bc2\"\n              className=\"uploaded-cross-icon\"\n              onClick={() => clearData()}\n            />\n            <img className=\"upload-image\" src={imageURL} alt=\"upload-image\" />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : videoURL ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <VideoComponent\n              videoUrl={videoURL}\n              videoStyles={videoStyles}\n              videoWidth=\"300\"\n            />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n          </div>\n        ) : audioSrc ? (\n          <div className=\"nft-uploaded-img-container\">\n            <MdClose color=\"#e33d0bc2\" className=\"uploaded-cross-icon\" />\n            <AudioPlayer audioSrc={audioSrc} />\n            <img\n              src={UploadIcon}\n              alt=\"upload-icon\"\n              className=\"nft-upload-icon\"\n            />\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={onFileChange}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </div>\n        ) : (\n          <>\n            {\" \"}\n            <img\n              className=\"upload-image-place-holder\"\n              src={Images.uploadImage}\n              alt=\"upload-image\"\n            />\n            <div className=\"upload-details text-center mt-2\">\n              <p>Drag and drop your file</p>\n              <p>PNG, GIF, WEBP, MP4 or MP3. Max 100mb.</p>\n            </div>\n            <input\n              type=\"file\"\n              style={{ display: \"none\" }}\n              onChange={(e) => onFileChange(e, \"onChange\")}\n              accept=\".mp4, .png,.jpeg\"\n              name=\"image\"\n            />\n          </>\n        )}\n      </div>\n    </label>\n  );\n};\n\nexport default Upload;\n","/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/videoComponent/videoComponent.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/PropertiesModal.js",["738","739"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/LevelsModal.js",["740","741"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/modals/StatsModal.js",["742","743"],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/components/statsinfo.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/components/levelsinfo.js",[],"/home/adnan/Desktop/mintsClubFrontendV2/frontend-v2/frontend/src/components/create-nft/components/propertiesinfo.js",[],{"ruleId":"744","replacedBy":"745"},{"rule