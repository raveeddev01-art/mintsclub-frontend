lub-ariswap/ariswap/frontend/src/components/hero-slider/CustomSlider.js",["901","902","903","904","905","906"],"import React, { useState } from \"react\";\nimport HeroCards from \"../../Screens/rough/hero-cards/HeroCards\";\nimport AuctionsCards from \"../../Screens/rough/auctions-cards/AuctionsCards\";\nimport SliderNextIcon from \"../../assets/images/slidernextArrow.png\";\nimport SliderPrevIcon from \"../../assets/images/sliderprevArrow.png\";\nimport \"./CustomSlider.css\";\n\nconst sliderData = [\n  {\n    id: 1,\n    content: <HeroCards />,\n  },\n  {\n    id: 2,\n    content: <AuctionsCards />,\n  },\n  {\n    id: 3,\n    content: <HeroCards />,\n  },\n  {\n    id: 4,\n    content: <AuctionsCards />,\n  },\n  {\n    id: 5,\n    content: <HeroCards />,\n  },\n  {\n    id: 6,\n    content: <HeroCards />,\n  },\n];\n\nconst CustomSlider = () => {\n  const [current, setCurrent] = useState(0);\n  const [prevSlide, setPreviousSlide] = useState(null);\n  const [nextSlide, setNextSlide] = useState(current + 1);\n  const [secondNextSlide, setSecondNextSlide] = useState(current + 2);\n  const length = sliderData.length;\n\n  const nextSlideMove = () => {\n    setCurrent(current === length - 1 ? 0 : current + 1);\n  };\n\n  const prevSlideMove = () => {\n    setCurrent(current === 0 ? length - 1 : current - 1);\n  };\n  return (\n    <section className=\"customHeroSlider\">\n      {sliderData.map((slide, id) => {\n        return (\n          <div>\n            <div className={id === current ? \"slide active\" : \"slide\"} key={id}>\n              {slide.content}\n            </div>\n          </div>\n        );\n      })}\n      <div className=\"text-end\">\n        <button className=\"card-slider-btn mb-4 me-3\" onClick={nextSlideMove}>\n          <img src={SliderPrevIcon} alt=\"SliderPrevButton\" />\n        </button>\n        <button className=\"card-slider-btn mb-4\" onClick={prevSlideMove}>\n          <img src={SliderNextIcon} alt=\"SliderNextButton\" />\n        </button>\n      </div>\n    </section>\n  );\n};\n\nexport default CustomSlider;\n","/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/hero-cards/HeroCards.js",["907"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero-slider/HeroSlickSlider.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero/component/slider.js",["908","909","910"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/hero-slider/HeroSliderSetting.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/create-nft/components/upload.js",["911","912","913"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/audioPlayer/AudioPlayer.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collections/explore-collections.js",["914","915","916","917","918","919","920"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/collection-details/collectiondetails.js",["921","922","923","924","925","926","927","928","929","930","931","932","933","934","935","936","937","938","939","940"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/nft-detail/nftdetail.js",["941","942","943","944","945","946","947","948","949","950","951"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/Screens/rough/listing-cards/ListingCards.js",["952","953"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/filter-component/FilterComponent.js",[],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/all-nft/allnft.js",["954","955","956","957","958","959","960","961","962","963","964","965","966","967","968","969","970","971","972","973","974","975","976","977","978","979","980","981","982","983","984","985","986"],"/home/usman/integrate-mintsClub-ariswap/ariswap/frontend/src/components/explore/explore.reducer.js",["987"],"/home/usman/integrate-mintsClub-ariswap/a