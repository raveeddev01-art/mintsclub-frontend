unt":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"178"},{"filePath":"375","messages":"376","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"377","usedDeprecatedRules":"178"},{"filePath":"378","messages":"379","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"178"},{"filePath":"380","messages":"381","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"178"},{"filePath":"382","messages":"383","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"178"},{"filePath":"384","messages":"385","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"178"},{"filePath":"386","messages":"387","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"388","usedDeprecatedRules":"178"},{"filePath":"389","messages":"390","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"178"},{"filePath":"391","messages":"392","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"178"},"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/index.js",[],["393","394"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/serviceWorker.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/store.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/App.js",["395","396","397","398"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/redux/index.js",["399","400"],"import { combineReducers } from \"redux\";\nimport homeReducer from \"./../components/home/home.reducer\";\nimport mintsReducer from \"../redux/reducer/reducer\";\nimport auctionReducer from \"./../components/auctions/auctions.reducer\";\nimport nftReducer from \"./../components/nfts/nfts.reducer\";\nimport userReducer from \"./../components/user/user.reducer\";\nimport walletReducer from \"./../components/wallet/wallet.reducer\";\nimport categoryReducer from \"./../components/categories/categories.reducer\";\nimport collectionReducer from \"./../components/collections/collections.reducer\";\nimport errorReducer from \"./shared/error/error.reducer\";\nimport settingsReducer from \"../components/footer/footer.reducer\";\n\nimport offersReducer from \"../components/offers/offers.reducer\";\nimport bidsReducer from \"../components/bids/bids.reducer\";\n\nimport exploreAllReducer from \"../components/explore/explore.reducer\";\nimport createNftReducer from \"../components/create-nft/create-nft-reducer\";\n\nexport default combineReducers({\n  home: homeReducer,\n  dashboard: mintsReducer,\n  auction: auctionReducer,\n  nft: nftReducer,\n  user: userReducer,\n  wallet: walletReducer,\n  category: categoryReducer,\n  collection: collectionReducer,\n  error: errorReducer,\n\n  offer: offersReducer,\n  bid: bidsReducer,\n\n  explore: exploreAllReducer,\n});\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/routes.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/privateRoute.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/config/config.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/full-page-loader/full-page-loader.js",["401"],"import React, { useEffect, useState } from 'react';\nimport AOS from 'aos';\nimport './full-page-loader.css';\n\nfunction FullPageLoader() {\n    useEffect(() => {\n        AOS.init();\n    }, []);\n\n    return (\n        <React.Fragment>\n            <div className=\"fullpage-loader-holder\">\n                <div className=\"fullpage-loader\">\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"circle\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                    <div className=\"shadow\"></div>\n                </div>\n            </div>\n        </React.Fragment>\n    );\n};\n\nexport default FullPageLoader;","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/utils/web3.js",["402","403","404"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/auctions/auctions.reducer.js",["405"],"import { BEFORE_AUCTION, GET_AUCTIONS } from '../../redux/types';\n\nconst initialState = {\n    auctions: null,\n    pagination: null,\n    getAuth: false,\n\n    auctionsData: {},\n    auctionsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_AUCTIONS:\n            return {\n                ...state,\n                auctions: action.payload.auctions,\n                pagination: action.payload.pagination,\n                getAuth: true,\n                auctionsAuth:true,\n            }\n        case BEFORE_AUCTION:\n            return {\n                ...state,\n                auctionsData: {},\n                auctionsAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/redux/reducer/reducer.js",["406"],"import {\n  // HOME_TEST,\n  CURRENT_STEP,\n  CURRENT_STEP_DECREMENT,\n  CLEAR_CURRENT_STEP,\n  SET_CONTRACT_INFO,\n  CONNECT_WELLET,\n  CONTRACT_ERROR_MESSAGE,\n  CONTRACT_REPONSE,\n  TOKEN_ID,\n  MINTING_RESPONSE,\n  LOADER,\n  CONTRACT_ADDRESS,\n  SET_PROPERTIES,\n  SET_LEVELS,\n  SET_OTP_STATUS\n\n\n} from \"../types/types\";\n\nconst initialState = {\n  home: [],\n  currentStep: 1,\n  contractInfo: [],\n  contractErrorMessage: \"\",\n  contractError: false,\n  connectedAddress: \"\",\n  connectedAddressFlag: false,\n  contractReponse: false,\n  tokenId:'',\n  mintingResponse:false,\n  loader:false,\n  contractAddress:\"\",\n  tokenMinted:[],\n  formsInfo:{\n    name:'',\n    symbol:'',\n    externalUrl:'',\n    supply:1,\n    \n  },\n  properties:[],\n  levels:[],\n  otpVerification:false,\n  otpEmail:''\n\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case CURRENT_STEP:\n      // alert(\"reducer\")\n      return {\n        ...state,\n        currentStep: state.currentStep + 1,\n      };\n    case CURRENT_STEP_DECREMENT:\n      return {\n        ...state,\n        currentStep: state.currentStep - 1,\n      };\n    case CLEAR_CURRENT_STEP:\n      return {\n        ...state,\n        currentStep: 1,\n        contractInfo: [],\n        contractErrorMessage: \"\",\n        contractError: false,\n        connectedAddress: \"\",\n        connectedAddressFlag: false,\n        contractReponse: false,\n        tokenId:'',\n        mintingResponse:false,\n        loader:false,\n        contractAddress:\"\",\n        tokenMinted:[],\n        properties:[],\n        levels:[],\n        otpVerification:false,\n      };\n    case SET_CONTRACT_INFO:\n   \n      return {\n        ...state,\n        contractInfo: action.payload.data,\n      };\n    case CONNECT_WELLET:\n      // console.log(action.payload, \"action.payload.address\");\n      return {\n        ...state,\n        connectedAddress: action.payload,\n        connectedAddressFlag: !state.connectedAddressFlag,\n      };\n    case CONTRACT_ERROR_MESSAGE:\n      // alert(\"error\");\n      return {\n        ...state,\n        contractError: true,\n        contractErrorMessage: action.payload.data,\n      };\n    case CONTRACT_REPONSE:\n      return {\n        ...state,\n        contractReponse: !state.contractReponse,\n      };\n\n      case TOKEN_ID:\n  \n        if(action.payload.events.Transfer?.returnValues?.tokenId)\n        {\n         \n          return  {\n            ...state,\n            tokenId:action.payload.events.Transfer.returnValues.tokenId\n          }\n        }\n        else {\n        \n          return  {\n            ...state,\n            tokenMinted:action.payload.events.TokenMinted\n          }\n        }\n        case MINTING_RESPONSE:\n          return {\n            ...state,\n            mintingResponse:!state.mintingResponse\n          }\n          case LOADER:\n            // console.log(action.payload,\"action.payload\")\n            return {\n              ...state,\n              loader:action.payload\n            }\n            case   CONTRACT_ADDRESS:\n              return {\n                ...state,\n                contractAddress:action.payload\n              }\n              case  SET_PROPERTIES:\n                // alert(\"kdjkfdfk\")\n                return {\n                  ...state,\n                  properties:action.payload\n                }\n                case SET_LEVELS:\n                  return {\n                    ...state,\n                    levels:action.payload\n                  }\n                  case SET_OTP_STATUS:\n      \n                    return {\n                      ...state,\n                      otpVerification:action.payload\n                    }\n\n    default:\n      // need this for default case\n      return state;\n  }\n}\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/home/home.reducer.js",["407","408"],"import { BEFORE_HOME, HOME_PAGE_DATA } from '../../redux/types';\n\nconst initialState = {\n    featuredItems: [], // list of featured items\n    featuredItemsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case HOME_PAGE_DATA:\n            return {\n                ...state,\n                featuredItems: true,\n                featuredItems: action.payload\n            }\n        case BEFORE_HOME:\n            return {\n                ...state,\n                featuredItems: [],\n                featuredItemsAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/nfts/nfts.reducer.js",["409"],"import {\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\n\nconst initialState = {\n  nftsData: {},\n  nftAll: {},\n  nftsAuth: false,\n  upsertAuth: false,\n  createNFTResult: [],\n  createNFTerror: false,\n  nftsByCollection: [],\n  nftsByCollectionStatus: false,\n  myLikedNfts: [],\n  myLikedNftsStatus: false,\n  profileNFTs: [],\n  profileNFTsStatus: false,\n  itemActivities:[],\n  activitiesAuth:false,\n  itemsListing:[],\n  itemsListingAuth:false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case UPSERT_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        upsertAuth: true,\n      };\n    case GET_NFT:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case NFTALL:\n      return {\n        ...state,\n        nftAll: action.payload,\n      };\n\n    case GET_NFTS:\n      return {\n        ...state,\n        nftsData: action.payload,\n        nftsAuth: true,\n      };\n    case BEFORE_NFT:\n      return {\n        ...state,\n        nftsData: {},\n        nftsAuth: false,\n        upsertAuth: false,\n\n        myLikedNfts: [],\n        myLikedNftsStatus: false,\n        profileNFTs: [],\n        profileNFTsStatus: false,\n        activitiesAuth:false,\n        itemsListingAuth:false,\n      };\n\n    case GET_NFTS_BY_COLLECTION:\n      return {\n        ...state,\n        nftsByCollection: action.payload,\n        nftsByCollectionStatus: true,\n      };\n    case GET_MYLIKED_NFTS:\n      return {\n        ...state,\n        myLikedNfts: action.payload,\n        myLikedNftsStatus: true,\n      };\n    case GET_PROFILE_NFTS:\n      return {\n        ...state,\n        profileNFTs: action.payload,\n        profileNFTsStatus: true,\n      };\n      case GET_ACTIVITIES:\n        return {\n          ...state,\n          itemActivities:action.payload,\n          activitiesAuth:true\n        }\n        case GET_ITEM_LISTING:\n          return {\n            ...state,\n            itemsListing:action.payload,\n            itemsListingAuth:true,\n          }\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/collections/collections.reducer.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/categories/categories.reducer.js",["410"],"import { BEFORE_CATEGORY, GET_CATEGORIES } from '../../redux/types';\n\nconst initialState = {\n    categories: null,\n    getAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_CATEGORIES:\n     \n            return {\n                ...state,\n                categories: action.payload,\n                getAuth: true\n            }\n        case BEFORE_CATEGORY:\n            return {\n                ...state,\n                categories: null,\n                getAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/user/user.reducer.js",["411"],"import {\n  BEFORE_USER,\n  SET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  GET_USER,\n  GET_APPROVALS,\n  EDIT_APPROVAL,\n} from \"../../redux/types\";\n\nconst initialState = {\n  userData: null,\n  userAuth: false,\n  creatorsAuth: false,\n  topSellersAuth: false,\n  individualUserAuth: false,\n  approvals: null,\n  approvalsAuth: false,\n  editApprovalAuth: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case SET_USER:\n      return {\n        ...state,\n        userData: action.payload,\n        userAuth: true,\n      };\n    case GET_USER:\n      return {\n        ...state,\n      };\n    case SET_CREATORS:\n      return {\n        ...state,\n        creators: action.payload,\n        creatorsAuth: true,\n      };\n    case TOP_SELLERS:\n      return {\n        ...state,\n        sellers: action.payload,\n        topSellersAuth: true,\n      };\n    case SET_INDIVIDUAL_USER:\n      return {\n        ...state,\n        individualUser: action.payload,\n        individualUserAuth: true,\n      };\n    case BEFORE_USER:\n      return {\n        ...state,\n        userData: null,\n        userAuth: false,\n        creatorsAuth: false,\n        topSellersAuth: false,\n        individualUserAuth: false,\n        approvalsAuth: false,\n        editApprovalAuth: false,\n      };\n\n    case GET_APPROVALS:\n      return {\n        ...state,\n        approvals: action.payload,\n        approvalsAuth: true,\n      };\n    case EDIT_APPROVAL:\n      return {\n        ...state,\n        editApprovalAuth: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/wallet/wallet.reducer.js",["412"],"import { BEFORE_WALLET, SET_WALLET, GET_WALLET } from '../../redux/types';\n\nconst initialState = {\n    connectedAddress: '',\n    walletAuth: false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_WALLET:\n            return {\n                ...state,\n                connectedAddress: action.payload,\n                walletAuth: true\n            }\n        case GET_WALLET:\n            return {\n                ...state\n            }\n        case BEFORE_WALLET:\n            return {\n                ...state,\n                connectedAddress: '',\n                walletAuth: false,\n                userAuth: false,\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/offers/offers.reducer.js",["413"],"import { BEFORE_OFFER, GET_OFFERS, CREATE_OFFER, DELETE_OFFER, ACCEPT_OFFER,BUY_NOW } from '../../redux/types';\n\nconst initialState = {\n    offer: null,\n    offers: null,\n    pagination: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    buyAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_OFFERS:\n            console.log(action.payload.offers,\"reducer\")\n            \n            return {\n                ...state,\n                offers: action.payload.offers,\n                pagination: action.payload.pagination,\n                getAuth: true\n            }\n        case CREATE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_OFFER:\n            return {\n                ...state,\n                offer: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_OFFER:\n            return {\n                ...state,\n                offer: null,\n                offers: null,\n                pagination: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                buyAuth:false,\n            }\n            case BUY_NOW:\n                return {\n                    ...state,\n                    buyAuth:true,\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/footer/footer.reducer.js",["414"],"import { BEFORE_FOOTER, GET_FOOTER } from '../../redux/types';\n\nconst initialState = {\n    settings: null,\n    settingsAuth: false\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_FOOTER:\n            return{\n                ...state,\n                settings: action.payload,\n                settingsAuth: true\n            }\n        case BEFORE_FOOTER:\n            return {\n                ...state,\n                settings: null,\n                settingAuth: false\n            }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/bids/bids.reducer.js",["415"],"import { BEFORE_BID, GET_BIDS, CREATE_BID, DELETE_BID, ACCEPT_BID,GETBIDS_BY_NFT } from '../../redux/types';\n\nconst initialState = {\n    bid: null,\n    bids: null,\n    pagination: null,\n    highestBidAmt: null,\n    deleteAuth: false,\n    createAuth: false,\n    getAuth: false,\n    acceptAuth: false,\n    bidsByNft:null,\n    bidsBYNftAuth:false,\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_BIDS:\n            console.log(action.payload.Bids,\"action.payload.Bids\")\n            return {\n                ...state,\n                bids: action.payload.Bids,\n                // pagination: action.payload.pagination,\n                // highestBidAmt: action.payload.highestBidAmt,\n                getAuth: true\n            }\n        case CREATE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                createAuth: true\n            }\n        case ACCEPT_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                acceptAuth: true\n            }\n        case DELETE_BID:\n            return {\n                ...state,\n                bid: action.payload,\n                deleteAuth: true\n            }\n        case BEFORE_BID:\n            return {\n                ...state,\n                bid: null,\n                bids: null,\n                pagination: null,\n                highestBidAmt: null,\n                deleteAuth: false,\n                createAuth: false,\n                getAuth: false,\n                acceptAuth: false,\n                bidsBYNftAuth:false,\n                \n            }\n            case GETBIDS_BY_NFT:\n                return {\n                    ...state,\n                    bidsByNft:action.payload,\n                    bidsBYNftAuth:true\n                }\n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/create-nft/create-nft-reducer.js",["416"],"import { SET_NFT_TOKEN } from '../../redux/types';\n\nconst initialState = {\n    createNFTResult: ''\n}\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case SET_NFT_TOKEN :\n            return {\n                ...state,\n                createNFTResult: true\n            }\n      \n        default:\n            return {\n                ...state\n            }\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/explore/explore.reducer.js",["417"],"import {\n  GET_COLLECTION,\n  TOGGLE_LIKE_RES,\n  BEFORE_TOGGLE_LIKE,\n} from \"../../redux/types\";\n\nconst initialState = {\n  collection: [],\n  getAuth: true,\n  togleLikeRes: false,\n};\n\nexport default function (state = initialState, action) {\n  switch (action.type) {\n    case GET_COLLECTION:\n      return {\n        ...state,\n        collection: action.payload.collection,\n        getAuth: true,\n      };\n    case BEFORE_TOGGLE_LIKE:\n      return {\n        ...state,\n        togleLikeRes: false,\n      };\n    case TOGGLE_LIKE_RES:\n      return {\n        ...state,\n        togleLikeRes: true,\n      };\n\n    default:\n      return {\n        ...state,\n      };\n  }\n}\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/explore/explore-all.js",["418","419","420","421","422","423","424","425","426"],"import React, { useEffect, useState } from \"react\";\nimport { connect } from \"react-redux\";\nimport { beforeNFT, getNFTs } from \"../nfts/nfts.action\";\nimport { ENV } from \"../../config/config\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\nimport ExploreItems from \"./explore-items\";\nimport NftCard from \"../collections/components/NftCard/NftCard\";\nimport { Link, useHistory } from \"react-router-dom\";\nimport { getCreators, beforeUser } from \"./../user/user.action\";\n\nconst initData = {\n  pre_heading: \"Explore\",\n  heading: \"Exclusive Digital Assets\",\n  content: \"\",\n  btn_1: \"Load More\",\n};\n\nfunction ExploreAll(props) {\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [nfts, setNFTs] = useState([]); // NFTs for explore section\n  const [loader, setLoader] = useState(true);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [intro, setIntro] = useState(false);\n  const [creators, setCreator] = useState([]);\n  const pathname = useHistory().location.pathname;\n\n  useEffect(() => {\n    window.scroll(0, 0);\n    if (pathname === \"/explore-all\") setIntro(true);\n    getNFTs();\n    props.getCreators();\n  }, []);\n  useEffect(() => {\n    if (props.user.topSellersAuth) {\n      setCreator(props.user.sellers);\n    }\n  }, [props.user.topSellersAuth]);\n  useEffect(() => {\n    if (props.user.creatorsAuth) {\n      setCreator(props.user.creators);\n      setLoader(false);\n    }\n  }, [props.user.creatorsAuth]);\n  useEffect(() => {\n    if (props.nft.nftsAuth) {\n      const { nftsData } = props.nft;\n      if (nftsData) {\n        setNFTs(nftsData);\n        setNFTPagination(nftsData.pagination);\n        props.beforeNFT();\n        if (props.setLoader) props.setLoader(false);\n      }\n      setLoader(false);\n    }\n  }, [props.nft.nftsAuth]);\n\n  useEffect(() => {\n    if (nftPagination)\n      setLoadMoreBtn(\n        nftPagination.total > 0 &&\n          nftPagination.total > nfts.length &&\n          nfts.length > 0\n      );\n  }, [nftPagination]);\n\n  const loadMore = () => {\n    const { page, limit } = nftPagination;\n    setLoader(true);\n    getNFTs(1, limit * (page + 1));\n  };\n\n  const getNFTs = (page = 1, limit = 4) => {\n    const nftQS = { page, limit, explore: true };\n\n    if (props.collectionId) nftQS.collectionId = props.collectionId;\n\n    const qs = ENV.objectToQueryString(nftQS);\n    props.getNFTs(qs);\n  };\n\n  return (\n    <section\n      className=\"explore-area\"\n      style={{ paddingTop: `${intro ? \"150\" : \"30\"}px` }}\n    >\n      {loader && <FullPageLoader />}\n      <div className=\"container\">\n        {intro && (\n          <div className=\"row justify-content-center\">\n            <div className=\"col-12 col-md-8 col-lg-7\">\n              <div className=\"intro text-center mb-4\">\n                <span>{initData.pre_heading}</span>\n                <h3 className=\"mt-3 mb-0\">{initData.heading}</h3>\n              </div>\n            </div>\n          </div>\n        )}\n        <div className=\"row items gx-4 explore-items\">\n          {nfts && nfts.length > 0 && creators.length > 0 ? (\n            nfts.map((item, idx) => {\n              return (\n                <div className=\"col-3 mt-5\" style={{}}>\n                  <NftCard\n                    nft={item}\n                    creators={creators}\n                    userId={ENV.getUserKeys(\"_id\")._id}\n                  />\n                </div>\n              );\n            })\n          ) : (\n            <p className=\"text-center\">No Items Found to Exploree</p>\n          )}\n        </div>\n        {loadMoreBtn && (\n          <div className=\"row\">\n            <div className=\"col-12 text-center\">\n              <a\n                id=\"load-btn\"\n                className=\"btn btn-bordered-white mt-5\"\n                onClick={() => loadMore()}\n              >\n                {initData.btn_1}\n              </a>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n\nconst mapStateToProps = (state) => ({\n  nft: state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs, getCreators })(\n  ExploreAll\n);\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/home/home.js",["427","428"],"import React, { useEffect } from \"react\";\nimport { Table, Pagination } from \"react-bootstrap\";\nimport Hero from \"../hero/hero\";\nimport Auctions from \"../auctions/home-auctions\";\nimport TopSeller from \"../top-seller/topseller2\";\n\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport OwnCollection from \"../owncollection/OwnCollection\";\nimport Buysell from \"../buy-sell/Buysell\";\nimport Footer from \"../footer/footer\";\nimport PopularCollections from \"../collections/popular-collections\";\n\nfunction Home() {\n  useEffect(() => {\n    window.scroll(0, 0);\n  }, []);\n\n  return (\n    <>\n  \n      <NavbarMain />\n      <Hero />\n\n      <Auctions />\n   \n  \n      <TopSeller viewAll={\"View All\"} />\n   \n      <PopularCollections />\n     \n      <OwnCollection />\n      <Buysell />\n      <Footer />\n    </>\n  );\n}\n\nexport default Home;\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/collections/collection-details.js",["429","430","431","432","433","434","435","436","437","438","439","440","441","442","443","444","445","446","447"],"import React, { useState, useEffect, useRef } from \"react\";\n\nimport Explore from \"../explore/explore-all\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport { connect } from \"react-redux\";\nimport { beforeCollection, getCollection } from \"../collections/collections.actions\";\nimport { Link } from \"react-router-dom\";\nimport { ENV } from \"../../config/config\";\nimport { Accordion, Dropdown } from \"react-bootstrap\";\nimport Select from 'react-select'\nimport NftCard from './components/NftCard/NftCard';\nimport {getNFTs} from '../nfts/nfts.action'\nimport {getCreators, beforeUser} from './../user/user.action';\nimport { toast } from \"react-toastify\";\nconst { collectionFeaturedImg, userDefaultImg, categoryDefaultImg } = ENV;\n\nconst CollectionDetails = (props) => {\n  const [collection, setCollection] = useState(null);\n  const [nfts, setNfts] = useState(null);\n  const [nftPagination, setNFTPagination] = useState(null);\n  const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n  const [loader, setLoader] = useState(true);\n  const [limit, setLimit] = useState(2);\n  const [collectionLoader, setColLoader] = useState(true); // collections loader\n  const [nftsLoader, setNftsLoader] = useState(true); // NFTs loader\n  const [creators,setCreator]=useState([])\n  const nftsRef = useRef(null);\n\n  useEffect(() => {\n   \n    props.getNFTs()\n    window.scroll(0, 0);\n    const { collectionId } = props.match.params;\n    if (collectionId) props.getCollection(window.atob(collectionId));\n    else props.history.push(\"/collections\");\n  }, []);\n\n  // when collection data is received\n  useEffect(() => {\n    if (props.collection.getAuth) {\n      const { collection } = props.collection;\n  \n      setCollection(collection);\n      props.beforeCollection();\n      setColLoader(false);\n    }\n  }, [props.collection.getAuth]);\n   \n  useEffect(()=>{\n      \n    if(props.user.topSellersAuth ){\n    \n       setCreator(props.user.sellers)\n\n    }\n  },[props.user.topSellersAuth])\n\n  // handle show load more button state when pagination is set\n  useEffect(() => {\n   \n    if (nftPagination)\n        setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length && nfts.length > 0))\n  }, [nftPagination])\n\n  const loadMore = () => {\n    \n    // const { page, limit } = nftPagination\n    setLoader(true)\n    setLimit(limit + 2)\n    // get more NFTs for explore section\n    // getNFTs(1, limit * (page + 1));\n  }\n\n  const filterNfts=(nfts)=>{\n\n    if(collection)\n    {\n      const result_nft = nfts.filter((nft)=>nft?.collectionId===collection._id);\n      nfts.pagination = { page: 1, limit: 10, total: result_nft.length, pages: 1 }\n      setNfts(result_nft.slice(0, limit));\n      setNFTPagination(nfts.pagination)\n      getNftsLoader(false);\n    }\n  }\n\n\n\n\n  const getNFTs = (page = 1, limit = 2) => {\n      const nftQS = { page, limit }\n      if (props.collectionId)\n          nftQS.collectionId = props.collectionId\n      const qs = ENV.objectToQueryString(nftQS)\n      props.getNFTs(qs)\n  }\n\n  useEffect(()=>{\n    if(props.nft.nftsAuth)\n    {\n      const {nftsData}=props.nft;\n      filterNfts(nftsData)  \n    }\n\n  },[props?.nft?.nftsAuth,collection, limit])\n\n\n\n  const getNftsLoader = (loader) => {\n    setNftsLoader(loader);\n  };\n\n  return (\n    <section\n      className=\"author-area explore-area  popular-collections-area\"\n      style={{ padding: \"0px\" }}\n    >\n      {(collectionLoader || nftsLoader) && <FullPageLoader />}\n      <div className=\"\">\n        {collection  && (\n          <div className=\"row p-5\" style={{width:\"80%\",margin:\"auto\"}}>\n            <div className=\"col-4 p-4\">\n              {/* <CollectionPreview collection={collection} creators={creators} /> */}\n            </div>\n            <div className=\"col-8 \">\n              <div className=\"row justify-content-center mt-5\">\n                <div className=\"col-12 col-md-8 col-lg-7\">\n                  <div className=\"intro text-center mb-4\">\n                      {/* <span>{initData.pre_heading}</span> */}\n                      <span>Explore</span>\n                      {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                          <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"row gx-5 p-4\">\n              \n                {\n                  nfts && creators && nfts.map((nft)=>{\n                  return (\n                    <div className=\"col-6 mt-5\" style={{}}>\n                      <NftCard nft={nft} creators={creators}/>\n                    </div>\n                    )\n                  })\n                }\n                {\n                  loadMoreBtn &&\n                  <div className=\"row w-100\">\n                      <div className=\"col-12 w-100 text-center\">\n                          <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>Load More</a>\n                      </div>\n                  </div>\n                }\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  {\n\n  error: state.error,\n  collection: state.collection,\n  nft:state.nft,\n  user: state.user,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  getCollection,\n  getNFTs,\n  getCreators,\n\n})(CollectionDetails);\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/collections/explore-collections.js",["448","449","450","451"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/redux/shared/error/error.reducer.js",["452"],"import { GET_ERRORS, EMPTY_ERRORS } from './../../types';\n\nconst initialState = null;\n\nexport default function (state = initialState, action) {\n    switch (action.type) {\n        case GET_ERRORS:\n            return action.payload;\n        case EMPTY_ERRORS:\n            return initialState;\n        default:\n            return state;\n    }\n}","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/signup/signup.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/popular-collections-list/popular-collections-list.js",["453","454","455","456","457","458"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/not-found/not-found.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/user-profile/user-edit-profile.js",["459","460","461","462","463","464","465","466","467","468","469","470","471","472","473","474","475","476"],"import React, { useEffect, useState } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport \"./user-edit-profile.css\";\nimport { editImages } from \"../../assets/assets\";\nimport { ReactComponent as ProfileEditSVG } from \"../../assets/images/edit-pen.svg\";\n/////////\n\nimport { connect } from \"react-redux\";\nimport { SET_INDIVIDUAL_USER } from \"../../redux/types\";\nimport \"react-toastify/dist/ReactToastify.css\";\nimport $ from \"jquery\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport {\n  updateProfile,\n  setIndividualUserData,\n  getUserById,\n  beforeUser,\n\n} from \"./../user/user.action\";\nimport { signRequest } from \"./../../utils/web3\";\nimport { ENV } from \"./../../config/config\";\nimport { toast } from \"react-toastify\";\nimport { useHistory } from \"react-router-dom\";\nimport FullPageLoader from \"../full-page-loader/full-page-loader\";\n\nconst EditProfile = (props) => {\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [loader, setLoader] = useState(false);\n  const [errors, setErrors] = useState(\"\");\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\n  const [image, setImage] = useState(\"\");\n  const [imageUrl, setImageUrl] = useState(\"\");\n  const [banner, setBannerImage] = useState(\"\");\n  const [bannerUrl, setBannerUrl] = useState(\"\");\n  const [address, setAddress] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [username, setUsername] = useState(\"\");\n  const [description, setDescription] = useState(\"\");\n  const [facebookLink, setFbLink] = useState(\"\");\n  const [twitterLink, setTwitterLink] = useState(\"\");\n  const [gPlusLink, setgPlusLink] = useState(\"\");\n  const [vineLink, setVineLink] = useState(\"\");\n  const [instaLink, setInstaLink] = useState(\"\");\n  const [webLink, setWebLink] = useState(\"\");\n  const [_id, setUserId] = useState(\"\");\n  const history = useHistory();\n  let validator = new SimpleReactValidator({\n    autoForceUpdate: this,\n    messages: {\n      required: \"This field is required.\", // will override all messages\n    },\n  });\n  useEffect(() => {\n    let user = ENV.getUserKeys(\"\");\n  \n    props.getUserById(ENV.getUserKeys(\"_id\")._id);\n  }, []);\n\n  useEffect(() => {\n    if (props.user.individualUserAuth) {\n\n      const {\n        address,\n        email,\n        bio,\n        twitterLink,\n        username,\n        profileImage,\n        bannerImage,\n        instaLink,\n        webLink,\n      } = props.user.individualUser;\n      props.beforeUser();\n      setLoader(false);\n\n      setConnectedAddress(address ? address : \"\");\n      setAddress(address ? address : \"\");\n      setEmail(email ? email : \"\");\n      setUserId(_id ? _id : \"\");\n      setDescription(bio ? bio : \"\");\n      setTwitterLink(twitterLink ? twitterLink : \"\");\n      setUsername(username ? username : \"\");\n      setImageUrl(profileImage ? profileImage : \"\");\n      setBannerUrl(bannerImage ? bannerImage : \"\");\n      setImage(profileImage?profileImage:'');\n      setBannerImage(bannerImage?bannerImage:\"\");\n      setInstaLink(instaLink ? instaLink : \"\");\n      setWebLink(webLink ? webLink : \"\");\n    }\n  }, [props.user.individualUserAuth]);\n\n  useEffect(() => {\n    if (props.user.userAuth) {\n  \n      setLoader(false);\n      props.beforeUser()\n      history.push(\"/userprofile\");\n    }\n  }, [props.user.userAuth]);\n\n  useEffect(() => {\n    if (props.error) {\n      setErrors(props.error.message);\n      goToTop();\n    }\n  }, [props.error]);\n\n  const goToTop = () => {\n    $(\"html, body\").animate(\n      {\n        scrollTop: 0,\n      },\n      600\n    );\n  };\n\n  const onFileChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setImageUrl(fileURL);\n      setImage(file);\n    }\n  };\n\n  const onBannerChange = (e) => {\n    let file = e.target.files[0];\n    let fileURL = \"\";\n    if (file) {\n      if (file.type.includes(\"image\")) {\n        fileURL = URL.createObjectURL(file);\n      } else {\n        file = {};\n        fileURL = \"\";\n      }\n      setBannerUrl(fileURL);\n      setBannerImage(file);\n    }\n  };\n\n  const submit = async (e) => {\n    e.preventDefault();\n    let obj = {\n      image,\n      banner,\n      username,\n      instaLink,\n      webLink,\n      description,\n      email,\n      address,\n      instaLink,\n      twitterLink,\n    };\n\n    setErrors(\"\");\n    setLoader(true);\n    setIsSubmitted(true);\n    let isFormValid = validator.allValid() ? true : false;\n    if (isFormValid) {\n      try {\n        // let signature = await signRequest();\n        setLoader(true);\n        console.log(ENV.getUserKeys(\"_id\")._id, \"id\");\n        var formData = new FormData();\n        formData.append(\"userId\", ENV.getUserKeys(\"_id\")._id);\n        if (image) {\n          formData.append(\"profileImage\", image);\n        }\n        if (banner) {\n          formData.append(\"bannerImage\", banner);\n        }\n        formData.append(\"bio\", description);\n        formData.append(\"twitterLink\", twitterLink);\n        formData.append(\"username\", username);\n        formData.append(\"email\", email);\n        formData.append(\"webLink\", webLink);\n        formData.append(\"instaLink\", instaLink);\n        console.log(\"sending request\");\n        // return ''\n        props.updateProfile(formData);\n      } catch (e) {}\n    } else {\n      validator.showMessages();\n      setErrors(\"Please fill all required fields in valid format.\");\n      goToTop();\n    }\n  };\n\n  return (\n    <>\n      {loader && <FullPageLoader />}\n      <NavbarMain />\n      <Breadcrumb title1={\"Profile\"} title2={\"EditProfile\"} />\n      <section className=\"edit-profile padding-wrapper\">\n        <form onSubmit={submit}>\n          <div className=\"container\">\n            <div className=\"row\">\n              <div className=\"col-12\">\n                <div className=\"intro\">\n                  <div className=\"intro-content\">\n                    <span>Set Up Your Profile</span>\n                    <h3 className=\"mb-0\">Profile Setting</h3>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                <div className=\"edit-inp-subheading\">\n                  <h6>Profile Image</h6>\n                </div>\n                <div className=\"edit-avatar pt-4\">\n                  <img\n                    src={imageUrl ? imageUrl : editImages.EditAvatar}\n                    alt=\"editavatar\"\n                  />\n\n                  <label>\n                    <div className=\"avatar-btn-pen\">\n                      <ProfileEditSVG />\n                    </div>\n                    <input\n                      type=\"file\"\n                      accept=\".png,.jpeg,.jpg\"\n                      onChange={(e) => onFileChange(e)}\n                      style={{ display: \"none\" }}\n                      name=\"image\"\n                    />\n                  </label>\n                </div>\n                <div className=\"edit-banner-container\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Profile Banner</h6>\n                  </div>\n                  <div className=\"edit-banner pt-4\">\n                    <img\n                      src={bannerUrl ? bannerUrl : editImages.EditBanner}\n                      alt=\"editavatar\"\n                    />\n                    <label>\n                      <div className=\"banner-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => onBannerChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"banner\"\n                      />\n                    </label>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                <div className=\"row g-4\">\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Username</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"username\"\n                        placeholder=\"User Name\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        onChange={(e) => setUsername(e.target.value)}\n                        defaultValue={username}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"username\", username, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Email Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"email\"\n                        placeholder=\"Email Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        readOnly\n                        value={email}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"email\", email, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-4 col-lg-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Wallet Address</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <input\n                        name=\"address\"\n                        placeholder=\"Wallet Address\"\n                        required=\"required\"\n                        autocomplete=\"off\"\n                        value={address}\n                      />\n                      <span className=\"text-danger\">\n                        {validator.message(\"address\", address, \"required\")}\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-8\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Bio</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <textarea\n                        name=\"bio\"\n                        placeholder=\"Bio\"\n                        onChange={(e) => setDescription(e.target.value)}\n                        defaultValue={description}\n                      ></textarea>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6 col-lg-6 col-xl-4\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Links</h6>\n                    </div>\n                    <div className=\"edit-inp pt-4\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Twitter}\n                          alt=\"twitterlink\"\n                        />\n                        <input\n                          name=\"twitterlink\"\n                          placeholder=\"Twitter Link\"\n                          autocomplete=\"off\"\n                          ype=\"url\"\n                          onChange={(e) => setTwitterLink(e.target.value)}\n                          defaultValue={twitterLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Insta}\n                          alt=\"instalink\"\n                        />\n                        <input\n                          name=\"instagramlink\"\n                          placeholder=\"Instagram Link\"\n                          type=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => setInstaLink(e.target.value)}\n                          defaultValue={instaLink}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"edit-inp pt-3\">\n                      <div className=\"edit-link-inp d-flex align-items-center\">\n                        <img\n                          className=\"ps-3\"\n                          src={editImages.Website}\n                          alt=\"websitelink\"\n                        />\n                        <input\n                          name=\"websitelink\"\n                          placeholder=\"Website Link\"\n                          ype=\"url\"\n                          autocomplete=\"off\"\n                          onChange={(e) => setWebLink(e.target.value)}\n                          defaultValue={webLink}\n                        />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n              <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                <div className=\"\">\n                  <button className=\"btn btn-linear-gradient\">\n                    Save changes\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n        </form>\n      </section>\n      <Footer />\n    </>\n  );\n};\n\nconst mapStateToProps = (state) => (\n  {\n    wallet: state.wallet,\n    user: state.user,\n    error: state.error,\n  }\n);\n\nexport default connect(mapStateToProps, {\n  updateProfile,\n  setIndividualUserData,\n  beforeUser,\n  getUserById,\n})(EditProfile);\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/create-nft/create-nft.js",["477","478","479","480"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/wallet/wallet.js",["481","482","483","484","485","486","487","488"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/auctions/home-auction-list.js",["489","490","491","492","493","494","495","496","497","498","499"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/top-seller/topsellerlist.js",["500","501","502"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/creat-collections/CreateCollections.js",["503","504","505","506","507","508"],"import React, { Component } from \"react\";\nimport NavbarMain from \"../navbar-main/NavbarMain\";\nimport Footer from \"../footer/footer\";\nimport Breadcrumb from \"../breadcrumb/breadcrumb\";\nimport \"./CreateCollections.css\";\nimport { editImages } from \"../../assets/assets\";\nimport { ReactComponent as ProfileEditSVG } from \"../../assets/images/edit-pen.svg\";\nimport CollectionUploadIcon from \"../../assets/images/collection-upload-icon.svg\";\nimport { connect } from \"react-redux\";\nimport {\n  beforeCollection,\n  upsertCollection,\n} from \"../collections/collections.actions\";\nimport { beforeCategory, getCategories } from \"../categories/categories.action\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport SimpleReactValidator from \"simple-react-validator\";\nimport { ENV } from \"../../config/config\";\nimport $ from \"jquery\";\nimport { toast } from \"react-toastify\";\nimport FullPageLoader from \"../../components/full-page-loader/full-page-loader\";\nimport UploadIcon from \"../../assets/images/uploadIcon.png\";\nimport { MdClose } from \"react-icons/md\";\n\nclass CreateCollections extends Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isSubmitted: false,\n      formValid: true,\n      loader: true,\n      errors: \"\",\n      collection: {\n        userId: ENV.getUserKeys(\"_id\")._id,\n        categoryId: \"\",\n        logo: \"\",\n        featuredImg: \"\",\n        banner: \"\",\n        name: \"\",\n        url: \"\",\n        logoUrl: \"\",\n        bannerUrl: \"\",\n        featuredImgUrl: \"\",\n        description: \"\",\n      },\n      categories: null,\n    };\n    this.validator = new SimpleReactValidator({\n      autoForceUpdate: this,\n      messages: {\n        required: \"This field is required.\", // will override all messages\n      },\n    });\n  }\n\n  componentDidMount() {\n    window.scroll(0, 0);\n    this.props.getCategories();\n    // this.props.getUser()\n  }\n\n  componentDidUpdate() {\n    if (this.props.error) {\n      this.setState({ loader: false }, () => {\n        this.props.emptyError();\n      });\n    }\n\n    if (this.props.collection.upsertAuth) {\n      this.props.beforeCollection();\n      this.props.history.push(\"/explore/exploreAll\");\n    }\n    if (this.props.category.getAuth) {\n      const { categories } = this.props.category;\n      this.setState({ categories, loader: false }, () => {\n        this.props.beforeCategory();\n      });\n    }\n  }\n\n  onFileChange(e) {\n    let file = e.target.files[0];\n    if (file)\n      if (file.type.includes(\"image\")) {\n        let { collection } = this.state;\n        collection = { ...collection, [e.target.name]: file };\n        if (e.target.name) {\n          collection[`${e.target.name}Url`] = URL.createObjectURL(\n            e.target.files[0]\n          );\n          $(`#collection-${e.target.name}-label`).html(\"File selected\");\n        }\n        this.setState({ collection });\n      }\n  }\n\n  onChange(e) {\n    let { name, value } = e.target;\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    let { collection } = this.state;\n    collection = { ...collection, [name]: value, userId: userId };\n    console.log(collection, \"collection input\");\n    this.setState({ collection });\n  }\n\n  reset = () => {\n    const collection = {\n      userId: \"\",\n      categoryId: \"\",\n      logo: \"\",\n      featuredImg: \"\",\n      banner: \"\",\n      name: \"\",\n      url: \"\",\n      description: \"\",\n    };\n    this.setState({ collection, isSubmitted: false });\n  };\n\n  submit = (e) => {\n    e.preventDefault();\n    const userId = ENV.getUserKeys(\"_id\")._id;\n    this.setState(\n      {\n        isSubmitted: true,\n        formValid: this.validator.allValid() ? true : false,\n      },\n      () => {\n        const { formValid } = this.state;\n        if (formValid) {\n          this.setState(\n            {\n              loader: true,\n            },\n            async () => {\n              const { collection } = this.state;\n\n              var formData = new FormData();\n              for (var val in collection) {\n                if (collection[val]) {\n                  formData.append(val, collection[val]);\n                }\n              }\n\n              this.props.upsertCollection(\"collection/create\", formData);\n            }\n          );\n        } else {\n          this.validator.showMessages();\n          this.setState(\n            {\n              errors: \"Please fill all required fields in valid format.\",\n              formValid: false,\n            },\n            () => {\n              $(\"#create-collection\").scrollTop(0, 0);\n            }\n          );\n        }\n      }\n    );\n  };\n\n  clearData = () => {\n    let { collection } = this.state;\n    collection = { ...collection, featuredImg: \"\", featuredImgUrl: \"\" };\n    this.setState({ collection });\n  };\n\n  render() {\n    const { collection, errors, loader, isSubmitted, categories } = this.state;\n    if (!ENV.getUserKeys(\"_id\")._id) {\n      toast.error(\"Please login to create Collection\");\n      this.props.history.push(\"/\");\n      return \" \";\n    } else {\n      return (\n        <>\n          <NavbarMain />\n          <Breadcrumb title1={\"Collections\"} title2={\"CreateCollections\"} />\n          <section className=\"edit-profile padding-wrapper create-collection-container\">\n            {loader && <FullPageLoader />}\n            <div className=\"container\">\n              <div className=\"row\">\n                <div className=\"col-12\">\n                  <div className=\"intro\">\n                    <div className=\"intro-content\">\n                      <span>Create Now</span>\n                      <h3 className=\"mb-0\">Create New Collection</h3>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"col-12 col-sm-10 col-md-8 col-lg-4 col-xl-3\">\n                  <div className=\"edit-inp-subheading\">\n                    <h6>Logo Image</h6>\n                    <span className=\"text-danger\">\n                      {this.validator.message(\n                        \"logo\",\n                        collection.logo,\n                        \"required\"\n                      )}\n                    </span>\n                  </div>\n                  <div className=\"collection-logo-container pt-2\">\n                    {collection && collection.logo ? (\n                      <img\n                        src={collection.logoUrl}\n                        className=\"colection-avatar-img\"\n                      />\n                    ) : (\n                      <div className=\"colection-avatar\"></div>\n                    )}\n                    <label>\n                      <div className=\"avatar-btn-pen\">\n                        <ProfileEditSVG />\n                      </div>\n                      <input\n                        id=\"logo\"\n                        type=\"file\"\n                        accept=\".png,.jpeg,.jpg\"\n                        onChange={(e) => this.onFileChange(e)}\n                        style={{ display: \"none\" }}\n                        name=\"logo\"\n                      />\n                    </label>\n                  </div>\n                  <div className=\"\">\n                    <div className=\"edit-inp-subheading\">\n                      <h6>Featured Image</h6>\n                      <span className=\"text-danger\">\n                        {this.validator.message(\n                          \"logo\",\n                          collection.featuredImg,\n                          \"required\"\n                        )}\n                      </span>\n                    </div>\n                    <div className=\"upload-featured-container\">\n                      {collection && collection.featuredImg ? (\n                        <div className=\"uploaded-featured-container\">\n                          <img\n                            src={collection.featuredImgUrl}\n                            className=\"uploaded-featured-img\"\n                          />\n                          <div className=\"uploaded-featured-hover w-100\">\n                            <div className=\"uploaded-featured-cross\">\n                              <MdClose\n                                color=\"#e33d0bc2\"\n                                className=\"uploaded-cross-icon\"\n                                onClick={() => this.clearData()}\n                              />\n                            </div>\n                            <label>\n                              <div className=\"text-center\">\n                                <img src={UploadIcon} alt=\"upload-icon\" />\n                              </div>\n                              <input\n                                id=\"featuredImg\"\n                                type=\"file\"\n                                accept=\".png,.jpeg,.jpg\"\n                                style={{ display: \"none\" }}\n                                name=\"featuredImg\"\n                                onChange={(e) => this.onFileChange(e)}\n                              />\n                            </label>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className=\"upload-featured-img\">\n                          <label>\n                            <div className=\"text-center\">\n                              <img\n                                src={CollectionUploadIcon}\n                                alt=\"upload-icon\"\n                              />\n                            </div>\n                            <div className=\"upload-featured-img-content pt-2\">\n                              <h6 className=\"pb-1\">Browse Files</h6>\n                              <p>PNG, GIF, WEBP, MP4 or MP3 Max 100mb.</p>\n                            </div>\n                            <input\n                              id=\"featuredImg\"\n                              type=\"file\"\n                              accept=\".png,.jpeg,.jpg\"\n                              style={{ display: \"none\" }}\n                              name=\"featuredImg\"\n                              onChange={(e) => this.onFileChange(e)}\n                            />\n                          </label>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 col-md-12 col-lg-8 col-xl-9 pt-5 pt-lg-0\">\n                  <div className=\"row g-4\">\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Name</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"name\",\n                            collection.name,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"name\"\n                          type=\"text\"\n                          name=\"name\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.name}\n                          placeholder=\"Name\"\n                          maxLength=\"55\"\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>URL</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\"url\", collection.url, \"url\")}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <input\n                          id=\"url\"\n                          type=\"text\"\n                          name=\"url\"\n                          placeholder=\"URL\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.url}\n                          autoComplete=\"off\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"col-md-4 col-lg-4\">\n                      <div className=\"edit-inp-subheading position-relative\">\n                        <h6>Select Category</h6>\n                        <span className=\"text-danger position-absolute top-0\">\n                          {this.validator.message(\n                            \"category\",\n                            collection.categoryId,\n                            \"required\"\n                          )}\n                        </span>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <select\n                          id=\"category\"\n                          name=\"categoryId\"\n                          onChange={(e) => this.onChange(e)}\n                        >\n                          <option value=\"\" className=\"d-none\">\n                            Select Collection\n                          </option>\n                          {categories &&\n                            categories.map((category, index) => {\n                              return (\n                                <option key={index} value={category._id}>\n                                  {category.name}\n                                </option>\n                              );\n                            })}\n                        </select>\n                      </div>\n                    </div>\n                    <div className=\"col-md-8\">\n                      <div className=\"edit-inp-subheading pt-4\">\n                        <h6>Discription</h6>\n                      </div>\n                      <div className=\"edit-inp pt-4\">\n                        <textarea\n                          name=\"description\"\n                          placeholder=\"Discription\"\n                          onChange={(e) => this.onChange(e)}\n                          value={collection.description}\n                          maxLength=\"230\"\n                        ></textarea>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"col-12 mt-4 mt-md-5 text-center\">\n                  <div className=\"\">\n                    <button\n                      type=\"button\"\n                      className=\"btn btn-linear-gradient\"\n                      onClick={(e) => this.submit(e)}\n                    >\n                      Create Collections\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n          <Footer />\n        </>\n      );\n    }\n  }\n}\n\nconst mapStateToProps = (state) => ({\n  collection: state.collection,\n  // user: state.user,\n  error: state.error,\n  category: state.category,\n});\n\nexport default connect(mapStateToProps, {\n  beforeCollection,\n  upsertCollection,\n  emptyError,\n  beforeCategory,\n  getCategories,\n})(CreateCollections);\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/layouts/layout4/layout4.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/explore/all-nft/allnft.js",["509","510","511","512","513","514","515","516","517","518","519","520","521","522","523","524"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/collection-details/collectiondetails.js",["525","526","527","528","529","530","531","532","533","534"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/user-profile/UserProfile.js",["535","536","537","538","539","540","541","542","543","544","545","546","547","548","549","550","551","552","553"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/sell-nft/SellNFT.js",["554","555","556","557","558","559","560","561","562","563","564","565","566","567","568","569","570","571"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/nft-detail/nftdetail.js",["572","573","574","575","576","577","578","579","580","581","582","583","584","585","586","587","588","589","590","591","592","593","594","595","596","597","598","599","600","601","602","603","604","605","606","607","608","609","610","611","612"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/layouts/layout2/layout2.jsx",["613","614"],"import React, { Component } from \"react\";\nimport Particles from \"react-tsparticles\";\nimport NavbarMain from \"../../components/navbar-main/NavbarMain\";\nimport Footer from \"../../components/footer/footer\";\n// import Scrollup from '../../components/scroll-up/sroll-up';\n\nclass Layout2 extends Component {\n  render() {\n    const particlesData = {\n      fullScreen: {\n        zIndex: -5,\n      },\n      color: {\n        value: \"#5666fe\",\n      },\n      twinkle: {\n        lines: {\n          enable: true,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n        particles: {\n          enable: false,\n          frequency: 0.05,\n          opacity: 0.5,\n        },\n      },\n      wobble: {\n        distance: 5,\n        enable: false,\n        speed: 2,\n      },\n      particles: {\n        number: {\n          value: 25,\n          density: {\n            enable: true,\n            value_area: 800,\n          },\n        },\n        shape: {\n          type: \"circle\",\n          stroke: {\n            width: 0,\n            color: \"#5666fe\",\n          },\n          polygon: {\n            nb_sides: 5,\n          },\n          image: {\n            src: \"img/github.svg\",\n            width: 100,\n            height: 100,\n          },\n        },\n        opacity: {\n          value: 0.5,\n          random: false,\n          anim: {\n            enable: false,\n            speed: 1,\n            opacity_min: 0.1,\n            sync: false,\n          },\n        },\n        size: {\n          value: 3,\n          random: true,\n          anim: {\n            enable: false,\n            speed: 50,\n            size_min: 0.1,\n            sync: false,\n          },\n        },\n        line_linked: {\n          enable: true,\n          distance: 150,\n          color: \"#5666fe\",\n          opacity: 0.4,\n          width: 1,\n        },\n        move: {\n          enable: true,\n          speed: 1,\n          direction: \"none\",\n          random: false,\n          straight: false,\n          out_mode: \"out\",\n          bounce: false,\n          attract: {\n            enable: false,\n            rotateX: 600,\n            rotateY: 1200,\n          },\n        },\n      },\n      interactivity: {\n        detect_on: \"canvas\",\n        events: {\n          onhover: {\n            enable: true,\n            mode: \"grab\",\n          },\n          onclick: {\n            enable: true,\n            mode: \"push\",\n          },\n          resize: true,\n        },\n        modes: {\n          grab: {\n            distance: 140,\n            line_linked: {\n              opacity: 1,\n            },\n          },\n          bubble: {\n            distance: 400,\n            size: 40,\n            duration: 2,\n            opacity: 8,\n            speed: 2,\n          },\n          repulse: {\n            distance: 200,\n            duration: 0.4,\n          },\n          push: {\n            particles_nb: 4,\n          },\n          remove: {\n            particles_nb: 2,\n          },\n        },\n      },\n      retina_detect: true,\n      zLayers: 1,\n    };\n    return (\n      <>\n        {/* <NavbarMain /> */}\n        <div className=\"main\">\n          <Particles id=\"tsparticles\" options={{ ...particlesData }} />\n          {this.props.children}\n        </div>\n        {/* <Footer /> */}\n      </>\n    );\n  }\n}\n\nexport default Layout2;\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/layouts/layout3/layout3.jsx",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/redux/types.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/redux/types/types.js",[],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/user/user.action.js",["615","616"],"import { toast } from 'react-toastify';\nimport { ENV } from './../../config/config';\nimport {\n  GET_ERRORS,\n  SET_USER,\n  GET_USER,\n  SET_CREATORS,\n  TOP_SELLERS,\n  SET_INDIVIDUAL_USER,\n  BEFORE_USER,\n  UPDATE_API_STATEC,\n  EDIT_APPROVAL,\n  GET_APPROVALS\n} from '../../redux/types';\nimport { emptyError } from '../../redux/shared/error/error.action';\nimport {\n  getCollections,\n  setAuthState,\n} from '../collections/collections.actions';\n\nexport const beforeUser = () => {\n  return {\n    type: BEFORE_USER,\n  };\n};\n\n// method to set user data\nexport const setUser = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_USER,\n    payload: user,\n  });\n};\n\n// method to get user data\nexport const getUser = () => (dispatch) => {\n  dispatch({\n    type: GET_USER,\n  });\n};\n\n// method to login using wallet address and sign\nexport const login = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/login/`;\n  // const url = `http://localhost:5000/v1/front/auth/login/`;\n  console.log(payload, 'payload');\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        const userId = data.data._id;\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to signup using wallet address, sign, and payload\nexport const signup = (payload) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}auth/register/`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      Authorization: ENV.Authorization,\n      'Access-Control-Allow-Origin': '*',\n      'x-auth-token': ENV.x_auth_token,\n    },\n    body: JSON.stringify(payload),\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        ENV.encryptUserData(data.data);\n        dispatch(getCollections());\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'register resonse');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to update user's profile, update user's payload\nexport const updateProfile = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/updateProfile`;\n  console.log(body,\"sendin body\")\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      console.log(data, 'update profile response');\n      if (data.status) {\n        // ENV.encryptUserData(data.data);\n        dispatch({\n          type: SET_USER,\n          payload: data.data,\n        });\n        toast.success(data.message);\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      console.log(errors, 'update profile response');\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const getApprovals = () => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/list`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n      console.log(data.data,\"approvals record\")\n      if(data.success){\n        dispatch({\n          type:GET_APPROVALS,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const updateApprovals = (body) => (dispatch) => {\n\n  dispatch(emptyError());\n  const url = `${ENV.adminUrl}approvals/edit`;\n  fetch(url, {\n    method: 'PUT',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body\n  \n  })\n    .then((res) => res.json())\n    .then((data) => {\n    \n      if(data.success){\n        toast.success(data.message)\n        dispatch({\n          type:EDIT_APPROVAL,\n          payload:data.data\n        })\n      }\n    })\n    .catch((errors) => {\n   \n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getTopSellers =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    //console.log('query string', qs);\n\n    let url = `${ENV.url}users/top-sellers`;\n\n    if (qs) {\n      url += `?${qs}`;\n    }\n    console.log(url, 'url sending');\n\n    fetch(url, {\n      method: 'GET',\n      headers: {\n        Authorization: ENV.Authorization,\n        'x-auth-token': ENV.x_auth_token,\n        'Access-Control-Allow-Origin': '*',\n        'x-access-token':\n          ENV.getUserKeys('accessToken') &&\n          ENV.getUserKeys('accessToken').accessToken\n            ? ENV.getUserKeys('accessToken').accessToken\n            : '',\n      },\n      //   body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          console.log('fetching data', data);\n          dispatch({\n            type: TOP_SELLERS,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\n// method to get authors' details\nexport const getCreators = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/creators`;\n  // const url = `http://3.142.91.8/v1/front/users/creators`;\n\n  fetch(url, {\n    method: 'POST',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n    body,\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      if (data.status) {\n        dispatch({\n          type: SET_CREATORS,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const getUserById = (userId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}users/${userId}`;\n  fetch(url, {\n    method: 'GET',\n    headers: {\n      Authorization: ENV.Authorization,\n      'x-auth-token': ENV.x_auth_token,\n      'Access-Control-Allow-Origin': '*',\n      'x-access-token':\n        ENV.getUserKeys('accessToken') &&\n        ENV.getUserKeys('accessToken').accessToken\n          ? ENV.getUserKeys('accessToken').accessToken\n          : '',\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      console.log(data, 'user response by id');\n      if (data.success) {\n        dispatch({\n          type: SET_INDIVIDUAL_USER,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\n\n// method to get authors' details\nexport const setIndividualUserData = (user) => (dispatch) => {\n  dispatch(emptyError());\n  dispatch({\n    type: SET_INDIVIDUAL_USER,\n    payload: user,\n  });\n};\n\nexport const logoutUser = () => (dispatch) => {\n  dispatch({\n    type: SET_USER,\n    userAuth: false,\n    userData: null,\n  });\n  dispatch(setAuthState());\n  localStorage.removeItem('encuse');\n};\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/explore/explore-items.js",["617","618","619","620","621","622","623"],"import React, { useEffect, useState } from 'react';\nimport { connect } from 'react-redux';\nimport { beforeNFT, getNFTs } from '../nfts/nfts.action';\nimport { ENV } from '../../config/config';\nimport { Link } from 'react-router-dom';\nimport NftCard from '../collections/components/NftCard/NftCard'\nconst initData = {\n    btn_1: \"Load More\",\n}\n\nfunction ExploreItems(props) {\n    const [nftPagination, setNFTPagination] = useState(null);\n    const [nfts, setNFTs] = useState([]); // NFTs for explore section\n    const [loader, setLoader] = useState(true);\n    const [loadMoreBtn, setLoadMoreBtn] = useState(false);\n\n    useEffect(() => {\n        // get NFTs for explore section\n        const nftQS = { page: 1, limit: 4, explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }, [])\n\n    // set NFTs for explore section\n    useEffect(() => {\n        if (props.nft.nftsAuth) {\n            const { nftsData } = props.nft\n            if (nftsData) {\n                setNFTs(nftsData.nfts)\n                setNFTPagination(nftsData.pagination)\n                props.beforeNFT()\n                setLoader(false)\n                if (props.setView)\n                    props.setViewAll(nftsData.nfts && nftsData.nfts.length > 0)\n            }\n        }\n    }, [props.nft.nftsAuth])\n\n    // handle show load more button state when pagination is set\n    useEffect(() => {\n        if (nftPagination)\n            setLoadMoreBtn((nftPagination.total > 0 && nftPagination.total > nfts.length))\n    }, [nftPagination])\n\n    const loadMore = () => {\n        const { page, limit } = nftPagination\n        setLoader(true)\n\n        // get more NFTs for explore section\n        const nftQS = { page: 1, limit: limit * (page + 1), explore: true }\n        const qs = ENV.objectToQueryString(nftQS)\n        props.getNFTs(qs)\n    }\n\n    return (\n        <>\n            {/* <div className={`row items ${props.class1 ? props.class1 : ''} ${!nfts.length ? 'justify-content-center' : ''}`}> */}\n            <div className=\"row\">\n            <div className=\"row justify-content-center mt-5 w-100\">\n                        <div className=\"col-12 col-md-8 col-lg-7\">\n                            <div className=\"intro text-center mb-4\">\n                                {/* <span>{initData.pre_heading}</span> */}\n                                <span>Explore</span>\n                                {/* <h3 className=\"mt-3 mb-0\">{\"initData.heading\"}</h3> */}\n                                    <h3 className=\"mt-3 mb-0\">{\"Exclusce digital assets\"}</h3>\n                            </div>\n                        </div>\n                    </div>\n\n                {\n                    props.nfts && props.nfts.length > 0 ?\n                        props.nfts.map((item, idx) => {\n                            return (\n                                \n                                // <div key={`${props.key}_${idx}`} className={`col-12 col-sm-6 col-lg-3 item d-block ${props.class2 ? props.class2 : ''}`}>\n                                //     <div className=\"card\">\n                                //         <div className=\"image-over\">\n                                //             <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                 <img className=\"card-img-top\" src={item.image} alt=\"Item Image\" />\n                                //             </Link>\n                                //         </div>\n                                //         <div className=\"card-caption col-12 p-0\">\n                                //             <div className=\"card-body\">\n                                //                 <Link to={`/item-details?item=${window.btoa(item._id)}`}>\n                                //                     <h5 className=\"mb-0\">{item.name}</h5>\n                                //                 </Link>\n                                //                 <div className=\"seller d-flex align-items-center my-3\">\n                                //                     <span>Owned By</span>\n                                //                     <Link to=\"/author\">\n                                //                         <h6 className=\"ml-2 mb-0\">{item.owner.username}</h6>\n                                //                     </Link>\n                                //                 </div>\n                                //                 <div className=\"card-bottom d-flex justify-content-between\">\n                                //                     <span>{item.currentPrice}</span>\n                                //                     {/* <span>{item.sold} of {item.copies}</span> */}\n                                //                 </div>\n                                //                 {/* <Link className=\"btn btn-bordered-white btn-smaller mt-3\" to=\"/login\"><i className=\"icon-handbag mr-2\" />Place a Bid</Link> */}\n                                //             </div>http://3.142.91.8/authorshttp://3.142.91.8/authors\n                                //         </div>\n                                //     </div>\n                                // </div>\n                                     \n                      <>\n                     \n                                     <div className=\"col-4 mt-5\">\n                                     <NftCard/>\n                                     </div>\n\n                                     </>\n                              \n                            );\n                        })\n                        : <p className=\"text-center\">No Items Found to Explore</p>\n                }  </div>\n            {/* </div> */}\n            {\n                props.loadMoreBtn &&\n                <div className=\"row\">\n                    <div className=\"col-12 text-center\">\n                        <a id=\"load-btn\" className=\"btn btn-bordered-white mt-5\" onClick={() => loadMore()}>{initData.btn_1}</a>\n                    </div>\n                </div>\n            }\n        </>\n    );\n}\n\nconst mapStateToProps = state => ({\n    nft: state.nft\n});\n\nexport default connect(mapStateToProps, { beforeNFT, getNFTs })(ExploreItems);","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/nfts/nfts.action.js",["624","625","626","627","628"],"import { toast } from \"react-toastify\";\nimport {\n  GET_ERRORS,\n  BEFORE_NFT,\n  GET_NFTS,\n  GET_NFT,\n  UPSERT_NFT,\n  NFTALL,\n  SET_NFT_TOKEN,\n  GET_NFTS_BY_COLLECTION,\n  GET_MYLIKED_NFTS,\n  GET_PROFILE_NFTS,\n  CREATE_ACITIVITY,\n  GET_ACTIVITIES,\n  GET_ITEM_LISTING\n} from \"../../redux/types\";\nimport { ENV } from \"./../../config/config\";\nimport { emptyError } from \"../../redux/shared/error/error.action\";\nimport {\n  axiosPostFormData,\n  decimalNumberValidator,\n} from \"./../../utils/functions\";\nimport axios from \"axios\";\n\nexport const beforeNFT = () => {\n  return {\n    type: BEFORE_NFT,\n  };\n};\nexport const upsertNFT =\n  (type = \"create\", body, method = \"POST\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    const url = `${ENV.url}/nfts/${type}`;\n    console.log(url, \"upsert nft ==}}}}}}}}}}}}}}}}}}}}}\");\n    fetch(url, {\n      method,\n      headers: {\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n      body,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        console.log(data, \"response of upser nft \");\n        if (data.success) {\n          toast.success(data.message);\n          dispatch({\n            type: UPSERT_NFT,\n            payload: data,\n          });\n        } else {\n          toast.error(data.message);\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((error) => {\n        if (error.response && error.response.data) {\n          const { data } = error.response;\n          if (data.message) toast.error(data.message);\n        }\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n\nexport const getNFTs =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.success) {\n          //change to data.data first dispatch\n          dispatch({\n            type: GET_NFTS,\n            payload: data.data,\n          });\n          dispatch({\n            type: NFTALL,\n            payload: data.data,\n          });\n        } else {\n          dispatch({\n            type: GET_ERRORS,\n            payload: data,\n          });\n        }\n      })\n      .catch((errors) => {\n        dispatch({\n          type: GET_ERRORS,\n          payload: errors,\n        });\n      });\n  };\n\nexport const getNFT = (nftId) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}nfts/get/${nftId}`;\n\n  fetch(url, {\n    method: \"GET\",\n    headers: {\n      \"content-type\": \"application/json\",\n      Authorization: ENV.Authorization,\n      \"x-auth-token\": ENV.x_auth_token,\n      \"Access-Control-Allow-Origin\": \"*\",\n      \"x-access-token\":\n        ENV.getUserKeys(\"accessToken\") &&\n        ENV.getUserKeys(\"accessToken\").accessToken\n          ? ENV.getUserKeys(\"accessToken\").accessToken\n          : \"\",\n    },\n  })\n    .then((res) => res.json())\n    .then((data) => {\n      // alert(\"called\")\n      if (data.success) {\n        dispatch({\n          type: NFTALL,\n          payload: data.data,\n        });\n        dispatch({\n          type: GET_NFT,\n          payload: data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: data,\n        });\n      }\n    })\n    .catch((errors) => {\n      dispatch({\n        type: GET_ERRORS,\n        payload: errors,\n      });\n    });\n};\nexport const update =\n  (body, qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .put(url, body)\n      .then(function (response) {\n        if (response.data.success) {\n        } else {\n        }\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n  };\n\nexport const createActivity = (body) => (dispatch) => {\n  dispatch(emptyError());\n  const url = `${ENV.url}activity/create`;\n\n  axios\n    .post(url, body)\n    .then(function (response) {\n      console.log(response, \"response\");\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\nexport const getActivities =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}activity/get`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {\n       \n\n        dispatch({\n          type: GET_ACTIVITIES,\n          payload: response.data.data,\n        });\n      })\n      .catch(function (error) {\n        console.log(error);\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n      });\n  };\n  export const getItemsListing =\n  (qs = null) =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}itemsListing/list`;\n    if (qs) {\n      url += `?${qs}`;\n    }\n\n    axios\n      .get(url)\n      .then(function (response) {    \n        dispatch({\n          type:  GET_ITEM_LISTING,\n          payload: response.data.data,\n        });\n \n      })\n      .catch(function (error) {\n        console.log(error)\n        dispatch({\n          type: GET_ERRORS,\n          payload: error,\n        });\n   \n      });\n  };\n\nexport const getNFTsByCollection = (id) => (dispatch) => {\n  let data = {\n    collectionId: id,\n  };\n\n  dispatch(emptyError());\n\n  const url = `${ENV.url}nfts/getNFTsByCollection`;\n  axios\n    .post(url, data)\n    .then(function (response) {\n      if (response.data.success) {\n        dispatch({\n          type: GET_NFTS_BY_COLLECTION,\n          payload: response.data.data,\n        });\n      } else {\n        dispatch({\n          type: GET_ERRORS,\n          payload: response.data,\n        });\n      }\n    })\n    .catch(function (error) {\n      console.log(error);\n      dispatch({\n        type: GET_ERRORS,\n        payload: error,\n      });\n    });\n};\n\nexport const getMyLikedNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n\n    let url = `${ENV.url}nftLikes/userNftLikes?`;\n    url = url + qs;\n    axios\n      .get(url)\n      .then(function (response) {\n        console.log();\n        if (response.data.success) {\n          dispatch({\n            type: GET_MYLIKED_NFTS,\n            payload: response.data.data,\n          });\n        } else {\n        }\n      })\n      .catch(function (error) {\n        console.log(error);\n      });\n  };\n\nexport const createNFT = async (formData) => {\n  try {\n    const res = await axiosPostFormData(\"nfts/create\", formData, true);\n  } catch (err) {}\n};\nexport const addNFTRecord = (formData) => async (dispatch) => {\n  const res = await axiosPostFormData(\"nfts/storeNFTData\", formData, true);\n};\n\nexport const getProfileNfts =\n  (qs = \"\") =>\n  (dispatch) => {\n    dispatch(emptyError());\n    let url = `${ENV.url}nfts/list`;\n    if (qs) url += `?${qs}`;\n\n    fetch(url, {\n      method: \"GET\",\n      headers: {\n        \"content-type\": \"application/json\",\n        Authorization: ENV.Authorization,\n        \"x-auth-token\": ENV.x_auth_token,\n        \"Access-Control-Allow-Origin\": \"*\",\n        \"x-access-token\":\n          ENV.getUserKeys(\"accessToken\") &&\n          ENV.getUserKeys(\"accessToken\").accessToken\n            ? ENV.getUserKeys(\"accessToken\").accessToken\n            : \"\",\n      },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        console.log(data, \"profile nfts\");\n        if (data.success) {\n          dispatch({\n            type: GET_PROFILE_NFTS,\n            payload: data.data,\n          });\n        } else {\n        }\n      })\n      .catch((errors) => {});\n  };\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/auctions/home-auctions.js",["629","630","631","632","633","634","635","636","637","638","639"],"import React, { useEffect, useState } from 'react';\r\nimport { Link } from 'react-router-dom';\r\nimport { connect } from 'react-redux';\r\nimport { beforeAuction, getLiveAuctions } from './auctions.action';\r\nimport FullPageLoader from '../full-page-loader/full-page-loader';\r\nimport { ENV } from '../../config/config';\r\nimport 'slick-carousel';\r\nimport '../../assets/slick/slick.min.css';\r\nimport '../../assets/slick/slick-theme.min.css';\r\nimport $ from 'jquery';\r\nimport { Images } from '../../assets/assets';\r\n\r\nimport SwiperCore, {\r\n  Navigation,\r\n  Pagination,\r\n  Autoplay,\r\n  Virtual,\r\n} from 'swiper/core';\r\nimport 'swiper/swiper-bundle.css';\r\nimport './auction.css';\r\n\r\nimport { getCreators, beforeUser } from './../user/user.action';\r\nimport ViewAllIcon from '../../assets/images/view-all-arrow.svg';\r\n//CardSliders\r\nimport CardSlider from '../card-slider/CardSlider';\r\nimport AuctionsCards from '../auctions-cards/AuctionsCards';\r\nimport {\r\n  beforeCategory,\r\n  getCategories,\r\n} from '../collections/collections.actions';\r\n\r\nSwiperCore.use([Navigation, Pagination, Autoplay, Virtual]);\r\n\r\nconst initData = {\r\n  pre_heading: 'Auctions',\r\n  heading: 'Live Auctions',\r\n  btnText: 'View All',\r\n};\r\n\r\nfunction AuctionsOne(props) {\r\n  const [auctions, setAuctions] = useState(null);\r\n  const [loader, setLoader] = useState(false); // auctions loader\r\n  const [creators, setCreator] = useState([]);\r\n  const [categories, setCategories] = useState(null);\r\n  const [categoryId, setCategoryId] = useState('all');\r\n  const [auctionSettings, setAuctionSettings] = useState();\r\n  const [isActive, setIsActive] = useState(0);\r\n  useEffect(() => {\r\n    window.scroll(0, 0);\r\n    // get live auctions\r\n    const qs = ENV.objectToQueryString({\r\n      myFilter: 'all',\r\n    });\r\n    props.getLiveAuctions(qs);\r\n    props.getCreators();\r\n  }, []);\r\n\r\n  useEffect(() => {\r\n    if (props.user.topSellersAuth) {\r\n      setCreator(props.user.sellers);\r\n      setLoader(false);\r\n    }\r\n  }, [props.user.topSellersAuth]);\r\n\r\n  // set live auctions\r\n  useEffect(() => {\r\n    if (props.auction.auctionsAuth) {\r\n      const { auctions, pagination } = props.auction;\r\n      if (auctions) {\r\n        auctions.forEach((element, i) => {\r\n          if (element.bidInfo.bidBy.length > 0) {\r\n            auctions[i].totalBids = element.bidInfo.bidBy.length;\r\n            // auctions[i].bidProfiles = element.bidInfo.bidByProfile;\r\n          }\r\n          auctions[i].totalBids = 0;\r\n        });\r\n      }\r\n\r\n      setAuctions(auctions);\r\n      let auctionCollectionsSettings = ENV.auctionCollectionsSettings;\r\n      if (auctions.length > 4) {\r\n        auctionCollectionsSettings.infinite = true;\r\n      } else {\r\n        auctionCollectionsSettings.infinite = false;\r\n      }\r\n      setAuctionSettings(auctionCollectionsSettings);\r\n      props.beforeAuction();\r\n    }\r\n  }, [props.auction.auctionsAuth]);\r\n\r\n  // ready slides when auctions data is received\r\n  useEffect(() => {\r\n    if (auctions && auctions.length) {\r\n      $('.swiper-wrapper').slick(ENV.slickSettings);\r\n    }\r\n  }, [auctions]);\r\n\r\n  useEffect(() => {\r\n    props.getCategories();\r\n  }, []);\r\n  useEffect(() => {\r\n    if (props.collectionFlag) {\r\n      setCategories(props.categories);\r\n    }\r\n  }, [props.collectionFlag]);\r\n\r\n  const handleCategoryFilter = (desc) => {\r\n    setCategoryId(desc);\r\n    const qs = ENV.objectToQueryString({ myFilter: desc });\r\n    props.getLiveAuctions(qs);\r\n  };\r\n\r\n  return (\r\n    <section className='live-auctions-area padding-wrapper'>\r\n      {loader ? (\r\n        <FullPageLoader />\r\n      ) : (\r\n        <div className='container'>\r\n          <div className='row mb-5'>\r\n            <div className='col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4'>\r\n              {/* Intro */}\r\n              <div className='intro d-flex justify-content-between align-items-end m-0'>\r\n                <div className='intro-content'>\r\n                  <span>{initData.pre_heading}</span>\r\n                  <h3 className='mb-0'>{initData.heading}</h3>\r\n                  <p>\r\n                    Explore on the world's best & largest NFT marketplace with\r\n                    our beautiful NFT products. We want to be a part of your\r\n                    smile, success and future growth.\r\n                  </p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div className='col-12 col-lg-7 col-xl-8 mt-3 mt-lg-0'>\r\n              {categoryId === 'all' && auctions && auctions?.length == 0 ? (\r\n                ''\r\n              ) : (\r\n                <div className='popular-collections-content-right mt-lg-4 d-flex justify-content-end align-content-xxl-start text-end'>\r\n                  {categories &&\r\n                    categories.length > 0 &&\r\n                    categories.map((item, id) => {\r\n                      if (id <= 3) {\r\n                        return (\r\n                          <button\r\n                            className={`${\r\n                              id === isActive ? 'home-active-category' : ''\r\n                            } me-1 me-sm-2`}\r\n                            onClick={() => {\r\n                              setIsActive(id);\r\n                              handleCategoryFilter(item.description);\r\n                            }}\r\n                          >\r\n                            {item.name}\r\n                          </button>\r\n                        );\r\n                      }\r\n                    })}\r\n                  <div className='intro-btn'>\r\n                    <Link\r\n                      className='btn btn-rounded-bordered btn-viewAll'\r\n                      to='/auctions'\r\n                    >\r\n                      View All\r\n                      <img\r\n                        src={ViewAllIcon}\r\n                        alt='arrow-left'\r\n                        className='ms-2 d-none d-sm-block'\r\n                      />\r\n                    </Link>\r\n                  </div>\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className='auctions-slides'>\r\n            <div className=''>\r\n              {auctions && auctions.length > 0 ? (\r\n                <CardSlider\r\n                  settings={auctionSettings}\r\n                  data={auctions}\r\n                  homeAuction\r\n                >\r\n                  {auctions.map((item) => {\r\n                    return (\r\n                      <AuctionsCards\r\n                        endDate={item.auctionEndDate}\r\n                        image={item.image}\r\n                        ownerName={item.owner.username}\r\n                        name={item.name}\r\n                        id={item._id}\r\n                        highestBid={item.highestBid}\r\n                        totalBids={item.totalBids - 1}\r\n                        bidsProfile={item.bidInfo.bidByProfile}\r\n                        userId={ENV.getUserKeys('_id')._id}\r\n                        ownerId={item.owner._id}\r\n                        fileType={item.fileType}\r\n                      />\r\n                    );\r\n                  })}\r\n                </CardSlider>\r\n              ) : (\r\n                <p className='text-white text-center'>No Live Auctions Found</p>\r\n              )}\r\n            </div>\r\n          </div>\r\n        </div>\r\n      )}\r\n    </section>\r\n  );\r\n}\r\nconst mapStateToProps = (state) => ({\r\n  auction: state.auction,\r\n  user: state.user,\r\n  collectionFlag: state.collection.collectionFlag,\r\n  categories: state.collection.categories,\r\n});\r\nexport default connect(mapStateToProps, {\r\n  beforeAuction,\r\n  getLiveAuctions,\r\n  getCreators,\r\n  getCategories,\r\n  beforeCategory,\r\n})(AuctionsOne);\r\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/footer/footer.js",["640","641","642","643","644","645","646","647"],"import { useEffect, useState } from \"react\";\nimport { Link } from \"react-router-dom\";\nimport logo from \"../../assets/images/MintsClub-White.png\";\nimport { connect } from \"react-redux\";\nimport { getFooter } from \"./footer.action\";\nimport { ENV } from \"./../../config/config\";\n\nconst Footer = (props) => {\n  const [data, setData] = useState({\n    facebook: \"\",\n    twitter: \"\",\n    instagram: \"\",\n    youtube: \"\",\n    vine: \"\",\n    desc: \"\",\n  });\n\n  useEffect(() => {\n    props.getFooter();\n  }, []);\n\n  // useEffect(() => {\n  //   if (props.settings.settingsAuth) {\n  //     setData(props.settings.settings);\n  //   }\n  // }, [props.settings.settingsAuth]);\n\n  return (\n    <footer className=\"footer-area\">\n      {/* Footer Top */}\n      <div className=\"footer-top\">\n        <div className=\"container\">\n          <div className=\"row justify-content-center justify-content-lg-between\">\n            <div className=\"col-12 col-sm-8 col-md-6 col-lg-4 res-margin order-5 order-lg-0\">\n              {/* Footer Items */}\n              <div className=\"footer-items footer-notify-item\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">\n                  {\"Want to get notify and product updates from us?\"}\n                </h4>\n                {/* Subscribe Form */}\n                <div className=\"input-group notify-form\">\n                  <div className=\"input-group-prepend\">\n                    <button\n                      type=\"submit\"\n                      className=\"input-group-text\"\n                      id=\"basic-addon1\"\n                    >\n                      Notify\n                    </button>\n                  </div>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"yourname@gmail.com\"\n                    aria-label=\"yourname@gmail.com\"\n                    aria-describedby=\"basic-addon1\"\n                  />\n                </div>\n                {/* <div className=\"subscribe-form d-flex align-items-center\">\n                  <button type=\"submit\" className=\"btn\">\n                    Notify\n                  </button>\n                  <input\n                    type=\"email\"\n                    className=\"form-control\"\n                    placeholder=\"info@yourmail.com\"\n                  />\n                </div> */}\n                <p>{data.desc}</p>\n                {/* Social Icons */}\n                <div className=\"social-icons d-flex justify-content-center justify-content-lg-start\">\n                  <a href={data.linkedin} target=\"_blank\">\n                    <i className={\"fab fa-linkedin-in\"} />\n                  </a>\n                  <a href={data.facebook} target=\"_blank\">\n                    <i className={\"fab fa-facebook-f\"} />\n                  </a>\n                  <a href={data.instagram} target=\"_blank\">\n                    <i className={\"fab fa-instagram\"} />\n                  </a>\n                  <a href={data.twitter} target=\"_blank\">\n                    <i className={\"fab fa-twitter\"} />\n                  </a>\n                  {/* {data.facebook ? (\n                    <a href={data.facebook} target=\"_blank\">\n                      <i className={\"fab fa-facebook-f\"} />\n                      <i className={\"fab fa-facebook-f\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.twitter ? (\n                    <a href={data.twitter} target=\"_blank\">\n                      <i className={\"fab fa-twitter\"} />\n                      <i className={\"fab fa-twitter\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.instagram ? (\n                    <a href={data.instagram} target=\"_blank\">\n                      <i className={\"fab fa-instagram\"} />\n                      <i className={\"fab fa-instagram\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.youtube ? (\n                    <a href={data.youtube} target=\"_blank\">\n                      <i className={\"fab fa-youtube\"} />\n                      <i className={\"fab fa-youtube\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )}\n\n                  {data.vine ? (\n                    <a href={data.vine} target=\"_blank\">\n                      <i className={\"fab fa-vine\"} />\n                      <i className={\"fab fa-vine\"} />\n                    </a>\n                  ) : (\n                    \"\"\n                  )} */}\n                </div>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin  text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Company\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/explore-all\">About</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/how-it-works\">Team</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/create\">Contact Us</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/privacy-and-terms\">Blog</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Resource\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Authors</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Affiliate Program</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">FAQS</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">News & Press</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Testimonials</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6 col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Need Help ?\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Privacy Policy</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign up</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Sign in</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Pre-sale Questions</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Terms & Conditions</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n            <div className=\"col-12 col-sm-6  col-lg-2 res-margin text-center  text-lg-start\">\n              {/* Footer Items */}\n              <div className=\"footer-items\">\n                {/* Footer Title */}\n                <h4 className=\"footer-title\">{\"Marketplace\"}</h4>\n                <ul>\n                  <li>\n                    <Link to=\"/help-center\">Live Auction</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">NFT Product</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Virtual World</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Popular Art</Link>\n                  </li>\n                  <li>\n                    <Link to=\"/contact\">Domain Names</Link>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      {/* Footer Bottom */}\n      <div className=\"footer-bottom\">\n        <div className=\"container-fluid\">\n          <div className=\"row\">\n            <div className=\"col-12\">\n              {/* Copyright Left */}\n              <div className=\"copyright-text\">\n                © 2022 All Rights Reserved By MintsClub.com\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n\nconst mapStateToProps = (state) => ({\n  error: state.error,\n  settings: state.settings,\n});\n\nexport default connect(mapStateToProps, { getFooter })(Footer);\n","/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/top-seller/topseller2.js",["648","649","650","651","652"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/collections/popular-collections.js",["653","654","655","656","657","658","659","660","661"],"/Users/aqsaqayyum/Desktop/mintsClubV2 latestnew/frontend/frontend-v2/frontend/src/components/hero/hero.js",["662","663","664"],"import React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { connectMetamaskCopy } from \"../../utils/web3\";\r\nimport { ENV } from \"./../../config/config\";\r\nimport \"./hero.css\";\r\nimport CreateIcon from \"../../assets/images/create-icon.svg\";\r\nimport ExploreIcon from \"../../assets/images/explore-icon.svg\";\r\nimport PlayIcon from \"../../assets/images/play-icon.svg\";\r\nimport Slider from \"./component/slider\";\r\n\r\nconst Hero = (props) => {\r\n  const [connectedAddress, setConnectedAddress] = useState(\"\");\r\n\r\n  useEffect(async () => {\r\n    let connectedAddress = await connectMetamaskCopy();\r\n    setConnectedAddress(connectedAddress);\r\n  }, []);\r\n\r\n  const sliderRadioButtons = [\r\n    {\r\n      id: \"s1\",\r\n      value: 1,\r\n    },\r\n    {\r\n      id: \"s2\",\r\n      value: 2,\r\n    },\r\n    {\r\n      id: \"s3\",\r\n      value: 3,\r\n    },\r\n    {\r\n      id: \"s4\",\r\n      value: 4,\r\n    },\r\n    {\r\n      id: \"s5\",\r\n      value: 5,\r\n    },\r\n    {\r\n      id: \"s6\",\r\n      value: 6,\r\n    },\r\n    {\r\n      id: \"s7\",\r\n      value: 7,\r\n    },\r\n  ];\r\n\r\n  const [sliderChecked, setSliderChecked] = useState(1);\r\n  const length = sliderRadioButtons.length;\r\n  const handleRadioInputs = (e) => {\r\n    setSliderChecked(e.target.value);\r\n  };\r\n\r\n  const nextBtnHandler = () => {\r\n    if (sliderChecked < length) {\r\n      setSliderChecked(sliderChecked + 1);\r\n    } else {\r\n      setSliderChecked(1);\r\n    }\r\n  };\r\n\r\n  const prevBtnHandler = () => {\r\n    if (sliderChecked === 1) {\r\n      setSliderChecked(7);\r\n    } else {\r\n      setSliderChecked(sliderChecked - 1);\r\n    }\r\n  };\r\n  const setHandler = (id) => {\r\n    setSliderChecked(id);\r\n  };\r\n  return (\r\n    <section className=\"hero-section padding-wrapper\">\r\n      {/* <Particles id=\"tsparticles\" options={{ ...particlesData }} /> */}\r\n      <div className=\"container\">\r\n        <div className=\"row align-items-center\">\r\n          <div className=\"col-12 col-lg-6 col-xl-5\">\r\n            <h1 className=\"mt-4\">\r\n              Discover, collect, and sell extraordinary NFTs\r\n            </h1>\r\n            <p className=\"mp-explore-text\">\r\n        